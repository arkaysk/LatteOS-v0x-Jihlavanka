@@ -629,3 +629,18 @@ pub use wayland::icon;
 pub fn icon(_: &str) -> Option<std::path::PathBuf> {
     None
 }
+
+/// Whether `what` (a service, a command's family, or "cursor") goes through
+/// Hyprland's socket. `PLEAMAR_GENERIC=1` sends everything through the
+/// protocols every compositor understands; `PLEAMAR_GENERIC=window` (a list,
+/// comma separated) only what it names: on Hyprland the `window` service reports
+/// only the active window, while wlr-foreign-toplevel lists them all, and the
+/// cursor can still come from Hyprland.
+#[cfg(target_os = "linux")]
+fn hyprland_path(what: &str) -> bool {
+    hyprland::is_present()
+        && match std::env::var("PLEAMAR_GENERIC") {
+            Err(_) => true,
+            Ok(v) => !v.split(',').map(str::trim).any(|p| p == "1" || p == what),
+        }
+}
