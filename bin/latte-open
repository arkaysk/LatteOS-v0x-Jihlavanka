#!/usr/bin/env python3
"""latte-open URL: a web address in the default browser, and the browser's window brought forward, as Windows does when
an app opens a link. A browser that is already running puts the page in a tab of its last window, which may be put away
(minimized) or behind: Wayland lets nobody take the front by themselves, so it only blinks in the dock and the person
sees "nothing happened" (LensAI › Agents › ACP › Read, 21. 11.). The window whose title changed, or that came, is shown.
Without pleamar-wm (the hyprctl of system/pleamarwm/bin), only xdg-open."""
import json, os, subprocess, sys, time


def browser_class():
    """The window class of the default browser: its .desktop's StartupWMClass, else the .desktop's own name."""
    try:
        desk = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/https"], capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""
    for d in [os.path.expanduser("~/.local/share/applications"), "/usr/local/share/applications", "/usr/share/applications",
              "/var/lib/flatpak/exports/share/applications"]:
        try:
            with open(os.path.join(d, desk)) as f:
                for line in f:
                    if line.startswith("StartupWMClass="):
                        return line.split("=", 1)[1].strip().lower()
            break
        except OSError:
            continue
    return desk.removesuffix(".desktop").lower()


def windows(kind):
    try:
        got = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    return {c["address"]: c["title"] for c in got if (c.get("class") or "").lower() == kind}


def main(url):
    on_wm = os.environ.get("XDG_CURRENT_DESKTOP") == "pleamar" and os.environ.get("PLEAMAR_SOCKETS")
    kind = browser_class() if on_wm else ""
    before = windows(kind) if kind else {}
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if not kind:
        return 0
    for _ in range(40):                                   # a browser that is not running yet takes a few seconds
        time.sleep(0.25)
        moved = [a for a, t in windows(kind).items() if before.get(a) != t]
        if moved:
            subprocess.run(["pleamar-wm", "--say", "wm", "emit latte_focus " + moved[0][2:]],      # "0x8": the WM's slot 8
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            return 0
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(__doc__.split("\n")[0], file=sys.stderr)
        sys.exit(2)
    sys.exit(main(sys.argv[1]))
