#!/usr/bin/env python3
"""latte-goowidgets [list|build|folder]: the window "Widgets and new Goo" (goo/widgets.plm, ROADMAP 6.47) and its helper.

No argument: opens the window. `list` prints the creations of pleamar-wm's Build mode (the gadgets the AI builds, Win+B) as
JSON; `build` starts the Build mode; `folder` opens the folder they are kept in. The creations are Build's own
(<scene folder>/creations/<id>/creation.json and index.json, where pleamar keeps them); this only reads them, and keeping,
replacing and deleting stay in Build's own list ("My creations"). Foreign Goo is not handled here yet.
"""
import json
import os
import subprocess
import sys

DATA = os.path.expanduser(os.environ.get("LATTE_CREATIONS_ROOT", "~/.local/share/pleamar"))
AUTOSTART = os.path.expanduser("~/.config/pleamar/creations.autostart")


def folders():
    """Where Build keeps its creations: the folder of the scene that makes them (Marea's, ROADMAP 1D.19)."""
    out = []
    for scene in ("marea", "build"):
        d = os.path.join(DATA, scene, "creations")
        if os.path.isdir(d):
            out.append(d)
    return out


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def listing():
    try:
        with open(AUTOSTART) as f:
            started = f.read()
    except OSError:
        started = ""
    out = []
    for d in folders():
        ix = load(os.path.join(d, "index.json"))
        for item in (ix or {}).get("list", []):
            if not isinstance(item, dict) or item.get("thrown") or not item.get("id"):
                continue
            rec = load(os.path.join(d, str(item["id"]), "creation.json")) or {}
            out.append({"id": item["id"], "name": item.get("name") or rec.get("name") or item["id"],
                        "kind": item.get("kind") or rec.get("kind") or "",
                        "session": "# creation %s" % item["id"] in started})
    return out


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "list":
        print(json.dumps(listing()))
    elif cmd == "build":
        subprocess.Popen(["pleamar-wm", "build", "on"], start_new_session=True)
    elif cmd == "folder":
        d = (folders() or [DATA])[0]
        subprocess.Popen(["xdg-open", d], start_new_session=True)
    elif cmd == "":
        share = os.environ.get("LATTE_SHARE", "/usr/share/latteos")
        scene = os.path.join(share, "goo/widgets.plm")
        if not os.path.isfile(scene):
            scene = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../goo/widgets.plm")   # from the repository
        os.execvp("pleamar", ["pleamar", "--scene", scene, "--no-hud", "--answer-as", "goowidgets-%d" % os.getpid()])
    else:
        sys.exit("latte-goowidgets [list|build|folder]")


if __name__ == "__main__":
    main(sys.argv)
