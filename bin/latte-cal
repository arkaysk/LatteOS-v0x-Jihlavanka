#!/usr/bin/env python3
"""latte-cal: the calendars, for ClockGoo and the Calendar app.

  latte-cal events [--from YYYY-MM-DD] [--to YYYY-MM-DD] [ADDRESS…]
        every event: the user's accounts (Google, Microsoft 365, Exchange, Nextcloud, iCloud and other CalDAV,
        Thunderbird's and this computer's own — Evolution Data Server keeps them, GNOME Online Accounts signs in),
        the addresses given (iCalendar, below) and the holidays of the place's country (latte-sky country). Prints
        [{"date", "time" ("" for a whole day), "end", "title", "location", "link" (a Teams, Meet or Zoom address found
        in it), "calendar", "color", "kind": "event"|"holiday", "uid", "source"}], sorted; a month ago to a year ahead
        unless said otherwise. A repeated event comes once for each time (Evolution Data Server writes them out).
  latte-cal calendars        the calendars: [{"uid", "name", "account", "color", "backend", "writable", "enabled", "removable"}]
  latte-cal add UID TITLE START END [LOCATION]   a new event in the calendar UID; START and END as YYYY-MM-DDTHH:MM,
        or YYYY-MM-DD for a whole day (END the day after the last); prints {"ok", "uid"}
  latte-cal update UID EVENT JSON                changes an event: any of title, start, end, location, notes, color, url, free, private
  latte-cal remove UID EVENT [SCOPE RID]         takes an event out (of a repeating one SCOPE this|future|all of the occurrence
        RID); the last one is kept for `undo`
  latte-cal tasklists                            the lists of tasks of the accounts: [{"uid", "name", "account", "color", "removable", "enabled"}]
  latte-cal tasklist-show UID on|off             a list of tasks shows in the calendar, or not
  latte-cal add-account ics|caldav NAME ADDRESS [USER]   a calendar from an address; the password on the standard input
  latte-cal remove-account UID                   a calendar the user added goes away (the computer's own does not)
  latte-cal watch [--once]                       tells the reminders as they come due (the service latte-calwatch)
  latte-cal undo                                 puts back the event taken out last
  latte-cal duplicate UID EVENT                  a copy of the event, beside it
  latte-cal move UID EVENT TO                    the event into another calendar TO
  latte-cal parse [--ai] [--day YYYY-MM-DD] TEXT   a new event written as a sentence ("Obed s Petrom zajtra o 12 v Jihlavanke"): {"ok", "title",
        "start", "end" (as `add` takes them), "allday", "place", "calendar", "calendar_name", "when"}; Slovak words
  latte-cal holidays [YEAR]  the holidays of the place's country, in the user's language where it is known
  latte-cal accounts         the window where accounts are signed in (gnome-online-accounts-gtk)
  latte-cal ADDRESS…         as before: the events of the addresses only, [{"date", "time", "title"}]

An address

An address is a calendar in iCalendar form: https://…, webcal://… or a file (.ics). Google Calendar, iCloud,
Nextcloud and the rest all give such an address for a calendar ("secret address in iCal format").
Prints [{"date": "YYYY-MM-DD", "time": "HH:MM" or "" for the whole day, "title": …}], sorted, for the days from
a month ago to a year ahead; an event that repeats is written out day by day. A calendar that cannot be read is
left out, with a line on stderr.
"""
import datetime as dt
import json
import os
import re
import subprocess
import sys
import urllib.request
import uuid
from zoneinfo import ZoneInfo

DAYS = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
MOST = 2000                 # occurrences of one event: a rule that never ends stops somewhere


def fetch(address):
    if re.match(r"^(https?|webcal)://", address):
        req = urllib.request.Request(re.sub(r"^webcal://", "https://", address), headers={"User-Agent": "LatteOS"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.read(4 << 20).decode("utf-8", "replace")
    with open(address, encoding="utf-8", errors="replace") as f:
        return f.read()


def when(params, value):
    """A DTSTART or the like → (a datetime in local time, whether it is a whole day)."""
    if re.fullmatch(r"\d{8}", value):
        return dt.datetime.strptime(value, "%Y%m%d"), True
    t = dt.datetime.strptime(value[:15], "%Y%m%dT%H%M%S")
    zone = re.search(r"TZID=([^;:]+)", params)
    if value.endswith("Z"):
        t = t.replace(tzinfo=dt.timezone.utc).astimezone().replace(tzinfo=None)
    elif zone:
        try:
            t = t.replace(tzinfo=ZoneInfo(zone.group(1).strip('"'))).astimezone().replace(tzinfo=None)
        except Exception:
            pass                # a zone this system does not know: the time as written
    return t, False


def step(t, freq, n):
    if freq == "DAILY": return t + dt.timedelta(days=n)
    if freq == "WEEKLY": return t + dt.timedelta(weeks=n)
    months = t.month - 1 + (n if freq == "MONTHLY" else 12 * n)
    try:
        return t.replace(year=t.year + months // 12, month=months % 12 + 1)
    except ValueError:
        return None             # the 31st of a month that has none, the 29th of February: no such day that time


def times(start, rule, first, last):
    """Every time an event that starts at `start` happens between `first` and `last`."""
    if not rule:
        return [start] if first <= start <= last else []
    r = dict(p.split("=", 1) for p in rule.split(";") if "=" in p)
    freq, every = r.get("FREQ", ""), max(1, int(r.get("INTERVAL", "1") or 1))
    if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        return [start] if first <= start <= last else []
    count = int(r["COUNT"]) if r.get("COUNT", "").isdigit() else None
    until = when("", r["UNTIL"])[0] if r.get("UNTIL") else None
    if until and len(r["UNTIL"]) == 8: until += dt.timedelta(days=1)
    # ponytail: BYDAY is obeyed for weekly events only ("every Monday and Thursday"); "the second Tuesday of the
    # month" repeats on the same date instead. Use a real iCalendar library when that matters.
    days = sorted(DAYS[d] for d in r.get("BYDAY", "").split(",") if d in DAYS) if freq == "WEEKLY" else []
    out, made, n = [], 0, 0
    while made < MOST:
        base = step(start, freq, n * every)
        n += 1
        if n > MOST * 4: break
        if base is None: continue
        group = [base + dt.timedelta(days=d - base.weekday()) for d in days] if days else [base]
        for t in group:
            if t < start: continue
            if (until and t > until) or (count is not None and made >= count) or t > last: return out
            made += 1
            if t >= first: out.append(t)
    return out


def events(text, first, last):
    text = re.sub(r"\r?\n[ \t]", "", text)                      # a long line goes on in the next, after a space
    out = []
    for block in re.findall(r"BEGIN:VEVENT(.*?)END:VEVENT", text, re.S):
        got, skipped = {}, set()
        for line in block.splitlines():
            m = re.match(r"([A-Z-]+)((?:;[^:]*)?):(.*)", line.strip())
            if not m: continue
            name, params, value = m.groups()
            if name == "EXDATE":
                for v in value.split(","):
                    try: skipped.add(when(params, v)[0])
                    except ValueError: pass
            else:
                got.setdefault(name, (params, value))
        if "DTSTART" not in got or got.get("STATUS", ("", ""))[1] == "CANCELLED": continue
        try:
            start, whole = when(*got["DTSTART"])
            end = when(*got["DTEND"])[0] if "DTEND" in got else start
        except ValueError:
            continue
        title = re.sub(r"\\([,;\\])", r"\1", got.get("SUMMARY", ("", ""))[1]).replace("\\n", " ").replace("\\N", " ").strip()
        long = min(max((end - start).days, 1), 14) if whole else 1            # a whole-day event of several days
        for t in times(start, got.get("RRULE", ("", ""))[1], first - dt.timedelta(days=long), last):
            if t in skipped: continue
            for day in range(long):
                d = t + dt.timedelta(days=day)
                if first <= d <= last:
                    out.append({"date": d.strftime("%Y-%m-%d"), "time": "" if whole else d.strftime("%H:%M"), "title": title})
    return out


# ── the user's accounts, through Evolution Data Server ───────────────────────────────────────────────────────────────
LINKS = re.compile(r"https://(?:teams\.microsoft\.com/l/meetup-join|teams\.live\.com/meet|meet\.google\.com|[\w.-]*zoom\.us/j|[\w.-]*webex\.com)/[^\s<>\"']+")


def eds():
    import gi
    gi.require_version("EDataServer", "1.2"); gi.require_version("ECal", "2.0"); gi.require_version("ICalGLib", "3.0")
    from gi.repository import EDataServer, ECal, ICalGLib
    return EDataServer, ECal, ICalGLib


def connect(ECal, reg, uid):
    """A calendar's client. Waiting for its backend to be online: a calendar of this computer never says it is (it took
    the whole 15 s each time, 22. 10.), one of an account is read from its copy kept here when it is not there soon."""
    src = reg.ref_source(uid)
    local = src.get_extension("Calendar").get_backend_name() in ("local", "contacts")
    # (guint32)-1 does not wait at all; 0 would wait for ever
    return ECal.Client.connect_sync(src, ECal.ClientSourceType.EVENTS, 0xFFFFFFFF if local else 3, None)


def calendars():
    try:
        EDataServer, ECal, _ = eds()
        reg = EDataServer.SourceRegistry.new_sync(None)
    except Exception as e:                      # no Evolution Data Server here: no accounts, the addresses still work
        print(f"latte-cal: {e}", file=sys.stderr)
        return []
    out = []
    for src in reg.list_sources(EDataServer.SOURCE_EXTENSION_CALENDAR):
        ext = src.get_extension(EDataServer.SOURCE_EXTENSION_CALENDAR)
        parent = reg.ref_source(src.get_parent()) if src.get_parent() else None
        out.append({"uid": src.get_uid(), "name": src.get_display_name(), "account": parent.get_display_name() if parent else "",
                    "color": ext.get_color() or "#f7c873", "backend": ext.get_backend_name(), "enabled": src.get_enabled(),
                    "writable": ext.get_backend_name() not in ("contacts", "weather", "webcal") and src.get_writable(),
                    "removable": bool(src.get_removable()) and not src.get_uid().startswith("system")})
    return out


def prop(icomp, kind, getter):
    p = icomp.get_first_property(kind)
    return getattr(p, getter)() if p else None


def rule_of(icomp, kind):
    """The event's RRULE as written in iCalendar ("FREQ=WEEKLY;BYDAY=MO"), "" for none."""
    p = icomp.get_first_property(kind)
    # the property's text is "RRULE;X-EVOLUTION-ENDDATE=…:FREQ=…" folded over lines: the rule is what follows the colon
    return re.sub(r"\r?\n ", "", p.as_ical_string()).split(":", 1)[1].strip() if p else ""


def rule_for(rule, whole, ICalGLib, zone):
    """A rule as the editor writes it (UNTIL=YYYY-MM-DD) in the form iCalendar wants: a date for a whole-day event, else the
    end of that day in UTC."""
    def until(m):
        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if whole:
            return "UNTIL=%04d%02d%02d" % (y, mo, d)
        t = dt.datetime(y, mo, d, 23, 59, 59).astimezone(dt.timezone.utc)
        return "UNTIL=" + t.strftime("%Y%m%dT%H%M%SZ")
    return ICalGLib.Recurrence.new_from_string(re.sub(r"UNTIL=(\d{4})-(\d\d)-(\d\d)", until, rule))


def alarms_of(icomp, ICalGLib):
    """The reminders of an event: minutes before its start (a relative TRIGGER), sorted."""
    out = set()
    a = icomp.get_first_component(ICalGLib.ComponentKind.VALARM_COMPONENT)
    while a:
        p = a.get_first_property(ICalGLib.PropertyKind.TRIGGER_PROPERTY)
        d = p.get_trigger().get_duration() if p else None
        if d is not None and not d.is_null_duration():
            out.add(-d.as_int() // 60)
        a = icomp.get_next_component(ICalGLib.ComponentKind.VALARM_COMPONENT)
    return sorted(out)


def sources_of(extension):
    """[{"uid", "name", "account", "color", "removable", "enabled"}] of the sources that have this extension."""
    EDataServer, ECal, _ = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    out = []
    for src in reg.list_sources(extension):
        ext = src.get_extension(extension)
        parent = reg.ref_source(src.get_parent())
        out.append({"uid": src.get_uid(), "name": src.get_display_name(), "account": parent.get_display_name() if parent else "",
                    "color": ext.get_color() if hasattr(ext, "get_color") and ext.get_color() else "",
                    "removable": bool(src.get_removable()), "enabled": bool(src.get_enabled()) and bool(getattr(ext, "get_selected", lambda: True)())})
    return out


def task_lists():
    """The lists of tasks (VTODO) of the accounts."""
    return sources_of("Task List")


def task_list_shown(uid, on):
    EDataServer, _, _ = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    src = reg.ref_source(uid)
    if not src:
        return {"ok": False}
    src.get_extension("Task List").set_selected(bool(on))
    reg.commit_source_sync(src, None)
    return {"ok": True}


def add_account(kind, name, url, user="", password=""):
    """A calendar from an address: kind "ics" (a calendar published on the web) or "caldav" (Nextcloud, iCloud, Fastmail…);
    the password goes to the keyring (the secret service), never to a file."""
    from gi.repository import GLib
    EDataServer, ECal, _ = eds()
    if not re.match(r"^(https?|webcal)://", url):
        return {"ok": False, "error": "address"}
    uri = GLib.Uri.parse(re.sub(r"^webcal://", "https://", url), GLib.UriFlags.NONE)
    reg = EDataServer.SourceRegistry.new_sync(None)
    src = EDataServer.Source.new(None, None)
    src.set_display_name(name or uri.get_host())
    src.set_parent("webcal-stub" if kind == "ics" else "caldav-stub")
    cal = src.get_extension("Calendar")
    cal.set_backend_name("webcal" if kind == "ics" else "caldav")
    cal.set_selected(True)
    secure = uri.get_scheme() == "https"
    auth = src.get_extension("Authentication")
    auth.set_host(uri.get_host() or "")
    auth.set_port(uri.get_port() if uri.get_port() > 0 else (443 if secure else 80))
    if user:
        auth.set_user(user)
    src.get_extension("Security").set_method("tls" if secure else "none")
    web = src.get_extension("WebDAV Backend")
    web.set_resource_path(uri.get_path() or "/")
    reg.commit_source_sync(src, None)
    if password:
        src.store_password_sync(password, True, None)
    return {"ok": True, "uid": src.get_uid()}


def remove_account(uid):
    """Takes a calendar (or a list of tasks) away from the computer; only what the user added, not the computer's own."""
    EDataServer, _, _ = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    src = reg.ref_source(uid)
    if not src or not src.get_removable() or uid.startswith("system"):
        return {"ok": False}
    src.remove_sync(None)
    return {"ok": True}


def task_events(first, last):
    """The tasks (VTODO) that have a day, of the lists switched on: shown in the calendar as Google shows its tasks."""
    out = []
    try:
        EDataServer, ECal, ICalGLib = eds()
        reg = EDataServer.SourceRegistry.new_sync(None)
    except Exception:
        return out
    for lst in task_lists():
        if not lst["enabled"]:
            continue
        try:
            src = reg.ref_source(lst["uid"])
            client = ECal.Client.connect_sync(src, ECal.ClientSourceType.TASKS, 0xFFFFFFFF, None)
            ok, comps = client.get_object_list_sync("#t", None)
        except Exception as e:
            print(f"latte-cal: {lst['name']}: {e}", file=sys.stderr)
            continue
        for ic in comps if ok else []:
            due = ic.get_due() if ic.get_first_property(ICalGLib.PropertyKind.DUE_PROPERTY) else None
            if due is None or due.is_null_time():
                continue
            day = dt.datetime(due.get_year(), due.get_month(), due.get_day())
            if not first <= day <= last:
                continue
            out.append({"date": day.strftime("%Y-%m-%d"), "time": "", "end": "", "title": (ic.get_summary() or "").strip(), "location": "", "link": "",
                        "calendar": lst["name"], "color": lst["color"] or "#f7c873", "own_color": "", "kind": "task", "uid": ic.get_uid() or "",
                        "source": lst["uid"], "writable": False, "notes": (ic.get_description() or "").strip(), "start": day.strftime("%Y-%m-%d"),
                        "finish": day.strftime("%Y-%m-%d"), "allday": True, "alarms": [], "repeat": "", "rid": "",
                        "done": ic.get_status() == ICalGLib.PropertyStatus.COMPLETED, "free": True, "private": False, "url": ""})
    return out


def account_events(first, last):
    try:
        EDataServer, ECal, ICalGLib = eds()
        reg = EDataServer.SourceRegistry.new_sync(None)
    except Exception:
        return []
    out = []
    for cal in calendars():
        if not cal["enabled"]:
            continue
        try:
            client = connect(ECal, reg, cal["uid"])
        except Exception as e:
            print(f"latte-cal: {cal['name']}: {e}", file=sys.stderr)
            continue

        def each(icomp, start, end, *rest):
            whole = start.is_date()
            s = dt.datetime.fromtimestamp(start.as_timet_with_zone(start.get_timezone()) if start.get_timezone() else start.as_timet())
            e = dt.datetime.fromtimestamp(end.as_timet_with_zone(end.get_timezone()) if end.get_timezone() else end.as_timet())
            if whole:
                s, e = dt.datetime.combine(start_date(start), dt.time()), dt.datetime.combine(start_date(end), dt.time())
            where = icomp.get_location() or ""
            text = " ".join(x for x in (where, icomp.get_description() or "", prop(icomp, ICalGLib.PropertyKind.URL_PROPERTY, "get_url") or "") if x)
            link = LINKS.search(text)
            # the event's own colour (iCalendar's COLOR, as Evolution keeps it), else its calendar's
            p = icomp.get_first_property(ICalGLib.PropertyKind.COLOR_PROPERTY)
            own = p.get_color() if p else ""
            # a whole day of several days shows on each of them
            days = max(1, (e - s).days) if whole else 1
            for n in range(min(days, 31)):
                d = s + dt.timedelta(days=n)
                if first <= d <= last:
                    out.append({"date": d.strftime("%Y-%m-%d"), "time": "" if whole else s.strftime("%H:%M"),
                                "end": "" if whole else e.strftime("%H:%M"), "title": (icomp.get_summary() or "").strip(),
                                "location": where if not where.startswith("http") else "", "link": link.group(0) if link else "",
                                "calendar": cal["name"], "color": own or cal["color"], "own_color": own, "kind": "event",
                                "uid": icomp.get_uid() or "", "source": cal["uid"], "writable": cal["writable"],
                                "notes": (icomp.get_description() or "").strip(), "start": s.strftime("%Y-%m-%d" if whole else "%Y-%m-%dT%H:%M"),
                                "finish": e.strftime("%Y-%m-%d" if whole else "%Y-%m-%dT%H:%M"), "allday": whole,
                                "free": prop(icomp, ICalGLib.PropertyKind.TRANSP_PROPERTY, "get_transp") == ICalGLib.PropertyTransp.TRANSPARENT,
                                "private": prop(icomp, ICalGLib.PropertyKind.CLASS_PROPERTY, "get_class") in (ICalGLib.Property_Class.PRIVATE, ICalGLib.Property_Class.CONFIDENTIAL),
                                "url": prop(icomp, ICalGLib.PropertyKind.URL_PROPERTY, "get_url") or "",
                                "alarms": alarms_of(icomp, ICalGLib), "repeat": rule_of(icomp, ICalGLib.PropertyKind.RRULE_PROPERTY), "rid": ECal.Component.new_from_icalcomponent(icomp).get_recurid_as_string() or ""})
            return True
        try:
            client.generate_instances_sync(int(first.timestamp()), int(last.timestamp()), None, each)
        except Exception as e:
            print(f"latte-cal: {cal['name']}: {e}", file=sys.stderr)
    return out


def start_date(t):
    return dt.date(t.get_year(), t.get_month(), t.get_day())


def place_country():
    try:
        c = subprocess.run(["latte-sky", "country"], capture_output=True, text=True, timeout=12).stdout.strip()
        if re.fullmatch(r"[a-z]{2}", c):
            return c
    except (OSError, subprocess.TimeoutExpired):
        pass
    return (os.environ.get("LANG", "sk_SK")[3:5] or "sk").lower()


def holidays_of(years):
    """The public holidays of the place's country (python-holidays), named in the user's language where it can."""
    try:
        import holidays
    except ImportError:
        return {}
    country = place_country().upper()
    lang = (os.environ.get("LC_ALL") or os.environ.get("LANG") or "en").split("_")[0].split(".")[0]
    try:
        return holidays.country_holidays(country, years=years, language=lang)
    except (NotImplementedError, KeyError):
        return {}
    except Exception:
        return holidays.country_holidays(country, years=years)


def all_events(first, last, addresses):
    found = account_events(first, last) + task_events(first, last)
    for a in addresses:
        try:
            for e in events(fetch(a), first, last):
                found.append(dict(e, end="", location="", link="", calendar=a.split("/")[2] if "//" in a else os.path.basename(a),
                                  color="#f7c873", kind="event", uid="", source=a))
        except Exception as e:
            print(f"latte-cal: {a}: {e}", file=sys.stderr)
    for d, name in sorted(holidays_of(range(first.year, last.year + 1)).items()):
        day = dt.datetime.combine(d, dt.time())
        if first <= day <= last:
            found.append({"date": d.isoformat(), "time": "", "end": "", "title": name, "location": "", "link": "",
                          "calendar": "", "color": "#e5484d", "kind": "holiday", "uid": "", "source": "holidays"})
    seen, out = set(), []
    for e in sorted(found, key=lambda e: (e["date"], e["kind"] != "holiday", e["time"], e["title"])):
        key = (e["date"], e["time"], e["title"], e["source"], e["uid"])   # a copy of an event is its own event
        if key not in seen:
            seen.add(key)
            out.append(e)
    return out


def add(cal_uid, title, start, end, location=""):
    EDataServer, ECal, ICalGLib = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    client = connect(ECal, reg, cal_uid)
    zone_name = os.path.realpath("/etc/localtime").split("zoneinfo/")[-1]
    zone = ICalGLib.Timezone.get_builtin_timezone(zone_name)
    comp = ECal.Component.new()
    comp.set_new_vtype(ECal.ComponentVType.EVENT)
    comp.set_uid(str(uuid.uuid4()))

    def at(text):
        whole = "T" not in text
        t = ICalGLib.Time.new_from_string(text.replace("-", "").replace(":", "") + ("" if whole else "00"))
        if not whole:
            t.set_timezone(zone)
        return ECal.ComponentDateTime.new(t, None if whole else zone_name)
    comp.set_dtstart(at(start))
    comp.set_dtend(at(end))
    comp.set_summary(ECal.ComponentText.new(title, None))
    if location:
        comp.set_location(location)
    comp.commit_sequence()
    ok, uid = client.create_object_sync(comp.get_icalcomponent(), ECal.OperationFlags.NONE, None)
    return {"ok": bool(ok), "uid": uid or ""}


def update(cal_uid, event_uid, change):
    """An event changed: any of title, start, end (as add takes them), location, notes, color, url ("" takes them off),
    free (true: shows as free), private, alarms (minutes before the start), repeat (an RRULE, UNTIL=YYYY-MM-DD allowed; "" for none); of a repeating event,
    scope "this" | "future" | "all" with the occurrence's rid and its start before the change (orig)."""
    EDataServer, ECal, ICalGLib = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    client = connect(ECal, reg, cal_uid)
    # which of a repeating event: this one, this and those after it, or all (the default); "rid" says which one, "orig"
    # the start it had, so that a change of all moves the series by as much as the one was moved
    scope, rid, orig = change.pop("scope", "all"), change.pop("rid", ""), change.pop("orig", "")
    if scope in ("this", "future") and not rid:
        raise SystemExit("latte-cal: scope %s needs the occurrence's rid" % scope)
    mod = {"this": ECal.ObjModType.THIS, "future": ECal.ObjModType.THIS_AND_FUTURE}.get(scope, ECal.ObjModType.ALL)
    ok, icomp = client.get_object_sync(event_uid, rid if scope != "all" and rid else None, None)
    comp = ECal.Component.new_from_icalcomponent(icomp)
    zone_name = os.path.realpath("/etc/localtime").split("zoneinfo/")[-1]
    zone = ICalGLib.Timezone.get_builtin_timezone(zone_name)

    def at(text):
        whole = "T" not in text
        t = ICalGLib.Time.new_from_string(text.replace("-", "").replace(":", "") + ("" if whole else "00"))
        if not whole:
            t.set_timezone(zone)
        return ECal.ComponentDateTime.new(t, None if whole else zone_name)
    if "title" in change:
        comp.set_summary(ECal.ComponentText.new(change["title"], None))
    def local(t):
        return dt.datetime.fromtimestamp(t.as_timet_with_zone(t.get_timezone()) if t.get_timezone() else t.as_timet())
    if scope != "all" and "start" not in change and "end" not in change:
        # EDS hands over an occurrence with the series' own times: it begins where its rid says, as long as the series did
        t0 = dt.datetime.strptime(rid[:15] if "T" in rid else rid + "T000000", "%Y%m%dT%H%M%S")
        if rid.endswith("Z"):
            t0 = t0.replace(tzinfo=dt.timezone.utc).astimezone().replace(tzinfo=None)
        a0, b0 = icomp.get_dtstart(), icomp.get_dtend()
        whole = a0.is_date()
        if whole:
            b0 = dt.datetime.combine(start_date(b0), dt.time()); a0 = dt.datetime.combine(start_date(a0), dt.time())
        else:
            a0, b0 = local(a0), local(b0)
        fmt = "%Y-%m-%d" if whole else "%Y-%m-%dT%H:%M"
        change["start"], change["end"] = t0.strftime(fmt), (t0 + (b0 - a0)).strftime(fmt)
    if scope == "all" and orig and "start" in change and "end" in change and rid:
        # the series keeps its own first day: move it by the distance the shown one moved
        def whole(t): return dt.datetime.strptime(t if "T" in t else t + "T00:00", "%Y-%m-%dT%H:%M")
        delta = whole(change["start"]) - whole(orig)
        old = icomp.get_dtstart(), icomp.get_dtend()
        first = dt.datetime.fromtimestamp(old[0].as_timet_with_zone(old[0].get_timezone()) if old[0].get_timezone() else old[0].as_timet())
        length = whole(change["end"]) - whole(change["start"])
        first = first.replace(tzinfo=None) + delta
        fmt = "%Y-%m-%d" if "T" not in change["start"] else "%Y-%m-%dT%H:%M"
        change["start"], change["end"] = first.strftime(fmt), (first + length).strftime(fmt)
    if "start" in change:
        comp.set_dtstart(at(change["start"]))
    if "end" in change:
        comp.set_dtend(at(change["end"]))
    if "location" in change:
        comp.set_location(change["location"] or None)
    if "notes" in change:
        comp.set_descriptions([ECal.ComponentText.new(change["notes"], None)] if change["notes"] else [])
    comp.commit_sequence()
    icomp = comp.get_icalcomponent()

    def reset(kind, new=None):
        while icomp.get_first_property(kind):
            icomp.remove_property(icomp.get_first_property(kind))
        if new is not None:
            icomp.add_property(new)
    if "free" in change:      # Google's "busy / free": TRANSP, as Evolution writes it
        reset(ICalGLib.PropertyKind.TRANSP_PROPERTY, ICalGLib.Property.new_transp(ICalGLib.PropertyTransp.TRANSPARENT if change["free"] else ICalGLib.PropertyTransp.OPAQUE))
    if "private" in change:   # "private / default visibility": CLASS
        reset(ICalGLib.PropertyKind.CLASS_PROPERTY, ICalGLib.Property.new_class(ICalGLib.Property_Class.PRIVATE if change["private"] else ICalGLib.Property_Class.PUBLIC))
    if "repeat" in change and scope != "this":      # "" makes it a single event; a single occurrence has no rule of its own
        whole = icomp.get_dtstart().is_date()
        reset(ICalGLib.PropertyKind.RRULE_PROPERTY, ICalGLib.Property.new_rrule(rule_for(change["repeat"], whole, ICalGLib, zone)) if change["repeat"] else None)
    if "alarms" in change:    # reminders: minutes before the start, as Google's "notification"; all are written afresh
        a = icomp.get_first_component(ICalGLib.ComponentKind.VALARM_COMPONENT)
        while a:
            icomp.remove_component(a)
            a = icomp.get_first_component(ICalGLib.ComponentKind.VALARM_COMPONENT)
        for n in sorted({int(x) for x in change["alarms"] if int(x) >= 0}):
            icomp.add_component(ICalGLib.Component.new_from_string(
                "BEGIN:VALARM\r\nACTION:DISPLAY\r\nDESCRIPTION:Reminder\r\nTRIGGER:%s\r\nEND:VALARM\r\n" % ("-PT%dM" % n if n else "PT0S")))
    if "url" in change:       # the video call's address (Meet, Teams, Zoom); "" takes it off
        reset(ICalGLib.PropertyKind.URL_PROPERTY, ICalGLib.Property.new_url(change["url"]) if change["url"] else None)
    if "color" in change:
        # iCalendar's COLOR on the event itself (RFC 7986), as Evolution writes it; "" takes it off
        while icomp.get_first_property(ICalGLib.PropertyKind.COLOR_PROPERTY):
            icomp.remove_property(icomp.get_first_property(ICalGLib.PropertyKind.COLOR_PROPERTY))
        if change["color"]:
            icomp.add_property(ICalGLib.Property.new_color(change["color"]))
    client.modify_object_sync(icomp, mod, ECal.OperationFlags.NONE, None)
    return {"ok": True}


UNDO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "latte-cal-undo.json")


def remove(cal_uid, event_uid, scope="all", rid=""):
    """Takes an event out (of a repeating one: this occurrence, it and the ones after, or all) and keeps the whole event
    (one level) so `undo` can put it back."""
    EDataServer, ECal, _ = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    client = connect(ECal, reg, cal_uid)
    ok, icomp = client.get_object_sync(event_uid, None, None)
    if ok:
        with open(UNDO, "w") as f:
            json.dump({"calendar": cal_uid, "ical": icomp.as_ical_string()}, f)
    if scope in ("this", "future") and not rid:
        raise SystemExit("latte-cal: scope %s needs the occurrence's rid" % scope)
    mod = {"this": ECal.ObjModType.THIS, "future": ECal.ObjModType.THIS_AND_FUTURE}.get(scope, ECal.ObjModType.ALL)
    client.remove_object_sync(event_uid, rid if scope != "all" and rid else None, mod, ECal.OperationFlags.NONE, None)
    return {"ok": True}


def create(cal_uid, ical, same_uid=False):
    """An event written as iCalendar goes into the calendar; a new UID unless it is the one taken out."""
    EDataServer, ECal, ICalGLib = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    client = connect(ECal, reg, cal_uid)
    icomp = ICalGLib.Component.new_from_string(ical)
    if not same_uid:
        icomp.set_uid(str(uuid.uuid4()))
    ok, uid = client.create_object_sync(icomp, ECal.OperationFlags.NONE, None)
    return {"ok": bool(ok), "uid": uid or ""}


def undo():
    if not os.path.exists(UNDO):
        return {"ok": False}
    with open(UNDO) as f:
        kept = json.load(f)
    EDataServer, ECal, ICalGLib = eds()
    client = connect(ECal, EDataServer.SourceRegistry.new_sync(None), kept["calendar"])
    uid = ICalGLib.Component.new_from_string(kept["ical"]).get_uid()
    if _exists(client, uid):      # a part of a series was taken out: the whole series is written over what is left
        client.modify_object_sync(ICalGLib.Component.new_from_string(kept["ical"]), ECal.ObjModType.ALL, ECal.OperationFlags.NONE, None)
        r = {"ok": True, "uid": uid}
    else:
        r = create(kept["calendar"], kept["ical"], same_uid=True)
    os.remove(UNDO)
    return r


def _exists(client, uid):
    try:
        client.get_object_sync(uid, None, None)
        return True
    except Exception:
        return False


def duplicate(cal_uid, event_uid, to_uid=None):
    """A copy of an event (in another calendar when TO is given); `move` is a duplicate and a removal."""
    EDataServer, ECal, _ = eds()
    reg = EDataServer.SourceRegistry.new_sync(None)
    ok, icomp = connect(ECal, reg, cal_uid).get_object_sync(event_uid, None, None)
    return create(to_uid or cal_uid, icomp.as_ical_string()) if ok else {"ok": False}


def move(cal_uid, event_uid, to_uid):
    r = duplicate(cal_uid, event_uid, to_uid)
    if r["ok"]:
        EDataServer, ECal, _ = eds()
        reg = EDataServer.SourceRegistry.new_sync(None)
        connect(ECal, reg, cal_uid).remove_object_sync(event_uid, None, ECal.ObjModType.ALL, ECal.OperationFlags.NONE, None)
    return r


# ── reminders: the ones that have come due are told, also when no window is open ────────────────────────────────
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "cal-alarms.json")
LATE = dt.timedelta(minutes=15)       # a reminder missed by more than this (asleep, off) is not told, it would only be old news
SNOOZE = dt.timedelta(minutes=10)


def tr(text):
    """What the notification says, in the desktop's language: the same table as the scenes' (goo/lang/LANG.plm)."""
    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2]
    try:
        with open(os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "goo", "lang", lang + ".plm"), encoding="utf-8") as f:
            m = re.search(r'^\s*"%s"\s*=\s*"((?:[^"\\]|\\.)*)"' % re.escape(text), f.read(), re.M)
            return m.group(1) if m else text
    except OSError:
        return text


def load_state():
    try:
        with open(STATE) as f:
            st = json.load(f)
        return {"fired": dict(st.get("fired", {})), "snoozed": dict(st.get("snoozed", {}))}
    except (OSError, ValueError):
        return {"fired": {}, "snoozed": {}}


def save_state(st, now):
    old = (now - dt.timedelta(days=3)).timestamp()
    st["fired"] = {k: v for k, v in st["fired"].items() if v > old}
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump(st, f)
    os.replace(STATE + ".tmp", STATE)


def due(now, st):
    """The reminders to tell now: [(key, event)]. What is told or too old to tell is marked in `st`."""
    out = []
    for e in account_events(now - dt.timedelta(days=1), now + dt.timedelta(days=8)):
        if not e.get("alarms") or e["kind"] != "event":
            continue
        fmt = "%Y-%m-%dT%H:%M" if e["time"] else "%Y-%m-%d"
        start, finish = dt.datetime.strptime(e["start"], fmt), dt.datetime.strptime(e["finish"], fmt)
        for m in e["alarms"]:
            key = "%s/%s/%s/%d" % (e["source"], e["uid"], e["start"], m)
            if key in st["fired"]:
                continue
            if key in st["snoozed"]:
                if st["snoozed"][key] > now.timestamp():
                    continue
                del st["snoozed"][key]
                out.append((key, e, start))
            elif start - dt.timedelta(minutes=m) <= now:
                if now - (start - dt.timedelta(minutes=m)) < LATE and now < finish:
                    out.append((key, e, start))
            else:
                continue
            st["fired"][key] = now.timestamp()
    return out


def tell(key, e, start, now, st, lock):
    """One notification, with Open and Snooze; waits for the answer (a thread of its own)."""
    mins = round((start - now).total_seconds() / 60)
    if not e["time"]:
        when = tr("all day")
    elif mins >= 90:
        when = tr("in {n} h").replace("{n}", str(round(mins / 60)))
    elif mins > 0:
        when = tr("in {n} min").replace("{n}", str(mins))
    else:
        when = tr("now")
    body = " · ".join(x for x in (when + ((" · " + e["time"] + (" – " + e["end"] if e["end"] else "")) if e["time"] else ""), e["location"]) if x)
    try:
        r = subprocess.run(["notify-send", "-a", "LatteOS", "-i", "appointment-soon", "-c", "calendar", "-A", "open=" + tr("Open"),
                            "-A", "snooze=" + tr("Snooze 10 min"), e["title"], body], capture_output=True, text=True, timeout=3600)
    except (OSError, subprocess.TimeoutExpired):
        return
    if r.stdout.strip() == "snooze":
        with lock:
            st["snoozed"][key] = (dt.datetime.now() + SNOOZE).timestamp()
            st["fired"].pop(key, None)
            save_state(st, dt.datetime.now())
    elif r.stdout.strip() == "open":
        subprocess.Popen(["latte-app", "calendar", e["date"], e["source"], e["uid"]], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch(once=False):
    """Every half minute: what has come due is told. A service of the session (latte-calwatch.service)."""
    import threading
    import time
    lock = threading.Lock()
    st = load_state()
    while True:
        now = dt.datetime.now()
        try:
            with lock:
                told = due(now, st)
                save_state(st, now)
            for key, e, start in told:
                threading.Thread(target=tell, args=(key, e, start, now, st, lock), daemon=True).start()
        except Exception as ex:      # EDS not up yet, or a calendar that cannot be read: the next round
            print("latte-cal: watch:", ex, file=sys.stderr)
        if once:
            time.sleep(2)            # a moment for the notifications to be sent
            return
        time.sleep(30)


# ── a new event written as a sentence ─────────────────────────────────────────────────────────────────────────────
# The words are the language's (goo/lang/<code>-dates.json): today/tomorrow, weekdays, dates, "at 12", "from 14 to 15",
# "for 2 hours", the place after its preposition. ponytail: a sentence the words do not cover is the local AI's to read
# (ROADMAP 17g), not yet.
def words(lang=None):
    lang = lang or (os.environ.get("LC_ALL") or os.environ.get("LANG") or "sk").split("_")[0].split(".")[0]
    for d in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "goo", "lang"),
              os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "goo", "lang")):
        for code in (lang, "sk"):
            try:
                with open(os.path.join(d, code + "-dates.json"), encoding="utf-8") as f:
                    return json.load(f)
            except OSError:
                pass
    return None


def alt(xs):
    return "|".join(re.escape(x) for x in sorted(xs, key=len, reverse=True))


def month_part(part, today):
    """end, start or middle of the month, or of the next one ("_next"), on a working day; one already past is the next month's."""
    def at(y, mo):
        if part.startswith("end"):
            d = dt.date(y + mo // 12, mo % 12 + 1, 1) - dt.timedelta(days=1)
            return d - dt.timedelta(days=max(0, d.weekday() - 4))
        d = dt.date(y, mo, 15 if part.startswith("middle") else 1)
        return d + dt.timedelta(days=(7 - d.weekday()) % 7 if d.weekday() > 4 else 0)
    y, mo = today.year, today.month
    if part.endswith("_next"):
        y, mo = (y + 1, 1) if mo == 12 else (y, mo + 1)
    d = at(y, mo)
    return d if d >= today else at(*((y + 1, 1) if mo == 12 else (y, mo + 1)))


def parse(text, today=None, w=None, default=None):
    today, w = today or dt.date.today(), w or words()
    if not w:
        return {"ok": False}
    rest, day, start, end, long = " " + text.strip() + " ", None, None, None, None

    def cut(m):
        nonlocal rest
        rest = rest[:m.start()] + " " + rest[m.end():]
    low = lambda: rest.lower()
    for word, n in w["relative"].items():
        m = re.search(r"\s" + re.escape(word) + r"\b", low())
        if m:
            day = today + dt.timedelta(days=n)
            cut(m)
            break
    wd = r"(?:(?:" + alt(w["before_weekday"]) + r")\s)*(" + alt(w["weekdays"]) + r")"
    # in two weeks (on Tuesday): that week's day, else the same day of the week
    num = r"(\d+|" + alt(w["numbers"]) + r")"
    m = re.search(r"\s(?:" + alt(w["at"]) + r")\s(?:" + num + r"\s)?(" + alt(w["days"] + w["weeks"]) + r")\b(?:\s" + wd + r"\b)?", low())
    if not day and m:
        n = int(w["numbers"].get(m.group(1), m.group(1) or 1))
        day = today + dt.timedelta(days=n * (7 if m.group(2) in w["weeks"] else 1))
        if m.group(3):
            day += dt.timedelta(days=w["weekdays"][m.group(3)] - day.weekday())
        cut(m)
    # the last Friday of the month
    m = re.search(r"\s(?:" + alt(w["last"]) + r")\s(" + alt(w["weekdays"]) + r")\s(?:" + alt(w["of_month"]) + r")\b", low())
    if not day and m:
        k = w["weekdays"][m.group(1)]
        for y, mo in ((today.year, today.month), (today.year + today.month // 12, today.month % 12 + 1)):
            d = dt.date(y + mo // 12, mo % 12 + 1, 1) - dt.timedelta(days=1)
            day = d - dt.timedelta(days=(d.weekday() - k) % 7)
            if day >= today:
                break
        cut(m)
    m = re.search(r"\s" + wd + r"\b", low())
    if not day and m:
        day = today + dt.timedelta(days=(w["weekdays"][m.group(1)] - today.weekday()) % 7 or 7)
        cut(m)
    m = re.search(r"\s(\d{1,2})\.\s?(\d{1,2})\.(?:\s?(\d{4}))?", rest)
    if not day and m:
        try:
            day = dt.date(int(m.group(3) or today.year), int(m.group(2)), int(m.group(1)))
            day = day if m.group(3) or day >= today else day.replace(year=day.year + 1)
            cut(m)
        except ValueError:
            pass
    m = re.search(r"\s(\d{1,2})\.\s?(" + alt(w["months"]) + r")\b", low())
    if not day and m:
        day = dt.date(today.year, w["months"][m.group(2)], int(m.group(1)))
        day = day if day >= today else day.replace(year=day.year + 1)
        cut(m)
    # a part of a month: its end is its last working day, its beginning the first one (of the next month, once it is past)
    m = re.search(r"\s(" + alt(w["month_parts"]) + r")\b", low())
    if not day and m:
        day = month_part(w["month_parts"][m.group(1)], today)
        cut(m)
    hm = r"(\d{1,2})(?:[:.](\d{2}))?"
    m = re.search(r"\s(?:(?:" + alt(w["at"]) + r")\s)?" + hm + r"\s?(?:-|–|(?:" + alt(w["until"]) + r")\s)\s?" + hm + r"\b", low())
    if m:
        start, end = dt.time(int(m.group(1)) % 24, int(m.group(2) or 0)), dt.time(int(m.group(3)) % 24, int(m.group(4) or 0))
        cut(m)
    else:
        m = re.search(r"\s(?:" + alt(w["at"]) + r")\s" + hm + r"(?:\s?h\.?)?\b", low()) or re.search(r"\s(\d{1,2}):(\d{2})\b", low())
        if m:
            start = dt.time(int(m.group(1)) % 24, int(m.group(2) or 0))
            cut(m)
    # the hour in words: "o deviatej", "pol siedmej" (half to seven: 6:30)
    m, said = re.search(r"\s(?:(?:" + alt(w["at"]) + r")\s)?(?:(" + alt(w["half"]) + r")\s)?(" + alt(w["hour_words"]) + r")\b", low()), None
    if start is None and m:
        said = w["hour_words"][m.group(2)]
        start = dt.time((said - 1 or 12) if m.group(1) else said, 30 if m.group(1) else 0)
        cut(m)
    # the part of the day: in the evening 7 is 19:00; an hour said in words from 1 to 6, with none, is in the afternoon
    pm = re.search(r"\s(" + alt(w["pm"]) + r")\b", low())
    am = re.search(r"\s(" + alt(w["am"]) + r")\b", low())
    if start is not None and start.hour < 12 and (pm or (said is not None and said <= 6 and not am)):
        start = start.replace(hour=start.hour + 12)
    for x in (pm, am):
        if x and start is not None:
            cut(re.search(r"\s" + re.escape(x.group(1)) + r"\b", low()))
    m = re.search(r"\s(?:" + alt(w["for"]) + r")\s(\d+|" + alt(w["one_hour"] + w["half_hour"]) + r")\s?(" + alt(w["hours"] + w["minutes"]) + r")?\b", low())
    if m and start:
        n = 0.5 if m.group(1) in w["half_hour"] else (1 if m.group(1) in w["one_hour"] else int(m.group(1)))
        long = dt.timedelta(minutes=n) if m.group(2) in w["minutes"] else dt.timedelta(hours=n)
        cut(m)
    # the place: a word with a capital after its preposition, to the end
    place = ""
    m = re.search(r"\s(?:" + alt(w["place"]) + r")\s(\S[^,]*?)\s*$", rest)
    if m and m.group(1)[0].isupper():
        place = m.group(1).strip()
        cut(m)
    title = re.sub(r"\s+", " ", rest).strip(" ,.-")
    if not title:
        return {"ok": False}
    # sure: a day or a time was read, and no word of time is left in the title (evening, half past, the end of the month…)
    sure = (day is not None or start is not None or default is not None) and not re.search(r"(?:^|\s)(?:" + alt(w["time_words"]) + r")\b", title.lower())
    day = day or default or today          # a sentence with no day goes to the day chosen in the calendar
    allday = start is None
    if allday:
        s_, e_ = day.isoformat(), (day + dt.timedelta(days=1)).isoformat()
    else:
        a = dt.datetime.combine(day, start)
        b = dt.datetime.combine(day, end) if end else a + (long or dt.timedelta(hours=1))
        if b <= a:
            b += dt.timedelta(days=1)
        s_, e_ = a.strftime("%Y-%m-%dT%H:%M"), b.strftime("%Y-%m-%dT%H:%M")
    return {"ok": True, "title": title[0].upper() + title[1:], "start": s_, "end": e_, "allday": allday, "place": place, "sure": sure}


# A sentence the words did not find a day or a time in goes to the AI on this computer (latte-ai quick): asked only
# when the event is to be added, and what it read is shown before it is.
ASK = """Today is {weekday} {today}. Turn the calendar event below into JSON with exactly these keys:
title (the event in the sentence's own language, without when and where), date (YYYY-MM-DD), start (HH:MM, or "" if no time), end (HH:MM or ""), place ("" if none).
The next six weeks, to take the date from (do not count it): {days}
The end of a month is its last working day, its beginning the first one.
Example: "Obed s Petrom v piatok o 12 v Jihlavanke" -> {{"title": "Obed s Petrom", "date": "{friday}", "start": "12:00", "end": "", "place": "Jihlavanka"}}
Event: "{text}"
JSON:"""


def ai_read(text, today=None):
    today = today or dt.date.today()
    try:
        out = subprocess.run(["latte-ai", "quick", "--for", "calendar-ai", ASK.format(today=today.isoformat(), weekday=today.strftime("%A"), text=text.replace('"', "'"),
                                                     friday=(today + dt.timedelta(days=(4 - today.weekday()) % 7 or 7)).isoformat(),
                                                     days=", ".join((today + dt.timedelta(days=i)).strftime("%a %Y-%m-%d") for i in range(42)))],
                             capture_output=True, text=True, timeout=180).stdout
        j = json.loads(out[out.index("{"):out.rindex("}") + 1])
        day = dt.date.fromisoformat(j["date"])
        title = str(j.get("title") or "").strip()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return None
    if not title:
        return None
    hm = lambda v: dt.time.fromisoformat(v) if re.fullmatch(r"\d{1,2}:\d{2}", str(v or "")) else None
    start, end = hm(j.get("start")), hm(j.get("end"))
    if start is None:
        s_, e_ = day.isoformat(), (day + dt.timedelta(days=1)).isoformat()
    else:
        a = dt.datetime.combine(day, start)
        b = dt.datetime.combine(day, end) if end else a + dt.timedelta(hours=1)
        b = b if b > a else b + dt.timedelta(days=1)
        s_, e_ = a.strftime("%Y-%m-%dT%H:%M"), b.strftime("%Y-%m-%dT%H:%M")
    return {"ok": True, "title": title[0].upper() + title[1:], "start": s_, "end": e_, "allday": start is None, "place": str(j.get("place") or "").strip(),
            "sure": True, "ai": True}


def command(a):
    today = dt.datetime.combine(dt.date.today(), dt.time())
    if a[0] == "events":
        first, last, rest = today - dt.timedelta(days=31), today + dt.timedelta(days=366), a[1:]
        while rest[:1] in (["--from"], ["--to"]) and len(rest) > 1:
            d = dt.datetime.strptime(rest[1], "%Y-%m-%d")
            if rest[0] == "--from": first = d
            else: last = d + dt.timedelta(days=1)
            rest = rest[2:]
        print(json.dumps(all_events(first, last, rest), ensure_ascii=False))
    elif a == ["calendars"]:
        print(json.dumps(calendars(), ensure_ascii=False))
    elif a[0] == "add" and len(a) in (5, 6):
        print(json.dumps(add(*a[1:])))
    elif a[0] == "parse" and len(a) >= 2:
        opts = a[1:-1]
        default = dt.date.fromisoformat(opts[opts.index("--day") + 1]) if "--day" in opts and opts.index("--day") + 1 < len(opts) else None
        r = parse(a[-1], default=default)
        if "--ai" in opts and not r.get("sure"):
            r = ai_read(a[-1]) or dict(r, ai_failed=True)
        if r["ok"]:
            # where it goes: the first calendar of an account that may be written to, else this computer's own
            cals = [c for c in calendars() if c["writable"] and c["enabled"]]
            pick = next((c for c in cals if c["backend"] != "local"), cals[0] if cals else None)
            r["calendar"], r["calendar_name"] = (pick["uid"], (pick["account"] + " · " if pick["account"] and pick["backend"] != "local" else "") + pick["name"]) if pick else ("", "")
        print(json.dumps(r, ensure_ascii=False))
    elif a[0] == "update" and len(a) == 4:
        change = json.loads(a[3])
        if not isinstance(change, dict) or set(change) - {"title", "start", "end", "location", "notes", "color", "url", "free", "private", "repeat", "alarms", "scope", "rid", "orig"}:
            return 2
        print(json.dumps(update(a[1], a[2], change)))
    elif a[0] == "remove" and len(a) in (3, 5):
        print(json.dumps(remove(*a[1:])))
    elif a == ["tasklists"]:
        print(json.dumps(task_lists(), ensure_ascii=False))
    elif a[0] == "tasklist-show" and len(a) == 3:
        print(json.dumps(task_list_shown(a[1], a[2] == "on")))
    elif a[0] == "add-account" and len(a) in (4, 5):
        # the password comes on the standard input, so that it is not seen in the list of processes
        print(json.dumps(add_account(a[1], a[2], a[3], a[4] if len(a) > 4 else "", sys.stdin.readline().rstrip("\n") if len(a) > 4 else "")))
    elif a[0] == "remove-account" and len(a) == 2:
        print(json.dumps(remove_account(a[1])))
    elif a[:1] == ["watch"]:
        watch(once=a[1:] == ["--once"])
    elif a == ["undo"]:
        print(json.dumps(undo()))
    elif a[0] == "duplicate" and len(a) == 3:
        print(json.dumps(duplicate(a[1], a[2])))
    elif a[0] == "move" and len(a) == 4:
        print(json.dumps(move(a[1], a[2], a[3])))
    elif a[0] == "holidays":
        year = int(a[1]) if len(a) > 1 else today.year
        print(json.dumps([{"date": d.isoformat(), "name": n} for d, n in sorted(holidays_of([year]).items())], ensure_ascii=False))
    elif a == ["accounts"]:
        subprocess.Popen(["gnome-online-accounts-gtk"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        return 2
    return 0


def main(addresses):
    if addresses and addresses[0] in ("events", "calendars", "add", "update", "remove", "tasklists", "tasklist-show", "add-account", "remove-account", "watch", "undo", "duplicate", "move", "holidays", "accounts", "parse"):
        return command(addresses)
    if not addresses or addresses[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if addresses else 2
    today = dt.datetime.combine(dt.date.today(), dt.time())
    first, last = today - dt.timedelta(days=31), today + dt.timedelta(days=366)
    found = []
    for a in addresses:
        try:
            found += events(fetch(a), first, last)
        except Exception as e:
            print(f"latte-cal: {a}: {e}", file=sys.stderr)
    seen, out = set(), []
    for e in sorted(found, key=lambda e: (e["date"], e["time"], e["title"])):
        key = (e["date"], e["time"], e["title"])
        if key not in seen:
            seen.add(key)
            out.append(e)
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
