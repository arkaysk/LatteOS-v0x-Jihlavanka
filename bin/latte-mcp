#!/usr/bin/env python3
"""latte-mcp: LatteOS as one MCP server, the AI layer every agent shares (docs/lensai/NAVRH-MCP.md, ROADMAP 10B.43).
It knows nothing itself: each tool is a thin cover over a command that is there already (latte-ai, pleamar-wm).

  latte-mcp                 serves on stdio: what an agent's tool (Claude Code, Codex, Gemini CLI) starts
  latte-mcp --lazy          the same, behind three tools (find_tools, describe_tool, call_tool): a model with a small
                            window gets ~300 tokens of tools instead of every schema, and opens what it needs
  latte-mcp http [PORT]     the same over HTTP on 127.0.0.1 (8791), for Agent Chats: a request needs the token of
                            ~/.config/latteos/mcp-token (Authorization: Bearer …), made the first time, readable by the user alone
  latte-mcp gate            serves one tool, `approve`: Claude Code's --permission-prompt-tool in LensAI's conversations,
                            where it may look on the web only when the person allows it there (bin/latte-ai claude)
  latte-mcp install|remove  writes it into, or takes it out of, the agents installed here, for this user
  latte-mcp status          {"ai", "agents": [{"id", "name", "installed", "has"}]}: which agents have it
  latte-mcp store [WORDS]   LensAI's MCP store: {"latteos": LatteOS's picks, "agentgram": agentgram's whole offer, "docker":
                            Docker's checked catalog (images run with podman; the most pulled, or for WORDS), "registry":
                            the official MCP registry's servers for WORDS, "mine": those installed, each with the tools it is given to}
  latte-mcp add ID          installs one (stdin: {"entry" (a registry one as the store gave it), "values": the fields it asks})
  latte-mcp give ID claude|chatgpt|gemini on|off   gives an installed one to that agent's tool, or takes it back
  latte-mcp remove ID       takes it back from every tool, uninstalls and forgets it
  latte-mcp servers         every MCP server the agents are given (their user settings), by name: [{"name", "how" (the
                            command line or the URL), "clients": ["Claude Code", "Codex", "Gemini CLI"]}]; never env or headers

It reads: the conversations kept in LensAI, who can answer and what is left of the limits, the agents at work and the
windows open. And it changes what bin/latte-skill names (the Wi-Fi, the volume, the brightness…), each change only
after the person allowed it in LensAI: the confirmation is LatteOS's, never the agent's own.
`ask` puts one question to another AI (latte-ai send): the one asked gets no tools and cannot ask on.
With the AI turned off (Settings › AI) it serves nothing. Every call is written to the journal: journalctl -t latte-mcp.
"""
import json
import os
import shutil
import subprocess
import sys

NAME = "latteos"
# the desktop's services have a short PATH: the user's own tools live in ~/.local/bin and beside (as bin/latte-ai)
SEARCH = os.pathsep.join([os.environ.get("PATH", "/usr/local/bin:/usr/bin"), os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"),
                          os.path.expanduser("~/.local/share/mise/shims")])
# how each agent is told of a server, and how it forgets one
AGENTS = {
    "claude": {"name": "Claude Code", "tool": "claude", "add": ["mcp", "add", "--scope", "user", NAME, "--", "latte-mcp"],
               "remove": ["mcp", "remove", "--scope", "user", NAME]},
    "chatgpt": {"name": "Codex", "tool": "codex", "add": ["mcp", "add", NAME, "--", "latte-mcp"], "remove": ["mcp", "remove", NAME]},
    "gemini": {"name": "Gemini", "tool": "gemini", "add": ["mcp", "add", "--scope", "user", NAME, "latte-mcp"],
               "remove": ["mcp", "remove", "--scope", "user", NAME]},
}


def turned_off():
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai")) as f:
            return f.read().strip() == "off"
    except OSError:
        return False


def told(argv, lines=False, timeout=30, **env):
    """What a command of LatteOS answers, as JSON (or a JSON object a line); an error is said, not thrown at the agent."""
    if turned_off():
        return {"error": "the AI of LatteOS is turned off (Settings › AI)"}
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=dict(os.environ, PATH=SEARCH, **env)).stdout
        return [json.loads(l) for l in out.splitlines() if l.strip()] if lines else json.loads(out)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": "%s: %s" % (argv[0], e)}


CALLER = {}       # who calls, when a tool is reached through call_tool (--lazy): its own Context is not that request's


def caller(ctx):
    try:
        return CALLER.get("name") or ctx.session.client_params.clientInfo.name
    except (AttributeError, ValueError):
        return "AI"


def logged(f):
    """Each call into the journal, with who, what and whether it answered or failed (ROADMAP 10B.68: for GuardCorgi
    and for what was done when)."""
    import functools
    import syslog

    import inspect

    def note(k, out):
        bad = (isinstance(out, dict) and "error" in out) or (isinstance(out, str) and out.startswith('{"error"'))
        syslog.openlog("latte-mcp")
        syslog.syslog("%s %s %s %s" % (caller(k.get("ctx")), f.__name__, json.dumps({x: y for x, y in k.items() if x != "ctx"}, ensure_ascii=False)[:300],
                                       "failed" if bad else "answered"))

    if inspect.iscoroutinefunction(f):
        @functools.wraps(f)
        async def acall(*a, **k):
            out = await f(*a, **k)
            note(k, out)
            return out
        return acall

    @functools.wraps(f)
    def call(*a, **k):
        out = f(*a, **k)
        note(k, out)
        return out
    return call


def score(query, tools):
    """The tools best for the words, by BM25 over each one's name and description (the search of swarmclawai/mcp-gateway's
    mcp_tool_search, MIT, written anew): [(score, tool)], the best first, those that share no word left out."""
    import math
    import re
    words = lambda t: re.findall(r"[a-z0-9]+", t.lower())
    docs = [words(t["name"].replace("_", " ") + " " + t["description"]) for t in tools]
    avg, q = sum(map(len, docs)) / max(1, len(docs)), set(words(query))
    idf = {w: math.log(1 + (len(docs) - sum(w in d for d in docs) + 0.5) / (sum(w in d for d in docs) + 0.5)) for w in q}
    found = [(sum(idf[w] * d.count(w) * 2.2 / (d.count(w) + 1.2 * (0.25 + 0.75 * len(d) / avg)) for w in q), t) for t, d in zip(tools, docs)]
    return sorted([f for f in found if f[0] > 0], key=lambda f: -f[0])


def allowed(ctx, what, detail):
    """The person's word in LensAI before an AI reads their conversations or windows or asks another AI (user 17. 11.):
    None when allowed, else what to answer the agent."""
    who = caller(ctx)
    r = told(["latte-skill", "allow", what, detail, "--by", who], timeout=150)
    return None if isinstance(r, dict) and r.get("answer") == "yes" else {"error": "the user did not allow it", **(r if isinstance(r, dict) else {})}


def run(tool, args):
    try:
        return subprocess.run([shutil.which(tool, path=SEARCH) or tool] + args, capture_output=True, text=True, timeout=30,
                              env=dict(os.environ, PATH=SEARCH))
    except (OSError, subprocess.TimeoutExpired):
        return None


def status():
    out = []
    for i, a in AGENTS.items():
        there = shutil.which(a["tool"], path=SEARCH) is not None
        listed = run(a["tool"], ["mcp", "list"]) if there else None
        out.append({"id": i, "name": a["name"], "installed": there, "has": bool(listed and NAME in listed.stdout + listed.stderr)})
    return {"ai": not turned_off(), "agents": out}


def servers():
    """Every MCP server the agents' own settings give them, by name: [{"name", "how" (command line or URL), "clients"}].
    Only the user's scope (Claude Code keeps a project's own under "projects"); env and headers are never read out."""
    import tomllib
    found = {}

    def read(path, toml=False):
        try:
            with open(os.path.expanduser(path), "rb") as f:
                got = tomllib.load(f) if toml else json.load(f)
                return got if isinstance(got, dict) else {}
        except (OSError, ValueError):
            return {}

    def shown(s):
        """What it is, without what may be a secret: a URL's scheme and host, a command's name and its arguments, those
        after a key, token or secret flag (or holding one) masked."""
        import re
        import urllib.parse
        url = s.get("url") or s.get("httpUrl")
        if url:
            u = urllib.parse.urlsplit(str(url))
            return "%s://%s" % (u.scheme, u.hostname or "")
        words, hide = [os.path.basename(str(s.get("command", "")))], False
        for x in [str(a) for a in s.get("args") or []]:
            secret = re.search(r"key|token|secret|passw|bearer|auth", x, re.I)
            words.append("•••" if hide or (secret and "=" in x) else x)
            hide = bool(secret) and x.startswith("-") and "=" not in x
        return " ".join(w for w in words if w).strip()
    for client, given in (("Claude Code", read("~/.claude.json").get("mcpServers")),
                          ("Codex", read("~/.codex/config.toml", toml=True).get("mcp_servers")),
                          ("Gemini CLI", read("~/.gemini/settings.json").get("mcpServers"))):
        for name, s in (given or {}).items():
            s = s if isinstance(s, dict) else {}
            how = shown(s)
            row = found.setdefault(name, {"name": name, "how": how, "clients": []})
            row["clients"].append(client)
    return sorted(found.values(), key=lambda s: s["name"].lower())


# ── LensAI's MCP store (ROADMAP 10B.83; the user, 20. 11.): LatteOS's own picks (system/ai/mcp-store.json), the whole of
# agentgram's (agentes.chat's) offer read from its source, and a search of the official MCP registry. What the user
# installs is kept in mcp-servers.json and given to each agent's tool the user chooses, under its own name.
STORE = os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "ai", "mcp-store.json")
MINE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "mcp-servers.json")
AGENTGRAM_SRC = os.path.expanduser("~/src/agentes-chat")      # ponytail: the fork's source until a built agentgram ships
REGISTRY = "https://registry.modelcontextprotocol.io/v0.1/servers"
GIVEN = {"claude": ("Claude Code", "claude"), "chatgpt": ("Codex", "codex"), "gemini": ("Gemini", "gemini")}


def store_latteos():
    try:
        with open(STORE) as f:
            return [dict(x, source="latteos") for x in json.load(f)["servers"]]      # "home": its project's page
    except (OSError, ValueError, KeyError):
        return []


def store_agentgram():
    """agentgram's offer with whether each connects there now: Composio's only when its server has Composio's key (the
    local server's .env)."""
    try:
        with open(os.path.expanduser("~/.local/share/agentgram/server/.env")) as f:
            ready = any(line.startswith("COMPOSIO_API_KEY=") and line.strip() != "COMPOSIO_API_KEY=" for line in f)
    except OSError:
        ready = False
    return [dict(e, ready=ready or e.get("via") != "composio") for e in agentgram_offer()]


def agentgram_offer():
    """agentgram's offer as its authors keep it (presets.ts), read by bun once per commit of the fork: services reached at
    an address (each signs in on its own page), and those only agentgram reaches (through Composio, its own GitHub app)."""
    import re
    head = run("git", ["-C", AGENTGRAM_SRC, "rev-parse", "HEAD"])
    if not head or head.returncode:
        return []
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "agentgram-store.json")
    try:
        with open(cache) as f:
            got = json.load(f)
        if got["head"] == head.stdout.strip():
            return got["servers"]
    except (OSError, ValueError, KeyError):
        pass
    bun = shutil.which("bun", path=SEARCH + os.pathsep + os.path.expanduser("~/.bun/bin"))
    code = ('import {MCP_PRESETS, composioToolkitOf} from "./packages/engine/src/connectors/presets.ts";'
            'console.log(JSON.stringify(MCP_PRESETS.map(p => ({id: p.id, name: p.label, what: p.description, category: p.category,'
            'icon: p.icon, url: p.serverUrl, soon: !!p.soon, composio: !!composioToolkitOf(p.serverUrl)}))))')
    try:
        r = subprocess.run([bun, "-e", code], cwd=AGENTGRAM_SRC, capture_output=True, text=True, timeout=60) if bun else None
        presets = json.loads(r.stdout) if r and r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        presets = []
    pub = os.path.join(AGENTGRAM_SRC, "apps", "web", "public")
    try:
        with open(os.path.join(AGENTGRAM_SRC, "packages", "engine", "src", "connectors", "listing.ts")) as f:
            brands = dict(re.findall(r'^\s+"?([\w-]+)"?: \{ file: "([\w-]+)"', f.read(), re.M))
    except OSError:
        brands = {}
    # its own words for them in the user's language (agentgram's locale), where it has one
    lang = (os.environ.get("LANG") or "en")[:2]
    try:
        with open(os.path.join(AGENTGRAM_SRC, "packages", "i18n", "src", "locales", lang + ".json")) as f:
            here = json.load(f)["connectors"]["descriptions"]
    except (OSError, ValueError, KeyError):
        here = {}
    out = []
    for p in presets:
        f = brands.get(p["icon"], p["icon"])
        logo = next((x for x in (os.path.join(pub, "connectors", f + ".svg"), os.path.join(pub, "brands", f + ".svg")) if os.path.exists(x)), "")
        out.append({"id": "agentgram-" + p["id"], "name": p["name"], "what": p["what"], "here": here.get(p["id"], ""), "category": p["category"], "logo": logo,
                    "source": "agentgram", "license": "", "only": "agentgram" if p["composio"] else "",
                    "via": "composio" if p["composio"] else "",
                    "soon": p["soon"], "install": {"kind": "remote", "url": p["url"]}})
    out.append({"id": "agentgram-github", "name": "GitHub", "what": "Code, pull requests, issues and Actions.", "here": here.get("github", ""), "category": "dev",
                "logo": os.path.join(pub, "connectors", "github.svg"), "source": "agentgram", "license": "", "only": "agentgram",
                "soon": False, "install": {"kind": "remote", "url": ""}})
    try:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        with open(cache, "w") as f:
            json.dump({"head": head.stdout.strip(), "servers": out}, f)
    except OSError:
        pass
    return out


def store_registry(words, most=30):
    """The official MCP registry's servers for these words, their latest versions: each as the store shows it, with how
    it installs (pypi or npm on stdio, or an address); what this cannot install here says so (`cannot`)."""
    import urllib.parse
    import urllib.request
    url = REGISTRY + "?" + urllib.parse.urlencode({"search": words, "limit": most, "version": "latest"})
    try:
        got = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "LatteOS"}), timeout=15))
    except (OSError, ValueError):
        return []
    out = []
    for item in got.get("servers") or []:
        s = item.get("server") or {}
        pkg = next((p for p in s.get("packages") or [] if p.get("registryType") in ("pypi", "npm")
                    and (p.get("transport") or {}).get("type") == "stdio"), None)
        remote = next((r for r in s.get("remotes") or [] if r.get("type") in ("streamable-http", "sse") and r.get("url")), None)
        if pkg:
            fields = [{"id": e["name"], "label": e.get("description") or e["name"], "secret": bool(e.get("isSecret")),
                       "default": e.get("default") or "", "required": bool(e.get("isRequired"))} for e in pkg.get("environmentVariables") or [] if e.get("name")]
            how = {"kind": pkg["registryType"], "package": pkg["identifier"], "version": pkg.get("version") or "", "args": [],
                   "env": {f["id"]: "{%s}" % f["id"] for f in fields}, "fields": fields}
        elif remote and "{" not in remote["url"]:
            how = {"kind": "remote", "url": remote["url"]}
        else:
            how = {"kind": "other"}
        out.append({"id": "registry-" + s.get("name", "").replace("/", "-").lower(), "name": s.get("title") or s.get("name", "").split("/")[-1],
                    "registry": s.get("name", ""), "what": s.get("description", ""), "version": s.get("version", ""),
                    "source": "registry", "url": (s.get("repository") or {}).get("url") or s.get("websiteUrl") or "",
                    "category": "", "license": "", "unchecked": True, "install": how, "cannot": "" if how["kind"] != "other" else "kind"})
    return out


DOCKER_CATALOG = "https://desktop.docker.com/mcp/catalog/v2/catalog.yaml"


def store_docker(words=""):
    """Docker's MCP catalog (docker/mcp-registry, MIT): servers Docker builds and checks, each a container image run with
    podman here, or an address. One file, kept a day; with no words the most pulled."""
    import time
    import urllib.request
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "docker-mcp-catalog.yaml")
    try:
        if not os.path.exists(cache) or time.time() - os.path.getmtime(cache) > 86400:
            body = urllib.request.urlopen(urllib.request.Request(DOCKER_CATALOG, headers={"User-Agent": "LatteOS"}), timeout=30).read()
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            with open(cache + ".new", "wb") as f:
                f.write(body)
            os.replace(cache + ".new", cache)
        import yaml
        with open(cache) as f:
            reg = (yaml.safe_load(f) or {}).get("registry") or {}
    except (OSError, ValueError, ImportError, Exception):          # a bad download or YAML: no Docker section this time
        return []
    out = []
    for name, v in reg.items():
        meta = v.get("metadata") or {}
        fields = [{"id": x["env"], "label": x.get("description") or x["env"], "secret": True} for x in v.get("secrets") or [] if x.get("env")]
        if v.get("type") == "server" and v.get("image"):
            first = v["image"].split("/")[0]
            image = v["image"] if "/" in v["image"] and ("." in first or ":" in first) else "docker.io/" + v["image"]      # podman wants the registry
            env = {x["name"]: str(x.get("value", "")) for x in v.get("env") or [] if x.get("name") and "{" not in str(x.get("value", ""))}
            env.update({f["id"]: "{%s}" % f["id"] for f in fields})
            how = {"kind": "oci", "image": image, "env": env, "fields": fields}
        elif v.get("type") == "remote" and (v.get("remote") or {}).get("url"):
            r = v["remote"]
            how = {"kind": "remote", "url": r["url"], "fields": fields,
                   "headers": {k: str(h).replace("${", "{") for k, h in (r.get("headers") or {}).items()}}
        else:
            continue
        out.append({"id": "docker-" + name, "name": v.get("title") or name, "what": v.get("description", ""), "category": "",
                    "kind_of": meta.get("category", ""), "logo": v.get("icon", ""), "license": meta.get("license", ""),
                    "home": v.get("source") or v.get("upstream") or "", "source": "docker", "pulls": meta.get("pulls", 0), "install": how})
    if words:
        w = words.lower().split()
        out = [e for e in out if all(x in (e["name"] + " " + e["what"] + " " + e["kind_of"]).lower() for x in w)]
    return sorted(out, key=lambda e: -e["pulls"])[:30 if not words else 60]


def mine():
    try:
        with open(MINE) as f:
            got = json.load(f)
            return got if isinstance(got, dict) else {}
    except (OSError, ValueError):
        return {}


def mine_write(m):
    os.makedirs(os.path.dirname(MINE), exist_ok=True)
    with open(os.open(MINE + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:      # values may be tokens
        json.dump(m, f, indent=1, ensure_ascii=False)
    os.replace(MINE + ".new", MINE)


def fill(text, values):
    for k, v in values.items():
        text = text.replace("{%s}" % k, v)
    return text


def store_add(entry, values):
    """Installs one server of the store: a pypi package as a uv tool, an npm one into ~/.local, an address as it is; then
    kept in mcp-servers.json, given to no tool yet. {"ok"} or {"error"}."""
    how = entry.get("install") or {}
    kind, have = how.get("kind"), mine()
    missing = [f["id"] for f in how.get("fields") or [] if (f.get("required", True)) and not values.get(f["id"])]
    if missing:
        return {"error": "missing", "fields": missing}
    s = {"name": entry["name"], "source": entry["source"], "kind": "remote" if kind == "remote" else "local", "what": entry.get("what", ""),
         "from": entry.get("registry") or entry.get("source"), "given": {}, "values": {k: v for k, v in values.items() if v}}
    if kind == "pypi":
        spec = how["package"] + ("==" + how["version"] if how.get("version") else "")
        r = subprocess.run(["uv", "tool", "install", "--force", spec], capture_output=True, text=True, timeout=900, env=dict(os.environ, PATH=SEARCH))
        if r.returncode:
            return {"error": "install", "detail": r.stderr[-400:]}
        lst = subprocess.run(["uv", "tool", "list"], capture_output=True, text=True, env=dict(os.environ, PATH=SEARCH)).stdout.splitlines()
        i = next((n for n, line in enumerate(lst) if line.split(" ")[0].lower() == how["package"].lower()), None)
        bins = [line[2:].strip() for line in lst[i + 1:] if line.startswith("- ")] if i is not None else []
        s["command"] = shutil.which(how.get("bin") or (bins[0] if bins else how["package"]), path=SEARCH) or ""
    elif kind == "npm":
        spec = how["package"] + ("@" + how["version"] if how.get("version") else "")
        prefix = os.path.expanduser("~/.local")
        r = subprocess.run(["npm", "install", "-g", "--prefix", prefix, spec], capture_output=True, text=True, timeout=900, env=dict(os.environ, PATH=SEARCH))
        if r.returncode:
            return {"error": "install", "detail": r.stderr[-400:]}
        if not how.get("bin"):
            v = subprocess.run(["npm", "view", spec, "bin", "--json"], capture_output=True, text=True, timeout=60, env=dict(os.environ, PATH=SEARCH))
            try:
                b = json.loads(v.stdout or "{}")
                how = dict(how, bin=next(iter(b)) if isinstance(b, dict) and b else how["package"].split("/")[-1])
            except ValueError:
                how = dict(how, bin=how["package"].split("/")[-1])
        s["command"] = os.path.join(prefix, "bin", how["bin"])
    elif kind == "oci":
        podman = shutil.which("podman", path=SEARCH)
        if not podman:
            return {"error": "install", "detail": "podman is not installed"}
        r = subprocess.run([podman, "pull", how["image"]], capture_output=True, text=True, timeout=1800)
        if r.returncode:
            return {"error": "install", "detail": r.stderr[-400:]}
        s["command"] = podman
        how = dict(how, args=["run", "-i", "--rm"] + [x for k in (how.get("env") or {}) for x in ("-e", k)] + [how["image"]])
    elif kind == "remote":
        if not how.get("url"):
            return {"error": "only-agentgram"}
        s["url"] = fill(how["url"], values)
        s["headers"] = {k: fill(v, values) for k, v in (how.get("headers") or {}).items()}
    else:
        return {"error": "kind"}
    if s["kind"] == "local":
        if not s["command"] or not os.path.exists(s["command"]):
            return {"error": "install", "detail": "no program after the install"}
        s["args"] = [fill(a, values) for a in how.get("args") or []]
        s["env"] = {k: fill(v, values) for k, v in (how.get("env") or {}).items() if fill(v, values)}
        s["package"] = how.get("package") or how.get("image", "")
        s["installer"] = kind
    s["values"] = {}                                            # what was asked is in the command line, env or headers now
    if s["kind"] == "local":
        import secrets
        s["token"] = secrets.token_urlsafe(32)
    have[entry["id"]] = s
    mine_write(have)
    subprocess.run(["systemctl", "--user", "try-restart", "latte-mcp"], capture_output=True)      # its /mcp/ID for agentgram
    return {"ok": True}


def store_give(ident, tool, on):
    """Gives an installed server to one agent's tool (Claude Code, Codex, Gemini) under its own name, or takes it back."""
    have = mine()
    s = have.get(ident)
    if not s or tool not in GIVEN:
        return {"error": "unknown"}
    exe = GIVEN[tool][1]
    run(exe, {"claude": ["mcp", "remove", "--scope", "user", ident], "chatgpt": ["mcp", "remove", ident],
              "gemini": ["mcp", "remove", "--scope", "user", ident]}[tool])
    if on:
        env = [x for k, v in (s.get("env") or {}).items() for x in (("--env" if tool == "chatgpt" else "-e"), "%s=%s" % (k, v))]
        hdr = [x for k, v in (s.get("headers") or {}).items() for x in ("--header", "%s: %s" % (k, v))]
        if tool == "chatgpt" and hdr:
            return {"error": "headers"}                     # ponytail: Codex takes a server's token only from an env variable
        if s["kind"] == "local":
            argv = {"claude": ["mcp", "add", "--scope", "user"] + env + [ident, "--", s["command"]] + s.get("args", []),
                    "chatgpt": ["mcp", "add"] + env + [ident, "--", s["command"]] + s.get("args", []),
                    "gemini": ["mcp", "add", "--scope", "user"] + env + [ident, s["command"]] + s.get("args", [])}[tool]
        else:
            argv = {"claude": ["mcp", "add", "--scope", "user", "--transport", "http"] + hdr + [ident, s["url"]],
                    "chatgpt": ["mcp", "add", ident, "--url", s["url"]],
                    "gemini": ["mcp", "add", "--scope", "user", "--transport", "http"] + hdr + [ident, s["url"]]}[tool]
        r = run(exe, argv)
        if not r or r.returncode:
            return {"error": "give", "detail": (r.stderr if r else "")[-300:]}
    s.setdefault("given", {})[tool] = bool(on)
    mine_write(have)
    return {"ok": True}


def store_remove(ident):
    """Takes a server back from every tool, uninstalls its program and forgets it."""
    have = mine()
    s = have.get(ident)
    if not s:
        return {"error": "unknown"}
    for tool, on in (s.get("given") or {}).items():
        if on:
            store_give(ident, tool, False)
    if s.get("installer") == "pypi" and s.get("package"):
        subprocess.run(["uv", "tool", "uninstall", s["package"]], capture_output=True, env=dict(os.environ, PATH=SEARCH))
    elif s.get("installer") == "oci" and s.get("package"):
        subprocess.run(["podman", "rmi", s["package"]], capture_output=True, env=dict(os.environ, PATH=SEARCH))
    elif s.get("installer") == "npm" and s.get("package"):
        subprocess.run(["npm", "uninstall", "-g", "--prefix", os.path.expanduser("~/.local"), s["package"]], capture_output=True, env=dict(os.environ, PATH=SEARCH))
    have = mine()
    have.pop(ident, None)
    mine_write(have)
    subprocess.run(["systemctl", "--user", "try-restart", "latte-mcp"], capture_output=True)
    return {"ok": True}


def store_mine():
    """The installed servers as LensAI shows them: never their env, headers or values."""
    tools = {t: shutil.which(GIVEN[t][1], path=SEARCH) is not None for t in GIVEN}
    return [{"id": k, "name": v["name"], "what": v.get("what", ""), "source": v.get("source"), "kind": v["kind"],
             "given": {t: bool((v.get("given") or {}).get(t)) for t in GIVEN}, "tools": tools} for k, v in sorted(mine().items())]


def serve(lazy=False, port=0):
    from mcp.server.fastmcp import Context, FastMCP
    server = FastMCP(NAME, instructions="LatteOS, the desktop this runs on: the user's conversations with every AI kept in LensAI, "
                                        "who can answer here, the agents at work and the windows open; and the small changes of `skills`, "
                                        "each done only after the user allowed it in LensAI.")

    @server.tool()
    @logged
    def conversations(ctx: Context) -> list | dict:
        """The user's conversations with every AI, kept in LensAI, the newest first: id, title, provider, model, when
        it was last written to, how many messages, and where it began (from: lensai, lensgoo, lensshore).
        The user allows it in LensAI first; do not ask again for what was refused."""
        no = allowed(ctx, "conversations", "")
        if no: return no
        found = told(["latte-ai", "chats"])
        return [c for c in found if not c.get("machine")] if isinstance(found, list) else found

    @server.tool()
    @logged
    def conversation(id: str, ctx: Context) -> dict:
        """One conversation whole, by its id from `conversations`: its messages with who said each and when.
        The user allows it in LensAI first."""
        found = told(["latte-ai", "chats"])
        title = next((c.get("title", "") for c in found if c.get("id") == id), "") if isinstance(found, list) else ""
        no = allowed(ctx, "conversation", title or id)
        if no: return no
        return told(["latte-ai", "chat", id]) or {"error": "no such conversation"}

    @server.tool()
    @logged
    def search_chats(words: str, ctx: Context) -> list | dict:
        """Finds the user's conversations with every AI that say these words — LensAI's, their Claude Code sessions, the
        Helper's tasks — the best first, each with the place that says them (accents and endings do not matter).
        The user allows it in LensAI first, as for `conversations`."""
        no = allowed(ctx, "conversations", words)
        if no: return no
        return told(["latte-ai", "search", words], timeout=300)

    @server.tool()
    @logged
    def providers() -> list | dict:
        """Which AI can answer on this computer now (the services signed in, keys, the model that runs here), with
        the models of each; `local` true means the answer is made on this machine and nothing leaves it."""
        found = told(["latte-ai", "providers"])
        return [{k: p[k] for k in ("id", "name", "local", "models")} for p in found] if isinstance(found, list) else found

    @server.tool()
    @logged
    def usage() -> dict:
        """What each AI service tells of the account: the plan, the limits (the share used, 0 to 1, and when each
        starts again), and the tokens Claude Code used this week and today."""
        return told(["latte-ai", "agents"])

    @server.tool()
    @logged
    def agents_at_work() -> list | dict:
        """The AI agents in this desktop's terminals: which one, in which folder, and whether it works, is ready, or
        asks the person something."""
        return told(["pleamar-wm", "agents", "--json"], lines=True)

    @server.tool()
    @logged
    def windows(ctx: Context) -> dict:
        """The windows open on the desktop: program, title, where each is. Their contents are not read.
        The user allows it in LensAI first."""
        no = allowed(ctx, "windows", "")
        if no: return no
        done = run("pleamar-wm", ["agent", "windows"]) if not turned_off() else None
        if done and done.returncode == 0:
            return {"windows": done.stdout}
        return {"error": (done.stderr.strip() if done else "") or "the windows cannot be told here"}

    @server.tool()
    @logged
    def skills() -> dict:
        """What LatteOS can change on this computer for the user (the Wi-Fi, Bluetooth, the volume, the brightness,
        the night light, the power mode, a network or a device to connect), how to ask for each (`use`), and what
        each thing is now, with the names of the devices and networks there are."""
        return told(["latte-skill", "list"])

    @server.tool()
    @logged
    def do_skill(skill: str, args: dict, ctx: Context) -> dict:
        """Asks the user to allow one change from `skills`, e.g. skill "volume", args {"level": 30}. LatteOS shows
        the user what would change, from what to what, and waits up to two minutes: answer "yes" means it was done
        (ok says whether it worked), "no" that the user refused, "timeout" that nobody answered, "invalid" that the
        skill or its argument is not one of `skills`. Do not ask again for what was refused."""
        who = caller(ctx)
        return told(["latte-skill", "ask", skill, json.dumps(args), "--by", who], timeout=150)

    @server.tool()
    @logged
    def ask(provider: str, model: str, question: str, ctx: Context) -> dict:
        """Asks another AI of `providers` (its id, and the id of one of its models) one question and gives its answer:
        a second opinion, or what that one knows or does better. One question, no conversation. It uses up the
        user's limit with that service and the user sees who was asked and what: do not pass on what the user
        would not send to that service, and do not ask what you can answer yourself."""
        if os.environ.get("LATTE_NO_TOOLS"):
            return {"error": "an AI that another AI asked answers itself: it cannot ask on"}
        no = allowed(ctx, "ask", "%s · %s: %s" % (provider, model, question))      # the user sees whom and what before it goes
        if no: return no
        r = told(["latte-ai", "send", "new", provider, model, question, "--from", "ask"], timeout=310, LATTE_NO_TOOLS="1")
        return {k: r[k] for k in ("answer", "ok") if k in r} if isinstance(r, dict) and "answer" in r else r

    # ── what the AI remembers (ROADMAP 10B.75, lensAIplan2.md 8): the memory chosen in LensAI › Settings › Memory (ENGINES),
    # Basic Memory by default (AGPL-3.0, a program of its own: Markdown notes in ~/.local/share/latteAI/lensai that the
    # person reads and changes too); started at the first call.
    # Its twelve tools are ~6 300 tokens of forms, so they come behind two: what there is, and one to call
    @server.tool()
    @logged
    async def memory_tools() -> list:
        """What the AI's memory can do (its notes about the user, their work and what was agreed): each of its tools
        with what it does and its arguments. Then call one with `memory`."""
        s = await memory_session()
        if not s:
            return [{"error": memory_missing()}]
        return [{"name": t.name, "does": t.description, "arguments": t.inputSchema} for t in (await s.list_tools()).tools]

    @server.tool(structured_output=False)
    @logged
    async def memory(tool: str, arguments: dict, ctx: Context) -> str:
        """Calls one tool of the AI's memory (from memory_tools), e.g. Basic Memory's "bm_search" {"query": "…"} or "bm_write"
        to keep a note, EverOS's "search_memory" {"query": "…"} or "add_memory". What is written is shown to the user in
        LensAI; deleting or moving a note they allow first."""
        s = await memory_session()
        if not s:
            return json.dumps({"error": memory_missing()})
        eng = ENGINES[BM["engine"]]
        if tool in eng["ask"]:
            no = allowed(ctx, "memory", "%s %s" % (tool, json.dumps(arguments, ensure_ascii=False)[:300]))
            if no:
                return json.dumps(no)
        # LensAI's own memory unless the call names another (Agent Chats' projects have theirs, latteAI/agentes/…)
        forms = {t.name: t.inputSchema for t in (await s.list_tools()).tools}
        if tool not in forms:
            return json.dumps({"error": "no memory tool " + tool + ": see memory_tools"})
        if BM["engine"] == "basic" and "project" in (forms[tool].get("properties") or {}) and not arguments.get("project") and not arguments.get("projects") and not arguments.get("all_projects"):
            arguments = dict(arguments, project="lensai")
        r = await s.call_tool(tool, arguments)
        out = "\n".join(getattr(c, "text", "") for c in r.content)
        if tool in eng["did"] and not r.isError:
            what = arguments.get("title") or arguments.get("identifier") or arguments.get("path") or arguments.get("user_message") or ", ".join(arguments.get("memory_ids") or [])
            told(["latte-ai", "journal", "add", json.dumps({"app": "LensAI", "ai": caller(ctx), "did": eng["did"][tool], "where": eng["where"],
                  "items": [[str(what)[:300]]]}, ensure_ascii=False)])
        return out

    # LensAI's memory and conversations stay LensAI's (the user, 20. 11.: agentgram keeps a memory of its own): over HTTP
    # (agentgram's connector) and in an anonymous project's folder (agentgram's agents with their own MCP servers) the
    # tools that read or keep them, or carry a question to another AI's history, are not there
    if port or anonymous(os.getcwd()):
        for name in APART:
            server.remove_tool(name)
    if lazy:
        server = lazily(server)
    if not port:
        server.run()
        return
    # over HTTP, on this computer only, and only with the token: any program of the user's could reach the port
    import secrets
    import uvicorn
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "mcp-token")
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(secrets.token_urlsafe(32))
    with open(path) as f:
        token = f.read().strip()
    app = server.streamable_http_app()
    # each server installed from LensAI's store that runs here, at /mcp/ID with a token of its own (agentgram's card MCP
    # LatteOS connects them one by one, each agent gets only those it is allowed); /servers lists them for the master token
    import contextlib
    import re
    from mcp.server.streamable_http_manager import StreamableHTTPSessionManager
    have = mine()
    for v in have.values():
        if v.get("kind") == "local" and not v.get("token"):
            v["token"] = secrets.token_urlsafe(32)
    mine_write(have)
    local = {k: v for k, v in have.items() if v.get("kind") == "local" and v.get("command")}
    managers = {k: StreamableHTTPSessionManager(app=proxied(k, v)) for k, v in local.items()}

    async def answer(send, status, body, kind=b"text/plain"):
        await send({"type": "http.response.start", "status": status, "headers": [(b"content-type", kind)]})
        await send({"type": "http.response.body", "body": body})

    async def guarded(scope, receive, send):
        if scope["type"] == "lifespan":
            async with contextlib.AsyncExitStack() as stack:
                for m in managers.values():
                    await stack.enter_async_context(m.run())
                await app(scope, receive, send)
            return
        said = dict(scope.get("headers") or []).get(b"authorization", b"")
        own = re.match(r"^/mcp/([\w.-]+)/?$", scope.get("path", ""))
        if scope["type"] == "http" and own:
            ident = own.group(1)
            if ident not in managers or not secrets.compare_digest(said, b"Bearer " + local[ident]["token"].encode()):
                return await answer(send, 401, b"latte-mcp: this server's own token is needed")
            return await managers[ident].handle_request(scope, receive, send)
        if scope["type"] == "http" and not secrets.compare_digest(said, b"Bearer " + token.encode()):
            return await answer(send, 401, b"latte-mcp: the token of ~/.config/latteos/mcp-token is needed")
        if scope["type"] == "http" and scope.get("path") == "/servers":
            rows = [{"id": k, "name": v["name"], "what": v.get("what", ""), "path": "/mcp/" + k, "token": v["token"]} for k, v in sorted(local.items())]
            return await answer(send, 200, json.dumps(rows, ensure_ascii=False).encode(), b"application/json")
        await app(scope, receive, send)
    uvicorn.run(guarded, host="127.0.0.1", port=port, log_level="warning")


def proxied(ident, spec):
    """One installed server over HTTP: a server of the low level that hands each list and call to the program itself,
    started on stdio at the first request and kept while latte-mcp runs."""
    import asyncio
    from mcp import ClientSession, StdioServerParameters
    from mcp.client.stdio import stdio_client
    from mcp.server.lowlevel import Server
    srv, held, lock = Server(ident), {}, asyncio.Lock()

    async def session():
        async with lock:
            if "s" not in held:
                ready = asyncio.Event()

                async def life():
                    try:
                        params = StdioServerParameters(command=spec["command"], args=spec.get("args") or [],
                                                       env=dict(os.environ, PATH=SEARCH, **(spec.get("env") or {})))
                        async with stdio_client(params, errlog=open(os.devnull, "w")) as (r, w):
                            async with ClientSession(r, w) as s:
                                await s.initialize()
                                held["s"] = s
                                ready.set()
                                await asyncio.Event().wait()
                    finally:
                        held.pop("s", None)
                        ready.set()
                held["task"] = asyncio.create_task(life())
                await ready.wait()
            return held.get("s")

    @srv.list_tools()
    async def tools():
        s = await session()
        return (await s.list_tools()).tools if s else []

    @srv.call_tool(validate_input=False)
    async def call(name, arguments):
        s = await session()
        if not s:
            raise RuntimeError("%s did not start" % spec["name"])
        return await s.call_tool(name, arguments)                # its result whole: error, text and structured output
    return srv


APART = ("conversations", "conversation", "search_chats", "ask", "memory_tools", "memory")
PROJECTS_DIR = os.path.expanduser("~/LensAI/agentgram")


def anonymous(folder):
    """Whether a folder is in an anonymous project of agentgram, which marks its folders with .agentgram-anonymous (as
    latte-ai's index reads it): nothing of it may reach another memory, nor another memory it."""
    root, d = os.path.realpath(PROJECTS_DIR), os.path.realpath(folder)
    while d.startswith(root + os.sep):
        if os.path.exists(os.path.join(d, ".agentgram-anonymous")):
            return True
        d = os.path.dirname(d)
    return False


DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteAI")
CHOSEN = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "memory")
# the memories LensAI › Settings › Memory offers (latte-ai memory): the program, how its MCP server starts, which of its
# tools the user allows first, and which go to the journal of what the AI changed
ENGINES = {
    "basic": {"name": "Basic Memory", "tool": "basic-memory", "args": ["mcp", "--project", "lensai"], "env": {}, "where": os.path.join(DATA, "lensai"),
              "ask": ("bm_delete", "bm_move", "bm_project"),
              "did": {"bm_write": "Remembered", "bm_edit": "Changed in memory", "bm_delete": "Forgotten", "bm_move": "Moved in memory"}},
    # its server is latte-everos.service, on this computer only (latte-ai memory set everos)
    "everos": {"name": "EverOS", "tool": "everos-mcp", "args": [], "where": os.path.join(DATA, "everos"),
               "env": {"EVEROS_BASE_URL": "http://127.0.0.1:8792", "EVEROS_USER_ID": "me", "EVEROS_PROJECT_ID": "lensai"},
               "ask": ("delete_session", "delete_memories"),
               "did": {"add_memory": "Remembered", "record_trajectory": "Remembered", "delete_session": "Forgotten", "delete_memories": "Forgotten"}},
}
BM = {}


def memory_chosen():
    try:
        with open(CHOSEN) as f:
            word = f.read().strip()
    except OSError:
        word = ""
    return word if word in ENGINES or word == "off" else "basic"


def memory_missing():
    on = memory_chosen()
    return ("the memory is off (LensAI › Settings › Memory)" if on == "off"
            else "the memory is not there (%s is not installed)" % ENGINES[on]["name"])


async def memory_session():
    """The chosen memory's MCP session, started the first time it is asked for and kept while this server runs (again when
    the user chose another) — in a thread and event loop of its own: a stdio client's task scope cannot outlive the one
    request that opened it."""
    on = memory_chosen()
    if BM.get("engine") != on:
        if "stop" in BM:
            BM["loop"].call_soon_threadsafe(BM["stop"].set)
        BM.clear()
    if on == "off":
        return None
    if "s" not in BM:
        eng = ENGINES[on]
        tool = shutil.which(eng["tool"], path=SEARCH)
        if not tool:
            return None
        import asyncio
        import threading
        from mcp import ClientSession, StdioServerParameters
        from mcp.client.stdio import stdio_client
        loop, ready = asyncio.new_event_loop(), threading.Event()

        async def life():
            try:
                async with stdio_client(StdioServerParameters(command=tool, args=eng["args"], env=dict(os.environ, **eng["env"])),
                                        errlog=open(os.devnull, "w")) as (r, w):
                    async with ClientSession(r, w) as s:
                        await s.initialize()
                        BM["s"], BM["stop"], BM["engine"] = s, asyncio.Event(), on
                        ready.set()
                        await BM["stop"].wait()
            finally:
                ready.set()
        threading.Thread(target=lambda: loop.run_until_complete(life()), daemon=True).start()
        await asyncio.get_running_loop().run_in_executor(None, ready.wait, 60)
        BM["loop"] = loop
        if "s" not in BM:
            return None
    return Remote(BM["s"], BM["loop"])


class Remote:
    """The session as seen from this server's loop: each call made in the session's own loop and awaited here."""
    def __init__(self, s, loop):
        self.s, self.loop = s, loop

    async def _on(self, coro):
        import asyncio
        return await asyncio.wrap_future(asyncio.run_coroutine_threadsafe(coro, self.loop))

    async def list_tools(self):
        return await self._on(self.s.list_tools())

    async def call_tool(self, name, args):
        return await self._on(self.s.call_tool(name, args))


def lazily(full):
    """The tools behind three: an AI with a small window finds the one it needs by words, reads its form, and calls it
    (the "MCP gateway" pattern, lensAIplan.md 5.1)."""
    from mcp.server.fastmcp import Context, FastMCP
    front = FastMCP(NAME, instructions=full.instructions + " Find a tool by words with find_tools, read its form with "
                                                            "describe_tool, then call it with call_tool.")

    async def every():
        return {t.name: t for t in await full.list_tools()}

    @front.tool()
    async def find_tools(words: str) -> list:
        """The tools of LatteOS for these words (English works best), at most five, each with what it does. With no
        match, every tool's name."""
        tools = await every()
        hit = score(words, [{"name": n, "description": t.description or ""} for n, t in tools.items()])[:5]
        return [{"name": t["name"], "does": t["description"].split(". ")[0]} for _, t in hit] or [{"name": n} for n in tools]

    @front.tool()
    async def describe_tool(name: str) -> dict:
        """What a tool does and the arguments it takes (a JSON schema), by its name from find_tools."""
        t = (await every()).get(name)
        return {"name": name, "description": t.description, "arguments": t.inputSchema} if t else {"error": "no tool " + name}

    @front.tool(structured_output=False)
    async def call_tool(name: str, ctx: Context, arguments: dict | None = None) -> str:
        """Calls a tool by its name, with its arguments as describe_tool gives them; answers what the tool answers."""
        if name not in await every():
            return json.dumps({"error": "no tool " + name})
        CALLER["name"] = caller(ctx)
        try:
            out = await full.call_tool(name, arguments or {})
        except Exception as e:                      # a wrong argument: said to the model, which may try again
            return json.dumps({"error": str(e)})
        finally:
            CALLER.clear()
        if isinstance(out, tuple):
            out = out[0]
        return "\n".join(getattr(c, "text", "") for c in out) if isinstance(out, (list, tuple)) else json.dumps(out, ensure_ascii=False)

    return front


GATE = {"WebSearch": "query", "WebFetch": "url"}      # what the person is shown under "Look on the web": the search, or the page


def gate():
    """Claude Code asks here before it uses a tool it was given but not allowed (its --permission-prompt-tool): the web,
    in a conversation of LensAI. The person answers in LensAI; once yes, the rest of this answer may look further
    (the user, 18. 11.: an AI of a service looks on the web only on request)."""
    from mcp.server.fastmcp import FastMCP
    server, said = FastMCP(NAME + "-gate"), {}

    # plain text: with structured output Claude Code finds no "behavior" in it and calls the answer invalid (18. 11.)
    @server.tool(structured_output=False)
    def approve(tool_name: str, input: dict, tool_use_id: str = "") -> str:
        """LatteOS asks the person whether this tool may run. Not for the model to call."""
        if tool_name not in GATE:
            return json.dumps({"behavior": "deny", "message": "only the web may be asked for here"})
        if not said:                                       # asked once an answer: a no stays a no too
            r = told(["latte-skill", "allow", "web", str(input.get(GATE[tool_name], ""))[:300], "--by", "Claude", "--once"], timeout=150)
            said["yes" if isinstance(r, dict) and r.get("ok") else "no"] = True
        if "yes" in said:
            return json.dumps({"behavior": "allow", "updatedInput": input})
        return json.dumps({"behavior": "deny", "message": "the user did not allow looking on the web; answer from what you know and say so"})

    server.run()


def main(a):
    if a in ([], ["--lazy"]) or (a[:1] == ["http"] and len(a) <= 2 and all(x.isdigit() for x in a[1:])):
        if turned_off():
            print("latte-mcp: the AI of LatteOS is turned off (Settings › AI)", file=sys.stderr)
            return 1
        serve(lazy=a == ["--lazy"], port=int(a[1]) if len(a) == 2 else 8791 if a == ["http"] else 0)
        return 0
    if a == ["gate"]:
        gate()
        return 0
    if a == ["status"]:
        print(json.dumps(status()))
        return 0
    if a == ["servers"]:
        print(json.dumps(servers(), ensure_ascii=False))
        return 0
    if a[:1] == ["store"] and len(a) <= 2:
        words = a[1].strip() if len(a) == 2 else ""
        print(json.dumps({"latteos": store_latteos(), "agentgram": store_agentgram(), "docker": store_docker(words),
                          "registry": store_registry(words) if words else [], "mine": store_mine()}, ensure_ascii=False))
        return 0
    if a[:1] == ["add"] and len(a) == 2:                     # the store's entry as JSON on stdin: {"entry", "values"}
        got = json.load(sys.stdin)
        entry = got.get("entry") or {}
        known = {e["id"]: e for e in store_latteos() + store_agentgram()}
        entry = known.get(a[1]) or next((e for e in store_docker() + store_docker(entry.get("name", "")) if e["id"] == a[1]), None) \
            or (entry if entry.get("source") == "registry" and entry.get("id") == a[1] else None)
        print(json.dumps(store_add(entry, got.get("values") or {}) if entry else {"error": "unknown"}))
        return 0
    if a[:1] == ["give"] and len(a) == 4 and a[3] in ("on", "off"):
        print(json.dumps(store_give(a[1], a[2], a[3] == "on")))
        return 0
    if a[:1] == ["remove"] and len(a) == 2:
        print(json.dumps(store_remove(a[1])))
        return 0
    if a in (["install"], ["remove"]):
        for s in status()["agents"]:
            if s["installed"] and s["has"] != (a[0] == "install"):
                done = run(AGENTS[s["id"]]["tool"], AGENTS[s["id"]]["add" if a[0] == "install" else "remove"])
                print("%s: %s" % (s["name"], "ok" if done and done.returncode == 0 else "failed"))
        return 0
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
