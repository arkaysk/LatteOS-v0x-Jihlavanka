#!/usr/bin/env python3
"""latte-mcp: LatteOS as one MCP server, the AI layer every agent shares (docs/lensai/NAVRH-MCP.md, ROADMAP 10B.43).
It knows nothing itself: each tool is a thin cover over a command that is there already (latte-ai, pleamar-wm).

  latte-mcp                 serves on stdio: what an agent's tool (Claude Code, Codex, Gemini CLI) starts
  latte-mcp --lazy          the same, behind three tools (find_tools, describe_tool, call_tool): a model with a small
                            window gets ~300 tokens of tools instead of every schema, and opens what it needs
  latte-mcp http [PORT]     the same over HTTP on 127.0.0.1 (8791), for Agent Chats: a request needs the token of
                            ~/.config/latteos/mcp-token (Authorization: Bearer …), made the first time, readable by the user alone
  latte-mcp gate            serves one tool, `approve`: Claude Code's --permission-prompt-tool in LensAI's conversations,
                            where it may look on the web only when the person allows it there (bin/latte-ai claude)
  latte-mcp install|remove  writes it into, or takes it out of, the agents installed here, for this user
  latte-mcp status          {"ai", "agents": [{"id", "name", "installed", "has"}]}: which agents have it
  latte-mcp servers         every MCP server the agents are given (their user settings), by name: [{"name", "how" (the
                            command line or the URL), "clients": ["Claude Code", "Codex", "Gemini CLI"]}]; never env or headers

It reads: the conversations kept in LensAI, who can answer and what is left of the limits, the agents at work and the
windows open. And it changes what bin/latte-skill names (the Wi-Fi, the volume, the brightness…), each change only
after the person allowed it in LensAI: the confirmation is LatteOS's, never the agent's own.
`ask` puts one question to another AI (latte-ai send): the one asked gets no tools and cannot ask on.
With the AI turned off (Settings › AI) it serves nothing. Every call is written to the journal: journalctl -t latte-mcp.
"""
import json
import os
import shutil
import subprocess
import sys

NAME = "latteos"
# the desktop's services have a short PATH: the user's own tools live in ~/.local/bin and beside (as bin/latte-ai)
SEARCH = os.pathsep.join([os.environ.get("PATH", "/usr/local/bin:/usr/bin"), os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"),
                          os.path.expanduser("~/.local/share/mise/shims")])
# how each agent is told of a server, and how it forgets one
AGENTS = {
    "claude": {"name": "Claude Code", "tool": "claude", "add": ["mcp", "add", "--scope", "user", NAME, "--", "latte-mcp"],
               "remove": ["mcp", "remove", "--scope", "user", NAME]},
    "chatgpt": {"name": "Codex", "tool": "codex", "add": ["mcp", "add", NAME, "--", "latte-mcp"], "remove": ["mcp", "remove", NAME]},
    "gemini": {"name": "Gemini", "tool": "gemini", "add": ["mcp", "add", "--scope", "user", NAME, "latte-mcp"],
               "remove": ["mcp", "remove", "--scope", "user", NAME]},
}


def turned_off():
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai")) as f:
            return f.read().strip() == "off"
    except OSError:
        return False


def told(argv, lines=False, timeout=30, **env):
    """What a command of LatteOS answers, as JSON (or a JSON object a line); an error is said, not thrown at the agent."""
    if turned_off():
        return {"error": "the AI of LatteOS is turned off (Settings › AI)"}
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=dict(os.environ, PATH=SEARCH, **env)).stdout
        return [json.loads(l) for l in out.splitlines() if l.strip()] if lines else json.loads(out)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        return {"error": "%s: %s" % (argv[0], e)}


CALLER = {}       # who calls, when a tool is reached through call_tool (--lazy): its own Context is not that request's


def caller(ctx):
    try:
        return CALLER.get("name") or ctx.session.client_params.clientInfo.name
    except (AttributeError, ValueError):
        return "AI"


def logged(f):
    """Each call into the journal, with who, what and whether it answered or failed (ROADMAP 10B.68: for GuardCorgi
    and for what was done when)."""
    import functools
    import syslog

    import inspect

    def note(k, out):
        bad = (isinstance(out, dict) and "error" in out) or (isinstance(out, str) and out.startswith('{"error"'))
        syslog.openlog("latte-mcp")
        syslog.syslog("%s %s %s %s" % (caller(k.get("ctx")), f.__name__, json.dumps({x: y for x, y in k.items() if x != "ctx"}, ensure_ascii=False)[:300],
                                       "failed" if bad else "answered"))

    if inspect.iscoroutinefunction(f):
        @functools.wraps(f)
        async def acall(*a, **k):
            out = await f(*a, **k)
            note(k, out)
            return out
        return acall

    @functools.wraps(f)
    def call(*a, **k):
        out = f(*a, **k)
        note(k, out)
        return out
    return call


def score(query, tools):
    """The tools best for the words, by BM25 over each one's name and description (the search of swarmclawai/mcp-gateway's
    mcp_tool_search, MIT, written anew): [(score, tool)], the best first, those that share no word left out."""
    import math
    import re
    words = lambda t: re.findall(r"[a-z0-9]+", t.lower())
    docs = [words(t["name"].replace("_", " ") + " " + t["description"]) for t in tools]
    avg, q = sum(map(len, docs)) / max(1, len(docs)), set(words(query))
    idf = {w: math.log(1 + (len(docs) - sum(w in d for d in docs) + 0.5) / (sum(w in d for d in docs) + 0.5)) for w in q}
    found = [(sum(idf[w] * d.count(w) * 2.2 / (d.count(w) + 1.2 * (0.25 + 0.75 * len(d) / avg)) for w in q), t) for t, d in zip(tools, docs)]
    return sorted([f for f in found if f[0] > 0], key=lambda f: -f[0])


def allowed(ctx, what, detail):
    """The person's word in LensAI before an AI reads their conversations or windows or asks another AI (user 17. 11.):
    None when allowed, else what to answer the agent."""
    who = caller(ctx)
    r = told(["latte-skill", "allow", what, detail, "--by", who], timeout=150)
    return None if isinstance(r, dict) and r.get("answer") == "yes" else {"error": "the user did not allow it", **(r if isinstance(r, dict) else {})}


def run(tool, args):
    try:
        return subprocess.run([shutil.which(tool, path=SEARCH) or tool] + args, capture_output=True, text=True, timeout=30,
                              env=dict(os.environ, PATH=SEARCH))
    except (OSError, subprocess.TimeoutExpired):
        return None


def status():
    out = []
    for i, a in AGENTS.items():
        there = shutil.which(a["tool"], path=SEARCH) is not None
        listed = run(a["tool"], ["mcp", "list"]) if there else None
        out.append({"id": i, "name": a["name"], "installed": there, "has": bool(listed and NAME in listed.stdout + listed.stderr)})
    return {"ai": not turned_off(), "agents": out}


def servers():
    """Every MCP server the agents' own settings give them, by name: [{"name", "how" (command line or URL), "clients"}].
    Only the user's scope (Claude Code keeps a project's own under "projects"); env and headers are never read out."""
    import tomllib
    found = {}

    def read(path, toml=False):
        try:
            with open(os.path.expanduser(path), "rb") as f:
                got = tomllib.load(f) if toml else json.load(f)
                return got if isinstance(got, dict) else {}
        except (OSError, ValueError):
            return {}

    def shown(s):
        """What it is, without what may be a secret: a URL's scheme and host, a command's name and its arguments, those
        after a key, token or secret flag (or holding one) masked."""
        import re
        import urllib.parse
        url = s.get("url") or s.get("httpUrl")
        if url:
            u = urllib.parse.urlsplit(str(url))
            return "%s://%s" % (u.scheme, u.hostname or "")
        words, hide = [os.path.basename(str(s.get("command", "")))], False
        for x in [str(a) for a in s.get("args") or []]:
            secret = re.search(r"key|token|secret|passw|bearer|auth", x, re.I)
            words.append("•••" if hide or (secret and "=" in x) else x)
            hide = bool(secret) and x.startswith("-") and "=" not in x
        return " ".join(w for w in words if w).strip()
    for client, given in (("Claude Code", read("~/.claude.json").get("mcpServers")),
                          ("Codex", read("~/.codex/config.toml", toml=True).get("mcp_servers")),
                          ("Gemini CLI", read("~/.gemini/settings.json").get("mcpServers"))):
        for name, s in (given or {}).items():
            s = s if isinstance(s, dict) else {}
            how = shown(s)
            row = found.setdefault(name, {"name": name, "how": how, "clients": []})
            row["clients"].append(client)
    return sorted(found.values(), key=lambda s: s["name"].lower())


def serve(lazy=False, port=0):
    from mcp.server.fastmcp import Context, FastMCP
    server = FastMCP(NAME, instructions="LatteOS, the desktop this runs on: the user's conversations with every AI kept in LensAI, "
                                        "who can answer here, the agents at work and the windows open; and the small changes of `skills`, "
                                        "each done only after the user allowed it in LensAI.")

    @server.tool()
    @logged
    def conversations(ctx: Context) -> list | dict:
        """The user's conversations with every AI, kept in LensAI, the newest first: id, title, provider, model, when
        it was last written to, how many messages, and where it began (from: lensai, lensgoo, lensshore).
        The user allows it in LensAI first; do not ask again for what was refused."""
        no = allowed(ctx, "conversations", "")
        if no: return no
        found = told(["latte-ai", "chats"])
        return [c for c in found if not c.get("machine")] if isinstance(found, list) else found

    @server.tool()
    @logged
    def conversation(id: str, ctx: Context) -> dict:
        """One conversation whole, by its id from `conversations`: its messages with who said each and when.
        The user allows it in LensAI first."""
        found = told(["latte-ai", "chats"])
        title = next((c.get("title", "") for c in found if c.get("id") == id), "") if isinstance(found, list) else ""
        no = allowed(ctx, "conversation", title or id)
        if no: return no
        return told(["latte-ai", "chat", id]) or {"error": "no such conversation"}

    @server.tool()
    @logged
    def search_chats(words: str, ctx: Context) -> list | dict:
        """Finds the user's conversations with every AI that say these words — LensAI's, their Claude Code sessions, the
        Helper's tasks — the best first, each with the place that says them (accents and endings do not matter).
        The user allows it in LensAI first, as for `conversations`."""
        no = allowed(ctx, "conversations", words)
        if no: return no
        return told(["latte-ai", "search", words], timeout=300)

    @server.tool()
    @logged
    def providers() -> list | dict:
        """Which AI can answer on this computer now (the services signed in, keys, the model that runs here), with
        the models of each; `local` true means the answer is made on this machine and nothing leaves it."""
        found = told(["latte-ai", "providers"])
        return [{k: p[k] for k in ("id", "name", "local", "models")} for p in found] if isinstance(found, list) else found

    @server.tool()
    @logged
    def usage() -> dict:
        """What each AI service tells of the account: the plan, the limits (the share used, 0 to 1, and when each
        starts again), and the tokens Claude Code used this week and today."""
        return told(["latte-ai", "agents"])

    @server.tool()
    @logged
    def agents_at_work() -> list | dict:
        """The AI agents in this desktop's terminals: which one, in which folder, and whether it works, is ready, or
        asks the person something."""
        return told(["pleamar-wm", "agents", "--json"], lines=True)

    @server.tool()
    @logged
    def windows(ctx: Context) -> dict:
        """The windows open on the desktop: program, title, where each is. Their contents are not read.
        The user allows it in LensAI first."""
        no = allowed(ctx, "windows", "")
        if no: return no
        done = run("pleamar-wm", ["agent", "windows"]) if not turned_off() else None
        if done and done.returncode == 0:
            return {"windows": done.stdout}
        return {"error": (done.stderr.strip() if done else "") or "the windows cannot be told here"}

    @server.tool()
    @logged
    def skills() -> dict:
        """What LatteOS can change on this computer for the user (the Wi-Fi, Bluetooth, the volume, the brightness,
        the night light, the power mode, a network or a device to connect), how to ask for each (`use`), and what
        each thing is now, with the names of the devices and networks there are."""
        return told(["latte-skill", "list"])

    @server.tool()
    @logged
    def do_skill(skill: str, args: dict, ctx: Context) -> dict:
        """Asks the user to allow one change from `skills`, e.g. skill "volume", args {"level": 30}. LatteOS shows
        the user what would change, from what to what, and waits up to two minutes: answer "yes" means it was done
        (ok says whether it worked), "no" that the user refused, "timeout" that nobody answered, "invalid" that the
        skill or its argument is not one of `skills`. Do not ask again for what was refused."""
        who = caller(ctx)
        return told(["latte-skill", "ask", skill, json.dumps(args), "--by", who], timeout=150)

    @server.tool()
    @logged
    def ask(provider: str, model: str, question: str, ctx: Context) -> dict:
        """Asks another AI of `providers` (its id, and the id of one of its models) one question and gives its answer:
        a second opinion, or what that one knows or does better. One question, no conversation. It uses up the
        user's limit with that service and the user sees who was asked and what: do not pass on what the user
        would not send to that service, and do not ask what you can answer yourself."""
        if os.environ.get("LATTE_NO_TOOLS"):
            return {"error": "an AI that another AI asked answers itself: it cannot ask on"}
        no = allowed(ctx, "ask", "%s · %s: %s" % (provider, model, question))      # the user sees whom and what before it goes
        if no: return no
        r = told(["latte-ai", "send", "new", provider, model, question, "--from", "ask"], timeout=310, LATTE_NO_TOOLS="1")
        return {k: r[k] for k in ("answer", "ok") if k in r} if isinstance(r, dict) and "answer" in r else r

    # ── what the AI remembers (ROADMAP 10B.75, lensAIplan2.md 8): Basic Memory (AGPL-3.0, a program of its own), its notes
    # Markdown files in ~/.local/share/latteAI/lensai that the person reads and changes too; started at the first call.
    # Its twelve tools are ~6 300 tokens of forms, so they come behind two: what there is, and one to call
    @server.tool()
    @logged
    async def memory_tools() -> list:
        """What the AI's memory can do (its notes about the user, their work and what was agreed): each of its tools
        with what it does and its arguments. Then call one with `memory`."""
        s = await memory_session()
        if not s:
            return [{"error": "the memory is not there (Basic Memory is not installed)"}]
        return [{"name": t.name, "does": t.description, "arguments": t.inputSchema} for t in (await s.list_tools()).tools]

    @server.tool(structured_output=False)
    @logged
    async def memory(tool: str, arguments: dict, ctx: Context) -> str:
        """Calls one tool of the AI's memory (from memory_tools), e.g. tool "bm_search" {"query": "…"}, or "bm_write"
        to keep a note. What is written is shown to the user in LensAI; deleting or moving a note they allow first."""
        s = await memory_session()
        if not s:
            return json.dumps({"error": "the memory is not there (Basic Memory is not installed)"})
        if tool in ("bm_delete", "bm_move", "bm_project"):
            no = allowed(ctx, "memory", "%s %s" % (tool, json.dumps(arguments, ensure_ascii=False)[:300]))
            if no:
                return json.dumps(no)
        # LensAI's own memory unless the call names another (Agent Chats' projects have theirs, latteAI/agentes/…)
        forms = {t.name: t.inputSchema for t in (await s.list_tools()).tools}
        if tool not in forms:
            return json.dumps({"error": "no memory tool " + tool + ": see memory_tools"})
        if "project" in (forms[tool].get("properties") or {}) and not arguments.get("project") and not arguments.get("projects") and not arguments.get("all_projects"):
            arguments = dict(arguments, project="lensai")
        r = await s.call_tool(tool, arguments)
        out = "\n".join(getattr(c, "text", "") for c in r.content)
        if tool in ("bm_write", "bm_edit", "bm_delete", "bm_move") and not r.isError:
            what = arguments.get("title") or arguments.get("identifier") or arguments.get("path") or ""
            told(["latte-ai", "journal", "add", json.dumps({"app": "LensAI", "ai": caller(ctx), "did": {"bm_write": "Remembered", "bm_edit": "Changed in memory",
                  "bm_delete": "Forgotten", "bm_move": "Moved in memory"}[tool], "where": MEMORY, "items": [[str(what)]]}, ensure_ascii=False)])
        return out

    if lazy:
        server = lazily(server)
    if not port:
        server.run()
        return
    # over HTTP, on this computer only, and only with the token: any program of the user's could reach the port
    import secrets
    import uvicorn
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "mcp-token")
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(secrets.token_urlsafe(32))
    with open(path) as f:
        token = f.read().strip()
    app = server.streamable_http_app()

    async def guarded(scope, receive, send):
        if scope["type"] == "http" and not secrets.compare_digest(dict(scope["headers"]).get(b"authorization", b""), b"Bearer " + token.encode()):
            await send({"type": "http.response.start", "status": 401, "headers": [(b"content-type", b"text/plain")]})
            await send({"type": "http.response.body", "body": b"latte-mcp: the token of ~/.config/latteos/mcp-token is needed"})
            return
        await app(scope, receive, send)
    uvicorn.run(guarded, host="127.0.0.1", port=port, log_level="warning")


MEMORY = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteAI", "lensai")
BM = {}


async def memory_session():
    """Basic Memory's MCP session, started the first time it is asked for and kept while this server runs — in a thread
    and event loop of its own: a stdio client's task scope cannot outlive the one request that opened it."""
    if "s" not in BM:
        tool = shutil.which("basic-memory", path=SEARCH)
        if not tool:
            return None
        import asyncio
        import threading
        from mcp import ClientSession, StdioServerParameters
        from mcp.client.stdio import stdio_client
        loop, ready = asyncio.new_event_loop(), threading.Event()

        async def life():
            try:
                async with stdio_client(StdioServerParameters(command=tool, args=["mcp", "--project", "lensai"]), errlog=open(os.devnull, "w")) as (r, w):
                    async with ClientSession(r, w) as s:
                        await s.initialize()
                        BM["s"] = s
                        ready.set()
                        await asyncio.Event().wait()
            finally:
                ready.set()
        threading.Thread(target=lambda: loop.run_until_complete(life()), daemon=True).start()
        await asyncio.get_running_loop().run_in_executor(None, ready.wait, 60)
        BM["loop"] = loop
        if "s" not in BM:
            return None
    return Remote(BM["s"], BM["loop"])


class Remote:
    """The session as seen from this server's loop: each call made in the session's own loop and awaited here."""
    def __init__(self, s, loop):
        self.s, self.loop = s, loop

    async def _on(self, coro):
        import asyncio
        return await asyncio.wrap_future(asyncio.run_coroutine_threadsafe(coro, self.loop))

    async def list_tools(self):
        return await self._on(self.s.list_tools())

    async def call_tool(self, name, args):
        return await self._on(self.s.call_tool(name, args))


def lazily(full):
    """The tools behind three: an AI with a small window finds the one it needs by words, reads its form, and calls it
    (the "MCP gateway" pattern, lensAIplan.md 5.1)."""
    from mcp.server.fastmcp import Context, FastMCP
    front = FastMCP(NAME, instructions=full.instructions + " Find a tool by words with find_tools, read its form with "
                                                            "describe_tool, then call it with call_tool.")

    async def every():
        return {t.name: t for t in await full.list_tools()}

    @front.tool()
    async def find_tools(words: str) -> list:
        """The tools of LatteOS for these words (English works best), at most five, each with what it does. With no
        match, every tool's name."""
        tools = await every()
        hit = score(words, [{"name": n, "description": t.description or ""} for n, t in tools.items()])[:5]
        return [{"name": t["name"], "does": t["description"].split(". ")[0]} for _, t in hit] or [{"name": n} for n in tools]

    @front.tool()
    async def describe_tool(name: str) -> dict:
        """What a tool does and the arguments it takes (a JSON schema), by its name from find_tools."""
        t = (await every()).get(name)
        return {"name": name, "description": t.description, "arguments": t.inputSchema} if t else {"error": "no tool " + name}

    @front.tool(structured_output=False)
    async def call_tool(name: str, ctx: Context, arguments: dict | None = None) -> str:
        """Calls a tool by its name, with its arguments as describe_tool gives them; answers what the tool answers."""
        if name not in await every():
            return json.dumps({"error": "no tool " + name})
        CALLER["name"] = caller(ctx)
        try:
            out = await full.call_tool(name, arguments or {})
        except Exception as e:                      # a wrong argument: said to the model, which may try again
            return json.dumps({"error": str(e)})
        finally:
            CALLER.clear()
        if isinstance(out, tuple):
            out = out[0]
        return "\n".join(getattr(c, "text", "") for c in out) if isinstance(out, (list, tuple)) else json.dumps(out, ensure_ascii=False)

    return front


GATE = {"WebSearch": "query", "WebFetch": "url"}      # what the person is shown under "Look on the web": the search, or the page


def gate():
    """Claude Code asks here before it uses a tool it was given but not allowed (its --permission-prompt-tool): the web,
    in a conversation of LensAI. The person answers in LensAI; once yes, the rest of this answer may look further
    (the user, 18. 11.: an AI of a service looks on the web only on request)."""
    from mcp.server.fastmcp import FastMCP
    server, said = FastMCP(NAME + "-gate"), {}

    # plain text: with structured output Claude Code finds no "behavior" in it and calls the answer invalid (18. 11.)
    @server.tool(structured_output=False)
    def approve(tool_name: str, input: dict, tool_use_id: str = "") -> str:
        """LatteOS asks the person whether this tool may run. Not for the model to call."""
        if tool_name not in GATE:
            return json.dumps({"behavior": "deny", "message": "only the web may be asked for here"})
        if not said:                                       # asked once an answer: a no stays a no too
            r = told(["latte-skill", "allow", "web", str(input.get(GATE[tool_name], ""))[:300], "--by", "Claude", "--once"], timeout=150)
            said["yes" if isinstance(r, dict) and r.get("ok") else "no"] = True
        if "yes" in said:
            return json.dumps({"behavior": "allow", "updatedInput": input})
        return json.dumps({"behavior": "deny", "message": "the user did not allow looking on the web; answer from what you know and say so"})

    server.run()


def main(a):
    if a in ([], ["--lazy"]) or (a[:1] == ["http"] and len(a) <= 2 and all(x.isdigit() for x in a[1:])):
        if turned_off():
            print("latte-mcp: the AI of LatteOS is turned off (Settings › AI)", file=sys.stderr)
            return 1
        serve(lazy=a == ["--lazy"], port=int(a[1]) if len(a) == 2 else 8791 if a == ["http"] else 0)
        return 0
    if a == ["gate"]:
        gate()
        return 0
    if a == ["status"]:
        print(json.dumps(status()))
        return 0
    if a == ["servers"]:
        print(json.dumps(servers(), ensure_ascii=False))
        return 0
    if a in (["install"], ["remove"]):
        for s in status()["agents"]:
            if s["installed"] and s["has"] != (a[0] == "install"):
                done = run(AGENTS[s["id"]]["tool"], AGENTS[s["id"]]["add" if a[0] == "install" else "remove"])
                print("%s: %s" % (s["name"], "ok" if done and done.returncode == 0 else "failed"))
        return 0
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
