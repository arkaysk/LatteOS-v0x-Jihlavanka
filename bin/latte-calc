#!/usr/bin/env python3
"""latte-calc LINE: the calculator's parts that Qalculate does not read (ROADMAP 6B.48; Raycast 2.12's Calculator as a model).

Prints one JSON object, or {} when it is not a line it understands:
  {"kind": "weather", "place", "temp", "code" (WMO), "hi", "lo", "days": [{"weekday" (0 Monday), "max", "min", "code"}]}
  {"kind": "time"|"diff"|"date"|"hours"|"elapsed"|"span", "answer": "15:42 · Fri 14. 11."}
  {"kind": "transit", "from", "to", "items": [{"dep": "08:12", "arr": "11:40", "minutes", "transfers", "via": "Os 7337 + FlixBus N866", "live"}]}
Places are found OFFLINE: GeoNames' cities of 15,000 people and more (CC BY 4.0: names, their short forms such as SF or NYC,
coordinates, time zones) and OurAirports (public domain: IATA codes), fetched once into ~/.cache/latteos/places.tsv. So "time in
San Francisco", "diff Paris" and "time in JFK" need no network at all; only the weather asks Open-Meteo for the forecast (as
latte-sky does), and the connections ("from Zvolen to Kosice": trains, buses, trams, metro) ask Transitous (transitous.org, open data,
non-commercial; its sources are listed at transitous.org/sources). Without the data file and without a network the places fall back to Open-Meteo's geocoding.
"""
import datetime as dt
import difflib
import io
import json
import math
import os
import re
import sys
import time
import unicodedata
import urllib.parse
import urllib.request
import zipfile
from zoneinfo import ZoneInfo

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "places.tsv")
CITIES = "https://download.geonames.org/export/dump/cities15000.zip"
AIRPORTS = "https://davidmegginson.github.io/ourairports-data/airports.csv"

DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
MONTHS = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]


# The words of the lines: English here, other languages in goo/lang/<code>-amount.json (`calc`, folded), each to its English one. The
# first word of a line may be misspelt: the nearest of these wins (wether → weather), and the small words are the languages' own.
VOCAB = {"route": "route", "connection": "route", "train": "route", "bus": "route", "trip": "route", "weather": "weather", "forecast": "weather", "time": "time", "diff": "diff", "workhours": "workhours", "today": "today",
         "tomorrow": "tomorrow"}
SMALL = {"in": "in", "for": "in", "at": "in"}
SKIP = {"time", "to"}
FROM, TO, AT = {"from"}, {"to"}, {"at", "in"}               # the little words of a connection: from Zvolen to Kosice at 8:00
YEAR = {"year"}
PHRASES = {}                                  # two words said as one: "pracovne hodiny" → workhours


def load_words():
    share = os.environ.get("LATTE_SHARE") or "/usr/share/latteos"
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "goo", "lang")
    for folder in (os.path.join(share, "goo", "lang"), here):
        try:
            names = [n for n in os.listdir(folder) if n.endswith("-amount.json")]
        except OSError:
            continue
        for name in names:
            try:
                calc_words = json.load(open(os.path.join(folder, name), encoding="utf-8")).get("calc") or {}
            except (OSError, ValueError):
                continue
            FROM.update(calc_words.get("from", []))
            TO.update(calc_words.get("to", []))
            AT.update(calc_words.get("at", []))
            for key in ("weather", "time", "diff", "today", "tomorrow", "route"):
                for w in calc_words.get(key, []):
                    VOCAB[w] = key
            for w in calc_words.get("workhours", []):
                PHRASES[w] = "workhours"
            SMALL.update({w: "in" for w in calc_words.get("small", [])})
            SKIP.update(calc_words.get("skip", []))
            YEAR.update(calc_words.get("year", []))
        return


def words_of(line):
    """The line, folded, its first word and the little words put as English ones: 'weather v Bratislave' → 'weather in bratislave'."""
    load_words()
    t = fold(line).split()
    if not t:
        return ""
    t = t[:1] + [SMALL.get(w, w) for w in t[1:]]
    for phrase, word in PHRASES.items():                                    # a two-word name of one thing
        n = len(phrase.split())
        if " ".join(t[:n]) == phrase or (n == 2 and len(t) > 1 and t[0] == phrase.split()[0] and t[1][:5] == phrase.split()[1][:5]):
            t = [word] + [w for w in t[n:] if w not in YEAR]
            break
    if t[0] in VOCAB:
        t[0] = VOCAB[t[0]]
    elif len(t[0]) >= 4:
        close = difflib.get_close_matches(t[0], list(VOCAB), n=1, cutoff=0.78)
        if close and len(t) > 1:                                              # a misspelt first word only counts with something after it
            t[0] = VOCAB[close[0]]
    if t[0] == "diff":
        t = [w for w in t if w not in SKIP]
    return " ".join(t)


def get(url):
    return json.load(urllib.request.urlopen(url, timeout=8))


def fold(text):
    """Lower case without accents: São Paulo = sao paulo."""
    return "".join(c for c in unicodedata.normalize("NFD", text.lower()) if unicodedata.category(c) != "Mn").strip()


def fetch_data():
    """Builds the places file: `C name TAB ,alt,alt, TAB lat TAB lon TAB tz TAB population TAB country` for a city, `A IATA TAB city TAB lat
    TAB lon` for an airport. Latin short names only: the file stays about 3 MB."""
    rows = []
    z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(CITIES, timeout=60).read()))
    for line in z.read("cities15000.txt").decode("utf-8").splitlines():
        f = line.split("\t")
        alts = {fold(a) for a in f[3].split(",") + [f[1]] if a and len(a) <= 24 and all(ord(c) < 0x250 for c in a)}
        rows.append("C\t%s\t,%s,\t%s\t%s\t%s\t%s\t%s" % (f[1], ",".join(sorted(alts)), f[4], f[5], f[17], f[14], f[8]))
    import csv
    for r in csv.DictReader(io.StringIO(urllib.request.urlopen(AIRPORTS, timeout=60).read().decode("utf-8"))):
        if r["iata_code"] and r["scheduled_service"] == "yes":
            rows.append("A\t%s\t%s\t%s\t%s" % (r["iata_code"], r["municipality"], r["latitude_deg"], r["longitude_deg"]))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".new", "w", encoding="utf-8") as f:
        f.write("\n".join(rows) + "\n")
    os.replace(CACHE + ".new", CACHE)


def load_data():
    try:
        return open(CACHE, encoding="utf-8").read().splitlines()
    except OSError:
        pass
    try:
        fetch_data()
        return open(CACHE, encoding="utf-8").read().splitlines()
    except Exception:
        return []


def near(lat, lon, cities):
    """The city nearest those coordinates (for an airport's time zone)."""
    return min(cities, key=lambda c: (float(c["latitude"]) - lat) ** 2 + ((float(c["longitude"]) - lon) * math.cos(math.radians(lat))) ** 2)


def place(name):
    """A place by its name, its short form (sf, nyc) or an airport's IATA code: {name, latitude, longitude, timezone, country} or None."""
    want = fold(name)
    lines = load_data()
    cities, air = [], None
    for line in lines:
        if line[0] == "C":
            if "," + want + "," in line:                     # the names are folded, one in `,a,b,` form
                f = line.split("\t")
                cities.append({"name": f[1], "latitude": f[3], "longitude": f[4], "timezone": f[5], "pop": int(f[6] or 0), "country": f[7]})
        elif line.startswith("A\t" + want.upper() + "\t"):
            f = line.split("\t")
            air = (float(f[3]), float(f[4]))
    if lines and air:
        every = [dict(zip(("name", "latitude", "longitude", "timezone"), l.split("\t")[1:2] + l.split("\t")[3:6])) for l in lines if l[0] == "C"]
        c = near(air[0], air[1], every)
        return {"name": want.upper(), "latitude": c["latitude"], "longitude": c["longitude"], "timezone": c["timezone"], "country": ""}
    if lines and not cities and " " in want:                 # London Heathrow: the city's name first
        first = want.split(" ")[0]
        cities = [{"name": l.split("\t")[1], "latitude": l.split("\t")[3], "longitude": l.split("\t")[4], "timezone": l.split("\t")[5],
                   "pop": int(l.split("\t")[6] or 0), "country": l.split("\t")[7]} for l in lines if l[0] == "C" and "," + first + "," in l]
    if not cities and lines and len(want) >= 4:
        # a case ending or a slip of the finger: Bratislave, Bratislva, Tokiu → the nearest name, the biggest town of them
        names = {}
        for line in lines:
            if line[0] == "C":
                f = line.split("\t")
                for n in [fold(f[1])] + [x for x in f[2].split(",") if len(x) > 4]:
                    names.setdefault(n, f)
        stems = [n for n in names if len(n) > 3 and want.startswith(n[:-1])] if len(want) >= 5 else []       # Bratislave → Bratislava
        if stems:
            longest = max(len(n) for n in stems)
            stems = [n for n in stems if len(n) == longest]            # the longest only: not the short ones that begin the same
        if not stems:
            stems = difflib.get_close_matches(want, list(names), n=3, cutoff=0.75)
        for n in stems:
            f = names[n]
            cities.append({"name": f[1], "latitude": f[3], "longitude": f[4], "timezone": f[5], "pop": int(f[6] or 0), "country": f[7]})
    if cities:
        return dict(max(cities, key=lambda c: c["pop"]))
    try:                                                     # no data, no network for it: the service's own search
        r = get("https://geocoding-api.open-meteo.com/v1/search?count=1&name=" + urllib.parse.quote(name.strip()))
    except Exception:
        return None
    return (r.get("results") or [None])[0]


def clock(t):
    return "%02d:%02d" % (t.hour, t.minute)


def parse_time(s):
    """'4:39pm', '8am', '16:30' → a time of day, or None."""
    m = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm)?", s.strip().lower())
    if not m:
        return None
    h, mi, ap = int(m.group(1)), int(m.group(2) or 0), m.group(3)
    if ap == "pm" and h < 12:
        h += 12
    if ap == "am" and h == 12:
        h = 0
    if h > 23 or mi > 59:
        return None
    return dt.time(h, mi)


def weather(where):
    p = place(where)
    if not p:
        return {}
    try:
        d = get("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current=temperature_2m,weather_code&daily=weather_code,"
                "temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=4" % (p["latitude"], p["longitude"]))
    except Exception:
        return {}
    cur, day = d.get("current") or {}, d.get("daily") or {}
    days = [{"weekday": dt.date.fromisoformat(t).weekday(), "max": round(day["temperature_2m_max"][i]), "min": round(day["temperature_2m_min"][i]),
             "code": day["weather_code"][i]} for i, t in enumerate(day.get("time") or [])]
    if not days:
        return {}
    return {"kind": "weather", "place": "%s, %s" % (p["name"], p.get("country") or p.get("country_code", "")), "temp": round(cur.get("temperature_2m", 0)),
            "code": cur.get("weather_code", 3), "hi": days[0]["max"], "lo": days[0]["min"], "days": days}


def work_hours(year):
    d, n = dt.date(year, 1, 1), 0
    while d.year == year:
        n += d.weekday() < 5
        d += dt.timedelta(days=1)
    return n * 8     # ponytail: public holidays are not taken off; a holiday list per country is the upgrade


def elapsed(word, now):
    if word == "day":
        f = (now.hour * 60 + now.minute) / 1440
    elif word == "week":
        f = (now.weekday() * 1440 + now.hour * 60 + now.minute) / (7 * 1440)
    elif word == "month":
        days = (dt.date(now.year + now.month // 12, now.month % 12 + 1, 1) - dt.date(now.year, now.month, 1)).days
        f = ((now.day - 1) * 1440 + now.hour * 60 + now.minute) / (days * 1440)
    else:
        start = dt.datetime(now.year, 1, 1)
        f = (now.replace(tzinfo=None) - start) / (dt.datetime(now.year + 1, 1, 1) - start)
    return "%.1f %%" % (f * 100)


# ── connections: Transitous (MOTIS), the open routing service of public transport ─────────────────────────────────────
PLAN = "https://api.transitous.org/api/v5/plan"
GEOCODE = "https://api.transitous.org/api/v1/geocode"
AGENT = "latteos-calc/0.1"                    # Transitous asks every client to say who it is (name, version, contact); ponytail: no contact is given until the project has one
TRANSIT_CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "transit.json")


def fetch(url):
    return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": AGENT}), timeout=20))


def where(name):
    """A place for a connection: a town known offline, else the first place or stop Transitous knows by that name: (lat, lon, name) or None."""
    p = place(name)
    if p and "latitude" in p:
        return float(p["latitude"]), float(p["longitude"]), p["name"]
    try:
        for r in fetch(GEOCODE + "?language=en&text=" + urllib.parse.quote(name.strip())):
            if r.get("lat", -1) > 0 or r.get("lon", -1) > 0:
                return r["lat"], r["lon"], r["name"].split(",")[0]
    except Exception:
        pass
    return None


def transit(a, b, at=None, now=None):
    """The next connections from a to b (names), from `at` (a time of day) or now: up to three, each {dep, arr, minutes, transfers, via, live}."""
    now = now or dt.datetime.now().astimezone()
    start, end = where(a), where(b)
    if not start or not end:
        return {}
    when = now
    if at:
        when = now.replace(hour=at.hour, minute=at.minute, second=0, microsecond=0)
        if when < now - dt.timedelta(minutes=5):
            when += dt.timedelta(days=1)
    key = "%s|%s|%s" % (start[:2], end[:2], when.strftime("%Y%m%d%H%M"))
    cached = None
    try:
        cached = json.load(open(TRANSIT_CACHE))
        if cached.get("key") == key and time.time() - cached.get("at", 0) < 300:     # the same question within five minutes: asked once (Transitous counts them)
            return cached["answer"]
    except (OSError, ValueError, AttributeError):
        pass
    try:
        d = fetch("%s?fromPlace=%s,%s&toPlace=%s,%s&time=%s&numItineraries=4" % (PLAN, start[0], start[1], end[0], end[1],
                  urllib.parse.quote(when.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))))
    except Exception:
        return {}
    items = []
    for it in d.get("itineraries") or []:
        legs = [l for l in it.get("legs", []) if l.get("mode") not in ("WALK", "BIKE", "CAR")]
        if not legs:
            continue
        names = []
        for l in legs:
            line = l.get("routeShortName") or l.get("displayName") or l.get("mode", "").title()
            agency = (l.get("agencyName") or "").split(" ")[0].split("-")[0]
            names.append(("%s %s" % (agency, line) if l.get("mode") == "COACH" and agency and agency.lower() not in line.lower() else line).strip())
        # the walk to the first stop and from the last is not the journey: it is counted from the first vehicle to the last
        d0 = dt.datetime.fromisoformat(legs[0]["startTime"].replace("Z", "+00:00")).astimezone()
        d1 = dt.datetime.fromisoformat(legs[-1]["endTime"].replace("Z", "+00:00")).astimezone()
        items.append({"dep": clock(d0), "arr": clock(d1), "minutes": int((d1 - d0).total_seconds() // 60), "transfers": max(0, len(legs) - 1),
                      "via": " + ".join(names), "live": any(l.get("realTime") for l in legs), "mode": legs[0].get("mode", ""), "_at": d0.isoformat()})
    items.sort(key=lambda i: i["_at"])
    for i in items:
        del i["_at"]
    answer = {"kind": "transit", "from": start[2], "to": end[2], "items": items[:3]} if items else {}
    try:
        os.makedirs(os.path.dirname(TRANSIT_CACHE), exist_ok=True)
        json.dump({"key": key, "at": time.time(), "answer": answer}, open(TRANSIT_CACHE, "w"))
    except OSError:
        pass
    return answer


def route(tokens):
    """"from zvolen to kosice at 8:00", "route zvolen kosice": the two places and the time of day, or None."""
    t = list(tokens)
    if t and (t[0] in FROM or t[0] == "route"):
        t = t[1:]
    at = None
    for i, w in enumerate(t):
        if w in AT and i + 1 < len(t) and parse_time(t[i + 1]):
            at, t = parse_time(t[i + 1]), t[:i]
            break
    cut = next((i for i, w in enumerate(t) if w in TO), None)
    if cut is not None and 0 < cut < len(t) - 1:
        return " ".join(t[:cut]), " ".join(t[cut + 1:]), at
    if len(t) == 2:                                           # "route zvolen kosice"
        return t[0], t[1], at
    return None


def calc(line, now=None):
    s = words_of(line)
    now = now or dt.datetime.now().astimezone()
    first = s.split(" ")[0] if s else ""
    if first in ("route", "from") or first in FROM:
        r = route(s.split(" "))
        if r:
            return transit(r[0], r[1], r[2], now)
    m = re.fullmatch(r"(?:weather|forecast)\s+(?:in|for|at)\s+(.+)", s)
    if m:
        return weather(m.group(1))
    m = re.fullmatch(r"(?:time\s+)?diff\s+(.+)", s) or re.fullmatch(r"time\s+difference\s+(?:to\s+)?(.+)", s)
    if m:
        p = place(m.group(1))
        if not p:
            return {}
        there = now.astimezone(ZoneInfo(p["timezone"]))
        d = (there.utcoffset() - now.utcoffset()).total_seconds() / 3600
        return {"kind": "diff", "answer": ("%+g h" % d) if d else "0 h"}
    m = re.fullmatch(r"time\s+in\s+(.+?)\s*\+\s*(\d+(?:\.\d+)?)\s*(?:hours?|h)", s)        # time in brisbane + 4 hours
    if m:
        p = place(m.group(1))
        if not p:
            return {}
        t = now.astimezone(ZoneInfo(p["timezone"])) + dt.timedelta(hours=float(m.group(2)))
        return {"kind": "time", "answer": "%s · %s %d. %d." % (clock(t), DAYS[t.weekday()], t.day, t.month)}
    m = re.fullmatch(r"time(?:\s+in\s+(\d+(?:\.\d+)?)\s*(?:hours?|h))?(?:\s+in\s+(.+))?", s)
    if m and (m.group(1) or m.group(2)):
        t = now
        if m.group(2):
            p = place(m.group(2))
            if not p:
                return {}
            t = now.astimezone(ZoneInfo(p["timezone"]))
        if m.group(1):
            t += dt.timedelta(hours=float(m.group(1)))
        return {"kind": "time", "answer": "%s · %s %d. %d." % (clock(t), DAYS[t.weekday()], t.day, t.month)}
    m = re.fullmatch(r"workhours\s+in\s+(\d{4})", s)
    if m:
        return {"kind": "hours", "answer": "%d h" % work_hours(int(m.group(1)))}
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*h(?:ours?)?\s+(?:in|to)\s+workdays?", s)
    if m:
        v = float(m.group(1)) / 8
        return {"kind": "hours", "answer": "%g workdays" % round(v, 2)}
    m = re.fullmatch(r"(day|week|month|year)\s*(?:percentage|%)", s)
    if m:
        return {"kind": "elapsed", "answer": elapsed(m.group(1), now)}
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(days?|weeks?|hours?|h)\s+from\s+now(?:\s+at\s+(.+))?", s)
    if m:
        n, unit = float(m.group(1)), m.group(2)
        t = now + dt.timedelta(**{("hours" if unit[0] == "h" else "weeks" if unit[0] == "w" else "days"): n})
        if m.group(3):
            at = parse_time(m.group(3))
            if not at:
                return {}
            t = t.replace(hour=at.hour, minute=at.minute, second=0, microsecond=0)
        return {"kind": "date", "answer": "%s %d. %d. %s" % (DAYS[t.weekday()], t.day, t.month, clock(t)) if m.group(3) else "%s %d. %d." % (DAYS[t.weekday()], t.day, t.month)}
    m = re.fullmatch(r"(%s)\s+(\d{1,2})\s*\+\s*(\d+)(?:\s*days?)?" % "|".join(MONTHS), s)
    if m:
        t = dt.date(now.year, MONTHS.index(m.group(1)) + 1, int(m.group(2))) + dt.timedelta(days=int(m.group(3)))
        return {"kind": "date", "answer": "%s %d. %d." % (DAYS[t.weekday()], t.day, t.month)}
    m = re.fullmatch(r"(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)\s*\+\s*(\d+(?:\.\d+)?)(?:\s*(?:hours?|h))?", s)
    if m and parse_time(m.group(1)) and re.search(r"am|pm|:", m.group(1)):
        at = parse_time(m.group(1))
        t = dt.datetime.combine(dt.date.today(), at) + dt.timedelta(hours=float(m.group(2)))
        return {"kind": "time", "answer": clock(t)}
    m = re.fullmatch(r"(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)\s+to\s+(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)", s)
    if m and parse_time(m.group(1)) and parse_time(m.group(2)):
        a, b = parse_time(m.group(1)), parse_time(m.group(2))
        mins = (b.hour * 60 + b.minute - a.hour * 60 - a.minute) % 1440
        return {"kind": "span", "answer": ("%d h %d min" % (mins // 60, mins % 60)) if mins % 60 else "%d h" % (mins // 60)}
    return {}


if __name__ == "__main__":
    print(json.dumps(calc(" ".join(sys.argv[1:]))))
