    "ollama": {"name": "Ollama", "local": True, "style": "own", "tool": "ollama", "command": ollama, "models": ollama_models},
}


def turned_off():
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai")) as f:
            return f.read().strip() == "off"
    except OSError:
        return False


# ── the field's menus, each a copy of the service's own (the user's pictures, 21. 10.): + and its chip ───────────────
# LensGoo and LensAI draw them from here. A row: name, glyph (Tabler), "do" — what LatteOS does with it:
# {"attach": 0 file | 1 picture of the screen}, {"model": id}, {"effort": e}, {"think": true} (effort on or off),
# {"reset": true} (the field emptied), {"sub": [rows]} (a menu beside it); a row without "do" opens the service's page
# ("web"), drawn in one colour shared by all. desc under the name, hint after it, key at the right ("@effort": the
# effort chosen), sep a line before it, more a chevron, note a small text, on ticked whatever is chosen
WEB = {"claude": "https://claude.ai/new", "gemini": "https://gemini.google.com/app", "chatgpt": "https://chatgpt.com/",
       "grok": "https://grok.com/", "mistral": "https://chat.mistral.ai/chat", "copilot": "https://github.com/copilot",
       "deepseek": "https://chat.deepseek.com/"}


def _row(name, glyph=None, do=None, **o):
    r = dict(o, name=name)
    if glyph:
        r["glyph"] = glyph
    if do is not None:
        r["do"] = do
    return r


ATTACH, SHOT = {"attach": 0}, {"attach": 1}
# + offers what LatteOS itself does, the same for every service (the user, 10. 11.): what a service's own page
# offers beside that is in its tab in LensAI
PLUS = [_row(N("Attach a file…"), "paperclip", ATTACH), _row(N("A picture of the screen"), "screenshot", SHOT)]
EFFORT_WORDS = {"low": N("low"), "medium": N("medium"), "high": N("high"), "xhigh": N("very high"), "max": N("highest"), "think": N("thinking")}


def chip_menu(p):
    """The menu of the field's chip: the models, and how hard it may think where the tool lets that be said."""
    rows = [_row(m["name"], do={"model": m["id"]}) for m in p["models"][:9]]
    efforts = [_row(EFFORT_WORDS.get(e, e), do={"effort": e}) for e in p.get("efforts", [])]
    if efforts:
        rows.append(_row(N("Effort"), do={"sub": efforts}, sep=True, more=True, key="@effort"))
    return rows


def menus(p):
    return {"web": WEB.get(p["style"], ""), "plus": PLUS, "menu": chip_menu(p)}


def providers(all=False, every=False):
    """What can answer; `every` keeps the models the user hid, for LensAI to show them."""
    if turned_off() and not all:
        return []
    out = []
    for i, p in PROVIDERS.items():
        if not (local_server() if i == "local" else shutil.which(p["tool"], path=SEARCH)):
            continue
        models = p["models"]() if callable(p["models"]) else p["models"]
        if models:
            out.append({"id": i, "name": p["name"], "local": p["local"], "style": p["style"], "models": models, "efforts": p.get("efforts", [])})
    for i, a in apis().items():
        if a.get("server") or secret(i):
            models = api_models(i)
            if models:
                out.append({"id": i, "name": a["name"], "local": False, "style": a["style"], "models": models, "efforts": []})
    if every:
        return out
    c = choice()
    for p in out:
        p["models"] = [m for m in p["models"] if "%s/%s" % (p["id"], m["id"]) not in c["hidden"]]
        p["models"].sort(key=lambda m: "%s/%s" % (p["id"], m["id"]) != c["default"])
    out = [p for p in out if p["models"]]
    out.sort(key=lambda p: not c["default"].startswith(p["id"] + "/"))
    for p in out:
        p.update(menus(p))
    return out


def services():
    out = []
    for i, p in PROVIDERS.items():
        there = (local_server() if i == "local" else shutil.which(p["tool"], path=SEARCH)) is not None
        signed, account = None, ""
        if there and p.get("status"):
            try:
                st = json.loads(subprocess.run(p["status"], capture_output=True, text=True, timeout=20, env=dict(os.environ, PATH=SEARCH)).stdout)
                signed = st.get("loggedIn") is True
                account = " · ".join(x for x in (st.get("email", ""), st.get("subscriptionType", "")) if x)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
        elif there and p.get("signed"):       # a tool that says it only by how it ends
            try:
                signed = subprocess.run(p["signed"], capture_output=True, timeout=20, env=dict(os.environ, PATH=SEARCH)).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                pass
        # the whole path of the tool: the terminal the centre opens has the desktop's short PATH, without ~/.local/bin
        whole = lambda argv: ([shutil.which(argv[0], path=SEARCH) or argv[0]] + argv[1:]) if argv else []
        out.append({"id": i, "name": p["name"], "local": p["local"], "style": p["style"], "installed": there, "tool": p["tool"],
                    "signed": True if p["local"] and there else signed, "account": account, "login": whole(p.get("login", [])), "logout": whole(p.get("logout", [])),
                    "install": ("mise install " + MISE_TOOLS[i]) if i in MISE_TOOLS and shutil.which("mise") else INSTALL.get(i, "")})
    return out


def as_prompt(talk):
    """The conversation as one question: the tools are asked afresh each time."""
    talk = [m for m in talk if m.get("content")][-KEEP:]
    if len(talk) <= 1:
        return talk[0]["content"] if talk else ""
    lines = ["%s: %s" % ("User" if m.get("role") == "user" else "Assistant", m["content"]) for m in talk[:-1]]
    return "The conversation so far:\n" + "\n".join(lines) + "\n\nNow answer this:\n" + talk[-1]["content"]


def path_of(ident):
    return os.path.join(CHATS, os.path.basename(ident) + ".json")


def load(ident):
    try:
        with open(path_of(ident)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def keep(chat):
    os.makedirs(CHATS, exist_ok=True)
    with open(path_of(chat["id"]) + ".new", "w") as f:
        json.dump(chat, f, ensure_ascii=False, indent=1)
    os.replace(path_of(chat["id"]) + ".new", path_of(chat["id"]))


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def instructions():
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai-instructions.txt")) as f:
            said = f.read().strip()[:4000]
    except OSError:
        return ""
    return ("\n\nWhat the user asks of you in every conversation:\n" + said) if said else ""


def send(ident, provider, model, question, effort="", attach=(), origin=""):
    global SYSTEM
    if "What the user asks of you" not in SYSTEM:
        SYSTEM += instructions()
    chat = None if ident == "new" else load(ident)
    if chat and chat.get("imported"):              # another assistant's conversation, kept as it came: read only
        return {"chat": ident, "answer": N("An imported conversation is read only: begin a new one."), "ok": False, "usage": chat.get("usage") or {}, "stopped": False}
    if chat is None:
        chat = {"id": uuid.uuid4().hex[:12], "title": question.strip().splitlines()[0][:80], "messages": [],
                "usage": {"context": 0, "window": 0, "tokens": 0, "cost": 0}, "from": origin}
    chat["provider"], chat["model"], chat["effort"] = provider, model, effort
    # what is attached is copied beside the question: the tool runs in that folder and reads nothing else
    room = os.path.join(ROOM, "files", chat["id"])
    files = []
    for path in attach:
        if os.path.isfile(path):
            os.makedirs(room, exist_ok=True)
            shutil.copy(path, os.path.join(room, os.path.basename(path)))
            files.append(os.path.basename(path))
    chat["messages"].append({"role": "user", "content": question, "provider": provider, "model": model, "at": now(), "files": files})
    keep(chat)          # the question stays even if no answer comes
    p = PROVIDERS.get(provider) or ({"ask": api_ask(provider), "tool": ""} if provider in apis() else None)
    answer, ok, usage, stopped = "", False, {}, False
    try:
        answer, ok, usage = ask_one(p, provider, chat, model, effort, files, room)
    except Stopped:
        if CHILD and CHILD.poll() is None:
            CHILD.terminate()
        answer, ok, stopped = "".join(PIECES).strip(), bool(PIECES), True
    msg = {"role": "assistant", "content": answer, "provider": provider, "model": model, "at": now(), "ok": ok}
    if USED:
        msg["used"] = list(USED)
    if stopped:
        msg["stopped"] = True
    chat["messages"].append(msg)
    was = chat.get("usage") or {}
    chat["usage"] = {"context": usage.get("context", was.get("context", 0)), "window": usage.get("window", was.get("window", 0)),
                     "tokens": was.get("tokens", 0) + usage.get("tokens", 0), "cost": round(was.get("cost", 0) + usage.get("cost", 0), 6),
                     "limits": usage.get("limits") or {}}
    chat["updated"] = now()
    keep(chat)
    return {"chat": chat["id"], "answer": answer, "ok": ok, "usage": chat["usage"], "stopped": stopped}


def ask_one(p, provider, chat, model, effort, files, room):
    """One answer from whoever it is: the API of a key or a server, the AI on this computer, or a tool."""
    answer, ok, usage = "", False, {}
    if p and provider in apis():
        try:
            answer, ok, usage = p["ask"](chat["messages"], model, effort, files, room)
        except Exception as e:          # whatever the service answers with (a refused key, a model it does not have) is told, not thrown
            answer = "latte-ai: %s" % e
    elif not p or not (local_server() if provider == "local" else shutil.which(p["tool"], path=SEARCH)):
        answer = "latte-ai: no such provider here: " + provider
    elif "ask" in p:
        try:
            answer, ok, usage = p["ask"](chat["messages"], model, effort, files, room)
        except (OSError, ValueError, KeyError) as e:
            answer = "latte-ai: " + str(e)
    else:
        os.makedirs(room if files else ROOM, exist_ok=True)
        global CHILD
        import threading
        env = dict(os.environ, PATH=SEARCH)
        if provider == "copilot" and "GH_TOKEN" not in env:
            token = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True).stdout.strip()   # the account gh is signed in with
            if token:
                env["GH_TOKEN"] = token
        CHILD = subprocess.Popen(p["command"](as_prompt(chat["messages"]), model, effort, files), cwd=room if files else ROOM, env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        late = threading.Timer(300, CHILD.kill)
        late.start()
        out, err = [], []
        aside = threading.Thread(target=lambda: err.append(CHILD.stderr.read()), daemon=True)     # read as it comes: a full pipe would stop the tool
        aside.start()
        for line in CHILD.stdout:
            out.append(line)
            if "read" in p:
                # Claude's events: the pieces of text, as it writes them
                try:
                    e = json.loads(line)
                    d = (e.get("event") or {}).get("delta") or {}
                    if e.get("type") == "stream_event" and d.get("type") == "text_delta":
                        piece(d.get("text", ""))
                except ValueError:
                    pass
            else:
                piece(line)
        code = CHILD.wait()
        late.cancel()
        aside.join(5)
        err = "".join(err)
        answer, ok = "".join(out).strip(), code == 0
        if "read" in p:
            try:
                answer, ok, usage = p["read"]("".join(out))
            except (ValueError, AttributeError):
                pass
        if not answer:
            answer = err.strip()[-600:] or ("latte-ai: no answer in five minutes" if code == -9 else "latte-ai: no answer")
    return answer, ok, usage


def chats():
    out = []
    for path in glob.glob(os.path.join(CHATS, "*.json")):
        c = load(os.path.basename(path)[:-5])
        if c:
            out.append({"id": c["id"], "title": c.get("title", ""), "provider": c.get("provider", ""), "model": c.get("model", ""),
                        "updated": c.get("updated", ""), "count": len(c.get("messages", [])),
                        "from": c.get("from", ""), "machine": c.get("from", "") in MACHINE})
    return sorted(out, key=lambda c: c["updated"], reverse=True)


# ── the helpers, as Omarchy keeps them (MIT; manual 13 and 17): what helps the system is a toggle that can be turned off —
# a flag named for the off state in ~/.local/state/latteos/toggles (Omarchy's ~/.local/state/omarchy/toggles), which
# stops the offer and never the thing itself (latte-ai crash PID works by hand) — and who does the work is a default
# the user picks (Omarchy's Setup › Defaults): the agent (AGENT_WORD, none picked for them: once, an invitation), and
# who reads a sentence (HELPER_WORD): this computer (nothing leaves it) unless they choose Claude Haiku.
TOGGLES = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "toggles")
HELPER_WORD = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "helper")
SWITCHES = {
    "crash-capture": {"name": N("Ask the AI about a crash"), "glyph": "bug",
                      "desc": N("A program of yours that crashed gets a notice with “Ask the AI”: your agent explains what happened and changes nothing.")},
    "calendar-ai": {"name": N("The calendar reads a sentence with the AI"), "glyph": "calendar-plus",
                    "desc": N("What the words do not read (“the dentist the week after next, after lunch”) goes to the helper below; what it read is shown before it is added.")},
}


def switched_on(name):
    return not turned_off() and not os.path.isfile(os.path.join(TOGGLES, name + "-off"))


def switch(name, action):
    flag = os.path.join(TOGGLES, name + "-off")
    off = action == "off" or (action == "toggle" and not os.path.isfile(flag))
    if off:
        os.makedirs(TOGGLES, exist_ok=True)
        open(flag, "w").close()
    elif os.path.isfile(flag):
        os.remove(flag)


def chosen(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def helper_who():
    return chosen(HELPER_WORD) or "local"


def haiku_ways():
    return [w for w, there in (("key", secret("api-anthropic") is not None), ("claude", shutil.which("claude", path=SEARCH) is not None)) if there]


def quick_model():
    """The smallest model over 2 GB: a 2B one (Qwen3.5) left the day out of the sentences, a 4B one read them (21. 10.)."""
    ms = [m for m in local_models_all() if m["size"] > 2e9] or local_models_all()[-1:]
    return ms[0] if ms and local_server() else None


def helpers():
    """LensAI's Helpers page: the defaults, the toggles, and the programs whose crashes are not told (GuardCorgi's)."""
    try:
        muted = json.loads(subprocess.run(["latte-guardcorgi", "quiet"], capture_output=True, text=True, timeout=10).stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        muted = []
    m, have = quick_model(), acp_installed()
    return {"ai": not turned_off(), "agent": chosen(AGENT_WORD),
            "agents": [{"id": i, "name": d["name"], "installed": shutil.which(d["tool"], path=SEARCH) is not None or ACP_OF[i] in have} for i, d in DOERS.items()]
                      + [{"id": "acp:" + r, "name": g.get("name") or r, "installed": True} for r, g in have.items() if r not in ACP_OF.values()],
            "helper": helper_who(), "local": m["name"] if m else "", "haiku": haiku_ways(),
            "switches": [dict(v, id=k, on=switched_on(k)) for k, v in SWITCHES.items()], "muted": muted}


def invite():
    """Once, as Omarchy's first run does: no agent is picked for the user, so they are asked to pick one."""
    done = os.path.join(TOGGLES, "..", "done", "agent-invitation")
    if turned_off() or chosen(AGENT_WORD) or os.path.exists(done) or not doers() or not shutil.which("notify-send"):
        return
    os.makedirs(os.path.dirname(done), exist_ok=True)
    open(done, "w").close()
    a = subprocess.run(["notify-send", "-a", "LatteOS", "--wait", "--action=pick=" + T("Choose"), T("Choose your agent"),
                        T("Let your favourite agent help with LatteOS: crashes, tasks, questions about this computer.")],
                       capture_output=True, text=True).stdout.strip()
    if a == "pick":
        subprocess.Popen(["latte-app", "aicenter", "helpers"], start_new_session=True)


def modules():
    """What of LensAI is downloaded (Settings › AI): LensAI itself is part of LatteOS, its add-ons are not — the official
    tools of the services, the AI on this computer (llama.cpp and its models) and turning speech into text (whisper)."""
    return {"ai": not turned_off(),
            "services": [{"id": i, "name": p["name"], "installed": shutil.which(p["tool"], path=SEARCH) is not None}
                         for i, p in PROVIDERS.items() if not p["local"]],
            "local": {"runtime": local_server() is not None, "models": len(local_models_all())},
            "voice": whisper()[0] is not None}


def quick(prompt, who):
    """One question, the answer alone, or None: on this computer (quick_model), or Claude Haiku — by its API with a key of
    one's own (a second or two), else Claude Code signed in (some ten seconds, most of it starting). Like Omarchy's
    dictation clean-up (voxtype post_process): whoever asks keeps what it had when this fails."""
    if who == "haiku":
        ways = haiku_ways()
        if "key" in ways:
            r = api_call(dict(APIS["api-anthropic"], id="api-anthropic"), "/messages",
                         {"model": "claude-haiku-5-5", "max_tokens": 256, "messages": [{"role": "user", "content": prompt}]}, timeout=60)
            return "".join(b.get("text", "") for b in r.get("content", [])).strip()
        if "claude" in ways:
            done = subprocess.run([shutil.which("claude", path=SEARCH), "-p", prompt, "--model", "haiku", "--no-session-persistence",
                                   "--setting-sources", "project", "--strict-mcp-config", "--tools", ""],
                                  capture_output=True, text=True, timeout=120, cwd=os.path.expanduser("~"))
            return done.stdout.strip() if done.returncode == 0 else None
        return None
    m = quick_model()
    if not m or not local_start(m["id"]):
        return None
    return chat_completion("http://127.0.0.1:%d/v1" % LOCAL_PORT, {}, {"model": local_name(m["id"]), "messages": [{"role": "user", "content": prompt}], "temperature": 0,
                                                                        "max_tokens": 256, "chat_template_kwargs": {"enable_thinking": False}})[0]


def main(a):
    if a in (["providers"], ["providers", "all"]):
        print(json.dumps(providers(len(a) == 2)))
        return 0
    global STREAM, SYSTEM
    if a[:1] in (["send"], ["again"]):
        if turned_off():                # Settings › AI: nothing leaves, whoever asks
            print(json.dumps({"chat": "", "answer": "latte-ai: the AI is turned off (Settings › AI)", "ok": False, "usage": {}, "stopped": False}))
            return 1
        effort, attach, text, skills, origin, rest = "", [], None, "", "", a[5:] if a[0] == "send" else a[4:]
        while rest:
            if rest[0] == "--effort" and len(rest) > 1:
                effort, rest = rest[1], rest[2:]
            elif rest[0] == "--attach" and len(rest) > 1:
                attach, rest = attach + [rest[1]], rest[2:]
            elif rest[0] == "--text" and len(rest) > 1:
                text, rest = rest[1], rest[2:]
            elif rest[0] == "--skills" and len(rest) > 1:
                skills, rest = rest[1], rest[2:]
            elif rest[0] == "--from" and len(rest) > 1:
                origin, rest = rest[1], rest[2:]
            else:
                STREAM = STREAM or rest[0] == "--stream"
                SYSTEM = SYSTEM_MD if rest[0] == "--markdown" else SYSTEM
                rest = rest[1:]
        if skills:
            SYSTEM += "\n\n" + skills

        def stop(*_):
            raise Stopped()
        import signal
        signal.signal(signal.SIGTERM, stop)
    if len(a) >= 4 and a[0] == "again":
        c = load(a[1])
        if not c or c.get("imported"):
            return 1
