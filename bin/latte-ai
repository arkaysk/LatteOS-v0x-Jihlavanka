#!/usr/bin/env python3
"""latte-ai: who answers in LensGoo's AI mode and in LensAI, and the conversations kept with them.
No API key: the official tool of a service answers, with the account the user is logged in to it with.

  latte-ai providers [all]  what there is on this computer: [{"id", "name", "local", "style", "models": [{"id", "name"}],
                            "efforts": [how hard it may think, from least to most; empty when it cannot be told]}];
                            "local" tells an answer made on this machine from one that goes to a service, "style"
                            whose look the field to write in takes (claude, gemini, grok, chatgpt, own); "web" the
                            service's page, "plus" and "menu" the rows of the field's + and chip (see PLUS). None when the
                            user turned the AI off (Settings › AI: the word "off" in ~/.config/latteos/ai), unless `all`
  latte-ai send CHAT PROVIDER MODEL TEXT [--effort E] [--attach PATH]… [--stream] [--markdown]
                            asks the next question of a conversation and keeps both in it. CHAT "new" begins one.
                            A model "" is the tool's own choice. What is attached is copied beside the question, and
                            the tool may read only that: files and pictures, never the rest of the computer.
                            Prints {"chat", "answer", "ok", "usage": {"context", "window", "tokens", "cost", "limits"}}:
                            context is what the last question filled of the model's window, tokens all the
                            conversation has spent, limits what the service told of the account's own:
                            {"five_hour": {"used": 0…1, "resets": unix time}, "seven_day": {…}} (Claude tells them).
                            What went wrong is the answer, with "ok": false.
                            --stream: the answer is printed as it comes too, a line {"delta": text} for each piece,
                            before the last line. --markdown: the answer may be formatted (LensAI shows
                            Markdown; LensGoo's card does not). Ended (SIGTERM), it keeps what had come, "stopped": true.
                            --skills TEXT: what LatteOS can change for the user, added to what the AI is told
                            (LensShore: goo/lib/skills.luau). --from NAME: who began the conversation (lensai,
                            lensgoo, lensshore, chapolera…), kept with it as "from"; one begun by a program for
                            its own work (MACHINE) is "machine" in `chats`, and LensAI does not list it.
                            With the AI turned off (Settings › AI) nothing is asked: "ok": false
  latte-ai again CHAT PROVIDER MODEL [--text TEXT] [same options as send]
                            the last answer once more, from this service and model; with --text the last question
                            is changed first
  latte-ai services         every service LatteOS knows, also those not installed, for LensAI:
                            [{"id", "name", "local", "style", "installed", "signed" (true, false, or null where it
                            cannot be told), "account", "login": [command], "logout": [command], "install": shell}]; a
                            command to sign in or out, or to install the tool, is run in a terminal, where it asks what it needs
  latte-ai pick             a file chooser; the paths chosen, one a line
  latte-ai shot             a picture of the screen now; its path
  latte-ai keys             the services one can bring a key of one's own to, as in VS Code, and the user's own
                            servers: [{"id", "name", "style", "url", "has" (a key is kept), "tail" (its last four
                            characters), "page" (where a key is made), "locked" (the keyring is), "server" (one of the user's)}]
  latte-ai key ID           keeps the key read from stdin, in the system's keyring (never in a file); refused,
                            {"error": "locked" | "refused"}
  latte-ai forget-key ID    takes it out of the keyring
  latte-ai server add NAME URL     a server of the user's own that speaks the OpenAI API (llama-server, Ollama…)
  latte-ai server remove ID
  latte-ai agents           what the services tell of the accounts and what was used, for LensAI's agents panel:
                            {"services": [{"id", "name", "plan", "signed", "login", "limits": [{"label", "used", "resets",
                            "scope" (one model's own), "note" (a sum: the extra usage), "off"}], "asked"}],
                            "stats": {"week", "today", "model", "busiest", "prompts", "sessions", "days": [{"day", "tokens"}]}}
  latte-ai skill install|reset|path   LatteOS's skill for the agents (Claude Code, Codex, Gemini): the user's copy in
                            ~/.config/latteos/skills/latteos, linked into each agent's skills; reset brings back LatteOS's own
  latte-ai skills           every agent skill on this computer, once by its real SKILL.md: [{"name", "description", "path",
                            "home" (latteos, claude, agents, codex, other: where the file lives), "seen" (the tools that
                            find it: Claude Code, Codex, Gemini CLI)}]
  latte-ai sessions [N]     the user's Claude Code sessions, the newest N (30): [{"id", "title" (the first prompt), "folder",
                            "when", "turns"}]; one goes on with `claude --resume ID` run in "folder"
  latte-ai do TASK [AGENT] [--in DIR]  "Do it for me": the agent (claude, chatgpt = Codex, gemini; else the chosen one) on
                            the task in a terminal (in DIR, else home), planning first with LatteOS's skill and changing
                            nothing until the user says yes
  latte-ai doer AGENT       the agent "Do it for me" and crashes go to (~/.config/latteos/agent); none is picked for the user
                            (an agent installed from the ACP Registry: acp:ID)
  latte-ai acp list · acp refresh   the ACP Registry's agents (the list kept a day, refresh: now; offline the last one), the
                            ones the Helper can use first: [{"id", "name", "description", "version", "license", "icon",
                            "svg", "url", "kind": binary|npx|uvx|"" (none for this computer), "needs", "missing",
                            "signin", "installed": version|"", "doer", "usable"}]
  latte-ai acp install ID · acp remove ID   one into ~/.local/share/latteos/acp/ID (as Zed installs them; a binary checked
                            against its sha256), or out of it: {"ok", "error"}; its sign-in is its own, at its first task
  latte-ai running          the agents at work now, for LensShore: [{"agent", "name", "pid", "title", "where", "window",
                            "state", "host"}]; "window" is the address of the terminal it runs in ("" for none: "host"
                            says where it is then, e.g. "VS Code" for one in an editor reached over ssh), "state" is
                            "working", "waiting" (for the user: Claude Code says so in the title) or "" (not told)
  latte-ai modules          what of LensAI is downloaded, for Settings › AI: {"ai", "services": [{"id", "name",
                            "installed"}], "local": {"runtime", "models"}, "voice"}
  latte-ai helpers          LensAI's Helpers page: the agent, who reads a sentence, the toggles, the programs muted
  latte-ai toggle NAME [on|off|toggle]   a helper (crash-capture, calendar-ai), as Omarchy's toggles: a flag named for the
                            off state in ~/.local/state/latteos/toggles; alone, the exit code says whether it is on
  latte-ai helper local|haiku   who reads a sentence: this computer (nothing leaves it) or Claude Haiku (~/.config/latteos/helper)
  latte-ai quick --for NAME PROMPT   one question for a helper, the answer alone; exit 1 when it is off or fails
  latte-ai offer-crash      exit 0 when GuardCorgi offers "Ask the AI" for a crash: the toggle on and an agent chosen
  latte-ai invite           once: a notice asking the user to choose their agent (latte-session, a minute in)
  latte-ai local up | hardware | recommend | models | search TEXT [best|downloads|updated|likes] | files REPO | readme REPO |
                 get REPO FILE | downloads | cancel NAME | runtime get | gpu on|off | remove PATH |
                 set MODEL KEY N|auto… | estimate MODEL CTX NGL
                            the AI on this computer: what it can carry, LatteOS's recommended models (with "fit": gpu ·
                            partial · cpu · too-big, and the "best"), Hugging Face's GGUF models as LM Studio lists them,
                            a download ({"got", "total"} lines, then {"done"}; ended, it is paused: `downloads` lists those,
                            `get` goes on, `cancel` drops one, by its name or its file), llama.cpp's Vulkan build. models: each with "vision",
                            "tools", "reasoning", its "settings" (ctx ngl threads batch ubatch parallel mlock mmap; "own":
                            those the user set) and "memory" {"gpu", "total", "vram", "free", "ram", "fit", "layers", "context",
                            "measured" (llama.cpp's own count, else one from the file's head)}; `models measured` has
                            llama.cpp count those it has not yet (a second each)
  latte-ai crash PID        a program that crashed (systemd-coredump): the agent finds out what happened and explains it
  latte-ai why              in SAFE: the agent finds out why the last session ended and explains it
  latte-ai models           every model of every service there is, for LensAI: [{"id", "name", "models":
                            [{"id", "name", "hidden", "default"}]}]; `providers` leaves the hidden ones out and puts
                            the default first
  latte-ai model show|hide|default PROVIDER MODEL
  latte-ai hands            the agent's own pointer and keyboard (pleamar-wm agent), where each may go: {"mouse": {"scope",
                            "apps"}, "keys": {…}}; scope off · os (LatteOS's own windows, the default) · apps (the ones named) · all
  latte-ai hands set mouse|keys off|os|apps|all [APP…]   written as pleamar-wm's rules (gate.rules, TOOL mouse/keys);
                            APP is a window's app id (its .desktop name); `hands apply` writes them as they are
  latte-ai listen start|stop    the microphone: start records, stop ends it and prints what was said, {"text"}
                            (whisper.cpp, in the language of the desktop; a build with Vulkan and the large-v3-turbo
                            model when there is one, else the small model on the processor)
  latte-ai agent NAME [TEXT]    a small fixed task (a micro-agent) as a question for the AI: {"question", "provider",
                            "model"}; the text is TEXT, or the clipboard when there is none. NAME: summarize, translate,
                            explain, command. It goes to the AI on this computer when there is one: quick, and the
                            clipboard does not leave the computer
  latte-ai usage PROVIDER   {"limits", "asked"}: what the service tells of the account's own limits without being asked
                            anything, as "limits" of send (Copilot: {"chat", "completions"}; {} when it tells nothing), and
                            how many questions went to it through Lens this month — LatteOS's own count, not the account's
  latte-ai chats            the conversations, the newest first: [{"id", "title", "provider", "model", "updated", "count",
                            "from", "machine"}]
  latte-ai chat ID          one conversation whole: {"id", "title", "provider", "model", "messages": [{"role", "content",
                            "provider", "model", "at"}], "usage"}
  latte-ai forget ID        throws one away, and what was attached to it
  latte-ai helper           the Helper's conversation, the oldest first: [{"at", "agent", "app", "task", "dir", "state":
                            running|done|error, "steps": [{"kind": text|tool|plan|ask, "text", "answer"}], "n" (items changed),
                            "log"}]; a task through ACP (latte-acp) with its steps, other journal entries without
  latte-ai index            the index of the conversations whole, with each line's meaning (e5-sk-small through the router);
                            a search starts it behind when lines have no meaning yet
  latte-ai import FILE [--dry-run]   an export of ChatGPT, Claude or Gemini (Takeout, JSON) into LensAI, its zip or a
                            file of it, the kind told by what is in it: each conversation one of LensAI's, read only
                            ("imported": the kind), the same export again changes only what changed; Claude's
                            memories as with import-memory. {"kind", "new", "updated", "same", "notes", "note", "error"}
                            (anonymous: called in an anonymous project of agentgram, unknown, gemini-html, unreadable);
                            --dry-run writes nothing and adds "titles" [{"title", "at", "messages", "state"}] and "lines"
  latte-ai import-memory TEXT|FILE|- --from chatgpt|claude|gemini [--dry-run]   what that assistant says it remembers
                            (pasted, a file, stdin) as a note of the chosen memory, imported/KIND-memory.md, a fact a
                            line, only the lines it lacks added: {"notes", "note", "cut" (past 64 KB, left), "error"}
  latte-ai search WORDS [N]   every conversation that says them, or means them (LensAI's, Claude Code's sessions, the Helper's tasks),
                            the best first, without accents, words by their beginning: [{"source", "ref", "title",
                            "folder", "at", "snippet"}]; the index (~/.local/state/latteos/ai/index.db) is read on first
  latte-ai projects         every project, each with its subprojects: [{"path", "name", "type", "state", "storage",
                            "remote", "lock": {"ai": [agent ids; none: all], "memory"}, "subs"}]
  latte-ai project new DIR NAME TYPE [STORAGE]   a folder made a project (.latte/projekt.toml, AGENTS.md, CLAUDE.md →
                            AGENTS.md); TYPE code|drawing|book|3d|music|comic|other, STORAGE offline|github|forgejo
  latte-ai project new --in PARENT NAME TYPE [STORAGE]   the same, its folder named after it in PARENT (slug: no accents)
  latte-ai agentgram        its settings: {"on", "mode": local|remote, "server", "identity": home|other, "web", "api",
                            "paired", "client"}
  latte-ai agentgram set on on|off · mode local|remote · server URL · identity home|other   then starts and stops to match
  latte-ai agentgram folder PATH   a project's folder (only under ~/LensAI/agentgram), opened in Files: {"path"}
  latte-ai agentgram pair [--link CODE]   connects this computer (its runner) to the server: {"url", "code"} to confirm
                            there, then {"ok"}; with agentgram's connect link, the person lets it join on that page
  latte-ai skills find WORDS · skills official · skills add SOURCE SKILL · skills remove NAME   the skills' store:
                            {"skillssh", "clawhub"} for WORDS, Anthropic's own; installed once into ~/.agents/skills for Codex,
                            Claude Code and Gemini CLI (Vercel's `skills`, or ClawHub's for SOURCE @owner/slug; no telemetry), removed
  latte-ai memory           which memory the AIs keep: {"engine": basic|everos|off, "engines": [{"id", "name", "installed",
                            "folder", "license", "cannot" (everos: "avx2" when this processor cannot run it), "running"}]}
  latte-ai memory set basic|everos|off · install everos · up   choose it (EverOS's server runs only while chosen), get
                            EverOS (uv tool), load the local models EverOS asks (its service does it before it starts)
  latte-ai memory-folder [CHANNEL [SUBCHANNEL]]   where the AI keeps what it has: latteAI/lensai, or latteAI/agentes/CHANNEL/SUB
  latte-ai project set DIR state|type|storage|name|remote|memory VALUE · set DIR ai ID…   a project's setting; ai: the
                            only agents allowed in it (none: all)
  latte-ai project forget DIR   off the list (the folder stays) · latte-ai project DIR: the project a folder is in
  latte-ai say TEXT | stop  reads it aloud in Lili's voice (sherpa-onnx, Piper; Markdown marks and code left out), or stops
  latte-ai helper say LOG TEXT | end LOG   the person goes on with a task that waits (state "waiting"), or ends it
  latte-ai journal [N]      what the AI changed, the newest first (N entries, 200): [{"at", "app", "ai", "task", "did",
                            "where", "items": [[before, after] | [what]], "more"}]; an entry shows its first 20 items
  latte-ai journal add JSON   one entry, written by the app in which the AI did it
  latte-ai journal full [AT]   every entry whole (or the one written at AT), for the window of the changes
  latte-ai journal export FILE|auto [DAYS|AT]   as Markdown, every item: all, the last days, or one entry; auto: into
                            Documents as LensAI-DATE.md; says {"path"}
  latte-ai journal clear    forgets it, on the person's word (what Ctrl+Z can take back stays)

The conversations are kept in ~/.local/state/latteos/ai/chats/ID.json, one file each. What the user wants every AI
to know or keep to (LensAI › Instructions) is ~/.config/latteos/ai-instructions.txt; it goes with every question.
The AI on this computer is llama.cpp's llama-server in its router mode with the model files (.gguf) found under
~/.local/share/latteos/ai or /data/ai (llama/*/llama-server, models/*.gguf), each model a process of its own, loaded and
let go without a restart. It starts the first time it is asked and stays, on 127.0.0.1 only; `latte-ai stop` ends it.
"""
import datetime
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import uuid


def N(s):
    """A text the apps show translated (goo/lang): marked, so that tests/check.sh asks for its translation."""
    return s


def T(text):
    """The user's language, for what latte-ai itself shows (a notice): the table of goo/lang/<language>.plm, as GuardCorgi."""
    lang = re.split(r"[_.@]", os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[0]
    try:
        with open(os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "goo", "lang", lang + ".plm"), encoding="utf-8") as f:
            table = f.read()
    except OSError:
        return text
    m = re.search(r'^\s*"%s"\s*=\s*"((?:[^"\\]|\\.)*)"\s*$' % re.escape(text), table, re.M)
    return m.group(1) if m else text

SYSTEM = ("You are the assistant in the launcher of the LatteOS desktop. Answer briefly and to the point, in the "
          "language of the question, in plain text: no Markdown, no headings.")
SYSTEM_MD = ("You are the assistant of the LatteOS desktop. Answer to the point, in the language of the question. "
             "Markdown is shown: use it where it helps (lists, code blocks, bold), not for headings on short answers.")
STREAM = False                  # --stream: the pieces of an answer are printed as they come
PIECES = []                     # what has come of the answer so far, kept for a stop
CHILD = None                    # the tool asked now, ended with us


class Stopped(BaseException):          # not an error of the service: no except of theirs may swallow it
    pass


def piece(text):
    """A piece of the answer: kept, and told at once when someone is watching."""
    if text:
        PIECES.append(text)
        if STREAM:
            say(delta=text)


def say(**what):
    print(json.dumps(what, ensure_ascii=False), flush=True)
# Where a tool is run: an empty folder of its own, so that it finds no project there to read.
# The desktop's services have a short PATH (no ~/.local/bin, where a user's own tools live): look there too.
SEARCH = os.pathsep.join([os.environ.get("PATH", "/usr/local/bin:/usr/bin"), os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"),
                          os.path.expanduser("~/.grok/bin"), os.path.expanduser("~/.local/share/mise/shims")])
ROOM = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "ai")
CHATS = os.path.join(ROOM, "chats")
KEEP = 12                       # what a tool is reminded of: the last six turns
MACHINE = ("chapolera", "ask")        # programs that ask for their own work: their conversations are not the user's to read


def claude(prompt, model, effort="", files=()):
    # No tools that act on the computer: reading, where something is attached (the files lie in the folder it runs in,
    # and it reads only there), and the web when the person allows it. The conversation is not kept among the user's own, and what
    # the user set up for their own work with the tool (hooks, instructions) stays out of the answers.
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["claude", "-p", prompt, "--system-prompt", SYSTEM, "--output-format", "stream-json", "--verbose"] + (["--include-partial-messages"] if STREAM else []) + ["--no-session-persistence",
            "--setting-sources", "project", "--restricted", "--strict-mcp-config"] + (["--model", model] if model else []) + (["--effort", effort] if effort else []) \
        + (["--allowedTools", "Read(./**)", "--tools", "Read"] if files else ["--tools", ""] if os.environ.get("LATTE_NO_TOOLS") else
           # the web only on request: Claude Code asks bin/latte-mcp's gate, the person answers in LensAI (the user, 18. 11.)
           ["--mcp-config", json.dumps({"mcpServers": {"gate": {"command": "latte-mcp", "args": ["gate"]}}}),
            "--permission-prompt-tool", "mcp__gate__approve", "--tools", "WebSearch,WebFetch"])


def claude_read(out):
    """The answer, what it cost and how much of the account's limits is used, from the lines claude prints.
    The limits come as a rate_limit_event: the share of the five hours and of the week, and when each starts again."""
    d, limits = {}, {}
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "result":
            d = e
        elif e.get("type") == "rate_limit_event":
            for k, w in ((e.get("rate_limit_info") or {}).get("unifiedWindows") or {}).items():
                limits[k] = {"used": w.get("utilization", 0), "resets": w.get("resetsAt", 0)}
    if not d:
        raise ValueError("no result")
    used = next(iter((d.get("modelUsage") or {}).values()), {})
    u = d.get("usage") or {}
    context = sum(u.get(k, 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
    return d.get("result", ""), not d.get("is_error"), {"context": context, "window": used.get("contextWindow", 200000),
                                                        "tokens": used.get("inputTokens", 0) + used.get("outputTokens", 0), "cost": d.get("total_cost_usd", 0),
                                                        "limits": limits}


# Gemini, Codex, Grok and Mistral answered on latte-lab (21. 10.), signed in with the user's accounts; Grok and Mistral
# were also asked to write a file and did not. Ollama is written from its documentation. Their answers come as plain
# text, without usage.
def gemini(prompt, model, effort="", files=()):
    # plan: it may read, never change anything; @ puts an attached file into the question
    # the folder it runs in is LatteOS's own empty one: trusted without asking, so that plan is not overridden
    return ["gemini", "-p", SYSTEM + "\n\n" + prompt + "".join(" @" + f for f in files), "--skip-trust", "--approval-mode", "plan", "-o", "text"] \
        + (["-m", model] if model else [])


def grok(prompt, model, effort="", files=()):
    # plan: a headless run cannot be asked to allow anything, so it reads and never writes or runs
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["grok", "-p", SYSTEM + "\n\n" + prompt, "--permission-mode", "plan", "--output-format", "plain"] + (["-m", model] if model else [])


def vibe(prompt, model, effort="", files=()):
    # ask: a tool would need a yes nobody can give; one turn: it answers and stops
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["vibe", "-p", SYSTEM + "\n\n" + prompt, "--agent", "ask", "--max-turns", "1", "--output", "text"]


LOCAL_PORT = 8790
LOCAL_CONTEXT = 8192
LOCAL_DIRS = [os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteos", "ai"), "/data/ai"]


# ── the AI on this computer: what the hardware can carry, LatteOS's recommended models, and any other found on Hugging
# Face as LM Studio finds them (GGUF files, how each would fit), downloaded into LOCAL_DIRS ──────────────────────────
RECOMMENDED = os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "ai", "local-models.json")
HF = "https://huggingface.co"
LOCAL_SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "local-ai.json")


def hardware():
    """The processor (and whether it has AVX2: without it, only small models answer at a reading pace), the memory, the
    graphics cards with their own memory, and the room where models go."""
    cpu, flags = "", ""
    for line in open("/proc/cpuinfo", errors="replace"):
        if line.startswith("model name") and not cpu:
            cpu = line.split(":", 1)[1].strip()
        elif line.startswith("flags") and not flags:
            flags = line
    ram = 0
    for line in open("/proc/meminfo"):
        if line.startswith("MemTotal:"):
            ram = int(line.split()[1]) * 1024
    gpus = []
    for dev in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        vendor = open(os.path.join(dev, "vendor")).read().strip() if os.path.exists(os.path.join(dev, "vendor")) else ""
        vram = 0
        try:
            vram = int(open(os.path.join(dev, "mem_info_vram_total")).read())          # AMD
        except (OSError, ValueError):
            pass
        name = {"0x1002": "AMD", "0x10de": "NVIDIA", "0x8086": "Intel"}.get(vendor, vendor)
        try:
            slot = os.path.basename(os.path.realpath(dev))
            name = subprocess.run(["lspci", "-s", slot], capture_output=True, text=True, timeout=5).stdout.split(": ", 1)[-1].strip() or name
        except (OSError, subprocess.TimeoutExpired):
            pass
        if vendor == "0x10de" and shutil.which("nvidia-smi"):
            try:
                vram = int(subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                                          capture_output=True, text=True, timeout=10).stdout.split()[0]) * 1048576
            except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
                pass
        gpus.append({"name": name, "vendor": {"0x1002": "amd", "0x10de": "nvidia", "0x8086": "intel"}.get(vendor, ""), "vram": vram})
    where = models_dir()
    free = shutil.disk_usage(where if os.path.exists(where) else os.path.expanduser("~")).free
    return {"cpu": cpu, "cores": os.cpu_count() or 1, "avx2": " avx2" in flags, "ram": ram, "gpus": gpus, "dir": where, "free": free}


def models_dir():
    """Where a downloaded model goes: the first of LOCAL_DIRS that already has models, else the user's own."""
    for d in LOCAL_DIRS:
        if os.path.isdir(os.path.join(d, "models")) and os.access(os.path.join(d, "models"), os.W_OK):
            return os.path.join(d, "models")
    return os.path.join(LOCAL_DIRS[0], "models")


def fit(size, hw):
    """How a file of this size would run here, in LM Studio's words: on the graphics card whole, partly, on the processor
    alone, or too large. Memory is left for the system and the rest of the desktop."""
    vram = max([g["vram"] for g in hw["gpus"]] or [0])
    need = size * 1.15                                  # the file and the context beside it
    if vram and need <= vram * 0.9:
        return "gpu"
    ram = hw["ram"] * 0.6
    if vram and need <= vram * 0.9 + ram:
        return "partial"
    return "cpu" if need <= ram else "too-big"


def recommend():
    """LatteOS's list with how each would fit, and the one offered: the best that fits; without AVX2 a dense model over
    5 GB that leans on the processor answers too slowly to count (latte-lab, inspo/ai-na-ploche.md)."""
    try:
        with open(RECOMMENDED) as f:
            listed = json.load(f)
    except (OSError, ValueError):
        listed = {"models": [], "updated": ""}
    hw = hardware()
    have = {os.path.basename(m["id"]) for m in local_models_all()}
    best = ""
    for m in listed["models"]:
        m["fit"] = fit(m["size"], hw)
        m["have"] = m["file"] in have
        slow = m["fit"] in ("cpu", "partial") and not hw["avx2"] and not m.get("moe") and m["size"] > 5e9
        if not best and m["fit"] != "too-big" and not slow:
            best = m["id"]
    small = listed["models"][-1]["id"] if listed["models"] else ""
    listed["models"].sort(key=lambda m: (m["fit"] == "too-big", m["id"] != best))   # the one offered, then what fits, in LatteOS's order
    return {"hardware": hw, "updated": listed.get("updated", ""), "models": listed["models"], "best": best, "fast": small,
            "gpu": local_settings().get("gpu", False), "runtime": local_server() or ""}


def local_settings():
    try:
        with open(LOCAL_SETTINGS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def hf(path):
    import urllib.request
    return json.load(urllib.request.urlopen(urllib.request.Request(HF + path, headers={"Accept": "application/json"}), timeout=20))


SORTS = {"best": "trendingScore", "downloads": "downloads", "updated": "lastModified", "likes": "likes"}


def hf_search(text, sort="best"):
    """Models on Hugging Face with GGUF files, as LM Studio's search lists them: sorted by best match (trending),
    downloads, the latest or likes; each with what can be told without opening it (size class, base, licence, vision)."""
    import re
    import urllib.parse
    found = hf("/api/models?" + urllib.parse.urlencode({"search": text, "filter": "gguf", "sort": SORTS.get(sort, "trendingScore"),
                                                          "direction": "-1", "limit": "40", "full": "true"}))
    out = []
    for m in found:
        tags = m.get("tags") or []
        name = m["id"].split("/", 1)[1]
        params = re.search(r"(\d+(?:\.\d+)?)[Bb](?![a-z])", name)
        out.append({"repo": m["id"], "author": m["id"].split("/")[0], "name": re.sub(r"[-_]GGUF$", "", name, flags=re.I),
                    "downloads": m.get("downloads", 0), "likes": m.get("likes", 0),
                    "updated": (m.get("lastModified") or m.get("createdAt") or "")[:10], "params": (params.group(1) + "B") if params else "",
                    "base": next((t.split(":", 1)[1] for t in tags if t.startswith("base_model:") and t.count(":") == 1), ""),
                    "license": next((t.split(":", 1)[1] for t in tags if t.startswith("license:")), ""),
                    "vision": m.get("pipeline_tag") == "image-text-to-text"})
    return out


def hf_readme(repo):
    """A model's card, its README, without the front matter: what its page says of it."""
    import urllib.request
    try:
        text = urllib.request.urlopen("%s/%s/raw/main/README.md" % (HF, repo), timeout=20).read().decode(errors="replace")
    except OSError:
        return ""
    if text.startswith("---"):
        end = text.find("\n---", 3)
        text = text[end + 4:] if end > 0 else text
    return text.strip()[:100000]


def hf_files(repo):
    """The GGUF files of a model on Hugging Face: each quantization with its size and how it would fit here, in LM Studio's
    four estimations (lmstudio-js ModelSearch.ts, MIT: fullGPUOffload · partialGPUOffload · fitWithoutGPU · willNotFit,
    here gpu · partial · cpu · too-big), and the one recommended."""
    import re
    hw = hardware()
    have = {os.path.basename(m["id"]) for m in local_models_all()}
    out, parts = [], {}
    for f in hf("/api/models/%s/tree/main?recursive=true" % repo):
        p = f.get("path", "")
        base = os.path.basename(p).lower()
        # not the model itself: its picture reader, and the small drafts that only speed a big one up (EAGLE, MTP heads, speculators)
        if not p.endswith(".gguf") or "mmproj" in base or base.startswith(("eagle", "mtp")) or "draft" in base or "speculator" in base:
            continue
        size = (f.get("lfs") or {}).get("size") or f.get("size") or 0
        split = re.search(r"-(\d{5})-of-(\d{5})\.gguf$", p)
        if split:                                   # a model in parts is one option: the first part, all of them counted
            key = p[:split.start()]
            parts.setdefault(key, []).append((p, size))
            continue
        q = re.search(r"(I?Q\d[\w]*|F16|BF16|F32|MXFP4\w*)", os.path.basename(p), re.I)
        out.append({"file": p, "quant": q.group(1).upper() if q else "", "size": size, "fit": fit(size, hw), "have": os.path.basename(p) in have})
    for key, files in parts.items():
        files.sort()
        size = sum(n for _, n in files)
        q = re.search(r"(I?Q\d[\w]*|F16|BF16|F32|MXFP4\w*)", os.path.basename(key), re.I)
        out.append({"file": files[0][0], "quant": q.group(1).upper() if q else "", "size": size, "fit": fit(size, hw),
                    "have": os.path.basename(files[0][0]) in have, "parts": len(files)})
    out.sort(key=lambda x: x["size"])
    # the variant chosen when nothing is chosen, as LM Studio's `recommended`: Q4_K_M where it fits, else the largest that fits;
    # never one of one or two bits (IQ1, IQ2, Q2: they answer much worse) — then none, and the person chooses (audit 21. 11.)
    fits = [f for f in out if f["fit"] != "too-big" and not re.match(r"I?Q[12]_", f["quant"])]
    pick = next((f for f in fits if f["quant"] == "Q4_K_M"), fits[-1] if fits else None)
    for f in out:
        f["recommended"] = f is pick
    return out


def hf_get(repo, file):
    """Downloads a model file into models_dir(), resuming a broken one; a line {"got", "total"} as it comes. A model in
    parts (-00001-of-0000N) comes whole: llama.cpp is given the first and finds the others beside it."""
    import re
    if ".." in repo or ".." in file or not file.endswith(".gguf"):
        print(json.dumps({"error": "not a model file"}))
        return 1
    split = re.search(r"-00001-of-(\d{5})\.gguf$", file)
    if split:
        for n in range(int(split.group(1)), 0, -1):         # the first last: it is what says the model is here
            code = hf_get_one(repo, file[:split.start()] + "-%05d-of-%s.gguf" % (n, split.group(1)), file)
            if code:
                return code
        return 0
    return hf_get_one(repo, file)


def hf_get_one(repo, file, first=""):
    import urllib.request
    where = models_dir()
    os.makedirs(where, exist_ok=True)
    import time
    dest = os.path.join(where, os.path.basename(file))
    if os.path.exists(dest):                # a part of a model in parts that came whole before a pause
        return 0
    part = dest + ".part"
    got = os.path.getsize(part) if os.path.exists(part) else 0
    req = urllib.request.Request("%s/%s/resolve/main/%s" % (HF, repo, file), headers={"Range": "bytes=%d-" % got} if got else {})
    with urllib.request.urlopen(req, timeout=30) as r, open(part, "ab" if got else "wb") as out:
        total = got + int(r.headers.get("Content-Length") or 0)
        # what it is and where from, beside it: a paused download is gone on with from this (latte-ai local downloads)
        with open(part + ".json", "w") as f:
            json.dump({"repo": repo, "file": first or file, "total": total}, f)
        told = 0
        while True:
            chunk = r.read(1 << 18)
            if not chunk:
                break
            out.write(chunk)
            got += len(chunk)
            if time.monotonic() - told >= 0.5 or got == total:
                told = time.monotonic()
                print(json.dumps({"got": got, "total": total}), flush=True)
    # the file against the fingerprint Hugging Face keeps of it (lfs.oid, a sha256): a broken or swapped one is not kept
    try:
        folder = os.path.dirname(file)
        want = next(((f.get("lfs") or {}).get("oid") for f in hf("/api/models/%s/tree/main%s" % (repo, "/" + folder if folder else ""))
                     if f.get("path") == file), None)
    except (OSError, ValueError):
        want = None
    if want and sha256_of(part) != want:
        os.remove(part)
        os.remove(part + ".json")
        print(json.dumps({"error": "fingerprint"}), flush=True)
        return 1
    os.replace(part, dest)
    os.remove(part + ".json")
    print(json.dumps({"done": dest}), flush=True)
    return 0


def sha256_of(path):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def downloads():
    """The downloads begun and not finished (paused, or broken off): [{"name", "repo", "file", "got", "total"}]."""
    out = []
    for d in LOCAL_DIRS:
        for part in sorted(glob.glob(os.path.join(d, "models", "*.gguf.part"))):
            try:
                with open(part + ".json") as f:
                    note = json.load(f)
                out.append({"name": os.path.basename(part)[:-5], "repo": note["repo"], "file": note["file"], "got": os.path.getsize(part), "total": note["total"]})
            except (OSError, ValueError, KeyError):
                pass                        # a part without its note cannot be gone on with
    return out


def gguf(path):
    """What a model file says of itself in its head (GGUF's metadata, github.com/ggml-org/ggml docs/gguf.md): its layers,
    the context it was trained for, the sizes its memory is counted from, and what its chat template can do. Read once
    for a file and kept."""
    import hashlib, struct
    st = os.stat(path)
    cache = os.path.join(ROOM, "gguf-%s.json" % hashlib.sha1(("%s %d %d" % (path, st.st_size, st.st_mtime)).encode()).hexdigest()[:16])
    try:
        with open(cache) as f:
            return json.load(f)
    except (OSError, ValueError):
        pass
    sizes = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
    forms = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?", 10: "<Q", 11: "<q", 12: "<d"}
    kv = {}
    try:
        with open(path, "rb") as f:
            if f.read(4) != b"GGUF":
                return {}
            _, _, count = struct.unpack("<IQQ", f.read(20))
            word = lambda: f.read(struct.unpack("<Q", f.read(8))[0])
            for _ in range(count):
                key, kind = word().decode(errors="replace"), struct.unpack("<I", f.read(4))[0]
                if kind == 8:
                    kv[key] = word().decode(errors="replace")
                elif kind == 9:                 # a list (the vocabulary…): only how long it is
                    of, n = struct.unpack("<IQ", f.read(12))
                    kv[key] = n
                    if of == 8:
                        for _ in range(n):
                            f.seek(struct.unpack("<Q", f.read(8))[0], 1)
                    elif of in sizes:
                        f.seek(n * sizes[of], 1)
                    else:
                        break                   # a list of lists: nothing LatteOS needs comes after what it has by then
                elif kind in sizes:
                    kv[key] = struct.unpack(forms[kind], f.read(sizes[kind]))[0]
                else:
                    break
    except (OSError, struct.error):
        return {}
    arch = kv.get("general.architecture", "")
    num = lambda k, d=0: kv.get("%s.%s" % (arch, k)) if isinstance(kv.get("%s.%s" % (arch, k)), int) else d
    heads = num("attention.head_count", 1) or 1
    embd = num("embedding_length")
    template = kv.get("tokenizer.chat_template", "") if isinstance(kv.get("tokenizer.chat_template"), str) else ""
    out = {"arch": arch, "layers": num("block_count"), "context": num("context_length"), "embedding": embd, "heads": heads,
           "heads_kv": num("attention.head_count_kv", heads) or heads,
           "key": num("attention.key_length", embd // heads), "value": num("attention.value_length", embd // heads),
           "vocab": kv.get("tokenizer.ggml.tokens", 0) if isinstance(kv.get("tokenizer.ggml.tokens"), int) else 0,
           "tools": "tools" in template, "reasoning": any(w in template for w in ("enable_thinking", "<think>", "reasoning_content"))}
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(out, f)
    return out


LOCAL_KEYS = {"ctx": (256, 1 << 21), "ngl": (0, 999), "threads": (1, 512), "batch": (16, 8192), "ubatch": (16, 8192), "parallel": (1, 16),
              "mlock": (0, 1), "mmap": (0, 1)}


def model_settings(model):
    """How this model is loaded: the user's own word on it (LensAI › Local LLMs › My Models), the rest as LatteOS loads any."""
    s = local_settings()
    mine = (s.get("models") or {}).get(os.path.basename(model), {})
    return dict({"ctx": LOCAL_CONTEXT, "ngl": 999 if s.get("gpu") else 0, "threads": max(2, (os.cpu_count() or 4) // 2),
                 "batch": 2048, "ubatch": 512, "parallel": 1, "mlock": 0, "mmap": 1}, **{k: v for k, v in mine.items() if k in LOCAL_KEYS})


def estimate(model, sets, hw, quick=False):
    """The memory a model takes loaded this way, on the graphics card and in all, and how that sits on this computer.
    llama.cpp says it itself without loading the model (its llama-fit-params, a second): kept for the next time.
    `quick` never runs it: what was kept, else the textbook count from the file's head (Ollama's llm/memory.go and
    fs/ggml GraphSize, MIT: weights, two bytes x context x layers x (key + value) x heads, and the computing's room),
    which is too much for the architectures that keep tokens in only some of their layers."""
    import re
    g = gguf(model)
    st = os.stat(model)
    eyes = os.path.getsize(local_mmproj(model)) if local_mmproj(model) else 0
    layers = g.get("layers") or 1
    share = min(1.0, sets["ngl"] / (layers + 1))           # the layers and what comes out of the last
    vram, free, tool = max([c["vram"] for c in hw["gpus"]] or [0]), 0, os.path.join(os.path.dirname(local_server() or ""), "llama-fit-params")
    key = "%s %d %d c%d g%d b%d u%d p%d" % (model, st.st_size, st.st_mtime, sets["ctx"], sets["ngl"], sets["batch"], sets["ubatch"], sets["parallel"])
    kept = {}
    try:
        with open(MEASURED) as f:
            kept = json.load(f)
    except (OSError, ValueError):
        pass
    if key not in kept and not quick and os.path.exists(tool):
        try:
            said = subprocess.run([tool, "-m", model, "-c", str(sets["ctx"]), "-ngl", str(sets["ngl"]), "-b", str(sets["batch"]), "-ub", str(sets["ubatch"]),
                                   "-np", str(sets["parallel"]), "-v"], capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
            rows = re.findall(r"breakdown_print: \|   - (.*?)\|(.*)\|", said.stdout + said.stderr)
            # a card: total = free + (self = …) + the rest;  the host: self = …
            cards = [re.match(r" *(\d+) = +(\d+) \+ \( *(\d+) =", r) for n, r in rows if not n.startswith("Host")]
            host = [re.match(r" *(\d+) =", r) for n, r in rows if n.startswith("Host")]
            if host and host[0] and all(cards):
                kept[key] = {"gpu": sum(int(c.group(3)) for c in cards) << 20, "host": int(host[0].group(1)) << 20,
                             "vram": max([int(c.group(1)) for c in cards] or [0]) << 20, "free": max([int(c.group(2)) for c in cards] or [0]) << 20}
                os.makedirs(ROOM, exist_ok=True)
                with open(MEASURED, "w") as f:
                    json.dump(kept, f)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if key in kept:
        gpu, total = kept[key]["gpu"] + (eyes if share else 0), kept[key]["gpu"] + kept[key]["host"] + eyes
        vram, free = kept[key]["vram"] or vram, kept[key]["free"]
    else:
        ctx = min(sets["ctx"], g.get("context") or sets["ctx"])
        kv = 2 * ctx * layers * (g.get("key", 0) + g.get("value", 0)) * min(g.get("heads_kv", 1), g.get("heads", 1))
        graph = max(4 * sets["ubatch"] * (1 + 4 * g.get("embedding", 0) + ctx * (1 + g.get("heads", 1))), 4 * sets["ubatch"] * (g.get("embedding", 0) + g.get("vocab", 0)))
        total = st.st_size + eyes + kv + graph
        gpu = int((st.st_size + eyes + kv) * share + (graph if share else 0))
    if (share and gpu > vram * 0.95) or total - gpu > hw["ram"] * 0.6:
        how = "too-big"
    else:
        how = "gpu" if share >= 1 else "partial" if share else "cpu"
    return {"gpu": int(gpu), "total": int(total), "vram": vram, "free": free, "ram": hw["ram"], "fit": how, "layers": layers + 1,
            "context": g.get("context") or 0, "measured": key in kept}


MEASURED = os.path.join(ROOM, "local-memory.json")


def runtime_get():
    """llama.cpp built for Vulkan (any graphics card, and the processor), into LOCAL_DIRS[0]/llama: the build its
    latest release names (nightly-tag.txt, since v0.9.0 the release itself carries no programs), checked against the
    fingerprint GitHub keeps of it."""
    import urllib.request, zipfile, tarfile
    api = "https://api.github.com/repos/ggml-org/llama.cpp/releases/"
    rel = json.load(urllib.request.urlopen(api + "latest", timeout=20))
    named = next((a for a in rel["assets"] if a["name"] == "nightly-tag.txt"), None)
    if named:
        tag = urllib.request.urlopen(named["browser_download_url"], timeout=20).read().decode().strip()
        if not re.fullmatch(r"[\w.-]+", tag):
            print(json.dumps({"error": "no build named in " + rel.get("tag_name", "")}))
            return 1
        rel = json.load(urllib.request.urlopen(api + "tags/" + tag, timeout=20))
    asset = next((a for a in rel["assets"] if a["name"].endswith(("-bin-ubuntu-vulkan-x64.tar.gz", "-bin-ubuntu-vulkan-x64.zip"))), None)
    if not asset:
        print(json.dumps({"error": "no Vulkan build in " + rel.get("tag_name", "")}))
        return 1
    home = os.path.join(LOCAL_DIRS[0], "llama", rel["tag_name"])
    os.makedirs(home, exist_ok=True)
    zpath = home + (".zip" if asset["name"].endswith(".zip") else ".tar.gz")
    with urllib.request.urlopen(asset["browser_download_url"], timeout=30) as r, open(zpath, "wb") as out:
        total, got = asset["size"], 0
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)
            got += len(chunk)
            print(json.dumps({"got": got, "total": total}), flush=True)
    want = (asset.get("digest") or "").partition("sha256:")[2]
    if want and sha256_of(zpath) != want:
        os.remove(zpath)
        os.rmdir(home)
        print(json.dumps({"error": "fingerprint"}), flush=True)
        return 1
    if zpath.endswith(".zip"):
        with zipfile.ZipFile(zpath) as z:
            z.extractall(home)
    else:
        with tarfile.open(zpath) as z:
            z.extractall(home, filter="data")
    os.remove(zpath)
    # the archive keeps its programs in build/bin: llama-server is looked for one folder down
    for f in glob.glob(os.path.join(home, "**", "*"), recursive=True):
        # a link too, though what it points at may have gone up already: the libraries are found by those names
        if (os.path.isfile(f) or os.path.islink(f)) and os.path.dirname(f) != home:
            os.replace(f, os.path.join(home, os.path.basename(f)))
    for d in sorted((d for d in glob.glob(os.path.join(home, "**", ""), recursive=True) if d.rstrip(os.sep) != home), reverse=True):
        os.rmdir(d)
    for f in glob.glob(os.path.join(home, "*")):
        if os.path.isfile(f) and not f.endswith((".so", ".txt", ".md")) and "." not in os.path.basename(f):
            os.chmod(f, 0o755)
    print(json.dumps({"done": os.path.join(home, "llama-server")}), flush=True)
    return 0


def local_server():
    for d in LOCAL_DIRS:
        found = sorted(glob.glob(os.path.join(d, "llama", "*", "llama-server")))
        if found:
            return found[-1]
    return shutil.which("llama-server", path=SEARCH)


def local_mmproj(model):
    """The vision file that belongs to a model (mmproj-<name>….gguf beside it), or None: such a model can look at pictures."""
    import re
    base = re.sub(r"-(q\d.*|f16|bf16|f32)\.gguf$", "", os.path.basename(model), flags=re.I)
    near = sorted(glob.glob(os.path.join(os.path.dirname(model), "mmproj*.gguf")))
    for f in near:
        if base.lower() in os.path.basename(f).lower():
            return f
    # a folder of its own (LM Studio's author/model/) with one reader in it: that one, whatever its name
    return near[0] if len(near) == 1 and os.path.basename(os.path.dirname(model)) != "models" else None


def model_files():
    """Every model file in the models folders, also one put there by hand or by another program (LM Studio keeps them as
    author/model/file.gguf): any depth, but not the picture readers, nor the index's and speech's own models."""
    found = []
    for d in LOCAL_DIRS:
        root = os.path.join(d, "models")
        found += [f for f in glob.glob(os.path.join(root, "**", "*.gguf"), recursive=True)
                  if os.path.relpath(f, root).split(os.sep)[0] not in ("embed", "asr") and "mmproj" not in os.path.basename(f).lower()]
    return found


def local_models_all():
    found = model_files()
    return [{"id": f, "name": os.path.basename(f)[:-5], "size": os.path.getsize(f)} for f in sorted(found, key=os.path.getsize)]


def my_models(quick=True):
    """The models here for LensAI's list: each with what it can do, how it is loaded, and the memory that takes."""
    hw, out = hardware(), []
    for m in local_models_all():
        g, sets = gguf(m["id"]), model_settings(m["id"])
        out.append(dict(m, vision=local_mmproj(m["id"]) is not None, tools=g.get("tools", False), reasoning=g.get("reasoning", False),
                        arch=g.get("arch", ""), settings=sets, own=sorted((local_settings().get("models") or {}).get(os.path.basename(m["id"]), {})),
                        memory=estimate(m["id"], sets, hw, quick)))
    return out


def local_models():
    """The model files there are, the smallest first: a small one answers soonest."""
    found = sorted(model_files(), key=os.path.getsize)
    return [{"id": f, "name": os.path.basename(f)[:-5].replace("-Q4_K_M", "").replace("-q4_k_m", "").replace("-", " "),
             "vision": local_mmproj(f) is not None} for f in found] if local_server() else []


def local_catalog():
    """The models here as other programs offer them (agentgram's model picker): each by the name the router knows it by,
    a label with what LM Studio shows in its list (quantization, size, parameters) and what it can do. Embedding and
    speech models are not here (they live in models/embed, models/asr)."""
    import re
    out = []
    for m in local_models_all():
        g, base = gguf(m["id"]), os.path.basename(m["id"])[:-5]
        quant = re.search(r"(?i)(?:^|[-_.])((?:i?q\d[a-z0-9_]*)|f16|bf16|f32)$", base)
        params = re.search(r"(?i)(?:^|[-_])(\d+(?:\.\d+)?)b(?:[-_]|$)", base)
        name = base[:quant.start()].rstrip("-_.") if quant else base
        bits = [name.replace("-", " ").replace("_", " ")] + ([quant.group(1).upper()] if quant else []) + ["%.1f GB" % (m["size"] / 1e9)]
        out.append({"id": local_name(m["id"]), "label": " · ".join(bits), "size": m["size"],
                    "quant": quant.group(1).upper() if quant else "", "params": (params.group(1) + "B") if params else "",
                    "tools": bool(g.get("tools")), "vision": local_mmproj(m["id"]) is not None, "reasoning": bool(g.get("reasoning"))})
    return out


def local_progress(name):
    """How far the router is with loading a model (llama.cpp's router says only `loading`, not how far): the bytes of its
    files the model's own server has read or mapped in, of all of them; `percent` is an estimate, 100 once loaded."""
    try:
        st = next((x.get("status") or {} for x in local_call("/v1/models", timeout=2).get("data") or [] if x.get("id") == name), None)
    except (OSError, ValueError):
        return {"state": "off", "percent": 0}
    if st is None:
        return {"state": "none", "percent": 0}
    state = st.get("value", "")
    if state == "loaded":
        return {"state": state, "percent": 100}
    if state != "loading":
        return {"state": state, "percent": 0}
    model = next((m["id"] for m in local_models_all() if local_name(m["id"]) == name), None)
    files = [f for f in (model, model and local_mmproj(model)) if f]
    total = sum(os.path.getsize(f) for f in files) or 1
    done = 0
    for pid in os.listdir("/proc"):
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                args = f.read().split(b"\0")
            if b"--alias" not in args or args[args.index(b"--alias") + 1] != name.encode():
                continue
            with open("/proc/%s/status" % pid) as f:
                rss = sum(int(l.split()[1]) * 1024 for l in f if l.startswith(("RssFile:", "RssAnon:")))
            with open("/proc/%s/io" % pid) as f:
                read = next((int(l.split()[1]) for l in f if l.startswith("read_bytes:")), 0)
            done = max(done, rss, read)
        except (OSError, ValueError, IndexError):
            continue
    # ponytail: an estimate — pages the kernel drops while loading make it step back; callers keep the highest
    return {"state": state, "percent": min(99, int(done * 100 / total))}


def local_call(path, body=None, timeout=5):
    import urllib.request
    req = urllib.request.Request("http://127.0.0.1:%d%s" % (LOCAL_PORT, path), json.dumps(body).encode() if body else None,
                                 {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=timeout))


def local_name(model):
    """The name a model goes by in the router's presets: its file's name without .gguf."""
    return os.path.basename(model)[:-5]


ROUTER_PRESET = os.path.join(ROOM, "models.ini")


def local_preset():
    """llama.cpp's router presets (INI): a section for each model here, loaded as LensAI › Local LLMs says. The layers on
    the graphics card are left to llama.cpp's --fit unless the user set them: it counts them from the memory free when the
    model loads, so a game that holds the card leaves the model fewer instead of a crash. True when the file changed."""
    own = local_settings().get("models") or {}
    keys = {"ctx": "ctx-size", "threads": "threads", "batch": "batch-size", "ubatch": "ubatch-size", "parallel": "parallel"}
    # ponytail: idle 5 min, then the model's memory goes back (llama.cpp's sleep); a setting when someone asks for it
    out = ["[*]", "jinja = true", "sleep-idle-seconds = 300", ""]
    if embedder():
        # the meanings of the conversations' words (the index): small, on the processor, never in the chat's way
        out += ["[%s]" % local_name(embedder()), "model = " + embedder(), "embedding = true", "pooling = mean", "ctx-size = 512",
                "batch-size = 512", "ubatch-size = 512", "n-gpu-layers = 0", ""]
    for m in local_models_all():
        s, mine, mm = model_settings(m["id"]), own.get(os.path.basename(m["id"]), {}), local_mmproj(m["id"])
        out += ["[%s]" % local_name(m["id"]), "model = " + m["id"]] + ["%s = %s" % (keys[k], s[k]) for k in keys]
        if not local_settings().get("gpu"):
            out.append("n-gpu-layers = 0")
        elif "ngl" in mine:
            out.append("n-gpu-layers = %d" % s["ngl"])
        out += (["mmproj = " + mm] if mm else []) + (["mlock = true"] if s["mlock"] else []) + ([] if s["mmap"] else ["no-mmap = true"]) + [""]
    text = "\n".join(out)
    try:
        with open(ROUTER_PRESET) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(ROOM, exist_ok=True)
    with open(ROUTER_PRESET, "w") as f:
        f.write(text)
    return True


def local_reload():
    """The models' settings changed: the router goes, loaded anew at the next question; while agentgram's agents use the
    models here it comes back at once, or their next call finds nobody on the port (they do not start it themselves)."""
    subprocess.run(["pkill", "-f", "llama-server.*--port %d" % LOCAL_PORT])
    s = agentgram()
    if s["on"] and s["mode"] == "local":
        local_start(None, load=False)


def local_start(model, load=True):
    """The model loaded in llama.cpp's router (llama-server without -m, on this computer only): one server, each model in a
    process of its own, loaded and let go without a restart; three at most (the one asked, a helper, the small model of
    meanings the index uses), the older let go
    first, and a margin of the graphics card's memory kept free. Started the first time it is asked, and again when the
    models or their settings changed. Without `load` (model None), only the router: a model asked by name loads then."""
    import time
    name, changed = local_name(model) if model else "", local_preset()
    try:
        known = [m["id"] for m in local_call("/models")["data"]]
    except (OSError, ValueError, KeyError):
        known = None
    if known is None or changed or (name and name not in known):
        subprocess.run(["pkill", "-f", "llama-server.*--port %d" % LOCAL_PORT])
        for _ in range(40):                                    # the old one lets go of the port first, or the new one cannot take it
            if subprocess.run(["pgrep", "-f", "llama-server.*--port %d" % LOCAL_PORT], capture_output=True).returncode:
                break
            time.sleep(0.25)
        try:
            proc = subprocess.Popen([local_server(), "--models-preset", ROUTER_PRESET, "--models-max", "3", "--models-memory-margin", "1024",
                                     "--host", "127.0.0.1", "--port", str(LOCAL_PORT)],
                                    stdout=open(os.path.join(ROOM, "llama-server.log"), "w"), stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                    start_new_session=True)
        except OSError:
            return False
        for _ in range(240):                                   # it measures every model first: a second or so each
            try:
                local_call("/health")
                break
            except (OSError, ValueError):
                if proc.poll() is not None:
                    return False
                time.sleep(0.25)
        else:
            return False
    if not load:
        return True
    try:
        local_call("/models/load", {"model": name})
    except (OSError, ValueError):
        pass                                                   # already loaded or loading: the state below says
    for _ in range(480):                                       # a big model from a slow disk takes its time
        try:
            state = next((m["status"] for m in local_call("/models")["data"] if m["id"] == name), {})
        except (OSError, ValueError, KeyError):
            return False
        if state.get("value") == "loaded":
            return True
        if state.get("value") == "unloaded" and state.get("failed"):
            return False                                       # a bad file, no memory: no reason to wait the rest
        time.sleep(0.25)
    return False


def chat_completion(url, head, body, timeout=600):
    """An OpenAI-style answer (llama-server, the services' APIs, the user's servers): the text and the tokens used.
    Asked for in pieces when someone is watching, and each piece is told as it comes."""
    import urllib.request
    if STREAM:
        body = dict(body, stream=True, stream_options={"include_usage": True})
    req = urllib.request.Request(url.rstrip("/") + "/chat/completions", json.dumps(body).encode(), dict(head, **{"Content-Type": "application/json"}))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        if not STREAM:
            d = json.load(r)
            u = d.get("usage") or {}
            m = d["choices"][0]["message"]
            return (m.get("content") or "").strip(), u.get("prompt_tokens", 0) + u.get("completion_tokens", 0), m.get("tool_calls") or []
        text, used, calls = [], 0, {}
        for raw in r:
            line = raw.decode(errors="replace").strip()
            if not line.startswith("data:") or line == "data: [DONE]":
                continue
            d = json.loads(line[5:])
            for c in d.get("choices") or []:
                bit = (c.get("delta") or {}).get("content") or ""
                text.append(bit)
                piece(bit)
                for t in (c.get("delta") or {}).get("tool_calls") or []:       # a tool asked for comes in pieces too, by its index
                    call = calls.setdefault(t.get("index", 0), {"id": "", "type": "function", "function": {"name": "", "arguments": ""}})
                    call["id"] = t.get("id") or call["id"]
                    for k in ("name", "arguments"):
                        call["function"][k] += (t.get("function") or {}).get(k) or ""
            u = d.get("usage") or {}
            used = u.get("prompt_tokens", 0) + u.get("completion_tokens", 0) or used
        return "".join(text).strip(), used, [calls[i] for i in sorted(calls)]


# ── tools for an AI that has none of its own (a key's API, the model on this computer): LatteOS's own, the ones every
# agent gets from bin/latte-mcp, asked for over MCP as an agent's tool would (ROADMAP 10B.43, step 3). A service's
# official tool (Claude Code, Codex…) is given latte-mcp in its own settings and needs none of this.
USED = []                       # the tools this answer used: [{"tool", "args"}], kept with the answer
TOOLS_WORD = ("\n\nYou have tools of this computer. What they can tell (what a setting is now, who can answer, what is "
              "open), find out with them instead of guessing or promising to; then answer with what they said.")
ROUNDS = 6                      # how many times one answer may go for tools


def tools_open(who, lazy=False):
    """(the tools, call(name, args) → text, close) or None: without python3-mcp or latte-mcp, and for an AI that
    another AI asked (LATTE_NO_TOOLS: it answers, it does not ask on)."""
    if os.environ.get("LATTE_NO_TOOLS") or turned_off() or not shutil.which("latte-mcp", path=SEARCH):
        return None
    try:
        import asyncio, threading
        from mcp import ClientSession, StdioServerParameters, types
        from mcp.client.stdio import stdio_client
    except ImportError:
        return None
    loop, ready, box = asyncio.new_event_loop(), threading.Event(), {}

    async def life():               # the session lives in a thread of its own until the answer is done
        try:
            server = StdioServerParameters(command=shutil.which("latte-mcp", path=SEARCH), args=["--lazy"] if lazy else [], env=dict(os.environ, PATH=SEARCH))
            async with stdio_client(server, errlog=open(os.devnull, "w")) as (r, w):
                async with ClientSession(r, w, client_info=types.Implementation(name=who, version="1")) as s:
                    await s.initialize()
                    box["tools"], box["session"], box["done"] = (await s.list_tools()).tools, s, asyncio.Event()
                    ready.set()
                    await box["done"].wait()
        except Exception:
            pass
        finally:
            ready.set()
    threading.Thread(target=lambda: loop.run_until_complete(life()), daemon=True).start()
    ready.wait(20)
    if "session" not in box:
        return None

    def call(name, args, most=12000):
        USED.append({"tool": name, "args": args})
        try:
            r = asyncio.run_coroutine_threadsafe(box["session"].call_tool(name, args), loop).result(320)
            return "\n".join(c.text for c in r.content if getattr(c, "text", None))[:most] or "(nothing)"
        except Exception as e:      # told to the model, which says it on: a tool that failed is no reason to lose the answer
            return "error: %s" % (e or type(e).__name__)
    return box["tools"], call, lambda: loop.call_soon_threadsafe(box["done"].set)


def converse(url, head, body, who, timeout=600, most=12000, window=0):
    """chat_completion, and whenever the model asks for tools, the tools and the question again: (text, tokens).
    `window`: a model's context; when every tool's form would take more than an eighth of it, the tools come behind
    three (latte-mcp --lazy, ~260 tokens). Measured 18. 11.: Qwen3.5 4B finds and calls a tool that way, the 2B does
    not — so the whole set while it fits (9 tools, ~920 tokens)."""
    import urllib.error
    opened = tools_open(who)
    if not opened:
        return chat_completion(url, head, body, timeout)[:2]
    tools, call, close = opened
    offer = [{"type": "function", "function": {"name": t.name, "description": t.description or "", "parameters": t.inputSchema}} for t in tools]
    if window and len(json.dumps(offer)) / 4 > window / 8:
        close()
        opened = tools_open(who, lazy=True)
        if not opened:
            return chat_completion(url, head, body, timeout)[:2]
        tools, call, close = opened
        offer = [{"type": "function", "function": {"name": t.name, "description": t.description or "", "parameters": t.inputSchema}} for t in tools]
    talk, total, text = list(body["messages"]), 0, ""
    if talk and talk[0]["role"] == "system":       # a small model answers around a tool unless it is told it has them
        talk[0] = dict(talk[0], content=talk[0]["content"] + TOOLS_WORD)
    try:
        for n in range(ROUNDS):
            try:
                text, used, calls = chat_completion(url, head, dict(body, messages=talk, tools=offer), timeout)
            except urllib.error.HTTPError as e:
                if n or e.code not in (400, 404, 422):
                    raise
                return chat_completion(url, head, body, timeout)[:2]        # a model or service that takes no tools answers without
            total += used
            if not calls:
                break
            talk.append({"role": "assistant", "content": text or None, "tool_calls": calls})
            for c in calls:
                try:
                    args = json.loads(c["function"]["arguments"] or "{}")
                except ValueError:
                    args = {}
                talk.append({"role": "tool", "tool_call_id": c["id"], "content": call(c["function"]["name"], args if isinstance(args, dict) else {}, most)})
        return text, total
    finally:
        close()


PICTURES = (".jpg", ".jpeg", ".png", ".webp", ".gif")


def attached(room, f):
    """What an attached file adds to the question of a model that is given text: a PDF's words (pdftotext), the
    beginning of a text file, and of anything else only that it is there — never its bytes as letters."""
    path = os.path.join(room, f)
    try:
        if f.lower().endswith(".pdf"):
            said = subprocess.run(["pdftotext", "-layout", path, "-"], capture_output=True, timeout=60).stdout.decode(errors="replace").strip()
            return "\n\n--- %s ---\n%s" % (f, said[:20000]) if said else "\n\n(%s is a PDF with no text in it that could be read.)" % f
        with open(path, "rb") as fh:
            raw = fh.read(80000)
    except (OSError, subprocess.TimeoutExpired):
        return "\n\n(%s could not be read.)" % f
    if b"\0" in raw:
        return "\n\n(%s is not a text file; it could not be read.)" % f
    return "\n\n--- %s ---\n%s" % (f, raw.decode(errors="replace")[:20000])


def picture(room, f):
    """An attached picture as (kind, base64), or None when the file is not a picture."""
    if not f.lower().endswith(PICTURES):
        return None
    import base64
    try:
        with open(os.path.join(room, f), "rb") as fh:
            return "image/" + ("jpeg" if f.lower().endswith((".jpg", ".jpeg")) else f.rsplit(".", 1)[-1].lower()), base64.b64encode(fh.read()).decode()
    except OSError:
        return None


def local_ask(messages, model, effort, files, room):
    """The whole conversation, as messages: the server keeps no memory between questions."""
    if not os.path.isfile(model):
        return "latte-ai: the model file is not on this computer: %s" % model, False, {}
    if not local_server():
        return "latte-ai: llama-server is not installed (LensAI › This computer)", False, {}
    if not local_start(model):
        return "latte-ai: the AI on this computer did not start (see llama-server.log)", False, {}
    talk = [{"role": "system", "content": SYSTEM}] + [{"role": m["role"], "content": m["content"]} for m in messages if m.get("content")][-KEEP:]
    if len(talk) > KEEP:
        talk = [talk[0]] + talk[-KEEP:]
    seen = []
    for f in files:
        pic = picture(room, f)
        if pic and local_mmproj(model):
            seen.append({"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % pic}})
        elif pic:
            talk[-1]["content"] += "\n\n(%s is a picture; this model cannot see pictures.)" % f
        else:
            talk[-1]["content"] += attached(room, f)
    if seen:
        talk[-1]["content"] = [{"type": "text", "text": talk[-1]["content"]}] + seen
    body = {"model": local_name(model), "messages": talk, "temperature": 0.5, "max_tokens": 1024, "repeat_penalty": 1.15, "chat_template_kwargs": {"enable_thinking": effort == "think"}}
    # tools only for a model whose template knows them, and their answers kept short: its window is small
    if gguf(model).get("tools"):
        text, used = converse("http://127.0.0.1:%d/v1" % LOCAL_PORT, {}, body, PROVIDERS["local"]["name"], most=3000, window=model_settings(model)["ctx"])
    else:
        text, used = chat_completion("http://127.0.0.1:%d/v1" % LOCAL_PORT, {}, body)[:2]
    return text, True, {"context": used, "window": model_settings(model)["ctx"], "tokens": used, "cost": 0}


# ── a key of one's own (as VS Code's "Manage Models"): the service's API is asked directly, a conversation and nothing
# else, no tools. The key lives in the system's keyring (Secret Service: gnome-keyring), looked up when it is needed.
APIS = {
    "api-anthropic": {"name": "Claude API", "style": "claude", "url": "https://api.anthropic.com/v1", "kind": "anthropic", "page": "https://console.anthropic.com/settings/keys"},
    "api-openai": {"name": "OpenAI API", "style": "chatgpt", "url": "https://api.openai.com/v1", "kind": "openai", "page": "https://platform.openai.com/api-keys"},
    "api-google": {"name": "Gemini API", "style": "gemini", "url": "https://generativelanguage.googleapis.com/v1beta/openai", "kind": "openai", "page": "https://aistudio.google.com/apikey"},
    "api-xai": {"name": "Grok API", "style": "grok", "url": "https://api.x.ai/v1", "kind": "openai", "page": "https://console.x.ai/"},
    "api-mistral": {"name": "Mistral API", "style": "mistral", "url": "https://api.mistral.ai/v1", "kind": "openai", "page": "https://console.mistral.ai/api-keys"},
    "api-deepseek": {"name": "DeepSeek API", "style": "deepseek", "url": "https://api.deepseek.com", "kind": "openai", "page": "https://platform.deepseek.com/api_keys"},
}
SERVERS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai-servers.json")


def servers():
    try:
        with open(SERVERS) as f:
            return {s["id"]: dict(s, style="own", kind="openai", server=True) for s in json.load(f)}
    except (OSError, ValueError, KeyError, TypeError):
        return {}


def apis():
    return dict(APIS, **servers())


def secret(ident, value=None, forget=False):
    """The key of a service in the keyring: read it, keep one, or take it out. None when there is none or no keyring."""
    attrs = ["latteos", "ai", "service", ident]
    try:
        if forget:
            return subprocess.run(["secret-tool", "clear"] + attrs, capture_output=True, timeout=20).returncode == 0
        if value is not None:
            return subprocess.run(["secret-tool", "store", "--label", "LatteOS AI: " + apis().get(ident, {}).get("name", ident)] + attrs,
                                  input=value, capture_output=True, text=True, timeout=60).returncode == 0
        if keyring_locked():                # not asked: each look would bring up the system's password window
            return None
        out = subprocess.run(["secret-tool", "lookup"] + attrs, capture_output=True, text=True, timeout=20)
        return out.stdout.strip() or None if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


LOCKED = []                     # whether the keyring was locked when this run first looked


def keyring_locked():
    """Whether the keyring that keys go to is locked: then the system asks for its password, which need not be the
    account's (a keyring made before, or a sign-in that does not open it)."""
    if not LOCKED:
        try:
            out = subprocess.run(["busctl", "--user", "get-property", "org.freedesktop.secrets", "/org/freedesktop/secrets/aliases/default",
                                  "org.freedesktop.Secret.Collection", "Locked"], capture_output=True, text=True, timeout=10)
            LOCKED.append(out.stdout.strip() == "b true")
        except (OSError, subprocess.TimeoutExpired):
            LOCKED.append(False)
    return LOCKED[0]


def api_call(a, path, body=None, timeout=20):
    import urllib.request
    key = secret(a["id"])
    head = {"Content-Type": "application/json"}
    if a["kind"] == "anthropic":
        head.update({"x-api-key": key or "", "anthropic-version": "2023-06-01"})
    elif key:
        head["Authorization"] = "Bearer " + key
    req = urllib.request.Request(a["url"].rstrip("/") + path, json.dumps(body).encode() if body else None, head)
    return json.load(urllib.request.urlopen(req, timeout=timeout))


def api_models(ident):
    """What the service offers, asked once a day: the list is long and the question costs a moment."""
    cache = os.path.join(ROOM, "models-%s.json" % ident)
    try:
        if os.path.getmtime(cache) > datetime.datetime.now().timestamp() - 86400:
            with open(cache) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    a = dict(apis()[ident], id=ident)
    try:
        found = [m["id"] for m in api_call(a, "/models").get("data", [])]
    except (OSError, ValueError, KeyError):
        return []
    found = [m.split("/")[-1] for m in found if not any(w in m for w in ("embed", "tts", "whisper", "dall-e", "moderation", "image", "audio", "realtime"))]
    out = [{"id": m, "name": m} for m in sorted(set(found))][:40]
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(out, f)
    return out


def api_ask(ident):
    def ask(messages, model, effort, files, room):
        a = dict(apis()[ident], id=ident)
        talk = [{"role": m["role"], "content": m["content"]} for m in messages if m.get("content")][-KEEP:]
        seen = [(f, picture(room, f)) for f in files]
        for f, pic in seen:
            if not pic:
                talk[-1]["content"] += attached(room, f)
        seen = [(f, pic) for f, pic in seen if pic]
        words = talk[-1]["content"]
        blind = words + "".join("\n\n(%s is a picture; this model cannot see pictures.)" % f for f, _ in seen)
        import urllib.error

        def once(fn):
            """With the pictures; a service or model that refuses them is asked again without, told that they were there."""
            try:
                return fn()
            except urllib.error.HTTPError as e:
                if not seen or e.code not in (400, 404, 415, 422):
                    raise
                talk[-1]["content"] = blind
                return fn()
        if a["kind"] == "anthropic":
            if seen:
                talk[-1]["content"] = [{"type": "image", "source": {"type": "base64", "media_type": pic[0], "data": pic[1]}} for _, pic in seen] \
                    + [{"type": "text", "text": words}]
            opened = tools_open(a["name"])
            body = {"model": model, "max_tokens": 2048, "system": SYSTEM + (TOOLS_WORD if opened else ""), "messages": talk}
            if opened:              # Anthropic's own shape of the same: tool_use in the answer, tool_result in the next question
                body["tools"] = [{"name": t.name, "description": t.description or "", "input_schema": t.inputSchema} for t in opened[0]]
            used = 0
            try:
                for _ in range(ROUNDS):
                    r = once(lambda: api_call(a, "/messages", body, timeout=300))
                    u = r.get("usage") or {}
                    used += u.get("input_tokens", 0) + u.get("output_tokens", 0)
                    asked = [b for b in r.get("content", []) if b.get("type") == "tool_use"]
                    if not opened or not asked:
                        break
                    body["messages"] = body["messages"] + [{"role": "assistant", "content": r["content"]}, {"role": "user", "content": [
                        {"type": "tool_result", "tool_use_id": b["id"], "content": opened[1](b["name"], b.get("input") or {})} for b in asked]}]
            finally:
                if opened:
                    opened[2]()
            return "".join(b.get("text", "") for b in r.get("content", [])).strip(), True, {"context": used, "window": 200000, "tokens": used, "cost": 0}
        if seen:
            talk[-1]["content"] = [{"type": "text", "text": words}] + [{"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % pic}} for _, pic in seen]
        key = secret(ident)
        text, used = once(lambda: converse(a["url"], {"Authorization": "Bearer " + key} if key else {},
                                           {"model": model, "messages": [{"role": "system", "content": SYSTEM}] + talk}, a["name"], timeout=300))
        return text, True, {"context": used, "window": 0, "tokens": used, "cost": 0}
    return ask


def codex_models():
    """The models ChatGPT's Codex offers the account, and how hard each may think; asked once a day."""
    cache = os.path.join(ROOM, "models-chatgpt.json")
    try:
        if os.path.getmtime(cache) > datetime.datetime.now().timestamp() - 86400:
            with open(cache) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        d = json.loads(subprocess.run(["codex", "debug", "models"], capture_output=True, text=True, timeout=30, env=dict(os.environ, PATH=SEARCH)).stdout)
        out = [{"id": m["slug"], "name": m.get("display_name") or m["slug"], "efforts": [e["effort"] for e in m.get("supported_reasoning_levels", [])]}
               for m in d.get("models", []) if m.get("visibility") == "list"]
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return [{"id": "", "name": "Auto"}]
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(out, f)
    return out or [{"id": "", "name": "Auto"}]


CHOICE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai-models.json")


def choice():
    """The user's word on the models: which are hidden ("provider/model") and which one is the default."""
    try:
        with open(CHOICE) as f:
            c = json.load(f)
        return {"hidden": list(c.get("hidden", [])), "default": c.get("default", "")}
    except (OSError, ValueError, AttributeError):
        return {"hidden": [], "default": ""}


def whisper():
    """whisper-cli and the model it is best with here: on the graphics card the large turbo model is quick enough
    (8 s for a 4 s sentence on latte-lab's RX 640), on the processor only the small one is (inspo/ai-na-ploche.md)."""
    for d in LOCAL_DIRS:
        for build, models in (("build-vk", ("ggml-large-v3-turbo-q5_0.bin", "ggml-small.bin")), ("build", ("ggml-small.bin", "ggml-base.bin"))):
            cli = os.path.join(d, "whisper-src", build, "bin", "whisper-cli")
            for m in models:
                if os.path.exists(cli) and os.path.exists(os.path.join(d, "whisper", m)):
                    return cli, os.path.join(d, "whisper", m)
    return None, None


HANDS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "agent-hands.json")
GATE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "pleamar-wm", "gate.rules")
# LatteOS's own windows, as pleamar-wm's rules see them ("APP TITLE", lowercase): its apps (`//@ pragma AppId
# latteos-…`), its scenes (pleamar: Goo, DualBrew…), the panels (the shell's surfaces) and its own programs (latte-…)
OS_WINDOWS = ["latteos-*", "org.latteos.*", "pleamar*", "panel", "latte-*"]      # org.latteos.*: its windows made with pleamar (Properties, What the AI changed…)
GATE_BEGIN, GATE_END = "# LatteOS: the agent's hands (LensAI › Settings › Hands) — begin", "# LatteOS: the agent's hands — end"


def hands_state():
    s = {"mouse": {"scope": "os", "apps": []}, "keys": {"scope": "os", "apps": []}}
    try:
        with open(HANDS) as f:
            for k, v in json.load(f).items():
                if k in s and isinstance(v, dict) and v.get("scope") in ("off", "os", "apps", "all"):
                    s[k] = {"scope": v["scope"], "apps": [str(x) for x in v.get("apps", []) if str(x).strip()]}
    except (OSError, ValueError):
        pass
    return s


def hands_rules(s):
    """The lines for pleamar-wm: a deny fences nothing in, an allow fences the hand in to what it names."""
    out = []
    for tool in ("mouse", "keys"):
        scope, apps = s[tool]["scope"], s[tool]["apps"]
        if scope == "off":
            out.append(f"deny * {tool} *")
        elif scope in ("os", "apps"):
            for w in OS_WINDOWS + ([f"{a.lower()} *" for a in apps] if scope == "apps" else []):
                out.append(f"allow * {tool} {w}")
    return out


def hands_write(s):
    os.makedirs(os.path.dirname(HANDS), exist_ok=True)
    with open(HANDS, "w") as f:
        json.dump(s, f, indent=1)
    try:
        with open(GATE) as f:
            old = f.read().splitlines()
    except OSError:
        old = []
    keep, inside = [], False                      # the user's own lines stay, ours are written again
    for line in old:
        if line == GATE_BEGIN:
            inside = True
        elif line == GATE_END:
            inside = False
        elif not inside:
            keep.append(line)
    os.makedirs(os.path.dirname(GATE), exist_ok=True)
    with open(GATE, "w") as f:
        f.write("\n".join(keep + [GATE_BEGIN] + hands_rules(s) + [GATE_END]) + "\n")


def sherpa(kind):
    """sherpa-onnx (Apache-2.0) and its model here: "asr" Parakeet TDT (KInIT's Slovak one when it is made, else NVIDIA's
    v3 of 25 languages; 5 s of speech in ~1 s on the processor), "tts" Piper's Slovak voice Lili. The voice needs the
    1.x build: from 2.0 sherpa-onnx has no espeak-ng, which a Piper voice reads its words with."""
    for d in LOCAL_DIRS:
        builds = sorted(glob.glob(os.path.join(d, "sherpa-onnx", "sherpa-onnx-v*-linux-x64-shared")))
        if kind == "tts":
            builds = [b for b in builds if "-v1." in b]
        if not builds:
            continue
        if kind == "asr":
            for m in ("parakeet-tdt-0.6b-v3-sk-int8", "sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"):
                m = os.path.join(d, "models", "asr", m)
                # whole only: a model half made (its encoder missing) is passed over for the next one
                if os.path.exists(os.path.join(m, "tokens.txt")) and glob.glob(os.path.join(m, "encoder*.onnx")):
                    return builds[-1], m
        else:
            m = os.path.join(d, "models", "tts", "vits-piper-sk_SK-lili-medium")
            if os.path.exists(os.path.join(m, "tokens.txt")):
                return builds[-1], m
    return None, None


def asr(wav):
    """What was said in a recording: Parakeet through sherpa-onnx; None when it is not here."""
    build, m = sherpa("asr")
    if not build:
        return None
    pick = lambda name: next(iter(sorted(glob.glob(os.path.join(m, name)))), "")
    out = subprocess.run([os.path.join(build, "bin", "sherpa-onnx-offline"), "--num-threads=%d" % max(2, min(4, (os.cpu_count() or 4) // 2)),
                          "--encoder=" + pick("encoder*.onnx"), "--decoder=" + pick("decoder*.onnx"), "--joiner=" + pick("joiner*.onnx"),
                          "--tokens=" + os.path.join(m, "tokens.txt"), "--model-type=nemo_transducer", wav],
                         capture_output=True, text=True, timeout=120, env=dict(os.environ, LD_LIBRARY_PATH=os.path.join(build, "lib")))
    found = re.findall(r'"text": "((?:[^"\\]|\\.)*)"', out.stdout + out.stderr)
    return json.loads('"%s"' % found[-1]) if found else None


SPEAKING = os.path.join(ROOM, "say.pid")


def say(text, wait=False):
    """Read aloud in Lili's voice (Piper, the dataset CC0): the words to a sound file, then pw-play; one at a time — a new
    one, or `say stop`, ends what is being read. With `wait`, returns when it was read or stopped (LensAI's button)."""
    import signal
    try:
        os.killpg(int(open(SPEAKING).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    if text == "":
        return {"ok": True}
    build, m = sherpa("tts")
    if not build:
        return {"ok": False, "error": "the voice is not here (sherpa-onnx 1.x and Piper's Lili, /data/ai)"}
    wav = os.path.join(ROOM, "say.wav")
    tool = [os.path.join(build, "bin", "sherpa-onnx-offline-tts"), "--num-threads=4", "--vits-model=" + os.path.join(m, "sk_SK-lili-medium.onnx"),
            "--vits-tokens=" + os.path.join(m, "tokens.txt"), "--vits-data-dir=" + os.path.join(m, "espeak-ng-data"), "--output-filename=" + wav]
    # what a person hears: no Markdown marks, no code blocks
    words = re.sub(r"```.*?```", " ", text, flags=re.S)
    words = re.sub(r"[*_#`>|]+", " ", words)
    p = subprocess.Popen(["sh", "-c", 'lib="$1"; out="$2"; shift 2; LD_LIBRARY_PATH="$lib" "$@" >/dev/null 2>&1 && exec pw-play "$out"',
                          "sh", os.path.join(build, "lib"), wav] + tool + [" ".join(words.split())[:4000]],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    open(SPEAKING, "w").write(str(p.pid))
    if wait:
        p.wait()
    return {"ok": True}


def listen(what):
    wav, pid = os.path.join(ROOM, "listen.wav"), os.path.join(ROOM, "listen.pid")
    os.makedirs(ROOM, exist_ok=True)
    if what == "start":
        p = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", wav],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        try:
            p.wait(0.3)                                      # no microphone or no PipeWire: it ends at once
            return {"ok": False, "error": "the microphone did not start"}
        except subprocess.TimeoutExpired:
            pass
        open(pid, "w").write(str(p.pid))
        return {"ok": True}
    import signal, time
    try:
        os.kill(int(open(pid).read()), signal.SIGINT)        # SIGINT: pw-record closes the file properly
        time.sleep(0.4)
    except (OSError, ValueError):
        pass                                                 # it had ended by itself: what it wrote is still there
    try:
        os.remove(pid)
    except OSError:
        pass
    if not os.path.exists(wav) or os.path.getsize(wav) < 8000:   # under a quarter of a second: nothing was heard
        return {"text": "", "ok": False, "error": "nothing was heard"}
    heard = asr(wav)                                          # Parakeet first: as good, five times sooner
    if heard is not None:
        return {"text": heard, "ok": True}
    cli, model = whisper()
    if not cli:
        return {"text": "", "ok": False, "error": "neither sherpa-onnx nor whisper.cpp is here"}
    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2]
    out = subprocess.run([cli, "-m", model, "-l", lang, "-t", str(max(2, (os.cpu_count() or 4) // 2)), "-nt", "-np", "-f", wav],
                         capture_output=True, text=True, timeout=120).stdout
    return {"text": " ".join(l.strip() for l in out.splitlines() if l.strip()), "ok": True}


# Micro-agents (inspo/ai-na-ploche.md): each a fixed task with words of its own, for a small model to do quickly.
LANGS = {"sk": "Slovak", "cs": "Czech", "en": "English", "de": "German", "hu": "Hungarian", "pl": "Polish"}
AGENTS = {
    "summarize": "Summarize the following in a few sentences, in {lang}:\n\n{text}",
    "translate": "Translate the following into {lang}; if it is already {lang}, into English. Only the translation:\n\n{text}",
    "explain": "This is an error message from a Linux computer (Fedora). Explain simply in {lang} what it means and how to fix it:\n\n{text}",
    "command": "Write one bash command for Fedora Linux that does this, then one sentence in {lang} saying what it does. "
               "The user's home folder is {home}; use the folder names as they are given:\n\n{text}",
}


def agent(name, text):
    if not text.strip():
        try:
            text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            text = ""
    if not text.strip():
        return {"question": "", "error": "nothing to work on: the field and the clipboard are empty"}
    lang = LANGS.get((os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2], "English")
    local = [p for p in providers() if p["id"] == "local"]
    pick = local[0] if local else (providers() or [None])[0]
    return {"question": AGENTS[name].format(lang=lang, home=os.path.expanduser("~"), text=text.strip()[:12000]), "provider": pick["id"] if pick else "",
            "model": pick["models"][0]["id"] if pick else ""}


def copilot(prompt, model, effort="", files=()):
    # prompt mode asks for no permission, so a tool that would change something is refused; no MCP servers of the user's
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["copilot", "-p", SYSTEM + "\n\n" + prompt, "-s", "--disable-builtin-mcps", "--model", model or "auto"]


def copilot_usage():
    """What GitHub tells of the account's Copilot (what VS Code shows): {"chat": {"used", "resets"}, "completions": …}."""
    try:
        d = json.loads(subprocess.run(["gh", "api", "/copilot_internal/user"], capture_output=True, text=True, timeout=15).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    resets = 0
    try:
        resets = int(datetime.datetime.fromisoformat(d.get("quota_reset_date", "") + "T00:00:00").timestamp())
    except ValueError:
        pass
    out = {}
    for k, q in (d.get("quota_snapshots") or {}).items():
        if k in ("chat", "completions") and not q.get("unlimited"):
            out[k] = {"used": round(1 - (q.get("percent_remaining", 100) / 100), 4), "resets": resets}
    return out


# ── what the services tell of the account, asked without a question (the way Omarchy's agents panel does; MIT) ──
USAGE_REUSE = 900                     # Anthropic refuses usage checks readily: an answer is good for a quarter of an hour
USAGE_REUSE_NEAR = 180                # …and for three minutes once a limit is 80 % used, when it matters (as Omarchy does)


def _remembered(name, fetch):
    """A service's answer, kept for USAGE_REUSE seconds and given again when a new one cannot be had."""
    cache = os.path.join(ROOM, "usage-%s.json" % name)
    try:
        with open(cache) as f:
            kept = json.load(f)
    except (OSError, ValueError):
        kept = {}
    near = any(isinstance(v, dict) and (v.get("used") or 0) >= 0.8 for v in (kept.get("limits") or {}).values())
    if kept.get("at", 0) > datetime.datetime.now().timestamp() - (USAGE_REUSE_NEAR if near else USAGE_REUSE) and kept.get("limits"):
        return kept["limits"]
    try:
        fresh = fetch()
    except Exception:                 # the service did not answer, or answered with something else: the last answer stays
        fresh = None
    if not fresh:
        return kept.get("limits") or {}
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump({"at": datetime.datetime.now().timestamp(), "limits": fresh}, f)
    return fresh


def _when(iso):
    try:
        return int(datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


def claude_usage():
    """The five hours and the week, from Anthropic's usage endpoint, with the sign-in Claude Code keeps. The token is
    read, used in the one request and nowhere written; when it has run out, Claude Code renews it the next time it runs."""
    def fetch():
        import urllib.request
        home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
        with open(os.path.join(home, ".credentials.json")) as f:
            login = json.load(f).get("claudeAiOauth") or {}
        if (login.get("expiresAt") or 0) / 1000 < datetime.datetime.now().timestamp():
            return None
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": "Bearer " + login.get("accessToken", ""), "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"})
        d = json.load(urllib.request.urlopen(req, timeout=10))
        out = {}
        for key, name in (("five_hour", "five_hour"), ("seven_day_oauth_apps", "seven_day"), ("seven_day", "seven_day")):
            b = d.get(key)
            if isinstance(b, dict) and b.get("utilization") is not None and name not in out:
                u = float(b["utilization"])
                out[name] = {"used": round(u / 100 if u > 1 else u, 4), "resets": _when(b.get("resets_at"))}
        # a limit of one model alone (a week of Fable, Opus…): Anthropic lists each in "limits" with what it is for, its scope
        for b in d.get("limits") or []:
            scope = b.get("scope")
            if isinstance(scope, dict):
                scope = next((str(v) for k, v in scope.items() if isinstance(v, str) and k in ("display_name", "name", "model", "label")), "")
            if scope and b.get("percent") is not None:
                out.setdefault("scoped", []).append({"group": b.get("group") or "", "scope": str(scope), "used": round(float(b["percent"]) / 100, 4),
                                                     "resets": _when(b.get("resets_at"))})
        # the extra usage paid with credits once the plan's limits are reached: how much of the month's sum is spent
        x = d.get("extra_usage")
        if isinstance(x, dict) and x.get("monthly_limit"):
            places = int(x.get("decimal_places") or 2)
            spent, cap = float(x.get("used_credits") or 0) / 10 ** places, float(x["monthly_limit"]) / 10 ** places
            out["extra"] = {"used": round(spent / cap, 4) if cap else 0, "resets": 0,
                            "note": "%.2f / %.0f %s" % (spent, cap, x.get("currency") or ""), "off": not x.get("is_enabled")}
        # credits given for free now and then (a promotion), told while there are any
        promo = d.get("promo_credits")
        if isinstance(promo, dict) and promo.get("utilization") is not None:
            u = float(promo["utilization"])
            out["promo"] = {"used": round(u / 100 if u > 1 else u, 4), "resets": _when(promo.get("resets_at"))}
        return out
    return _remembered("claude", fetch)


def grok_usage():
    """The period's credits, from xAI's billing, with the sign-in Grok Build keeps."""
    def fetch():
        import urllib.request
        with open(os.path.join(os.environ.get("GROK_HOME") or os.path.expanduser("~/.grok"), "auth.json")) as f:
            login = next((v for v in json.load(f).values() if isinstance(v, dict)), {})
        req = urllib.request.Request("https://cli-chat-proxy.grok.com/v1/billing?format=credits",
                                     headers={"Authorization": "Bearer " + str(login.get("key", "")), "Accept": "application/json"})
        config = json.load(urllib.request.urlopen(req, timeout=10))["config"]
        period = config["currentPeriod"]
        return {"credits": {"used": round(float(config.get("creditUsagePercent") or 0) / 100, 4), "resets": _when(period.get("end")),
                            "week": "WEEK" in str(period.get("type"))}}
    return _remembered("grok", fetch)


def chatgpt_usage():
    """The five hours and the week of the ChatGPT plan, as Codex itself tells them: its app-server (read-only) asked for
    account/rateLimits/read over JSON-RPC, the way Omarchy's omarchy-agent-usage-codex does (MIT)."""
    def fetch():
        import select
        proc = subprocess.Popen([shutil.which("codex", path=SEARCH) or "codex", "-s", "read-only", "-a", "on-request", "app-server"],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=dict(os.environ, PATH=SEARCH))
        pending = b""

        def ask(n, method, params=None):
            nonlocal pending
            proc.stdin.write((json.dumps({"id": n, "method": method, "params": params or {}}) + "\n").encode())
            proc.stdin.flush()
            end = datetime.datetime.now().timestamp() + 8
            while datetime.datetime.now().timestamp() < end:
                while b"\n" in pending:            # replies and notifications can come in one write: split them here
                    line, pending = pending.split(b"\n", 1)
                    try:
                        m = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(m, dict) and m.get("id") == n:
                        return m
                if select.select([proc.stdout], [], [], 0.25)[0]:
                    chunk = os.read(proc.stdout.fileno(), 65536)
                    if not chunk:
                        return {}
                    pending += chunk
            return {}
        try:
            ask(1, "initialize", {"clientInfo": {"name": "latte-ai", "version": "1"}})
            proc.stdin.write((json.dumps({"method": "initialized", "params": {}}) + "\n").encode())
            proc.stdin.flush()
            limits = ((ask(2, "account/rateLimits/read").get("result") or {}).get("rateLimits")) or {}
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        out = {"plan": str(limits.get("planType") or "")} if limits else {}
        for w in (limits.get("primary"), limits.get("secondary")):
            if isinstance(w, dict) and w.get("usedPercent") is not None:
                name = "seven_day" if (w.get("windowDurationMins") or 0) >= 10080 else "five_hour"
                out[name] = {"used": round(float(w["usedPercent"]) / 100, 4), "resets": int(w.get("resetsAt") or 0)}
        return out
    return _remembered("chatgpt", fetch)


def claude_stats(days=7):
    """Tokens of the last days by day and model, from Claude Code's own transcripts (~/.claude/projects; LatteOS's
    questions to Claude are there too): a message counted once (its blocks repeat its usage), input, output and what went
    into the cache, not what was read from it again. Each file's sums are kept by its size, so only a changed one is read."""
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    since = datetime.datetime.now().timestamp() - (days + 1) * 86400
    cache_path = os.path.join(ROOM, "stats-claude.json")
    try:
        with open(cache_path) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    fresh = {}
    for path in glob.glob(os.path.join(home, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        if st.st_mtime < since:
            continue
        kept = cache.get(path)
        if kept and kept.get("s") == st.st_size:
            fresh[path] = kept
            continue
        sums, prompts, seen = {}, {}, set()
        with open(path, errors="replace") as f:
            for line in f:
                if '"usage"' not in line and '"promptId"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                day = str(d.get("timestamp", ""))[:10]
                m = d.get("message") if isinstance(d.get("message"), dict) else {}
                if d.get("type") == "assistant" and m.get("usage") and m.get("id") not in seen:
                    seen.add(m.get("id"))
                    u = m["usage"]
                    n = (u.get("input_tokens") or 0) + (u.get("output_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
                    by = sums.setdefault(day, {})
                    by[m.get("model", "")] = by.get(m.get("model", ""), 0) + n
                elif d.get("type") == "user" and d.get("promptId") and d["promptId"] not in seen:
                    seen.add(d["promptId"])
                    prompts[day] = prompts.get(day, 0) + 1
        fresh[path] = {"s": st.st_size, "days": sums, "prompts": prompts}
    os.makedirs(ROOM, exist_ok=True)
    with open(cache_path, "w") as f:
        json.dump(fresh, f)
    return fresh


SKILL_SHIPPED = "/usr/share/latteos/agents/skills/latteos"
SKILL_MINE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "skills", "latteos")
# where the agents look for skills (as Omarchy links its own): a tool's folder only when the tool is there
SKILL_HOMES = (("~/.claude", "skills"), ("~/.codex", "skills"), ("~/.gemini", "../.agents/skills"))


def skill(what):
    """LatteOS's skill for the agents: the user's own copy, made from LatteOS's and linked where each agent looks.
    install: the copy if there is none, and the links where there are none (a skill of the user's own of the same name
    is left alone); reset: LatteOS's own again, the user's kept beside it as SKILL.md.bak; path: where the copy is."""
    if what == "path":
        return os.path.join(SKILL_MINE, "SKILL.md")
    mine = os.path.join(SKILL_MINE, "SKILL.md")
    if what == "reset" and os.path.exists(mine):
        shutil.copy(mine, mine + ".bak")
    if what == "reset" or not os.path.exists(mine):
        os.makedirs(SKILL_MINE, exist_ok=True)
        shutil.copy(os.path.join(SKILL_SHIPPED, "SKILL.md"), mine)
    for home, sub in SKILL_HOMES:
        home = os.path.expanduser(home)
        if not os.path.isdir(home):
            continue
        where = os.path.normpath(os.path.join(home, sub))
        os.makedirs(where, exist_ok=True)
        link = os.path.join(where, "latteos")
        if not os.path.lexists(link):
            os.symlink(SKILL_MINE, link)
    return mine


# what Claude Code writes as a user's line that the user did not type: slash commands, their output, notes to the model
NOT_PROMPT = ("<command-", "<local-command", "Caveat:", "<system-reminder", "<bash-", "<task-notification", "<ide_",
              "[Request interrupted")


def sessions(most=30):
    """The user's Claude Code sessions, the newest first, to be resumed with `claude --resume ID` in "folder":
    [{"id", "title" (Claude Code's own ai-title, else the first prompt, one line), "folder", "when", "turns" (prompts)}].
    Only top-level transcripts (subagents' are in subfolders); one with no prompt of the user's (a subagent's own) or run
    by a program through the SDK (entrypoint sdk-*) is left out. A transcript only grows, so each is read on from where
    it was read last (kept in sessions-claude-2.json; the number goes up when what is kept changes)."""
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    cache_path = os.path.join(ROOM, "sessions-claude-2.json")
    try:
        with open(cache_path) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    fresh = {}
    for path in glob.glob(os.path.join(home, "projects", "*", "*.jsonl")):
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        kept = cache.get(path)
        if not kept or kept["s"] > size:
            kept = {"s": 0, "title": "", "ai": "", "folder": "", "when": "", "turns": 0, "sdk": False}
        if kept["s"] < size:
            with open(path, "rb") as f:
                f.seek(kept["s"])
                for raw in f:
                    if not raw.endswith(b"\n"):     # a line still being written: read next time
                        break
                    kept["s"] += len(raw)
                    line = raw.decode(errors="replace")
                    if '"timestamp":"' in line:
                        kept["when"] = max([kept["when"]] + re.findall(r'"timestamp":"([0-9T:.Z-]+)"', line))
                    kept["sdk"] = kept["sdk"] or '"entrypoint":"sdk-' in line
                    if line.startswith('{"type":"ai-title"'):
                        try:
                            kept["ai"] = json.loads(line).get("aiTitle") or kept["ai"]
                        except ValueError:
                            pass
                        continue
                    if '"type":"user"' not in line or '"type":"tool_result"' in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    if d.get("type") != "user" or d.get("isSidechain") or d.get("isMeta") or d.get("isCompactSummary"):
                        continue
                    c = (d.get("message") or {}).get("content")
                    texts = [c] if isinstance(c, str) else [b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"]
                    text = next((t.strip() for t in texts if t.strip() and not t.strip().startswith(NOT_PROMPT)), "")
                    if not text:
                        continue
                    kept["turns"] += 1
                    if not kept["title"]:
                        first = text.splitlines()[0].strip()
                        kept["title"] = first if len(first) <= 80 else first[:79] + "…"
                        kept["folder"] = d.get("cwd", "")
        fresh[path] = kept
    os.makedirs(ROOM, exist_ok=True)
    with open(cache_path + ".new", "w") as f:      # whole or not at all: a run ended halfway leaves the last cache
        json.dump(fresh, f)
    os.replace(cache_path + ".new", cache_path)
    found = [{"id": os.path.basename(p)[:-6], "title": s["ai"] or s["title"], "folder": s["folder"], "when": s["when"], "turns": s["turns"]}
             for p, s in fresh.items() if s["turns"] and not s["sdk"]]
    return sorted(found, key=lambda s: s["when"], reverse=True)[:most]


def front_matter(path):
    """name and description from a SKILL.md's YAML head: plain, quoted, or folded (> |) values only, no YAML library."""
    found, key = {}, None
    with open(path, errors="replace") as f:
        if f.readline().strip() != "---":
            return found
        for line in f:
            if line.strip() == "---":
                break
            if key and line[:1] in (" ", "\t"):
                found[key] = (found[key] + " " + line.strip()).strip()
                continue
            key = None
            name, colon, value = line.partition(":")
            if colon and name in ("name", "description"):
                value = value.strip()
                if value[:1] in ("'", '"') and value[-1:] == value[:1]:
                    value = value[1:-1]
                found[name] = "" if value in (">", "|", ">-", "|-") else value
                key = name
    return found


# where each skill lives, and which tool reads each folder: Gemini CLI reads ~/.agents/skills (SKILL_HOMES links it
# there for ~/.gemini, as Omarchy does)
SKILL_DIRS = (("latteos", "~/.config/latteos/skills", None), ("claude", "~/.claude/skills", "Claude Code"),
              ("agents", "~/.agents/skills", "Gemini CLI"), ("codex", "~/.codex/skills", "Codex"))


def skills_all():
    """Every agent skill on this computer, by its real SKILL.md: [{"name", "description", "path", "home", "seen"}]."""
    found = {}
    for home, where, tool in SKILL_DIRS:
        for path in glob.glob(os.path.join(os.path.expanduser(where), "*", "SKILL.md")):
            real = os.path.realpath(path)
            if real not in found:
                try:
                    head = front_matter(real)
                except OSError:
                    continue
                lives = next((h for h, w, _ in SKILL_DIRS if real.startswith(os.path.realpath(os.path.expanduser(w)) + os.sep)), "other")
                found[real] = {"name": head.get("name") or os.path.basename(os.path.dirname(path)),
                               "description": head.get("description", ""), "path": real, "home": lives, "seen": []}
            if tool and tool not in found[real]["seen"]:
                found[real]["seen"].append(tool)
    return sorted(found.values(), key=lambda s: s["name"].lower())


