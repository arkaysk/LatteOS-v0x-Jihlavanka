# ── one index of every conversation (ROADMAP 10B.73, lensAIplan2.md 7): LensAI's own (LensGoo's and LensShore's too),
# Claude Code's sessions in terminals, the Helper's tasks — searched by their words, without accents and in any form of
# the word's beginning (SQLite FTS5, as memex-chats does it, MIT). Vectors of meaning (e5-sk-small) come after. Read on
# from where each file was read last, so a search after the first costs what came since.
INDEX = os.path.join(ROOM, "index.db")


def embedder():
    """The model that turns a text into its meaning (e5-sk-small, MIT, Slovak; made GGUF for llama.cpp, ROADMAP 10B.75)."""
    for d in LOCAL_DIRS:
        found = sorted(glob.glob(os.path.join(d, "models", "embed", "e5-sk*.gguf")))
        if found:
            return found[-1]
    return None


def embed(texts):
    """Each text's meaning, a unit vector (numpy), from the router; None when there is no model or it does not answer.
    e5 wants "query: " before what is looked for and "passage: " before what is looked in."""
    import numpy
    m = embedder()
    if not m or not local_server() or not local_start(m):
        return None
    try:
        got = local_call("/v1/embeddings", {"model": local_name(m), "input": texts}, timeout=300)["data"]
    except (OSError, ValueError, KeyError):
        return None
    v = numpy.array([x["embedding"] for x in sorted(got, key=lambda x: x["index"])], dtype=numpy.float32)
    return v / numpy.maximum(numpy.linalg.norm(v, axis=1, keepdims=True), 1e-9)


# ── the skills' store (ROADMAP 10B.85; the user, 20. 11.): skills.sh's search, installed by Vercel's `skills` (MIT) once
# into ~/.agents/skills, which Codex reads, linked for Claude Code and Gemini CLI; agentgram offers them in "Skill from LensAI"
SKILL_AGENTS = ["codex", "claude-code", "gemini-cli"]


def skills_find(words):
    """skills.sh's skills for these words, the most installed first: [{"source", "skill", "name", "installs", "url"}]."""
    import urllib.parse
    import urllib.request
    try:
        got = json.load(urllib.request.urlopen(urllib.request.Request(
            "https://skills.sh/api/search?" + urllib.parse.urlencode({"q": words}), headers={"User-Agent": "LatteOS"}), timeout=15))
    except (OSError, ValueError):
        return []
    rows = [x for x in got.get("skills") or [] if not x.get("isDuplicate") and x.get("source") and x.get("skillId")]
    return [{"source": x["source"], "skill": x["skillId"], "name": x.get("name") or x["skillId"], "installs": x.get("installs", 0),
             "url": "https://skills.sh/" + x.get("id", "")} for x in sorted(rows, key=lambda x: -x.get("installs", 0))[:40]]


def skills_official():
    """Anthropic's own skills (github.com/anthropics/skills, their licenses in each folder), the list kept a day."""
    import time
    import urllib.request
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "skills-anthropic.json")
    try:
        if os.path.exists(cache) and time.time() - os.path.getmtime(cache) < 86400:
            with open(cache) as f:
                return json.load(f)
        got = json.load(urllib.request.urlopen(urllib.request.Request("https://api.github.com/repos/anthropics/skills/contents/skills",
                                                                      headers={"User-Agent": "LatteOS"}), timeout=15))
        rows = [{"source": "anthropics/skills", "skill": x["name"], "name": x["name"], "installs": 0, "from": "anthropic",
                 "url": "https://github.com/anthropics/skills/tree/main/skills/" + x["name"]} for x in got if x.get("type") == "dir"]
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        with open(cache, "w") as f:
            json.dump(rows, f)
        return rows
    except (OSError, ValueError, KeyError, TypeError):
        return []


def skills_clawhub(words):
    """ClawHub's skills (OpenClaw's registry) for these words, those it does not mark suspicious; each links back to its
    page there, as ClawHub asks of directories that show its catalog."""
    import urllib.parse
    import urllib.request
    try:
        got = json.load(urllib.request.urlopen(urllib.request.Request("https://clawhub.ai/api/v1/search?" + urllib.parse.urlencode(
            {"q": words, "limit": 30, "nonSuspiciousOnly": "true"}), headers={"User-Agent": "LatteOS"}), timeout=15))
    except (OSError, ValueError):
        return []
    return [{"source": "@" + x["ownerHandle"] + "/" + x["slug"], "skill": x["slug"], "name": x.get("displayName") or x["slug"],
             "what": x.get("summary", ""), "installs": (x.get("metrics") or {}).get("downloads") or x.get("downloads") or 0, "from": "clawhub",
             "url": "https://clawhub.ai" + (x.get("canonicalUrl") or "")}
            for x in got.get("results") or [] if x.get("slug") and x.get("ownerHandle")
            and (x.get("trust") or {}).get("installability", "installable") == "installable"]


def skills_clawhub_run(args):
    """ClawHub's own tool (npx clawhub, MIT) on the shared folder ~/.agents/skills, asking nothing, telling nothing back;
    a skill it put there is linked for Claude Code as Vercel's `skills` links them."""
    try:
        r = subprocess.run(["npx", "-y", "clawhub", "--workdir", os.path.expanduser("~/.agents"), "--dir", "skills", "--no-input"] + args,
                           capture_output=True, text=True, timeout=600, env=dict(os.environ, PATH=SEARCH, CLAWHUB_DISABLE_TELEMETRY="1"))
    except (OSError, subprocess.TimeoutExpired):
        return False
    name = args[-1].split("/")[-1]
    link = os.path.expanduser("~/.claude/skills/" + name)
    if r.returncode == 0 and args[0] == "install" and os.path.isdir(os.path.expanduser("~/.claude")) and not os.path.lexists(link):
        os.makedirs(os.path.dirname(link), exist_ok=True)
        os.symlink("../../.agents/skills/" + name, link)
    if r.returncode == 0 and args[0] == "uninstall" and os.path.islink(link):
        os.remove(link)
    return r.returncode == 0


def skills_cli(args):
    """Vercel's `skills` (through npx), for this user, for every agent's tool, asking nothing and telling nothing back."""
    agents = [x for a in SKILL_AGENTS for x in ("-a", a)] if args[0] == "add" else []      # removed: from all, the shared copy too
    try:
        r = subprocess.run(["npx", "-y", "skills"] + args + ["-g"] + agents + ["-y"], capture_output=True, text=True, timeout=600,
                           env=dict(os.environ, PATH=SEARCH, DISABLE_TELEMETRY="1", DO_NOT_TRACK="1"))
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def anonymous(folder):
    """Whether a folder is in an anonymous project of agentgram (the user, 20. 11.: nothing of it leaves it, LensAI's index
    neither): agentgram marks its folder and its subprojects' with .agentgram-anonymous."""
    root, d = os.path.realpath(PROJECTS_DIR), os.path.realpath(folder) if folder else ""
    while d.startswith(root + os.sep):
        if os.path.exists(os.path.join(d, ".agentgram-anonymous")):
            return True
        d = os.path.dirname(d)
    return False


def forget_said(db, key):
    """A conversation's lines out of the index, with their meanings (a line's number may be given again later)."""
    db.execute("delete from vecs where id in (select rowid from said where key = ?)", (key,))
    db.execute("delete from said where key = ?", (key,))


def index_meanings(most=100000):
    """The meanings of the lines that have none yet, 32 at a time: what `latte-ai index` does in the background."""
    db = index_open()
    index_update(db)
    left = db.execute("select rowid, text from said where rowid not in (select id from vecs) limit ?", (most,)).fetchall()
    for i in range(0, len(left), 32):
        part = left[i:i + 32]
        # 512 tokens at most a line (the model's length); code takes more tokens a letter than words, so a shorter cut once more
        v = embed(["passage: " + t[:800] for _, t in part])
        if v is None:
            v = embed(["passage: " + t[:300] for _, t in part])
        if v is None:
            break
        db.executemany("insert or replace into vecs values (?, ?)", [(rid, v[k].tobytes()) for k, (rid, _) in enumerate(part)])
        db.commit()
    db.close()


def index_open():
    import sqlite3
    os.makedirs(ROOM, exist_ok=True)
    db = sqlite3.connect(INDEX)
    db.execute("create table if not exists docs (key text primary key, source text, ref text, title text, folder text, at text, size integer)")
    db.execute("create virtual table if not exists said using fts5 (key unindexed, role unindexed, at unindexed, text, "
               "tokenize = 'unicode61 remove_diacritics 2')")
    db.execute("create table if not exists vecs (id integer primary key, v blob)")    # a line's meaning, 384 floats
    return db


def index_update(db):
    """What came since the last time: LensAI's conversations whole when they changed, the transcripts read on."""
    known = {k: (s, t) for k, s, t in db.execute("select key, size, title from docs")}
    for path in glob.glob(os.path.join(ROOM, "chats", "*.json")):
        key, stamp = "lensai:" + os.path.basename(path)[:-5], int(os.path.getmtime(path))
        if key in known and known[key][0] == stamp:
            continue
        try:
            with open(path) as f:
                c = json.load(f)
        except (OSError, ValueError):
            continue
        if c.get("machine"):
            continue
        forget_said(db, key)
        for m in c.get("messages") or []:
            if isinstance(m.get("content"), str) and m["content"].strip():
                db.execute("insert into said values (?, ?, ?, ?)", (key, m.get("role", ""), m.get("at", ""), m["content"]))
        db.execute("insert or replace into docs values (?, 'lensai', ?, ?, '', ?, ?)",
                   (key, os.path.basename(path)[:-5], c.get("title", ""), (c.get("messages") or [{}])[-1].get("at", ""), stamp))
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    for key, folder in db.execute("select key, folder from docs where source = 'claude' and folder != ''").fetchall():
        if anonymous(folder):                               # a project made anonymous after its agents' sessions were read
            forget_said(db, key)
            db.execute("update docs set title = '', folder = '' where key = ?", (key,))
    for path in glob.glob(os.path.join(home, "projects", "*", "*.jsonl")) + glob.glob(os.path.join(HELPER, "*.jsonl")):
        helper_log = path.startswith(HELPER)
        key, size = ("helper:" if helper_log else "claude:") + path, os.path.getsize(path)
        start, title = known.get(key, (0, ""))
        if start > size:                                   # a file written anew: from its beginning
            forget_said(db, key)
            start = 0
        if start == size:
            continue
        folder, at = "", ""
        with open(path, "rb") as f:
            f.seek(start)
            for raw in f:
                if not raw.endswith(b"\n"):
                    break
                start += len(raw)
                try:
                    d = json.loads(raw)
                except ValueError:
                    continue
                if helper_log:
                    if d.get("t") == "start":
                        title, folder = d.get("task", "").split("The task:", 1)[-1].strip()[:120], d.get("dir", "")
                        db.execute("insert into said values (?, 'user', '', ?)", (key, title))
                    elif d.get("t") == "update" and (d.get("u") or {}).get("sessionUpdate") == "agent_message_chunk":
                        db.execute("insert into said values (?, 'assistant', '', ?)", (key, (d["u"].get("content") or {}).get("text", "")))
                    continue
                if d.get("isSidechain") or d.get("isMeta") or d.get("type") not in ("user", "assistant"):
                    if d.get("type") == "ai-title":
                        title = d.get("aiTitle") or title
                    continue
                folder, at = d.get("cwd") or folder, d.get("timestamp") or at
                content = (d.get("message") or {}).get("content")
                parts = [content] if isinstance(content, str) else [b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text"]
                text = "\n".join(p for p in parts if p and not p.startswith("<"))      # not the harness's own tags
                if text.strip():
                    if not title and d["type"] == "user":
                        title = text.strip().splitlines()[0][:120]
                    db.execute("insert into said values (?, ?, ?, ?)", (key, d["type"], at, text))
        if not helper_log and anonymous(folder):            # an agent of agentgram's anonymous project: never indexed
            forget_said(db, key)
            title, folder, at = "", "", ""
        db.execute("insert into docs values (?, ?, ?, ?, ?, ?, ?) on conflict(key) do update set title = excluded.title, "
                   "folder = coalesce(nullif(excluded.folder, ''), docs.folder), at = coalesce(nullif(excluded.at, ''), docs.at), size = excluded.size",
                   (key, "helper" if helper_log else "claude", os.path.basename(path)[:-6], title, folder, at, start))
    db.commit()


def search(words, most=20):
    """The conversations that say these words, the best first, with the place each says them (FTS5 bm25): [{"source":
    lensai|claude|helper, "ref" (a chat id, a session id, a Helper log), "title", "folder", "at", "snippet"}]."""
    import re
    terms = [w for w in re.findall(r"\w+", words) if w]
    if not terms:
        return []
    db = index_open()
    index_update(db)
    query = " ".join('"%s"*' % w for w in terms)          # every word, each also as the beginning of a longer one
    # the best place in each conversation: bm25 cannot be grouped in SQLite, so the first of each key in rank order
    best = {}
    for key, snip in db.execute("select key, snippet(said, 3, '«', '»', '…', 14) from said where said match ? order by rank limit 400", (query,)):
        best.setdefault(key, snip)
    # and by meaning (e5-sk): the lines nearest to the question, a conversation by its nearest line; both lists joined by
    # Reciprocal Rank Fusion (as memex-chats joins them), so a conversation found both ways comes first
    score = {k: 1 / (60 + i) for i, k in enumerate(best)}
    have = db.execute("select count(*) from vecs").fetchone()[0]
    if have:
        import numpy
        q = embed(["query: " + words])
        if q is not None:
            ids, blobs = zip(*db.execute("select id, v from vecs").fetchall())
            near = numpy.frombuffer(b"".join(blobs), dtype=numpy.float32).reshape(len(ids), -1) @ q[0]
            seen = []
            for j in numpy.argsort(-near)[:200]:
                if near[j] < 0.82:                         # e5's scores lie close together: below this, not the same thing
                    break
                row = db.execute("select key, text from said where rowid = ?", (int(ids[j]),)).fetchone()
                # a line of a few words ("do it", "go on") is near to everything: it says nothing of its own
                if row and len(row[1]) >= 40 and row[0] not in seen:
                    seen.append(row[0])
                    best.setdefault(row[0], " ".join(row[1].split())[:160] + "…")
            for i, k in enumerate(seen[:most]):
                score[k] = score.get(k, 0) + 1 / (60 + i)
    if db.execute("select count(*) from said").fetchone()[0] > have and embedder():
        subprocess.Popen([os.path.abspath(__file__), "index"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)   # the rest, behind
    out = []
    for key in sorted(best, key=lambda k: -score.get(k, 0))[:most]:
        snip = best[key]
        d = db.execute("select source, ref, title, folder, at from docs where key = ?", (key,)).fetchone()
        if d:
            out.append({"source": d[0], "ref": key.split(":", 1)[1] if d[0] == "helper" else d[1], "title": d[2], "folder": d[3], "at": d[4],
                        "snippet": " ".join(snip.split())})
    db.close()
    return out


# ── what another assistant kept, brought into LensAI (ROADMAP 10B.73): ChatGPT's data export (conversations.json, or
# its conversations-NNN.json shards), Claude.ai's (conversations.json, memories.json, projects) and Google Takeout's
# Gemini Apps activity (My Activity/Gemini Apps/MyActivity.json), as the zip or one of its files. Read as llm-memex (MIT,
# Alex Towell) and memex-chats (MIT, Dionisio Pereyra Bocchio) read them. A conversation becomes one of LensAI's, read
# only ("imported"): the index, the search and Conversations have it with no code of their own. What the assistant
# remembers goes into the chosen memory as a note, as Claude's own importer files it (import-memory): only added to,
# never a line twice.
IMPORT_KINDS = {"chatgpt": "ChatGPT", "claude": "Claude", "gemini": "Gemini"}
IMPORT_MOST = 65536             # a pasted memory at most, as Claude's import modal takes it


def import_read(path):
    """The JSON files of an export that tell something: {base name: data}; a zip's read from it, not unpacked. Claude's
    projects (projects/UUID.json, or one projects.json) are one list "projects.json"."""
    import zipfile
    got = {}
    if not zipfile.is_zipfile(path):
        with open(path, encoding="utf-8-sig") as f:
            got[os.path.basename(path)] = json.load(f)
        return got
    with zipfile.ZipFile(path) as z:
        for n in z.namelist():
            b = os.path.basename(n)
            if n.startswith("projects/") and b.endswith(".json"):
                with z.open(n) as f:
                    got.setdefault("projects.json", []).append(json.loads(f.read().decode("utf-8-sig")))
            # Takeout's other products keep a MyActivity of their own; an export in HTML is said so (import_export)
            elif re.fullmatch(r"conversations(-\d+)?\.json|memories\.json|projects\.json", b) or (b == "MyActivity.json" and "Gemini" in n):
                with z.open(n) as f:
                    got[b] = json.loads(f.read().decode("utf-8-sig"))
            elif b == "MyActivity.html" and "Gemini" in n:
                got["html"] = True
    return got


def import_at(t):
    """A time of an export (seconds since 1970, or ISO 8601 with Z) as LensAI keeps its own: local, to the second; "" none."""
    try:
        d = (datetime.datetime.fromtimestamp(t, datetime.timezone.utc) if isinstance(t, (int, float))
             else datetime.datetime.fromisoformat(str(t).replace("Z", "+00:00")))
    except (TypeError, ValueError, OverflowError, OSError):
        return ""
    return (d.astimezone() if d.tzinfo else d).replace(tzinfo=None).isoformat(timespec="seconds")


def import_chatgpt(c):
    """A ChatGPT conversation: a tree (`mapping`; each answer asked again is a branch), read from the node shown last
    (`current_node`) back to its root, as ChatGPT shows it; the system's, the tools' and the hidden messages left out."""
    m = c.get("mapping") or {}
    node = c.get("current_node")
    if node not in m:                                     # none told: the branch that ends last
        leaves = [k for k, v in m.items() if isinstance(v, dict) and not v.get("children")]
        node = max(leaves, key=lambda k: (m[k].get("message") or {}).get("create_time") or 0, default=None)
    line, seen = [], set()
    while node in m and node not in seen and isinstance(m[node], dict):
        seen.add(node)
        line.append(m[node].get("message") or {})
        node = m[node].get("parent")
    out, model = [], ""
    for msg in reversed(line):
        role, meta, body = (msg.get("author") or {}).get("role"), msg.get("metadata") or {}, msg.get("content") or {}
        if (role not in ("user", "assistant") or msg.get("recipient", "all") != "all" or meta.get("is_visually_hidden_from_conversation")
                or body.get("content_type", "text") not in ("text", "multimodal_text")):       # not thoughts, code, its output
            continue
        text = "\n".join(p if isinstance(p, str) else str(p.get("text") or "") for p in body.get("parts") or [] if isinstance(p, (str, dict))).strip()
        if text:
            out.append({"role": role, "content": text, "at": import_at(msg.get("create_time"))})
            model = meta.get("model_slug") or model if role == "assistant" else model
    return {"id": c.get("conversation_id") or c.get("id") or "", "title": c.get("title") or "", "model": model or c.get("default_model_slug") or "",
            "updated": import_at(c.get("update_time")), "messages": out}


def import_claude(c):
    """A Claude.ai conversation (memex-chats' parse_conversation_dict): its text blocks, or the older `text`."""
    out = []
    for m in c.get("chat_messages") or c.get("messages") or []:
        if not isinstance(m, dict):
            continue
        blocks = m.get("content") if isinstance(m.get("content"), list) else []
        text = "\n".join(str(b.get("text") or "") for b in blocks if isinstance(b, dict) and b.get("type") == "text").strip()
        text = text or str(m.get("text") or "").strip()
        if text:
            out.append({"role": "assistant" if m.get("sender") == "assistant" else "user", "content": text, "at": import_at(m.get("created_at"))})
    return {"id": c.get("uuid") or "", "title": c.get("name") or c.get("title") or "", "model": c.get("model") or "",
            "updated": import_at(c.get("updated_at")), "messages": out}


def import_gemini(items):
    """Gemini's activity in Takeout: an entry a question with its answer (safeHtmlItem), no conversation told, so a
    day's entries are one conversation. The question is the title after a word in the account's language ("Prompted …")."""
    import html
    # ponytail: a conversation a day; a Takeout that tells Gemini's conversations would want them instead
    acts = sorted((a for a in items if isinstance(a, dict) and a.get("safeHtmlItem") and "Gemini" in str(a.get("header", "")) + str(a.get("products", ""))),
                  key=lambda a: str(a.get("time", "")))
    heads = [t.split(": ", 1)[0] for t in (str(a.get("title", "")) for a in acts) if ": " in t[:60]]
    lead = max(set(heads), key=heads.count) if heads else ""
    lead = lead + ": " if lead and heads.count(lead) >= max(2, 0.8 * len(acts)) else "\0"      # the same word before most: Takeout's
    days = {}
    for a in acts:
        at = import_at(a.get("time"))
        q = re.sub(r"^Prompted\s+", "", str(a.get("title", "")))
        q = (q[len(lead):] if q.startswith(lead) else q).strip()
        said = "\n".join(str(h.get("html") or "") for h in a["safeHtmlItem"] if isinstance(h, dict))
        said = html.unescape(re.sub(r"<[^>]+>", "", re.sub(r"<br\s*/?>|</(p|li|h\d|div|tr|pre)>", "\n", said, flags=re.I)))
        said = re.sub(r"\n{3,}", "\n\n", said).strip()
        d = days.setdefault(at[:10], {"id": at[:10], "title": q[:80], "model": "", "updated": "", "messages": []})
        d["messages"] += [m for m in ({"role": "user", "content": q, "at": at}, {"role": "assistant", "content": said, "at": at}) if m["content"]]
    return list(days.values())


def import_memory_lines(text, cat="memory"):
    """What an assistant says it remembers, a fact a line as Basic Memory's observations: `- [category] fact (date)`, the
    category from the heading over it (the prompt's Instructions, Identity, Career, Projects, Preferences)."""
    out, block = [], re.search(r"```[^\n]*\n(.*?)```", text, re.S)
    for s in (x.strip() for x in (block.group(1) if block else text).splitlines()):     # the block the prompt asks for, not what is said after it
        if not s.strip("`"):                              # the code block the prompt asks for
            continue
        h = re.fullmatch(r"#{1,6}\s*(.+?)\s*:?|(?:\d+\.\s*)?\*\*(.+?):?\*\*:?|([^\s:\[][^:]{0,38}):", s)
        if h:
            cat = slug(next(g for g in h.groups() if g)).replace("_", "-") or cat
            continue
        s = re.sub(r"^(?:[-*•]|\d+\.)\s+", "", s)
        d = re.match(r"\[(\d{4}-\d{2}-\d{2}|unknown)\]\s*[-–:]?\s*", s)
        fact = (s[d.end():] if d else s).strip()
        if fact:
            out.append("- [%s] %s%s" % (cat, fact, " (%s)" % d.group(1) if d and d.group(1) != "unknown" else ""))
    return out


def import_memory_add(lines, kind, dry=False):
    """Facts into the chosen memory: Basic Memory's note imported/KIND-memory.md, marked with its source; only the lines
    it lacks are added, the old ones never changed (Claude's import-memory: additive only)."""
    engine = chosen(MEMORY_WORD) or "basic"
    if engine != "basic":                                 # ponytail: Basic Memory only; EverOS would take them by its add_memory
        return {"notes": 0, "note": "", "error": "memory-" + engine}
    folder = os.path.join(ai_folder(), "imported")
    if anonymous(folder):
        return {"notes": 0, "note": "", "error": "anonymous"}
    path = os.path.join(folder, kind + "-memory.md")
    try:
        with open(path, encoding="utf-8") as f:
            have = f.read()
    except OSError:
        have = ""
    key = lambda l: re.sub(r"\s*\(\d{4}-\d{2}-\d{2}\)$", "", l).strip().lower()
    known, new = {key(l) for l in have.splitlines()}, []
    for l in lines:
        if key(l) not in known:
            known.add(key(l))
            new.append(l)
    if new and not dry:
        os.makedirs(folder, exist_ok=True)
        name = IMPORT_KINDS[kind]
        head = "" if have else ("---\ntitle: Memory from %s\ntype: note\npermalink: imported/%s-memory\ntags:\n- imported\n- %s\nsource: %s\n---\n\n"
                                "# Memory from %s\n\nWhat %s remembered about the user, imported into LensAI on %s.\n\n## Observations\n"
                                % (name, kind, kind, kind, name, name, now()[:10]))
        with open(path, "a", encoding="utf-8") as f:
            f.write(head + "".join(l + "\n" for l in new))
    return dict({"notes": len(new), "note": path}, **({"lines": new} if dry else {}))


def import_memory(text, kind, dry=False):
    """A pasted "what you remember about me" (latte-ai import-memory); what is past IMPORT_MOST is left, whole lines."""
    cut = len(text) > IMPORT_MOST
    if cut:
        text = text[:IMPORT_MOST].rsplit("\n", 1)[0]
    return dict(import_memory_add(import_memory_lines(text), kind, dry), cut=cut)


def import_export(path, dry=False):
    """An export of ChatGPT, Claude or Gemini into LensAI: {"kind", "new", "updated", "same" (there already, unchanged),
    "notes", "note", "error"}; with dry, nothing written and "titles" what would come. Never from or for an anonymous
    project of agentgram: nothing of it leaves it, nothing comes in."""
    import hashlib
    import zipfile
    if anonymous(os.getcwd()) or anonymous(os.path.abspath(path)):
        return {"error": "anonymous"}
    try:
        files = import_read(path)
    except (OSError, ValueError, zipfile.BadZipFile) as e:
        return {"error": "unreadable", "why": str(e)[:200]}
    convs, memories, projects, kind = [], {}, {}, ""
    for name, data in sorted(files.items()):
        items = data if isinstance(data, list) else [data]
        first = items[0] if items and isinstance(items[0], dict) else {}
        if "mapping" in first:
            kind, convs = "chatgpt", convs + [import_chatgpt(c) for c in items if isinstance(c, dict)]
        elif "chat_messages" in first:
            kind, convs = "claude", convs + [import_claude(c) for c in items if isinstance(c, dict)]
        elif "conversations_memory" in first or "project_memories" in first:
            kind, memories = "claude", first
        elif name == "projects.json":
            projects = {p.get("uuid"): p.get("name") or "" for p in items if isinstance(p, dict)}
        elif any(isinstance(a, dict) and "Gemini" in str(a.get("header", "")) + str(a.get("products", "")) for a in items[:50]):
            kind, convs = "gemini", convs + import_gemini(items)
    if not kind:
        return {"error": "gemini-html" if files.get("html") else "unknown"}
    out = {"kind": kind, "new": 0, "updated": 0, "same": 0, "notes": 0, "note": ""}
    if dry:
        out["titles"] = []
    for c in convs:
        if not c["messages"]:
            continue
        ident = "%s-%s" % (kind, hashlib.sha1(str(c["id"] or c["title"] + c["messages"][0]["at"]).encode()).hexdigest()[:12])
        chat = {"id": ident, "title": c["title"] or c["messages"][0]["content"].splitlines()[0][:80], "provider": kind, "model": c["model"],
                "effort": "", "messages": c["messages"], "usage": {"context": 0, "window": 0, "tokens": 0, "cost": 0},
                "from": "import", "imported": kind, "updated": c["updated"] or c["messages"][-1]["at"] or now()}
        was = load(ident)
        state = "same" if was == chat else "updated" if was else "new"
        out[state] += 1
        if dry:
            out["titles"].append({"title": chat["title"], "at": chat["updated"], "messages": len(chat["messages"]), "state": state})
        elif state != "same":
            keep(chat)
    if not dry and out["new"] + out["updated"]:
        db = index_open()                                  # searchable at once, the meanings behind with the next search
        index_update(db)
        db.close()
    if memories:
        said = memories.get("conversations_memory")
        lines = import_memory_lines(said) if isinstance(said, str) else []
        for ref, t in (memories.get("project_memories") or {}).items():
            if isinstance(t, str):
                lines += import_memory_lines(t, slug("project " + (projects.get(ref) or str(ref)[:8])).replace("_", "-"))
        r = import_memory_add(lines, kind, dry)
        out.update(notes=r["notes"], note=r["note"], **({"memory_error": r["error"]} if r.get("error") else {}), **({"lines": r["lines"]} if dry else {}))
    return out


# ── projects (ROADMAP 10B.72, lensAIplan2.md D1, F2/F3/F8/F13/F16): a project is a folder of the person's, with
# `.latte/projekt.toml` (what it is, its state, where it lives, its lock) and AGENTS.md (what every agent is told there;
# CLAUDE.md beside it points to it, since Claude Code reads that name). The list of them is ~/.config/latteos/projects,
# one folder a line: LensAI and the fork of Agent Chats read the same files, and switched off, Agent Chats loses nothing.
PROJECTS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "projects")
PROJECT_TYPES = ("code", "drawing", "book", "3d", "music", "comic", "other")
PROJECT_STATES = ("active", "paused", "done", "archived")
PROJECT_STORAGE = ("offline", "github", "forgejo")


def project_read(folder):
    """A project's file, with what it does not say filled in; None when the folder is not one."""
    import tomllib
    try:
        with open(os.path.join(folder, ".latte", "projekt.toml"), "rb") as f:
            p = tomllib.load(f)
    except (OSError, ValueError):
        return None
    lock = p.get("lock") if isinstance(p.get("lock"), dict) else {}
    return {"path": folder, "name": str(p.get("name") or os.path.basename(folder)),
            "type": p.get("type") if p.get("type") in PROJECT_TYPES else "other",
            "state": p.get("state") if p.get("state") in PROJECT_STATES else "active",
            "storage": p.get("storage") if p.get("storage") in PROJECT_STORAGE else "offline", "remote": str(p.get("remote") or ""),
            "lock": {"ai": [str(x) for x in lock.get("ai") or []], "memory": lock.get("memory") if lock.get("memory") in ("shared", "separate", "none") else "shared"}}


def project_write(p):
    """The file back, written whole (TOML a person can read and change by hand)."""
    q = lambda v: json.dumps(v, ensure_ascii=False)        # a TOML basic string is JSON's
    text = ("# A project of LatteOS (LensAI › Projects): what it is, its state, where it lives, and which AI may work in it.\n"
            "name = %s\ntype = %s\nstate = %s\nstorage = %s\nremote = %s\n\n[lock]\nai = [%s]\nmemory = %s\n"
            % (q(p["name"]), q(p["type"]), q(p["state"]), q(p["storage"]), q(p["remote"]), ", ".join(map(q, p["lock"]["ai"])), q(p["lock"]["memory"])))
    os.makedirs(os.path.join(p["path"], ".latte"), exist_ok=True)
    with open(os.path.join(p["path"], ".latte", "projekt.toml"), "w") as f:
        f.write(text)


def project_list():
    try:
        with open(PROJECTS) as f:
            return [l.strip() for l in f if l.strip()]
    except OSError:
        return []


def projects():
    """Every project, each with its subprojects (the folders right in it that are projects too)."""
    out = []
    for folder in project_list():
        p = project_read(folder)
        if not p:
            continue
        p["subs"] = [x for x in (project_read(os.path.join(folder, d)) for d in sorted(os.listdir(folder))
                                 if os.path.isdir(os.path.join(folder, d, ".latte"))) if x]
        p["exists"] = True
        out.append(p)
    return out


def project_of(path):
    """The project a folder belongs to, the nearest first (a subproject before its project), or None."""
    path = os.path.realpath(path or "")
    while path and path != "/":
        p = project_read(path)
        if p:
            return p
        path = os.path.dirname(path)
    return None


def slug(name):
    """A folder's name from a project's or a channel's: no accents, small letters, words joined by "_" ("Magna Moravia" →
    magna_moravia, "Wolf's eyes" → wolf_s_eyes); the user, 18. 11.: folder names never carry accented letters."""
    import unicodedata
    plain = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "_", plain.lower()).strip("_") or "project"


def ai_folder(*names):
    """Where the AI keeps what it has of a place (the user, 18. 11.): ~/.local/share/latteAI/lensai for LensAI, and for
    Agent Chats latteAI/agentes/CHANNEL/SUBCHANNEL, each named after its channel (slug); made when first asked for."""
    base = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteAI")
    path = os.path.join(base, "lensai") if not names else os.path.join(base, "agentes", *map(slug, names))
    os.makedirs(path, exist_ok=True)
    return path


# ── which memory LensAI's AIs keep (the user, 20. 11.): Basic Memory (the default), EverOS, or none; latte-mcp asks each
# time. agentgram keeps its own (agentes.chat's), apart from this one.
MEMORY_WORD = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "memory")
EVEROS_ROOT = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteAI", "everos")
EVEROS_PORT = 8792
EVEROS_UNIT = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "systemd", "user", "latte-everos.service")


def memory_engines():
    """The memory chosen and those there are: whether each is installed, and why it cannot run here."""
    on = chosen(MEMORY_WORD) or "basic"
    ev = shutil.which("everos", path=SEARCH) and shutil.which("everos-mcp", path=SEARCH)
    # EverOS's index (LanceDB) is built for processors with AVX2: without it, it stops at its first instruction
    return {"engine": on if on in ("basic", "everos", "off") else "basic",
            "engines": [{"id": "basic", "name": "Basic Memory", "installed": bool(shutil.which("basic-memory", path=SEARCH)),
                         "folder": ai_folder(), "license": "AGPL-3.0"},
                        {"id": "everos", "name": "EverOS", "installed": bool(ev), "folder": EVEROS_ROOT, "license": "Apache-2.0",
                         "cannot": "" if hardware()["avx2"] else "avx2",
                         "running": subprocess.run(["systemctl", "--user", "is-active", "--quiet", "latte-everos"]).returncode == 0}]}


def everos_config():
    """EverOS's settings: its root in latteAI, its server on this computer only, and the AI that reads what is said is the
    local model here (llama.cpp's router), the meanings from e5-sk: nothing leaves the computer."""
    os.makedirs(EVEROS_ROOT, exist_ok=True)
    m, e = quick_model(), embedder()
    if not m:
        return False
    url = "http://127.0.0.1:%d/v1" % LOCAL_PORT
    text = ("[api]\nhost = \"127.0.0.1\"\nport = %d\n\n[llm]\nmodel = \"%s\"\napi_key = \"local\"\nbase_url = \"%s\"\ntimeout_seconds = 300.0\n"
            "response_format_mode = \"json_object\"\n" % (EVEROS_PORT, local_name(m["id"]), url))
    if e:
        # e5-sk-small: 384 numbers a text; a slow local endpoint, one batch at a time
        text += "\n[embedding]\nmodel = \"%s\"\napi_key = \"local\"\nbase_url = \"%s\"\ndim = 384\nbatch_size = 4\nmax_concurrent = 1\n" % (local_name(e), url)
    with open(os.path.join(EVEROS_ROOT, "everos.toml"), "w") as f:
        f.write(text)
    unit = ("[Unit]\nDescription=EverOS, the memory LensAI's AIs keep\n\n[Service]\nEnvironment=EVEROS_ROOT=%s\n"
            "ExecStartPre=-%s memory up\nExecStart=%s server start\nRestart=on-failure\nRestartSec=10\n\n[Install]\nWantedBy=default.target\n"
            % (EVEROS_ROOT, os.path.realpath(sys.argv[0]), shutil.which("everos", path=SEARCH)))
    os.makedirs(os.path.dirname(EVEROS_UNIT), exist_ok=True)
    with open(EVEROS_UNIT, "w") as f:
        f.write(unit)
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    return True


def memory_set(engine):
    """The memory chosen: EverOS's server runs only while it is the one."""
    if engine == "everos":
        s = memory_engines()["engines"][1]
        if not s["installed"] or s["cannot"]:
            return dict(memory_engines(), error="everos-" + (s["cannot"] or "missing"))
        if not everos_config():
            return dict(memory_engines(), error="no-local-model")
    os.makedirs(os.path.dirname(MEMORY_WORD), exist_ok=True)
    with open(MEMORY_WORD, "w") as f:
        f.write(engine + "\n")
    if os.path.exists(EVEROS_UNIT):
        subprocess.run(["systemctl", "--user", "enable" if engine == "everos" else "disable", "--now", "latte-everos"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return memory_engines()


AGENTGRAM = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "agentgram.json")
# ponytail: agentgram runs from its development source until a built one ships with LatteOS (ROADMAP 10B.77)
AGENTGRAM_SRC = os.path.expanduser("~/src/agentes-chat")
AGENTGRAM_LOCAL = {"web": "http://localhost:5173/", "api": "http://127.0.0.1:5173"}      # the built server: API and web on one port
AGENTGRAM_RUNNER = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "agentgram", "runner")
AGENTGRAM_UNIT = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "systemd", "user", "agentgram-runner.service")


def agentgram():
    """agentgram as LensAI › Settings sets it (the user, 19. 11.): off, a server of its own on this computer (local) or
    someone's (remote); the client (this computer's runner) comes on with either. The home identity lends the
    computer's own sign-ins of every AI to the agents (nobody signs in again); another one is a page with a profile
    of its own and no runner here."""
    s = {"on": False, "mode": "local", "server": "", "identity": "home"}
    s.update({k: v for k, v in read_json(AGENTGRAM).items() if k in s})
    local = s["mode"] == "local"
    s["web"] = AGENTGRAM_LOCAL["web"] if local else s["server"]
    s["api"] = AGENTGRAM_LOCAL["api"] if local else s["server"].rstrip("/")
    cfg = read_json(os.path.join(AGENTGRAM_RUNNER, "config.json"))
    s["paired"] = bool(cfg.get("token")) and str(cfg.get("server", "")).rstrip("/") == s["api"].rstrip("/") and s["api"] != ""
    s["client"] = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "agentgram-runner"]).returncode == 0
    return s


def agentgram_apply():
    """Starts and stops what the settings say: the local server, and the runner when the home identity is paired."""
    s = agentgram()
    ctl = lambda *a: subprocess.run(["systemctl", "--user"] + list(a), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # enabled, so it is there after the next login too, as the user turned it on
    if s["on"] and s["mode"] == "local":
        ctl("enable", "--now", "agentgram")
        ctl("start", "latte-mcp")
        # its agents may answer with the models here (Other provider, http://127.0.0.1:8790/v1): the router waits for them,
        # ~100 MB; a model loads when asked and is let go after five idle minutes
        if local_server():
            local_start(None, load=False)
    else:
        ctl("disable", "--now", "agentgram")
    bun = shutil.which("bun", path=SEARCH + os.pathsep + os.path.expanduser("~/.bun/bin"))
    if s["on"] and s["identity"] == "home" and s["paired"] and bun:
        unit = ("[Unit]\nDescription=agentgram client (this computer's runner)\nAfter=network-online.target\n\n[Service]\n"
                "ExecStart=%s %s/apps/server/runner/main.ts start\nEnvironment=AGENTES_RUNNER_HOME=%s\nEnvironment=AGENTES_RUNNER_SERVICE=systemd\n"
                "Environment=LATTEOS_PROJECTS_DIR=%s\n"
                "Environment=PATH=%s\nRestart=always\nRestartSec=5\nRestartPreventExitStatus=0 2 3\nKillMode=process\n\n[Install]\nWantedBy=default.target\n"
                % (bun, AGENTGRAM_SRC, AGENTGRAM_RUNNER, PROJECTS_DIR, os.path.dirname(bun) + os.pathsep + SEARCH))
        old = open(AGENTGRAM_UNIT).read() if os.path.exists(AGENTGRAM_UNIT) else ""
        if old != unit:
            os.makedirs(os.path.dirname(AGENTGRAM_UNIT), exist_ok=True)
            with open(AGENTGRAM_UNIT, "w") as f:
                f.write(unit)
            ctl("daemon-reload")
        ctl("enable", "agentgram-runner")
        ctl("restart" if old != unit else "start", "agentgram-runner")
    else:
        ctl("disable", "--now", "agentgram-runner")


def agentgram_set(key, value):
    allowed = {"on": ("on", "off"), "mode": ("local", "remote"), "identity": ("home", "other")}
    if key == "server":
        if not re.match(r"^https?://[^\s/]+", value):
            return False
    elif value not in allowed.get(key, ()):
        return False
    s = read_json(AGENTGRAM)
    s[key] = value == "on" if key == "on" else value.strip()
    os.makedirs(os.path.dirname(AGENTGRAM), exist_ok=True)
    with open(AGENTGRAM, "w") as f:
        json.dump(s, f)
    agentgram_apply()
    return True


def agentgram_pair(link=""):
    """Connects this computer to the server as agentgram's own runner does (a code confirmed on the server's page): a line
    {"url", "code"} as soon as there is one, then {"ok"}; when it worked, the client starts. With `link` (agentgram's
    "Connect a computer" in LensAI), the code its page made: the person lets it join there."""
    s = agentgram()
    bun = shutil.which("bun", path=SEARCH + os.pathsep + os.path.expanduser("~/.bun/bin"))
    if not bun or not s["api"]:
        print(json.dumps({"ok": False}), flush=True)
        return 1
    p = subprocess.Popen([bun, os.path.join(AGENTGRAM_SRC, "apps/server/runner/main.ts"), "pair", "--server", s["api"],
                          "--home", AGENTGRAM_RUNNER, "--dir", os.path.join(os.path.dirname(ai_folder()), "agentes")]
                         + (["--link", link] if link else []),
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=dict(os.environ, NO_COLOR="1"))
    for line in p.stdout:
        m = re.search(r"https?://\S+[?&]code=([A-Za-z0-9]+)", line)
        if m:
            print(json.dumps({"url": m.group(0), "code": m.group(1)}), flush=True)
    ok = p.wait() == 0
    if ok:
        agentgram_apply()
    print(json.dumps({"ok": ok}), flush=True)
    return 0 if ok else 1


PROJECTS_DIR = os.path.expanduser("~/LensAI/agentgram")   # agentgram's projects' folders, the chats in none in channels/ (the user, 19. 11.)


def agentgram_folder(path):
    """A project's folder of agentgram (agentgram makes it with the project), shown in Files; only one under ~/LensAI/agentgram,
    whatever a page asks for."""
    real = os.path.realpath(os.path.expanduser(path))
    if not real.startswith(os.path.realpath(PROJECTS_DIR) + os.sep):
        return ""
    os.makedirs(real, exist_ok=True)
    return real


def project_new(folder, name, kind, storage):
    folder = os.path.realpath(os.path.expanduser(folder))
    os.makedirs(folder, exist_ok=True)
    p = project_read(folder) or {"path": folder, "name": name, "type": kind, "state": "active", "storage": storage, "remote": "",
                                  "lock": {"ai": [], "memory": "shared"}}
    project_write(p)
    agents = os.path.join(folder, "AGENTS.md")
    if not os.path.exists(agents):
        with open(agents, "w") as f:
            f.write("# %s\n\n%s\n\n## %s\n\n- \n" % (name, T("What every AI working here should know about this project."), T("Rules")))
    if not os.path.exists(os.path.join(folder, "CLAUDE.md")):
        os.symlink("AGENTS.md", os.path.join(folder, "CLAUDE.md"))
    # a subproject is found in its project's folder; only a project of its own goes on the list
    parent = project_of(os.path.dirname(folder))
    if not parent and folder not in project_list():
        os.makedirs(os.path.dirname(PROJECTS), exist_ok=True)
        with open(PROJECTS, "a") as f:
            f.write(folder + "\n")
    return project_read(folder)


# the agents through ACP: its adapter (Apache-2.0, agentclientprotocol), or the tool itself
ACP = {"claude": ["claude-agent-acp"], "chatgpt": ["codex-acp"], "gemini": ["gemini", "--acp"]}
# the sign-in an ACP agent is told to use: Gemini's own setting (an API key, Google's sign-in…); others need none
ACP_AUTH = {"gemini": lambda: (read_json("~/.gemini/settings.json").get("security", {}).get("auth", {}) or {}).get("selectedType", "")}
HELPER = os.path.join(ROOM, "helper")      # a task's lines (latte-acp), one file each: the Helper's conversation


def read_json(path):
    try:
        with open(os.path.expanduser(path)) as f:
            got = json.load(f)
            return got if isinstance(got, dict) else {}
    except (OSError, ValueError):
        return {}


# ── the agents of the ACP Registry (ROADMAP 10B.87; agentclientprotocol/registry, Apache-2.0): its list kept a day (Zed
# looks every hour), each agent installed as Zed installs them (crates/project/src/agent_server_store.rs, GPL-3.0-or-later):
# this platform's binary from its archive, checked against its sha256 (none given: GitHub's digest of the release asset),
# else its npm package (npm install, started with node), else its PyPI package (uv tool install; Zed has no uvx) — each in
# a folder of its own under ACP_HOME, so removing it leaves nothing. Its sign-in is its own, at its first task: never here.
ACP_REGISTRY = "https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json"
ACP_CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "acp")
ACP_HOME = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteos", "acp")
ACP_OF = {"claude": "claude-acp", "chatgpt": "codex-acp", "gemini": "gemini"}       # LatteOS's agents in the registry
ACP_NEEDS = {"binary": [], "npx": ["node", "npm"], "uvx": ["uv"]}
ACP_ID = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")          # an id is a folder's name here
ACP_ARCHIVES = (".zip", ".tar.gz", ".tgz", ".tar.bz2", ".tbz2")
# what the registry does not allow, or Zed cannot unpack: taken for a raw binary, it would be a broken one
ACP_NOT = (".dmg", ".pkg", ".deb", ".rpm", ".msi", ".appimage", ".tar.xz", ".txz", ".tar", ".gz", ".bz2", ".xz", ".7z")


def acp_get(url, timeout=30):
    import urllib.request
    return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "LatteOS"}), timeout=timeout)


def acp_registry(fresh=False):
    """The registry's agents: fetched when asked or a day old, with their icons (as Zed keeps them); offline, the last list."""
    import time
    from concurrent.futures import ThreadPoolExecutor
    path = os.path.join(ACP_CACHE, "registry.json")
    if fresh or not os.path.exists(path) or time.time() - os.path.getmtime(path) > 86400:
        try:
            with acp_get(ACP_REGISTRY) as r:
                raw = r.read()
            got = json.loads(raw)
            if isinstance(got, dict) and isinstance(got.get("agents"), list):
                os.makedirs(os.path.join(ACP_CACHE, "icons"), exist_ok=True)
                with open(path + ".part", "wb") as f:
                    f.write(raw)
                os.replace(path + ".part", path)

                def icon(x):
                    try:
                        with acp_get(x["icon"], 10) as r, open(os.path.join(ACP_CACHE, "icons", x["id"] + ".svg"), "wb") as f:
                            f.write(r.read(65536))
                    except (OSError, KeyError, TypeError):
                        pass
                with ThreadPoolExecutor(8) as pool:
                    list(pool.map(icon, [x for x in got["agents"] if isinstance(x, dict) and ACP_ID.match(str(x.get("id", "")))
                                         and str(x.get("icon", "")).startswith("https://")]))
        except (OSError, ValueError):
            pass
    return [x for x in read_json(path).get("agents") or [] if isinstance(x, dict) and ACP_ID.match(str(x.get("id", "")))]


def acp_platform():
    import platform
    m = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}.get(platform.machine().lower())
    # ponytail: glibc's only (Fedora); a musl system would want linux-*-musl first, as Zed does
    return "linux-" + m if m else ""


def acp_how(x):
    """How an agent is had here, as Zed picks it: ("binary", its target for this platform), else ("npx", …), else ("uvx", …)."""
    d = x.get("distribution") or {}
    t = (d.get("binary") or {}).get(acp_platform())
    if isinstance(t, dict) and t.get("archive") and t.get("cmd"):
        return "binary", t
    for kind in ("npx", "uvx"):
        if isinstance(d.get(kind), dict) and d[kind].get("package"):
            return kind, d[kind]
    return "", {}


def acp_installed():
    """The registry's agents installed here: {id: its agent.json — "name", "version", "kind", "argv", "env", "run"}."""
    out = {}
    for path in glob.glob(os.path.join(ACP_HOME, "*", "agent.json")):
        m, rid = read_json(path), os.path.basename(os.path.dirname(path))
        if ACP_ID.match(rid) and m.get("argv") and os.path.exists(m.get("run", "")):
            out[rid] = m
    return out


def acp_argv(who):
    """How the Helper starts an agent through ACP, (argv, env): its adapter on the PATH, else the one from the registry."""
    if who in ACP and shutil.which(ACP[who][0], path=SEARCH):
        return [shutil.which(x, path=SEARCH) or x for x in ACP[who]], {}
    m = acp_installed().get(ACP_OF.get(who) or (who[4:] if who.startswith("acp:") else ""))
    if not m:
        return None
    return [shutil.which(m["argv"][0], path=SEARCH) or m["argv"][0]] + m["argv"][1:], m.get("env") or {}


def acp_list(fresh=False):
    """Every agent of the registry, the ones the Helper can use first: what it is, how it is installed and what that needs."""
    have, back = acp_installed(), {v: k for k, v in ACP_OF.items()}
    runs = bool(shutil.which("latte-acp", path=SEARCH) and shutil.which("bwrap"))
    out = []
    for x in acp_registry(fresh):
        kind = acp_how(x)[0]
        needs = ACP_NEEDS.get(kind, [])
        doer = back.get(x["id"]) or "acp:" + x["id"]
        try:
            with open(os.path.join(ACP_CACHE, "icons", x["id"] + ".svg")) as f:
                svg = f.read()
        except (OSError, ValueError):
            svg = ""
        out.append({"id": x["id"], "name": str(x.get("name") or x["id"]), "description": str(x.get("description", "")),
                    "version": str(x.get("version", "")), "license": str(x.get("license", "")), "icon": str(x.get("icon", "")), "svg": svg,
                    "url": str(x.get("website") or x.get("repository") or ""), "kind": kind, "needs": needs,
                    "missing": [n for n in needs if not shutil.which(n, path=SEARCH)],
                    "signin": True,        # the registry lists only agents that sign in their own way (AUTHENTICATION.md)
                    "installed": have.get(x["id"], {}).get("version", ""), "doer": doer, "usable": runs and acp_argv(doer) is not None})
    return sorted(out, key=lambda a: (not a["usable"], not a["installed"], a["name"].lower()))


def acp_github_digest(url):
    """GitHub's sha256 of a release asset, for an archive the registry gives none for (as Zed asks for it)."""
    import urllib.parse
    u = urllib.parse.urlparse(url)
    p = u.path.split("/")                       # /OWNER/REPO/releases/download/TAG/ASSET
    if u.netloc != "github.com" or len(p) != 7 or p[3:5] != ["releases", "download"]:
        return ""
    try:
        with acp_get("https://api.github.com/repos/%s/%s/releases/tags/%s" % (p[1], p[2], p[5]), 15) as r:
            got = json.load(r)
    except (OSError, ValueError):
        return ""
    d = next((str(a.get("digest") or "") for a in got.get("assets") or [] if a.get("name") == urllib.parse.unquote(p[6])), "")
    return d[7:] if d.startswith("sha256:") else ""


def acp_unpack(t, into):
    """A binary target: its archive downloaded and checked, unpacked into the folder; the path of its command."""
    import hashlib
    import tarfile
    import urllib.parse
    import zipfile
    cmd, url = str(t["cmd"]), str(t["archive"])
    if not cmd.startswith("./") or ".." in cmd or not url.startswith("https://"):
        raise ValueError("the registry's command or archive is not one LatteOS runs: %s %s" % (cmd, url))
    kind = urllib.parse.urlparse(url).path.lower()
    if kind.endswith(ACP_NOT) and not kind.endswith(ACP_ARCHIVES):
        raise ValueError("an archive LatteOS cannot unpack: " + url)
    file, h = os.path.join(into, ".download"), hashlib.sha256()
    with acp_get(url, 60) as r, open(file, "wb") as f:
        for chunk in iter(lambda: r.read(1 << 20), b""):
            h.update(chunk)
            f.write(chunk)
    want = str(t.get("sha256") or acp_github_digest(url)).lower()
    if want and h.hexdigest() != want:
        raise ValueError("the download is not what the registry says (sha256)")
    run = os.path.join(into, cmd[2:])
    try:
        if kind.endswith(".zip"):
            with zipfile.ZipFile(file) as z:
                for i in z.infolist():
                    got = z.extract(i, into)         # zipfile drops absolute paths and ".."; it keeps no modes: those set here
                    if i.external_attr >> 16 & 0o111 and not i.is_dir():
                        os.chmod(got, 0o755)
        elif kind.endswith(ACP_ARCHIVES):
            with tarfile.open(file) as z:
                z.extractall(into, filter="data")    # nothing outside the folder, no devices, no setuid
    except (tarfile.TarError, zipfile.BadZipFile) as e:
        raise ValueError("the archive did not unpack: %s" % e)
    if not kind.endswith(ACP_ARCHIVES):
        os.makedirs(os.path.dirname(run), exist_ok=True)
        os.replace(file, run)                        # a raw binary, named as its command (Zed: as the URL's last part)
    if os.path.exists(file):
        os.remove(file)
    if not os.path.isfile(run) or not os.path.realpath(run).startswith(os.path.realpath(into) + os.sep):
        raise ValueError("its command is not in what was downloaded: " + cmd)
    os.chmod(run, os.stat(run).st_mode | 0o755)
    return run


def acp_install(rid):
    """One agent of the registry into ACP_HOME/ID, agent.json telling how it starts; "" when it is there, else why not.
    Installed again, the old one goes first (an update)."""
    x = next((x for x in acp_registry() if x["id"] == rid), None)
    kind, t = acp_how(x) if x else ("", {})
    if not kind:
        return "not in the registry for this computer"
    missing = [n for n in ACP_NEEDS[kind] if not shutil.which(n, path=SEARCH)]
    if missing:
        return "needs " + ", ".join(missing)
    home = os.path.join(ACP_HOME, rid)
    shutil.rmtree(home, ignore_errors=True)
    os.makedirs(home)
    env = dict(os.environ, PATH=SEARCH)
    # ponytail: straight into its folder (uv's tools keep absolute paths); an update that fails leaves it uninstalled
    try:
        if kind == "binary":
            run = acp_unpack(t, home)
            argv = [run] + [str(a) for a in t.get("args") or []]
        elif kind == "npx":
            spec = str(t["package"])
            subprocess.run(["npm", "install", "--prefix", home, "--save-exact", "--no-fund", "--no-audit", spec],
                           check=True, capture_output=True, timeout=900, env=env, cwd=home)
            name = spec.rsplit("@", 1)[0] or spec              # @scope/name@1.0 → @scope/name
            pkg = os.path.join(home, "node_modules", name)
            bins = read_json(os.path.join(pkg, "package.json")).get("bin")
            if isinstance(bins, dict):                         # Zed's read_package_executable: the only one, or the named one
                bins = next(iter(bins.values())) if len(bins) == 1 else bins.get(name.rsplit("/", 1)[-1])
            if not isinstance(bins, str):
                raise ValueError("the npm package %s declares no command" % name)
            run = os.path.realpath(os.path.join(pkg, bins))
            argv = ["node", run] + [str(a) for a in t.get("args") or []]
        else:
            spec = str(t["package"])
            subprocess.run(["uv", "tool", "install", spec], check=True, capture_output=True, timeout=900, cwd=home,
                           env=dict(env, UV_TOOL_DIR=os.path.join(home, "tools"), UV_TOOL_BIN_DIR=os.path.join(home, "bin"),
                                    UV_PYTHON_INSTALL_DIR=os.path.join(home, "python")))
            name = re.split(r"[=<>~!\[@ ]", spec, 1)[0]
            found = sorted(os.listdir(os.path.join(home, "bin")))
            run = os.path.join(home, "bin", name if name in found else (found[0] if len(found) == 1 else name))
            if not os.path.exists(run):
                raise ValueError("the PyPI package %s gave no command" % name)
            argv = [run] + [str(a) for a in t.get("args") or []]
        with open(os.path.join(home, "agent.json"), "w") as f:
            json.dump({"id": rid, "name": x.get("name") or rid, "version": x.get("version", ""), "kind": kind, "argv": argv, "run": run,
                       "env": {str(k): str(v) for k, v in (t.get("env") or {}).items()}}, f, ensure_ascii=False)
        return ""
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as e:
        shutil.rmtree(home, ignore_errors=True)
        err = getattr(e, "stderr", None)
        return (err.decode(errors="replace").strip().splitlines() or [str(e)])[-1] if isinstance(err, bytes) and err.strip() else str(e)


def acp_remove(rid):
    home = os.path.join(ACP_HOME, rid)
    if not ACP_ID.match(rid) or not os.path.isdir(home):
        return False
    shutil.rmtree(home)
    return True


def doer_name(who):
    return DOERS[who]["name"] if who in DOERS else acp_installed().get(who[4:], {}).get("name") or who


def helper(most=60):
    """The Helper's conversation, the oldest first: every task an agent did through ACP, with its words, its steps and
    what it asked, and every other entry of the journal (a "Do it" in a terminal, a setting an AI changed)."""
    out, seen = [], set()
    entries = journal_read()
    by_log = {e.get("log"): e for e in entries if e.get("log")}
    for path in sorted(glob.glob(os.path.join(HELPER, "*.jsonl")))[-most:]:
        t = {"log": path, "steps": [], "state": "running"}
        try:
            with open(path) as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        words = ""
        for line in lines:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("t") == "start":
                t.update(agent=d.get("agent", ""), task=d.get("task", ""), dir=d.get("dir", ""))
            elif d.get("t") == "update":
                u = d.get("u") or {}
                kind = u.get("sessionUpdate")
                if kind == "agent_message_chunk":
                    words += (u.get("content") or {}).get("text", "")
                    continue
                if words:
                    t["steps"].append({"kind": "text", "text": words})
                    words = ""
                if kind == "tool_call":
                    t["steps"].append({"kind": "tool", "text": u.get("title", "")})
                elif kind == "plan":
                    t["steps"].append({"kind": "plan", "text": "\n".join(e.get("content", "") for e in u.get("entries") or [])})
            elif d.get("t") == "ask":
                if words:
                    t["steps"].append({"kind": "text", "text": words})
                    words = ""
                t["steps"].append({"kind": "ask", "text": d.get("title", ""), "answer": d.get("answer", "")})
            elif d.get("t") == "turn":
                if words:
                    t["steps"].append({"kind": "text", "text": words})
                    words = ""
                t["state"] = "waiting"                         # its answer is done: the person may go on
            elif d.get("t") == "you":
                t["steps"].append({"kind": "you", "text": d.get("text", "")})
                t["state"] = "running"
            elif d.get("t") == "end":
                t["state"] = "error" if d.get("error") else "done"
                if d.get("error"):
                    t["error"] = d["error"]
        if words:
            t["steps"].append({"kind": "text", "text": words})
        # the task said as it was given, without what LatteOS puts before it
        t["task"] = t.get("task", "").split("The task:", 1)[-1].strip()
        e = by_log.get(path)
        if e:
            t.update(at=e.get("at", ""), n=len(e.get("items") or []) + e.get("more", 0))
            seen.add(path)
        else:
            stamp = os.path.basename(path)[:15]
            t["at"] = "%s-%s-%sT%s:%s:%s" % (stamp[0:4], stamp[4:6], stamp[6:8], stamp[9:11], stamp[11:13], stamp[13:15])
        out.append(t)
    for e in entries:
        if not e.get("log"):
            out.append({"at": e.get("at", ""), "agent": e.get("ai", ""), "app": e.get("app", ""), "task": e.get("task", ""),
                        "dir": e.get("where", ""), "did": e.get("did", ""), "n": len(e.get("items") or []) + e.get("more", 0), "state": "done", "steps": []})
    return sorted(out, key=lambda t: t.get("at", ""))[-most:]


# what an agent never writes, even where the person's files are: what runs at the next login or holds a secret, and
# LatteOS's own rules — a change there could outlive the task without the person seeing it
SEALED = ["~/.ssh", "~/.gnupg", "~/.bashrc", "~/.bash_profile", "~/.profile", "~/.zshrc", "~/.config/autostart", "~/.config/systemd",
          "~/.config/environment.d", "~/.config/pleamar", "~/.config/latteos", "~/.local/share/keyrings", "~/.local/share/applications",
          "~/.local/bin", "~/.local/share/latteos/acp"]          # acp: the agents installed from the ACP Registry


def sandbox(who, work, net):
    """The agent in bubblewrap (as Flatpak and Claude Code's own sandbox-runtime run things; the policy is LatteOS's):
    the system to read; the person's home to write, since every change is asked in LensAI first (the user, 18. 11.: a file
    on the desktop allowed three times and still refused was the read-only home), except what is SEALED; a /tmp of its
    own; no network unless it was allowed. The person's answers and what they allowed are in the session's runtime
    folder, read-only here: an agent cannot allow itself anything."""
    home = os.path.expanduser("~")
    out = [shutil.which("bwrap"), "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--die-with-parent",
           "--bind", home, home]
    for p in [p for p in map(os.path.expanduser, SEALED) if os.path.exists(p)]:
        out += ["--ro-bind", p, p]
    if work and os.path.isdir(work) and not os.path.realpath(work).startswith(home + os.sep):
        out += ["--bind", work, work]          # a task's folder elsewhere (a disk of its own)
    # ponytail: the network is all or nothing (bubblewrap); only the agent's own service would need a proxy (srt's way)
    return out + ([] if net else ["--unshare-net"]) + ["--"]


def do(task, who="", where=""):
    """Starts the agent on the task in a terminal, in its sandbox; who: one of DOERS, else the chosen one. A service's
    agent has the internet (its service is there); it looks on the web only when it asks and the person allows it, as its
    own tool asks (the user, 18. 11.)."""
    can = doers()
    who = who if who in can else (can[0] if can else "")
    if not who:
        return {"ok": False, "agent": ""}
    name = doer_name(who)
    proj = project_of(where) if where else None
    if proj and proj["lock"]["ai"] and who not in proj["lock"]["ai"]:
        notify(T("{n} was not started").replace("{n}", name), T("The project {p} allows only: {a}").replace("{p}", proj["name"]).replace("{a}", ", ".join(proj["lock"]["ai"])))
        return {"ok": False, "agent": who, "locked": True}
    if not shutil.which("bwrap"):
        notify(T("{n} was not started").replace("{n}", name), T("Its sandbox (bubblewrap) is not installed."))
        return {"ok": False, "agent": who, "sandbox": False}
    # ponytail: every agent here is a service's; one with a local model gets no network unless allowed (latte-skill allow net)
    net = True
    here = where if os.path.isdir(where) else os.path.expanduser("~")
    # through ACP when its adapter is here (crates/latte-acp): the work shows in LensAI's Helper, each step it asks for
    # is the person's (ROADMAP 10B.71); else its own tool in a terminal, as before
    acp, extra = acp_argv(who) or ([], {})          # its adapter on the PATH, or one installed from the ACP Registry
    if task.strip() and acp and shutil.which("latte-acp", path=SEARCH):
        os.makedirs(HELPER, exist_ok=True)
        log = os.path.join(HELPER, datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f") + ".jsonl")
        env = dict(dict(os.environ, **extra), PATH=SEARCH, LATTE_ACP_LOG=log, LATTE_ACP_IN=log + ".in", LATTE_APP_NAME=os.environ.get("LATTE_APP_NAME") or "LensAI",
                   LATTE_ACP_AUTH=ACP_AUTH.get(who, lambda: "")())
        subprocess.Popen([shutil.which("latte-acp", path=SEARCH), here, name, ACP_FIRST % language() + task, "--"] + sandbox(who, where, net) + acp,
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=open(log, "w"), stderr=subprocess.DEVNULL, cwd=here, env=env)
        return {"ok": True, "agent": who, "log": log}
    if who not in DOERS:                            # an agent of the registry speaks ACP only: there is no terminal of its own
        return {"ok": False, "agent": who}
    argv = DOERS[who]["argv"](first_words() + task) if task.strip() else DOERS[who]["argv"]("")[:-1]
    argv[0] = shutil.which(argv[0], path=SEARCH) or argv[0]
    journal_add({"app": os.environ.get("LATTE_APP_NAME") or "LensAI", "ai": name, "task": task, "did": T("Handed to the agent"), "where": here})
    subprocess.Popen(["foot", "--title", name, "--working-directory", here, "--"] + sandbox(who, where, net) + argv,
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     env=dict(os.environ, PATH=SEARCH))
    return {"ok": True, "agent": who}


# ── the journal of what the AI changed (ROADMAP 10B.69, the user 18. 11.): every app writes here what an AI did for the
# person — what, where, which AI, the whole list before → after — so that a wrong change can be found and put right.
# A file a month, at most six months and 20 MB in all (the oldest month goes first), at most 10 000 items an entry.
JOURNAL = os.path.join(ROOM, "journal")
JOURNAL_MONTHS, JOURNAL_BYTES, JOURNAL_ITEMS = 6, 20 << 20, 10000


def journal_add(e):
    """One entry: {"app", "ai", "task", "did", "where", "items": [[before, after] or [what]], "undo"}; "at" is added."""
    import time
    e = dict(e, at=datetime.datetime.now().isoformat(timespec="seconds"))
    items = e.get("items") or []
    if len(items) > JOURNAL_ITEMS:
        e["items"], e["more"] = items[:JOURNAL_ITEMS], len(items) - JOURNAL_ITEMS
    os.makedirs(JOURNAL, exist_ok=True)
    with open(os.path.join(JOURNAL, time.strftime("%Y-%m") + ".jsonl"), "a") as f:
        f.write(json.dumps(e, ensure_ascii=False) + "\n")
    months = sorted(glob.glob(os.path.join(JOURNAL, "*.jsonl")))
    while len(months) > 1 and (len(months) > JOURNAL_MONTHS or sum(map(os.path.getsize, months)) > JOURNAL_BYTES):
        os.remove(months.pop(0))
    return e


def journal_read(days=0):
    """The entries, the newest first; `days`: only those of the last days."""
    since = (datetime.datetime.now() - datetime.timedelta(days=days)).isoformat() if days else ""
    out = []
    for path in sorted(glob.glob(os.path.join(JOURNAL, "*.jsonl")), reverse=True):
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("at", "") >= since:
                    out.append(e)
    return sorted(out, key=lambda e: e.get("at", ""), reverse=True)


def journal_md(entries):
    """The journal as Markdown, whole: every item before → after."""
    lines = ["# " + T("What the AI changed"), "", T("Exported {d}").replace("{d}", datetime.datetime.now().strftime("%d. %m. %Y %H:%M")), ""]
    for e in entries:
        lines += ["## %s · %s · %s" % (e.get("at", "").replace("T", " "), e.get("app", ""), e.get("ai", "")), ""]
        lines += [x for x in ("**%s**" % e["did"] if e.get("did") else "", T("Task: {t}").replace("{t}", e["task"]) if e.get("task") else "",
                              T("Where: {w}").replace("{w}", e["where"]) if e.get("where") else "") if x for x in (x, "")]
        for it in e.get("items") or []:
            lines.append("- " + (" → ".join("`%s`" % x for x in it) if isinstance(it, list) else "`%s`" % it))
        if e.get("more"):
            lines.append("- " + T("…and {n} more").replace("{n}", str(e["more"])))
        lines.append("")
    return "\n".join(lines)


def journal_main(a):
    if a[:1] == ["add"] and len(a) == 2:
        try:
            e = json.loads(a[1])
        except ValueError:
            return 2
        print(json.dumps(journal_add(e), ensure_ascii=False))
        return 0
    if len(a) <= 1 and all(x.isdigit() for x in a):
        # for the window: each entry with its first 20 items, the rest counted
        print(json.dumps([dict(e, items=(e.get("items") or [])[:20], more=len(e.get("items") or []) - 20 + e.get("more", 0))
                          if len(e.get("items") or []) > 20 else e for e in journal_read()[:int(a[0]) if a else 200]], ensure_ascii=False))
        return 0
    if a[:1] == ["full"] and len(a) <= 2:
        # every item, for the window of the changes (goo/journal.plm): all, or the one entry of that moment
        print(json.dumps([e for e in journal_read() if len(a) == 1 or e.get("at") == a[1]], ensure_ascii=False))
        return 0
    if a[:1] == ["export"] and len(a) in (2, 3):
        # FILE, or "auto": the Documents folder, LensAI-DATE.md; then all, the last DAYS, or the one entry AT
        path = os.path.expanduser(a[1])
        if a[1] == "auto":
            docs = subprocess.run(["xdg-user-dir", "DOCUMENTS"], capture_output=True, text=True).stdout.strip() if shutil.which("xdg-user-dir") else ""
            path = os.path.join(docs if os.path.isdir(docs) else os.path.expanduser("~"), "LensAI-" + datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S") + ".md")
        which = journal_read(int(a[2]) if len(a) == 3 and a[2].isdigit() else 0)
        if len(a) == 3 and not a[2].isdigit():
            which = [e for e in which if e.get("at") == a[2]]
        with open(path, "w") as f:
            f.write(journal_md(which))
        print(json.dumps({"path": path}))
        return 0
    if a == ["clear"]:
        # the person's deliberate clean-up: the journal alone; what Ctrl+Z can take back stays (latte-files keeps it)
        shutil.rmtree(JOURNAL, ignore_errors=True)
        return 0
    return 2


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "LensAI", title, body], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# the agents' programs as they run: by the name of the program, or of the script node or python runs
AGENT_PROGRAMS = {"claude": "claude", "codex": "chatgpt", "gemini": "gemini", "aider": "aider", "opencode": "opencode", "qwen": "qwen"}
AGENT_NAMES = {"aider": "Aider", "opencode": "opencode", "qwen": "Qwen Code"}
SPINNER = set("✶✻✽✢·*")


def running():
    """The agents at work, each with the terminal window it is in (the window's process is one of its parents)."""
    try:
        clients = json.loads(subprocess.run([shutil.which("hyprctl") or "/usr/share/latteos/pleamarwm/bin/hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        clients = []
    windows = {c.get("pid"): c for c in clients}
    parent, found, cmd = {}, [], {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % d) as f:
                parent[int(d)] = int(f.read().rsplit(")", 1)[1].split()[1])
            with open("/proc/%s/cmdline" % d, "rb") as f:
                argv = [x.decode(errors="replace") for x in f.read().split(b"\0") if x]
        except (OSError, IndexError, ValueError):
            continue
        cmd[int(d)] = " ".join(argv[:3])
        names = [os.path.basename(x) for x in argv[:2]]
        tool = next((AGENT_PROGRAMS[n] for n in names if n in AGENT_PROGRAMS), None)
        if tool and not (names[0] in ("node", "python3", "python", "bun") and len(argv) < 2):
            found.append((int(d), tool))
    out, seen = [], set()
    for pid, tool in found:
        up, window, host = pid, None, ""
        for _ in range(40):
            if up in windows:
                window = windows[up]
                break
            if not host and "vscode-server" in cmd.get(up, ""):
                host = "VS Code"
            up = parent.get(up, 0)
            if up <= 1:
                break
        # one agent is one row: a program that started another of the same kind is the same agent
        key = (tool, window.get("address") if window else pid)
        if key in seen or parent.get(pid) in [p for p, _ in found]:
            continue
        seen.add(key)
        title = (window or {}).get("title", "")
        first = title[:1]
        state = "waiting" if first == "✳" else ("working" if first and (0x2800 <= ord(first) <= 0x28FF or first in SPINNER) else "")
        try:
            where = os.readlink("/proc/%d/cwd" % pid)
        except OSError:
            where = ""
        out.append({"agent": tool, "name": DOERS.get(tool, {}).get("name") or AGENT_NAMES.get(tool, tool), "pid": pid,
                    "title": title.lstrip("✳✶✻✽✢·* " + "".join(chr(c) for c in range(0x2800, 0x2900))).strip(),
                    "where": where, "window": (window or {}).get("address", ""), "state": state, "host": host})
    return out


# ── a crash, and why the session ended: the facts to an agent, which explains and changes nothing (Omarchy's
# diagnose-crash, MIT; GuardCorgi's notice and LatteOS SAFE ask for it)
def crash(pid):
    try:
        found = json.loads(subprocess.run(["coredumpctl", "list", "--json=short", "--no-pager", str(pid)],
                                          capture_output=True, text=True, timeout=20).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        found = []
    c = found[-1] if found else {"exe": "?", "pid": pid, "sig": "?", "time": 0}
    at = datetime.datetime.fromtimestamp((c.get("time") or 0) / 1e6)
    task = ("The program %s (pid %s) crashed on %s with signal %s; systemd-coredump caught it. Find out what happened: "
            "`coredumpctl info %s`, the journal around that moment (`journalctl --since '%s' --until '%s'`), and whose it is "
            "(LatteOS's, Fedora's or an app's: `latte-guardcorgi crashes`). Tell me in plain words what happened, whether it is "
            "worth reporting and to whom, and what I can do. Do not change anything."
            % (c.get("exe"), c.get("pid"), at.strftime("%Y-%m-%d %H:%M:%S"), c.get("sig"), c.get("pid"),
               (at - datetime.timedelta(minutes=2)).strftime("%Y-%m-%d %H:%M:%S"), (at + datetime.timedelta(seconds=30)).strftime("%Y-%m-%d %H:%M:%S")))
    return do(task)


def why():
    task = ("My LatteOS desktop session ended and I am in the SAFE session. Find out why: `latte-safe why` (LatteOS's own "
            "note, and whyd's reading of the journal when it is installed), `journalctl -b -1 -p warning`, "
            "`coredumpctl list --since=-1d`. Tell me in plain words what happened and what I can do; change nothing "
            "without asking me first.")
    return do(task)


def agents():
    """What the services tell of the accounts and what was used, for LensAI's agents panel (Omarchy's, MIT):
    {"services": [{"id", "name", "style", "plan", "signed", "login", "limits": [{"label", "used", "resets"}], "asked"}],
     "stats": {"week", "today", "model", "busiest", "prompts", "sessions"}} — tokens of Claude Code's transcripts."""
    out = []
    for s in services():
        if not s["installed"] or s["local"]:
            continue
        told = {"claude": claude_usage, "chatgpt": chatgpt_usage, "grok": grok_usage, "copilot": copilot_usage}.get(s["id"], dict)() \
            if s["signed"] is not False else {}
        rows = []
        for key, label in (("five_hour", N("Session (5 h)")), ("seven_day", N("Week (7 days)")), ("chat", N("Credits (month)")),
                           ("completions", N("Suggestions in the editor"))):
            if isinstance(told.get(key), dict):
                rows.append({"label": label, "used": told[key].get("used", 0), "resets": told[key].get("resets", 0)})
        for b in told.get("scoped") or []:
            rows.append({"label": N("Week (7 days)") if b["group"] == "weekly" else N("Session (5 h)"), "scope": b["scope"], "used": b["used"], "resets": b["resets"]})
        if isinstance(told.get("credits"), dict):
            c = told["credits"]
            rows.append({"label": N("Credits (week)") if c.get("week") else N("Credits (month)"), "used": c.get("used", 0), "resets": c.get("resets", 0)})
        if isinstance(told.get("promo"), dict):
            rows.append({"label": N("Free credits"), "used": told["promo"]["used"], "resets": told["promo"]["resets"]})
        if isinstance(told.get("extra"), dict):
            e = told["extra"]
            rows.append({"label": N("Extra usage (credits)"), "used": e["used"], "resets": 0, "note": e["note"], "off": e["off"]})
        plan = told.get("plan") or (s["account"].split(" · ")[-1] if " · " in s["account"] else "")
        out.append({"id": s["id"], "name": s["name"], "style": s["style"], "plan": plan, "account": s["account"], "signed": s["signed"],
                    "login": s["login"], "limits": rows, "asked": asked_this_month(s["id"])})
    today = datetime.date.today()
    week = {str(today - datetime.timedelta(days=i)) for i in range(7)}
    by_day, by_model, prompts, sessions = {}, {}, 0, 0
    for f in claude_stats().values():
        touched = False
        for day, models in f["days"].items():
            if day in week:
                for model, n in models.items():
                    by_day[day] = by_day.get(day, 0) + n
                    by_model[model] = by_model.get(model, 0) + n
            touched = touched or day == str(today)
        prompts += f["prompts"].get(str(today), 0)
        sessions += 1 if touched else 0
    stats = {"week": sum(by_day.values()), "today": by_day.get(str(today), 0),
             "model": max(by_model, key=by_model.get) if by_model else "", "busiest": max(by_day, key=by_day.get) if by_day else "",
             "prompts": prompts, "sessions": sessions,
             # the week day by day, the oldest first: the overview draws it
             "days": [{"day": str(today - datetime.timedelta(days=i)), "tokens": by_day.get(str(today - datetime.timedelta(days=i)), 0)} for i in range(6, -1, -1)]}
    can = doers()
    return {"services": out, "stats": stats, "doers": [{"id": i, "name": doer_name(i), "chosen": i == chosen(AGENT_WORD)} for i in can],
            "ideas": IDEAS}


def asked_this_month(provider):
    month = datetime.datetime.now().strftime("%Y-%m")
    n = 0
    for path in glob.glob(os.path.join(CHATS, "*.json")):
        c = load(os.path.basename(path)[:-5]) or {}
        n += sum(1 for m in c.get("messages", []) if m.get("role") == "user" and m.get("provider") == provider and m.get("at", "").startswith(month))
    return n


def grok_models():
    """Asked of the tool once a day: the question takes most of a second, at every opening of LensGoo."""
    cache = os.path.join(ROOM, "models-grok.json")
    try:
        if os.path.getmtime(cache) > datetime.datetime.now().timestamp() - 86400:
            with open(cache) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        out = subprocess.run(["grok", "models"], capture_output=True, text=True, timeout=20, env=dict(os.environ, PATH=SEARCH)).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    found = [l.strip().lstrip("*").split()[0] for l in out.splitlines() if l.startswith("  ") and l.strip()]
    out = [{"id": m, "name": m.replace("grok-", "Grok ")} for m in found]
    if out:
        os.makedirs(ROOM, exist_ok=True)
        with open(cache, "w") as f:
            json.dump(out, f)
    return out


def codex(prompt, model, effort="", files=()):
    # read-only: it may look, never write or run anything that changes the computer; ephemeral: not kept among the user's own
    pictures = [f for f in files if os.path.splitext(f)[1].lower() in (".png", ".jpg", ".jpeg", ".webp", ".gif")]
    others = [f for f in files if f not in pictures]
    if others:
        prompt += "\n\nAttached, in this folder: " + ", ".join(others)
    return ["codex", "exec", "--skip-git-repo-check", "--ephemeral", "--sandbox", "read-only"] + (["-m", model] if model else []) \
        + (["-c", "model_reasoning_effort=" + effort] if effort else []) + sum((["-i", f] for f in pictures), []) + [SYSTEM + "\n\n" + prompt]


def ollama(prompt, model, effort="", files=()):
    return ["ollama", "run", model, SYSTEM + "\n\n" + prompt]


def ollama_models():
    try:
        out = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [{"id": l.split()[0], "name": l.split()[0]} for l in out.splitlines()[1:] if l.strip()]


# how each service's official tool is put on the computer, for this user: by mise where LatteOS's AI layer has it
# (/etc/mise/conf.d/latteos-tools.toml, as Omarchy does), else by the tool's own installer (no password; npm or uv
# come from Fedora, asked for in the terminal, when they are missing)
MISE_TOOLS = {"claude": "claude", "gemini": "gemini-cli", "chatgpt": "codex", "grok": "grok", "copilot": "copilot",
              "mistral": "pipx:mistral-vibe"}
NPM = 'command -v npm >/dev/null || sudo dnf install -y nodejs-npm; npm install -g --prefix "$HOME/.local" '
INSTALL = {
    "claude": "curl -fsSL https://claude.ai/install.sh | bash",
    "gemini": NPM + "@google/gemini-cli",
    "chatgpt": NPM + "@openai/codex",
    "grok": "curl -fsSL https://x.ai/cli/install.sh | bash",
    "mistral": "command -v uv >/dev/null || sudo dnf install -y uv; uv tool install mistral-vibe",
    "copilot": NPM + "@github/copilot",
    "ollama": "sudo dnf install -y ollama",
}

