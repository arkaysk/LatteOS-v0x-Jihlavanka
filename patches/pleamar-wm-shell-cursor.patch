+
+/// A shell that draws the cursor as part of its own scene (`pleamar-wm cursor shell PID [SHAPES]`): the session's
+/// is hidden meanwhile, for the shapes it says it draws. Never over a window that has the whole screen, nor while
+/// the session is locked: the shell is not seen there, and a cursor nobody draws is a mouse that is lost.
+pub fn shell_draws_cursor(shapes: Option<Vec<String>>) {
+    let changed = {
+        let mut now = SHELL_DRAWS.lock().unwrap();
+        let changed = *now != shapes;
+        *now = shapes;
+        changed
+    };
+    if changed {
+        cursor_as_asked();
+    }
+}
+
+/// The shape the session would show: the arrow, a text's beam, an edge to stretch, a hand, or `custom`, a
+/// program's own picture. A shell's cursor replaces the ones it knows: every other says something the shell does
+/// not, and is shown as ever.
+pub fn shell_cursor_shape(name: &'static str) {
+    let changed = {
+        let mut now = SHAPE.lock().unwrap();
+        let changed = now.0 != name;
+        if changed {
+            *now = (name, now.1 + 1);
+        }
+        changed
+    };
+    if changed {
+        cursor_as_asked();
+    }
+}
+
+/// The shape and the count of its changes.
+pub fn cursor_shape() -> (&'static str, u64) {
+    *SHAPE.lock().unwrap()
+}
