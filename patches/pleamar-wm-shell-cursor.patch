+/// The file that says a shell draws the cursor itself (`pleamar-wm cursor shell PID`): it holds that
+/// program's process number, and counts only while that process lives, so a shell that crashes cannot
+/// leave the session without a cursor.
+pub fn shell_cursor_path() -> std::path::PathBuf {
+    let dir = std::env::var("XDG_RUNTIME_DIR").ok().filter(|d| !d.is_empty()).unwrap_or_else(|| "/tmp".into());
+    std::path::PathBuf::from(dir).join("pleamar-wm-shell-cursor")
+}
+
+/// The shapes that program draws itself, if the file names a process that is alive: the words after the process
+/// number (`default text grab ew-resize`…, the names of Wayland's cursor shapes). None after it: the arrow alone.
+pub fn shell_cursor_shapes() -> Option<Vec<String>> {
+    let said = std::fs::read_to_string(shell_cursor_path()).ok()?;
+    let mut words = said.split_whitespace();
+    let pid = words.next()?.parse::<u32>().ok()?;
+    std::path::Path::new(&format!("/proc/{pid}")).exists().then(|| words.map(str::to_owned).collect())
+}
+
+/// Whether that file names a process that is alive.
+pub fn shell_cursor() -> bool {
+    shell_cursor_shapes().is_some()
+}
