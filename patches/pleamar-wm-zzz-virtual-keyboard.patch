+smithay::reexports::wayland_server::delegate_dispatch!(State: [smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::ZwpVirtualKeyboardV1: smithay::wayland::virtual_keyboard::VirtualKeyboardUserData<State>] => VirtualKeyboardManagerState);
+impl Dispatch<smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_manager_v1::ZwpVirtualKeyboardManagerV1, ()> for State {
+    fn request(
+        state: &mut Self,
