+/// The pointer is over a menu of a window or a program's overlay: they lie over the shell, which draws no cursor there (LatteOS).
+static OVER_MENU: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn pointer_over_menu(yes: bool) {
+    if OVER_MENU.swap(yes, std::sync::atomic::Ordering::Relaxed) != yes {
+        cursor_as_asked();
+    }
+}
+
 /// The cursor hidden or shown by what is asked of it now: called again whenever a part of that changes.
 pub fn cursor_as_asked() {
     use std::sync::atomic::Ordering::Relaxed;
     let covered = covered();
     let shape = SHAPE.lock().unwrap().0;
     let drawn = SHELL_DRAWS.lock().unwrap().as_ref().is_some_and(|shapes| shape == "default" || shapes.iter().any(|s| s == shape));
-    let hidden = PROGRAM_HIDES.load(Relaxed) || (drawn && !covered);
+    let hidden = PROGRAM_HIDES.load(Relaxed) || (drawn && !covered && !OVER_MENU.load(Relaxed));
     if HIDDEN_NOW.swap(hidden, Relaxed) == hidden {
         return;
     }
