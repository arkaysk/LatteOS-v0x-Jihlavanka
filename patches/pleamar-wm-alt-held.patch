+        // LatteOS: Alt held too (`keys.alt`), so the shell can carry with Alt what it carries (patches/README.md)
+        if name.starts_with("Alt_") || name == "ISO_Level3_Shift" {
+            let _ = self.to_render.send(ToRender::Fact("keys.alt", if down { 1.0 } else { 0.0 }));
