 #include "efi/fs.h"
 
+#include "efi/system.h"
 #include "lib/memory.h"
 #include "lib/str.h"
 
@@ -60,6 +61,43 @@ int fs_exists(const CHAR16 *path)
     return 1;
 }
 
+EFI_HANDLE fs_find_elsewhere(const CHAR16 *path)
+{
+    EFI_GUID guid = SIMPLE_FILE_SYSTEM_PROTOCOL;
+    EFI_HANDLE *handles = NULL;
+    EFI_HANDLE found = NULL;
+    UINTN count = 0;
+    UINTN i;
+
+    if (BS->LocateHandleBuffer(ByProtocol, &guid, NULL, &count, &handles) != EFI_SUCCESS) {
+        return NULL;
+    }
+
+    for (i = 0; i < count && found == NULL; i++) {
+        EFI_FILE_HANDLE other;
+        EFI_FILE_HANDLE file;
+
+        if (handles[i] == system_device_handle()) {
+            continue;
+        }
+
+        other = LibOpenRoot(handles[i]);
+        if (other == NULL) {
+            continue;
+        }
+
+        if (other->Open(other, &file, (CHAR16 *)path, EFI_FILE_MODE_READ, 0) == EFI_SUCCESS) {
+            file->Close(file);
+            found = handles[i];
+        }
+
+        other->Close(other);
+    }
+
+    FreePool(handles);
+    return found;
+}
+
