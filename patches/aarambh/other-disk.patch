diff --git a/src/boot/image_loader.c b/src/boot/image_loader.c
index 003eff4..72d75b9 100644
--- a/src/boot/image_loader.c
+++ b/src/boot/image_loader.c
@@ -20,7 +20,21 @@ EFI_STATUS image_loader_load(const CHAR16 *path, EFI_HANDLE *child)
 
     buffer = fs_read_path(path, &size);
     if (buffer == NULL) {
-        return EFI_NOT_FOUND;
+        /* Not on this partition: another one's (Windows on its own disk), read and checked by the firmware itself */
+        EFI_HANDLE other = fs_find_elsewhere(path);
+
+        if (other == NULL) {
+            return EFI_NOT_FOUND;
+        }
+
+        device_path = FileDevicePath(other, (CHAR16 *)path);
+        if (device_path == NULL) {
+            return EFI_NOT_FOUND;
+        }
+
+        status = BS->LoadImage(FALSE, system_image_handle(), device_path, NULL, 0, child);
+        FreePool(device_path);
+        return status;
     }
 
     device_path = FileDevicePath(system_device_handle(), (CHAR16 *)path);
