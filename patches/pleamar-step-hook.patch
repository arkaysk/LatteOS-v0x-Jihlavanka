+/// What a program that carries pleamar inside runs once a frame (`provide_step`).
+pub type HostStep = Box<dyn FnMut(f32, &[(&'static str, f32)], &mut [f32]) -> bool + Send>;
+static STEP: std::sync::Mutex<Option<HostStep>> = std::sync::Mutex::new(None);
+
+/// A step of the host's own, once a frame: it gets the seconds since the frame before, the scene's
+/// facts by name (the same order as the values; another slice means another scene was read) and
+/// their values to write, and answers whether its world still moves. While it does the scene keeps
+/// painting; when it does not, the scene rests as any other, and the next frame —a pointer that
+/// moved, a fact the logic set— calls it again. What `provide_windows` is to windows, for motion
+/// that is worked out in Rust: physics with masses and collisions, which a spring cannot say.
+pub fn provide_step(f: HostStep) {
+    *STEP.lock().unwrap() = Some(f);
+}
