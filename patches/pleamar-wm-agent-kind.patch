+/// Which maker an agent's name speaks of, for a shell that dresses each one's
+/// cursor in its own colours (`agent.kind`; a scene cannot look inside a text):
+/// 0 any other, 1 Claude, 2 OpenAI (Codex, ChatGPT, GPT), 3 Gemini, 4 DeepSeek,
+/// 5 Grok, 6 Mistral, 7 Copilot, 8 Marea, 9 Qwen, 10 a local model (llama, ollama).
+pub(crate) fn agent_kind(name: &str) -> f32 {
+    let n = name.to_lowercase();
+    const KINDS: &[(&[&str], f32)] = &[
+        (&["claude", "anthropic"], 1.0),
+        (&["codex", "openai", "chatgpt", "gpt"], 2.0),
+        (&["gemini", "google"], 3.0),
+        (&["deepseek"], 4.0),
+        (&["grok", "xai"], 5.0),
+        (&["mistral", "le chat"], 6.0),
+        (&["copilot"], 7.0),
+        (&["marea"], 8.0),
+        (&["qwen"], 9.0),
+        (&["llama", "ollama", "local"], 10.0),
+    ];
+    KINDS.iter().find(|(words, _)| words.iter().any(|w| n.contains(w))).map_or(0.0, |(_, k)| *k)
+}
+
+#[cfg(test)]
+mod kind_tests {
+    #[test]
+    fn kinds() {
+        assert_eq!(super::agent_kind("Claude Code"), 1.0);
+        assert_eq!(super::agent_kind("codex"), 2.0);
+        assert_eq!(super::agent_kind("Gemini CLI"), 3.0);
+        assert_eq!(super::agent_kind("Marea"), 8.0);
+        assert_eq!(super::agent_kind("agent"), 0.0);
+    }
+}
