+mod select_tests {
+    #[test]
+    fn a_field_chooses_its_stem_or_all_of_it() {
+        super::SELECTS.lock().unwrap().extend([("t_stem", true), ("t_all", false)]);
+        assert_eq!(super::focus_choice("t_stem", "report.final.pdf"), (12, 0));
+        assert_eq!(super::focus_choice("t_stem", ".bashrc"), (7, 0));
+        assert_eq!(super::focus_choice("t_stem", "Makefile"), (8, 0));
+        assert_eq!(super::focus_choice("t_all", "a.txt"), (5, 0));
+        assert_eq!(super::focus_choice("t_none", "a.txt"), (5, 5));
+    }
+}
