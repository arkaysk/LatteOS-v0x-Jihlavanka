diff --git a/src/scene.rs b/src/scene.rs
index f5cbea6..3c1c490 100644
--- a/src/scene.rs
+++ b/src/scene.rs
@@ -2777,6 +2777,21 @@ pub enum ToNest {
 /// process because whoever does the echo —the logic— does not have the scene in front of it.
 pub static SECRETS: std::sync::Mutex<Vec<&'static str>> = std::sync::Mutex::new(Vec::new());
 
+/// The texts whose field chooses part of what it holds when it is focused (`select:`): `all` everything,
+/// `stem` what is before the last dot —a file's name without its ending, as a file manager offers it to rename—.
+/// Unsaid, the cursor goes to the end and nothing is chosen.
+pub static SELECTS: std::sync::Mutex<Vec<(&'static str, bool)>> = std::sync::Mutex::new(Vec::new());
+
+/// Where the cursor and the other end of the choice go when a field holding `t` is focused: (cursor, anchor).
+pub fn focus_choice(name: &str, t: &str) -> (usize, usize) {
+    match SELECTS.lock().unwrap().iter().find(|(n, _)| *n == name).map(|(_, stem)| *stem) {
+        None => (t.len(), t.len()),
+        Some(false) => (t.len(), 0),
+        // a name that starts with its dot (".bashrc") or has none is all stem
+        Some(true) => (t.rfind('.').filter(|&i| i > 0).unwrap_or(t.len()), 0),
+    }
+}
