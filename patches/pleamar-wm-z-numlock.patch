+/// Whether Num Lock is on from the start (LatteOS): unless `PLEAMAR_WM_NUMLOCK=off`.
+pub(crate) fn numlock_at_start() -> bool {
+    std::env::var("PLEAMAR_WM_NUMLOCK").map_or(true, |v| v != "off")
