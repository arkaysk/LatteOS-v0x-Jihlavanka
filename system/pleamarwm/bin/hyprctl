#!/usr/bin/env python3
"""hyprctl for what LatteOS asks of the compositor, answered by pleamar-wm: first on PATH in its session (bin/latte-session),
so the shell and the apps need no change. Windows are told apart by their slot in the scene, as the address 0xN.
Outside that session it is the real one: systemd keeps this PATH after the session has ended."""
import concurrent.futures
import json
import os
import re
import socket
import subprocess
import sys
import time

WM = "wm.sock"
FIELDS = ("title", "app", "screen", "workspace", "minimized", "floating", "fullscreen", "focused")


def say(command):
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.path.join(os.environ["PLEAMAR_SOCKETS"], WM))
        s.sendall(command.encode() + b"\n")
        s.shutdown(socket.SHUT_WR)
        out = b""
        while chunk := s.recv(65536):
            out += chunk
    return out.decode().rstrip("\n")


def many(questions):
    with concurrent.futures.ThreadPoolExecutor(16) as pool:          # one question waits for a frame: together they take one
        return dict(zip(questions, pool.map(lambda q: say("get " + q), questions)))


def monitors():
    out = []
    with open(os.path.join(os.environ["PLEAMAR_SOCKETS"], "desktop")) as f:
        lines = [line.split(" ") for line in f.read().splitlines() if line.startswith("monitor ")]
    shown = many(["win.shown.%d" % i for i in range(len(lines))])
    for i, (_, name, w, h, x, y, mhz, focused, scale) in enumerate(lines):
        ws = int(shown["win.shown.%d" % i] or 1)
        out.append({"id": i, "name": name, "description": name, "make": "", "model": "", "width": int(w), "height": int(h),
                    "refreshRate": int(mhz) / 1000, "x": int(x), "y": int(y), "scale": float(scale), "focused": focused == "1",
                    "transform": 0, "dpmsStatus": True, "mirrorOf": "none", "activeWorkspace": {"id": ws, "name": str(ws)}})
    return out


def clients():
    screens = monitors()
    opened = many(["win.%d.open" % i for i in range(16)])
    slots = [i for i in range(16) if opened["win.%d.open" % i] == "true"]
    facts = many(["win.%d.%s" % (i, k) for i in slots for k in FIELDS])
    places = {int(m[0]): [int(v) for v in m[1:]] for m in re.findall(r"window\s+win\.(\d+)\s.*? at (-?\d+),(-?\d+) (\d+)×(\d+)", say("describe"))}
    out = []
    for i in slots:
        f = {k: facts["win.%d.%s" % (i, k)] for k in FIELDS}
        on = int(f["screen"] or 0)
        at = screens[on] if on < len(screens) else {"x": 0, "y": 0, "activeWorkspace": {"id": 1}}
        ws, away = int(f["workspace"] or 1), f["minimized"] == "true"
        x, y, w, h = places.get(i, [0, 0, 0, 0])
        out.append({"address": "0x%d" % i, "mapped": True, "class": f["app"], "title": f["title"], "pid": 0, "monitor": on,
                    "workspace": {"id": -99 if away else ws, "name": "special:minimized" if away else str(ws)},
                    "visible": not away and ws == at["activeWorkspace"]["id"], "floating": f["floating"] == "true", "pinned": False,
                    "fullscreen": 2 if f["fullscreen"] == "true" else 0, "focusHistoryID": 0 if f["focused"] == "true" else i + 1,
                    "at": [x + at["x"], y + at["y"]], "size": [w, h]})
    return out


def query(what):
    if what == "clients":
        return clients()
    if what == "monitors":
        return monitors()
    if what == "activewindow":
        return next((c for c in clients() if c["focusHistoryID"] == 0), {})
    if what == "activeworkspace":
        return next((m["activeWorkspace"] for m in monitors() if m["focused"]), {"id": 1, "name": "1"})
    return {}


def emits(expr):
    """What an `eval` means as events of the window manager's scene, in order; None: nothing it can do yet."""
    m = re.match(r'latte\.win\.(\w+)\("0x(\d+)"', expr)
    if m:
        what, slot = m.group(1), m.group(2)
        focus = "emit latte_focus " + slot
        if what == "toggle":
            return ["emit window_minimize " + slot] if say("get win.%s.focused" % slot) == "true" else [focus]
        return {"activate": [focus], "restore": [focus], "minimize": ["emit window_minimize " + slot], "maximize": ["emit window_maximize " + slot],
                "close": [focus, "emit close"], "fullscreen": [focus, "emit fullscreen"]}.get(what)
    # the buttons in the header of LatteOS's apps (apps/common/AppWindow.qml): the window with the keyboard
    m = re.match(r"latte\.win\.(minimize|maximize)_active\(\)", expr)
    if m:
        return ["emit " + m.group(1)]
    # its wire button, on a canvas: wiring from it, two clicks (wm/session.plm, `wclick`)
    if expr == "latte.win.wire_active()":
        front = next((c for c in clients() if c["focusHistoryID"] == 0), None)
        return ["emit wire_from " + front["address"][2:]] if front else []
    # the tape glides to the window with the keyboard: scrolling it is going to the next one
    # ponytail: a whole window at a time, not a quarter of the screen as on Hyprland
    m = re.match(r"latte\.win\.(?:cycle|scroll)\((-?\d+)\)", expr)
    if m:
        return ["emit focus_next" if int(m.group(1)) > 0 else "emit focus_previous"]
    return many_windows(expr)


SHOWN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "latte-desk-shown")   # what Win+D put away, to bring back


def many_windows(expr):
    """The keys that act on several windows, as system/hypr/latte/windows.lua does on Hyprland; None: not one of them."""
    m = re.match(r"latte\.(win\.minimize_all\((true|false)\)|win\.restore_all\(\)|win\.nth\((\d+)\)|desk\.show\(\))", expr)
    if not m:
        return None
    shown = [c for c in clients() if c["visible"]]                  # on the desktop one looks at, not put away
    slot = lambda c: c["address"][2:]
    if m.group(1).startswith("win.minimize_all"):
        keep = m.group(2) == "true"
        return ["emit window_minimize " + slot(c) for c in shown if not (keep and c["focusHistoryID"] == 0)]
    if m.group(1) == "win.restore_all()":
        return ["emit latte_focus " + slot(c) for c in clients() if c["workspace"]["name"] == "special:minimized"]
    if m.group(3):
        # Win+1…9: the n-th app of the window bar (goo/lib/bar.luau: in the order they opened, one per app, put away
        # ones too, so the number stays with the app). As on Windows: not in front, its latest window comes; in front,
        # its next window comes, and an app of one window goes away.
        # ponytail: an order the user dragged in the bar is not known here; upgrade: Goo answers the key itself
        apps = {}
        for c in sorted(clients(), key=lambda c: int(slot(c))):
            if c["visible"] or c["workspace"]["name"] == "special:minimized":
                apps.setdefault(c["class"], []).append(c)
        n = int(m.group(3))
        if n > len(apps):
            return []
        group = list(apps.values())[n - 1]
        front = next((i for i, c in enumerate(group) if c["focusHistoryID"] == 0), None)
        if front is None:
            return ["emit latte_focus " + slot(min(group, key=lambda c: c["focusHistoryID"]))]
        if len(group) == 1:
            return ["emit window_minimize " + slot(group[0])]
        return ["emit latte_focus " + slot(group[(front + 1) % len(group)])]
    # Win+D: the desktop, and the same again brings back what it put away (only if nothing came out meanwhile)
    if shown:
        with open(SHOWN, "w") as f:
            f.write(" ".join(slot(c) for c in shown))
        return ["emit window_minimize " + slot(c) for c in shown]
    try:
        with open(SHOWN) as f:
            back = f.read().split()
        os.remove(SHOWN)
    except OSError:
        back = []
    away = {slot(c) for c in clients() if c["workspace"]["name"] == "special:minimized"}   # a slot closed meanwhile may hold another window
    return ["emit latte_focus " + s for s in back if s in away]


ORDER = ("tape", "tiles", "floating", "glance")
# a mode as the scene's facts of a monitor: its layout (5 scrolling, 0 a leader) and whether it is free.
# "glance" is LatteGlance (docs/goo/ROZHODNUTIA.md), nothing of pleamar-wm's that is called a glance.
# ponytail: LatteGlance's windows are free, as on Hyprland, until it is a layout of its own (ROADMAP 8A)
LAYOUT = {"tape": (5, 0), "tiles": (0, 0), "floating": (None, 1), "glance": (None, 1)}
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "window-mode")


def load_modes():
    """The mode of every screen and the ones of a screen's own, in the file Hyprland's session keeps (system/hypr/latte/windows.lua)."""
    try:
        with open(STATE) as f:
            lines = f.read().split("\n")
    except OSError:
        lines = []
    every = lines[0].strip() if lines and lines[0].strip() in ORDER else "tape"
    own = dict(p for p in (line.split() for line in lines[1:]) if len(p) == 2 and p[1] in ORDER)
    return every, own


def save_modes(every, own):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(every + "\n" + "".join("%s %s\n" % p for p in own.items()))


def apply_modes(every, own):
    """Each monitor laid out by its mode, and the Goo scene told the main one's (the one at 0,0, which carries the drops)."""
    for m in monitors():
        lay, free = LAYOUT[own.get(m["name"], every)]
        if lay is not None:
            say("fact lay.%d %d" % (m["id"], lay))
        say("fact free.%d %d" % (m["id"], free))
        if m["x"] == 0 and m["y"] == 0:
            subprocess.Popen(["latte-say", "emit window_mode %d" % ORDER.index(own.get(m["name"], every))], start_new_session=True)


def mode(expr):
    """latte.mode.set / next / tell; False: not one of them."""
    m = re.match(r'latte\.mode\.(set|next|tell)\((?:"(\w+)"(?:,\s*"([^"]+)")?)?\)', expr)
    if not m:
        return False
    every, own = load_modes()
    if m.group(1) == "set" and m.group(2) in ORDER:
        if m.group(3):
            own[m.group(3)] = m.group(2)
        else:
            every, own = m.group(2), {}
    elif m.group(1) == "next":                  # of every screen while they share one, else of the screen one works on
        here = next((s["name"] for s in monitors() if s["focused"]), None) if own else None
        now = own.get(here, every)
        after = ORDER[(ORDER.index(now) + 1) % len(ORDER)]
        if here:
            own[here] = after
        else:
            every = after
    if m.group(1) != "tell":
        save_modes(every, own)
    apply_modes(every, own)
    return True


# The cups' title bars, as system/hypr/latte/bars.lua has them: the bar, its writing; the edge of the window with the keyboard
CUPS = {"espresso": ("261d17", "f3ebdd"), "mocha": ("3e3027", "f6eee2"), "porcelain": ("ebe2d2", "2a170c")}
EDGE = "e4b283"


def cup_colours(name):
    """The bar, its writing and the edge for a cup; "wallpaper": what skwd-wall worked out of it (bin/latte-wall)."""
    if name == "wallpaper":
        try:
            with open(os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "skwd-wall-v2", "colors.json")) as f:
                all = f.read()
            of = lambda k: (re.search(r'"%s"\s*:\s*"#([0-9a-fA-F]{6})"' % k, all) or [None, None])[1]
            if of("surfaceVariant") and of("surfaceText"):
                return of("surfaceVariant"), of("surfaceText"), of("primary") or EDGE
        except OSError:
            pass
        name = "espresso"
    bar, ink = CUPS.get(name, CUPS["espresso"])
    return bar, ink, EDGE


def cup(expr):
    """latte.cup("name") from Settings, latte.cup() from latte-wall and the session's start; False: not that."""
    m = re.match(r'latte\.cup\((?:"(\w+)")?\)', expr)
    if not m:
        return False
    name = m.group(1)
    if not name:
        try:
            with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "cup")) as f:
                name = f.read().strip() or "espresso"
        except OSError:
            name = "espresso"
    for part, colour in zip(("b", "i", "e"), cup_colours(name)):
        for c, k in (("r", 0), ("g", 2), ("b", 4)):
            say("fact cup.%s%s %.3f" % (part, c, int(colour[k:k + 2], 16) / 255))
    subprocess.Popen(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-light" if name == "porcelain" else "prefer-dark"],
                     start_new_session=True)
    return True


def evaluate(expr):
    m = re.search(r"hl\.exec_cmd\((\"|')(.*)\1\)", expr)
    if m:
        subprocess.Popen(["sh", "-c", m.group(2).replace('\\"', '"')], start_new_session=True)
    elif "hl.dsp.exit()" in expr:
        subprocess.run(["pkill", "-TERM", "-x", "pleamar-wm"])
    elif "send_shortcut" in expr:
        slot = re.search(r"address:0x(\d+)", expr)
        if slot:
            say("emit latte_focus " + slot.group(1))
            time.sleep(0.1)
        subprocess.run(["wtype", "-M", "ctrl"] + (["-M", "shift"] if "SHIFT" in expr else []) + ["-k", "v"])
    elif expr.startswith("latte.wallpaper("):
        path = re.search(r'"(.*)"', expr)
        subprocess.Popen(["latte-wall", "set", "*", "picture", path.group(1)] if path else ["latte-wall", "restore"], start_new_session=True)
    elif cup(expr):
        pass
    elif not mode(expr):
        steps = emits(expr)
        if steps is None:           # ponytail: snapping, desks, glass and the band wait for ROADMAP 1D.06 to 1D.09
            print("hyprctl (pleamar-wm): nothing for: " + expr, file=sys.stderr)
        for i, step in enumerate(steps or []):
            if i:
                time.sleep(0.05)    # a rule reads the frame before: `close` has to see the keyboard moved
            say(step)


def main(args):
    args = [a for a in args if a not in ("-q", "--quiet")]
    if args[:1] == ["--batch"]:
        answers = [json.dumps(query(part.strip().removeprefix("j/"))) for part in args[1].split(";")]
        print("\n\n\n".join(answers))
    elif args[:1] == ["eval"]:
        evaluate(args[1])
    elif "-j" in args:
        print(json.dumps(query(next((a for a in args if a != "-j"), ""))))
    elif args[:1] == ["monitors"]:
        subprocess.run(["pleamar-wm", "hyprctl", "monitors"])
    elif args[:1] == ["cursorpos"]:
        with socket.socket(socket.AF_UNIX) as s:
            s.connect(os.path.join(os.environ["PLEAMAR_SOCKETS"], "cursor.sock"))
            x, y = s.makefile().readline().split()[:2]
        print("%d, %d" % (float(x), float(y)))
    else:
        print("hyprctl (pleamar-wm): nothing for: " + " ".join(args), file=sys.stderr)


if __name__ == "__main__":
    if os.environ.get("XDG_CURRENT_DESKTOP") != "pleamar" or not os.environ.get("PLEAMAR_SOCKETS"):
        os.execv("/usr/bin/hyprctl", ["hyprctl"] + sys.argv[1:])
    main(sys.argv[1:])
