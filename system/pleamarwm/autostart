# What pleamar-wm starts with the LatteOS session, one command a line (system/hypr/hyprland.lua does the same on Hyprland).
# pleamar-wm puts its own folder first on PATH, so its hyprctl is put back in front of it where it is asked for.
# systemd and D-Bus learn where the session is; latte-screens starts the target (the Goo scene on the main monitor, the
# portals) and a window bar on every other monitor, again whenever monitors come or go.
sh -c 'export PATH=/usr/share/latteos/pleamarwm/bin:$PATH; dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH QT_WAYLAND_DISABLE_WINDOWDECORATION PLEAMAR_SOCKETS LATTE_MODE LATTE_RENDERER LATTE_TIER LANG; exec latte-screens --watch'
# skwd-walld (the wallpaper) starts with the user, before any session, and stays with the compositor it found first
sh -c 'export PATH=/usr/share/latteos/pleamarwm/bin:$PATH; sleep 1; systemctl --user try-restart skwd-walld; sleep 1; exec latte-wall restore'
PATH=/usr/share/latteos/pleamarwm/bin:$PATH latte-widget start
PATH=/usr/share/latteos/pleamarwm/bin:$PATH latte-nightlight
# The title bars in the colours of the cup the user chose (on Hyprland, system/hypr/hyprland.lua does it as it starts).
sh -c 'export PATH=/usr/share/latteos/pleamarwm/bin:$PATH; sleep 1; exec hyprctl eval "latte.cup()"'
# The lowest tiers move less: the window manager's springs settle at once (on Hyprland, no animations: system/hypr/latte/tiers.lua).
sh -c 'case "${LATTE_TIER:-software}" in minimal|software) sleep 1; exec pleamar-wm --say wm "fact motion.reduced 1" ;; esac'
/usr/libexec/latte-polkit-agent
sh -c 'command -v cliphist >/dev/null || exit; command -v latte-clip >/dev/null && exec wl-paste --watch latte-clip store; exec wl-paste --watch cliphist store'
# Marea, if the user keeps her on the desktop (Settings › Drops › Marea).
latte-marea
latte-boot ok --after 60 --require pleamar
