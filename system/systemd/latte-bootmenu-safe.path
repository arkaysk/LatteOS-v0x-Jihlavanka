# The boot menu's SAFE entry follows the kernels Aarambh lists (system/libexec/latte-bootmenu-safe). Enabled by
# patches/aarambh/setup-latteos.sh when the boot menu is installed.
[Unit]
Description=LatteOS boot menu: keep the SAFE entry's kernels current

[Path]
PathChanged=/boot/efi/EFI/aarambh/fedora.kernels

[Install]
WantedBy=multi-user.target
