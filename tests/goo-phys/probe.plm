        ellipse { at: g.x.5, g.y.5; radius: g.r.5; scale: (1 + g.st.5) * (1 + g.sq.5 * 0.6), (1 - g.sq.5 * 0.6) / (1 + g.st.5); rotate: if(g.st.5 > 0.02, g.rot.5, 0); blend: 18 }
