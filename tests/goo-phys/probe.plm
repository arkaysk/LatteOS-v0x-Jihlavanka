        // drop 0: longer the way it goes, flatter where it met something (the area kept), a tip to the cursor, its thread
        ellipse { at: g.x.0, g.y.0; radius: g.r.0; scale: (1 + g.st.0) * (1 + g.sq.0 * 0.6), (1 - g.sq.0 * 0.6) / (1 + g.st.0); rotate: if(g.st.0 > 0.02, g.rot.0, 0); blend: 18 }
        ellipse { at: g.x.0 + cos(g.tipa.0) * (g.r.0 * 0.7 + g.tip.0), g.y.0 + sin(g.tipa.0) * (g.r.0 * 0.7 + g.tip.0); radius: g.r.0 * 0.3 * (g.tip.0 > 0.5); blend: 22 }
        line { from: j.ax.0, j.ay.0; to: j.bx.0, j.by.0; width: j.w.0 * j.on.0; blend: 14 }
