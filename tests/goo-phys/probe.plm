        ellipse { at: g.x.3 + cos(g.tipa.3) * (g.r.3 * 0.7 + g.tip.3), g.y.3 + sin(g.tipa.3) * (g.r.3 * 0.7 + g.tip.3); radius: g.r.3 * 0.3 * (g.tip.3 > 0.5); blend: 22 }
        line { from: j.ax.3, j.ay.3; to: j.bx.3, j.by.3; width: j.w.3 * j.on.3; blend: 14 }
