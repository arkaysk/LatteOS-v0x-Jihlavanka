        ellipse { at: g.x.1, g.y.1; radius: g.r.1; scale: (1 + g.st.1) * (1 + g.sq.1 * 0.6), (1 - g.sq.1 * 0.6) / (1 + g.st.1); rotate: if(g.st.1 > 0.02, g.rot.1, 0); blend: 18 }
