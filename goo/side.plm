// The Goo of a monitor that is not the main one: BarGoo alone, with the windows of that monitor, as the
// taskbar on a second screen. It is goo.plm's drops and card without what a session has only once (the other
// drops, the lock screen, the notifications); one runs for each such monitor (latte-goo-side@.service).
language 0.4
import "lang/sk.plm"

scene GooSide {
    surface {
        size: full, full
        anchor: bottom
        margin: 0
        level: top
        reserve: -1
        // sixty frames while something moves; a core that pulses on a still desktop needs no more than twenty
        rate: 60, 20 while stir < 0.001 and card.p < 0.01
        keyboard: exclusive while card_open or kb
    }
    permissions {
        run: "latte-sky", "latte-login", "hyprctl", "latte-say", "latte-net", "latte-desktop", "foot", "xdg-open", "latte-app"
        services: "files", "env", "window", "apps", "audio", "clipboard", "clipboard.set"
    }

    event window_mode ->                       // as in goo.plm: Hyprland says how windows are arranged
    event win_menu ->
    text win_asked = ""

    include "parts/drops.plm"
    include "parts/picks.plm"
    include "parts/body.plm"
    include "parts/bubble.plm"
    shader velvet = file "shaders/velvet.wgsl"
    shader pegboard = file "shaders/pegboard.wgsl"
    shader shore = file "shaders/shore.wgsl"
    shader breathe = file "shaders/breathe.wgsl"     // the goo alive at rest (parts/body.plm)
    shader ring = file "shaders/ring.wgsl"          // the ring of a press (parts/cursor.plm)
    include "parts/card.plm"
    include "parts/outline.plm"          // the one outline, over the goo and the card's frame, under what they show
    include "parts/faces.plm"
    include "parts/strip.plm"
    include "parts/launch.plm"
    include "parts/keys.plm"
    include "parts/rows.plm"
    include "parts/desk.plm"
    include "parts/ctx.plm"
    include "parts/cursor.plm"           // last: the cursor is over everything

    // The scene's clock (parts/drops.plm): it runs while the world is stirred, a card is out, the keyboard walks
    // the drops or something asked for a moment of it. At rest it stands: the goo's breath is the graphics card's
    // (shaders/breathe.wgsl), and no number of the scene changes (pleamar still reads it once a frame: about 7 % of a core).
    spin tick by if(stir > 0.001 or buzz > 0.001 or card.p > 0.01 or kb.p > 0.01 or beats, 1, 0)
}
