// The card's frame, its ear, LensShore's plate and the strip it grows from: the shapes of the card's own body
// (card.plm) and, the same ones, of the outline round the whole matter (outline.plm).
part CardFrame {
    // LensShore's panel reaches 40 px into its plate: the two overlap and their sides run straight on, no waist
    box { at: card.ax + card.sx * card.cw / 2, card.ay + card.sy * (card.ch - if(card_lens, 40, 0)) / 2; size: card.cw * if(card.p > 0.02 and not card_dock, 1, 0), card.ch + if(card_lens, 40, 0); corner: if(card_menu, 12, min(if(ear > 14, 26, 18) + (card.round - 18), min(card.cw, card.ch) / 2)) }
    ellipse { at: card.ax + if(card_owner >= 0, own.dx - own.x, 0), card.ay + if(card_owner >= 0, own.dy - own.y, 0); radius: (ear.d * clamp(card.p * 3, 0, 1) + 1) * if(card.p > 0.02 and not card_menu and not card_lens and not card_dock, 1, 0); blend: 4 + 30 * 4 * card.t * (1 - card.t) }
    // LensShore: its plate is part of this body while the panel is out, so the two are one, joined by a fillet
    box { from: lens_a, if(lens_edge == 2, -40, H - 46); size: (lens_b - lens_a) * if(card_lens and card.p > 0.02, 1, 0), 86; corner: 18 }
    line { from: card.bx, card.by; to: card.bx + cap.tx * cap.len * from.dir, card.by + (1 - cap.tx) * cap.len * from.dir; width: ear * 2 * clamp(card.p * 3, 0, 1) * if(cap.len > 0 and card.p > 0.02 and not card_dock, 1, 0); blend: 4 + 30 * 4 * card.t * (1 - card.t) }
}
