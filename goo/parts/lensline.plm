// LensShore's plate and line (goo/lib/lens.luau): a plate of the cards' own glass at the top or the bottom edge, with the
// conversations on the left, the line to type into, and on the right who answers (this computer or a service), the
// microphone and send. Its panel slides out of the plate (parts/card.plm, `card_lens`) and, while it is out, the plate
// is part of the panel's body: one shape. Not a drop: the drops keep off its stretch of the edge (lib/engine.luau).
part LensLine {
    fact lens_typed = false
    fact lens_busy = false                     // the AI is still answering: the conversations pulse
    fact lens_fresh = false                    // an answer came while the card was shut: a dot
    fact lens_agent = false                    // an agent stopped working and waits for the user: a pulsing dot
    fact lens_listening = false                // the microphone is on
    text lens_q = ""
    text lens_hint = ""
    text g_ln_talk = ""                        // glyphs, from the logic
    text g_ln_who = ""
    text g_ln_mic = ""
    text g_send = ""
    text g_ln_home = ""                        // the arrow towards the panel: LensShore's home out, and back
    event lens_press ->                        // the line was pressed: the card grows
    event lens_enter ->                        // Enter in the line: what is chosen in the card (at first: ask the AI)
    event lens_send ->                         // the send button: to the AI
    event lens_home ->                         // the same button with nothing typed: the home out, or back in (6B.27)
    event lens_right ->                        // the right button on the line
    text lens_cur = ""                         // the mode shown, and its glyph: the footer's left side (parts/rows.plm)
    text g_lens_cur = ""
    event lens_quick ->                        // Tab with words in the line: they go to the AI as a question (Raycast's Quick AI)
    event lens_continue ->                     // Ctrl+J: this conversation goes on in LensAI
    on key Tab while card_open and card_lens and tab_asks and not ctx_open and not ap_open { emit lens_quick }
    on key Ctrl+j while card_open and card_lens and not ctx_open and not ap_open { emit lens_continue }
    on change lens_typed { tab_asks = lens_typed or lens_arg }
    on change lens_arg { tab_asks = lens_typed or lens_arg }
    fact lens_arg = false                      // an argument is asked in the line (a quicklink's, or the name and link of a new one): a chip before the field
    text lens_chip = ""
    measure lens_chip_m
    event lens_hist ->                         // 1 older, 0 newer
    event lens_history_clear ->                // from Settings: `latte-say "emit lens_history_clear"`
    event lens_arg_back ->
    event lens_arg_cancel ->
    on key Up while lens_hist_up and not ctx_open and not ap_open { emit lens_hist(1) }
    on key Down while lens_hist_dn and not ctx_open and not ap_open { emit lens_hist(0) }
    on key BackSpace while lens_arg and not lens_typed { emit lens_arg_back }
    on key Escape while lens_arg { emit lens_arg_cancel }
    event lens_talk ->                         // the conversations
    event lens_who ->                          // who answers
    event lens_mic ->                          // the microphone, on or off
    text lens_prev = ""                        // the modes beside the one shown (6B.28): their names at the panel's sides
    text lens_next = ""
    fact lens_has_prev = false
    fact lens_has_next = false
    // the plate: lens_a…lens_b along the top (lens_edge 2) or the bottom edge (0), 46 px deep, as TrayShore's
    let ln.left = lens_a
    let ln.right = lens_b
    let ln.cy = if(lens_edge == 2, 23, H - 23)
    let ln.fx = ln.left + 46                   // the field, between the conversations and the three on the right
    let ln.fw = ln.right - ln.left - 46 - 118
    let ln.ix = ln.fx + 32 + if(lens_arg, min(lens_chip_m.width, 260) + 22, 0)     // where the typing begins: after the chip
    // The tape's edges: at each side of the panel, where there is a mode beside, an arrow and its name turned along the
    // side; a press turns the tape there. Over the list, clear of the strip and the coffee by the line.
    let ln.ey = if(lens_edge == 2, card.y0 + 96, card.y0 + 8)
    let ln.eh = max(card.h - 104, 0)
    group {
        show: lens_shore and card_lens and card_open and card.p > 0.9 and ln.eh > 120
        group {
            show: lens_has_prev
            box { from: lens_a + 2, ln.ey + ln.eh / 2 - 70; size: 20, 140; corner: 10; color: ink; opacity: 4% + 8% * ln_prev.hover }
            text g_back { at: lens_a + 12, ln.ey + ln.eh / 2 - 48; anchor: center; size: 16; color: ink; opacity: 55% + 40% * ln_prev.hover; family: "tabler-icons" }
            group {
                pivot: lens_a + 12, ln.ey + ln.eh / 2 + 12
                rotate: -90deg
                text lens_prev { at: lens_a + 12, ln.ey + ln.eh / 2 + 12; anchor: center; width: 96; lines: 1; size: 11.5; weight: 600; color: ink; opacity: 40% + 45% * ln_prev.hover; family: "Inter" }
            }
            zone box ln_prev { from: lens_a + 2, ln.ey + ln.eh / 2 - 70; size: 20, 140; cursor: pointer; label: "{lens_prev}"; role: button }
            on press ln_prev { emit card_next(0) }
        }
        group {
            show: lens_has_next
            box { from: lens_b - 22, ln.ey + ln.eh / 2 - 70; size: 20, 140; corner: 10; color: ink; opacity: 4% + 8% * ln_next.hover }
            text g_more { at: lens_b - 12, ln.ey + ln.eh / 2 - 48; anchor: center; size: 16; color: ink; opacity: 55% + 40% * ln_next.hover; family: "tabler-icons" }
            group {
                pivot: lens_b - 12, ln.ey + ln.eh / 2 + 12
                rotate: 90deg
                text lens_next { at: lens_b - 12, ln.ey + ln.eh / 2 + 12; anchor: center; width: 96; lines: 1; size: 11.5; weight: 600; color: ink; opacity: 40% + 45% * ln_next.hover; family: "Inter" }
            }
            zone box ln_next { from: lens_b - 22, ln.ey + ln.eh / 2 - 70; size: 20, 140; cursor: pointer; label: "{lens_next}"; role: button }
            on press ln_next { emit card_next(1) }
        }
    }

    // (At rest the plate is a shape of the goo's own body: parts/plates.plm. With the panel out the panel's body holds it.)
    box { from: ln.left + 1.5, if(lens_edge == 2, 0, H - 47); size: ln.right - ln.left - 3, 47; color: coffee; show: lens_shore and card_lens and card.p > 0.02 }
    group {
        show: lens_shore and lens_b > lens_a
        // the conversations: a pulse while the AI answers, a dot when an answer came meanwhile
        ellipse { at: ln.left + 24, ln.cy; radius: 16; color: ink; opacity: 10% * ln_talk.hover }
        text g_ln_talk { at: ln.left + 24, ln.cy; anchor: center; size: 18; color: ink; opacity: if(lens_busy, 55% + 40% * sin(tick * 300), 85%); family: "tabler-icons" }
        ellipse { at: ln.left + 33, ln.cy - 9; radius: 4; color: gold; show: lens_fresh }
        ellipse { at: ln.left + 33, ln.cy + 9; radius: 4; color: gold; opacity: 60% + 40% * sin(tick * 300); show: lens_agent }
        zone box ln_talk { at: ln.left + 24, ln.cy; size: 36, 46; cursor: pointer; label: "Conversations"; role: button }
        on press ln_talk { emit lens_talk }

        // the field
        box { from: ln.fx, ln.cy - 16; size: ln.fw, 32; corner: 16; color: ink; opacity: 7% + 5% * lens_field.hover }
        text g_search { at: ln.fx + 16, ln.cy; anchor: center; size: 15; color: ink; opacity: 60%; family: "tabler-icons" }
        group {
            show: lens_arg
            box { from: ln.fx + 28, ln.cy - 11; size: min(lens_chip_m.width, 260) + 16, 22; corner: 8; color: gold; opacity: 24% }
            text lens_chip { at: ln.fx + 36, ln.cy; anchor: left center; lines: 1; size: 12.5; weight: 600; color: ink; measure: lens_chip_m; family: "Inter" }
        }
        text lens_hint { at: ln.ix, ln.cy; anchor: left center; width: ln.fw - 44 - (ln.ix - ln.fx - 32); lines: 1; size: 15; color: ink; opacity: 55%; show: not lens_typed; family: "Inter" }
        input lens_q { at: ln.ix, ln.cy - 10; width: ln.fw - 44 - (ln.ix - ln.fx - 32); size: 15; color: ink; selection: #5a463a; family: "Inter"; label: "{lens_hint}" }
        zone box lens_field { from: ln.fx, ln.cy - 16; size: ln.fw, 32; cursor: text; label: "LensShore" }
        on press lens_field { focus lens_q; emit lens_press }
        on press right lens_field { tap.x = cursor.x; tap.y = cursor.y; emit lens_right }
        on submit lens_q { emit lens_enter }

        // who answers: a house for this computer, a cloud for a service
        ellipse { at: ln.right - 96, ln.cy; radius: 15; color: ink; opacity: 10% * ln_who.hover }
        text g_ln_who { at: ln.right - 96, ln.cy; anchor: center; size: 16; color: ink; opacity: 60%; family: "tabler-icons" }
        zone box ln_who { at: ln.right - 96, ln.cy; size: 32, 46; cursor: pointer; label: "Who answers"; role: button }
        on press ln_who { tap.x = cursor.x; tap.y = cursor.y; emit lens_who }
        // the microphone: red while it listens
        ellipse { at: ln.right - 60, ln.cy; radius: 15; color: if(lens_listening, #e5484d, ink); opacity: if(lens_listening, 100%, 10% * ln_mic.hover) }
        text g_ln_mic { at: ln.right - 60, ln.cy; anchor: center; size: 16; color: if(lens_listening, #ffffff, ink); opacity: if(lens_listening, 100%, 60%); family: "tabler-icons" }
        zone box ln_mic { at: ln.right - 60, ln.cy; size: 32, 46; cursor: pointer; label: "Microphone"; role: button }
        on press ln_mic { emit lens_mic }
        // send, lit, when there is something to send; with nothing typed the arrow that brings the home out and back
        ellipse { at: ln.right - 24, ln.cy; radius: 15; color: if(lens_typed, gold, ink); opacity: if(lens_typed, 100%, 10% * ln_go.hover) }
        text g_send { at: ln.right - 24, ln.cy; anchor: center; size: 16; color: #2a170c; show: lens_typed; family: "tabler-icons" }
        group {
            show: not lens_typed
            pivot: ln.right - 24, ln.cy
            rotate: if(lens_edge == 2, 180deg, 0deg) + if(card_lens and card_open, 180deg, 0deg)
            text g_ln_home { at: ln.right - 24, ln.cy; anchor: center; size: 16; color: ink; opacity: 60%; family: "tabler-icons" }
        }
        zone box ln_go { at: ln.right - 24, ln.cy; size: 32, 46; cursor: pointer; label: pick(if(lens_typed, 1, 0), "More", "Send"); role: button }
        on press ln_go while lens_typed { emit lens_send }
        on press ln_go while not lens_typed { emit lens_home }
    }

    // ── the footer of the open panel, as Raycast's: the mode on the left; on the right what Enter does and the Actions panel ──
    fact ap_typed = false
    fact ap_h = 0
    fact ap_sel = 0
    text ap_q = ""
    text ap_none = ""
    event ap_pick ->
    event ap_close ->
    model ap max 8 { label: text; glyph: text; danger: bool; line: bool; keys: text; more: bool }
    measure ft_act_m
    measure ft_main_m
    let ft.on = lens_shore and card_lens and card_open and card.p > 0.9
    let ft.cy = card.y0 + card.h - 18
    let ft.r = card.x0 + card.w - 18
    let ft.mx = if(card_more, ft.r - ft_act_m.width - 66, ft.r)
    let ap.w = 330
    let ap.x = card.x0 + card.w - ap.w - 12
    let ap.y = card.y0 + card.h - 40 - ap_h
    group {
        show: ft.on
        box { from: card.x0 + 2, card.y0 + card.h - 36; size: card.w - 4, 34; corner: 14; color: coffee; show: lens_edge == 2 }
        text g_lens_cur { at: card.x0 + 28, ft.cy; anchor: center; size: 15; color: cream; opacity: 70%; family: "tabler-icons" }
        text lens_cur { at: card.x0 + 44, ft.cy; anchor: left center; width: 200; lines: 1; size: 12.5; weight: 600; color: cream; opacity: 75%; family: "Inter" }
        group {
            show: card_main_on
            text card_main { at: ft.mx, ft.cy; anchor: right center; width: 190; lines: 1; size: 12.5; weight: 600; color: cream; opacity: 85%; measure: ft_main_m; family: "Inter" }
            box { from: ft.mx - ft_main_m.width - 36, ft.cy - 10; size: 24, 20; corner: 6; color: cream; opacity: 14% }
            text "↵" { at: ft.mx - ft_main_m.width - 24, ft.cy; anchor: center; size: 13; color: cream; opacity: 85%; family: "Inter" }
        }
        group {
            show: card_more
            zone box ft_actions { from: ft.r - ft_act_m.width - 56, ft.cy - 14; size: ft_act_m.width + 60, 28; cursor: pointer; label: "Actions"; role: button }
            on press ft_actions { tap.x = card.x0 + card.w - ctx_w - 8; tap.y = card.y0 + card.h - 8; emit card_actions }
            box { from: ft.r - ft_act_m.width - 56, ft.cy - 13; size: ft_act_m.width + 56, 26; corner: 8; color: cream; opacity: 14% * ft_actions.hover }
            text "Actions" { at: ft.r - 50, ft.cy; anchor: right center; size: 12.5; weight: 600; color: cream; opacity: 85%; measure: ft_act_m; family: "Inter" }
            box { from: ft.r - 44, ft.cy - 10; size: 44, 20; corner: 6; color: cream; opacity: 14% }
            text "Ctrl+K" { at: ft.r - 22, ft.cy; anchor: center; size: 10.5; weight: 600; color: cream; opacity: 85%; family: "Inter" }
        }
    }

    // ── the Actions panel (lib/actions.luau): over the panel's foot, on the right ──
    zone box ap_away { at: W / 2, H / 2; size: W, H; active: ap_open; label: "Close"; role: button }
    on press ap_away { emit ap_close }
    on press right ap_away { emit ap_close }
    on key Escape while ap_open { emit ap_close }
    on key Ctrl+k while ap_open { emit ap_close }
    on key Down while ap_open { ap_sel = min(ap_sel + 1, ap.count - 1) }
    on key Up while ap_open { ap_sel = max(ap_sel - 1, 0) }
    on submit ap_q { emit ap_pick(ap_sel) }
    spring apsnap = 900, 60
    prop ap.p = 0 ~apsnap
    follow ap.p = if(ap_open, 1, 0)
    group {
        show: ap.p > 0.01
        opacity: clamp(ap.p, 0, 1)
        move: 0, (1 - clamp(ap.p, 0, 1)) * 6
        body {
            color: #2c2019
            rim: 20%
            shadow: 0, 8, 22, 40%
            box { from: ap.x, ap.y; size: ap.w, ap_h; corner: 12 }
        }
        text g_search { at: ap.x + 24, ap.y + 26; anchor: center; size: 15; color: cream; opacity: 60%; family: "tabler-icons" }
        input ap_q { at: ap.x + 44, ap.y + 16; width: ap.w - 60; size: 14; color: cream; selection: #5a463a; family: "Inter"; label: "Search for actions" }
        text "Search for actions…" { at: ap.x + 44, ap.y + 26; anchor: left center; size: 14; color: cream; opacity: 45%; show: not ap_typed; family: "Inter" }
        box { from: ap.x + 10, ap.y + 46; size: ap.w - 20, 1; color: #5a463a }
        text ap_none { at: ap.x + ap.w / 2, ap.y + 76; anchor: center; size: 13; color: cream; opacity: 55%; family: "Inter" }
        column ap_col {
            at: ap.x, ap.y + 52
            padding: 6
            for r in ap { ApRow(r) }
        }
    }

    component ApRow(r: record) {
        size: ap.w - 12, if(r.line, 43, 34)
        box { from: 6, if(r.line, 4, 0); size: ap.w - 24, 1; color: #5a463a; show: r.line }
        box { from: 0, if(r.line, 9, 0); size: ap.w - 12, 34; corner: 8; color: if(r.danger, #e5484d, #4a372b); opacity: max(hit.hover, if(ap_sel == r.index, 1, 0)) * if(r.danger, 22%, 100%) }
        text r.glyph { at: 20, if(r.line, 26, 17); anchor: center; size: 16; color: if(r.danger, #e5484d, cream); opacity: 90%; family: "tabler-icons" }
        text r.label { at: 40, if(r.line, 26, 17); anchor: left center; width: ap.w - 110; lines: 1; size: 13.5; weight: 500; color: if(r.danger, #e5484d, cream); family: "Inter" }
        text r.keys { at: ap.w - 24, if(r.line, 26, 17); anchor: right center; size: 12; color: #b8a491; family: "Inter" }
        text g_more { at: ap.w - 28, if(r.line, 26, 17); anchor: center; size: 14; color: #b8a491; show: r.more; family: "tabler-icons" }
        zone box hit { from: 0, if(r.line, 9, 0); size: ap.w - 12, 34; cursor: pointer; active: ap_open; label: "{r.label}" }
        on press hit { emit ap_pick(r.index) }
    }
}
