// LatteOS GOO: the shell of the desktop. Where a taskbar, a Start button and a clock would be there are drops
// of coffee on the edges of the screen, all of one goo.
//
// The scene is one rule for every drop: a drop is a record the logic fills (lib/engine.luau), and what makes
// two drops differ is the numbers in it. The scene moves and paints them; the logic decides what a press
// does. It covers the whole screen, because a drop may be anywhere; only the zones take the mouse.
//
// Its parts, in the order they are painted:
//   drops    what a drop is: its record, how it moves, what the mouse does to it
//   picks    (written by gen.py) the one drop a card grows from
//   body     the goo: every drop, the edge and the shores' plates as one body; shapes.plm in it is written by gen.py
//   shore    what is on the hard corner at the bottom right: background programs, the network, the volume
//   bubble   a window born of a drop comes in a bubble; a window closed bursts
//   card     the card's state and its frame
//   faces    what each drop shows on itself
//   strip    the performance strip in PowerGoo's capsule
//   launch   the quick-launch strip in QuickGoo's capsule
//   keys     Goo from the keyboard: the keys, and the mark on the drop chosen
//   rows     what is in the card, and the tooltip
//   lock     the lock screen, a surface of its own
//   cursor   the cursor as a drop that changes itself, and the ring of a press, over everything
language 0.4
import "lang/sk.plm"

scene Goo {
    surface {
        size: full, full
        anchor: bottom
        margin: 0
        level: top
        reserve: -1
        // sixty frames while something moves; a core that pulses on a still desktop needs no more than twenty
        rate: 60, 20 while stir < 0.001 and card.p < 0.01
        // An open card is a menu: it has the keyboard until a press elsewhere, so Escape closes it at once
        // and its field is typed into without a press. So has Goo while it is walked with the arrow keys.
        keyboard: exclusive while card_open or kb or cloud_grid
    }
    permissions {
        run: "latte-sky", "latte-skill", "latte-login", "latte-stats", "hyprctl", "foot", "hostname", "id", "cat", "powerprofilesctl", "date", "notify-send", "nmcli", "xdg-open", "xdg-user-dir", "fd", "latte-say", "sh", "latte-cal", "latte-ai", "cliphist", "latte-app", "latte-apps", "latte-devices", "latte-settings", "latte-net", "latte-desktop", "latte-focus", "latte-nameday", "latte-cam", "latte-lock", "qalc", "latte-calc", "wl-paste", "brightnessctl", "wpctl", "bluetoothctl", "pactl", "logger", "latte-nightlight", "latte-weather", "latte-files", "wl-copy", "latte-emoji", "latte-gif", "latte-clip", "gtk-launch", "latte-properties", "latte-linked"
        services: "files", "files.write", "env", "clock", "battery", "window", "apps", "apps.launch", "session.*", "auth", "notifications", "notifications.*", "sound", "audio", "audio.*", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "tray", "tray.*", "clipboard", "clipboard.set", "media", "media.*"
    }

    // ── what the desktop around the scene tells it (`pleamar --say goo "emit …"`) ───────────────────────────
    event window_mode ->                       // Hyprland: how windows are arranged now: 0 tape, 1 tiles, 2 floating
    event win_menu ->                          // the right button on a window's title: the menu of the window `win_asked`
    text win_asked = ""
    event lens_toggle ->                       // the Windows key: the launcher, open or shut
    event lens_clipboard ->                    // Win+V: LensShore's clipboard
    event lens_paste_next ->                   // Win+Shift+V: paste in turn, the next older each press
    event lens_mode ->                         // …or open in one of its modes: 0 apps, 1 files, 2 the web, 3 a command, 4 AI
    event clock_notes ->                       // Win+N: notifications and the calendar
    event clock_time ->                        // Win+Alt+D: the time card
    event quick_toggle ->                      // Win+A: the shore's panel, the quick settings
    // the logic says it is up, last thing when it starts: a scene drawn without it (cut off while the computer was slow
    // to start, 22. 10.) shows no drops, and GuardCorgi asks for this to know it (`pleamar --say goo "get goo_alive"`)
    fact goo_alive = false

    include "parts/drops.plm"
    include "parts/picks.plm"
    include "parts/body.plm"
    include "parts/shore.plm"            // after the body: the plate is the body's, what is on it is drawn over it
    include "parts/cloud.plm"            // AppCloud: the third launcher's plate, and its apps over the whole screen
    include "parts/bubble.plm"
    shader velvet = file "shaders/velvet.wgsl"
    shader pegboard = file "shaders/pegboard.wgsl"
    shader shore = file "shaders/shore.wgsl"
    shader breathe = file "shaders/breathe.wgsl"     // the goo alive at rest (parts/body.plm)
    shader ring = file "shaders/ring.wgsl"          // the ring of a press (parts/cursor.plm)
    include "parts/card.plm"
    include "parts/outline.plm"          // the one outline, over the goo and the card's frame, under what they show
    include "parts/faces.plm"
    include "parts/strip.plm"
    include "parts/launch.plm"
    include "parts/keys.plm"
    include "parts/rows.plm"
    include "parts/lock.plm"
    include "parts/desk.plm"
    include "parts/lensline.plm"           // over the card: the line stays on its capsule while the card grows out of it
    include "parts/ctx.plm"
    include "parts/shoregrab.plm"       // over the plates and what is on them: with Alt held they are carried (6.36)
    include "parts/cursor.plm"           // last: the cursor is over everything

    // The scene's clock (parts/drops.plm): it runs while the world is stirred, a card is out, the keyboard walks
    // the drops or something asked for a moment of it. At rest it stands: the goo's breath is the graphics card's
    // (shaders/breathe.wgsl), and no number of the scene changes (pleamar still reads it once a frame: about 7 % of a core).
    spin tick by if(stir > 0.001 or buzz > 0.001 or card.p > 0.01 or kb.p > 0.01 or beats or lens_busy or lens_agent or breathing, 1, 0)
}
