        line { from: x.17, y.17 - thy0.17; to: thx.17, thy.17; width: th.17 * if(goo.17.sk != 1, 1, 0); blend: 12 * clamp(th.17 / 3, 0, 1) }
        ellipse { at: x.18, floor + 4; radius: rr.18 * 0.5 * base.18 * if(goo.18.sk != 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.18, floor + 6; to: x.18, y.18; width: rr.18 * 2 * stalk.18 * if(goo.18.sk != 1, 1, 0); blend: 14 }
        line { from: x.18, floor + wa.18; to: thx.18, floor + wa.18; width: wa.18 * 2 * if(goo.18.sk != 1, 1, 0); blend: 16 }
        ellipse { at: x.18, y.18; radius: rr.18 * if(goo.18.sk != 1, 1, 0); scale: 1 + fxw.18, 1 - fxw.18; blend: lk.18 + 6 * near.18 }
        line { from: x.18, y.18 - thy0.18; to: thx.18, thy.18; width: th.18 * if(goo.18.sk != 1, 1, 0); blend: 12 * clamp(th.18 / 3, 0, 1) }
        ellipse { at: x.19, floor + 4; radius: rr.19 * 0.5 * base.19 * if(goo.19.sk != 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
