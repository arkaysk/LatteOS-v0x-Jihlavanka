// LatteOS — engine Goo (jadro, skúšobná scéna; relácia „LatteOS Kvapky – engine test“).
// Jedny pravidlá pre všetky kvapky (LATTEOS-GOO.md §2, §3, 3.2): každá kvapka je záznam v modeli `goo` (plní logika,
// lib/engine.luau) a scéna s ňou robí vždy to isté. Kvapky sú vždy káva (pravidlo 6: pomer vody a mlieka z Baristu),
// nemajú tvár (7), sú v jednom goo tele s lištou (§3) — zlievajú sa s ňou aj medzi sebou. Kurzor ich iba PRIŤAHUJE
// (gravitácia, nikdy neodpudzuje) a je ich svetlom: keď sa priblíži, kvapky sa nadnesú od lišty na stopke, nakloní sa
// k nemu a susedné sa pri tom prelievajú; nad kvapkou sa mierne nafúkne a netrpezlivo pulzuje (obsah sa nemení).
// Vlastný pohyb aj bez myši (dych, drift). Lepivosť: ťahaná kvapka sa natiahne a odtrhne; ťažká padne a odrazí sa.
// Čím sa kvapky líšia, sú iba ČÍSLA v zázname (povaha) a háčiky v logike — nie vlastné pravidlá.
// Nová kvapka = záznam (JSON používateľa alebo modul Luau programátora), scéna sa nemení. Pozri README.md.
//
// Rozšírenie pleamar „ako DLC“: iba zdokumentovaný jazyk 0.2 (bez záplat Rustu), aby to prežilo aktualizácie.
// Jazyk nedovolí `repeat` vnútri `body` (zliatie goo) — telo rozpisuje gen.py; ten nastavuje aj počet miest (N).
language 0.2

scene Goo {
    surface {
        size: full, full    // celá obrazovka: kvapka môže byť kdekoľvek; kliky berú iba zóny
        anchor: bottom
        margin: 0
        level: top
        reserve: -1
        rate: 60
    }
    permissions { run: "latte-goo", "date"; services: "clock" }

    // ── káva (pravidlo 6): pomer vody a mlieka z Baristu (~/.config/latteos/kava, číta logika) ──────────────────
    spring jemna = 60, 14
    fact voda = 0
    fact mlieko = 0
    prop v = 0 ~jemna
    prop m = 0 ~jemna
    follow v = voda
    follow m = mlieko
    let coffee = mix(mix(#1c0f09, #4a2410, v), #c9a47a, pow(m, 2))   // rovnako ako plocha Kvapky
    let cream = #f3ebdd
    let ink = mix(#f3ebdd, #2a170c, smooth(0.62, 0.78, m))          // na mliečnej káve tmavé písmo
    let W = screen.width
    let H = screen.height
    let floor = H - 6                          // hladina lišty: kvapky pri nej sa s ňou zlievajú

    // ── kvapky: jeden záznam = jedna kvapka (miesto k). Polia plní logika; čo chýba, má predvolenú hodnotu ─────
    //   on      miesto obsadené            hx, hy   domov: hx podiel šírky obrazovky (0…1), hy výška nad lištou (px);
    //                                               nezávislé od rozlíšenia — logika súradnice obrazovky nepozná
    //   r       polomer (px)               z        veľkosť (koliesko, ak ho kvapka má)   rast  nafúknutie nad ňou
    //   grav    gravitácia kurzora 0…1 (iba priťahuje)   dosah  dokiaľ ju kurzor cíti (px)
    //   vz      nadnesenie pri priblížení kurzora 0…1 (vystúpi od lišty na stopke)
    //   lep     lepivosť 0…1 (pri ťahaní sa drží domova, natiahne sa a až potom odtrhne)  trh  dĺžka odtrhnutia (px)
    //   svetlo  odlesk od kurzora (0…1)    tahat    dá sa ťahať (pravidlo 16: všetky kvapky sú drag & drop)
    //   fx, fa  efekt scény a jeho sila: 0 nič, 1 dych, 2 kmit, 3 tras, 4 obeh, 5 tlkot, 6–9 REZERVA (zatiaľ nič)
    //   e1…e4   REZERVA pre efekty logiky (s pružinou): e1 + veľkosť, e2 / e3 posun x / y (px), e4 žiara okraja
    //   druh    0 ikona + text, 1 ukazovateľ (prstenec podľa `hodnota` 0…1), 2–3 REZERVA
    //   ikona, text  ikona (znak písma Tabler) a text v kvapke (názov a popis sú iba v bubline)
    model goo max 64 {
        on: bool; hx: number; hy: number; r: number = 26; z: number = 1; rast: number = 0.08
        grav: number = 0.3; dosah: number = 220; vz: number = 1; lep: number; trh: number = 90; svetlo: number = 0.5
        tahat: bool = true; fx: number; fa: number = 1; e1: number; e2: number; e3: number; e4: number
        druh: number; hodnota: number; ikona: text; text: text
    }
    spring plava = 150, 13                    // vodorovne: mäkko, bez odskoku
    spring pada = 190, 9                      // zvisle: s prestrelením a odrazom („odkvapne“, §3)
    spring rastie = 260, 16
    spring rezerva = 120, 14                  // kanály e1…e4 (logika ich mení zriedka, pružina to vyhladí)

    // vstupy myši → logika (payload = miesto k; koliesko k * 2 + 1 hore, k * 2 dole)
    event goo_click ->
    event goo_right ->
    event goo_middle ->
    event goo_hold ->
    event goo_scroll ->
    event goo_enter ->
    event goo_leave ->
    event goo_hover ->
    event goo_drag ->
    event goo_drop ->
    event goo_idle ->
    event goo_hop                              // logika → scéna: kvapka k poskočí (hra pri nečinnosti)
    event goo_squish                           // logika → scéna: kvapka k sa stlačí (zrážka, prebudenie)
    fact rx = 0                               // kam bola kvapka pustená (číta logika pri goo_drop): ako hx, hy
    fact ry = 0
    fact nk = -1                              // ťahaná kvapka (krk lepkavej v tele goo), −1 žiadna
    fact idle = 0                             // stupeň nečinnosti (§3.1): 0 aktívny, 1 po 1 min, 2 po 3 min, 3 po 6 min

    // bublina s názvom a popisom (prechod myšou; text plní logika)
    text tip = ""
    fact tipk = -1
    fact tipx = 0
    fact tipy = 0
    prop tip.p = 0 ~rastie
    // ladenie (relácia engine test): posledná udalosť vľavo hore
    text hud = ""
    fact ladenie = false

    repeat k in 0..64 {
        // ťahanie (iba scéna): posun od stlačenia, či už ide o ťahanie (drg) a či sa kvapka odtrhla (tr)
        fact dx.$k = 0
        fact dy.$k = 0
        fact drg.$k = 0
        fact tr.$k = 0
        fact lp.$k = 0                        // stlačené ľavým (klik = pustenie ľavého bez ťahania)
        prop hov.$k = 0 ~rastie
        prop sq.$k = 0 ~pada                  // stlačenie (squish) pri zrážke
        let hxp.$k = goo.$k.hx * W
        let hyp.$k = floor - goo.$k.hy
        let cdx.$k = cursor.x - hxp.$k
        let cdy.$k = cursor.y - hyp.$k
        let cd.$k = max(length(cdx.$k, cdy.$k), 1)
        // blízkosť kurzora 0…1 (smooth() chce stále hranice; dosah je z modelu → vlastná krivka t²(3 − 2t))
        let ct.$k = clamp((cd.$k - goo.$k.r) / max(goo.$k.dosah - goo.$k.r, 1), 0, 1)
        let prox.$k = (1 - ct.$k * ct.$k * (3 - 2 * ct.$k)) * (1 - drg.$k)
        // gravitácia: kurzor kvapku iba priťahuje (nakloní sa k nemu), slabšie čím je lepkavejšia
        let shift.$k = max(0, goo.$k.grav) * prox.$k * (1 - goo.$k.lep * 0.6) * min(cd.$k, goo.$k.dosah) * 0.28
        // nadnesenie: kvapka pri lište vystúpi kolmo od nej (na stopke) — KU kurzoru, najviec po jeho výšku
        // (kurzor pri spodnom okraji ju nezdvihne, inak by mu ušla spod ruky); späť padne s odrazom
        let lup.$k = clamp(hyp.$k - cursor.y + goo.$k.r * 0.3, 0, goo.$k.r * goo.$k.z * 1.1)
        let dk.$k = if(goo.$k.hy < goo.$k.r * 1.6, 1, 0)
        prop lift.$k = 0 ~pada
        follow lift.$k = goo.$k.vz * prox.$k * if(idle > 0, 0.4, 1)
        // lepivosť: kým sa neodtrhne, ide za myšou iba časť cesty (natiahne sa, krk ostane doma)
        let mv.$k = if(tr.$k > 0, 1, 1 - goo.$k.lep * 0.75)
        // vlastný pohyb aj bez myši (§3): dych a pomalý drift; nad kvapkou nafúknutie a netrpezlivé pulzovanie
        let life.$k = 0.012 * sin(time * 60 + k * 53) + hov.$k * (goo.$k.rast + 0.035 * sin(time * 420 + k * 30))
        // efekty scény (bez logiky, plynulo): 1 dych, 2 kmit, 3 tras, 4 obeh, 5 tlkot; 6–9 rezerva
        // (sin a cos sú v stupňoch: time * 120 = 120 °/s)
        let fxs.$k = goo.$k.fa * (if(goo.$k.fx == 1, 0.05 * sin(time * 120 + k * 50), 0) + if(goo.$k.fx == 5, 0.09 * smooth(0.82, 1, sin(time * 315 + k * 50)), 0))
        prop fxw.$k = 0 ~0ms
        follow fxw.$k = goo.$k.fa * if(goo.$k.fx == 2, 0.07 * noise(k * 1.7, time * 1.6), 0) + sq.$k * 0.09
        let fxx.$k = goo.$k.fa * (if(goo.$k.fx == 3, 2.5 * noise(k, time * 18), 0) + if(goo.$k.fx == 4, 4 * cos(time * 80 + k * 40), 0)) + 1.5 * noise(k * 3.1, time * 0.25)
        let fxy.$k = goo.$k.fa * (if(goo.$k.fx == 3, 2.5 * noise(k + 9, time * 18), 0) + if(goo.$k.fx == 4, 4 * sin(time * 80 + k * 40), 0)) + noise(k * 5.7, time * 0.2)
        // rezerva pre logiku (e1…e4), s pružinou
        prop e1.$k = 0 ~rezerva
        prop e2.$k = 0 ~rezerva
        prop e3.$k = 0 ~rezerva
        prop e4.$k = 0 ~rezerva
        follow e1.$k = goo.$k.e1
        follow e2.$k = goo.$k.e2
        follow e3.$k = goo.$k.e3
        follow e4.$k = goo.$k.e4
        // poloha: domov + gravitácia + nadnesenie + ťahanie, s pružinou; zobrazená poloha k tomu pridá efekty
        prop px.$k = 0 ~plava
        prop py.$k = 0 ~pada
        follow px.$k = hxp.$k + cdx.$k / cd.$k * shift.$k + dx.$k * mv.$k
        follow py.$k = hyp.$k + cdy.$k / cd.$k * shift.$k + dy.$k * mv.$k
        // x, y, rr, near, neck, stalk, fxw: pružina ~0ms = tá istá hodnota v tom istom snímku, ale globálna
        // (let vnútri repeat patrí iba svojej kópii; telo goo a odlesky ich potrebujú zvonka)
        prop x.$k = 0 ~0ms
        prop y.$k = 0 ~0ms
        prop rr.$k = 0 ~0ms
        prop near.$k = 0 ~0ms
        prop neck.$k = 0 ~0ms
        prop stalk.$k = 0 ~0ms
        prop lifted.$k = 0 ~0ms
        follow x.$k = px.$k + fxx.$k + e2.$k
        // prázdne miesto pod obrazovku (bez záplaty pleamar-prazdne-tvary by bod nulovej veľkosti cez zliatie vydul hrbček)
        follow y.$k = if(goo.$k.on, py.$k + fxy.$k + e3.$k - lift.$k * lup.$k * dk.$k, H + 400)
        follow rr.$k = goo.$k.r * goo.$k.z * (1 + life.$k + fxs.$k + e1.$k) * if(goo.$k.on, 1, 0)
        follow lifted.$k = lift.$k
        // pri lište sa s ňou zleje (0 = ďaleko, 1 = dotýka sa)
        let nt.$k = clamp((floor - y.$k - rr.$k * 0.6) / (rr.$k * 0.4 + 70), 0, 1)
        follow near.$k = 1 - nt.$k * nt.$k * (3 - 2 * nt.$k)
        // stopka k lište: iba kvapka, ktorá na lište sedí; pri nadnesení sa natiahne a stenčí (§3: vlákna ako sliz)
        follow stalk.$k = dk.$k * (0.55 - 0.25 * lift.$k) * (1 - drg.$k * tr.$k) * if(goo.$k.on, 1, 0)
        // krk: kým lepkavá kvapka drží, spája ju s domovom (zmizne po odtrhnutí)
        follow neck.$k = drg.$k * (1 - tr.$k) * goo.$k.lep * clamp(length(dx.$k, dy.$k) / 30, 0, 1)

        // zóna: kvapka aj jej stopka k lište (nadnesenú kvapku treba trafiť aj pri okraji); pri ťahaní celá obrazovka
        let zh.$k = max(rr.$k * 2, 24) + dk.$k * max(0, floor - y.$k - rr.$k)
        zone box hit.$k { at: if(drg.$k > 0, W / 2, x.$k), if(drg.$k > 0, H / 2, y.$k - max(rr.$k, 12) + zh.$k / 2); size: if(drg.$k > 0, W * 3, max(rr.$k * 2, 24)), if(drg.$k > 0, H * 3, zh.$k); corner: max(rr.$k, 12); cursor: pointer; active: goo.$k.on }
        on enter hit.$k { hov.$k: 1; emit goo_enter(k) }
        on leave hit.$k { hov.$k: 0; emit goo_leave(k) }
        on hover hit.$k for 450ms { tipk = k; tipx = x.$k; tipy = y.$k - rr.$k - 14; tip.p: 1; emit goo_hover(k) }
        on away hit.$k for 200ms while tipk == k { tip.p: 0 }
        on press hit.$k { lp.$k = 1 }
        on press right hit.$k { lp.$k = 0; emit goo_right(k) }
        on press middle hit.$k { lp.$k = 0; emit goo_middle(k) }
        on hold hit.$k for 650ms while drg.$k == 0 and lp.$k == 1 { lp.$k = 0; emit goo_hold(k) }
        on scroll hit.$k { emit goo_scroll(k * 2 + if(wheel > 0, 1, 0)) }
        on drag hit.$k while goo.$k.tahat { dx.$k = drag.dx; dy.$k = drag.dy }
        on drag hit.$k while goo.$k.tahat and drg.$k == 0 and length(drag.dx, drag.dy) > 6 { drg.$k = 1; nk = k; tip.p: 0; emit goo_drag(k) }
        on drag hit.$k while goo.$k.tahat and tr.$k == 0 and length(drag.dx, drag.dy) > goo.$k.trh * goo.$k.lep { tr.$k = 1 }
        // pustenie: bez ťahania = klik; po ťahaní povie logike, kam (neodtrhnutá lepkavá kvapka sa vráti domov)
        on release hit.$k while drg.$k == 0 and lp.$k == 1 { lp.$k = 0; emit goo_click(k) }
        on release hit.$k while drg.$k > 0 { rx = (hxp.$k + dx.$k * mv.$k) / W; ry = floor - (hyp.$k + dy.$k * mv.$k); emit goo_drop(k) }
        on goo_hop(v) while v == k { impulse py.$k -520 }
        on goo_squish(v) while v == k { impulse sq.$k 9 }
    }

    // nečinnosť (§3.1): 1 zaspávajú (menšie nadnesenie), 2 počasie (rezerva), 3 hra; pohyb myši ich hneď zobudí
    on idle for 60s { idle = 1; emit goo_idle(1) }
    on idle for 180s { idle = 2; emit goo_idle(2) }
    on idle for 360s { idle = 3; emit goo_idle(3) }
    on change cursor.x while idle > 0 { idle = 0; emit goo_idle(0) }
    on change cursor.y while idle > 0 { idle = 0; emit goo_idle(0) }

    // ── telo: lišta a všetky kvapky v jednom goo (zliatie) ─────────────────────────────────────────────────────
    body {
        // jedna káva pre lištu aj všetky kvapky (pravidlo 6), jedno svetlo kurzora (§3)
        gradient: radial cursor.x, cursor.y radius 260, mix(coffee, cream, 0.12), coffee
        rim: 28%
        shadow: 0, 5, 14, 35%
        box bar { from: 0, floor; size: W, 40 }
        // >>> telo (gen.py)
        line { from: x.0, floor + 6; to: x.0, y.0; width: rr.0 * 2 * stalk.0; blend: 16 }
        ellipse { at: x.0, y.0; radius: rr.0; scale: 1 + fxw.0, 1 - fxw.0; blend: 12 + 10 * near.0 + 8 * lifted.0 }
        line { from: x.1, floor + 6; to: x.1, y.1; width: rr.1 * 2 * stalk.1; blend: 16 }
        ellipse { at: x.1, y.1; radius: rr.1; scale: 1 + fxw.1, 1 - fxw.1; blend: 12 + 10 * near.1 + 8 * lifted.1 }
        line { from: x.2, floor + 6; to: x.2, y.2; width: rr.2 * 2 * stalk.2; blend: 16 }
        ellipse { at: x.2, y.2; radius: rr.2; scale: 1 + fxw.2, 1 - fxw.2; blend: 12 + 10 * near.2 + 8 * lifted.2 }
        line { from: x.3, floor + 6; to: x.3, y.3; width: rr.3 * 2 * stalk.3; blend: 16 }
        ellipse { at: x.3, y.3; radius: rr.3; scale: 1 + fxw.3, 1 - fxw.3; blend: 12 + 10 * near.3 + 8 * lifted.3 }
        line { from: x.4, floor + 6; to: x.4, y.4; width: rr.4 * 2 * stalk.4; blend: 16 }
        ellipse { at: x.4, y.4; radius: rr.4; scale: 1 + fxw.4, 1 - fxw.4; blend: 12 + 10 * near.4 + 8 * lifted.4 }
        line { from: x.5, floor + 6; to: x.5, y.5; width: rr.5 * 2 * stalk.5; blend: 16 }
        ellipse { at: x.5, y.5; radius: rr.5; scale: 1 + fxw.5, 1 - fxw.5; blend: 12 + 10 * near.5 + 8 * lifted.5 }
        line { from: x.6, floor + 6; to: x.6, y.6; width: rr.6 * 2 * stalk.6; blend: 16 }
        ellipse { at: x.6, y.6; radius: rr.6; scale: 1 + fxw.6, 1 - fxw.6; blend: 12 + 10 * near.6 + 8 * lifted.6 }
        line { from: x.7, floor + 6; to: x.7, y.7; width: rr.7 * 2 * stalk.7; blend: 16 }
        ellipse { at: x.7, y.7; radius: rr.7; scale: 1 + fxw.7, 1 - fxw.7; blend: 12 + 10 * near.7 + 8 * lifted.7 }
        line { from: x.8, floor + 6; to: x.8, y.8; width: rr.8 * 2 * stalk.8; blend: 16 }
        ellipse { at: x.8, y.8; radius: rr.8; scale: 1 + fxw.8, 1 - fxw.8; blend: 12 + 10 * near.8 + 8 * lifted.8 }
        line { from: x.9, floor + 6; to: x.9, y.9; width: rr.9 * 2 * stalk.9; blend: 16 }
        ellipse { at: x.9, y.9; radius: rr.9; scale: 1 + fxw.9, 1 - fxw.9; blend: 12 + 10 * near.9 + 8 * lifted.9 }
        line { from: x.10, floor + 6; to: x.10, y.10; width: rr.10 * 2 * stalk.10; blend: 16 }
        ellipse { at: x.10, y.10; radius: rr.10; scale: 1 + fxw.10, 1 - fxw.10; blend: 12 + 10 * near.10 + 8 * lifted.10 }
        line { from: x.11, floor + 6; to: x.11, y.11; width: rr.11 * 2 * stalk.11; blend: 16 }
        ellipse { at: x.11, y.11; radius: rr.11; scale: 1 + fxw.11, 1 - fxw.11; blend: 12 + 10 * near.11 + 8 * lifted.11 }
        line { from: x.12, floor + 6; to: x.12, y.12; width: rr.12 * 2 * stalk.12; blend: 16 }
        ellipse { at: x.12, y.12; radius: rr.12; scale: 1 + fxw.12, 1 - fxw.12; blend: 12 + 10 * near.12 + 8 * lifted.12 }
        line { from: x.13, floor + 6; to: x.13, y.13; width: rr.13 * 2 * stalk.13; blend: 16 }
        ellipse { at: x.13, y.13; radius: rr.13; scale: 1 + fxw.13, 1 - fxw.13; blend: 12 + 10 * near.13 + 8 * lifted.13 }
        line { from: x.14, floor + 6; to: x.14, y.14; width: rr.14 * 2 * stalk.14; blend: 16 }
        ellipse { at: x.14, y.14; radius: rr.14; scale: 1 + fxw.14, 1 - fxw.14; blend: 12 + 10 * near.14 + 8 * lifted.14 }
        line { from: x.15, floor + 6; to: x.15, y.15; width: rr.15 * 2 * stalk.15; blend: 16 }
        ellipse { at: x.15, y.15; radius: rr.15; scale: 1 + fxw.15, 1 - fxw.15; blend: 12 + 10 * near.15 + 8 * lifted.15 }
        line { from: x.16, floor + 6; to: x.16, y.16; width: rr.16 * 2 * stalk.16; blend: 16 }
        ellipse { at: x.16, y.16; radius: rr.16; scale: 1 + fxw.16, 1 - fxw.16; blend: 12 + 10 * near.16 + 8 * lifted.16 }
        line { from: x.17, floor + 6; to: x.17, y.17; width: rr.17 * 2 * stalk.17; blend: 16 }
        ellipse { at: x.17, y.17; radius: rr.17; scale: 1 + fxw.17, 1 - fxw.17; blend: 12 + 10 * near.17 + 8 * lifted.17 }
        line { from: x.18, floor + 6; to: x.18, y.18; width: rr.18 * 2 * stalk.18; blend: 16 }
        ellipse { at: x.18, y.18; radius: rr.18; scale: 1 + fxw.18, 1 - fxw.18; blend: 12 + 10 * near.18 + 8 * lifted.18 }
        line { from: x.19, floor + 6; to: x.19, y.19; width: rr.19 * 2 * stalk.19; blend: 16 }
        ellipse { at: x.19, y.19; radius: rr.19; scale: 1 + fxw.19, 1 - fxw.19; blend: 12 + 10 * near.19 + 8 * lifted.19 }
        line { from: x.20, floor + 6; to: x.20, y.20; width: rr.20 * 2 * stalk.20; blend: 16 }
        ellipse { at: x.20, y.20; radius: rr.20; scale: 1 + fxw.20, 1 - fxw.20; blend: 12 + 10 * near.20 + 8 * lifted.20 }
        line { from: x.21, floor + 6; to: x.21, y.21; width: rr.21 * 2 * stalk.21; blend: 16 }
        ellipse { at: x.21, y.21; radius: rr.21; scale: 1 + fxw.21, 1 - fxw.21; blend: 12 + 10 * near.21 + 8 * lifted.21 }
        line { from: x.22, floor + 6; to: x.22, y.22; width: rr.22 * 2 * stalk.22; blend: 16 }
        ellipse { at: x.22, y.22; radius: rr.22; scale: 1 + fxw.22, 1 - fxw.22; blend: 12 + 10 * near.22 + 8 * lifted.22 }
        line { from: x.23, floor + 6; to: x.23, y.23; width: rr.23 * 2 * stalk.23; blend: 16 }
        ellipse { at: x.23, y.23; radius: rr.23; scale: 1 + fxw.23, 1 - fxw.23; blend: 12 + 10 * near.23 + 8 * lifted.23 }
        line { from: x.24, floor + 6; to: x.24, y.24; width: rr.24 * 2 * stalk.24; blend: 16 }
