        line { from: x.116, floor + 6; to: x.116, y.116; width: rr.116 * 2 * stalk.116 * if(goo.116.sk >= 1, 1, 0); blend: 14 }
        line { from: x.116, floor + wa.116; to: thx.116, floor + wa.116; width: wa.116 * 2 * if(goo.116.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.116, y.116; radius: rr.116 * if(goo.116.sk >= 1, 1, 0); scale: 1 + fxw.116, 1 - fxw.116; blend: lk.116 + 6 * near.116 }
        line { from: x.116, y.116 - thy0.116; to: thx.116, thy.116; width: th.116 * if(goo.116.sk >= 1, 1, 0); blend: 12 * clamp(th.116 / 3, 0, 1) }
        ellipse { at: x.117, floor + 4; radius: rr.117 * 0.5 * base.117 * if(goo.117.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.117, floor + 6; to: x.117, y.117; width: rr.117 * 2 * stalk.117 * if(goo.117.sk >= 1, 1, 0); blend: 14 }
        line { from: x.117, floor + wa.117; to: thx.117, floor + wa.117; width: wa.117 * 2 * if(goo.117.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.117, y.117; radius: rr.117 * if(goo.117.sk >= 1, 1, 0); scale: 1 + fxw.117, 1 - fxw.117; blend: lk.117 + 6 * near.117 }
        line { from: x.117, y.117 - thy0.117; to: thx.117, thy.117; width: th.117 * if(goo.117.sk >= 1, 1, 0); blend: 12 * clamp(th.117 / 3, 0, 1) }
        ellipse { at: x.118, floor + 4; radius: rr.118 * 0.5 * base.118 * if(goo.118.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.118, floor + 6; to: x.118, y.118; width: rr.118 * 2 * stalk.118 * if(goo.118.sk >= 1, 1, 0); blend: 14 }
        line { from: x.118, floor + wa.118; to: thx.118, floor + wa.118; width: wa.118 * 2 * if(goo.118.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.118, y.118; radius: rr.118 * if(goo.118.sk >= 1, 1, 0); scale: 1 + fxw.118, 1 - fxw.118; blend: lk.118 + 6 * near.118 }
        line { from: x.118, y.118 - thy0.118; to: thx.118, thy.118; width: th.118 * if(goo.118.sk >= 1, 1, 0); blend: 12 * clamp(th.118 / 3, 0, 1) }
        ellipse { at: x.119, floor + 4; radius: rr.119 * 0.5 * base.119 * if(goo.119.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.119, floor + 6; to: x.119, y.119; width: rr.119 * 2 * stalk.119 * if(goo.119.sk >= 1, 1, 0); blend: 14 }
        line { from: x.119, floor + wa.119; to: thx.119, floor + wa.119; width: wa.119 * 2 * if(goo.119.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.119, y.119; radius: rr.119 * if(goo.119.sk >= 1, 1, 0); scale: 1 + fxw.119, 1 - fxw.119; blend: lk.119 + 6 * near.119 }
        line { from: x.119, y.119 - thy0.119; to: thx.119, thy.119; width: th.119 * if(goo.119.sk >= 1, 1, 0); blend: 12 * clamp(th.119 / 3, 0, 1) }
        ellipse { at: x.120, floor + 4; radius: rr.120 * 0.5 * base.120 * if(goo.120.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.120, floor + 6; to: x.120, y.120; width: rr.120 * 2 * stalk.120 * if(goo.120.sk >= 1, 1, 0); blend: 14 }
        line { from: x.120, floor + wa.120; to: thx.120, floor + wa.120; width: wa.120 * 2 * if(goo.120.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.120, y.120; radius: rr.120 * if(goo.120.sk >= 1, 1, 0); scale: 1 + fxw.120, 1 - fxw.120; blend: lk.120 + 6 * near.120 }
        line { from: x.120, y.120 - thy0.120; to: thx.120, thy.120; width: th.120 * if(goo.120.sk >= 1, 1, 0); blend: 12 * clamp(th.120 / 3, 0, 1) }
        ellipse { at: x.121, floor + 4; radius: rr.121 * 0.5 * base.121 * if(goo.121.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.121, floor + 6; to: x.121, y.121; width: rr.121 * 2 * stalk.121 * if(goo.121.sk >= 1, 1, 0); blend: 14 }
        line { from: x.121, floor + wa.121; to: thx.121, floor + wa.121; width: wa.121 * 2 * if(goo.121.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.121, y.121; radius: rr.121 * if(goo.121.sk >= 1, 1, 0); scale: 1 + fxw.121, 1 - fxw.121; blend: lk.121 + 6 * near.121 }
        line { from: x.121, y.121 - thy0.121; to: thx.121, thy.121; width: th.121 * if(goo.121.sk >= 1, 1, 0); blend: 12 * clamp(th.121 / 3, 0, 1) }
        ellipse { at: x.122, floor + 4; radius: rr.122 * 0.5 * base.122 * if(goo.122.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.122, floor + 6; to: x.122, y.122; width: rr.122 * 2 * stalk.122 * if(goo.122.sk >= 1, 1, 0); blend: 14 }
        line { from: x.122, floor + wa.122; to: thx.122, floor + wa.122; width: wa.122 * 2 * if(goo.122.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.122, y.122; radius: rr.122 * if(goo.122.sk >= 1, 1, 0); scale: 1 + fxw.122, 1 - fxw.122; blend: lk.122 + 6 * near.122 }
        line { from: x.122, y.122 - thy0.122; to: thx.122, thy.122; width: th.122 * if(goo.122.sk >= 1, 1, 0); blend: 12 * clamp(th.122 / 3, 0, 1) }
        ellipse { at: x.123, floor + 4; radius: rr.123 * 0.5 * base.123 * if(goo.123.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.123, floor + 6; to: x.123, y.123; width: rr.123 * 2 * stalk.123 * if(goo.123.sk >= 1, 1, 0); blend: 14 }
        line { from: x.123, floor + wa.123; to: thx.123, floor + wa.123; width: wa.123 * 2 * if(goo.123.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.123, y.123; radius: rr.123 * if(goo.123.sk >= 1, 1, 0); scale: 1 + fxw.123, 1 - fxw.123; blend: lk.123 + 6 * near.123 }
        line { from: x.123, y.123 - thy0.123; to: thx.123, thy.123; width: th.123 * if(goo.123.sk >= 1, 1, 0); blend: 12 * clamp(th.123 / 3, 0, 1) }
        ellipse { at: x.124, floor + 4; radius: rr.124 * 0.5 * base.124 * if(goo.124.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.124, floor + 6; to: x.124, y.124; width: rr.124 * 2 * stalk.124 * if(goo.124.sk >= 1, 1, 0); blend: 14 }
        line { from: x.124, floor + wa.124; to: thx.124, floor + wa.124; width: wa.124 * 2 * if(goo.124.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.124, y.124; radius: rr.124 * if(goo.124.sk >= 1, 1, 0); scale: 1 + fxw.124, 1 - fxw.124; blend: lk.124 + 6 * near.124 }
        line { from: x.124, y.124 - thy0.124; to: thx.124, thy.124; width: th.124 * if(goo.124.sk >= 1, 1, 0); blend: 12 * clamp(th.124 / 3, 0, 1) }
        ellipse { at: x.125, floor + 4; radius: rr.125 * 0.5 * base.125 * if(goo.125.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.125, floor + 6; to: x.125, y.125; width: rr.125 * 2 * stalk.125 * if(goo.125.sk >= 1, 1, 0); blend: 14 }
        line { from: x.125, floor + wa.125; to: thx.125, floor + wa.125; width: wa.125 * 2 * if(goo.125.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.125, y.125; radius: rr.125 * if(goo.125.sk >= 1, 1, 0); scale: 1 + fxw.125, 1 - fxw.125; blend: lk.125 + 6 * near.125 }
        line { from: x.125, y.125 - thy0.125; to: thx.125, thy.125; width: th.125 * if(goo.125.sk >= 1, 1, 0); blend: 12 * clamp(th.125 / 3, 0, 1) }
        ellipse { at: x.126, floor + 4; radius: rr.126 * 0.5 * base.126 * if(goo.126.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.126, floor + 6; to: x.126, y.126; width: rr.126 * 2 * stalk.126 * if(goo.126.sk >= 1, 1, 0); blend: 14 }
        line { from: x.126, floor + wa.126; to: thx.126, floor + wa.126; width: wa.126 * 2 * if(goo.126.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.126, y.126; radius: rr.126 * if(goo.126.sk >= 1, 1, 0); scale: 1 + fxw.126, 1 - fxw.126; blend: lk.126 + 6 * near.126 }
        line { from: x.126, y.126 - thy0.126; to: thx.126, thy.126; width: th.126 * if(goo.126.sk >= 1, 1, 0); blend: 12 * clamp(th.126 / 3, 0, 1) }
        ellipse { at: x.127, floor + 4; radius: rr.127 * 0.5 * base.127 * if(goo.127.sk >= 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
        line { from: x.127, floor + 6; to: x.127, y.127; width: rr.127 * 2 * stalk.127 * if(goo.127.sk >= 1, 1, 0); blend: 14 }
        line { from: x.127, floor + wa.127; to: thx.127, floor + wa.127; width: wa.127 * 2 * if(goo.127.sk >= 1, 1, 0); blend: 16 }
        ellipse { at: x.127, y.127; radius: rr.127 * if(goo.127.sk >= 1, 1, 0); scale: 1 + fxw.127, 1 - fxw.127; blend: lk.127 + 6 * near.127 }
        line { from: x.127, y.127 - thy0.127; to: thx.127, thy.127; width: th.127 * if(goo.127.sk >= 1, 1, 0); blend: 12 * clamp(th.127 / 3, 0, 1) }
                // <<< goobar
    }
    // farebné jadro: od stredu prechod z farby do kávy (okraj splynie s kvapkou), predvolene druh upozornenia;
    // vypnuté má nulovú veľkosť (so záplatou nič nestojí)
    repeat k in 0..128 {
        body {
            gradient: radial x.$k, y.$k radius rr.$k * 0.97, if(goo.$k.jf == 0, #e5484d, if(goo.$k.jf == 1, #30a46c, if(goo.$k.jf == 2, #3e63dd, if(goo.$k.jf == 3, #f5a524, if(goo.$k.jf == 4, #ffe8c2, #8e4ec6))))), coffee
            opacity: clamp(jd.$k, 0, 1)
            ellipse { at: x.$k, y.$k; radius: rr.$k * 0.97 * if(jd.$k > 0.02, 1, 0); scale: 1 + fxw.$k, 1 - fxw.$k }
        }
    }
    // odlesky: svetlo kurzora na každej kvapke (bližšie = jasnejšie)
    repeat k in 0..128 {
        let rs.$k = rr.$k / 26                // pomer veľkosti (texty: `size:` = číslo × pomer)
        ellipse { at: x.$k + (cursor.x - x.$k) / max(length(cursor.x - x.$k, cursor.y - y.$k), 1) * rr.$k * 0.45, y.$k + (cursor.y - y.$k) / max(length(cursor.x - x.$k, cursor.y - y.$k), 1) * rr.$k * 0.45; radius: rr.$k * 0.16; scale: 1.4, 0.8; color: cream; opacity: goo.$k.svetlo * (0.25 + 0.5 * clamp(1 - length(cursor.x - x.$k, cursor.y - y.$k) / 420, 0, 1)) }
        // žiara okraja (rezerva e4)
        ellipse { at: x.$k, y.$k; radius: rr.$k + 3; stroke: 2.5 * e4.$k; color: #f7c873; opacity: clamp(e4.$k, 0, 1) }
        // druh 1: ukazovateľ (prstenec podľa hodnoty)
        arc { at: x.$k, y.$k; radius: rr.$k * 0.78; span: clamp(goo.$k.hodnota, 0, 1) * 360deg; rotate: clamp(goo.$k.hodnota, 0, 1) * 180deg; width: max(2, rr.$k * 0.12); color: #f7c873; opacity: if(goo.$k.druh == 1 and goo.$k.on, 0.9, 0) }
        text goo.$k.ikona { at: x.$k, y.$k - if(goo.$k.druh == 1, 0, rr.$k * 0.08); anchor: center; size: 20 * rs.$k; color: ink; opacity: if(goo.$k.on and goo.$k.druh != 2 and not goo.$k.img, 0.92, 0) * (1 - 0.55 * goo.$k.tlm); family: "noctalia-tabler-icons" }
        // ikona aplikácie (okno v Goobari): obrázok podľa mena ikony zo spúšťača; minimalizované okno stlmené
        image obr.$k = from goo.$k.obr, 30, 30
        image obr.$k { at: x.$k - rr.$k * 0.52, y.$k - rr.$k * 0.52; size: rr.$k * 1.04, rr.$k * 1.04; opacity: if(goo.$k.on and goo.$k.img, 1 - 0.55 * goo.$k.tlm, 0); show: goo.$k.img }
        // guľky (pravidlo 15): nad kvapkou na strane od okraja, do 4; pri viac ako 4 posledná väčšia s počtom
        repeat j in 0..4 {
            // farba guľky j: číslica j v osmičkovej sústave poľa gf (každá guľka vlastnú farbu, napr. QueenGoo)
            let gc.$j = floor(goo.$k.gf / pow(8, j)) - 8 * floor(goo.$k.gf / pow(8, j + 1))
            ellipse { at: x.$k + rr.$k * 0.78 - j * 9, y.$k - rr.$k * 0.82 - j * 1.5; radius: if(j == 3 and goo.$k.gn > 4, 7.5, 4.2); color: if(gc.$j == 0, #e5484d, if(gc.$j == 1, #30a46c, if(gc.$j == 2, #3e63dd, if(gc.$j == 3, #f5c518, if(gc.$j == 4, #8a2a22, #ffe8c2))))); opacity: if(goo.$k.on and j < goo.$k.gn, 0.95, 0); show: goo.$k.gn > j }
        }
        text goo.$k.gt { at: x.$k + rr.$k * 0.78 - 27, y.$k - rr.$k * 0.82 - 4.5; anchor: center; size: 8; weight: 700; color: #fff6ea; show: goo.$k.gn > 4; family: "Inter" }
        text goo.$k.text { at: x.$k, y.$k + rr.$k * 0.42; anchor: center; size: 9 * rs.$k; weight: 700; color: ink; opacity: if(goo.$k.on and goo.$k.druh != 2, 0.9, 0) }
        // druh 2 (hodiny, ako TimeGoo): veľký čas a pod ním dátum, písmo Inter
        text goo.$k.ikona { at: x.$k, y.$k - rr.$k * 0.12; anchor: center; size: 14 * rs.$k; weight: 700; color: ink; opacity: if(goo.$k.on and goo.$k.druh == 2, 1, 0); family: "Inter" }
        text goo.$k.text { at: x.$k, y.$k + rr.$k * 0.36; anchor: center; size: 8 * rs.$k; color: ink; opacity: if(goo.$k.on and goo.$k.druh == 2, 0.75, 0); family: "Inter" }
    }
    // ponuka Goo: karta z kávy do farby okien, ucho v rohu pri mieste kliku
    let ctx.sx = if(ctx.x + ctx_w + 12 <= W, 1, -1)
    let ctx.sy = if(ctx_up, if(ctx.y - ctx_h - 12 >= 0, -1, 1), if(ctx.y + ctx_h + 12 <= H, 1, -1))
    let cx0 = clamp(if(ctx.sx > 0, ctx.x, ctx.x - ctx_w), 12, W - 12 - ctx_w)
    let cy0 = clamp(if(ctx.sy > 0, ctx.y, ctx.y - ctx_h), 12, H - 12 - ctx_h)
    let ctx.ax = if(ctx.sx > 0, cx0, cx0 + ctx_w)
    let ctx.ay = if(ctx.sy > 0, cy0, cy0 + ctx_h)
    let ctx.q = clamp(ctx.p, 0, 1.08)
    let card = #2c2019
    zone box ctx_away { at: W / 2, H / 2; size: W, H; active: ctx_open }
    on press ctx_away { ctx_open = false; emit ctx_close }
    on press right ctx_away { ctx_open = false; emit ctx_close }
    body {
        gradient: ctx.ax, ctx.ay to ctx.ax + ctx.sx * ctx_w, ctx.ay + ctx.sy * ctx_h, mix(card, coffee, 0.6), card, card
        rim: 16%
        shadow: 0, 4, 6, 30% * clamp(ctx.p, 0, 1)
        opacity: if(ctx.p > 0.02, 1, 0)
        box { at: ctx.ax + ctx.sx * ctx_w * ctx.q / 2, ctx.ay + ctx.sy * ctx_h * ctx.q / 2; size: max(ctx_w * ctx.q, 14) * if(ctx.p > 0.02, 1, 0), max(ctx_h * ctx.q, 14); corner: 14 }
        ellipse { at: ctx.ax, ctx.ay; radius: (9 * clamp(ctx.p * 3, 0, 1) + 1) * if(ctx.p > 0.02, 1, 0); blend: 10 }
    }
    group {
        opacity: clamp(ctx.p * 2 - 1, 0, 1)
        show: ctx_open and ctx.p > 0.5
        repeat m in 0..14 {
            box { at: cx0 + ctx_w / 2, cy0 + ctx.$m.y - 6; size: ctx_w - 32, 1; color: #5a463a; show: m < ctx.count and ctx.$m.sep }
            box { at: cx0 + ctx_w / 2, cy0 + ctx.$m.y + 18; size: ctx_w - 12, 32; corner: 9; color: if(ctx.$m.danger, #e5484d, #4a372b); opacity: if(ctx_hot == m and not ctx.$m.off, if(ctx.$m.danger, 18%, 100%), 0); show: m < ctx.count }
            text ctx.$m.glyph { at: cx0 + 24, ctx.$m.y + cy0 + 18; anchor: center; size: 16; color: if(ctx.$m.danger, #e5484d, cream); opacity: if(ctx.$m.off, 40%, 90%); show: m < ctx.count and ctx.$m.on == 0; family: "noctalia-tabler-icons" }
            text "" { at: cx0 + 24, cy0 + ctx.$m.y + 18; anchor: center; size: 15; color: #f7c873; show: m < ctx.count and ctx.$m.on == 1; family: "noctalia-tabler-icons" }
            text ctx.$m.label { at: cx0 + 46, cy0 + ctx.$m.y + 18; anchor: left center; width: ctx_w - if(ctx.$m.sub, 82, 70); lines: 1; size: 13; weight: 500; color: if(ctx.$m.danger, #e5484d, cream); opacity: if(ctx.$m.off, 45%, 100%); show: m < ctx.count; family: "Inter" }
            text ctx.$m.hint { at: cx0 + ctx_w - 16, cy0 + ctx.$m.y + 18; anchor: right center; size: 11.5; color: #b8a491; show: m < ctx.count and not ctx.$m.sub; family: "Inter" }
            text "" { at: cx0 + ctx_w - 20, cy0 + ctx.$m.y + 18; anchor: center; size: 14; color: #b8a491; show: m < ctx.count and ctx.$m.sub and not ctx.$m.back; family: "noctalia-tabler-icons" }
            zone box ctx_row.$m { at: cx0 + ctx_w / 2, cy0 + ctx.$m.y + 18; size: ctx_w - 12, 34; cursor: pointer; active: ctx_open and m < ctx.count and not ctx.$m.off }
            on enter ctx_row.$m { ctx_hot = m }
            on leave ctx_row.$m { ctx_hot = -1 }
            on press ctx_row.$m { emit ctx_pick(m) }
        }
    }
    // bublina s názvom a popisom (§3: obsah kvapky sa hoverom nemení — názov je iba tu)
    box { from: tipx - 110, tipy - 15; size: 220, 30; corner: 15; color: coffee; opacity: tip.p * 0.94 }
    text tip { at: tipx, tipy; anchor: center; size: 12; color: ink; opacity: tip.p; width: 210; align: center }
    text hud { at: 16, 14; size: 12; color: #f3ebdd; opacity: if(ladenie, 0.8, 0); family: "monospace"; show: ladenie }
    // preklady (pravidlo 4: texty v UI po anglicky + preklad; tr() v logike)
    translations sk {
        "Back" = "Späť"
        "More windows" = "Ďalšie okná"
        "Restore" = "Obnoviť"
        "Minimize" = "Minimalizovať"
        "Maximize" = "Maximalizovať"
        "Layout" = "Rozloženie"
        "Left half" = "Ľavá polovica"
        "Right half" = "Pravá polovica"
        "Top left" = "Vľavo hore"
        "Top right" = "Vpravo hore"
        "Bottom left" = "Vľavo dole"
        "Bottom right" = "Vpravo dole"
        "Center" = "Na stred"
        "Always on top (all desktops)" = "Vždy navrchu (všetky plochy)"
        "Move to desktop" = "Presunúť na plochu"
        "Desktop" = "Plocha"
        "New desktop" = "Nová plocha"
        "Close" = "Zavrieť"
        "Floating windows" = "Plávajúce okná"
        "Tiles" = "Dlaždice"
        "Tape" = "Páska"
        "Settings" = "Nastavenia"
        "Monitor" = "Monitor"
        "Lock" = "Zamknúť"
        "Log out" = "Odhlásiť"
        "Sleep" = "Uspať"
        "Restart" = "Reštartovať"
        "Shut down" = "Vypnúť"
        "charging" = "nabíja sa"
        "Date and time settings" = "Nastavenia dátumu a času"
        "Well-being" = "Digitálna pohoda"
        "left: launcher · wheel: size" = "ľavý: spúšťač · koliesko: veľkosť"
        "devices need attention" = "zariadení potrebuje pozornosť"
        "offline" = "bez siete"
        "updates" = "aktualizácií"
        "left: App Manager · right: Device Manager" = "ľavý: App Manager · pravý: Správca zariadení"
        "No notifications" = "Žiadne upozornenia"
        "Clear all" = "Vymazať všetko"
        "notifications" = "upozornení"
    }
}
