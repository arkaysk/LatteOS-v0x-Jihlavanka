        line { from: x.2, y.2 - thy0.2; to: thx.2, thy.2; width: th.2 * if(goo.2.sk != 1, 1, 0); blend: 12 * clamp(th.2 / 3, 0, 1) }
        ellipse { at: x.3, floor + 4; radius: rr.3 * 0.5 * base.3 * if(goo.3.sk != 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
