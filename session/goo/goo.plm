        line { from: x.3, y.3 - thy0.3; to: thx.3, thy.3; width: th.3 * if(goo.3.sk != 1, 1, 0); blend: 12 * clamp(th.3 / 3, 0, 1) }
        ellipse { at: x.4, floor + 4; radius: rr.4 * 0.5 * base.4 * if(goo.4.sk != 1, 1, 0); scale: 1.6, 0.5; blend: 14 }
