#!/usr/bin/env bash
# latte-marea [wm|hyprland] — pôvodná Marea (github.com/k4ditano/pleamar, pleamar-wm, marea-plm) ako samostatné
# prostredie na pokusy (30. 9. 2026). Všetko svoje má oddelené od LatteOS: programy v ~/.local/share/marea-povodna
# (mimo PATH — /usr/bin/pleamar s úpravami LatteOS pre Kvapky ostáva nedotknutý), nastavenia v ~/.config/pleamar
# (LatteOS ho nepoužíva) a ~/.local/state/marea-plm. Preklad a aktualizácia: setup/lab/marea-povodna.sh.
#   wm        autorov kompozitor pleamar-wm s Mareou (ako na jeho videu)
#   hyprland  Marea ako shell na Hyprlande (hypr/marea.lua)
M="$HOME/.local/share/marea-povodna"
if [ ! -x "$M/bin/pleamar" ]; then
    echo "latte-marea: pôvodná Marea nie je preložená (setup/lab/marea-povodna.sh)" >&2
    exit 1
fi
export PATH="$M/bin:$PATH"                 # pôvodný pleamar a marea pred LatteOS
export XDG_SESSION_TYPE=wayland
# autorova tapeta (CachyOS GreenFeathers) na Fedore nie je → tapeta LatteOS, kým si v Marei nevyberieš inú
[ -n "${PLEAMAR_WALLPAPER:-}" ] || [ -f "$HOME/.local/share/pleamar/marea/settings.json" ] \
    || export PLEAMAR_WALLPAPER=/usr/share/backgrounds/latteos/latteos-wallpaper1.jpg
# systemd používateľa žije od štartu PC (Sunshine pred prihlásením): premenné cudzej relácie preč
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP 2>/dev/null
case "${1:-wm}" in
    hyprland)
        export XDG_CURRENT_DESKTOP=Hyprland
        exec Hyprland -c /usr/share/latteos/hypr/marea.lua ;;
    *)
        # ako autorova relácia (pleamar-wm/install.sh): jediná plocha — programy z dbus a systemd (portály,
        # upozornenia) sa dozvedia, kde je
        export XDG_CURRENT_DESKTOP=pleamar XDG_SESSION_DESKTOP=pleamar PLEAMAR_WM_EXPORT=1
        "$M/bin/pleamar-wm" init >/dev/null 2>&1      # ~/.config/pleamar, iba raz (nikdy neprepíše)
        exec "$M/bin/pleamar-session" ;;
esac
