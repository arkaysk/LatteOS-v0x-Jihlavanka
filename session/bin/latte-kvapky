#!/usr/bin/env bash
# latte-kvapky — skúšobná plocha LatteOS Kvapky (latteGoo): bez klasickej lišty a jej pomocníkov, živá tapeta
# a tekuté kvapky (session/kvapky, pleamar). Noctalia beží ďalej, ale bez lišty (bar-hide) a bez servera upozornení
# (tie sú kvapôčky na Hodinách): robí to, čo vie — zamknutie, Alt+Tab, snímky, OSD, klávesy médií, ovládacie centrum.
#   latte-kvapky start    autoštart relácie „LatteOS Kvapky“ (hyprland.lua pri LATTE_VARIANT=kvapky)
#   latte-kvapky skusit   z bežiacej klasickej plochy do Kvapiek bez odhlásenia (vypne Noctaliu a pomocníkov)
#   latte-kvapky spat     späť na klasickú plochu (Noctalia a pomocníci ako pri štarte, bežné okraje okien)
#   latte-kvapky stav     „kvapky“ alebo „klasicke“
#   latte-kvapky okraj [dole|hore|vlavo|vpravo POLOHA]   okraj lišty-kvapky (presun ťahaním); bez argumentov vypíše
#   latte-kvapky uloz spustac JSON   uloží nastavenia spúšťača (logika Kvapiek nevie zapisovať súbory)
# Ostáva aj Kapsa (história schránky), App Manager a systémové ponuky (Ctrl+Alt+Del, kvapka vypínač).
set -u
share=/usr/share/latteos
# stav Noctalie: klasický LatteOS ~/.local/state/latteos/noctalia, Kvapky ~/.local/state/latteos/kvapky/noctalia —
# navzájom sa nedeformujú (30. 9.); pôvodná Noctalia má svoj ~/.local/state/noctalia (latte-session)
st_classic="${XDG_STATE_HOME:-$HOME/.local/state}/latteos"
st_kvapky="$st_classic/kvapky"
scene="${LATTE_KVAPKY_SCENE:-$share/kvapky/kvapka.plm}"
pleamar="${PLEAMAR:-$(command -v pleamar || echo /usr/bin/pleamar)}"
# klasickí pomocníci z hyprland.lua (autoštart), ktorí patria k Noctalii
classic="netznak kapsavyrez nahlad plocha rychle pohoda maskot zivatapeta"

qs_app() { pgrep -f "latteos/apps/$1\.qml" >/dev/null; }
start_app() { qs_app "$1" || setsid -f latte-app "$1" >/dev/null 2>&1; }

flag="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/latteos/kvapky"          # plocha Kvapky beží; obsah = okraj lišty
okraj="${XDG_STATE_HOME:-$HOME/.local/state}/latteos/kvapka-okraj"    # „dole 0.400“ (pamätá sa)
side() { s="$(cut -d' ' -f1 "$okraj" 2>/dev/null)"; case "$s" in dole|hore|vlavo|vpravo) echo "$s" ;; *) echo dole ;; esac; }
gaps() {   # pás pri okraji lišty pre kvapku (Noctalia si ho inak vyhradí sama): rezerva monitora, ktorú rešpektujú
          # aj maximalizované okná (latte.kvapky_reserve v hyprland.lua); príznak ju obnoví po reload-e
    if [ "$1" = off ]; then
        rm -f "$flag"; hyprctl eval 'latte.kvapky_reserve(nil)' >/dev/null
    else
        mkdir -p "$(dirname "$flag")"; echo "$1" > "$flag"
        hyprctl eval "latte.kvapky_reserve('$1')" >/dev/null
    fi
}

# Noctalia pre Kvapky: rovnaká konfigurácia ako v klasickej ploche (odkazy), navyše zz-kvapky.toml — Noctalia
# zlúči všetky *.toml v priečinku v abecednom poradí
noctalia_up() {
    pgrep -x noctalia >/dev/null && return
    local base="${XDG_CONFIG_HOME:-$HOME/.config}/latteos/noctalia" dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/latteos/noctalia-kvapky"
    [ -f "$base/config.toml" ] || base="$share/noctalia"
    rm -rf "$dir"; mkdir -p "$dir/noctalia"
    for f in "$base"/*; do ln -s "$f" "$dir/noctalia/"; done
    cat > "$dir/noctalia/zz-kvapky.toml" <<'EOF2'
# plocha Kvapky: lištu nahrádzajú kvapky, upozornenia prijíma pleamar (kvapôčky na Hodinách),
# tapetu kreslí latte-tapety cez mpvpaper (živú aj statickú) — Noctalia by ju inak prekryla
[bar.main]
enabled = false

[notification]
enable_daemon = false

[wallpaper]
enabled = false

# klik na Hodiny otvorí ovládacie centrum Noctalie (dashboard) — lišta Noctalie nie je, preto voľne vľavo dole
# nad Hodinami, nie prilepené k lište
[shell.panel]
control_center_placement = "floating"
control_center_position  = "bottom_left"
EOF2
    # prvý štart Kvapiek: nastavenia sa skopírujú z klasického LatteOS, potom každá plocha žije sama
    if [ ! -e "$st_kvapky/noctalia/settings.toml" ]; then
        mkdir -p "$st_kvapky/noctalia"
        [ -f "$st_classic/noctalia/settings.toml" ] && cp "$st_classic/noctalia/settings.toml" "$st_kvapky/noctalia/"
        touch "$st_kvapky/noctalia/.setup-complete"
    fi
    NOCTALIA_CONFIG_HOME="$dir" NOCTALIA_STATE_HOME="$st_kvapky" setsid -f noctalia >/dev/null 2>&1
    ( sleep 3; latte-theme noctalia ) >/dev/null 2>&1 &     # téma LatteOS je spoločná, stav Noctalie nie
}

scene_up() {
    pgrep -x pleamar >/dev/null && return
    [ -x "$pleamar" ] && [ -f "$scene" ] || { notify-send -a LatteOS "Kvapky" "chýba pleamar alebo scéna ($scene)"; return 1; }
    # PLEAMAR_GENERIC=window: zoznam okien z wlr-foreign-toplevel, kurzor z Hyprlandu (resources/patches/pleamar-…)
    local log="${XDG_STATE_HOME:-$HOME/.local/state}/latteos/kvapky.log"
    [ -f "$log" ] && mv -f "$log" "$log.1"          # každý štart s čistým logom (predošlý ostáva ako .1)
    LATTE_VARIANT=kvapky PLEAMAR_GENERIC=window setsid -f "$pleamar" --scene "$scene" --no-hud >"$log" 2>&1
}

case "${1:-}" in
    start)
        mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/latteos"
        gaps "$(side)"
        latte-tapety obnov --bez-shellu
        pgrep -f "wl-paste --type text --watch latte-kapsa-store" >/dev/null || setsid -f wl-paste --type text --watch latte-kapsa-store
        pgrep -f "wl-paste --type image --watch latte-kapsa-store" >/dev/null || setsid -f wl-paste --type image --watch latte-kapsa-store
        start_app spustac
        start_app ponuka
        scene_up
        noctalia_up
        ;;
    skusit)
        pkill -x noctalia; sleep 0.5          # klasická Noctalia (s lištou) → nahradí ju tá pre Kvapky
        for a in $classic; do pkill -f "latteos/apps/$a\.qml"; done
        pkill -x pleamar; sleep 0.3          # kvapka z klasickej plochy (ak beží) sa spustí znova ako samostatná
        exec "$0" start
        ;;
    spat)
        pkill -x pleamar
        gaps off
        pkill -x noctalia; sleep 0.5          # Noctalia pre Kvapky → klasická (s lištou a upozorneniami)
        if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/latteos/noctalia/config.toml" ]; then
            export NOCTALIA_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/latteos"
        else
            export NOCTALIA_CONFIG_HOME="$share"
        fi
        NOCTALIA_STATE_HOME="$st_classic" setsid -f noctalia >/dev/null 2>&1
        ( sleep 3; latte-theme noctalia ) >/dev/null 2>&1 &
        [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/latteos/live-wallpaper" ] && start_app zivatapeta
        for a in netznak kapsavyrez nahlad plocha rychle pohoda maskot; do start_app "$a"; done
        # statická tapeta z mpvpaperu (bez shellu) ustúpi natívnej tapete Noctalie; živé video ostáva
        latte-tapety obnov >/dev/null 2>&1
        ;;
    uloz)
        # logika Kvapiek nevie zapisovať súbory: uloží, čo jej patrí (iba tieto súbory, atomicky)
        case "${2:-}" in
            spustac) f="${XDG_CONFIG_HOME:-$HOME/.config}/latteos/spustac.json" ;;
            widgety) f="${XDG_CONFIG_HOME:-$HOME/.config}/latteos/kvapky-widgety.json" ;;
            *) echo "latte-kvapky uloz: neznámy súbor: ${2:-}" >&2; exit 1 ;;
        esac
        mkdir -p "$(dirname "$f")"; printf '%s\n' "${3:-}" > "$f.new" && mv -f "$f.new" "$f"
        ;;
    okraj)
        if [ -z "${2:-}" ]; then cat "$okraj" 2>/dev/null || echo "dole 0.400"; exit 0; fi
        case "$2" in dole|hore|vlavo|vpravo) ;; *) echo "neznámy okraj: $2" >&2; exit 1 ;; esac
        mkdir -p "$(dirname "$okraj")"; echo "$2 ${3:-0.4}" > "$okraj"
        [ -e "$flag" ] && gaps "$2"
        ;;
    stav)
        if [ -e "$flag" ]; then echo kvapky; else echo klasicke; fi
        ;;
    *) sed -n '2,8p' "$0"; exit 1 ;;
esac
