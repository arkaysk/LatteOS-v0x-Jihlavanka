#!/usr/bin/python3
"""latte-goo — pomocník enginu Goo (session/goo): kvapky používateľa, ich akcie, uložené polohy, ikony.
Logika scény beží v pieskovisku pleamar (bez súborov a bez sh) — všetko, čo siaha na systém, robí tento pomocník.

  latte-goo zoznam [--priklady]   kvapky používateľa (~/.config/latteos/goo/kvapky/*.json) overené, ako JSON zoznam;
                                  chybná kvapka má pole "chyba" (logika ju preskočí a zapíše do logu)
  latte-goo novy MENO             nová kvapka zo vzoru (súbor JSON), vypíše cestu — upraviť a uložiť, ukáže sa sama
  latte-goo skontroluj            overí všetky kvapky používateľa, ľudsky čitateľne
  latte-goo akcia ID KLUC         vykoná akciu kvapky (klik, pravy, stredny, podrz, hore, dole) podľa jej súboru
  latte-goo text ID               text kvapky z príkazu (prvý riadok, do 5 s)
  latte-goo upozornenie ID        farba jadra z príkazu upozornenia (hardver|siet|softver|vystraha|svetlo|ine), prázdne = nič
  latte-goo stav                  uložené polohy a veľkosti ({id: {x, y, z}})
  latte-goo uloz-stav JSON        uloží ich (atomicky)
  latte-goo nastavenia            Nastavenia › Kvapky (~/.config/latteos/kvapky.json): skryté, veľkosť, vrátenie
  latte-goo cas                   údaje karty ClockGoo: {"teraz" ms, "casovace" (stopky, minútka, budíky — spoločné
                                  s plochou Kvapky, ~/.local/share/latteos/casovace.json), "pohoda" (čas pred obrazovkou
                                  a tri najpoužívanejšie aplikácie dnes), "pasma" (svetové hodiny z clock.conf)}
  latte-goo zvon TITUL [TEXT]     minútka alebo budík: upozornenie a trikrát zvuk (logika zvoniť nevie)
  latte-goo ikony MENO…           mená ikon Tabler → znaky písma ({meno: znak}), podľa Noctalie
  latte-goo kava                  pomer vody a mlieka podľa Baristu (~/.config/latteos/kava): [voda, mlieko]
  latte-goo rezim                 režim okien (plavajuce | dlazdice | paska) z ~/.local/state/latteos/window-mode
  latte-goo okna                  viditeľné okná na aktuálnej ploche zameraného monitora (obdĺžniky voči monitoru):
                                  {"w", "h", "okna": [{x, y, w, h}], "roh": rohová lišta Noctalie} — Goobar podľa
                                  nich uhýba k okraju a kvapky sa zastavia pred rohovou lištou (Hyprland,
                                  inak Sway na skúšky)
"""
import glob, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "latteos", "goo", "kvapky")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "latteos", "goo", "stav.json")
here = os.path.dirname(os.path.realpath(__file__))
SHARE = os.environ.get("LATTE_GOO_DIR") or next(
    (d for d in ("/usr/share/latteos/goo", os.path.join(here, "..", "goo")) if os.path.isdir(d)), "/usr/share/latteos/goo")
PRIKLADY = os.path.join(SHARE, "priklady")
TABLER = "/usr/share/noctalia/assets/fonts/tabler.json"
KAVA = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "latteos", "kava")
# rovnaké ako plocha Kvapky (kvapka.luau › kavy)
KAVY = {"espresso": (0, 0), "ristretto": (0, 0), "lungo": (0.35, 0), "americano": (0.7, 0), "macchiato": (0, 0.25),
        "cortado": (0, 0.4), "flatwhite": (0.05, 0.5), "cappuccino": (0, 0.55), "latte": (0, 0.85),
        "cierna-s-mliekom": (0.4, 0.3)}

POVAHY = {"pokojna", "zvedava", "lepkava", "tazka", "hrava"}
EFEKTY = {"nic", "dych", "kmit", "tras", "obeh", "tlkot"}
DRUHY = {"ikona", "ukazovatel"}
AKCIE = {"klik", "pravy", "stredny", "podrz", "koliesko", "hore", "dole"}
VSTAVANE = {"domov", "velkost", "poskoc", "vlnka", "vibracia", "nic"}
JADRA = {"hardver", "siet", "softver", "vystraha", "svetlo", "ine"}
DRUHY_AKCII = ("spusti", "aplikacia", "otvor", "vystup")
# čísla: (min, max)
CISLA = {"velkost": (8, 80), "gravitacia": (0, 1), "vznos": (0, 2), "vyska": (0, 300), "odstup": (-2000, 2000), "dosah": (40, 800), "lepivost": (0, 1), "trhanie": (20, 400),
         "svetlo": (0, 1), "rast": (0, 1), "hmotnost": (0, 1), "sila": (0, 2), "hodnota": (0, 1)}
TEXTY = ("nazov", "ikona", "popis", "pri")

VZOR = {
    "id": "", "nazov": "", "ikona": "droplet", "popis": "Moja kvapka",
    "povaha": "zvedava", "velkost": 26,
    "text": {"prikaz": "date +%H:%M", "kazdych": 30},
    "akcie": {"klik": {"spusti": "notify-send Kvapka Ahoj"}, "pravy": {"vystup": "uptime -p"},
              "stredny": "domov", "koliesko": "velkost"},
}


def slug(s):
    s = s.lower()
    for a, b in zip("áäčďéěíĺľňóôŕřšťúůýž", "aacdeeillnoorrstuuyz"):
        s = s.replace(a, b)
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:40]


def check_action(name, a):
    if isinstance(a, str):
        return None if a in VSTAVANE else f"akcia {name}: nepoznám '{a}' (vstavané: {', '.join(sorted(VSTAVANE))})"
    if not isinstance(a, dict) or len([k for k in DRUHY_AKCII if k in a]) != 1:
        return f"akcia {name}: čakám jedno z {', '.join(DRUHY_AKCII)}, alebo {', '.join(sorted(VSTAVANE))}"
    k = next(k for k in DRUHY_AKCII if k in a)
    return None if isinstance(a[k], str) and a[k].strip() else f"akcia {name}: '{k}' má byť neprázdny text"


def validate(j, path):
    """overená a očistená kvapka; chyba → {"id", "zdroj", "chyba"}"""
    def bad(msg):
        return {"id": j.get("id") if isinstance(j.get("id"), str) else slug(os.path.basename(path)[:-5]), "zdroj": path, "chyba": msg}
    if not isinstance(j, dict):
        return {"id": slug(os.path.basename(path)[:-5]), "zdroj": path, "chyba": "súbor nie je objekt JSON"}
    out = {"zdroj": path}
    out["id"] = slug(j.get("id") or os.path.basename(path)[:-5])
    if not out["id"]:
        return bad("chýba id")
    for k in TEXTY:
        if k in j:
            if not isinstance(j[k], str):
                return bad(f"'{k}' má byť text")
            out[k] = j[k][:80]
    out.setdefault("nazov", j.get("id") or out["id"])
    for k, (lo, hi) in CISLA.items():
        if k in j:
            if not isinstance(j[k], (int, float)) or isinstance(j[k], bool):
                return bad(f"'{k}' má byť číslo ({lo} až {hi})")
            out[k] = max(lo, min(hi, j[k]))
    for k, allowed in (("povaha", POVAHY), ("efekt", EFEKTY), ("druh", DRUHY)):
        if k in j:
            if j[k] not in allowed:
                return bad(f"'{k}' môže byť: {', '.join(sorted(allowed))}")
            out[k] = j[k]
    if "farba" in j:
        return bad("'farba' nie je: kvapky sú vždy káva (Barista: pomer vody a mlieka)")
    if "tahat" in j:
        out["tahat"] = bool(j["tahat"])
    if "poloha" in j:
        p = j["poloha"]
        if not (isinstance(p, dict) and isinstance(p.get("x", 0.5), (int, float)) and isinstance(p.get("y", 0), (int, float))):
            return bad("'poloha' má byť {\"x\": 0…1, \"y\": px nad lištou}")
        out["poloha"] = {"x": max(0.02, min(0.98, p.get("x", 0.5))), "y": max(0, p.get("y", 0))}
    t = j.get("text")
    if isinstance(t, str):
        out["text"] = t[:12]
    elif isinstance(t, dict):
        if not isinstance(t.get("prikaz"), str):
            return bad("'text' má byť text, alebo {\"prikaz\": \"…\", \"kazdych\": sekundy}")
        out["text"] = {"prikaz": t["prikaz"], "kazdych": max(2, int(t.get("kazdych", 60)))}
    if "jadro" in j:
        if j["jadro"] not in JADRA:
            return bad(f"'jadro' môže byť: {', '.join(sorted(JADRA))}")
        out["jadro"] = j["jadro"]
    if "upozornenie" in j:
        u = j["upozornenie"]
        if not (isinstance(u, dict) and isinstance(u.get("prikaz"), str)):
            return bad("'upozornenie' má byť {\"prikaz\": \"…\", \"kazdych\": sekundy}; výstup príkazu = farba jadra")
        out["upozornenie"] = {"prikaz": u["prikaz"], "kazdych": max(2, int(u.get("kazdych", 30)))}
    if "akcie" in j:
        if not isinstance(j["akcie"], dict):
            return bad("'akcie' má byť objekt")
        acts = {}
        for name, a in j["akcie"].items():
            if name not in AKCIE:
                return bad(f"neznáma akcia '{name}' (môže byť: {', '.join(sorted(AKCIE))})")
            if name == "koliesko" and isinstance(a, dict) and ("hore" in a or "dole" in a):
                for sub in ("hore", "dole"):
                    if sub in a:
                        e = check_action(sub, a[sub])
                        if e:
                            return bad(e)
                        acts[sub] = a[sub]
                acts["koliesko"] = {"hore": a.get("hore", "nic"), "dole": a.get("dole", "nic")}
                continue
            e = check_action(name, a)
            if e:
                return bad(e)
            acts[name] = a
        out["akcie"] = acts
    return out


def files(priklady=False):
    fs = sorted(glob.glob(os.path.join(CONF, "*.json")))
    if priklady:
        own = {os.path.basename(f) for f in fs}
        fs += [f for f in sorted(glob.glob(os.path.join(PRIKLADY, "*.json"))) if os.path.basename(f) not in own]
    return fs


def load_all(priklady=False):
    res = []
    for f in files(priklady):
        try:
            j = json.load(open(f, encoding="utf-8"))
        except (OSError, ValueError) as e:
            res.append({"id": slug(os.path.basename(f)[:-5]), "zdroj": f, "chyba": f"neplatný JSON: {e}"})
            continue
        res.append(validate(j, f))
    return res


def find(i):
    for d in load_all(priklady=True):
        if d["id"] == i and "chyba" not in d:
            return d
    return None


def run_action(a):
    if isinstance(a, str):
        return 0
    if "spusti" in a:
        subprocess.Popen(["sh", "-c", a["spusti"]], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif "aplikacia" in a:
        app = a["aplikacia"][:-8] if a["aplikacia"].endswith(".desktop") else a["aplikacia"]
        subprocess.Popen(["gtk-launch", app], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif "otvor" in a:
        subprocess.Popen(["xdg-open", os.path.expanduser(a["otvor"])], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif "vystup" in a:
        try:
            out = subprocess.run(["sh", "-c", a["vystup"]], capture_output=True, text=True, timeout=5).stdout
        except subprocess.TimeoutExpired:
            out = "(príkaz nestihol odpovedať do 5 s)"
        print(out.strip()[:300])
    return 0


def glyphs(names):
    try:
        tab = json.load(open(TABLER))
    except (OSError, ValueError):
        return {}
    res = {}
    for n in names:
        e = tab.get(n) or tab.get("tabler-" + n)
        cp = str(e.get("codepoint", "")) if isinstance(e, dict) else ""
        if cp[:2] in ("U+", "0x"):                    # tabler.json Noctalie píše „U+EA35“
            res[n] = chr(int(cp[2:], 16))
    return res


def cas():
    """údaje karty ClockGoo — to isté, čo číta časové menu plochy Kvapky (kvapka.luau › paint_static)"""
    import datetime, time
    share = os.environ.get("XDG_DATA_HOME", HOME + "/.local/share")
    cfg = os.environ.get("XDG_CONFIG_HOME", HOME + "/.config")
    def load(path, default):
        try:
            v = json.load(open(path))
            return v if isinstance(v, type(default)) else default
        except (OSError, ValueError):
            return default
    out = {"teraz": int(time.time() * 1000), "casovace": load(share + "/latteos/casovace.json", {}),
           "pohoda": {"spolu": 0, "aplikacie": []}, "pasma": []}
    d = load(share + "/latteos/pohoda/" + datetime.date.today().isoformat() + ".json", {})
    if isinstance(d.get("apps"), dict):
        out["pohoda"]["spolu"] = int(sum((seg[1] or 0) - (seg[0] or 0) for seg in d.get("screen") or [] if len(seg) >= 2))
        apps = sorted(((c, int((v or {}).get("s", 0))) for c, v in d["apps"].items()), key=lambda x: -x[1])[:3]
        for cls, sec in apps:
            name = cls[6:] if cls.startswith("latte:") else cls.rsplit(".", 1)[-1]
            out["pohoda"]["aplikacie"].append({"nazov": name[:1].upper() + name[1:], "s": sec})
    try:
        zones = re.search(r'zones = "([^"]*)"', open(cfg + "/latteos/clock.conf").read())
    except OSError:
        zones = None
    if zones:
        import zoneinfo
        now = datetime.datetime.now().astimezone()
        for z in [x for x in re.split(r"[,\s]+", zones.group(1)) if x][:4]:
            try:
                t = now.astimezone(zoneinfo.ZoneInfo(z))
            except Exception:
                continue
            diff = (t.utcoffset() - now.utcoffset()).total_seconds() / 3600
            ds = "" if diff == 0 else ("+" if diff > 0 else "−") + ("%g" % abs(diff)).replace(".", ",") + " h"
            out["pasma"].append({"mesto": z.rsplit("/", 1)[-1].replace("_", " "), "hm": t.strftime("%H:%M"), "rozdiel": ds})
    return out


def zvon(title, body):
    """upozornenie hneď, zvuk trikrát na pozadí (ako ring() v kvapka.luau)"""
    subprocess.Popen(["notify-send", "-a", "LatteOS", "-i", "alarm-clock", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    snd = "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
    if os.path.exists(snd):
        subprocess.Popen(["sh", "-c", 'for i in 1 2 3; do paplay "$0" || break; done', snd], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def visible_windows():
    """okná, ktoré na ploche naozaj vidno (nie minimalizované v special:minimized), v súradniciach monitora"""
    def cmd(*c):
        try:
            return json.loads(subprocess.run(c, capture_output=True, text=True, timeout=2).stdout or "null")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return None
    mons = cmd("hyprctl", "-j", "monitors")
    if isinstance(mons, list) and mons:
        # monitor, na ktorom engine beží (hlavný, ľavý horný roh 0,0 — ako latte-kvapky), nie práve zameraný
        m = next((x for x in mons if x.get("x") == 0 and x.get("y") == 0), mons[0])
        ws = (m.get("activeWorkspace") or {}).get("id")
        out = []
        for c in cmd("hyprctl", "-j", "clients") or []:
            w = c.get("workspace") or {}
            if not c.get("mapped", True) or c.get("hidden") or w.get("id") != ws or str(w.get("name", "")).startswith("special"):
                continue
            (x, y), (cw, ch) = c.get("at", [0, 0]), c.get("size", [0, 0])
            out.append({"x": x - m["x"], "y": y - m["y"], "w": cw, "h": ch})
        scale = m.get("scale", 1) or 1
        # rohová lišta Noctalie na tomto monitore: kvapky sa pred ňou zastavia
        roh = None
        for lv in ((cmd("hyprctl", "-j", "layers") or {}).get(m.get("name"), {}).get("levels") or {}).values():
            for l in lv:
                if "noctalia-bar" in l.get("namespace", "") and l.get("w", 0) > 0 and l.get("h", 0) > 0:
                    roh = {"x": l["x"] - m["x"], "y": l["y"] - m["y"], "w": l["w"], "h": l["h"]}
        return {"w": int(m["width"] / scale), "h": int(m["height"] / scale), "okna": out, "roh": roh}
    tree = cmd("swaymsg", "-t", "get_tree")
    if isinstance(tree, dict):
        out, mon = [], {"w": 1920, "h": 1080}
        def walk(n, visible):
            if n.get("type") == "output" and n.get("name") != "__i3":
                mon.update(w=n["rect"]["width"], h=n["rect"]["height"])
            if n.get("type") == "workspace":
                visible = n.get("visible", False) if "visible" in n else True
            if (n.get("app_id") is not None or n.get("window")) and visible and n.get("visible", True):
                r = n["rect"]
                out.append({"x": r["x"], "y": r["y"], "w": r["width"], "h": r["height"]})
            for k in n.get("nodes", []) + n.get("floating_nodes", []):
                walk(k, visible)
        walk(tree, True)
        return {"w": mon["w"], "h": mon["h"], "okna": out}
    return {"w": 0, "h": 0, "okna": []}


def main(a):
    c = a[0] if a else ""
    if c == "zoznam":
        print(json.dumps(load_all("--priklady" in a), ensure_ascii=False)); return 0
    if c == "skontroluj":
        ds = load_all()
        if not ds:
            print(f"žiadne kvapky v {CONF} (nová: latte-goo novy MENO)")
        for d in ds:
            print(("✗ " + d["zdroj"] + ": " + d["chyba"]) if "chyba" in d else ("✓ " + d["id"] + " · " + d.get("nazov", "")))
        return 1 if any("chyba" in d for d in ds) else 0
    if c == "novy" and len(a) >= 2:
        name = " ".join(a[1:])
        i = slug(name) or "kvapka"
        os.makedirs(CONF, exist_ok=True)
        p = os.path.join(CONF, i + ".json")
        if os.path.exists(p):
            print(p); return 0
        v = dict(VZOR, id=i, nazov=name)
        json.dump(v, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
        print(p); return 0
    if c == "akcia" and len(a) == 3:
        d = find(a[1])
        if not d:
            print(f"kvapka {a[1]} nie je", file=sys.stderr); return 1
        acts = d.get("akcie", {})
        act = acts.get(a[2]) or (acts.get("koliesko", {}).get(a[2]) if isinstance(acts.get("koliesko"), dict) else None)
        if act is None:
            return 0
        return run_action(act)
    if c == "text" and len(a) == 2:
        d = find(a[1])
        t = d and d.get("text")
        if isinstance(t, dict):
            try:
                out = subprocess.run(["sh", "-c", t["prikaz"]], capture_output=True, text=True, timeout=5).stdout
            except subprocess.TimeoutExpired:
                out = "…"
            print((out.strip().splitlines() or [""])[0][:12])
        elif isinstance(t, str):
            print(t)
        return 0
    if c == "upozornenie" and len(a) == 2:
        d = find(a[1])
        u = d and d.get("upozornenie")
        if u:
            try:
                out = subprocess.run(["sh", "-c", u["prikaz"]], capture_output=True, text=True, timeout=5).stdout.strip()
            except subprocess.TimeoutExpired:
                out = ""
            w = (out.split() or [""])[0].lower()
            print(w if w in JADRA else ("ine" if w else ""))
        return 0
    if c == "cas":
        print(json.dumps(cas(), ensure_ascii=False)); return 0
    if c == "zvon" and len(a) >= 2:
        zvon(a[1], a[2] if len(a) > 2 else ""); return 0
    if c == "nastavenia":      # Nastavenia › Kvapky: skryté voliteľné kvapky, veľkosť, vrátenie na miesto
        try:
            print(json.dumps(json.load(open(os.path.join(os.path.dirname(os.path.dirname(CONF)), "kvapky.json"))), ensure_ascii=False))
        except (OSError, ValueError):
            print("{}")
        return 0
    if c == "stav":
        try:
            print(json.dumps(json.load(open(STATE)), ensure_ascii=False))
        except (OSError, ValueError):
            print("{}")
        return 0
    if c == "uloz-stav" and len(a) == 2:
        try:
            v = json.loads(a[1])
            assert isinstance(v, dict)
        except (ValueError, AssertionError):
            print("uloz-stav: čakám objekt JSON", file=sys.stderr); return 1
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".new", "w") as f:
            json.dump(v, f, ensure_ascii=False)
        os.replace(STATE + ".new", STATE)
        return 0
    if c == "okna":
        print(json.dumps(visible_windows())); return 0
    if c == "rezim":
        try:
            print(open(os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "latteos", "window-mode")).read().split()[0])
        except (OSError, IndexError):
            print("plavajuce")
        return 0
    if c == "kava":
        try:
            name = (re.findall(r"[\w-]+", open(KAVA).read()) or ["espresso"])[0]
        except OSError:
            name = "espresso"
        print(json.dumps(list(KAVY.get(name, KAVY["espresso"])))); return 0
    if c == "ikony":
        print(json.dumps(glyphs(a[1:]), ensure_ascii=False)); return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
