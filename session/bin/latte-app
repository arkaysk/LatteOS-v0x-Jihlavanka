#!/usr/bin/env bash
# latte-app <meno> — spustí aplikáciu LatteOS (Quickshell QML v /usr/share/latteos/apps/<meno>.qml).
#   latte-app subory [priečinok] · nastavenia [stránka] · monitor [prehlad|procesy|autorun|telemetria]
# Vo VM (stupeň Softvér/SAFE) kreslí Qt softvérovo bez GL — lacnejšie a bez pádov llvmpipe.
app="${1:?použitie: latte-app <subory|nastavenia|monitor> [argumenty]}"; shift
qml="/usr/share/latteos/apps/$app.qml"
[ -f "$qml" ] || { echo "neznáma aplikácia: $app"; exit 1; }
case "${LATTE_TIER:-softver}" in softver|safe|minimalny) export QT_QUICK_BACKEND=software ;; esac
# Nastavenia sú jedno okno: otvorené dostanú stránku cez IPC a prídu dopredu (napr. pravý klik na goo › Upraviť)
if [ "$app" = nastavenia ] && [ $# -gt 0 ]; then
    pid=$(pgrep -f "^qs -n -p $qml" | head -1)
    if [ -n "$pid" ] && qs ipc --pid "$pid" call nastavenia otvor "$1" "${2:-}" >/dev/null 2>&1; then
        # okno aj zo zbalenia (special:minimized) či z inej plochy: na aktuálnu plochu a dopredu
        read -r addr ws < <(hyprctl clients -j 2>/dev/null | python3 -c 'import json,sys; p=int(sys.argv[1]); c=next((c for c in json.load(sys.stdin) if c.get("pid")==p), None); print(c["address"], c["workspace"]["name"]) if c else print("")' "$pid")
        cur=$(hyprctl activeworkspace -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name",""))')
        if [ -n "$addr" ]; then
            [ -n "$cur" ] && [ "$ws" != "$cur" ] && hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$cur\", follow = false, window = \"address:$addr\" }))" >/dev/null 2>&1
            hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$addr\" }))" >/dev/null 2>&1
        fi
        exit 0
    fi
fi
export LATTE_APP_ARGS="$*"
export LATTE_APP_ARGV="$(printf '%s\n' "$@")"     # jednotlivé argumenty po riadkoch (cesty s medzerami)
export QS_ICON_THEME="${QS_ICON_THEME:-breeze}"      # ikony súborov (mime) a aplikácií; Breeze je v obraze
exec qs -n -p "$qml"
