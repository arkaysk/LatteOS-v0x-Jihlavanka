#!/bin/sh
# latte-goo-greeter — scéna prihlásenia LatteOS GOO vo všeobecnej relácii (LATTEOS-GOO.md §6.2). Spúšťa ju
# latte-greeter (greeter = "goo") vnútri labwc pod účtom prihlasovača; heslo overí greetd cez latte-greetd.
# Scéna beží na jednom monitore (pleamar má pre kópie scény spoločný stav): na tom s najväčším rozlíšením.
mon=$(wlr-randr 2>/dev/null | awk '/^[^ ]/ { n = $1 } /current/ { split($1, a, "x"); if (a[1] * a[2] > best) { best = a[1] * a[2]; m = n } } END { print m }')
cd /usr/share/latteos/goo || { labwc --exit; exit 1; }
LATTE_LOGIN=greetd pleamar --scene login.plm --no-hud ${mon:+--screen "$mon"} > "${XDG_DATA_HOME:-/tmp}/login.log" 2>&1
# scéna skončila (latte-greetd koniec ukončí labwc sám; sem sa dôjde pri páde scény) → koniec všeobecnej relácie
labwc --exit
