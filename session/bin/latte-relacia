#!/usr/bin/env python3
"""latte-relacia — obnovenie relácie: po prihlásení sa okná vrátia tam, kde boli (vzor: hyprsession; vlastné, lebo
hyprsession posiela príkazy Hyprlandu starým spôsobom, ktorý konfigurácia v Lua už neprijíma).

  latte-relacia uloz       zapíše, aké okná sú otvorené a kde (plocha, plávanie, poloha, veľkosť, minimalizované)
  latte-relacia obnov      spustí uložené aplikácie a každú umiestni tam, kde bola (iba keď ešte nie je otvorené nič)
  latte-relacia sleduj     beží s plochou: ukladá každých 10 s, ak sa okná zmenili a zmena vydržala (nie pri odhlásení)
  latte-relacia stav       JSON: zapnuté, kedy uložené, ktoré aplikácie sa obnovia

Vypnutie: ~/.config/latteos/relacia = off (Nastavenia › Spúšťanie a na pozadí). Uložené:
~/.local/state/latteos/relacia.json. Neobnovujú sa: hry (Steam, gamescope), pomocné okná systému a kvapky Goo.
Prehliadače a iné aplikácie, ktoré si okná obnovujú samy, sa spustia raz. Terminál sa otvorí prázdny (bez príkazu,
ktorý v ňom bežal).
"""
import glob, json, os, re, signal, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or HOME + "/.local/state", "latteos", "relacia.json")
SWITCH = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "latteos", "relacia")
# okná, ktoré sa neobnovujú: hry, pomocné okná, prihlásenie a kvapky
SKIP = re.compile(r"^(steam_app_\d+|gamescope|steam|steamwebhelper|xdg-desktop-portal.*|polkit.*|hyprpolkitagent|"
                  r"org\.kde\.polkit.*|pinentry.*|pleamar.*|latte-relacia-skuska)$", re.I)
TERMINALS = {"foot", "footclient", "kitty", "alacritty", "org.wezfurlong.wezterm", "com.mitchellh.ghostty", "ghostty",
             "org.gnome.console", "org.gnome.ptyxis", "konsole", "xterm"}


def on():
    try:
        return open(SWITCH).read().strip() != "off"
    except OSError:
        return True


def hypr(*args):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def latte_apps():
    """titulok okna aplikácie LatteOS („Súbory — LatteOS“) → meno pre latte-app (subory)"""
    m = {}
    for f in glob.glob("/usr/share/latteos/apps/*.qml"):
        try:
            for t in re.findall(r'"([^"\n]{2,40}) — LatteOS"', open(f, encoding="utf-8").read()):
                m.setdefault(t, os.path.basename(f)[:-4])
        except OSError:
            pass
    return m


def command(c, apps):
    """príkaz, ktorým sa aplikácia okna znova spustí; None = neobnovovať"""
    cls = c.get("class") or c.get("initialClass") or ""
    if not cls or SKIP.match(cls) or c.get("pid", 0) <= 0:
        return None
    if cls == "org.quickshell":
        name = (c.get("title") or "").split(" — LatteOS")[0]
        app = apps.get(name)
        return ["latte-app", app] if app and " — LatteOS" in (c.get("title") or "") else None
    pid = c["pid"]
    try:                                                     # aplikácia z Flatpaku: flatpak run <id>
        info = open(f"/proc/{pid}/root/.flatpak-info", encoding="utf-8").read()
        fid = re.search(r"^name=(.+)$", info, re.M)
        if fid:
            return ["flatpak", "run", fid.group(1).strip()]
    except OSError:
        pass
    try:
        argv = [a for a in open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0") if a]
    except OSError:
        return None
    if not argv:
        return None
    if cls.lower() in TERMINALS or os.path.basename(argv[0]).lower() in TERMINALS:
        return [argv[0]]                                     # terminál prázdny, bez príkazu
    return argv


def snapshot():
    try:
        clients = json.loads(hypr("-j", "clients") or "[]")
    except ValueError:
        return None
    apps, out, seen = latte_apps(), [], set()
    for c in sorted(clients, key=lambda c: (c.get("focusHistoryID", 99) * -1)):
        if not c.get("mapped", True):
            continue
        cmd = command(c, apps)
        if not cmd:
            continue
        key = " ".join(cmd)
        if key in seen:                                      # druhé okno tej istej aplikácie: tá si ho obnoví sama
            continue
        seen.add(key)
        ws = c.get("workspace") or {}
        out.append({"cmd": cmd, "class": c.get("class", ""), "title": c.get("title", ""),
                    "workspace": ws.get("name") or str(ws.get("id", "")), "floating": bool(c.get("floating")),
                    "at": c.get("at"), "size": c.get("size"), "fullscreen": c.get("fullscreen", 0)})
    return out


def save(windows):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump({"time": int(time.time()), "windows": windows}, f, ensure_ascii=False, indent=1)
    os.replace(STATE + ".tmp", STATE)


def lua_str(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def shell_join(argv):
    import shlex
    return " ".join(shlex.quote(a) for a in argv)


def restore():
    if not on():
        return 0
    try:
        data = json.load(open(STATE))
    except (OSError, ValueError):
        return 0
    try:
        if json.loads(hypr("-j", "clients") or "[]"):
            return 0                                         # niečo už je otvorené: neobnovovať dvakrát
    except ValueError:
        pass
    n = 0
    for w in data.get("windows", []):
        rules = {}
        ws = str(w.get("workspace") or "")
        if ws.startswith("special:minimized"):
            rules["workspace"] = "special:minimized silent"
        elif ws:
            rules["workspace"] = ws + " silent"
        if w.get("floating") and w.get("at") and w.get("size"):
            rules["float"] = True
            rules["move"] = "%d %d" % tuple(w["at"])
            rules["size"] = "%d %d" % tuple(w["size"])
        if w.get("fullscreen") == 1:
            rules["maximize"] = True
        r = ", ".join(f"{k} = {('true' if v is True else lua_str(v))}" for k, v in rules.items())
        hypr("eval", f"hl.exec_cmd({lua_str(shell_join(w['cmd']))}, {{ {r} }})")
        n += 1
        time.sleep(0.25)                                     # nie všetko naraz: disk a pamäť pri štarte
    if n:
        subprocess.run(["notify-send", "-a", "LatteOS", "-i", "view-restore", "Okná sa vrátili",
                        f"Otvorené aplikácie z minula: {n}. Vypnúť: Nastavenia › Spúšťanie a na pozadí."],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def watch():
    # uloží až zmenu, ktorá vydrží dve kontroly za sebou (10 s): pri odhlásení sa okná zatvárajú postupne a ten
    # medzistav sa nesmie stať reláciou na obnovenie
    last_saved, pending = None, None
    stop = {"x": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(x=True))
    while not stop["x"]:
        if on():
            snap = snapshot()
            if snap is not None:
                sig = json.dumps(snap, sort_keys=True)
                if sig != last_saved:
                    if sig == pending:
                        save(snap)
                        last_saved, pending = sig, None
                    else:
                        pending = sig
        for _ in range(10):
            if stop["x"]:
                break
            time.sleep(1)
    return 0


def main(a):
    c = a[0] if a else "stav"
    if c == "uloz":
        snap = snapshot()
        if snap is None:
            return 1
        save(snap)
        print(f"uložené okná: {len(snap)}")
        return 0
    if c == "obnov":
        return restore()
    if c == "sleduj":
        return watch()
    if c == "stav":
        try:
            data = json.load(open(STATE))
        except (OSError, ValueError):
            data = {}
        print(json.dumps({"on": on(), "time": data.get("time"), "apps": [w.get("class") for w in data.get("windows", [])]},
                         ensure_ascii=False))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
