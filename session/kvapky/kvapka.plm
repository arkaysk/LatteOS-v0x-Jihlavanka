// LatteOS — Kvapka: lišta aplikácií ako tekutá kvapka kávy (prototyp, pleamar 0.1).
// Zámerne nesúmerná: hlava (hrbolček bez očí — kvapky nemajú tvár) stojí vždy na ĽAVOM konci, kvapka rastie
// doprava s každým oknom; bez okien je guľatá, do okraja sa zlieva plynulo, radiálne.
// V pokoji je vpitá do okraja obrazovky (skoro rovina). Keď sa k nej myš priblíži na štvrtinu výšky obrazovky,
// začne sa vysúvať a kým k nej myš dôjde, je napoly vonku, na hrubej stopke pod hlavou.
// Vlastné menu nemá: od okraja sa odtrhne iba chytením a potiahnutím (drag & drop). Stopka sa natiahne a
// pretrhne, kvapka ide za myšou; pustená pri inom okraji sa k nemu prilepí (ako presun panela úloh k inému
// okraju), pustená uprostred skvapalní, stečie a znova sa vynorí tam, kde bola.
// Kreslí sa v „rámci okraja“ (okraj je čiara y = edge, kvapka nad ňou) a skupina ho otočí k zvolenému okraju;
// ikony a nápis stoja rovno, preto sa ich poloha prepočíta do obrazovky (pick podľa `side`).
// Klik na hlavu prepne režim okien (plávajúce → dlaždice → páska), koliesko nad hlavou: páska = posun,
// plávajúce = ďalšie okno.
// Samostatne (relácia LatteOS Kvapky, bez Noctalie: LATTE_VARIANT=kvapky) pribudnú vľavo od hlavy dve malé
// kvapky, tiež vpité do okraja: Hodiny (na mieste Štartu; po rozbalení dashboard) a vypínač (ponuka Vypnúť).
// Na Hodinách visia upozornenia ako farebné kvapôčky; nové do nich spadne a vyleje sa pri nich bublina s textom.
// Kvapky na seba pôsobia:
// keď sa vysúvajú, spájajú ich goo vlákna (vypínač ↔ Štart ↔ hlava), nakláňajú sa k susedovi pod myšou
// a stlačenie jednej prebehne vlnou cez susedov.
// Koncept: AUDIT-WIN11.md › Kvapky.
language 0.1

scene Kvapka {
    surface {
        size: full, full    // celá obrazovka: kvapka sa dá preniesť k ľubovoľnému okraju; kliky berú iba zóny
        anchor: bottom
        margin: 0
        level: top
        reserve: -1     // ignorovať vyhradené pásy (lišta Noctalie): okraj kvapky je skutočný okraj obrazovky
        rate: 60        // pokojný pohyb kvapky nepotrebuje 144 Hz: 12 % → 6 % jadra na RX 640
        keyboard: on_demand while dash   // hľadanie v dashboarde
    }
    permissions { services: "window", "window.*", "clock", "notifications", "notifications.*", "apps", "apps.*"; run: "hyprctl", "cat", "printenv", "curl", "latte-spustac", "latte-ponuka", "latte-kvapky" }

    // zoznam okien priamo zo služby (wlr-foreign-toplevel), bez logiky; ikona podľa triedy okna
    model wins max 10 { id: text; title: text; class: text; active: bool; minimized: bool }
    service window { list: wins }
    // rozloženie guľôčok okien (počíta logika): x, y od hlavy v rámci okraja (y < 0 = preč od okraja), polomer.
    // Okná tej istej aplikácie sa zlepia do strapca ako ikry — čím viac, tým menšie (do 72 %) —, jedno okno je
    // plná guľa; myš nad strapcom ho rozvinie do radu (vejár), okno cez celú obrazovku (tight) všetko zrovná do pásu
    model lay max 10 { x: number; y: number; r: number }
    fact chain_w = 50                        // kde šnúra končí (od hlavy)
    // čas (služba bez logiky); dátum sa skladá tu — `clock.date` je iba po anglicky
    service clock as now { time: text = "--:--"; weekday: number; day: number; month: number; year: number }
    // upozornenia (plní logika, iba v ploche Kvapky — inak by ich prebrala Noctalii), najnovšie prvé;
    // urgency 0 nízka, 1 bežná, 2 kritická
    model notes max 20 { id: number; app: text; title: text; body: text; urgency: number }
    event new_note
    text toast = ""
    // dashboard: vyteká z Hodín (klik na Hodiny). Hľadanie aplikácií (úloha Štartu), upozornenia, pripnuté, počasie.
    fact dash = false
    text query = ""
    text weather = ""
    model results max 6 { name: text; icon: image 26, 26 }
    model pins max 6 { name: text; icon: image 36, 36 }
    fact sel = 0
    measure wday
    fact typing = false                      // v hľadaní je niečo napísané (logika; text sa vo výrazoch neporovnáva)
    event open_result ->
    event pin_open ->
    event note_open ->
    event notes_clear ->
    event hover ->
    event unhover ->
    fact mode: plavajuce | dlazdice | paska = plavajuce
    fact side: dole | hore | vlavo | vpravo = dole   // okraj, pri ktorom lišta je (logika ho pamätá)
    fact pos = 0.4                           // kde na okraji stojí hlava (podiel dĺžky okraja)
    fact pulling = false                     // ťahá sa od okraja (stopka sa naťahuje)
    fact lpress = false                      // základňa stlačená ľavým (klik = režim okien), nie pravým
    fact icon_press = false                  // stlačený hrbolček s oknom (ťahanie z neho kvapku nepresúva)
    fact menu.x = 0                          // kde otvoriť ponuku okna (kurzor pri pravom kliku)
    fact menu.y = 0
    fact free = false                        // odtrhnutá, ide za myšou
    fact melting = false                     // pustená uprostred: steká
    fact tight = false                       // aktívne okno siaha k lište (maximalizované, celá obrazovka, dlaždice):
                                             // kvapka ostane v páse 64 px a cez okno sa nevysunie (logika)
    fact solo = false                        // bez Noctalie: kvapky Štart a vypínač (logika podľa LATTE_VARIANT)
    event cycle ->
    event pick ->
    event wheel_turn ->
    event start_open ->
    event power_open ->
    event side_moved ->
    event win_menu ->

    // obsah je vždy káva (téma je hrnček — materiál okien); líši sa pomerom vody a mlieka:
    // voda ju robí priesvitnou (sklo, ako lungo/americano), mlieko svetlejšou a zakalenou (cappuccino, latte).
    // Voľbu (~/.config/latteos/kava, napr. „latte“) číta logika; fakty 0..1.
    fact voda = 0
    fact mlieko = 0
    prop v = 0 ~gentle
    prop m = 0 ~gentle
    follow v = voda
    follow m = mlieko
    let coffee = mix(mix(#1c0f09, #4a2410, v), #c9a47a, pow(m, 2))   // voda: hnedšia; mlieko svetlejšie, najprv pomaly
    let cream = #f3ebdd
    let ink = mix(#f3ebdd, #2a170c, smooth(0.62, 0.78, m))   // ikony a nápisy na svetlej (mliečnej) káve tmavé
    let edge = 260                           // okraj v rámci kvapky (čiara y = 260, kvapka nad ňou)
    let W = screen.width
    let H = screen.height
    let L = if(side == vlavo or side == vpravo, H, W)     // dĺžka okraja
    let lx = L * pos                         // hlava: ľavý koniec (v rámci okraja)
    let bl = lx - 36                         // ľavý okraj tela
    let sx0 = lx - 92                        // kvapka Hodiny (na mieste Štartu, pokojová poloha)
    let px0 = lx - 158                       // kvapka vypínač
    let n = wins.count
    // Tvar ako tekutina v nízkej gravitácii (goo): nie tuhá kapsula, ale šnúra guľôčok. Hlava vľavo je najväčšia
    // „materská“ kvapka, každé okno je vlastná guľatá kvapka (povrchové napätie), so susedkami ju spája krk
    // (blend) a drží ich tenké vlákno. Kvapky pomaly dýchajú a plávajú, každá inak; aktívne okno je plnšie;
    // pribudnuté alebo zatvorené okno pošle šnúrou vlnu. Bez okien ostane iba hlava — guľa vpitá do okraja.
    // Dlaždice: okná sú na ploche vedľa seba, kvapka je jedna široká „tabuľka“ bez guľôčok.
    let step = if(mode == paska, 46, 56)     // rozostup guľôčok (o trochu menší ako priemer → krk)
    let rr = if(mode == paska, 24, 29)       // polomer guľôčky okna
    let round = if(n < 1, 1, 0)
    prop w = 72 ~lively
    prop h = 72 ~lively
    prop c = 36 ~lively
    follow w = if(round, 72, if(mode == dlazdice, 150 + n * 34, chain_w + 36))
    follow h = if(round, 72, if(mode == dlazdice, 108, 2 * rr + 6))
    follow c = if(round, 36, if(mode == dlazdice, 30, 12))
    // vlákno medzi guľôčkami: tenké; pri dlaždiciach a bez okien je celé telo
    let spine.h = if(round or mode == dlazdice, h, h * 0.34)

    // blízkosť myši kdekoľvek na ploche (cursor.x/y: pleamar sa pýta Hyprlandu, žiadna zóna nekradne kliky):
    // od štvrtiny výšky obrazovky (270 px pri 1080) sa kvapka vysúva, pri nej je vonku na 0,55
    // myš v rámci okraja (inverzia otočenia skupiny nižšie)
    let cu = pick(side, cursor.x, W - cursor.x, cursor.y, H - cursor.y)
    let cv = pick(side, cursor.y - (H - edge), edge - cursor.y, edge - cursor.x, cursor.x - W + edge)
    let dist.x = max(0, max(if(solo, px0 - 30, bl) - cu, cu - (bl + w)))
    let dist.y = max(0, edge - h * 0.6 - cv)
    let approach = 1 - smooth(0, 270, length(dist.x, dist.y))

    // von z okraja: 0 = vpitá do okraja, 0,55 = napoly vonku (myš pri nej), 0,9 = stopka praskne pri ťahaní.
    // Bez odskoku, aby stopka nepreskočila späť. Pri vysúvaní drží telo stopka pod hlavou: stĺpik od okraja
    // k telu, roztavený s oboma koncami (preto je v strede tenší), ktorý sa od 0,4 zužuje, až pri 0,9 zmizne.
    fact probe = 0                           // na skúšky: `pleamar --say kvapka "fact probe 75"` zastaví kvapku na 0,75
    prop pull = 0 ~quick                     // ťahanie myšou od okraja: −1 k okraju … 1 preč
    prop out = 0 ~700ms
    follow out = if(probe > 0, probe / 100, if(pulling and not free, clamp(0.55 + pull * 0.45, 0, 1), if(tight, 0.1, 0.55) * approach))
    // ap: lišta je pri okraji (1) alebo vtiahnutá doň (0) — kým ide za myšou, steká, alebo sa vynára inde
    prop ap = 1 ~600ms
    let sink = h * 0.42
    let bottom = edge + sink * (1 - out) - 48 * out + (h + 44) * (1 - ap)
    let by = bottom - h
    let mid = by + h / 2
    let neck = if(round, 24, 14) * (1 - out) + 16 * 4 * out * (1 - out)
    let stalk.w = 30 * clamp((0.9 - out) / 0.5, 0, 1)
    let stalk.x = lx + 6
    // „voda“ pod okrajom: v pokoji široká (kvapka sa zlieva s okrajom do roviny), vonku úzka pod hlavou
    let water.w = 40 + (w + 90) * (1 - out) * (1 - out)
    let water.x = stalk.x + (bl + w / 2 - stalk.x) * (1 - out)

    // odtrhnutá kvapka (v súradniciach obrazovky): ide za myšou s oneskorením, zaguľatí sa; pri stekaní padá,
    // naťahuje sa a mizne
    prop gx = 0 ~lively
    prop gy = 0 ~lively
    prop gw = 90 ~lively
    prop gh = 90 ~lively
    prop fall = 0 ~1000ms
    prop dockt = 0 ~260ms
    let near.edge = min(min(cursor.x, W - cursor.x), min(cursor.y, H - cursor.y))

    prop wob = 0 ~lively
    prop squish = 0 ~quick
    prop squish.s = 0 ~quick
    prop squish.p = 0 ~quick
    prop nfall = 0 ~700ms                    // nové upozornenie padá do Hodín
    prop toast.p = 0 ~lively                 // bublina s textom nového upozornenia
    on new_note { nfall: 0 ~0ms; nfall: 1 after 20ms; toast.p: 1 after 500ms; toast.p: 0 after 6500ms }
    prop dsh = 0 ~420ms                      // dashboard: 0 = zbalený v Hodinách, 1 = rozliaty
    follow dsh = if(dash, 1, 0)
    on change ap > 0.9 while ap > 0.9 { impulse wob 70 }

    // Štart a vypínač: bez odtrhnutia, iba sa vysunú (pri myši napoly von, ako hlavná kvapka)
    prop so = 0 ~lively
    follow so = if(solo, 1, 0)
    prop lift = 0 ~700ms
    follow lift = approach * if(tight, 0.35, 1)
    // tekutina okolo vypínača a Štartu žije aj bez myši: pomalé toky (flow, flow2 0..1, desiatky sekúnd), kvapky
    // driftujú, mláka pri okraji sa rozlieva a sťahuje, vlákna sa samy tvoria a trhajú; myš (lift) to zosilní
    let flow = 0.5 + 0.5 * noise(time * 0.13 + 1.7)
    let flow2 = 0.5 + 0.5 * noise(time * 0.09 + 5.1)
    let stir = 1 + 1.5 * lift
    // pôsobenie medzi kvapkami: myš nad kvapkou (hs, hp, hh = Štart, vypínač, hlava) ju nafúkne a susedov
    // k nej nakloní; mosty (link) rastú s vysunutím — v pokoji spája kvapky iba okraj
    prop hs = 0 ~lively
    prop hp = 0 ~lively
    prop hh = 0 ~lively
    // most sa vytvorí, keď je medzera medzi kvapkami menšia ako asi polovica `link` (smooth min v pleamare):
    // pri vysúvaní sa preto kvapky k sebe nakláňajú — Štart k telu, vypínač k Štartu
    let sx = sx0 + 18 * lift + 10 * hh - 9 * hp + 6 * stir * noise(time * 0.11 + 3) + 3 * lift * noise(time * 0.45 + 8)
    let px = px0 + 12 * lift + 12 * hs + 5 * stir * noise(time * 0.1 + 4) + 3 * lift * noise(time * 0.5 + 2)
    let hx = lx - 7 * hs
    // v pokoji kvapky pomaly vystupujú z okraja a klesajú (každá v inom rytme), preto vidno aj vlákna a mláku
    // Hodiny sú vidieť stále (aj v pokoji a v úzkom páse): stred 22 px nad okrajom, pri myši o kúsok vyššie
    let s.y = edge - 22 - 10 * lift - 3 * hs - 4 * flow * (1 - lift) + 70 * (1 - ap)
    let p.y = edge + 3 - 26 * lift - 4 * hp - 12 * flow2 * (1 - lift) + 60 * (1 - ap)
    let link = 10 + 16 * lift + 10 * flow
    // goo vlákna: vypínač ↔ Štart a Štart ↔ telo lišty. Hrubnú s priblížením myši; keď sa lišta odtrhne
    // (out → 1), vlákno k nej sa stenčí a pretrhne. Roztavené s oboma koncami (blend), preto uprostred tenšie.
    let thread.ps = 9 * so * max(smooth(0.3, 0.9, lift), 0.8 * smooth(0.55, 0.85, flow))
    let thread.sb = 12 * so * max(smooth(0.2, 0.8, lift), 0.7 * smooth(0.6, 0.9, flow2)) * clamp((0.97 - out) / 0.3, 0, 1)
    // kvapôčka, ktorá tečie po vláknach vypínač → Štart → lišta (iba kde vlákno je)
    let tt = fract(time * 0.07)
    let seg = if(tt < 0.5, 0, 1)
    let tf = if(tt < 0.5, tt * 2, tt * 2 - 1)
    let drip.x = if(seg, sx + 8 + (bl + 18 - sx - 8) * tf, px + (sx - px) * tf)
    let drip.y = if(seg, s.y - 12 + (bottom - 14 - s.y + 12) * tf, p.y - 4 + (s.y - 6 - p.y + 4) * tf)
    let drip.r = 4.5 * if(seg, clamp(thread.sb * ap / 4, 0, 1), clamp(thread.ps / 4, 0, 1))

    // guľôčka každého okna: pružina 0 → 1, zatvorené okno sa vtiahne späť do šnúry; aktívne je plnšie (act)
    repeat k in 0..10 {
        image icon.$k = from wins.$k.class, 30, 30
        prop b.$k = 0 ~lively
        follow b.$k = if(k < n and mode != dlazdice, 1, 0)
        prop act.$k = 0 ~gentle
        follow act.$k = if(k < n and wins.$k.active, 1, 0)
        prop ux.$k = 50 ~gentle
        prop uy.$k = 0 ~gentle
        prop ur.$k = 29 ~gentle
        follow ux.$k = lay.$k.x
        follow uy.$k = lay.$k.y
        follow ur.$k = if(lay.$k.r > 0, lay.$k.r, rr)
    }
    on change n { impulse wob 70 }

    // otvorený dashboard: klik kamkoľvek mimo neho ho zavrie (zóna cez celú obrazovku, pod všetkými ostatnými)
    zone box dash_away { at: W / 2, H / 2; size: W, H; active: dash }

    // objem kvapky: svetlo zhora, lem a tieň z pleamaru, navrch odlesk. Skupina otočí rámec k okraju `side`
    // (otočenie okolo bodu okraja 0, edge a posun; inverzia je cu/cv vyššie).
    group {
        pivot: 0, edge
        rotate: pick(side, 0deg, 180deg, 90deg, -90deg)
        move: pick(side, 0, W, 0, W), pick(side, H - edge, 0 - edge, 0 - edge, H - edge)
        body {
            color: coffee
            opacity: 1 - 0.42 * v * (1 - m)     // voda: priesvitná (obyčajná priehľadnosť, sklo by farbu zmylo)
            light: 16%, by - 40, 34
            rim: 30%
            shadow: 0, 6, 16, 40% * out
            box water { from: water.x - water.w / 2, edge; size: water.w, 70 }
            box { at: bl + w / 2, mid; size: w + wob * 0.1, spine.h * (1 - squish * 0.08); corner: if(mode == dlazdice, c, spine.h / 2); blend: neck }
            box stalk { from: stalk.x - stalk.w / 2, bottom - 12; size: stalk.w, edge - bottom + 24; corner: stalk.w / 2; blend: 16 * clamp(stalk.w / 10, 0, 1) }
            // hlava: najväčšia guľa, trochu vyššie (nesúmernosť), pomaly dýcha
            ellipse { at: hx, mid - 8 - wob * 0.05; radius: (36 + 3 * hh) * (1 + 0.03 * noise(time * 0.4)); blend: 22 }
            // guľôčky okien: každá pláva a dýcha inak (noise podľa k), vlna pri zmene počtu (wob, striedavo)
            ellipse { at: lx + ux.0 + 2 * noise(0.0, time * 0.35), mid + uy.0 + 2.5 * noise(5.0, time * 0.3); radius: ur.0 * b.0 * (1 + 0.035 * noise(0.0, time * 0.5) + 0.12 * act.0) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.1 + 2 * noise(0.7, time * 0.35), mid + uy.1 + 2.5 * noise(6.3, time * 0.3); radius: ur.1 * b.1 * (1 + 0.035 * noise(2.1, time * 0.5) + 0.12 * act.1) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.2 + 2 * noise(1.4, time * 0.35), mid + uy.2 + 2.5 * noise(7.6, time * 0.3); radius: ur.2 * b.2 * (1 + 0.035 * noise(4.2, time * 0.5) + 0.12 * act.2) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.3 + 2 * noise(2.1, time * 0.35), mid + uy.3 + 2.5 * noise(8.9, time * 0.3); radius: ur.3 * b.3 * (1 + 0.035 * noise(6.3, time * 0.5) + 0.12 * act.3) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.4 + 2 * noise(2.8, time * 0.35), mid + uy.4 + 2.5 * noise(10.2, time * 0.3); radius: ur.4 * b.4 * (1 + 0.035 * noise(8.4, time * 0.5) + 0.12 * act.4) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.5 + 2 * noise(3.5, time * 0.35), mid + uy.5 + 2.5 * noise(11.5, time * 0.3); radius: ur.5 * b.5 * (1 + 0.035 * noise(10.5, time * 0.5) + 0.12 * act.5) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.6 + 2 * noise(4.2, time * 0.35), mid + uy.6 + 2.5 * noise(12.8, time * 0.3); radius: ur.6 * b.6 * (1 + 0.035 * noise(12.6, time * 0.5) + 0.12 * act.6) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.7 + 2 * noise(4.9, time * 0.35), mid + uy.7 + 2.5 * noise(14.1, time * 0.3); radius: ur.7 * b.7 * (1 + 0.035 * noise(14.7, time * 0.5) + 0.12 * act.7) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.8 + 2 * noise(5.6, time * 0.35), mid + uy.8 + 2.5 * noise(15.4, time * 0.3); radius: ur.8 * b.8 * (1 + 0.035 * noise(16.8, time * 0.5) + 0.12 * act.8) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.9 + 2 * noise(6.3, time * 0.35), mid + uy.9 + 2.5 * noise(16.7, time * 0.3); radius: ur.9 * b.9 * (1 + 0.035 * noise(18.9, time * 0.5) + 0.12 * act.9) - wob * 0.04; blend: 13 }
            // Štart a vypínač: vlastná „voda“ pod okrajom; s hlavou a medzi sebou ich spája most `link`
            box { from: px - 34 - 14 * flow2 * stir, edge; size: (sx - px + 68 + 28 * flow2 * stir) * so, 70 }
            ellipse { at: sx, s.y; radius: (33 + 3 * hs) * so; scale: 1 + squish.s * 0.08, 1 - squish.s * 0.12; blend: link * so }
            // upozornenia: kvapôčky prilepené hore vľavo na Hodinách (najviac tri) a jedna, ktorá práve padá
            ellipse { at: sx - 25, s.y - 23; radius: 6.5 * so * if(notes.count > 0, 1, 0); blend: 8 }
            ellipse { at: sx - 10, s.y - 34; radius: 5.5 * so * if(notes.count > 1, 1, 0); blend: 8 }
            ellipse { at: sx + 6, s.y - 37; radius: 4.8 * so * if(notes.count > 2, 1, 0); blend: 8 }
            ellipse { at: sx + 4, s.y - 110 + 72 * nfall; radius: 6 * so * if(nfall > 0.02 and nfall < 0.97, 1, 0); scale: 0.85, 1.25; blend: 10 }
            ellipse { at: px, p.y; radius: (19 + 4 * hp) * so; scale: 1 + squish.p * 0.08, 1 - squish.p * 0.12; blend: link * so }
            line { from: px, p.y - 4; to: sx, s.y - 6; width: thread.ps; blend: 12 * clamp(thread.ps / 3, 0, 1) }
            line { from: sx + 8, s.y - 12; to: bl + 18, bottom - 14; width: thread.sb * ap; blend: 14 * clamp(thread.sb * ap / 3, 0, 1) }
            ellipse { at: drip.x, drip.y; radius: drip.r * so; blend: 8 }
        }
        // odlesk: každá guľa odráža svetlo sama (bodka hore vľavo), hlava najväčšiu
        group {
            blur: 1.5
            opacity: 70% * ap
            ellipse { at: hx - 14, mid - 32; radius: 4; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
            repeat k in 0..10 {
                ellipse { at: (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)) - ur.$k * 0.4, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) - ur.$k * 0.52; radius: 0.11 * ur.$k * b.$k; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
            }
        }
        // farba upozornení podľa naliehavosti (nízka mätová, bežná jantárová, kritická červená)
        ellipse { at: sx - 25, s.y - 23; radius: 3.8 * so * if(notes.count > 0, 1, 0); color: pick(notes.0.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx - 10, s.y - 34; radius: 3.2 * so * if(notes.count > 1, 1, 0); color: pick(notes.1.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx + 6, s.y - 37; radius: 2.8 * so * if(notes.count > 2, 1, 0); color: pick(notes.2.urgency, #9ed6bd, #e4b283, #e07a5f) }
        // základňa kvapky: telo (0) a hlava (1) — ľavý klik = režim okien, ťahanie ľavým aj pravým = presun,
        // koliesko = okná, pravý klik nič. Hrbolčeky s oknami (icon_hit) majú vlastné kliky a ležia navrchu.
        repeat z in 0..2 {
            zone box base.$z { at: if(z == 0, bl + w / 2, hx), if(z == 0, mid, by - 4); size: if(z == 0, w, 66), if(z == 0, h, 66); corner: if(z == 0, c, 33); cursor: pointer }
        }
        zone ellipse start_hit { at: sx, s.y; radius: 34; cursor: pointer; active: solo }
        zone ellipse power_hit { at: px, p.y; radius: 19; cursor: pointer; active: solo }
        repeat k in 0..10 {
            zone box icon_hit.$k { at: (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)); size: ur.$k * 1.6, ur.$k * 1.6; corner: ur.$k * 0.8; cursor: pointer; active: k < n and mode != dlazdice and not free }
        }
    }

    // odtrhnutá kvapka: za myšou; pri stekaní padá (smerom dole na obrazovke), naťahuje sa, zmenšuje a kvapká
    body {
        color: coffee
        light: 16%, gy - gh / 2 - 10, 30
        rim: 30%
        shadow: 0, 8, 18, 40%
        opacity: if(free, 1, 0) * (1 - 0.42 * v * (1 - m))
        box { at: gx, gy + 150 * fall; size: gw * (1 - 0.7 * fall), gh * (1 + 0.5 * fall) * (1 - 0.8 * fall); corner: min(gw, gh) / 2 * (1 - 0.7 * fall) }
        ellipse { at: gx - 12, gy + gh * 0.4 + 210 * fall * fall; radius: 9 * fall * (1 - fall) * 4; blend: 10 }
        ellipse { at: gx + 16, gy + gh * 0.3 + 260 * fall * fall; radius: 6 * fall * (1 - fall) * 4; blend: 8 }
    }

    // ikony stoja rovno: bod rámca (u, v) → obrazovka podľa okraja; veľkosť podľa guľôčky
    repeat k in 0..10 {
        image icon.$k { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)), W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3))) - ur.$k * 0.52, pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)), (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35))) - ur.$k * 0.52; size: ur.$k * 1.04, ur.$k * 1.04; opacity: b.$k * ap; show: k < n and mode != dlazdice }
        box { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) - ur.$k * 0.76, W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) + ur.$k * 0.76), pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) + ur.$k * 0.76 + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3)) - ur.$k * 0.76, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35))); size: if(side == vlavo or side == vpravo, 3, 12), if(side == vlavo or side == vpravo, 12, 3); corner: 1.5; color: ink; opacity: ap; show: k < n and wins.$k.active and mode != dlazdice }
    }

    image power_icon = icon "system-shutdown-symbolic", 18, 18
    // Hodiny: čas a dátum stoja rovno v kvapke (bod rámca → obrazovka)
    let cxs = pick(side, sx, W - sx, edge - s.y, W - edge + s.y)
    let cys = pick(side, s.y + H - edge, edge - s.y, sx, H - sx)
    // bublina nového upozornenia: vyleje sa z Hodín smerom od okraja (v obrazovke, text rovno), 6 s
    let vert = if(side == vlavo or side == vpravo, 1, 0)
    let away.x = pick(side, 0, 0, 1, -1)
    let away.y = pick(side, -1, 1, 0, 0)
    let tst.x = cxs + if(vert, away.x * (40 + 170 * toast.p), 170 * toast.p)
    let tst.y = cys + if(vert, 0, away.y * (58 * toast.p))
    body {
        color: coffee
        rim: 30%
        shadow: 0, 6, 16, 30% * toast.p
        opacity: clamp(toast.p * 3, 0, 1) * so
        ellipse { at: cxs, cys; radius: 33 }
        box { at: tst.x, tst.y; size: 40 + 300 * toast.p, 30 + 14 * toast.p; corner: 22; blend: 22 }
    }
    text now.time { at: cxs, cys - 5; anchor: center; size: 16; weight: 800; color: ink; opacity: so * ap; show: solo }
    text pick(now.weekday, "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat") { at: cxs - 2, cys + 12; anchor: right center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap; show: solo }
    text "{now.day}. {now.month}." { at: cxs + 1, cys + 12; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap; show: solo }

    text toast { at: tst.x - 135, tst.y; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 600; color: ink; opacity: clamp(toast.p * 2 - 1, 0, 1) * so; show: solo }

    // ── dashboard (vyteká z Hodín smerom od okraja; v obrazovke, text rovno) ──
    let dw = 560
    let dh = 450
    let dt.x = if(vert, cxs + away.x * (40 + dw / 2), clamp(cxs + 190, dw / 2 + 12, W - dw / 2 - 12))
    let dt.y = if(vert, clamp(cys, dh / 2 + 12, H - dh / 2 - 12), cys + away.y * (40 + dh / 2))
    let dc.x = cxs + (dt.x - cxs) * dsh
    let dc.y = cys + (dt.y - cys) * dsh
    let d0.x = dt.x - dw / 2 + 28              // obsah: ľavý horný roh
    let d0.y = dt.y - dh / 2 + 24
    let dshow = clamp(dsh * 2 - 1, 0, 1)
    body {
        color: coffee
        light: 10%, dc.y - dh / 2, 60
        rim: 30%
        shadow: 0, 10, 30, 40% * dsh
        opacity: if(dsh > 0.01, 1, 0) * so
        ellipse { at: cxs, cys; radius: 34 }
        box { at: dc.x, dc.y; size: 66 + (dw - 66) * dsh, 66 + (dh - 66) * dsh; corner: 33 - 5 * dsh; blend: 30 }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        text now.time { at: d0.x, d0.y + 22; anchor: left center; size: 44; weight: 800; family: "Fraunces"; color: ink }
        text pick(now.weekday, "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday") { at: d0.x, d0.y + 62; anchor: left center; size: 14; weight: 600; color: ink; opacity: 75%; measure: wday }
        text "{now.day}. {now.month}. {now.year}" { at: d0.x + wday.width + 10, d0.y + 62; anchor: left center; size: 14; weight: 600; color: ink; opacity: 75% }
        text weather { at: d0.x + dw - 56, d0.y + 22; anchor: right center; size: 14; weight: 600; color: ink; opacity: 85% }
        // hľadanie (úloha Štartu): píše sa hneď po otvorení
        box { at: d0.x + (dw - 56) / 2, d0.y + 106; size: dw - 56, 40; corner: 20; color: #000000; opacity: 30% }
        input query { at: d0.x + 18, d0.y + 106; width: dw - 92; size: 14; color: ink; placeholder: "Search apps…"; selection: #6b4a33 }
        // výsledky hľadania
        repeat k in 0..6 {
            box { at: d0.x + (dw - 56) / 2, d0.y + 150 + k * 40; size: dw - 56, 36; corner: 12; color: #ffffff; opacity: if(k == sel, 10%, 0); show: typing and k < results.count }
            image results.$k.icon { at: d0.x + 12, d0.y + 137 + k * 40; size: 26, 26; show: typing and k < results.count }
            text results.$k.name { at: d0.x + 48, d0.y + 150 + k * 40; anchor: left center; size: 13.5; color: ink; show: typing and k < results.count }
        }
        text "Nothing found" { at: d0.x, d0.y + 150; anchor: left center; size: 13; color: ink; opacity: 60%; show: typing and results.count < 1 }
        // bez hľadania: upozornenia a pripnuté
        text "NOTIFICATIONS" { at: d0.x, d0.y + 150; anchor: left center; size: 10.5; weight: 800; color: #e4b283; show: not typing }
        text "Clear all" { at: d0.x + dw - 56, d0.y + 150; anchor: right center; size: 11; weight: 700; color: ink; opacity: 70%; show: not typing and notes.count > 0 }
        text "No notifications" { at: d0.x, d0.y + 180; anchor: left center; size: 13; color: ink; opacity: 55%; show: not typing and notes.count < 1 }
        repeat k in 0..4 {
            ellipse { at: d0.x + 6, d0.y + 180 + k * 30; radius: 4; color: pick(notes.$k.urgency, #9ed6bd, #e4b283, #e07a5f); show: not typing and k < notes.count }
            text "{notes.$k.app} · {notes.$k.title}" { at: d0.x + 20, d0.y + 180 + k * 30; anchor: left center; width: dw - 90; lines: 1; size: 13; color: ink; show: not typing and k < notes.count }
        }
        text "PINNED" { at: d0.x, d0.y + 316; anchor: left center; size: 10.5; weight: 800; color: #e4b283; show: not typing }
        repeat k in 0..6 {
            image pins.$k.icon { at: d0.x + k * 84 + 12, d0.y + 334; size: 36, 36; show: not typing and k < pins.count }
            text pins.$k.name { at: d0.x + k * 84 + 30, d0.y + 386; anchor: center; width: 80; lines: 1; size: 10.5; color: ink; opacity: 80%; show: not typing and k < pins.count }
        }
    }
    // dashboard: klikateľné miesta (navrchu)
    zone box dash_card { at: dt.x, dt.y; size: dw, dh; active: dash }
    repeat k in 0..6 {
        zone box res_hit.$k { at: d0.x + (dw - 56) / 2, d0.y + 150 + k * 40; size: dw - 56, 36; cursor: pointer; active: dash and typing and k < results.count }
        zone box pin_hit.$k { at: d0.x + k * 84 + 30, d0.y + 360; size: 76, 76; cursor: pointer; active: dash and not typing and k < pins.count }
    }
    repeat k in 0..4 {
        zone box note_hit.$k { at: d0.x + (dw - 56) / 2, d0.y + 180 + k * 30; size: dw - 56, 28; cursor: pointer; active: dash and not typing and k < notes.count }
    }
    zone box clear_hit { at: d0.x + dw - 90, d0.y + 150; size: 90, 24; cursor: pointer; active: dash and not typing and notes.count > 0 }
    image power_icon { at: pick(side, px, W - px, edge - p.y, W - edge + p.y) - 8, pick(side, p.y + H - edge, edge - p.y, px, H - px) - 8; size: 16, 16; tint: ink; opacity: so * (0.4 + 0.6 * lift) * ap; show: solo }

    text pick(mode, "Floating windows", "Tiles", "Endless strip") { at: pick(side, lx - 30, W - lx - 30, edge - by + 40, W - edge + by - 150), pick(side, by - 56 + H - edge, edge - by + 56, lx - 60, H - lx - 60); anchor: left center; size: 12; weight: 700; color: ink; opacity: 70% * out * ap * if(tight, 0, 1) }

    // základňa: vlastné menu nemá. Ľavý klik (bez ťahania) prepne režim okien. Chytiť ľavým alebo pravým a ťahať
    // od okraja: stopka sa naťahuje (pull), pri 0,9 praskne a kvapka ide za myšou; pustená pri okraji (do 170 px)
    // sa k nemu prilepí, inde steká a vynorí sa, kde bola. Pustená skôr, než stopka praskne: vráti sa.
    // Ťahanie, ktoré začalo na hrbolčeku s oknom (icon_press), kvapku nepresúva.
    repeat z in 0..2 {
        on press base.$z { lpress = true; squish: 1 }
        on press right base.$z { lpress = false; squish: 1 }
        on drag base.$z while not free and not icon_press { pull: clamp(pick(side, 0 - drag.dy, drag.dy, drag.dx, 0 - drag.dx) / 90, -1, 1) ~0ms }
        on drag base.$z while not free and not icon_press and abs(drag.dx) + abs(drag.dy) > 6 { pulling = true }
        on drag base.$z while free { gx: pointer.x; gy: pointer.y }
        on release base.$z while not free and not pulling and lpress { emit cycle; squish.s: 0.5 after 70ms; squish.p: 0.35 after 140ms }
        on release base.$z while not free { pulling = false; pull: 0; squish: 0; squish.s: 0 after 140ms; squish.p: 0 after 210ms }
        on release base.$z while free and near.edge < 170 and near.edge == H - cursor.y { side = dole; pos = clamp(cursor.x / W, 0.1, 0.6); gx: cursor.x; gy: H; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.y { side = hore; pos = clamp((W - cursor.x) / W, 0.1, 0.6); gx: cursor.x; gy: 0; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.x { side = vlavo; pos = clamp(cursor.y / H, 0.1, 0.6); gx: 0; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == W - cursor.x { side = vpravo; pos = clamp((H - cursor.y) / H, 0.1, 0.6); gx: W; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge >= 170 { melting = true }
        on release base.$z while free { pulling = false; pull: 0; squish: 0 }
        // koliesko nad kvapkou (aj nad hrbolčekmi): páska = posun, plávajúce = ďalšie okno
        on scroll base.$z { emit wheel_turn(wheel) }
    }
    on change out > 0.9 while out > 0.9 and pulling and not free { free = true; ap: 0 ~0ms; gx: cursor.x ~0ms; gy: cursor.y ~0ms; gw: w ~0ms; gh: h ~0ms; gw: 90 after 30ms; gh: 90 after 30ms; fall: 0 ~0ms }
    on change melting while melting { fall: 1 }
    // prilepenie: kvapka dobehne k okraju, potom sa lišta vynorí z okraja na novom mieste
    on change dockt > 0.95 while dockt > 0.95 { free = false; dockt: 0 ~0ms; ap: 1; emit side_moved }
    // stečenie: po páde sa lišta vynorí na starom mieste
    on change fall > 0.95 while fall > 0.95 and melting { free = false; melting = false; fall: 0 ~0ms; ap: 1 }
    // stlačenie prebehne vlnou cez susedov (vypínač → Štart → hlava a naopak)
    on press start_hit { toggle dash; squish.s: 1; squish.p: 0.5 after 70ms; squish: 0.4 after 70ms }
    on release start_hit { squish.s: 0; squish.p: 0 after 70ms; squish: 0 after 70ms }
    on press power_hit { emit power_open; squish.p: 1; squish.s: 0.5 after 70ms; squish: 0.3 after 140ms }
    on release power_hit { squish.p: 0; squish.s: 0 after 70ms; squish: 0 after 140ms }
    // dashboard: otvorenie dá kurzor do hľadania; Esc alebo klik mimo zavrie; ↑↓ a Enter vo výsledkoch
    on change dash while dash { focus query }
    on press dash_away { dash = false }
    on key Escape while dash { dash = false }
    on key Down while dash { sel = min(sel + 1, max(results.count - 1, 0)) }
    on key Up while dash { sel = max(sel - 1, 0) }
    on submit query { emit open_result(sel) }
    repeat k in 0..6 {
        on press res_hit.$k { emit open_result(k) }
        on press pin_hit.$k { emit pin_open(k) }
    }
    repeat k in 0..4 {
        on press note_hit.$k { emit note_open(k) }
    }
    on press clear_hit { emit notes_clear }
    on enter start_hit { hs: 1 }
    on leave start_hit { hs: 0 }
    on enter power_hit { hp: 1 }
    on leave power_hit { hp: 0 }
    on enter base.1 { hh: 1 }
    on leave base.1 { hh: 0 }
    // hrbolček s oknom: ľavý klik = prepnúť naň (aktívne okno sa minimalizuje, ako vo Windows),
    // pravý klik = ponuka okna
    repeat k in 0..10 {
        on press icon_hit.$k { icon_press = true; emit pick(k) }
        on enter icon_hit.$k { emit hover(k) }
        on leave icon_hit.$k { emit unhover(k) }
        on press right icon_hit.$k { icon_press = true; menu.x = cursor.x; menu.y = cursor.y; emit win_menu(k) }
        on release icon_hit.$k { icon_press = false }
    }

    translations sk {
        "Search apps…" = "Hľadať aplikácie…"
        "Nothing found" = "Nič sa nenašlo"
        "NOTIFICATIONS" = "UPOZORNENIA"
        "Clear all" = "Vymazať všetko"
        "No notifications" = "Žiadne upozornenia"
        "PINNED" = "PRIPNUTÉ"
        "Sunday" = "nedeľa"
        "Monday" = "pondelok"
        "Tuesday" = "utorok"
        "Wednesday" = "streda"
        "Thursday" = "štvrtok"
        "Friday" = "piatok"
        "Saturday" = "sobota"
        "Sun" = "ne"
        "Mon" = "po"
        "Tue" = "ut"
        "Wed" = "st"
        "Thu" = "št"
        "Fri" = "pi"
        "Sat" = "so"
        "Floating windows" = "Plávajúce okná"
        "Tiles" = "Dlaždice"
        "Endless strip" = "Nekonečná páska"
    }
}
