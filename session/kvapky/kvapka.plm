    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.6.icon { at: wp.x.6 - 11, wp.y.6 - 11 - if(wdg.6.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.6 * if(wdg.6.on, 100%, 55%); show: 6 < wdg.count and wdg.6.mono }
    image wdg.6.icon { at: wp.x.6 - 12, wp.y.6 - 12; size: 24, 24; opacity: wb.6 * if(wdg.6.on, 100%, 55%); show: 6 < wdg.count and not wdg.6.mono }
    text wdg.6.val { at: wp.x.6, wp.y.6 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.6; show: 6 < wdg.count }
    zone ellipse w_hit.6 { at: wp.x.6, wp.y.6; radius: 24; cursor: pointer; active: 6 < wdg.count and not dash }
    on press w_hit.6 { wdrag = 6; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.6 while wdrag == 6 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.6 while wdrag == 6 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.6 300; emit w_drop(6); wmoved = false; wdrag = -1 }
    on release w_hit.6 while wdrag == 6 and not wmoved { wdrag = -1; impulse wwob.6 120; emit w_click(6) }
    on press right w_hit.6 while wdg.6.right { impulse wwob.6 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(6) }
    on scroll w_hit.6 while wdg.6.wheel { emit w_wheel(6 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.6 { wh.6: 1 }
    on leave w_hit.6 { wh.6: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.7.icon { at: wp.x.7 - 11, wp.y.7 - 11 - if(wdg.7.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.7 * if(wdg.7.on, 100%, 55%); show: 7 < wdg.count and wdg.7.mono }
    image wdg.7.icon { at: wp.x.7 - 12, wp.y.7 - 12; size: 24, 24; opacity: wb.7 * if(wdg.7.on, 100%, 55%); show: 7 < wdg.count and not wdg.7.mono }
    text wdg.7.val { at: wp.x.7, wp.y.7 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.7; show: 7 < wdg.count }
    zone ellipse w_hit.7 { at: wp.x.7, wp.y.7; radius: 24; cursor: pointer; active: 7 < wdg.count and not dash }
    on press w_hit.7 { wdrag = 7; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.7 while wdrag == 7 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.7 while wdrag == 7 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.7 300; emit w_drop(7); wmoved = false; wdrag = -1 }
    on release w_hit.7 while wdrag == 7 and not wmoved { wdrag = -1; impulse wwob.7 120; emit w_click(7) }
    on press right w_hit.7 while wdg.7.right { impulse wwob.7 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(7) }
    on scroll w_hit.7 while wdg.7.wheel { emit w_wheel(7 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.7 { wh.7: 1 }
    on leave w_hit.7 { wh.7: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.8.icon { at: wp.x.8 - 11, wp.y.8 - 11 - if(wdg.8.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.8 * if(wdg.8.on, 100%, 55%); show: 8 < wdg.count and wdg.8.mono }
    image wdg.8.icon { at: wp.x.8 - 12, wp.y.8 - 12; size: 24, 24; opacity: wb.8 * if(wdg.8.on, 100%, 55%); show: 8 < wdg.count and not wdg.8.mono }
    text wdg.8.val { at: wp.x.8, wp.y.8 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.8; show: 8 < wdg.count }
    zone ellipse w_hit.8 { at: wp.x.8, wp.y.8; radius: 24; cursor: pointer; active: 8 < wdg.count and not dash }
    on press w_hit.8 { wdrag = 8; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.8 while wdrag == 8 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.8 while wdrag == 8 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.8 300; emit w_drop(8); wmoved = false; wdrag = -1 }
    on release w_hit.8 while wdrag == 8 and not wmoved { wdrag = -1; impulse wwob.8 120; emit w_click(8) }
    on press right w_hit.8 while wdg.8.right { impulse wwob.8 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(8) }
    on scroll w_hit.8 while wdg.8.wheel { emit w_wheel(8 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.8 { wh.8: 1 }
    on leave w_hit.8 { wh.8: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.9.icon { at: wp.x.9 - 11, wp.y.9 - 11 - if(wdg.9.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.9 * if(wdg.9.on, 100%, 55%); show: 9 < wdg.count and wdg.9.mono }
    image wdg.9.icon { at: wp.x.9 - 12, wp.y.9 - 12; size: 24, 24; opacity: wb.9 * if(wdg.9.on, 100%, 55%); show: 9 < wdg.count and not wdg.9.mono }
    text wdg.9.val { at: wp.x.9, wp.y.9 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.9; show: 9 < wdg.count }
    zone ellipse w_hit.9 { at: wp.x.9, wp.y.9; radius: 24; cursor: pointer; active: 9 < wdg.count and not dash }
    on press w_hit.9 { wdrag = 9; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.9 while wdrag == 9 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.9 while wdrag == 9 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.9 300; emit w_drop(9); wmoved = false; wdrag = -1 }
    on release w_hit.9 while wdrag == 9 and not wmoved { wdrag = -1; impulse wwob.9 120; emit w_click(9) }
    on press right w_hit.9 while wdg.9.right { impulse wwob.9 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(9) }
    on scroll w_hit.9 while wdg.9.wheel { emit w_wheel(9 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.9 { wh.9: 1 }
    on leave w_hit.9 { wh.9: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.10.icon { at: wp.x.10 - 11, wp.y.10 - 11 - if(wdg.10.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.10 * if(wdg.10.on, 100%, 55%); show: 10 < wdg.count and wdg.10.mono }
    image wdg.10.icon { at: wp.x.10 - 12, wp.y.10 - 12; size: 24, 24; opacity: wb.10 * if(wdg.10.on, 100%, 55%); show: 10 < wdg.count and not wdg.10.mono }
    text wdg.10.val { at: wp.x.10, wp.y.10 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.10; show: 10 < wdg.count }
    zone ellipse w_hit.10 { at: wp.x.10, wp.y.10; radius: 24; cursor: pointer; active: 10 < wdg.count and not dash }
    on press w_hit.10 { wdrag = 10; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.10 while wdrag == 10 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.10 while wdrag == 10 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.10 300; emit w_drop(10); wmoved = false; wdrag = -1 }
    on release w_hit.10 while wdrag == 10 and not wmoved { wdrag = -1; impulse wwob.10 120; emit w_click(10) }
    on press right w_hit.10 while wdg.10.right { impulse wwob.10 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(10) }
    on scroll w_hit.10 while wdg.10.wheel { emit w_wheel(10 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.10 { wh.10: 1 }
    on leave w_hit.10 { wh.10: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.11.icon { at: wp.x.11 - 11, wp.y.11 - 11 - if(wdg.11.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.11 * if(wdg.11.on, 100%, 55%); show: 11 < wdg.count and wdg.11.mono }
    image wdg.11.icon { at: wp.x.11 - 12, wp.y.11 - 12; size: 24, 24; opacity: wb.11 * if(wdg.11.on, 100%, 55%); show: 11 < wdg.count and not wdg.11.mono }
    text wdg.11.val { at: wp.x.11, wp.y.11 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.11; show: 11 < wdg.count }
    zone ellipse w_hit.11 { at: wp.x.11, wp.y.11; radius: 24; cursor: pointer; active: 11 < wdg.count and not dash }
    on press w_hit.11 { wdrag = 11; wmoved = false; wd.w = W; wd.h = H }
    on drag w_hit.11 while wdrag == 11 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.11 while wdrag == 11 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.11 300; emit w_drop(11); wmoved = false; wdrag = -1 }
    on release w_hit.11 while wdrag == 11 and not wmoved { wdrag = -1; impulse wwob.11 120; emit w_click(11) }
    on press right w_hit.11 while wdg.11.right { impulse wwob.11 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(11) }
    on scroll w_hit.11 while wdg.11.wheel { emit w_wheel(11 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.11 { wh.11: 1 }
    on leave w_hit.11 { wh.11: 0 }
    // <<< kvapky widgetov

    // ── ponuka Vypnúť (vyteká z kvapky vypínača smerom od okraja) ──
    let pxs = pick(side, px, W - px, edge - p.y, W - edge + p.y)
    let pys = pick(side, p.y + H - edge, edge - p.y, px, H - px)
    let pw = 230
    let ph = 5 * 42 + 22
    let pt.x = if(vert, pxs + away.x * (30 + pw / 2), clamp(pxs + pw / 2 - 34, pw / 2 + 12, W - pw / 2 - 12))
    let pt.y = if(vert, clamp(pys, ph / 2 + 12, H - ph / 2 - 12), pys + away.y * (30 + ph / 2))
    let pk.x = clamp(pxs, pt.x - pw / 2 + 20, pt.x + pw / 2 - 20)
    let pk.y = clamp(pys, pt.y - ph / 2 + 20, pt.y + ph / 2 - 20)
    let p.swim = smooth(0, 0.45, pm)
    let p.grow = smooth(0.3, 1, pm)
    let pb.x = pxs + (pk.x - pxs) * p.swim
    let pb.y = pys + (pk.y - pys) * p.swim
    let pc.x = pk.x + (pt.x - pk.x) * p.grow
    let pc.y = pk.y + (pt.y - pk.y) * p.grow
    let p0.y = pt.y - ph / 2 + 11
    body {
        color: coffee
        rim: 30%
        shadow: 0, 10, 26, 40% * pm
        opacity: if(pm > 0.01, 1, 0) * so
        ellipse { at: pb.x, pb.y; radius: 20 * if(p.grow > 0.02, 0, 1) }
        box { at: if(p.grow > 0.02, pc.x, pb.x), if(p.grow > 0.02, pc.y, pb.y); size: 40 + (pw - 40) * p.grow, 40 + (ph - 40) * p.grow; corner: 20 - 4 * p.grow }
    }
    // riadky ponuky ako kapsuly zliate do tekutého stĺpca; riadok pod myšou sa vydutí
    body {
        color: mix(coffee, #f3ebdd, 0.08)
        rim: 25%
        opacity: clamp(pm * 2 - 1, 0, 1) * so
        box { at: pt.x + 4 * pmh.0, p0.y + 21 + 0 * 42; size: pw - 30 + 10 * pmh.0, 35 + 5 * pmh.0; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.1, p0.y + 21 + 1 * 42; size: pw - 30 + 10 * pmh.1, 35 + 5 * pmh.1; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.2, p0.y + 21 + 2 * 42; size: pw - 30 + 10 * pmh.2, 35 + 5 * pmh.2; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.3, p0.y + 21 + 3 * 42; size: pw - 30 + 10 * pmh.3, 35 + 5 * pmh.3; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.4, p0.y + 21 + 4 * 42; size: pw - 30 + 10 * pmh.4, 35 + 5 * pmh.4; corner: 18; blend: 16 }
    }
    image pm_i.0 = icon "system-lock-screen-symbolic", 18, 18
    image pm_i.1 = icon "system-log-out-symbolic", 18, 18
    image pm_i.2 = icon "weather-clear-night-symbolic", 18, 18
    image pm_i.3 = icon "system-reboot-symbolic", 18, 18
    image pm_i.4 = icon "system-shutdown-symbolic", 18, 18
    group {
        opacity: clamp(pm * 2 - 1, 0, 1)
        show: pm > 0.5
        repeat k in 0..5 {
            image pm_i.$k { at: pt.x - pw / 2 + 20, p0.y + 12 + k * 42; size: 18, 18; tint: if(k == 4, #e07a5f, ink) }
            text pick(k, "Lock", "Sign out", "Sleep", "Restart", "Shut down") { at: pt.x - pw / 2 + 50, p0.y + 21 + k * 42; anchor: left center; size: 13.5; weight: 600; color: ink }
        }
    }
    repeat k in 0..5 {
        zone box pm_hit.$k { at: pt.x, p0.y + 21 + k * 42; size: pw - 16, 38; cursor: pointer; active: pmenu }
    }
    image power_icon { at: pick(side, px, W - px, edge - p.y, W - edge + p.y) - 8, pick(side, p.y + H - edge, edge - p.y, px, H - px) - 8; size: 16, 16; tint: ink; opacity: so * (0.4 + 0.6 * lift.p) * ap * (1 - smooth(0, 0.2, pm)); show: solo }

    text pick(mode, "Floating windows", "Tiles", "Endless strip") { at: pick(side, lx - 30, W - lx - 30, edge - by + 40, W - edge + by - 150), pick(side, by - 56 + H - edge, edge - by + 56, lx - 60, H - lx - 60); anchor: left center; size: 12; weight: 700; color: ink; opacity: 70% * out * ap * if(tight or dash or pmenu, 0, 1) }

    // základňa: vlastné menu nemá. Ľavý klik (bez ťahania) prepne režim okien. Chytiť ľavým alebo pravým a ťahať
    // od okraja: stopka sa naťahuje (pull), pri 0,9 praskne a kvapka ide za myšou; pustená pri okraji (do 170 px)
    // sa k nemu prilepí, inde steká a vynorí sa, kde bola. Pustená skôr, než stopka praskne: vráti sa.
    // Ťahanie, ktoré začalo na hrbolčeku s oknom (icon_press), kvapku nepresúva.
    repeat z in 0..2 {
        // (30. 9.) režim prepína iba hlava (v nej je obraz režimu): klik vedľa guľôčky na telo pásku prepol na dlaždice
        // (30. 9.) pravý klik na goo nerobí nič — okrem guľôčok okien (ponuka okna), ako na paneli úloh vo Windows
        on press base.$z { lpress = z == 1; ldrag = true; squish: 1 }
        on press right base.$z { lpress = false; ldrag = false }
        on drag base.$z while ldrag and not free and not icon_press { pull: clamp(pick(side, 0 - drag.dy, drag.dy, drag.dx, 0 - drag.dx) / 90, -1, 1) ~0ms }
        on drag base.$z while ldrag and not free and not icon_press and abs(drag.dx) + abs(drag.dy) > 6 { pulling = true }
        on drag base.$z while ldrag and free { gx: pointer.x; gy: pointer.y }
        on release base.$z while not free and not pulling and lpress { emit cycle; squish.s: 0.5 after 70ms; squish.p: 0.35 after 140ms }
        on release base.$z while not free { pulling = false; pull: 0; squish: 0; squish.s: 0 after 140ms; squish.p: 0 after 210ms }
        on release base.$z while free and near.edge < 170 and near.edge == H - cursor.y { side = dole; pos = clamp(cursor.x / W, 0.1, 0.6); gx: cursor.x; gy: H; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.y { side = hore; pos = clamp((W - cursor.x) / W, 0.1, 0.6); gx: cursor.x; gy: 0; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.x { side = vlavo; pos = clamp(cursor.y / H, 0.1, 0.6); gx: 0; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == W - cursor.x { side = vpravo; pos = clamp((H - cursor.y) / H, 0.1, 0.6); gx: W; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge >= 170 { melting = true }
        on release base.$z while free { pulling = false; pull: 0; squish: 0 }
        // koliesko nad kvapkou (aj nad hrbolčekmi): páska = posun, plávajúce = ďalšie okno
        on scroll base.$z { emit wheel_turn(wheel) }
    }
    on change out > 0.9 while out > 0.9 and pulling and not free { free = true; ap: 0 ~0ms; gx: cursor.x ~0ms; gy: cursor.y ~0ms; gw: w ~0ms; gh: h ~0ms; gw: 90 after 30ms; gh: 90 after 30ms; fall: 0 ~0ms }
    on change melting while melting { fall: 1 }
    // prilepenie: kvapka dobehne k okraju, potom sa lišta vynorí z okraja na novom mieste
    on change dockt > 0.95 while dockt > 0.95 { free = false; dockt: 0 ~0ms; ap: 1; emit side_moved }
    // stečenie: po páde sa lišta vynorí na starom mieste
    on change fall > 0.95 while fall > 0.95 and melting { free = false; melting = false; fall: 0 ~0ms; ap: 1 }
    // stlačenie prebehne vlnou cez susedov (vypínač → Štart → hlava a naopak)
    // TimeGoo: ľavý klik (alebo Win) otvorí / zavrie spúšťač; pravý = časové menu — záložka Čas z klasického
    // LatteOS (pásma, stopky, minútka, budíky, well-being), 1. 10.
    on press start_hit { toggle dash; pmenu = false }
    on press right start_hit { dash = false; pmenu = false; emit time_menu }
    on press start_hit { squish.s: 1; squish.p: 0.5 after 70ms; squish: 0.4 after 70ms }
    on release start_hit { squish.s: 0; squish.p: 0 after 70ms; squish: 0 after 70ms }
    on press power_hit { toggle pmenu; dash = false; squish.p: 1; squish.s: 0.5 after 70ms; squish: 0.3 after 140ms }
    on change dash while dash { pmenu = false }
    repeat k in 0..5 {
        on press pm_hit.$k { emit power_do(k) }
        on enter pm_hit.$k { pm_hot = k }
        on leave pm_hit.$k { pm_hot = -1 }
    }
    on release power_hit { squish.p: 0; squish.s: 0 after 70ms; squish: 0 after 140ms }
    // spúšťač: otvorenie dá kurzor do poľa; Esc zavrie ponuku, výber režimu, predpoveď, premenovanie, potom spúšťač;
    // klik mimo zavrie
    on change dash while dash { focus query }
    on change dash while not dash { ctx_open = false; mode_open = false; wx_detail = false }
    on press dash_away { dash = false; pmenu = false }
    on key Escape while ctx_open { ctx_open = false }
    on key Escape while dash and not ctx_open and mode_open { mode_open = false }
    on key Escape while dash and not ctx_open and not mode_open and wx_detail { wx_detail = false }
    on key Escape while dash and not ctx_open and not mode_open and not wx_detail and renaming { emit query_submit(-1) }
    on key Escape while dash and not ctx_open and not mode_open and not wx_detail and not renaming { dash = false }
    on key Down while dash and not ctx_open { emit sel_move(1) }
    on key Up while dash and not ctx_open { emit sel_move(-1) }
    on submit query { emit query_submit(1) }
    on dash_toggle { toggle dash; pmenu = false }
    // ikona režimu: klik rozbalí výber, koliesko točí režimy; Tab = ďalší režim (doplnok k myši)
    on press mode_btn { toggle mode_open; ctx_open = false }
    on scroll mode_btn { smode = smode + if(wheel > 0, 4, 1) - 5 * floor((smode + if(wheel > 0, 4, 1)) / 5); mode_open = false }
    on key Tab while dash and not ctx_open { smode = smode + 1 - 5 * floor((smode + 1) / 5); mode_open = false }
    on press mode_away { mode_open = false }
    repeat k in 0..5 {
        on press mode_row.$k { smode = k; mode_open = false; focus query }
        on enter mode_row.$k { mode_hot = k }
        on leave mode_row.$k { mode_hot = -1 }
    }
    // riadky: ľavý klik otvorí, pravý = ponuka (pridať do záložky, otvoriť priečinok…)
    repeat k in 0..10 {
        on press hit_row.$k { emit open_hit(k) }
        on press right hit_row.$k { sel = k; ctx_up = false; ctx.x = mx; ctx.y = my; emit hit_menu(k) }
        on enter hit_row.$k { hit_hot = k }
        on leave hit_row.$k { hit_hot = -1 }
    }
    // obľúbené: ľavý klik spustí, pravý = ponuka (odobrať, posunúť)
    repeat k in 0..18 {
        on press fav_hit.$k { emit fav_open(k) }
        on press right fav_hit.$k { ctx_up = false; ctx.x = mx; ctx.y = my; emit fav_menu(k) }
        on enter fav_hit.$k { fav_hot = k }
        on leave fav_hit.$k { fav_hot = -1 }
    }
    // rozhovor: koliesko roluje, pravý klik na bublinu = kopírovať
    on press ai_stop { emit ai_cancel }
    on scroll chat_zone { chst = clamp(chst - wheel * 60, 0, max(0, chh - 340)) }
    repeat k in 0..8 {
        on press right bub_hit.$k { ctx_up = false; ctx.x = mx; ctx.y = my; emit bubble_menu(k) }
    }
    // čipy: ľavý klik = akcia alebo rozbaľovacia ponuka (nahor), pravý = ponuka záložky
    repeat k in 0..7 {
        on press chip_hit.$k { ctx_up = true; ctx.x = chx.$k; ctx.y = yc - 16; mode_open = false; emit chip_pick(k) }
        on press right chip_hit.$k { ctx_up = true; ctx.x = chx.$k; ctx.y = yc - 16; mode_open = false; emit chip_menu(k) }
        on enter chip_hit.$k { chip_hot = k }
        on leave chip_hit.$k { chip_hot = -1 }
    }
    // počasie: Dnes / Zajtra / Týždeň, Detaily = predpoveď v obsahu (znova = zavrieť)
    repeat k in 0..3 {
        on press wxs_hit.$k { wx_view = k; emit wx_pick(k) }
        on enter wxs_hit.$k { wx_hot = k }
        on leave wxs_hit.$k { wx_hot = -1 }
    }
    on press wxd_hit { toggle wx_detail; mode_open = false }
    on enter wxd_hit { wx_hot = 3 }
    on leave wxd_hit { wx_hot = -1 }
    // kontextová ponuka
    on press ctx_away { ctx_open = false }
    on press right ctx_away { ctx_open = false }
    repeat k in 0..10 {
        on press ctx_row.$k { ctx_open = false; emit ctx_pick(k) }
        on enter ctx_row.$k { ctx_hot = k }
        on leave ctx_row.$k { ctx_hot = -1 }
    }
    on enter start_hit { hs: 1 }
    on leave start_hit { hs: 0 }
    on enter power_hit { hp: 1 }
    on leave power_hit { hp: 0 }
    on enter base.1 { hh: 1 }
    on leave base.1 { hh: 0 }
    // hrbolček s oknom: ľavý klik = prepnúť naň (aktívne okno sa minimalizuje, ako vo Windows),
    // pravý klik = ponuka okna
    repeat k in 0..48 {
        on press icon_hit.$k { icon_press = true; bdrag = k; bmoved = false; bsnap = false }
        // vlákno ako sliz: nad 180 px praskne (guľôčka sa zachveje), keď ju vrátiš bližšie ako 70 px, zlepí sa znova
        on drag icon_hit.$k while bdrag == k and not bsnap and length(bdx, bdy) > 180 { bsnap = true; impulse wob 45 }
        on drag icon_hit.$k while bdrag == k and bsnap and length(bdx, bdy) < 70 { bsnap = false; impulse wob 25 }
        on drag icon_hit.$k while bdrag == k { bdx: pick(side, drag.dx, 0 - drag.dx, drag.dy, 0 - drag.dy) ~0ms; bdy: pick(side, drag.dy, 0 - drag.dy, 0 - drag.dx, drag.dx) ~0ms }
        on drag icon_hit.$k while bdrag == k and abs(drag.dx) + abs(drag.dy) > 8 { bmoved = true }
        on release icon_hit.$k while not bmoved { emit pick(k) }
        on release icon_hit.$k while bmoved { emit bead_drop(k) }
        on enter icon_hit.$k { emit hover(k) }
        on leave icon_hit.$k { emit unhover(k) }
        on press right icon_hit.$k { icon_press = true; bdrag = -1; menu.x = cursor.x; menu.y = cursor.y; emit win_menu(k) }
        on release icon_hit.$k { icon_press = false; bdx: 0; bdy: 0; impulse wob 40 }
    }

    translations sk {
