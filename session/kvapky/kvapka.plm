            line { from: lx + ux.30 + 2 * noise(21.0, time * 0.35) + if(bdrag == 30, bdx, 0), mid + uy.30 + 2.5 * noise(44.0, time * 0.3) + if(bdrag == 30, bdy, 0); to: lx + kx.30, if(uy.30 > -3, edge + 14, mid + ky.30); width: ur.30 * b.30 * 0.3 * if(bdrag == 30, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 30 and bsnap, 0, 1) }
            line { from: lx + ux.31 + 2 * noise(21.7, time * 0.35) + if(bdrag == 31, bdx, 0), mid + uy.31 + 2.5 * noise(45.3, time * 0.3) + if(bdrag == 31, bdy, 0); to: lx + kx.31, if(uy.31 > -3, edge + 14, mid + ky.31); width: ur.31 * b.31 * 0.3 * if(bdrag == 31, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 31 and bsnap, 0, 1) }
            line { from: lx + ux.32 + 2 * noise(22.4, time * 0.35) + if(bdrag == 32, bdx, 0), mid + uy.32 + 2.5 * noise(46.6, time * 0.3) + if(bdrag == 32, bdy, 0); to: lx + kx.32, if(uy.32 > -3, edge + 14, mid + ky.32); width: ur.32 * b.32 * 0.3 * if(bdrag == 32, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 32 and bsnap, 0, 1) }
            line { from: lx + ux.33 + 2 * noise(23.1, time * 0.35) + if(bdrag == 33, bdx, 0), mid + uy.33 + 2.5 * noise(47.9, time * 0.3) + if(bdrag == 33, bdy, 0); to: lx + kx.33, if(uy.33 > -3, edge + 14, mid + ky.33); width: ur.33 * b.33 * 0.3 * if(bdrag == 33, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 33 and bsnap, 0, 1) }
            line { from: lx + ux.34 + 2 * noise(23.8, time * 0.35) + if(bdrag == 34, bdx, 0), mid + uy.34 + 2.5 * noise(49.2, time * 0.3) + if(bdrag == 34, bdy, 0); to: lx + kx.34, if(uy.34 > -3, edge + 14, mid + ky.34); width: ur.34 * b.34 * 0.3 * if(bdrag == 34, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 34 and bsnap, 0, 1) }
            line { from: lx + ux.35 + 2 * noise(24.5, time * 0.35) + if(bdrag == 35, bdx, 0), mid + uy.35 + 2.5 * noise(50.5, time * 0.3) + if(bdrag == 35, bdy, 0); to: lx + kx.35, if(uy.35 > -3, edge + 14, mid + ky.35); width: ur.35 * b.35 * 0.3 * if(bdrag == 35, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 35 and bsnap, 0, 1) }
            line { from: lx + ux.36 + 2 * noise(25.2, time * 0.35) + if(bdrag == 36, bdx, 0), mid + uy.36 + 2.5 * noise(51.8, time * 0.3) + if(bdrag == 36, bdy, 0); to: lx + kx.36, if(uy.36 > -3, edge + 14, mid + ky.36); width: ur.36 * b.36 * 0.3 * if(bdrag == 36, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 36 and bsnap, 0, 1) }
            line { from: lx + ux.37 + 2 * noise(25.9, time * 0.35) + if(bdrag == 37, bdx, 0), mid + uy.37 + 2.5 * noise(53.1, time * 0.3) + if(bdrag == 37, bdy, 0); to: lx + kx.37, if(uy.37 > -3, edge + 14, mid + ky.37); width: ur.37 * b.37 * 0.3 * if(bdrag == 37, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 37 and bsnap, 0, 1) }
            line { from: lx + ux.38 + 2 * noise(26.6, time * 0.35) + if(bdrag == 38, bdx, 0), mid + uy.38 + 2.5 * noise(54.4, time * 0.3) + if(bdrag == 38, bdy, 0); to: lx + kx.38, if(uy.38 > -3, edge + 14, mid + ky.38); width: ur.38 * b.38 * 0.3 * if(bdrag == 38, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 38 and bsnap, 0, 1) }
            line { from: lx + ux.39 + 2 * noise(27.3, time * 0.35) + if(bdrag == 39, bdx, 0), mid + uy.39 + 2.5 * noise(55.7, time * 0.3) + if(bdrag == 39, bdy, 0); to: lx + kx.39, if(uy.39 > -3, edge + 14, mid + ky.39); width: ur.39 * b.39 * 0.3 * if(bdrag == 39, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 39 and bsnap, 0, 1) }
            line { from: lx + ux.40 + 2 * noise(28.0, time * 0.35) + if(bdrag == 40, bdx, 0), mid + uy.40 + 2.5 * noise(57.0, time * 0.3) + if(bdrag == 40, bdy, 0); to: lx + kx.40, if(uy.40 > -3, edge + 14, mid + ky.40); width: ur.40 * b.40 * 0.3 * if(bdrag == 40, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 40 and bsnap, 0, 1) }
            line { from: lx + ux.41 + 2 * noise(28.7, time * 0.35) + if(bdrag == 41, bdx, 0), mid + uy.41 + 2.5 * noise(58.3, time * 0.3) + if(bdrag == 41, bdy, 0); to: lx + kx.41, if(uy.41 > -3, edge + 14, mid + ky.41); width: ur.41 * b.41 * 0.3 * if(bdrag == 41, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 41 and bsnap, 0, 1) }
            line { from: lx + ux.42 + 2 * noise(29.4, time * 0.35) + if(bdrag == 42, bdx, 0), mid + uy.42 + 2.5 * noise(59.6, time * 0.3) + if(bdrag == 42, bdy, 0); to: lx + kx.42, if(uy.42 > -3, edge + 14, mid + ky.42); width: ur.42 * b.42 * 0.3 * if(bdrag == 42, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 42 and bsnap, 0, 1) }
            line { from: lx + ux.43 + 2 * noise(30.1, time * 0.35) + if(bdrag == 43, bdx, 0), mid + uy.43 + 2.5 * noise(60.9, time * 0.3) + if(bdrag == 43, bdy, 0); to: lx + kx.43, if(uy.43 > -3, edge + 14, mid + ky.43); width: ur.43 * b.43 * 0.3 * if(bdrag == 43, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 43 and bsnap, 0, 1) }
            line { from: lx + ux.44 + 2 * noise(30.8, time * 0.35) + if(bdrag == 44, bdx, 0), mid + uy.44 + 2.5 * noise(62.2, time * 0.3) + if(bdrag == 44, bdy, 0); to: lx + kx.44, if(uy.44 > -3, edge + 14, mid + ky.44); width: ur.44 * b.44 * 0.3 * if(bdrag == 44, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 44 and bsnap, 0, 1) }
            line { from: lx + ux.45 + 2 * noise(31.5, time * 0.35) + if(bdrag == 45, bdx, 0), mid + uy.45 + 2.5 * noise(63.5, time * 0.3) + if(bdrag == 45, bdy, 0); to: lx + kx.45, if(uy.45 > -3, edge + 14, mid + ky.45); width: ur.45 * b.45 * 0.3 * if(bdrag == 45, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 45 and bsnap, 0, 1) }
            line { from: lx + ux.46 + 2 * noise(32.2, time * 0.35) + if(bdrag == 46, bdx, 0), mid + uy.46 + 2.5 * noise(64.8, time * 0.3) + if(bdrag == 46, bdy, 0); to: lx + kx.46, if(uy.46 > -3, edge + 14, mid + ky.46); width: ur.46 * b.46 * 0.3 * if(bdrag == 46, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 46 and bsnap, 0, 1) }
            line { from: lx + ux.47 + 2 * noise(32.9, time * 0.35) + if(bdrag == 47, bdx, 0), mid + uy.47 + 2.5 * noise(66.1, time * 0.3) + if(bdrag == 47, bdy, 0); to: lx + kx.47, if(uy.47 > -3, edge + 14, mid + ky.47); width: ur.47 * b.47 * 0.3 * if(bdrag == 47, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 47 and bsnap, 0, 1) }
            // Štart a vypínač: vlastná „voda“ pod okrajom; s hlavou a medzi sebou ich spája most `link`
            box { from: px - 34 - 14 * flow2 * stir, edge; size: (sx - px + 68 + 28 * flow2 * stir) * so, 70 }
            ellipse { at: sx, s.y; radius: (33 + 3 * hs) * so * (1 - smooth(0, 0.08, dsw)); scale: 1 + squish.s * 0.08 + jit.s + swob * 0.01, 1 - squish.s * 0.12 - jit.s - swob * 0.01; blend: link * so }
            ellipse { at: px, p.y; radius: (19 + 4 * hp) * so * (1 - smooth(0, 0.12, pm)); scale: 1 + squish.p * 0.08 + jit.p, 1 - squish.p * 0.12 - jit.p; blend: link * so }
            line { from: px, p.y - 4; to: sx, s.y - 6; width: thread.ps * (1 - max(dsh, pm)); blend: 12 * clamp(thread.ps * (1 - max(dsh, pm)) / 3, 0, 1) }
            line { from: sx + 8, s.y - 12; to: bl + 18, bottom - 14; width: thread.sb * ap * (1 - dsh); blend: 14 * clamp(thread.sb * ap * (1 - dsh) / 3, 0, 1) }
            ellipse { at: drip.x, drip.y; radius: drip.r * so; blend: 8 }
            // hladina: prehnutie pod Hodinami, zvyšková kvapka a vlnky (zliate s okrajom, preto bez kreslenia krku)
            // (neaktívne majú nulový polomer — elipsa stlačená na nulovú výšku by v tele vyrezala diery)
            ellipse { at: sx, edge; radius: 30 * if(sag.s > 0.3, 1, 0); scale: 1, max(sag.s, 0.3) / 30; blend: 16 * clamp(sag.s / 6, 0, 1) }
            ellipse { at: stray.x, edge - 5.5 * stray * 0.7; radius: 5.5 * stray * so; blend: 7 * clamp(stray * 5.5 / 3, 0, 1) }
            ellipse { at: vx.0 - vd.0, edge; radius: 9 * if(vh.0 > 0.3, 1, 0); scale: 1, max(vh.0, 0.3) / 9; blend: 8 * clamp(vh.0 / 3, 0, 1) }
            ellipse { at: vx.0 + vd.0, edge; radius: 9 * if(vh.0 > 0.3, 1, 0); scale: 1, max(vh.0, 0.3) / 9; blend: 8 * clamp(vh.0 / 3, 0, 1) }
            ellipse { at: vx.1 - vd.1, edge; radius: 9 * if(vh.1 > 0.3, 1, 0); scale: 1, max(vh.1, 0.3) / 9; blend: 8 * clamp(vh.1 / 3, 0, 1) }
            ellipse { at: vx.1 + vd.1, edge; radius: 9 * if(vh.1 > 0.3, 1, 0); scale: 1, max(vh.1, 0.3) / 9; blend: 8 * clamp(vh.1 / 3, 0, 1) }
            ellipse { at: vx.2 - vd.2, edge; radius: 9 * if(vh.2 > 0.3, 1, 0); scale: 1, max(vh.2, 0.3) / 9; blend: 8 * clamp(vh.2 / 3, 0, 1) }
            ellipse { at: vx.2 + vd.2, edge; radius: 9 * if(vh.2 > 0.3, 1, 0); scale: 1, max(vh.2, 0.3) / 9; blend: 8 * clamp(vh.2 / 3, 0, 1) }
            ellipse { at: vx.3 - vd.3, edge; radius: 9 * if(vh.3 > 0.3, 1, 0); scale: 1, max(vh.3, 0.3) / 9; blend: 8 * clamp(vh.3 / 3, 0, 1) }
            ellipse { at: vx.3 + vd.3, edge; radius: 9 * if(vh.3 > 0.3, 1, 0); scale: 1, max(vh.3, 0.3) / 9; blend: 8 * clamp(vh.3 / 3, 0, 1) }
        }
        // obraz režimu okien v hlave (30. 9., návrh používateľa): akoby cez kvapku presvitali okná — páska (pás
        // okolo valca, boky skrátené), plávajúce (nad sebou), dlaždice. Pri prepnutí sa okienka prelejú do nového
        // usporiadania; myš nad hlavou obraz zvýrazní (ľavý klik režim prepne)
        group {
            opacity: (26% + 34% * hh) * ap * (1 - o.pull)
            box { at: hx + (wp * -22 + wf * -7 + wd * -9) / ws + 1.5 * noise(0.3, time * 0.2), mid - 8 + (wp * 1 + wf * -7 + wd * 0) / ws; size: (wp * 11 + wf * 26 + wd * 17) / ws, (wp * 20 + wf * 19 + wd * 34) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 0.6 + wd * 1) / ws }
            box { at: hx + (wp * 0 + wf * 0 + wd * 10) / ws + 1.5 * noise(1.3, time * 0.2), mid - 8 + (wp * 0 + wf * 0 + wd * -9) / ws; size: (wp * 24 + wf * 26 + wd * 18) / ws, (wp * 30 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 1 + wf * 0.8 + wd * 0.8) / ws }
            box { at: hx + (wp * 22 + wf * 7 + wd * 10) / ws + 1.5 * noise(2.3, time * 0.2), mid - 8 + (wp * 1 + wf * 7 + wd * 9) / ws; size: (wp * 11 + wf * 26 + wd * 18) / ws, (wp * 20 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 1 + wd * 0.8) / ws }
        }
        // odlesk: každá guľa odráža svetlo sama (bodka hore vľavo), hlava najväčšiu
        group {
            blur: 1.5
            opacity: 70% * ap
            ellipse { at: hx - 14, mid - 32; radius: 4; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
            repeat k in 0..48 {
                // stred guľôčky a vzdialenosť kurzora (aktívne svetlo)
                let qx = lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)
                let qy = mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)
                let qd = length(cu - qx, cv - qy)
                ellipse { at: qx - ur.$k * 0.4, qy - ur.$k * 0.52; radius: 0.11 * ur.$k * b.$k; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
                // aktívne svetlo: odlesk na strane ku kurzoru, bližšie = jasnejší
                ellipse { at: qx + (cu - qx) / max(qd, 1) * ur.$k * 0.55, qy + (cv - qy) / max(qd, 1) * ur.$k * 0.55; radius: 0.13 * ur.$k * b.$k * (1 - smooth(50, 360, qd)); color: #ffe4bd }
            }
            // hlava a Hodiny: to isté
            ellipse { at: hx + (cu - hx) / max(length(cu - hx, cv - mid + 8), 1) * 22, mid - 8 + (cv - mid + 8) / max(length(cu - hx, cv - mid + 8), 1) * 22; radius: 5 * (1 - smooth(60, 420, length(cu - hx, cv - mid + 8))); color: #ffe4bd }
            ellipse { at: sx + (cu - sx) / max(length(cu - sx, cv - s.y), 1) * 20, s.y + (cv - s.y) / max(length(cu - sx, cv - s.y), 1) * 20; radius: 4.5 * so * (1 - smooth(0, 0.12, dsh)) * (1 - smooth(60, 420, length(cu - sx, cv - s.y))); color: #ffe4bd }
        }
        // základňa kvapky: telo (0) a hlava (1) — ľavý klik = režim okien, ťahanie ľavým aj pravým = presun,
        // koliesko = okná, pravý klik nič. Hrbolčeky s oknami (icon_hit) majú vlastné kliky a ležia navrchu.
        repeat z in 0..2 {
            zone box base.$z { at: if(z == 0, bl + w / 2, hx), if(z == 0, mid, by - 4); size: if(z == 0, w, 66), if(z == 0, h, 66); corner: if(z == 0, c, 33); cursor: pointer }
        }
        zone ellipse start_hit { at: sx, s.y; radius: 34; cursor: pointer; active: solo }
        zone ellipse power_hit { at: px, p.y; radius: 19; cursor: pointer; active: solo }
        repeat k in 0..48 {
            zone box icon_hit.$k { at: (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)); size: ur.$k * 2, ur.$k * 2; corner: ur.$k; cursor: pointer; active: k < n and not free }
        }
    }

    // odtrhnutá kvapka: za myšou; pri stekaní padá (smerom dole na obrazovke), naťahuje sa, zmenšuje a kvapká
    body {
        color: coffee
        light: 16%, gy - gh / 2 - 10, 30
        rim: 30%
        shadow: 0, 8, 18, 40%
        opacity: if(free, 1, 0) * (1 - 0.42 * v * (1 - m))
        box { at: gx, gy + 150 * fall; size: gw * (1 - 0.7 * fall), gh * (1 + 0.5 * fall) * (1 - 0.8 * fall); corner: min(gw, gh) / 2 * (1 - 0.7 * fall) }
        ellipse { at: gx - 12, gy + gh * 0.4 + 210 * fall * fall; radius: 9 * fall * (1 - fall) * 4; blend: 10 }
        ellipse { at: gx + 16, gy + gh * 0.3 + 260 * fall * fall; radius: 6 * fall * (1 - fall) * 4; blend: 8 }
    }

    // ikony stoja rovno: bod rámca (u, v) → obrazovka podľa okraja; veľkosť podľa guľôčky
    repeat k in 0..48 {
        image icon.$k { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0))) - ur.$k * 0.52, pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))) - ur.$k * 0.52; size: ur.$k * 1.04, ur.$k * 1.04; opacity: b.$k * ap * (1 - 0.55 * dm.$k); show: k < n }
        box { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76), pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76 + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))); size: if(side == vlavo or side == vpravo, 3, 12), if(side == vlavo or side == vpravo, 12, 3); corner: 1.5; color: ink; opacity: ap; show: k < n and wins.$k.active }
    }

    image power_icon = icon "system-shutdown-symbolic", 18, 18
    // >>> DaNoGoo (danogoo.py)
    // DaNoGoo: dátum + počasie + upozornenia (LATTEOS-GOO.md 4.2b). Poloha na okraji (dn.side, dn.pos) z logiky.
    fact dn.side = 0                         // 0 dole, 1 hore, 2 vľavo, 3 vpravo
    fact dn.pos = 0.78                       // 0..1 pozdĺž okraja
    fact dn_open = false                     // hrozno upozornení vonku
    fact dn_drag = false
    fact dn_moved = false
    fact dnd.x = 0
    fact dnd.y = 0
    // ťahanie: miesto stlačenia + posun (pointer.x platí iba v pravidle, nie vo follow)
    fact dnp.x = 0
    fact dnp.y = 0
    fact dnq.x = 0
    fact dnq.y = 0
    text dn_date = ""
    text dn_wx = ""
    text dn_temp = ""
    text dn_clear = ""                       // „Vymazať všetko (9)“
    fact dn_crit = 0                         // systémové výstrahy (kritické)
    fact dn_norm = 0                         // ostatné upozornenia
    model berries max 6 { app: text; title: text; body: text; icon: image 24, 24; pal: number; dark: bool; acts: bool }
    fact berry_hot = -1
    fact brk = -1                            // ťahaná bobuľa
    fact brmoved = false
    fact br.dx = 0
    fact br.dy = 0
    event dn_drop ->
    event dn_cal
    event dn_clear_all ->
    event berry_open ->
    event berry_menu ->
    event berry_dismiss ->
    // karta DaNoGoo (pravý klik): kalendár s udalosťami a úlohami (spoločné s klasickým LatteOS) a počasie
    fact dc_open = false
    fact dc_hot = -1
    fact dc_empty = true                     // pole novej udalosti je prázdne (zástupný text)
    text dc_month = ""
    text dc_seltitle = ""
    text dc_new = ""
    text dc_hint = ""
    model days max 42 { d: text; inm: bool; today: bool; sel: bool; dot: bool }
    model evs max 5 { hm: text; title: text }
    model tds max 5 { title: text; done: bool }
    event dc_nav ->
    event dc_day ->
    event dc_todo ->
    event dc_ev_menu ->
    event dc_add ->
    spring dnspring = 230, 11
    spring dnwobble = 420, 13
    let dn.ax = pick(dn.side, W * dn.pos, W * dn.pos, 0, W)
    let dn.ay = pick(dn.side, H, 0, H * dn.pos, H * dn.pos)
    let dn.nx = pick(dn.side, 0, 0, 1, -1)
    let dn.ny = pick(dn.side, -1, 1, 0, 0)
    let dn.px = 0 - dn.ny                    // pozdĺž okraja
    let dn.py = dn.nx
    let dn.vert = abs(dn.nx)
    let dn.near = 1 - smooth(0, 190, length(mx - dn.ax, my - dn.ay))
    prop dn.lift = 0 ~dnspring
    follow dn.lift = if(dn_open or dc_open, 1, 0)
    prop dn.h = 0 ~lively
    prop dn.wob = 0 ~dnwobble
    // živý tvor: nakloní sa ku kurzoru, nad ňou sa nafúkne; pri otvorení vystrelí kolmo od okraja (pružina)
    let dn.out = 32 + 8 * dn.near + 2.5 * noise(time * 0.3 + 11.3) + 62 * dn.lift
    let dn.tx = dn.ax + dn.nx * dn.out + clamp(mx - dn.ax, -20, 20) * 0.28 * dn.near * abs(dn.px)
    let dn.ty = dn.ay + dn.ny * dn.out + clamp(my - dn.ay, -20, 20) * 0.28 * dn.near * abs(dn.py)
    prop dn.x = 0 ~lively
    prop dn.y = 0 ~lively
    follow dn.x = if(dn_drag and dn_moved, dnp.x + dnq.x, dn.tx)
    follow dn.y = if(dn_drag and dn_moved, dnp.y + dnq.y, dn.ty)
    let dn.r = (31 + 3 * dn.h) * so
    let dn.jit = 0.05 * sin(time * 9 + 3) * dn.h + dn.wob * 0.01
    let dn.sheet = if(dn_drag and dn_moved, 0, 1) * so
    // guľky počtu na vonkajšom oblúku (žlté bežné, červeno-kávová systémová vľavo)
    let dny.x.0 = dn.x + (dn.nx * cos(-50) + dn.px * sin(-50)) * (dn.r + 2)
    let dny.y.0 = dn.y + (dn.ny * cos(-50) + dn.py * sin(-50)) * (dn.r + 2)
    let dny.x.1 = dn.x + (dn.nx * cos(-25) + dn.px * sin(-25)) * (dn.r + 2)
    let dny.y.1 = dn.y + (dn.ny * cos(-25) + dn.py * sin(-25)) * (dn.r + 2)
    let dny.x.2 = dn.x + (dn.nx * cos(0) + dn.px * sin(0)) * (dn.r + 2)
    let dny.y.2 = dn.y + (dn.ny * cos(0) + dn.py * sin(0)) * (dn.r + 2)
    let dny.x.3 = dn.x + (dn.nx * cos(25) + dn.px * sin(25)) * (dn.r + 2)
    let dny.y.3 = dn.y + (dn.ny * cos(25) + dn.py * sin(25)) * (dn.r + 2)
    let dny.x.4 = dn.x + (dn.nx * cos(50) + dn.px * sin(50)) * (dn.r + 2)
    let dny.y.4 = dn.y + (dn.ny * cos(50) + dn.py * sin(50)) * (dn.r + 2)
    let dnc.x = dn.x + (dn.nx * cos(-72) + dn.px * sin(-72)) * (dn.r + 3)
    let dnc.y = dn.y + (dn.ny * cos(-72) + dn.py * sin(-72)) * (dn.r + 3)
    // hrozno: bobule nad sebou smerom od okraja (pri bočnom okraji vedľa kvapky), najnovšia najďalej
    let brj.0 = (berries.count - 1 - 0)
    let brx.0 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 0 and brmoved, br.dx, 0)
    let bry.0 = if(dn.vert > 0.5, dn.y + (brj.0 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.0 * 60)) + if(brk == 0 and brmoved, br.dy, 0)
    let bre.0 = clamp(dn.lift * 1.7 - brj.0 * 0.12 - 0.2, 0, 1) * if(0 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 0 and brmoved, br.dx, 0)) / 260, 0, 1)
    let brj.1 = (berries.count - 1 - 1)
    let brx.1 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 1 and brmoved, br.dx, 0)
    let bry.1 = if(dn.vert > 0.5, dn.y + (brj.1 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.1 * 60)) + if(brk == 1 and brmoved, br.dy, 0)
    let bre.1 = clamp(dn.lift * 1.7 - brj.1 * 0.12 - 0.2, 0, 1) * if(1 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 1 and brmoved, br.dx, 0)) / 260, 0, 1)
    let brj.2 = (berries.count - 1 - 2)
    let brx.2 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 2 and brmoved, br.dx, 0)
    let bry.2 = if(dn.vert > 0.5, dn.y + (brj.2 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.2 * 60)) + if(brk == 2 and brmoved, br.dy, 0)
    let bre.2 = clamp(dn.lift * 1.7 - brj.2 * 0.12 - 0.2, 0, 1) * if(2 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 2 and brmoved, br.dx, 0)) / 260, 0, 1)
    let brj.3 = (berries.count - 1 - 3)
    let brx.3 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 3 and brmoved, br.dx, 0)
    let bry.3 = if(dn.vert > 0.5, dn.y + (brj.3 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.3 * 60)) + if(brk == 3 and brmoved, br.dy, 0)
    let bre.3 = clamp(dn.lift * 1.7 - brj.3 * 0.12 - 0.2, 0, 1) * if(3 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 3 and brmoved, br.dx, 0)) / 260, 0, 1)
    let brj.4 = (berries.count - 1 - 4)
    let brx.4 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 4 and brmoved, br.dx, 0)
    let bry.4 = if(dn.vert > 0.5, dn.y + (brj.4 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.4 * 60)) + if(brk == 4 and brmoved, br.dy, 0)
    let bre.4 = clamp(dn.lift * 1.7 - brj.4 * 0.12 - 0.2, 0, 1) * if(4 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 4 and brmoved, br.dx, 0)) / 260, 0, 1)
    let brj.5 = (berries.count - 1 - 5)
    let brx.5 = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200)) + if(brk == 5 and brmoved, br.dx, 0)
    let bry.5 = if(dn.vert > 0.5, dn.y + (brj.5 - (berries.count - 1) / 2) * 60, dn.y + dn.ny * (dn.r + 46 + brj.5 * 60)) + if(brk == 5 and brmoved, br.dy, 0)
    let bre.5 = clamp(dn.lift * 1.7 - brj.5 * 0.12 - 0.2, 0, 1) * if(5 < berries.count and dn_open, 1, 0) * clamp(1 - abs(if(brk == 5 and brmoved, br.dx, 0)) / 260, 0, 1)
    let clx = if(dn.vert > 0.5, dn.x + dn.nx * (dn.r + 196), clamp(dn.x, 200, W - 200))
    let cly = if(dn.vert > 0.5, dn.y + ((berries.count - 1) / 2 + 1) * 60, dn.y + dn.ny * (dn.r + 46 + berries.count * 60))
    let cle = clamp(dn.lift * 1.7 - berries.count * 0.12 - 0.2, 0, 1) * if(berries.count > 0 and dn_open, 1, 0)
    let brend.x = if(berries.count > 0, clx, dn.x)
    let brend.y = if(berries.count > 0, cly, dn.y)
    body {
        color: coffee
        rim: 30%
        light: 14%, 0, 30
        glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
        shine: pointer
        opacity: if(solo, 1, 0)
        box { at: dn.ax, dn.ay; size: 70 * abs(dn.ny) + 20 * abs(dn.nx), 20 * abs(dn.ny) + 70 * abs(dn.nx); corner: 10 }
        ellipse { at: dn.ax, dn.ay; radius: 24 * dn.sheet; blend: 16 }
        ellipse { at: dn.x, dn.y; radius: dn.r; scale: 1 + dn.jit, 1 - dn.jit; blend: 18 * dn.sheet + 2 }
        // lepkavé vlákno od kvapky cez hrozno (tenšie, čím ďalej)
        line { from: dn.x, dn.y; to: dn.x + (brend.x - dn.x) * clamp(dn.lift * 1.4, 0, 1), dn.y + (brend.y - dn.y) * clamp(dn.lift * 1.4, 0, 1); width: 7 * clamp(dn.lift * 3, 0, 1) * if(dn_open, 1, 0); blend: 10 * clamp(dn.lift * 3, 0, 1) }
        ellipse { at: brx.0 - 176 * bre.0, bry.0; radius: 9 * bre.0; blend: 8 * bre.0 }
        ellipse { at: brx.1 - 176 * bre.1, bry.1; radius: 9 * bre.1; blend: 8 * bre.1 }
        ellipse { at: brx.2 - 176 * bre.2, bry.2; radius: 9 * bre.2; blend: 8 * bre.2 }
        ellipse { at: brx.3 - 176 * bre.3, bry.3; radius: 9 * bre.3; blend: 8 * bre.3 }
        ellipse { at: brx.4 - 176 * bre.4, bry.4; radius: 9 * bre.4; blend: 8 * bre.4 }
        ellipse { at: brx.5 - 176 * bre.5, bry.5; radius: 9 * bre.5; blend: 8 * bre.5 }
    }
    // guľky počtu upozornení (goo: prilepené na kvapke)
    body {
        color: #f2c14e
        rim: 30%
        light: 16%, 0, 20
        opacity: if(solo, 1, 0) * (1 - dn.lift)
        ellipse { at: dny.x.0, dny.y.0; radius: 6.2 * if(0 < dn_norm, 1, 0) * so; blend: 5 * if(0 < dn_norm, 1, 0) }
        ellipse { at: dny.x.1, dny.y.1; radius: 6.2 * if(1 < dn_norm, 1, 0) * so; blend: 5 * if(1 < dn_norm, 1, 0) }
        ellipse { at: dny.x.2, dny.y.2; radius: 6.2 * if(2 < dn_norm, 1, 0) * so; blend: 5 * if(2 < dn_norm, 1, 0) }
        ellipse { at: dny.x.3, dny.y.3; radius: 6.2 * if(3 < dn_norm, 1, 0) * so; blend: 5 * if(3 < dn_norm, 1, 0) }
        ellipse { at: dny.x.4, dny.y.4; radius: 6.2 * if(4 < dn_norm, 1, 0) * so; blend: 5 * if(4 < dn_norm, 1, 0) }
    }
    body {
        color: #a8452f
        rim: 30%
        light: 16%, 0, 20
        opacity: if(solo, 1, 0) * (1 - dn.lift)
        ellipse { at: dnc.x, dnc.y; radius: 9.5 * if(dn_crit > 0, 1, 0) * so }
    }
    text "{dn_crit}" { at: dnc.x, dnc.y; anchor: center; size: 9.5; weight: 800; color: #ffffff; opacity: 1 - dn.lift; show: solo and dn_crit > 1; family: "Inter" }
    // bobule hrozna: kapsula vo farbe ikony aplikácie (ikona, aplikácia, nadpis, text)
    box { at: brx.0, bry.0; size: 360 * bre.0, 52 * bre.0; corner: 26; color: pick(berries.0.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 0, 100%, 94%); show: solo and bre.0 > 0.01 }
    ellipse { at: brx.0 - 152 * bre.0, bry.0; radius: 18 * bre.0; color: #ffffff; opacity: 92%; show: solo and bre.0 > 0.01 }
    image berries.0.icon { at: brx.0 - 164, bry.0 - 12; size: 24, 24; opacity: clamp(bre.0 * 2 - 1, 0, 1); show: solo and bre.0 > 0.5 }
    text "{berries.0.app} · {berries.0.title}" { at: brx.0 - 124, bry.0 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.0.dark, #1b1b1b, #ffffff); opacity: clamp(bre.0 * 2 - 1, 0, 1); show: solo and bre.0 > 0.5; family: "Inter" }
    text berries.0.body { at: brx.0 - 124, bry.0 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.0.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.0 * 2 - 1, 0, 1); show: solo and bre.0 > 0.5; family: "Inter" }
    box { at: brx.1, bry.1; size: 360 * bre.1, 52 * bre.1; corner: 26; color: pick(berries.1.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 1, 100%, 94%); show: solo and bre.1 > 0.01 }
    ellipse { at: brx.1 - 152 * bre.1, bry.1; radius: 18 * bre.1; color: #ffffff; opacity: 92%; show: solo and bre.1 > 0.01 }
    image berries.1.icon { at: brx.1 - 164, bry.1 - 12; size: 24, 24; opacity: clamp(bre.1 * 2 - 1, 0, 1); show: solo and bre.1 > 0.5 }
    text "{berries.1.app} · {berries.1.title}" { at: brx.1 - 124, bry.1 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.1.dark, #1b1b1b, #ffffff); opacity: clamp(bre.1 * 2 - 1, 0, 1); show: solo and bre.1 > 0.5; family: "Inter" }
    text berries.1.body { at: brx.1 - 124, bry.1 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.1.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.1 * 2 - 1, 0, 1); show: solo and bre.1 > 0.5; family: "Inter" }
    box { at: brx.2, bry.2; size: 360 * bre.2, 52 * bre.2; corner: 26; color: pick(berries.2.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 2, 100%, 94%); show: solo and bre.2 > 0.01 }
    ellipse { at: brx.2 - 152 * bre.2, bry.2; radius: 18 * bre.2; color: #ffffff; opacity: 92%; show: solo and bre.2 > 0.01 }
    image berries.2.icon { at: brx.2 - 164, bry.2 - 12; size: 24, 24; opacity: clamp(bre.2 * 2 - 1, 0, 1); show: solo and bre.2 > 0.5 }
    text "{berries.2.app} · {berries.2.title}" { at: brx.2 - 124, bry.2 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.2.dark, #1b1b1b, #ffffff); opacity: clamp(bre.2 * 2 - 1, 0, 1); show: solo and bre.2 > 0.5; family: "Inter" }
    text berries.2.body { at: brx.2 - 124, bry.2 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.2.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.2 * 2 - 1, 0, 1); show: solo and bre.2 > 0.5; family: "Inter" }
    box { at: brx.3, bry.3; size: 360 * bre.3, 52 * bre.3; corner: 26; color: pick(berries.3.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 3, 100%, 94%); show: solo and bre.3 > 0.01 }
    ellipse { at: brx.3 - 152 * bre.3, bry.3; radius: 18 * bre.3; color: #ffffff; opacity: 92%; show: solo and bre.3 > 0.01 }
    image berries.3.icon { at: brx.3 - 164, bry.3 - 12; size: 24, 24; opacity: clamp(bre.3 * 2 - 1, 0, 1); show: solo and bre.3 > 0.5 }
    text "{berries.3.app} · {berries.3.title}" { at: brx.3 - 124, bry.3 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.3.dark, #1b1b1b, #ffffff); opacity: clamp(bre.3 * 2 - 1, 0, 1); show: solo and bre.3 > 0.5; family: "Inter" }
    text berries.3.body { at: brx.3 - 124, bry.3 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.3.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.3 * 2 - 1, 0, 1); show: solo and bre.3 > 0.5; family: "Inter" }
    box { at: brx.4, bry.4; size: 360 * bre.4, 52 * bre.4; corner: 26; color: pick(berries.4.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 4, 100%, 94%); show: solo and bre.4 > 0.01 }
    ellipse { at: brx.4 - 152 * bre.4, bry.4; radius: 18 * bre.4; color: #ffffff; opacity: 92%; show: solo and bre.4 > 0.01 }
    image berries.4.icon { at: brx.4 - 164, bry.4 - 12; size: 24, 24; opacity: clamp(bre.4 * 2 - 1, 0, 1); show: solo and bre.4 > 0.5 }
    text "{berries.4.app} · {berries.4.title}" { at: brx.4 - 124, bry.4 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.4.dark, #1b1b1b, #ffffff); opacity: clamp(bre.4 * 2 - 1, 0, 1); show: solo and bre.4 > 0.5; family: "Inter" }
    text berries.4.body { at: brx.4 - 124, bry.4 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.4.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.4 * 2 - 1, 0, 1); show: solo and bre.4 > 0.5; family: "Inter" }
    box { at: brx.5, bry.5; size: 360 * bre.5, 52 * bre.5; corner: 26; color: pick(berries.5.pal, #e5484d, #f76b15, #ffb224, #f5d90a, #99d52a, #46a758, #12a594, #05a2c2, #0090ff, #3e63dd, #6e56cf, #8e4ec6, #ab4aba, #d6409f, #c8cbd0, #5b5f66, #a8452f); opacity: if(berry_hot == 5, 100%, 94%); show: solo and bre.5 > 0.01 }
    ellipse { at: brx.5 - 152 * bre.5, bry.5; radius: 18 * bre.5; color: #ffffff; opacity: 92%; show: solo and bre.5 > 0.01 }
    image berries.5.icon { at: brx.5 - 164, bry.5 - 12; size: 24, 24; opacity: clamp(bre.5 * 2 - 1, 0, 1); show: solo and bre.5 > 0.5 }
    text "{berries.5.app} · {berries.5.title}" { at: brx.5 - 124, bry.5 - 9; anchor: left center; width: 290; lines: 1; size: 12.5; weight: 600; color: if(berries.5.dark, #1b1b1b, #ffffff); opacity: clamp(bre.5 * 2 - 1, 0, 1); show: solo and bre.5 > 0.5; family: "Inter" }
    text berries.5.body { at: brx.5 - 124, bry.5 + 10; anchor: left center; width: 290; lines: 1; size: 11.5; color: if(berries.5.dark, #1b1b1b, #ffffff); opacity: 80% * clamp(bre.5 * 2 - 1, 0, 1); show: solo and bre.5 > 0.5; family: "Inter" }
    box { at: clx, cly; size: 190 * cle, 34 * cle; corner: 17; color: mix(coffee, #f3ebdd, 0.12); opacity: 95%; show: solo and cle > 0.01 }
    text dn_clear { at: clx, cly; anchor: center; size: 12; weight: 600; color: ink; opacity: clamp(cle * 2 - 1, 0, 1); show: solo and cle > 0.5; family: "Inter" }
    // <<< DaNoGoo
    // >>> QueenGoo (queengoo.py)
    // QueenGoo: kvapka s korunkou — App Manager (ľavý klik) a Správca zariadení (pravý); presúva sa ťahaním
    fact qg.side = 0
    fact qg.pos = 0.70
    fact qg_drag = false
    fact qg_moved = false
    fact qgd.x = 0
    fact qgd.y = 0
    fact qgp.x = 0
    fact qgp.y = 0
    fact qgq.x = 0
    fact qgq.y = 0
    fact qg_up = false                       // jej okno je otvorené: ostane vystúpená ako ucho v rohu okna
    fact qg_upd = 0                          // softvér: čakajúce aktualizácie (modrá guľka)
    fact qg_hw = 0                           // hardvér: zariadenia, ktoré potrebujú pozornosť (červená guľka)
    fact qg_net = 0                          // sieť: výpadok (zelená guľka)
    event qg_open ->
    event qg_drop ->
    let qg.ax = pick(qg.side, W * qg.pos, W * qg.pos, 0, W)
    let qg.ay = pick(qg.side, H, 0, H * qg.pos, H * qg.pos)
    let qg.nx = pick(qg.side, 0, 0, 1, -1)
    let qg.ny = pick(qg.side, -1, 1, 0, 0)
    let qg.px = 0 - qg.ny
    let qg.py = qg.nx
    let qg.near = 1 - smooth(0, 190, length(mx - qg.ax, my - qg.ay))
    prop qg.lift = 0 ~dnspring
    follow qg.lift = if(qg_up, 1, 0)
    prop qg.h = 0 ~lively
    prop qg.wob = 0 ~dnwobble
    let qg.out = 32 + 8 * qg.near + 2.5 * noise(time * 0.3 + 21.7) + 70 * qg.lift
    let qg.tx = qg.ax + qg.nx * qg.out + clamp(mx - qg.ax, -20, 20) * 0.28 * qg.near * abs(qg.px)
    let qg.ty = qg.ay + qg.ny * qg.out + clamp(my - qg.ay, -20, 20) * 0.28 * qg.near * abs(qg.py)
    prop qg.x = 0 ~lively
    prop qg.y = 0 ~lively
    follow qg.x = if(qg_drag and qg_moved, qgp.x + qgq.x, qg.tx)
    follow qg.y = if(qg_drag and qg_moved, qgp.y + qgq.y, qg.ty)
    let qg.r = (30 + 3 * qg.h) * so
    let qg.jit = 0.05 * sin(time * 9 + 5) * qg.h + qg.wob * 0.01
    let qg.sheet = if(qg_drag and qg_moved, 0, 1) * so
    // korunka na vonkajšej strane kvapky, natočená podľa okraja
    let qg.rot = pick(qg.side, 0, 180, 90, -90)
    body {
        color: coffee
        rim: 30%
        light: 14%, 0, 30
        glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
        shine: pointer
        opacity: if(solo, 1, 0)
        box { at: qg.ax, qg.ay; size: 70 * abs(qg.ny) + 20 * abs(qg.nx), 20 * abs(qg.ny) + 70 * abs(qg.nx); corner: 10 }
        ellipse { at: qg.ax, qg.ay; radius: 24 * qg.sheet; blend: 16 }
        ellipse { at: qg.x, qg.y; radius: qg.r; scale: 1 + qg.jit, 1 - qg.jit; blend: 18 * qg.sheet + 2 }
    }
    // guľky upozornení (pravidlo 1. 10.): červená = hardvér, zelená = sieť, modrá = softvér (aktualizácie); s počtom
    body {
        color: #e5484d
        rim: 30%
        light: 18%, 0, 16
        opacity: if(solo and qg_hw > 0, 1, 0)
        ellipse { at: qg.x + (qg.nx * cos(-58) + qg.px * sin(-58)) * (qg.r + 2), qg.y + (qg.ny * cos(-58) + qg.py * sin(-58)) * (qg.r + 2); radius: 9.5 * so }
    }
    body {
        color: #46a758
        rim: 30%
        light: 18%, 0, 16
        opacity: if(solo and qg_net > 0, 1, 0)
        ellipse { at: qg.x + (qg.nx * cos(-108) + qg.px * sin(-108)) * (qg.r + 2), qg.y + (qg.ny * cos(-108) + qg.py * sin(-108)) * (qg.r + 2); radius: 9.5 * so }
    }
    body {
        color: #0090ff
        rim: 30%
        light: 18%, 0, 16
        opacity: if(solo and qg_upd > 0, 1, 0)
        ellipse { at: qg.x + (qg.nx * cos(58) + qg.px * sin(58)) * (qg.r + 2), qg.y + (qg.ny * cos(58) + qg.py * sin(58)) * (qg.r + 2); radius: 9.5 * so }
    }
    // <<< QueenGoo
    // Hodiny: čas a dátum stoja rovno v kvapke (bod rámca → obrazovka)
    let cxs = pick(side, sx, W - sx, edge - s.y, W - edge + s.y)
    let cys = pick(side, s.y + H - edge, edge - s.y, sx, H - sx)
    // bublina nového upozornenia: vyleje sa z DaNoGoo smerom od okraja (v obrazovke, text rovno), 6 s
    let vert = if(side == vlavo or side == vpravo, 1, 0)
    let away.x = pick(side, 0, 0, 1, -1)
    let away.y = pick(side, -1, 1, 0, 0)
    let tst.x = dn.x + if(dn.vert > 0.5, dn.nx * (40 + 170 * toast.p), 170 * toast.p * if(dn.x > W - 420, -1, 1))
    let tst.y = dn.y + if(dn.vert > 0.5, 0, dn.ny * (58 * toast.p))
    body {
        color: coffee
        rim: 30%
        shadow: 0, 6, 16, 30% * toast.p
        opacity: clamp(toast.p * 3, 0, 1) * so
        ellipse { at: dn.x, dn.y; radius: dn.r }
        box { at: tst.x, tst.y; size: 40 + 300 * toast.p, 30 + 14 * toast.p; corner: 22; blend: 22 }
    }
    // hodiny: digitálny čas a dátum v kvapke (bez očí; ľavý klik alebo kláves Win otvorí spúšťač)
    text now.time { at: cxs, cys - 5; anchor: center; size: 16; weight: 800; color: ink; opacity: so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }
    text pick(now.weekday, "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat") { at: cxs - 2, cys + 12; anchor: right center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }
    text "{now.day}. {now.month}." { at: cxs + 1, cys + 12; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }

    text toast { at: tst.x - 135, tst.y; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 600; color: ink; opacity: clamp(toast.p * 2 - 1, 0, 1) * so; show: solo }

    // >>> DaNoGoo texty (danogoo.py)
    // obsah kvapky: dátum a počasie (bez tváre)
    text dn_date { at: dn.x, dn.y - 7; anchor: center; size: 11; weight: 700; color: ink; opacity: so; show: solo; family: "Inter" }
    text dn_wx { at: dn.x - 1, dn.y + 9; anchor: right center; size: 12; color: ink; opacity: 85% * so; show: solo; family: "noctalia-tabler-icons" }
    text dn_temp { at: dn.x + 1, dn.y + 9; anchor: left center; size: 10.5; weight: 600; color: ink; opacity: 85% * so; show: solo; family: "Inter" }
    // <<< DaNoGoo texty
    // >>> QueenGoo texty (queengoo.py)
    group {
        pivot: qg.x, qg.y
        rotate: qg.rot * 1deg
        show: solo
        text "" { at: qg.x, qg.y - qg.r - 4; anchor: center; size: 22; color: #e8b84a; outline: 1.5, #3a2410; family: "noctalia-tabler-icons" }
    }
    text "" { at: qg.x, qg.y + 1; anchor: center; size: 18; color: ink; opacity: 80% * so; show: solo; family: "noctalia-tabler-icons" }
    text "{qg_upd}" { at: qg.x + (qg.nx * cos(58) + qg.px * sin(58)) * (qg.r + 2), qg.y + (qg.ny * cos(58) + qg.py * sin(58)) * (qg.r + 2); anchor: center; size: 9.5; weight: 800; color: #ffffff; show: solo and qg_upd > 0; family: "Inter" }
    text "{qg_hw}" { at: qg.x + (qg.nx * cos(-58) + qg.px * sin(-58)) * (qg.r + 2), qg.y + (qg.ny * cos(-58) + qg.py * sin(-58)) * (qg.r + 2); anchor: center; size: 9.5; weight: 800; color: #ffffff; show: solo and qg_hw > 0; family: "Inter" }
    text "{qg_net}" { at: qg.x + (qg.nx * cos(-108) + qg.px * sin(-108)) * (qg.r + 2), qg.y + (qg.ny * cos(-108) + qg.py * sin(-108)) * (qg.r + 2); anchor: center; size: 9.5; weight: 800; color: #ffffff; show: solo and qg_net > 0; family: "Inter" }
    // <<< QueenGoo texty
    // ── spúšťač (vyteká z hodiniek smerom od okraja; v obrazovke, text rovno) ──
    // >>> spúšťač (spustac.py)
    // Vzhľad (1. 10., používateľ: „moderné ikony, fonty, trošku minimalizmu; chytrosti, vkusnosti a užitočnosti“):
    // farby z témy LatteOS (fact tema = poradie v make-themes.py), karta od ucha prechádza z kávy do farby okien.
    let l.acc = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#e4b283, #3b8fc4, if(tema == 1, 1, 0)), #5d6b78, if(tema == 2, 1, 0)), #7a8794, if(tema == 3, 1, 0)), #9c7a2e, if(tema == 4, 1, 0)), #8c7b6b, if(tema == 5, 1, 0)), #d9c7b0, if(tema == 6, 1, 0)), #e2963c, if(tema == 7, 1, 0)), #ff96aa, if(tema == 8, 1, 0)), #4f8fc9, if(tema == 9, 1, 0)), #2b6cd6, if(tema == 10, 1, 0)), #66c0f4, if(tema == 11, 1, 0)), #3478f6, if(tema == 12, 1, 0)), #9ad36a, if(tema == 13, 1, 0))
    let l.onacc = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#1e1712, #ffffff, if(tema == 1, 1, 0)), #ffffff, if(tema == 2, 1, 0)), #ffffff, if(tema == 3, 1, 0)), #fff8e6, if(tema == 4, 1, 0)), #ffffff, if(tema == 5, 1, 0)), #1e1c1a, if(tema == 6, 1, 0)), #2a1606, if(tema == 7, 1, 0)), #3a0712, if(tema == 8, 1, 0)), #ffffff, if(tema == 9, 1, 0)), #ffffff, if(tema == 10, 1, 0)), #171d25, if(tema == 11, 1, 0)), #ffffff, if(tema == 12, 1, 0)), #111111, if(tema == 13, 1, 0))
    let l.win = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#1b1410, #eaf4fb, if(tema == 1, 1, 0)), #d9dde1, if(tema == 2, 1, 0)), #e6e9ec, if(tema == 3, 1, 0)), #efe2c4, if(tema == 4, 1, 0)), #f6f2ec, if(tema == 5, 1, 0)), #1e1c1a, if(tema == 6, 1, 0)), #2a1606, if(tema == 7, 1, 0)), #3a0712, if(tema == 8, 1, 0)), #e8eef5, if(tema == 9, 1, 0)), #fafafa, if(tema == 10, 1, 0)), #171d25, if(tema == 11, 1, 0)), #eceef2, if(tema == 12, 1, 0)), #1c1c1c, if(tema == 13, 1, 0))
    let l.var = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#261d17, #d6ecfa, if(tema == 1, 1, 0)), #c9ced3, if(tema == 2, 1, 0)), #d6dadf, if(tema == 3, 1, 0)), #e3cf9f, if(tema == 4, 1, 0)), #e6e0d8, if(tema == 5, 1, 0)), #2a2724, if(tema == 6, 1, 0)), #3d2210, if(tema == 7, 1, 0)), #52101f, if(tema == 8, 1, 0)), #d8e2ee, if(tema == 9, 1, 0)), #e6e6e6, if(tema == 10, 1, 0)), #1b2838, if(tema == 11, 1, 0)), #ffffff, if(tema == 12, 1, 0)), #2e2e2e, if(tema == 13, 1, 0))
    let l.fg = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#f3ebdd, #10283d, if(tema == 1, 1, 0)), #1c2126, if(tema == 2, 1, 0)), #1a1d21, if(tema == 3, 1, 0)), #2b1f08, if(tema == 4, 1, 0)), #2a2622, if(tema == 5, 1, 0)), #ede6dc, if(tema == 6, 1, 0)), #ffe6b4, if(tema == 7, 1, 0)), #ffeff2, if(tema == 8, 1, 0)), #1c2430, if(tema == 9, 1, 0)), #1b1b1b, if(tema == 10, 1, 0)), #c7d5e0, if(tema == 11, 1, 0)), #1d1d1f, if(tema == 12, 1, 0)), #dadada, if(tema == 13, 1, 0))
    let l.dim = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#cdbca6, #3a5a74, if(tema == 1, 1, 0)), #4a525a, if(tema == 2, 1, 0)), #50575f, if(tema == 3, 1, 0)), #5e4a22, if(tema == 4, 1, 0)), #6e6358, if(tema == 5, 1, 0)), #bdb3a6, if(tema == 6, 1, 0)), #e0b98a, if(tema == 7, 1, 0)), #f2b8c4, if(tema == 8, 1, 0)), #4e5b6d, if(tema == 9, 1, 0)), #555555, if(tema == 10, 1, 0)), #8ba3b8, if(tema == 11, 1, 0)), #5b5b60, if(tema == 12, 1, 0)), #a0a0a0, if(tema == 13, 1, 0))
    let l.line = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#4a3b30, #a9c9de, if(tema == 1, 1, 0)), #a3aab1, if(tema == 2, 1, 0)), #b4bbc2, if(tema == 3, 1, 0)), #c7ae74, if(tema == 4, 1, 0)), #cfc6bb, if(tema == 5, 1, 0)), #4a443e, if(tema == 6, 1, 0)), #6b4220, if(tema == 7, 1, 0)), #7d0f24, if(tema == 8, 1, 0)), #b3c2d4, if(tema == 9, 1, 0)), #d0d0d0, if(tema == 10, 1, 0)), #2a475e, if(tema == 11, 1, 0)), #d2d5db, if(tema == 12, 1, 0)), #3a3a3a, if(tema == 13, 1, 0))
    let l.hover = mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(#3a2d24, #cfe4f3, if(tema == 1, 1, 0)), #bfc5cb, if(tema == 2, 1, 0)), #cdd2d7, if(tema == 3, 1, 0)), #e0cb95, if(tema == 4, 1, 0)), #eae3da, if(tema == 5, 1, 0)), #36322e, if(tema == 6, 1, 0)), #4a2b14, if(tema == 7, 1, 0)), #5e1426, if(tema == 8, 1, 0)), #ccd8e6, if(tema == 9, 1, 0)), #dddddd, if(tema == 10, 1, 0)), #22324a, if(tema == 11, 1, 0)), #e2e5ea, if(tema == 12, 1, 0)), #333333, if(tema == 13, 1, 0))
    // priehľadnosť (sklo karty) a perleťové dúhové okraje pri sklenených témach; kov má textúru
    let l.glass = pick(tema, 0.80, 0.72, 0.45, 0.45, 0.45, 0.35, 0.35, 0.62, 0.72, 0.72, 0.00, 0.00, 0.80, 0.00)
    let l.pearl = if(tema == 0 or tema == 1 or tema == 7 or tema == 8 or tema == 9 or tema == 12, 1, 0)
    image tex.hlinik.v = file "textury/hlinik_v.webp", 640, 560
    image tex.hlinik.h = file "textury/hlinik_h.webp", 640, 560
    image tex.striebro.v = file "textury/striebro_v.webp", 640, 560
    image tex.striebro.h = file "textury/striebro_h.webp", 640, 560
    image tex.zlato.v = file "textury/zlato_v.webp", 640, 560
    image tex.zlato.h = file "textury/zlato_h.webp", 640, 560
    let dw = 640
    let dh = 560
    // ucho (roh okna) je presne nad Hodinami (na bočnom okraji presne vedľa): kvapka vystúpi kolmo od okraja a späť
    // padne rovno ako pod ťarchou. Okno rastie od ucha doprava (dolu), ak je tam miesto, inak doľava (hore).
    let d.rise = 118                         // ucho vyššie: sliz má kde sa natiahnuť (1. 10.)
    let dk.x = if(vert, cxs + away.x * d.rise, cxs)
    let dk.y = if(vert, cys, cys + away.y * d.rise)
    let d.sx = if(vert, 0, if(cxs + dw + 12 <= W, 1, -1))
    let d.sy = if(vert, if(cys + dh + 12 <= H, 1, -1), 0)
    let dt.x = if(vert, dk.x + away.x * dw / 2, dk.x + d.sx * dw / 2)
    let dt.y = if(vert, dk.y + d.sy * dh / 2, dk.y + away.y * dh / 2)
    // kvapka Hodín sa odlepí od lišty, pružne dopláva do rohu karty najbližšieho Hodinám a karta z nej vyrastie;
    // kým je okno otvorené, ostane v rohu ako trčiace „ucho“ s časom (ako v Marei — je poznať, odkiaľ okno je).
    // Pri zatvorení sa karta najprv zloží do ucha a až potom ucho pružne odkvapne domov na okraj.
    let d.grow = smooth(0.35, 1, dsh) * smooth(0.75, 0.97, dsw)
    let db.x = cxs + (dk.x - cxs) * dsw
    let db.y = cys + (dk.y - cys) * dsw
    // vlákno od Hodín k letiacej kvapke (sliz): čím ďalej, tým tenšie; pri 58 px praskne, pod 24 px sa zlepí
    let e.d = length(db.x - cxs, db.y - cys)
    let e.ux = (db.x - cxs) / max(e.d, 1)
    let e.uy = (db.y - cys) / max(e.d, 1)
    let e.k = if(esnap or dsw < 0.02, 0, 1) * clamp(1 - (e.d - 110) / 200, 0.35, 1)
    let dc.x = dk.x + (dt.x - dk.x) * d.grow
    let dc.y = dk.y + (dt.y - dk.y) * d.grow
    let d0.x = dt.x - dw / 2 + 28              // obsah: ľavý horný roh
    let d0.y = dt.y - dh / 2 + 24
    let cw = dw - 56                           // šírka obsahu
    let dshow = clamp(dsh * 2 - 1, 0, 1)
    // prechod farby: ďaleko od ucha farba okien, pri uchu káva
    let g.ax = away.x * dw / 2 * if(vert, 1, 0)
    let g.ay = away.y * dh / 2 * if(vert, 0, 1)
    body {
        gradient: dc.x + g.ax, dc.y + g.ay to dc.x - g.ax, dc.y - g.ay, l.win, l.win, l.win, mix(l.win, coffee, 0.35), coffee
        glass: 100% * l.glass
        lens: l.pearl > 0.5
        shine: pointer
        refraction: 120% * l.pearl
        dispersion: 260% * l.pearl
        light: 6%, dc.y - dh / 2, 60
        rim: 18%
        shadow: 0, 12, 34, 38% * dsh
        opacity: if(dsw > 0.02 or dsh > 0.01, 1, 0) * so
        box { at: dc.x, dc.y; size: (60 + (dw - 60) * d.grow) * if(d.grow > 0.01, 1, 0), (60 + (dh - 60) * d.grow) * if(d.grow > 0.01, 1, 0); corner: 30 - 6 * d.grow }
        // vlákno k Hodinám (kým nepraskne) a po prasknutí pahýle na oboch koncoch, ktoré sa stiahnu
        line { from: db.x, db.y; to: db.x - e.ux * 22 * estub, db.y - e.uy * 22 * estub; width: 6 * estub; blend: 8 * clamp(estub * 3, 0, 1) }
        line { from: cxs, cys; to: cxs + e.ux * 22 * estub, cys + e.uy * 22 * estub; width: 6 * estub; blend: 8 * clamp(estub * 3, 0, 1) }
        // ucho = kvapka Hodín (trčí z rohu, zliata s kartou)
        ellipse { at: db.x, db.y; radius: 33 * clamp(dsw * 4, 0, 1); scale: 1 + swob * 0.01, 1 - swob * 0.01; blend: 18 * d.grow }
    }
    text now.time { at: db.x, db.y - 1; anchor: center; size: 13; weight: 800; color: ink; opacity: so * clamp(dsw * 3 - 0.5, 0, 1); show: dsw > 0.1 }
    // textúra materiálu témy (brúsený hliník, striebro, tepané zlato) na časti karty ďaleko od ucha; k uchu sa vytratí
    group {
        opacity: dshow
        show: dsh > 0.5 and d.grow > 0.98
        clip box { at: dc.x, dc.y; size: dw, dh; corner: 24 }
        group {
            pivot: dc.x, dc.y
            rotate: if(vert, if(away.x > 0, 0, 180), if(away.y < 0, 0, 180)) * 1deg
            image tex.hlinik.v { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 2 and not vert }
            image tex.hlinik.h { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 2 and vert }
            image tex.striebro.v { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 3 and not vert }
            image tex.striebro.h { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 3 and vert }
            image tex.zlato.v { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 4 and not vert }
            image tex.zlato.h { at: dc.x - dw / 2, dc.y - dh / 2; size: dw, dh; show: tema == 4 and vert }
        }
    }
    // obsah: y0 = horný okraj obsahu pod poľom; riadok režimu a počasia sú pri spodku karty
    let y0 = d0.y + 64
    let yc = d0.y + 494                        // riadok režimu (čipy) — úplne dole (počasie je v DaNoGoo, 1. 10.)
    let show_chat = tview == 0 and smode == 0 and not wx_detail
    let show_favs = tview == 0 and smode == 1 and not typing and not wx_detail
    let show_hits = tview == 0 and smode > 0 and not wx_detail and not show_favs
    prop mo = 0 ~springy
    follow mo = if(mode_open and dash, 1, 0)
    prop aiw = 0 ~lively
    follow aiw = if(ai_wait, 1, 0)
    fact chst = 0
    spring glide = 220, 30
    prop chs = 0 ~glide
    follow chs = chst
    measure ch.0
    measure ch.1
    measure ch.2
    measure ch.3
    measure ch.4
    measure ch.5
    measure ch.6
    measure ch.7
    let cy.0 = y0 + 8 + 50 * aiw - chs
    let cy.1 = cy.0 + if(0 < chat.count, ch.0.height + 34, 0)
    let cy.2 = cy.1 + if(1 < chat.count, ch.1.height + 34, 0)
    let cy.3 = cy.2 + if(2 < chat.count, ch.2.height + 34, 0)
    let cy.4 = cy.3 + if(3 < chat.count, ch.3.height + 34, 0)
    let cy.5 = cy.4 + if(4 < chat.count, ch.4.height + 34, 0)
    let cy.6 = cy.5 + if(5 < chat.count, ch.5.height + 34, 0)
    let cy.7 = cy.6 + if(6 < chat.count, ch.6.height + 34, 0)
    let chh = cy.7 + if(7 < chat.count, ch.7.height + 34, 0) - cy.0 + 50 * aiw
    let bx.0 = if(chat.0.me, d0.x + 4, d0.x + cw - ch.0.width - 32)
    let bv.0 = if(0 < chat.count and show_chat, 1, 0)
    let bx.1 = if(chat.1.me, d0.x + 4, d0.x + cw - ch.1.width - 32)
    let bv.1 = if(1 < chat.count and show_chat, 1, 0)
    let bx.2 = if(chat.2.me, d0.x + 4, d0.x + cw - ch.2.width - 32)
    let bv.2 = if(2 < chat.count and show_chat, 1, 0)
    let bx.3 = if(chat.3.me, d0.x + 4, d0.x + cw - ch.3.width - 32)
    let bv.3 = if(3 < chat.count and show_chat, 1, 0)
    let bx.4 = if(chat.4.me, d0.x + 4, d0.x + cw - ch.4.width - 32)
    let bv.4 = if(4 < chat.count and show_chat, 1, 0)
    let bx.5 = if(chat.5.me, d0.x + 4, d0.x + cw - ch.5.width - 32)
    let bv.5 = if(5 < chat.count and show_chat, 1, 0)
    let bx.6 = if(chat.6.me, d0.x + 4, d0.x + cw - ch.6.width - 32)
    let bv.6 = if(6 < chat.count and show_chat, 1, 0)
    let bx.7 = if(chat.7.me, d0.x + 4, d0.x + cw - ch.7.width - 32)
    let bv.7 = if(7 < chat.count and show_chat, 1, 0)
    measure cm.0
    measure cm.1
    measure cm.2
    measure cm.3
    measure cm.4
    measure cm.5
    measure cm.6
    let cwd.0 = 26 + if(chips.0.hasg, 18, 0) + if(chips.0.label_on, cm.0.width + if(chips.0.hasg, 4, 0), -4) + if(chips.0.drop, 16, 0)
    let cwd.1 = 26 + if(chips.1.hasg, 18, 0) + if(chips.1.label_on, cm.1.width + if(chips.1.hasg, 4, 0), -4) + if(chips.1.drop, 16, 0)
    let cwd.2 = 26 + if(chips.2.hasg, 18, 0) + if(chips.2.label_on, cm.2.width + if(chips.2.hasg, 4, 0), -4) + if(chips.2.drop, 16, 0)
    let cwd.3 = 26 + if(chips.3.hasg, 18, 0) + if(chips.3.label_on, cm.3.width + if(chips.3.hasg, 4, 0), -4) + if(chips.3.drop, 16, 0)
    let cwd.4 = 26 + if(chips.4.hasg, 18, 0) + if(chips.4.label_on, cm.4.width + if(chips.4.hasg, 4, 0), -4) + if(chips.4.drop, 16, 0)
    let cwd.5 = 26 + if(chips.5.hasg, 18, 0) + if(chips.5.label_on, cm.5.width + if(chips.5.hasg, 4, 0), -4) + if(chips.5.drop, 16, 0)
    let cwd.6 = 26 + if(chips.6.hasg, 18, 0) + if(chips.6.label_on, cm.6.width + if(chips.6.hasg, 4, 0), -4) + if(chips.6.drop, 16, 0)
    let chx.0 = d0.x
    let chx.1 = chx.0 + if(0 < chips.count, cwd.0 + 8, 0)
    let chx.2 = chx.1 + if(1 < chips.count, cwd.1 + 8, 0)
    let chx.3 = chx.2 + if(2 < chips.count, cwd.2 + 8, 0)
    let chx.4 = chx.3 + if(3 < chips.count, cwd.3 + 8, 0)
    let chx.5 = chx.4 + if(4 < chips.count, cwd.4 + 8, 0)
    let chx.6 = chx.5 + if(5 < chips.count, cwd.5 + 8, 0)
    let fav_rows = clamp(floor((favs.count + 5) / 6), 1, 2)
    let ry0 = y0 + 46 + fav_rows * 90          // nadpis „Nedávne“
    group {
        opacity: dshow
        show: dsh > 0.5 and tview == 0
        // pole: ikona režimu (klik = výber) + text; tenký akcentový okraj
        box { at: d0.x + cw / 2, d0.y + 24; size: cw, 48; corner: 14; color: l.acc; opacity: if(renaming, 100%, 75%) }
        box { at: d0.x + cw / 2, d0.y + 24; size: cw - 3, 45; corner: 12.5; color: l.var }
        box { at: d0.x + 30, d0.y + 24; size: 48, 34; corner: 10; color: l.acc; opacity: if(mode_open, 26%, 12%) }
        repeat k in 0..5 {
            text modes.$k.glyph { at: d0.x + 22, d0.y + 24; anchor: center; size: 18; color: l.acc; show: smode == k; family: "noctalia-tabler-icons" }
        }
        text "" { at: d0.x + 41, d0.y + 25; anchor: center; size: 11; color: l.acc; family: "noctalia-tabler-icons" }
        text hint { at: d0.x + 66, d0.y + 24; anchor: left center; width: cw - 80; lines: 1; size: 15; color: l.dim; opacity: 80%; show: not typing and not renaming; family: "Inter" }
        input query { at: d0.x + 66, d0.y + 24; width: cw - 80; size: 15; color: l.fg; selection: l.hover; family: "Inter" }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        // riadky: aplikácie, súbory, vyhľadávače, príkazy — karta s ikonou, názvom a popisom pod ním
        repeat k in 0..7 {
            box { at: d0.x + cw / 2, y0 + 22 + k * 48; size: cw, 44; corner: 12; color: if(hits.$k.warn, #e07a5f, if(k == sel and typing, l.acc, if(hit_hot == k, l.hover, l.var))); opacity: if(hits.$k.warn, 35%, if(k == sel and typing, 100%, if(hit_hot == k, 100%, 60%))); show: show_hits and k < hits.count }
            image hits.$k.icon { at: d0.x + 14, y0 + 8 + k * 48; size: 28, 28; show: show_hits and k < hits.count }
            text hits.$k.name { at: d0.x + 54, y0 + 14 + k * 48; anchor: left center; width: cw - 70; lines: 1; size: 14; weight: 500; color: if(k == sel and typing and not hits.$k.warn, l.onacc, l.fg); show: show_hits and k < hits.count; family: "Inter" }
            text hits.$k.sub { at: d0.x + 54, y0 + 31 + k * 48; anchor: left center; width: cw - 70; lines: 1; size: 11.5; color: if(k == sel and typing and not hits.$k.warn, l.onacc, l.dim); opacity: 90%; show: show_hits and k < hits.count; family: "Inter" }
        }
        // aplikácie bez textu: obľúbené zvolenej záložky ako dlaždice (6 × 2) a nedávne (2 × 2)
        text fav_title { at: d0.x + 2, y0 + 10; anchor: left center; size: 12.5; weight: 600; color: l.dim; show: show_favs; family: "Inter" }
        repeat k in 0..12 {
            box { at: d0.x + 44 + (k - 6 * floor(k / 6)) * 96, y0 + 67 + floor(k / 6) * 90; size: 88, 82; corner: 12; color: if(fav_hot == k, l.hover, l.var); opacity: if(fav_hot == k, 100%, 55%); show: show_favs and k < favs.count }
            image favs.$k.icon { at: d0.x + 26 + (k - 6 * floor(k / 6)) * 96, y0 + 41 + floor(k / 6) * 90; size: 36, 36; show: show_favs and k < favs.count }
            text favs.$k.name { at: d0.x + 44 + (k - 6 * floor(k / 6)) * 96, y0 + 91 + floor(k / 6) * 90; anchor: center; width: 80; lines: 1; size: 11.5; color: l.fg; show: show_favs and k < favs.count; family: "Inter" }
        }
        text "Recent" { at: d0.x + 2, ry0; anchor: left center; size: 12.5; weight: 600; color: l.dim; show: show_favs and recent.count > 0; family: "Inter" }
        repeat k in 0..4 {
            box { at: d0.x + 144 + (k - 2 * floor(k / 2)) * 296, ry0 + 34 + floor(k / 2) * 46; size: 288, 40; corner: 10; color: if(rec_hot == k, l.hover, l.var); opacity: if(rec_hot == k, 100%, 55%); show: show_favs and k < recent.count }
            image recent.$k.icon { at: d0.x + 12 + (k - 2 * floor(k / 2)) * 296, ry0 + 22 + floor(k / 2) * 46; size: 24, 24; show: show_favs and k < recent.count }
            text recent.$k.name { at: d0.x + 46 + (k - 2 * floor(k / 2)) * 296, ry0 + 34 + floor(k / 2) * 46; anchor: left center; width: 230; lines: 1; size: 13.5; color: l.fg; show: show_favs and k < recent.count; family: "Inter" }
        }
        // prázdny obsah: nápoveda podľa režimu
        text note { at: d0.x + 2, y0 + 20; anchor: left center; width: cw - 8; lines: 3; size: 13; color: l.dim; show: not wx_detail and ((show_chat and chat.count < 1 and not ai_wait) or (show_hits and hits.count < 1) or (show_favs and favs.count < 1)); family: "Inter" }
    }
    // rozhovor: bubliny používateľa (akcent, vľavo) a AI (vpravo), goo s kvapôčkou-chvostíkom k poľu
    group {
        opacity: dshow
        show: dsh > 0.5 and show_chat
        clip box { at: d0.x + cw / 2, y0 + 182; size: cw + 20, 364 }
        body {
            color: l.var
            rim: 12%
            light: 5%, 0, 30
            ellipse { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; radius: 20 * aiw; scale: 1.5 + 0.08 * sin(time * 6), 1; blend: 8 * aiw }
            box { from: bx.0, cy.0; size: (ch.0.width + 28) * bv.0 * if(chat.0.me, 0, 1), ch.0.height + 22; corner: 16 }
            ellipse { at: bx.0 + ch.0.width + 26, cy.0 + 2; radius: 5 * bv.0 * if(chat.0.me, 0, 1); blend: 7 * bv.0 * if(chat.0.me, 0, 1) }
            box { from: bx.1, cy.1; size: (ch.1.width + 28) * bv.1 * if(chat.1.me, 0, 1), ch.1.height + 22; corner: 16 }
            ellipse { at: bx.1 + ch.1.width + 26, cy.1 + 2; radius: 5 * bv.1 * if(chat.1.me, 0, 1); blend: 7 * bv.1 * if(chat.1.me, 0, 1) }
            box { from: bx.2, cy.2; size: (ch.2.width + 28) * bv.2 * if(chat.2.me, 0, 1), ch.2.height + 22; corner: 16 }
            ellipse { at: bx.2 + ch.2.width + 26, cy.2 + 2; radius: 5 * bv.2 * if(chat.2.me, 0, 1); blend: 7 * bv.2 * if(chat.2.me, 0, 1) }
            box { from: bx.3, cy.3; size: (ch.3.width + 28) * bv.3 * if(chat.3.me, 0, 1), ch.3.height + 22; corner: 16 }
            ellipse { at: bx.3 + ch.3.width + 26, cy.3 + 2; radius: 5 * bv.3 * if(chat.3.me, 0, 1); blend: 7 * bv.3 * if(chat.3.me, 0, 1) }
            box { from: bx.4, cy.4; size: (ch.4.width + 28) * bv.4 * if(chat.4.me, 0, 1), ch.4.height + 22; corner: 16 }
            ellipse { at: bx.4 + ch.4.width + 26, cy.4 + 2; radius: 5 * bv.4 * if(chat.4.me, 0, 1); blend: 7 * bv.4 * if(chat.4.me, 0, 1) }
            box { from: bx.5, cy.5; size: (ch.5.width + 28) * bv.5 * if(chat.5.me, 0, 1), ch.5.height + 22; corner: 16 }
            ellipse { at: bx.5 + ch.5.width + 26, cy.5 + 2; radius: 5 * bv.5 * if(chat.5.me, 0, 1); blend: 7 * bv.5 * if(chat.5.me, 0, 1) }
            box { from: bx.6, cy.6; size: (ch.6.width + 28) * bv.6 * if(chat.6.me, 0, 1), ch.6.height + 22; corner: 16 }
            ellipse { at: bx.6 + ch.6.width + 26, cy.6 + 2; radius: 5 * bv.6 * if(chat.6.me, 0, 1); blend: 7 * bv.6 * if(chat.6.me, 0, 1) }
            box { from: bx.7, cy.7; size: (ch.7.width + 28) * bv.7 * if(chat.7.me, 0, 1), ch.7.height + 22; corner: 16 }
            ellipse { at: bx.7 + ch.7.width + 26, cy.7 + 2; radius: 5 * bv.7 * if(chat.7.me, 0, 1); blend: 7 * bv.7 * if(chat.7.me, 0, 1) }
        }
        body {
            color: l.acc
            rim: 12%
            light: 6%, 0, 30
            box { from: bx.0, cy.0; size: (ch.0.width + 28) * bv.0 * if(chat.0.me, 1, 0), ch.0.height + 22; corner: 16 }
            ellipse { at: bx.0 + 2, cy.0 + 2; radius: 5 * bv.0 * if(chat.0.me, 1, 0); blend: 7 * bv.0 * if(chat.0.me, 1, 0) }
            box { from: bx.1, cy.1; size: (ch.1.width + 28) * bv.1 * if(chat.1.me, 1, 0), ch.1.height + 22; corner: 16 }
            ellipse { at: bx.1 + 2, cy.1 + 2; radius: 5 * bv.1 * if(chat.1.me, 1, 0); blend: 7 * bv.1 * if(chat.1.me, 1, 0) }
            box { from: bx.2, cy.2; size: (ch.2.width + 28) * bv.2 * if(chat.2.me, 1, 0), ch.2.height + 22; corner: 16 }
            ellipse { at: bx.2 + 2, cy.2 + 2; radius: 5 * bv.2 * if(chat.2.me, 1, 0); blend: 7 * bv.2 * if(chat.2.me, 1, 0) }
            box { from: bx.3, cy.3; size: (ch.3.width + 28) * bv.3 * if(chat.3.me, 1, 0), ch.3.height + 22; corner: 16 }
            ellipse { at: bx.3 + 2, cy.3 + 2; radius: 5 * bv.3 * if(chat.3.me, 1, 0); blend: 7 * bv.3 * if(chat.3.me, 1, 0) }
            box { from: bx.4, cy.4; size: (ch.4.width + 28) * bv.4 * if(chat.4.me, 1, 0), ch.4.height + 22; corner: 16 }
            ellipse { at: bx.4 + 2, cy.4 + 2; radius: 5 * bv.4 * if(chat.4.me, 1, 0); blend: 7 * bv.4 * if(chat.4.me, 1, 0) }
            box { from: bx.5, cy.5; size: (ch.5.width + 28) * bv.5 * if(chat.5.me, 1, 0), ch.5.height + 22; corner: 16 }
            ellipse { at: bx.5 + 2, cy.5 + 2; radius: 5 * bv.5 * if(chat.5.me, 1, 0); blend: 7 * bv.5 * if(chat.5.me, 1, 0) }
            box { from: bx.6, cy.6; size: (ch.6.width + 28) * bv.6 * if(chat.6.me, 1, 0), ch.6.height + 22; corner: 16 }
            ellipse { at: bx.6 + 2, cy.6 + 2; radius: 5 * bv.6 * if(chat.6.me, 1, 0); blend: 7 * bv.6 * if(chat.6.me, 1, 0) }
            box { from: bx.7, cy.7; size: (ch.7.width + 28) * bv.7 * if(chat.7.me, 1, 0), ch.7.height + 22; corner: 16 }
            ellipse { at: bx.7 + 2, cy.7 + 2; radius: 5 * bv.7 * if(chat.7.me, 1, 0); blend: 7 * bv.7 * if(chat.7.me, 1, 0) }
        }
        text "• • •" { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; anchor: center; size: 12; weight: 800; color: l.fg; opacity: aiw * (0.5 + 0.5 * sin(time * 6)); family: "Inter" }
        repeat k in 0..8 {
            text chat.$k.txt { at: bx.$k + 14, cy.$k + 11 + ch.$k.height / 2; anchor: left center; size: 13.5; line_height: 1.35; color: if(chat.$k.me, l.onacc, l.fg); measure: ch.$k; show: k < chat.count; family: "Inter" }
        }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        // riadok režimu: čipy (záložky obľúbených + „+“, služba a model AI, vyhľadávač…): ikonka, text, šípka ponuky
        repeat k in 0..7 {
            box { at: chx.$k + cwd.$k / 2, yc; size: cwd.$k, 32; corner: 16; color: if(chips.$k.on, l.acc, if(chip_hot == k, l.hover, l.var)); opacity: if(chips.$k.on or chip_hot == k, 100%, 85%); show: k < chips.count }
            text chips.$k.glyph { at: chx.$k + 13, yc; anchor: left center; size: 15; color: if(chips.$k.on, l.onacc, l.fg); show: k < chips.count and chips.$k.hasg; family: "noctalia-tabler-icons" }
            text chips.$k.label { at: chx.$k + 13 + if(chips.$k.hasg, 22, 0), yc; anchor: left center; size: 12.5; weight: 500; color: if(chips.$k.on, l.onacc, l.fg); measure: cm.$k; show: k < chips.count and chips.$k.label_on; family: "Inter" }
            text "" { at: chx.$k + cwd.$k - 13, yc + 1; anchor: right center; size: 12; color: if(chips.$k.on, l.onacc, l.dim); show: k < chips.count and chips.$k.drop; family: "noctalia-tabler-icons" }
        }
    }
    // ── časové menu TimeGoo (pravý klik): tá istá karta z ucha, obsah Prehľad · Stopky · Minútka · Budíky ──
    let tv = tview == 1 and not wx_detail
    let tcx = d0.x + cw / 2
    group {
        opacity: dshow
        show: dsh > 0.5 and tview == 1
        // hlavička: čas veľkým písmom, dátum a týždeň vpravo
        text now.time { at: d0.x + 2, d0.y + 24; anchor: left center; size: 40; weight: 300; color: l.fg; family: "Inter" }
        text t_date { at: d0.x + cw - 2, d0.y + 14; anchor: right center; size: 14; weight: 500; color: l.fg; family: "Inter" }
        text t_week { at: d0.x + cw - 2, d0.y + 36; anchor: right center; size: 12; color: l.dim; family: "Inter" }
    }
    group {
        opacity: dshow
        show: dsh > 0.5 and tv and ttab == 0
        // prehľad: digitálna pohoda (klik = podrobnosti v Monitore), svetové hodiny, najbližší budík / minútka
        box { at: tcx, y0 + 74; size: cw, 140; corner: 14; color: if(t_hot == 70, l.hover, l.var); opacity: if(t_hot == 70, 100%, 55%) }
        text "" { at: d0.x + 16, y0 + 24; anchor: left center; size: 15; color: l.acc; family: "noctalia-tabler-icons" }
        text "Digital wellbeing today" { at: d0.x + 38, y0 + 24; anchor: left center; size: 12.5; weight: 600; color: l.dim; family: "Inter" }
        text wb_total { at: d0.x + cw - 16, y0 + 24; anchor: right center; size: 13; weight: 600; color: l.fg; family: "Inter" }
        repeat k in 0..3 {
            text wbl.$k.name { at: d0.x + 16, y0 + 56 + k * 30; anchor: left center; width: 170; lines: 1; size: 13; color: l.fg; show: k < wbl.count; family: "Inter" }
            box { from: d0.x + 196, y0 + 53 + k * 30; size: cw - 290, 6; corner: 3; color: l.line; opacity: 60%; show: k < wbl.count }
            box { from: d0.x + 196, y0 + 53 + k * 30; size: (cw - 290) * wbl.$k.frac, 6; corner: 3; color: l.acc; show: k < wbl.count }
            text wbl.$k.dur { at: d0.x + cw - 16, y0 + 56 + k * 30; anchor: right center; size: 12; color: l.dim; show: k < wbl.count; family: "Inter" }
        }
        text "Nothing yet today" { at: d0.x + 16, y0 + 56; anchor: left center; size: 13; color: l.dim; show: wbl.count < 1; family: "Inter" }
        text "" { at: d0.x + 2, y0 + 170; anchor: left center; size: 15; color: l.dim; family: "noctalia-tabler-icons" }
        text "World clocks" { at: d0.x + 24, y0 + 170; anchor: left center; size: 12.5; weight: 600; color: l.dim; family: "Inter" }
        repeat k in 0..4 {
            box { at: d0.x + 144 + (k - 2 * floor(k / 2)) * 296, y0 + 204 + floor(k / 2) * 46; size: 288, 40; corner: 10; color: l.var; opacity: 55%; show: k < zones.count }
            text zones.$k.city { at: d0.x + 14 + (k - 2 * floor(k / 2)) * 296, y0 + 204 + floor(k / 2) * 46; anchor: left center; width: 150; lines: 1; size: 13.5; color: l.fg; show: k < zones.count; family: "Inter" }
            text zones.$k.diff { at: d0.x + 214 + (k - 2 * floor(k / 2)) * 296, y0 + 204 + floor(k / 2) * 46; anchor: right center; size: 11.5; color: l.dim; show: k < zones.count; family: "Inter" }
            text zones.$k.hm { at: d0.x + 274 + (k - 2 * floor(k / 2)) * 296, y0 + 204 + floor(k / 2) * 46; anchor: right center; size: 16; weight: 500; color: l.fg; show: k < zones.count; family: "Inter" }
        }
        text "Add cities in Settings › Date, time and location." { at: d0.x + 2, y0 + 204; anchor: left center; size: 13; color: l.dim; show: zones.count < 1; family: "Inter" }
        text "" { at: d0.x + 2, y0 + 340; anchor: left center; size: 15; color: l.acc; show: t_has_next; family: "noctalia-tabler-icons" }
        text t_next { at: d0.x + 24, y0 + 340; anchor: left center; width: cw - 30; lines: 1; size: 13; color: l.fg; show: t_has_next; family: "Inter" }
    }
    group {
        opacity: dshow
        show: dsh > 0.5 and tv and ttab == 1
        // stopky: veľké číslice, tlačidlá štart/pauza (akcent), medzičas, vynulovať; medzičasy pod nimi
        text t_sw { at: tcx, y0 + 76; anchor: center; size: 60; weight: 300; color: l.fg; family: "Inter" }
        ellipse { at: tcx, y0 + 168; radius: 32; color: if(t_hot == 1, mix(l.acc, l.fg, 0.15), l.acc) }
        text pick(if(sw_run, 1, 0), "", "") { at: tcx, y0 + 169; anchor: center; size: 24; color: l.onacc; family: "noctalia-tabler-icons" }
        ellipse { at: tcx - 90, y0 + 168; radius: 24; color: if(t_hot == 2, l.hover, l.var); opacity: if(sw_run, 100%, 45%) }
        text "" { at: tcx - 90, y0 + 169; anchor: center; size: 18; color: l.fg; opacity: if(sw_run, 100%, 45%); family: "noctalia-tabler-icons" }
        ellipse { at: tcx + 90, y0 + 168; radius: 24; color: if(t_hot == 3, l.hover, l.var) }
        text "" { at: tcx + 90, y0 + 169; anchor: center; size: 18; color: l.fg; family: "noctalia-tabler-icons" }
        repeat k in 0..5 {
            box { at: tcx, y0 + 236 + k * 26; size: 320, 24; corner: 8; color: l.var; opacity: if(k == 0, 55%, 0); show: k < laps.count }
            text laps.$k.label { at: tcx - 146, y0 + 236 + k * 26; anchor: left center; size: 12.5; color: l.dim; show: k < laps.count; family: "Inter" }
            text laps.$k.time { at: tcx + 146, y0 + 236 + k * 26; anchor: right center; size: 13.5; weight: 500; color: l.fg; show: k < laps.count; family: "Inter" }
        }
    }
    group {
        opacity: dshow
        show: dsh > 0.5 and tv and ttab == 2
        // minútka: kruh (koliesko nad ním mení minúty, klik spustí / pozastaví), predvoľby, zrušiť
        arc { at: tcx, y0 + 122; radius: 86; span: 360deg; width: 8; color: l.line; opacity: 60% }
        arc { at: tcx, y0 + 122; radius: 86; span: t_frac * 360deg; rotate: t_frac * 180deg; width: 8; color: l.acc }
        text t_timer { at: tcx, y0 + 116; anchor: center; size: 40; weight: 300; color: l.fg; family: "Inter" }
        text pick(if(t_run, 1, 0), "Scroll to set · click to start", "Click to pause") { at: tcx, y0 + 152; anchor: center; size: 11.5; color: l.dim; family: "Inter" }
        box { at: tcx + (0 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 30, l.hover, l.var); opacity: if(t_hot == 30, 100%, 80%) }
        text "1 min" { at: tcx + (0 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx + (1 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 31, l.hover, l.var); opacity: if(t_hot == 31, 100%, 80%) }
        text "5 min" { at: tcx + (1 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx + (2 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 32, l.hover, l.var); opacity: if(t_hot == 32, 100%, 80%) }
        text "10 min" { at: tcx + (2 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx + (3 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 33, l.hover, l.var); opacity: if(t_hot == 33, 100%, 80%) }
        text "15 min" { at: tcx + (3 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx + (4 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 34, l.hover, l.var); opacity: if(t_hot == 34, 100%, 80%) }
        text "25 min" { at: tcx + (4 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx + (5 - 2.5) * 80, y0 + 256; size: 72, 32; corner: 16; color: if(t_hot == 35, l.hover, l.var); opacity: if(t_hot == 35, 100%, 80%) }
        text "45 min" { at: tcx + (5 - 2.5) * 80, y0 + 256; anchor: center; size: 12.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: tcx, y0 + 312; size: 120, 32; corner: 16; color: if(t_hot == 21, l.hover, l.var); opacity: if(t_hot == 21, 100%, 80%); show: t_active }
        text "Cancel" { at: tcx, y0 + 312; anchor: center; size: 12.5; weight: 500; color: l.fg; show: t_active; family: "Inter" }
    }
    group {
        opacity: dshow
        show: dsh > 0.5 and tv and ttab == 3
        // budíky: zoznam s prepínačom a odstránením; nový budík myšou (koliesko nad hodinou a minútou, Pridať)
        repeat k in 0..5 {
            box { at: tcx, y0 + 22 + k * 50; size: cw, 44; corner: 12; color: l.var; opacity: 60%; show: k < alarms.count }
            text alarms.$k.hm { at: d0.x + 16, y0 + 22 + k * 50; anchor: left center; size: 20; weight: 500; color: if(alarms.$k.on, l.fg, l.dim); show: k < alarms.count; family: "Inter" }
            text alarms.$k.label { at: d0.x + 92, y0 + 22 + k * 50; anchor: left center; width: cw - 200; lines: 1; size: 12.5; color: l.dim; show: k < alarms.count; family: "Inter" }
            box { at: d0.x + cw - 76, y0 + 22 + k * 50; size: 42, 24; corner: 12; color: if(alarms.$k.on, l.acc, l.line); show: k < alarms.count }
            ellipse { at: d0.x + cw - 76 + if(alarms.$k.on, 9, -9), y0 + 22 + k * 50; radius: 9; color: if(alarms.$k.on, l.onacc, l.var); show: k < alarms.count }
            text "" { at: d0.x + cw - 24, y0 + 23 + k * 50; anchor: center; size: 15; color: if(t_hot == 60 + k, l.acc, l.dim); show: k < alarms.count; family: "noctalia-tabler-icons" }
        }
        text "No alarms. They ring even when this menu is closed." { at: d0.x + 2, y0 + 22; anchor: left center; size: 13; color: l.dim; show: alarms.count < 1; family: "Inter" }
        text "New alarm" { at: d0.x + 2, y0 + 300; anchor: left center; size: 12.5; weight: 600; color: l.dim; family: "Inter" }
        box { at: tcx - 34, y0 + 300; size: 60, 44; corner: 12; color: if(t_hot == 81, l.hover, l.var) }
        box { at: tcx + 34, y0 + 300; size: 60, 44; corner: 12; color: if(t_hot == 82, l.hover, l.var) }
        text t_alh { at: tcx - 34, y0 + 300; anchor: center; size: 22; weight: 500; color: l.fg; family: "Inter" }
        text ":" { at: tcx, y0 + 298; anchor: center; size: 22; color: l.dim; family: "Inter" }
        text t_alm { at: tcx + 34, y0 + 300; anchor: center; size: 22; weight: 500; color: l.fg; family: "Inter" }
        text "Scroll to set" { at: tcx, y0 + 334; anchor: center; size: 11; color: l.dim; family: "Inter" }
        box { at: d0.x + cw - 60, y0 + 300; size: 116, 36; corner: 18; color: l.acc; opacity: if(t_hot == 40, 85%, 100%) }
        text "" { at: d0.x + cw - 104, y0 + 300; anchor: left center; size: 15; color: l.onacc; family: "noctalia-tabler-icons" }
        text "Add" { at: d0.x + cw - 82, y0 + 300; anchor: left center; size: 13; weight: 600; color: l.onacc; family: "Inter" }
    }
    // výber režimu: vyteká z ikony v poli (goo), riadky s ikonou a názvom, zvolený zvýraznený
    body {
        color: l.var
        rim: 14%
        shadow: 0, 10, 24, 30% * mo
        opacity: dshow * clamp(mo * 4, 0, 1)
        ellipse { at: d0.x + 30, d0.y + 58; radius: 8 * clamp(mo * 3, 0, 1) }
        box { at: d0.x + 110, d0.y + 64 + 104 * mo; size: 220 * clamp(mo * 1.4, 0, 1), 208 * mo; corner: 14; blend: 14 }
    }
    group {
        opacity: dshow * clamp(mo * 2 - 1, 0, 1)
        show: dsh > 0.5 and mo > 0.5
        repeat k in 0..5 {
            box { at: d0.x + 110, d0.y + 84 + k * 40; size: 208, 36; corner: 10; color: if(smode == k, l.acc, l.hover); opacity: if(smode == k, 22%, if(mode_hot == k, 100%, 0)) }
            text modes.$k.glyph { at: d0.x + 18, d0.y + 84 + k * 40; anchor: left center; size: 17; color: if(smode == k, l.acc, l.fg); family: "noctalia-tabler-icons" }
            text modes.$k.name { at: d0.x + 46, d0.y + 84 + k * 40; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        }
    }
    // kontextová ponuka (pravý klik, rozbaľovacie čipy)
    let cx0 = clamp(ctx.x, 12, W - 252)
    // pri čipoch dole sa ponuka otvára nahor (ctx_up), inak nadol od kurzora
    fact ctx_up = false
    let cy0 = clamp(if(ctx_up, ctx.y - 10 - ctx.count * 36, ctx.y), 12, H - 12 - ctx.count * 36)
    body {
        color: l.var
        rim: 14%
        shadow: 0, 10, 26, 35%
        opacity: if(ctx_open, 1, 0)
        box { at: cx0 + 120, cy0 + ctx.count * 18; size: 240, ctx.count * 36 + 12; corner: 14 }
    }
    group {
        show: ctx_open
        repeat k in 0..10 {
            box { at: cx0 + 120, cy0 + 18 + k * 36; size: 228, 32; corner: 9; color: l.hover; opacity: if(ctx_hot == k, 100%, 0); show: k < ctx.count }
            text "" { at: cx0 + 22, cy0 + 18 + k * 36; anchor: center; size: 14; color: l.acc; show: k < ctx.count and ctx.$k.on == 1; family: "noctalia-tabler-icons" }
            text ctx.$k.label { at: cx0 + 40, cy0 + 18 + k * 36; anchor: left center; width: 190; lines: 1; size: 13; color: l.fg; opacity: if(ctx.$k.off, 45%, 100%); show: k < ctx.count; family: "Inter" }
        }
    }
    // spúšťač: klikateľné miesta (navrchu)
    zone box dash_card { at: dt.x, dt.y; size: dw, dh; active: dash }
    zone box mode_btn { at: d0.x + 30, d0.y + 24; size: 50, 36; cursor: pointer; active: dash and tview == 0 }
    repeat k in 0..7 {
        zone box hit_row.$k { at: d0.x + cw / 2, y0 + 22 + k * 48; size: cw, 44; cursor: pointer; active: dash and show_hits and k < hits.count and not mode_open }
    }
    repeat k in 0..12 {
        zone box fav_hit.$k { at: d0.x + 44 + (k - 6 * floor(k / 6)) * 96, y0 + 67 + floor(k / 6) * 90; size: 88, 82; cursor: pointer; active: dash and show_favs and k < favs.count and not mode_open }
    }
    repeat k in 0..4 {
        zone box rec_hit.$k { at: d0.x + 144 + (k - 2 * floor(k / 2)) * 296, ry0 + 34 + floor(k / 2) * 46; size: 288, 40; cursor: pointer; active: dash and show_favs and k < recent.count and not mode_open }
    }
    zone ellipse ai_stop { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; radius: 26; cursor: pointer; active: dash and show_chat and ai_wait }
    zone box chat_zone { at: d0.x + cw / 2, y0 + 182; size: cw, 364; active: dash and show_chat and not mode_open }
    repeat k in 0..8 {
        zone box bub_hit.$k { at: bx.$k + (ch.$k.width + 28) / 2, cy.$k + (ch.$k.height + 22) / 2; size: ch.$k.width + 28, ch.$k.height + 22; active: dash and show_chat and k < chat.count and cy.$k > y0 - 10 and cy.$k < y0 + 350 and not mode_open }
    }
    repeat k in 0..7 {
        zone box chip_hit.$k { at: chx.$k + cwd.$k / 2, yc; size: cwd.$k, 32; cursor: pointer; active: dash and k < chips.count }
    }
    // časové menu: klikateľné miesta (kód tlačidla v t_do, koliesko v t_wheel)
    zone box t_wb { at: tcx, y0 + 74; size: cw, 140; cursor: pointer; active: dash and tv and ttab == 0 }
    zone ellipse t_sw_go { at: tcx, y0 + 168; radius: 32; cursor: pointer; active: dash and tv and ttab == 1 }
    zone ellipse t_sw_lap { at: tcx - 90, y0 + 168; radius: 24; cursor: pointer; active: dash and tv and ttab == 1 and sw_run }
    zone ellipse t_sw_reset { at: tcx + 90, y0 + 168; radius: 24; cursor: pointer; active: dash and tv and ttab == 1 }
    zone ellipse t_ring { at: tcx, y0 + 122; radius: 92; cursor: pointer; active: dash and tv and ttab == 2 }
    repeat k in 0..6 {
        zone box t_pre.$k { at: tcx + (k - 2.5) * 80, y0 + 256; size: 72, 32; cursor: pointer; active: dash and tv and ttab == 2 }
    }
    zone box t_cancel { at: tcx, y0 + 312; size: 120, 32; cursor: pointer; active: dash and tv and ttab == 2 and t_active }
    repeat k in 0..5 {
        zone box t_al_on.$k { at: d0.x + cw - 76, y0 + 22 + k * 50; size: 46, 30; cursor: pointer; active: dash and tv and ttab == 3 and k < alarms.count }
        zone ellipse t_al_del.$k { at: d0.x + cw - 24, y0 + 22 + k * 50; radius: 14; cursor: pointer; active: dash and tv and ttab == 3 and k < alarms.count }
    }
    zone box t_al_h { at: tcx - 34, y0 + 300; size: 60, 44; cursor: pointer; active: dash and tv and ttab == 3 }
    zone box t_al_m { at: tcx + 34, y0 + 300; size: 60, 44; cursor: pointer; active: dash and tv and ttab == 3 }
    zone box t_al_add { at: d0.x + cw - 60, y0 + 300; size: 116, 36; cursor: pointer; active: dash and tv and ttab == 3 }
    // rozbalený výber režimu: klik mimo neho ho zavrie (pod jeho riadkami)
    zone box mode_away { at: W / 2, H / 2; size: W, H; active: dash and mode_open }
    repeat k in 0..5 {
        zone box mode_row.$k { at: d0.x + 110, d0.y + 84 + k * 40; size: 208, 38; cursor: pointer; active: dash and mode_open }
    }
    // otvorená ponuka: klik mimo nej ju zavrie (pod jej riadkami)
    zone box ctx_away { at: W / 2, H / 2; size: W, H; active: ctx_open }
    repeat k in 0..10 {
        zone box ctx_row.$k { at: cx0 + 120, cy0 + 18 + k * 36; size: 228, 34; cursor: pointer; active: ctx_open and k < ctx.count }
    }
    // <<< spúšťač
    // >>> kvapky widgetov (widgety.py)
    // Každá kvapka visí z okraja (side 0 dole, 1 hore, 2 vľavo, 3 vpravo; pos 0..1 pozdĺž neho) na hladine s krkom,
    // ku kurzoru sa nakloní a nad ňou sa nafúkne (živý tvor). Chytiť a pustiť pri inom okraji = prilepí sa tam;
    // pustiť ďaleko od okrajov = steká preč (odstráni sa, späť cez spúšťač). Kliky podľa Noctalie (logika).
    model wdg max 12 { icon: image 22, 22; val: text; hasval: bool; mono: bool; side: number; pos: number; right: bool; wheel: bool; on: bool }
    fact wdrag = -1
    fact wmoved = false
    fact wd.x = 0
    fact wd.y = 0
    fact wp0.x = 0                           // ťahanie: miesto stlačenia + posun (pointer.x iba v pravidle)
    fact wp0.y = 0
    fact wq.x = 0
    fact wq.y = 0
    fact wd.w = 1920
    fact wd.h = 1080
    event w_click ->
    event w_right ->
    event w_wheel ->
    event w_drop ->
    spring splashy = 420, 13
    let wa.x.0 = pick(wdg.0.side, W * wdg.0.pos, W * wdg.0.pos, 0, W)
    let wa.y.0 = pick(wdg.0.side, H, 0, H * wdg.0.pos, H * wdg.0.pos)
    let wn.x.0 = pick(wdg.0.side, 0, 0, 1, -1)
    let wn.y.0 = pick(wdg.0.side, -1, 1, 0, 0)
    let wnear.0 = 1 - smooth(0, 170, length(mx - wa.x.0, my - wa.y.0))
    let wout.0 = 24 + 9 * wnear.0 + 2.5 * noise(time * 0.3 + 0.0)
    let wt.x.0 = wa.x.0 + wn.x.0 * wout.0 + clamp(mx - wa.x.0, -18, 18) * 0.28 * wnear.0 * (1 - abs(wn.x.0))
    let wt.y.0 = wa.y.0 + wn.y.0 * wout.0 + clamp(my - wa.y.0, -18, 18) * 0.28 * wnear.0 * (1 - abs(wn.y.0))
    prop wp.x.0 = 0 ~lively
    prop wp.y.0 = 0 ~lively
    follow wp.x.0 = if(wdrag == 0 and wmoved, wp0.x + wq.x, wt.x.0)
    follow wp.y.0 = if(wdrag == 0 and wmoved, wp0.y + wq.y, wt.y.0)
    prop wb.0 = 0 ~lively
    follow wb.0 = if(0 < wdg.count, 1, 0)
    prop wh.0 = 0 ~lively
    prop wwob.0 = 0 ~splashy
    let wr.0 = (21 + 3 * wh.0) * wb.0
    let wjit.0 = 0.05 * sin(time * 9 + 0) * wh.0 + wwob.0 * 0.01
    let wsheet.0 = wb.0 * if(wdrag == 0 and wmoved, 0, 1)
    let wa.x.1 = pick(wdg.1.side, W * wdg.1.pos, W * wdg.1.pos, 0, W)
    let wa.y.1 = pick(wdg.1.side, H, 0, H * wdg.1.pos, H * wdg.1.pos)
    let wn.x.1 = pick(wdg.1.side, 0, 0, 1, -1)
    let wn.y.1 = pick(wdg.1.side, -1, 1, 0, 0)
    let wnear.1 = 1 - smooth(0, 170, length(mx - wa.x.1, my - wa.y.1))
    let wout.1 = 24 + 9 * wnear.1 + 2.5 * noise(time * 0.3 + 1.7)
    let wt.x.1 = wa.x.1 + wn.x.1 * wout.1 + clamp(mx - wa.x.1, -18, 18) * 0.28 * wnear.1 * (1 - abs(wn.x.1))
    let wt.y.1 = wa.y.1 + wn.y.1 * wout.1 + clamp(my - wa.y.1, -18, 18) * 0.28 * wnear.1 * (1 - abs(wn.y.1))
    prop wp.x.1 = 0 ~lively
    prop wp.y.1 = 0 ~lively
    follow wp.x.1 = if(wdrag == 1 and wmoved, wp0.x + wq.x, wt.x.1)
    follow wp.y.1 = if(wdrag == 1 and wmoved, wp0.y + wq.y, wt.y.1)
    prop wb.1 = 0 ~lively
    follow wb.1 = if(1 < wdg.count, 1, 0)
    prop wh.1 = 0 ~lively
    prop wwob.1 = 0 ~splashy
    let wr.1 = (21 + 3 * wh.1) * wb.1
    let wjit.1 = 0.05 * sin(time * 9 + 1) * wh.1 + wwob.1 * 0.01
    let wsheet.1 = wb.1 * if(wdrag == 1 and wmoved, 0, 1)
    let wa.x.2 = pick(wdg.2.side, W * wdg.2.pos, W * wdg.2.pos, 0, W)
    let wa.y.2 = pick(wdg.2.side, H, 0, H * wdg.2.pos, H * wdg.2.pos)
    let wn.x.2 = pick(wdg.2.side, 0, 0, 1, -1)
    let wn.y.2 = pick(wdg.2.side, -1, 1, 0, 0)
    let wnear.2 = 1 - smooth(0, 170, length(mx - wa.x.2, my - wa.y.2))
    let wout.2 = 24 + 9 * wnear.2 + 2.5 * noise(time * 0.3 + 3.4)
    let wt.x.2 = wa.x.2 + wn.x.2 * wout.2 + clamp(mx - wa.x.2, -18, 18) * 0.28 * wnear.2 * (1 - abs(wn.x.2))
    let wt.y.2 = wa.y.2 + wn.y.2 * wout.2 + clamp(my - wa.y.2, -18, 18) * 0.28 * wnear.2 * (1 - abs(wn.y.2))
    prop wp.x.2 = 0 ~lively
    prop wp.y.2 = 0 ~lively
    follow wp.x.2 = if(wdrag == 2 and wmoved, wp0.x + wq.x, wt.x.2)
    follow wp.y.2 = if(wdrag == 2 and wmoved, wp0.y + wq.y, wt.y.2)
    prop wb.2 = 0 ~lively
    follow wb.2 = if(2 < wdg.count, 1, 0)
    prop wh.2 = 0 ~lively
    prop wwob.2 = 0 ~splashy
    let wr.2 = (21 + 3 * wh.2) * wb.2
    let wjit.2 = 0.05 * sin(time * 9 + 2) * wh.2 + wwob.2 * 0.01
    let wsheet.2 = wb.2 * if(wdrag == 2 and wmoved, 0, 1)
    let wa.x.3 = pick(wdg.3.side, W * wdg.3.pos, W * wdg.3.pos, 0, W)
    let wa.y.3 = pick(wdg.3.side, H, 0, H * wdg.3.pos, H * wdg.3.pos)
    let wn.x.3 = pick(wdg.3.side, 0, 0, 1, -1)
    let wn.y.3 = pick(wdg.3.side, -1, 1, 0, 0)
    let wnear.3 = 1 - smooth(0, 170, length(mx - wa.x.3, my - wa.y.3))
    let wout.3 = 24 + 9 * wnear.3 + 2.5 * noise(time * 0.3 + 5.1)
    let wt.x.3 = wa.x.3 + wn.x.3 * wout.3 + clamp(mx - wa.x.3, -18, 18) * 0.28 * wnear.3 * (1 - abs(wn.x.3))
    let wt.y.3 = wa.y.3 + wn.y.3 * wout.3 + clamp(my - wa.y.3, -18, 18) * 0.28 * wnear.3 * (1 - abs(wn.y.3))
    prop wp.x.3 = 0 ~lively
    prop wp.y.3 = 0 ~lively
    follow wp.x.3 = if(wdrag == 3 and wmoved, wp0.x + wq.x, wt.x.3)
    follow wp.y.3 = if(wdrag == 3 and wmoved, wp0.y + wq.y, wt.y.3)
    prop wb.3 = 0 ~lively
    follow wb.3 = if(3 < wdg.count, 1, 0)
    prop wh.3 = 0 ~lively
    prop wwob.3 = 0 ~splashy
    let wr.3 = (21 + 3 * wh.3) * wb.3
    let wjit.3 = 0.05 * sin(time * 9 + 3) * wh.3 + wwob.3 * 0.01
    let wsheet.3 = wb.3 * if(wdrag == 3 and wmoved, 0, 1)
    let wa.x.4 = pick(wdg.4.side, W * wdg.4.pos, W * wdg.4.pos, 0, W)
    let wa.y.4 = pick(wdg.4.side, H, 0, H * wdg.4.pos, H * wdg.4.pos)
    let wn.x.4 = pick(wdg.4.side, 0, 0, 1, -1)
    let wn.y.4 = pick(wdg.4.side, -1, 1, 0, 0)
    let wnear.4 = 1 - smooth(0, 170, length(mx - wa.x.4, my - wa.y.4))
    let wout.4 = 24 + 9 * wnear.4 + 2.5 * noise(time * 0.3 + 6.8)
    let wt.x.4 = wa.x.4 + wn.x.4 * wout.4 + clamp(mx - wa.x.4, -18, 18) * 0.28 * wnear.4 * (1 - abs(wn.x.4))
    let wt.y.4 = wa.y.4 + wn.y.4 * wout.4 + clamp(my - wa.y.4, -18, 18) * 0.28 * wnear.4 * (1 - abs(wn.y.4))
    prop wp.x.4 = 0 ~lively
    prop wp.y.4 = 0 ~lively
    follow wp.x.4 = if(wdrag == 4 and wmoved, wp0.x + wq.x, wt.x.4)
    follow wp.y.4 = if(wdrag == 4 and wmoved, wp0.y + wq.y, wt.y.4)
    prop wb.4 = 0 ~lively
    follow wb.4 = if(4 < wdg.count, 1, 0)
    prop wh.4 = 0 ~lively
    prop wwob.4 = 0 ~splashy
    let wr.4 = (21 + 3 * wh.4) * wb.4
    let wjit.4 = 0.05 * sin(time * 9 + 4) * wh.4 + wwob.4 * 0.01
    let wsheet.4 = wb.4 * if(wdrag == 4 and wmoved, 0, 1)
    let wa.x.5 = pick(wdg.5.side, W * wdg.5.pos, W * wdg.5.pos, 0, W)
    let wa.y.5 = pick(wdg.5.side, H, 0, H * wdg.5.pos, H * wdg.5.pos)
    let wn.x.5 = pick(wdg.5.side, 0, 0, 1, -1)
    let wn.y.5 = pick(wdg.5.side, -1, 1, 0, 0)
    let wnear.5 = 1 - smooth(0, 170, length(mx - wa.x.5, my - wa.y.5))
    let wout.5 = 24 + 9 * wnear.5 + 2.5 * noise(time * 0.3 + 8.5)
    let wt.x.5 = wa.x.5 + wn.x.5 * wout.5 + clamp(mx - wa.x.5, -18, 18) * 0.28 * wnear.5 * (1 - abs(wn.x.5))
    let wt.y.5 = wa.y.5 + wn.y.5 * wout.5 + clamp(my - wa.y.5, -18, 18) * 0.28 * wnear.5 * (1 - abs(wn.y.5))
    prop wp.x.5 = 0 ~lively
    prop wp.y.5 = 0 ~lively
    follow wp.x.5 = if(wdrag == 5 and wmoved, wp0.x + wq.x, wt.x.5)
    follow wp.y.5 = if(wdrag == 5 and wmoved, wp0.y + wq.y, wt.y.5)
