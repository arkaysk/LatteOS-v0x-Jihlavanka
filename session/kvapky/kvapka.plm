            // lepkavé vlákna: guľôčky sa nikdy neoddelia od okraja (kotva visí na okraji, strapec na kotve)
            line { from: lx + ux.0 + 2 * noise(0.0, time * 0.35) + if(bdrag == 0, bdx, 0), mid + uy.0 + 2.5 * noise(5.0, time * 0.3) + if(bdrag == 0, bdy, 0); to: lx + kx.0, if(uy.0 > -3, edge + 14, mid + ky.0); width: ur.0 * b.0 * 0.3 * if(bdrag == 0, clamp(1 - (abs(bdx) + abs(bdy)) / 520, 0.22, 1), 1) * (1 - o.pull) * ap; blend: 9 }
