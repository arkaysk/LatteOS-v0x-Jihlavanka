            line { from: lx + ux.33 + 2 * noise(23.1, time * 0.35) + if(bdrag == 33, bdx, 0), mid + uy.33 + 2.5 * noise(47.9, time * 0.3) + if(bdrag == 33, bdy, 0); to: lx + kx.33, if(uy.33 > -3, edge + 14, mid + ky.33); width: ur.33 * b.33 * 0.3 * if(bdrag == 33, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 33 and bsnap, 0, 1) }
            line { from: lx + ux.34 + 2 * noise(23.8, time * 0.35) + if(bdrag == 34, bdx, 0), mid + uy.34 + 2.5 * noise(49.2, time * 0.3) + if(bdrag == 34, bdy, 0); to: lx + kx.34, if(uy.34 > -3, edge + 14, mid + ky.34); width: ur.34 * b.34 * 0.3 * if(bdrag == 34, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 34 and bsnap, 0, 1) }
            line { from: lx + ux.35 + 2 * noise(24.5, time * 0.35) + if(bdrag == 35, bdx, 0), mid + uy.35 + 2.5 * noise(50.5, time * 0.3) + if(bdrag == 35, bdy, 0); to: lx + kx.35, if(uy.35 > -3, edge + 14, mid + ky.35); width: ur.35 * b.35 * 0.3 * if(bdrag == 35, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 35 and bsnap, 0, 1) }
            line { from: lx + ux.36 + 2 * noise(25.2, time * 0.35) + if(bdrag == 36, bdx, 0), mid + uy.36 + 2.5 * noise(51.8, time * 0.3) + if(bdrag == 36, bdy, 0); to: lx + kx.36, if(uy.36 > -3, edge + 14, mid + ky.36); width: ur.36 * b.36 * 0.3 * if(bdrag == 36, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 36 and bsnap, 0, 1) }
            line { from: lx + ux.37 + 2 * noise(25.9, time * 0.35) + if(bdrag == 37, bdx, 0), mid + uy.37 + 2.5 * noise(53.1, time * 0.3) + if(bdrag == 37, bdy, 0); to: lx + kx.37, if(uy.37 > -3, edge + 14, mid + ky.37); width: ur.37 * b.37 * 0.3 * if(bdrag == 37, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 37 and bsnap, 0, 1) }
            line { from: lx + ux.38 + 2 * noise(26.6, time * 0.35) + if(bdrag == 38, bdx, 0), mid + uy.38 + 2.5 * noise(54.4, time * 0.3) + if(bdrag == 38, bdy, 0); to: lx + kx.38, if(uy.38 > -3, edge + 14, mid + ky.38); width: ur.38 * b.38 * 0.3 * if(bdrag == 38, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 38 and bsnap, 0, 1) }
            line { from: lx + ux.39 + 2 * noise(27.3, time * 0.35) + if(bdrag == 39, bdx, 0), mid + uy.39 + 2.5 * noise(55.7, time * 0.3) + if(bdrag == 39, bdy, 0); to: lx + kx.39, if(uy.39 > -3, edge + 14, mid + ky.39); width: ur.39 * b.39 * 0.3 * if(bdrag == 39, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 39 and bsnap, 0, 1) }
            line { from: lx + ux.40 + 2 * noise(28.0, time * 0.35) + if(bdrag == 40, bdx, 0), mid + uy.40 + 2.5 * noise(57.0, time * 0.3) + if(bdrag == 40, bdy, 0); to: lx + kx.40, if(uy.40 > -3, edge + 14, mid + ky.40); width: ur.40 * b.40 * 0.3 * if(bdrag == 40, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 40 and bsnap, 0, 1) }
            line { from: lx + ux.41 + 2 * noise(28.7, time * 0.35) + if(bdrag == 41, bdx, 0), mid + uy.41 + 2.5 * noise(58.3, time * 0.3) + if(bdrag == 41, bdy, 0); to: lx + kx.41, if(uy.41 > -3, edge + 14, mid + ky.41); width: ur.41 * b.41 * 0.3 * if(bdrag == 41, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 41 and bsnap, 0, 1) }
            line { from: lx + ux.42 + 2 * noise(29.4, time * 0.35) + if(bdrag == 42, bdx, 0), mid + uy.42 + 2.5 * noise(59.6, time * 0.3) + if(bdrag == 42, bdy, 0); to: lx + kx.42, if(uy.42 > -3, edge + 14, mid + ky.42); width: ur.42 * b.42 * 0.3 * if(bdrag == 42, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 42 and bsnap, 0, 1) }
            line { from: lx + ux.43 + 2 * noise(30.1, time * 0.35) + if(bdrag == 43, bdx, 0), mid + uy.43 + 2.5 * noise(60.9, time * 0.3) + if(bdrag == 43, bdy, 0); to: lx + kx.43, if(uy.43 > -3, edge + 14, mid + ky.43); width: ur.43 * b.43 * 0.3 * if(bdrag == 43, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 43 and bsnap, 0, 1) }
            line { from: lx + ux.44 + 2 * noise(30.8, time * 0.35) + if(bdrag == 44, bdx, 0), mid + uy.44 + 2.5 * noise(62.2, time * 0.3) + if(bdrag == 44, bdy, 0); to: lx + kx.44, if(uy.44 > -3, edge + 14, mid + ky.44); width: ur.44 * b.44 * 0.3 * if(bdrag == 44, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 44 and bsnap, 0, 1) }
            line { from: lx + ux.45 + 2 * noise(31.5, time * 0.35) + if(bdrag == 45, bdx, 0), mid + uy.45 + 2.5 * noise(63.5, time * 0.3) + if(bdrag == 45, bdy, 0); to: lx + kx.45, if(uy.45 > -3, edge + 14, mid + ky.45); width: ur.45 * b.45 * 0.3 * if(bdrag == 45, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 45 and bsnap, 0, 1) }
            line { from: lx + ux.46 + 2 * noise(32.2, time * 0.35) + if(bdrag == 46, bdx, 0), mid + uy.46 + 2.5 * noise(64.8, time * 0.3) + if(bdrag == 46, bdy, 0); to: lx + kx.46, if(uy.46 > -3, edge + 14, mid + ky.46); width: ur.46 * b.46 * 0.3 * if(bdrag == 46, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 46 and bsnap, 0, 1) }
            line { from: lx + ux.47 + 2 * noise(32.9, time * 0.35) + if(bdrag == 47, bdx, 0), mid + uy.47 + 2.5 * noise(66.1, time * 0.3) + if(bdrag == 47, bdy, 0); to: lx + kx.47, if(uy.47 > -3, edge + 14, mid + ky.47); width: ur.47 * b.47 * 0.3 * if(bdrag == 47, if(bsnap, 0, 0.12 + 0.88 * clamp(1 - length(bdx, bdy) / 180, 0, 1)), 1) * (1 - o.pull) * ap; blend: 9 * if(bdrag == 47 and bsnap, 0, 1) }
            // Štart a vypínač: vlastná „voda“ pod okrajom; s hlavou a medzi sebou ich spája most `link`
            box { from: px - 34 - 14 * flow2 * stir, edge; size: (sx - px + 68 + 28 * flow2 * stir) * so, 70 }
            ellipse { at: sx, s.y; radius: (33 + 3 * hs) * so * (1 - smooth(0, 0.08, dsw)); scale: 1 + squish.s * 0.08 + jit.s + swob * 0.01, 1 - squish.s * 0.12 - jit.s - swob * 0.01; blend: link * so }
            // upozornenia: kvapôčky prilepené hore vľavo na Hodinách (najviac tri) a jedna, ktorá práve padá
            ellipse { at: sx - 25, s.y - 23; radius: 6.5 * so * (1 - dsh) * if(notes.count > 0, 1, 0); blend: 8 }
            ellipse { at: sx - 10, s.y - 34; radius: 5.5 * so * (1 - dsh) * if(notes.count > 1, 1, 0); blend: 8 }
            ellipse { at: sx + 6, s.y - 37; radius: 4.8 * so * (1 - dsh) * if(notes.count > 2, 1, 0); blend: 8 }
            ellipse { at: sx + 4, s.y - 110 + 72 * nfall; radius: 6 * so * if(nfall > 0.02 and nfall < 0.97, 1, 0); scale: 0.85, 1.25; blend: 10 }
            ellipse { at: px, p.y; radius: (19 + 4 * hp) * so * (1 - smooth(0, 0.12, pm)); scale: 1 + squish.p * 0.08 + jit.p, 1 - squish.p * 0.12 - jit.p; blend: link * so }
            line { from: px, p.y - 4; to: sx, s.y - 6; width: thread.ps * (1 - max(dsh, pm)); blend: 12 * clamp(thread.ps * (1 - max(dsh, pm)) / 3, 0, 1) }
            line { from: sx + 8, s.y - 12; to: bl + 18, bottom - 14; width: thread.sb * ap * (1 - dsh); blend: 14 * clamp(thread.sb * ap * (1 - dsh) / 3, 0, 1) }
            ellipse { at: drip.x, drip.y; radius: drip.r * so; blend: 8 }
            // hladina: prehnutie pod Hodinami, zvyšková kvapka a vlnky (zliate s okrajom, preto bez kreslenia krku)
            // (neaktívne majú nulový polomer — elipsa stlačená na nulovú výšku by v tele vyrezala diery)
            ellipse { at: sx, edge; radius: 30 * if(sag.s > 0.3, 1, 0); scale: 1, max(sag.s, 0.3) / 30; blend: 16 * clamp(sag.s / 6, 0, 1) }
            ellipse { at: stray.x, edge - 5.5 * stray * 0.7; radius: 5.5 * stray * so; blend: 7 * clamp(stray * 5.5 / 3, 0, 1) }
            ellipse { at: vx.0 - vd.0, edge; radius: 9 * if(vh.0 > 0.3, 1, 0); scale: 1, max(vh.0, 0.3) / 9; blend: 8 * clamp(vh.0 / 3, 0, 1) }
            ellipse { at: vx.0 + vd.0, edge; radius: 9 * if(vh.0 > 0.3, 1, 0); scale: 1, max(vh.0, 0.3) / 9; blend: 8 * clamp(vh.0 / 3, 0, 1) }
            ellipse { at: vx.1 - vd.1, edge; radius: 9 * if(vh.1 > 0.3, 1, 0); scale: 1, max(vh.1, 0.3) / 9; blend: 8 * clamp(vh.1 / 3, 0, 1) }
            ellipse { at: vx.1 + vd.1, edge; radius: 9 * if(vh.1 > 0.3, 1, 0); scale: 1, max(vh.1, 0.3) / 9; blend: 8 * clamp(vh.1 / 3, 0, 1) }
            ellipse { at: vx.2 - vd.2, edge; radius: 9 * if(vh.2 > 0.3, 1, 0); scale: 1, max(vh.2, 0.3) / 9; blend: 8 * clamp(vh.2 / 3, 0, 1) }
            ellipse { at: vx.2 + vd.2, edge; radius: 9 * if(vh.2 > 0.3, 1, 0); scale: 1, max(vh.2, 0.3) / 9; blend: 8 * clamp(vh.2 / 3, 0, 1) }
            ellipse { at: vx.3 - vd.3, edge; radius: 9 * if(vh.3 > 0.3, 1, 0); scale: 1, max(vh.3, 0.3) / 9; blend: 8 * clamp(vh.3 / 3, 0, 1) }
            ellipse { at: vx.3 + vd.3, edge; radius: 9 * if(vh.3 > 0.3, 1, 0); scale: 1, max(vh.3, 0.3) / 9; blend: 8 * clamp(vh.3 / 3, 0, 1) }
        }
        // obraz režimu okien v hlave (30. 9., návrh používateľa): akoby cez kvapku presvitali okná — páska (pás
        // okolo valca, boky skrátené), plávajúce (nad sebou), dlaždice. Pri prepnutí sa okienka prelejú do nového
        // usporiadania; myš nad hlavou obraz zvýrazní (ľavý klik režim prepne)
        group {
            opacity: (26% + 34% * hh) * ap * (1 - o.pull)
            box { at: hx + (wp * -22 + wf * -7 + wd * -9) / ws + 1.5 * noise(0.3, time * 0.2), mid - 8 + (wp * 1 + wf * -7 + wd * 0) / ws; size: (wp * 11 + wf * 26 + wd * 17) / ws, (wp * 20 + wf * 19 + wd * 34) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 0.6 + wd * 1) / ws }
            box { at: hx + (wp * 0 + wf * 0 + wd * 10) / ws + 1.5 * noise(1.3, time * 0.2), mid - 8 + (wp * 0 + wf * 0 + wd * -9) / ws; size: (wp * 24 + wf * 26 + wd * 18) / ws, (wp * 30 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 1 + wf * 0.8 + wd * 0.8) / ws }
            box { at: hx + (wp * 22 + wf * 7 + wd * 10) / ws + 1.5 * noise(2.3, time * 0.2), mid - 8 + (wp * 1 + wf * 7 + wd * 9) / ws; size: (wp * 11 + wf * 26 + wd * 18) / ws, (wp * 20 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 1 + wd * 0.8) / ws }
        }
        // odlesk: každá guľa odráža svetlo sama (bodka hore vľavo), hlava najväčšiu
        group {
            blur: 1.5
            opacity: 70% * ap
            ellipse { at: hx - 14, mid - 32; radius: 4; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
            repeat k in 0..48 {
                // stred guľôčky a vzdialenosť kurzora (aktívne svetlo)
                let qx = lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)
                let qy = mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)
                let qd = length(cu - qx, cv - qy)
                ellipse { at: qx - ur.$k * 0.4, qy - ur.$k * 0.52; radius: 0.11 * ur.$k * b.$k; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
                // aktívne svetlo: odlesk na strane ku kurzoru, bližšie = jasnejší
                ellipse { at: qx + (cu - qx) / max(qd, 1) * ur.$k * 0.55, qy + (cv - qy) / max(qd, 1) * ur.$k * 0.55; radius: 0.13 * ur.$k * b.$k * (1 - smooth(50, 360, qd)); color: #ffe4bd }
            }
            // hlava a Hodiny: to isté
            ellipse { at: hx + (cu - hx) / max(length(cu - hx, cv - mid + 8), 1) * 22, mid - 8 + (cv - mid + 8) / max(length(cu - hx, cv - mid + 8), 1) * 22; radius: 5 * (1 - smooth(60, 420, length(cu - hx, cv - mid + 8))); color: #ffe4bd }
            ellipse { at: sx + (cu - sx) / max(length(cu - sx, cv - s.y), 1) * 20, s.y + (cv - s.y) / max(length(cu - sx, cv - s.y), 1) * 20; radius: 4.5 * so * (1 - smooth(0, 0.12, dsh)) * (1 - smooth(60, 420, length(cu - sx, cv - s.y))); color: #ffe4bd }
        }
        // farba upozornení podľa naliehavosti (nízka mätová, bežná jantárová, kritická červená)
        ellipse { at: sx - 25, s.y - 23; radius: 3.8 * so * (1 - dsh) * if(notes.count > 0, 1, 0); color: pick(notes.0.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx - 10, s.y - 34; radius: 3.2 * so * (1 - dsh) * if(notes.count > 1, 1, 0); color: pick(notes.1.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx + 6, s.y - 37; radius: 2.8 * so * (1 - dsh) * if(notes.count > 2, 1, 0); color: pick(notes.2.urgency, #9ed6bd, #e4b283, #e07a5f) }
        // základňa kvapky: telo (0) a hlava (1) — ľavý klik = režim okien, ťahanie ľavým aj pravým = presun,
        // koliesko = okná, pravý klik nič. Hrbolčeky s oknami (icon_hit) majú vlastné kliky a ležia navrchu.
        repeat z in 0..2 {
            zone box base.$z { at: if(z == 0, bl + w / 2, hx), if(z == 0, mid, by - 4); size: if(z == 0, w, 66), if(z == 0, h, 66); corner: if(z == 0, c, 33); cursor: pointer }
        }
        zone ellipse start_hit { at: sx, s.y; radius: 34; cursor: pointer; active: solo }
        zone ellipse power_hit { at: px, p.y; radius: 19; cursor: pointer; active: solo }
        repeat k in 0..48 {
            zone box icon_hit.$k { at: (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)); size: ur.$k * 2, ur.$k * 2; corner: ur.$k; cursor: pointer; active: k < n and not free }
        }
    }

    // odtrhnutá kvapka: za myšou; pri stekaní padá (smerom dole na obrazovke), naťahuje sa, zmenšuje a kvapká
    body {
        color: coffee
        light: 16%, gy - gh / 2 - 10, 30
        rim: 30%
        shadow: 0, 8, 18, 40%
        opacity: if(free, 1, 0) * (1 - 0.42 * v * (1 - m))
        box { at: gx, gy + 150 * fall; size: gw * (1 - 0.7 * fall), gh * (1 + 0.5 * fall) * (1 - 0.8 * fall); corner: min(gw, gh) / 2 * (1 - 0.7 * fall) }
        ellipse { at: gx - 12, gy + gh * 0.4 + 210 * fall * fall; radius: 9 * fall * (1 - fall) * 4; blend: 10 }
        ellipse { at: gx + 16, gy + gh * 0.3 + 260 * fall * fall; radius: 6 * fall * (1 - fall) * 4; blend: 8 }
    }

    // ikony stoja rovno: bod rámca (u, v) → obrazovka podľa okraja; veľkosť podľa guľôčky
    repeat k in 0..48 {
        image icon.$k { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0))) - ur.$k * 0.52, pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))) - ur.$k * 0.52; size: ur.$k * 1.04, ur.$k * 1.04; opacity: b.$k * ap * (1 - 0.55 * dm.$k); show: k < n }
        box { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76), pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76 + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))); size: if(side == vlavo or side == vpravo, 3, 12), if(side == vlavo or side == vpravo, 12, 3); corner: 1.5; color: ink; opacity: ap; show: k < n and wins.$k.active }
    }

    image power_icon = icon "system-shutdown-symbolic", 18, 18
    // Hodiny: čas a dátum stoja rovno v kvapke (bod rámca → obrazovka)
    let cxs = pick(side, sx, W - sx, edge - s.y, W - edge + s.y)
    let cys = pick(side, s.y + H - edge, edge - s.y, sx, H - sx)
    // bublina nového upozornenia: vyleje sa z Hodín smerom od okraja (v obrazovke, text rovno), 6 s
    let vert = if(side == vlavo or side == vpravo, 1, 0)
    let away.x = pick(side, 0, 0, 1, -1)
    let away.y = pick(side, -1, 1, 0, 0)
    let tst.x = cxs + if(vert, away.x * (40 + 170 * toast.p), 170 * toast.p)
    let tst.y = cys + if(vert, 0, away.y * (58 * toast.p))
    body {
        color: coffee
        rim: 30%
        shadow: 0, 6, 16, 30% * toast.p
        opacity: clamp(toast.p * 3, 0, 1) * so
        ellipse { at: cxs, cys; radius: 33 }
        box { at: tst.x, tst.y; size: 40 + 300 * toast.p, 30 + 14 * toast.p; corner: 22; blend: 22 }
    }
    // hodiny: digitálny čas a dátum v kvapke (bez očí; ľavý klik alebo kláves Win otvorí spúšťač)
    text now.time { at: cxs, cys - 5; anchor: center; size: 16; weight: 800; color: ink; opacity: so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }
    text pick(now.weekday, "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat") { at: cxs - 2, cys + 12; anchor: right center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }
    text "{now.day}. {now.month}." { at: cxs + 1, cys + 12; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.08, dsw)); show: solo }

    text toast { at: tst.x - 135, tst.y; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 600; color: ink; opacity: clamp(toast.p * 2 - 1, 0, 1) * so; show: solo }

    // ── spúšťač (vyteká z hodiniek smerom od okraja; v obrazovke, text rovno) ──
    // vzhľad spúšťača (1. 10.: používateľovi sa nepáčia písmo a farby → varianty na výber); písmo LatteOS Manrope
    let l.card = coffee                        // karta (Goo: káva podľa Baristu)
    let l.glass = 0%
    let l.ink = ink                            // text
    let l.acc = #e4b283                        // zvýraznenie (karamel)
    let l.onacc = #2a170c                      // text na zvýraznení
    let l.hov = #ffffff                        // podklad riadku pod myšou (s nízkou nepriehľadnosťou)
    let l.field = #000000                      // podklad poľa
    let l.sel = #6b4a33                        // výber textu
    let l.modes = mix(coffee, #e4b283, 0.55)   // ikona režimu a jeho výber
    let l.menu = mix(coffee, #f3ebdd, 0.08)    // kontextová ponuka
    let l.bme = #e4b283                        // bublina používateľa
    let l.bme_ink = #2a170c
    let l.bai = mix(coffee, #f3ebdd, 0.13)     // bublina AI
    let l.bai_ink = ink
    let dw = 640
    let dh = 560
    // ucho (roh okna) je presne nad Hodinami (na bočnom okraji presne vedľa): kvapka vystúpi kolmo od okraja a späť
    // padne rovno ako pod ťarchou. Okno rastie od ucha doprava (dolu), ak je tam miesto, inak doľava (hore).
    let d.rise = 74
    let dk.x = if(vert, cxs + away.x * d.rise, cxs)
    let dk.y = if(vert, cys, cys + away.y * d.rise)
    let d.sx = if(vert, 0, if(cxs + dw + 12 <= W, 1, -1))
    let d.sy = if(vert, if(cys + dh + 12 <= H, 1, -1), 0)
    let dt.x = if(vert, dk.x + away.x * dw / 2, dk.x + d.sx * dw / 2)
    let dt.y = if(vert, dk.y + d.sy * dh / 2, dk.y + away.y * dh / 2)
    // kvapka Hodín sa odlepí od lišty, pružne dopláva do rohu karty najbližšieho Hodinám a karta z nej vyrastie;
    // kým je okno otvorené, ostane v rohu ako trčiace „ucho“ s časom (ako v Marei — je poznať, odkiaľ okno je).
    // Pri zatvorení sa karta najprv zloží do ucha a až potom ucho pružne odkvapne domov na okraj (odrazí sa,
    // zachveje, po hladine sa rozbehnú vlnky). dsw: cesta ucha 0 doma … 1 v rohu, pružina s prestrelením.
    let d.grow = smooth(0.35, 1, dsh) * smooth(0.75, 0.97, dsw)
    let db.x = cxs + (dk.x - cxs) * dsw
    let db.y = cys + (dk.y - cys) * dsw
    // vlákno od Hodín k letiacej kvapke (sliz, 1. 10.): čím ďalej, tým tenšie; pri 58 px praskne a konce sa stiahnu,
    // na spiatočnej ceste sa pod 24 px zlepí
    let e.d = length(db.x - cxs, db.y - cys)
    let e.ux = (db.x - cxs) / max(e.d, 1)
    let e.uy = (db.y - cys) / max(e.d, 1)
    let dc.x = dk.x + (dt.x - dk.x) * d.grow
    let dc.y = dk.y + (dt.y - dk.y) * d.grow
    let d0.x = dt.x - dw / 2 + 28              // obsah: ľavý horný roh
    let d0.y = dt.y - dh / 2 + 24
    let cw = dw - 56                           // šírka obsahu
    let dshow = clamp(dsh * 2 - 1, 0, 1)
    body {
        color: l.card
        glass: l.glass
        light: 10%, dc.y - dh / 2, 60
        rim: 30%
        shadow: 0, 10, 30, 40% * dsh
        opacity: if(dsw > 0.02 or dsh > 0.01, 1, 0) * so
        box { at: dc.x, dc.y; size: (60 + (dw - 60) * d.grow) * if(d.grow > 0.01, 1, 0), (60 + (dh - 60) * d.grow) * if(d.grow > 0.01, 1, 0); corner: 30 - 2 * d.grow }
        // vlákno k Hodinám (kým nepraskne) a po prasknutí pahýle na oboch koncoch, ktoré sa stiahnu
        ellipse { at: cxs, cys; radius: 15 * if(dsw > 0.02 and not esnap, 1, 0); blend: 12 }
        line { from: cxs, cys; to: db.x, db.y; width: if(esnap or dsw < 0.02, 0, 5 + 20 * pow(clamp(1 - e.d / 58, 0, 1), 1.4)); blend: 12 * if(esnap, 0, 1) }
        line { from: db.x, db.y; to: db.x - e.ux * 22 * estub, db.y - e.uy * 22 * estub; width: 6 * estub; blend: 8 * clamp(estub * 3, 0, 1) }
        line { from: cxs, cys; to: cxs + e.ux * 22 * estub, cys + e.uy * 22 * estub; width: 6 * estub; blend: 8 * clamp(estub * 3, 0, 1) }
        // ucho = kvapka Hodín (trčí z rohu, zliata s kartou)
        ellipse { at: db.x, db.y; radius: 33 * clamp(dsw * 4, 0, 1); scale: 1 + swob * 0.01, 1 - swob * 0.01; blend: 18 * d.grow }
    }
    text now.time { at: db.x, db.y - 1; anchor: center; size: 13; weight: 800; color: ink; opacity: so * clamp(dsw * 3 - 0.5, 0, 1); show: dsw > 0.1 }
    // obsah: y0 = horný okraj obsahu pod poľom; riadok režimu a počasia sú pri spodku karty
    let y0 = d0.y + 64
    let yc = d0.y + 456                        // riadok režimu (čipy)
    let yw = d0.y + 494                        // riadok počasia
    let show_chat = smode == 0 and not wx_detail
    let show_favs = smode == 1 and not typing and not wx_detail
    let show_hits = smode > 0 and not wx_detail and not show_favs
    // výber režimu: tekutý stĺpec kapsúl vyteká z ikony v poli (mo 0 → 1)
    prop mo = 0 ~springy
    follow mo = if(mode_open and dash, 1, 0)
    // rozhovor s AI: bubliny sa merajú samy, najnovšia navrchu; kým AI píše, navrchu pulzuje kvapka „…“
    prop aiw = 0 ~lively
    follow aiw = if(ai_wait, 1, 0)
    fact chst = 0
    spring glide = 220, 30
    prop chs = 0 ~glide
    follow chs = chst
    measure ch.0
    measure ch.1
    measure ch.2
    measure ch.3
    measure ch.4
    measure ch.5
    measure ch.6
    measure ch.7
    let cy.0 = y0 + 8 + 50 * aiw - chs
    let cy.1 = cy.0 + if(0 < chat.count, ch.0.height + 34, 0)
    let cy.2 = cy.1 + if(1 < chat.count, ch.1.height + 34, 0)
    let cy.3 = cy.2 + if(2 < chat.count, ch.2.height + 34, 0)
    let cy.4 = cy.3 + if(3 < chat.count, ch.3.height + 34, 0)
    let cy.5 = cy.4 + if(4 < chat.count, ch.4.height + 34, 0)
    let cy.6 = cy.5 + if(5 < chat.count, ch.5.height + 34, 0)
    let cy.7 = cy.6 + if(6 < chat.count, ch.6.height + 34, 0)
    let chh = cy.7 + if(7 < chat.count, ch.7.height + 34, 0) - cy.0 + 50 * aiw
    let bx.0 = if(chat.0.me, d0.x + 4, d0.x + cw - ch.0.width - 30)
    let bv.0 = if(0 < chat.count and show_chat, 1, 0)
    let bx.1 = if(chat.1.me, d0.x + 4, d0.x + cw - ch.1.width - 30)
    let bv.1 = if(1 < chat.count and show_chat, 1, 0)
    let bx.2 = if(chat.2.me, d0.x + 4, d0.x + cw - ch.2.width - 30)
    let bv.2 = if(2 < chat.count and show_chat, 1, 0)
    let bx.3 = if(chat.3.me, d0.x + 4, d0.x + cw - ch.3.width - 30)
    let bv.3 = if(3 < chat.count and show_chat, 1, 0)
    let bx.4 = if(chat.4.me, d0.x + 4, d0.x + cw - ch.4.width - 30)
    let bv.4 = if(4 < chat.count and show_chat, 1, 0)
    let bx.5 = if(chat.5.me, d0.x + 4, d0.x + cw - ch.5.width - 30)
    let bv.5 = if(5 < chat.count and show_chat, 1, 0)
    let bx.6 = if(chat.6.me, d0.x + 4, d0.x + cw - ch.6.width - 30)
    let bv.6 = if(6 < chat.count and show_chat, 1, 0)
    let bx.7 = if(chat.7.me, d0.x + 4, d0.x + cw - ch.7.width - 30)
    let bv.7 = if(7 < chat.count and show_chat, 1, 0)
    // čipy v riadku režimu: šírka podľa textu
    measure cm.0
    measure cm.1
    measure cm.2
    measure cm.3
    measure cm.4
    measure cm.5
    measure cm.6
    let chx.0 = d0.x
    let chx.1 = chx.0 + if(0 < chips.count, cm.0.width + 36, 0)
    let chx.2 = chx.1 + if(1 < chips.count, cm.1.width + 36, 0)
    let chx.3 = chx.2 + if(2 < chips.count, cm.2.width + 36, 0)
    let chx.4 = chx.3 + if(3 < chips.count, cm.3.width + 36, 0)
    let chx.5 = chx.4 + if(4 < chips.count, cm.4.width + 36, 0)
    let chx.6 = chx.5 + if(5 < chips.count, cm.5.width + 36, 0)
    measure wxp
    let wxs = d0.x + 16 + wxp.width + 14         // začiatok variantov počasia
    group {
        opacity: dshow
        show: dsh > 0.5
        // pole: ikona režimu + text (alebo názov záložky pri premenovaní)
        box { at: d0.x + cw / 2, d0.y + 24; size: cw, 48; corner: 24; color: l.field; opacity: 30% }
        box { at: d0.x + cw / 2, d0.y + 24; size: cw, 48; corner: 24; color: l.acc; opacity: if(renaming, 22%, 0) }
        text hint { at: d0.x + 54, d0.y + 24; anchor: left center; width: cw - 70; lines: 1; size: 15; color: l.ink; opacity: 45%; show: not typing and not renaming; family: "Manrope" }
        input query { at: d0.x + 54, d0.y + 24; width: cw - 70; size: 15; color: l.ink; selection: l.sel; family: "Manrope" }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        // riadky: aplikácie, súbory, vyhľadávače, príkazy
        repeat k in 0..10 {
            box { at: d0.x + cw / 2, y0 + 17 + k * 34; size: cw, 32; corner: 12; color: if(hits.$k.warn, #e07a5f, l.hov); opacity: if(hits.$k.warn, 22%, if(k == sel and typing, 11%, if(hit_hot == k, 7%, 0))); show: show_hits and k < hits.count }
            image hits.$k.icon { at: d0.x + 10, y0 + 5 + k * 34; size: 24, 24; show: show_hits and k < hits.count }
            text hits.$k.name { at: d0.x + 44, y0 + 17 + k * 34; anchor: left center; width: cw - 190; lines: 1; size: 13.5; color: l.ink; show: show_hits and k < hits.count; family: "Manrope" }
            text hits.$k.sub { at: d0.x + cw - 10, y0 + 17 + k * 34; anchor: right center; width: 140; lines: 1; size: 11; color: l.ink; opacity: 55%; show: show_hits and k < hits.count; family: "Manrope" }
        }
        // záložka: obľúbené aplikácie (6 × 3)
        repeat k in 0..18 {
            box { at: d0.x + (k - 6 * floor(k / 6)) * 96 + 48, y0 + 56 + floor(k / 6) * 106; size: 90, 98; corner: 18; color: l.hov; opacity: if(fav_hot == k, 9%, 0); show: show_favs and k < favs.count }
            image favs.$k.icon { at: d0.x + (k - 6 * floor(k / 6)) * 96 + 28, y0 + 22 + floor(k / 6) * 106; size: 40, 40; show: show_favs and k < favs.count }
            text favs.$k.name { at: d0.x + (k - 6 * floor(k / 6)) * 96 + 48, y0 + 82 + floor(k / 6) * 106; anchor: center; width: 86; lines: 2; size: 11; color: l.ink; opacity: 85%; show: show_favs and k < favs.count; family: "Manrope" }
        }
        // prázdny obsah: nápoveda podľa režimu
        text note { at: d0.x + 4, y0 + 22; anchor: left center; width: cw - 8; lines: 3; size: 12.5; color: l.ink; opacity: 55%; show: not wx_detail and ((show_chat and chat.count < 1 and not ai_wait) or (show_hits and hits.count < 1) or (show_favs and favs.count < 1)); family: "Manrope" }
        // predpoveď počasia (Detaily): 8 stĺpcov — hodiny dňa alebo dni týždňa
        text "FORECAST · {wx_place}" { at: d0.x + 4, y0 + 18; anchor: left center; size: 10.5; weight: 800; color: l.acc; show: wx_detail; family: "Fraunces" }
        repeat k in 0..8 {
            box { at: d0.x + k * (cw / 8) + cw / 16, y0 + 110; size: cw / 8 - 8, 132; corner: 22; color: l.hov; opacity: 6%; show: wx_detail and k < wx.count }
            text wx.$k.label { at: d0.x + k * (cw / 8) + cw / 16, y0 + 64; anchor: center; size: 11; weight: 700; color: l.ink; opacity: 70%; show: wx_detail and k < wx.count; family: "Manrope" }
            text wx.$k.glyph { at: d0.x + k * (cw / 8) + cw / 16, y0 + 106; anchor: center; size: 26; color: l.ink; show: wx_detail and k < wx.count }
            text wx.$k.temp { at: d0.x + k * (cw / 8) + cw / 16, y0 + 150; anchor: center; size: 12.5; weight: 700; color: l.ink; show: wx_detail and k < wx.count; family: "Manrope" }
        }
    }
    // rozhovor: bubliny používateľa (mlieko, vľavo) a AI (káva, vpravo), každá s kvapôčkou-chvostíkom k poľu
    group {
        opacity: dshow
        show: dsh > 0.5 and show_chat
        clip box { at: d0.x + cw / 2, y0 + 182; size: cw + 20, 364 }
        body {
            color: l.bai
            rim: 30%
            light: 12%, 0, 30
            ellipse { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; radius: 20 * aiw; scale: 1.5 + 0.08 * sin(time * 6), 1; blend: 8 * aiw }
            box { from: bx.0, cy.0; size: (ch.0.width + 26) * bv.0 * if(chat.0.me, 0, 1), ch.0.height + 22; corner: 18 }
            ellipse { at: bx.0 + ch.0.width + 24, cy.0 + 2; radius: 6 * bv.0 * if(chat.0.me, 0, 1); blend: 8 * bv.0 * if(chat.0.me, 0, 1) }
            box { from: bx.1, cy.1; size: (ch.1.width + 26) * bv.1 * if(chat.1.me, 0, 1), ch.1.height + 22; corner: 18 }
            ellipse { at: bx.1 + ch.1.width + 24, cy.1 + 2; radius: 6 * bv.1 * if(chat.1.me, 0, 1); blend: 8 * bv.1 * if(chat.1.me, 0, 1) }
            box { from: bx.2, cy.2; size: (ch.2.width + 26) * bv.2 * if(chat.2.me, 0, 1), ch.2.height + 22; corner: 18 }
            ellipse { at: bx.2 + ch.2.width + 24, cy.2 + 2; radius: 6 * bv.2 * if(chat.2.me, 0, 1); blend: 8 * bv.2 * if(chat.2.me, 0, 1) }
            box { from: bx.3, cy.3; size: (ch.3.width + 26) * bv.3 * if(chat.3.me, 0, 1), ch.3.height + 22; corner: 18 }
            ellipse { at: bx.3 + ch.3.width + 24, cy.3 + 2; radius: 6 * bv.3 * if(chat.3.me, 0, 1); blend: 8 * bv.3 * if(chat.3.me, 0, 1) }
            box { from: bx.4, cy.4; size: (ch.4.width + 26) * bv.4 * if(chat.4.me, 0, 1), ch.4.height + 22; corner: 18 }
            ellipse { at: bx.4 + ch.4.width + 24, cy.4 + 2; radius: 6 * bv.4 * if(chat.4.me, 0, 1); blend: 8 * bv.4 * if(chat.4.me, 0, 1) }
            box { from: bx.5, cy.5; size: (ch.5.width + 26) * bv.5 * if(chat.5.me, 0, 1), ch.5.height + 22; corner: 18 }
            ellipse { at: bx.5 + ch.5.width + 24, cy.5 + 2; radius: 6 * bv.5 * if(chat.5.me, 0, 1); blend: 8 * bv.5 * if(chat.5.me, 0, 1) }
            box { from: bx.6, cy.6; size: (ch.6.width + 26) * bv.6 * if(chat.6.me, 0, 1), ch.6.height + 22; corner: 18 }
            ellipse { at: bx.6 + ch.6.width + 24, cy.6 + 2; radius: 6 * bv.6 * if(chat.6.me, 0, 1); blend: 8 * bv.6 * if(chat.6.me, 0, 1) }
            box { from: bx.7, cy.7; size: (ch.7.width + 26) * bv.7 * if(chat.7.me, 0, 1), ch.7.height + 22; corner: 18 }
            ellipse { at: bx.7 + ch.7.width + 24, cy.7 + 2; radius: 6 * bv.7 * if(chat.7.me, 0, 1); blend: 8 * bv.7 * if(chat.7.me, 0, 1) }
        }
        body {
            color: l.bme
            rim: 30%
            light: 16%, 0, 30
            box { from: bx.0, cy.0; size: (ch.0.width + 26) * bv.0 * if(chat.0.me, 1, 0), ch.0.height + 22; corner: 18 }
            ellipse { at: bx.0 + 2, cy.0 + 2; radius: 6 * bv.0 * if(chat.0.me, 1, 0); blend: 8 * bv.0 * if(chat.0.me, 1, 0) }
            box { from: bx.1, cy.1; size: (ch.1.width + 26) * bv.1 * if(chat.1.me, 1, 0), ch.1.height + 22; corner: 18 }
            ellipse { at: bx.1 + 2, cy.1 + 2; radius: 6 * bv.1 * if(chat.1.me, 1, 0); blend: 8 * bv.1 * if(chat.1.me, 1, 0) }
            box { from: bx.2, cy.2; size: (ch.2.width + 26) * bv.2 * if(chat.2.me, 1, 0), ch.2.height + 22; corner: 18 }
            ellipse { at: bx.2 + 2, cy.2 + 2; radius: 6 * bv.2 * if(chat.2.me, 1, 0); blend: 8 * bv.2 * if(chat.2.me, 1, 0) }
            box { from: bx.3, cy.3; size: (ch.3.width + 26) * bv.3 * if(chat.3.me, 1, 0), ch.3.height + 22; corner: 18 }
            ellipse { at: bx.3 + 2, cy.3 + 2; radius: 6 * bv.3 * if(chat.3.me, 1, 0); blend: 8 * bv.3 * if(chat.3.me, 1, 0) }
            box { from: bx.4, cy.4; size: (ch.4.width + 26) * bv.4 * if(chat.4.me, 1, 0), ch.4.height + 22; corner: 18 }
            ellipse { at: bx.4 + 2, cy.4 + 2; radius: 6 * bv.4 * if(chat.4.me, 1, 0); blend: 8 * bv.4 * if(chat.4.me, 1, 0) }
            box { from: bx.5, cy.5; size: (ch.5.width + 26) * bv.5 * if(chat.5.me, 1, 0), ch.5.height + 22; corner: 18 }
            ellipse { at: bx.5 + 2, cy.5 + 2; radius: 6 * bv.5 * if(chat.5.me, 1, 0); blend: 8 * bv.5 * if(chat.5.me, 1, 0) }
            box { from: bx.6, cy.6; size: (ch.6.width + 26) * bv.6 * if(chat.6.me, 1, 0), ch.6.height + 22; corner: 18 }
            ellipse { at: bx.6 + 2, cy.6 + 2; radius: 6 * bv.6 * if(chat.6.me, 1, 0); blend: 8 * bv.6 * if(chat.6.me, 1, 0) }
            box { from: bx.7, cy.7; size: (ch.7.width + 26) * bv.7 * if(chat.7.me, 1, 0), ch.7.height + 22; corner: 18 }
            ellipse { at: bx.7 + 2, cy.7 + 2; radius: 6 * bv.7 * if(chat.7.me, 1, 0); blend: 8 * bv.7 * if(chat.7.me, 1, 0) }
        }
        text "• • •" { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; anchor: center; size: 12; weight: 800; color: l.bai_ink; opacity: aiw * (0.5 + 0.5 * sin(time * 6)); family: "Manrope" }
        repeat k in 0..8 {
            text chat.$k.txt { at: bx.$k + 13, cy.$k + 11 + ch.$k.height / 2; anchor: left center; size: 13; line_height: 1.3; color: if(chat.$k.me, l.bme_ink, l.bai_ink); measure: ch.$k; show: k < chat.count; family: "Manrope" }
        }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        // riadok režimu: čipy (záložky obľúbených + „+“, služba a model AI, vyhľadávač…)
        repeat k in 0..7 {
            box { at: chx.$k + (cm.$k.width + 28) / 2, yc; size: cm.$k.width + 28, 32; corner: 16; color: if(chips.$k.on, l.acc, l.hov); opacity: if(chips.$k.on, 90%, if(chip_hot == k, 14%, 7%)); show: k < chips.count }
            text chips.$k.label { at: chx.$k + 14, yc; anchor: left center; size: 12; weight: 700; color: if(chips.$k.on, l.onacc, l.ink); measure: cm.$k; show: k < chips.count; family: "Manrope" }
        }
        // úzky riadok počasia: miesto · Dnes / Zajtra / Týždeň · súhrn · Detaily
        box { at: d0.x + cw / 2, yw; size: cw, 28; corner: 14; color: l.field; opacity: 18% }
        text wx_place { at: d0.x + 14, yw; anchor: left center; size: 11; weight: 700; color: l.ink; opacity: 75%; measure: wxp; family: "Manrope" }
        repeat k in 0..3 {
            box { at: wxs + k * 62 + 29, yw; size: 58, 22; corner: 11; color: if(wx_view == k, l.acc, l.hov); opacity: if(wx_view == k, 85%, if(wx_hot == k, 12%, 0)) }
        }
        text "Today" { at: wxs + 29, yw; anchor: center; size: 10.5; weight: 700; color: if(wx_view == 0, l.onacc, l.ink); family: "Manrope" }
        text "Tomorrow" { at: wxs + 91, yw; anchor: center; size: 10.5; weight: 700; color: if(wx_view == 1, l.onacc, l.ink); family: "Manrope" }
        text "Week" { at: wxs + 153, yw; anchor: center; size: 10.5; weight: 700; color: if(wx_view == 2, l.onacc, l.ink); family: "Manrope" }
        text wx_sum { at: wxs + 196, yw; anchor: left center; width: d0.x + cw - 90 - wxs - 196; lines: 1; size: 11; color: l.ink; opacity: 85%; family: "Manrope" }
        text pick(if(wx_detail, 1, 0), "Details ›", "Close ×") { at: d0.x + cw - 12, yw; anchor: right center; size: 11; weight: 700; color: if(wx_hot == 3 or wx_detail, l.acc, l.ink); opacity: 85%; family: "Manrope" }
    }
    // ikona režimu a z nej vytekajúci výber (goo: kapsuly zliate s ikonou)
    body {
        color: l.modes
        rim: 30%
        light: 14%, 0, 30
        glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
        shine: pointer
        opacity: dshow
        ellipse { at: d0.x + 24, d0.y + 24; radius: 19 * if(dsh > 0.5, 1, 0) }
        line { from: d0.x + 24, d0.y + 24; to: d0.x + 24, d0.y + 40 + 40 * 4 * mo; width: 14 * clamp(mo * 3, 0, 1); blend: 10 }
        box { at: d0.x + 100, d0.y + 66 + 0 * 40 * mo; size: 190 * clamp(mo * 1.6 - 0 * 0.12, 0, 1), 34 * clamp(mo * 1.6 - 0 * 0.12, 0, 1); corner: 17; blend: 12 }
        box { at: d0.x + 100, d0.y + 66 + 1 * 40 * mo; size: 190 * clamp(mo * 1.6 - 1 * 0.12, 0, 1), 34 * clamp(mo * 1.6 - 1 * 0.12, 0, 1); corner: 17; blend: 12 }
        box { at: d0.x + 100, d0.y + 66 + 2 * 40 * mo; size: 190 * clamp(mo * 1.6 - 2 * 0.12, 0, 1), 34 * clamp(mo * 1.6 - 2 * 0.12, 0, 1); corner: 17; blend: 12 }
        box { at: d0.x + 100, d0.y + 66 + 3 * 40 * mo; size: 190 * clamp(mo * 1.6 - 3 * 0.12, 0, 1), 34 * clamp(mo * 1.6 - 3 * 0.12, 0, 1); corner: 17; blend: 12 }
        box { at: d0.x + 100, d0.y + 66 + 4 * 40 * mo; size: 190 * clamp(mo * 1.6 - 4 * 0.12, 0, 1), 34 * clamp(mo * 1.6 - 4 * 0.12, 0, 1); corner: 17; blend: 12 }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        repeat k in 0..5 {
            image modes.$k.icon { at: d0.x + 14, d0.y + 14; size: 20, 20; tint: l.onacc; show: smode == k and k > 0 }
        }
        text "Ai" { at: d0.x + 24, d0.y + 24; anchor: center; size: 14; weight: 800; color: l.onacc; show: smode == 0; family: "Fraunces" }
        repeat k in 0..5 {
            box { at: d0.x + 100, d0.y + 66 + k * 40; size: 180, 30; corner: 15; color: l.hov; opacity: if(mode_hot == k, 22%, if(smode == k, 12%, 0)); show: mo > 0.9 }
            image modes.$k.icon { at: d0.x + 22, d0.y + 56 + k * 40; size: 20, 20; tint: l.onacc; opacity: clamp(mo * 2 - 1, 0, 1); show: mo > 0.5 and k > 0 }
            text modes.$k.name { at: d0.x + 52, d0.y + 66 + k * 40; anchor: left center; size: 13; weight: 700; color: l.onacc; opacity: clamp(mo * 2 - 1, 0, 1); show: mo > 0.5; family: "Manrope" }
        }
        text "Ai" { at: d0.x + 32, d0.y + 66; anchor: center; size: 13; weight: 800; color: l.onacc; opacity: clamp(mo * 2 - 1, 0, 1); show: mo > 0.5; family: "Fraunces" }
    }
    // kontextová ponuka (pravý klik v spúšťači): kapsuly zliate do stĺpca pri kurzore
    let cx0 = clamp(ctx.x, 12, W - 252)
    // pri čipoch dole sa ponuka otvára nahor (ctx_up), inak nadol od kurzora
    fact ctx_up = false
    let cy0 = clamp(if(ctx_up, ctx.y - 10 - ctx.count * 34, ctx.y), 12, H - 12 - ctx.count * 34)
    body {
        color: l.menu
        rim: 25%
        shadow: 0, 8, 22, 35%
        opacity: if(ctx_open, 1, 0)
        box { at: cx0 + 120, cy0 + ctx.count * 17; size: 240, ctx.count * 34 + 10; corner: 18 }
    }
    group {
        show: ctx_open
        repeat k in 0..10 {
            box { at: cx0 + 120, cy0 + 17 + k * 34; size: 228, 30; corner: 14; color: l.hov; opacity: if(ctx_hot == k, 12%, 0); show: k < ctx.count }
            text "✓" { at: cx0 + 20, cy0 + 17 + k * 34; anchor: center; size: 12; weight: 800; color: l.acc; show: k < ctx.count and ctx.$k.on == 1; family: "Manrope" }
            text ctx.$k.label { at: cx0 + 36, cy0 + 17 + k * 34; anchor: left center; width: 196; lines: 1; size: 12.5; color: l.ink; opacity: if(ctx.$k.off, 45%, 100%); show: k < ctx.count; family: "Manrope" }
        }
    }
    // spúšťač: klikateľné miesta (navrchu)
    zone box dash_card { at: dt.x, dt.y; size: dw, dh; active: dash }
    zone ellipse mode_btn { at: d0.x + 24, d0.y + 24; radius: 20; cursor: pointer; active: dash }
    repeat k in 0..10 {
        zone box hit_row.$k { at: d0.x + cw / 2, y0 + 17 + k * 34; size: cw, 32; cursor: pointer; active: dash and show_hits and k < hits.count and not mode_open }
    }
    repeat k in 0..18 {
        zone box fav_hit.$k { at: d0.x + (k - 6 * floor(k / 6)) * 96 + 48, y0 + 56 + floor(k / 6) * 106; size: 90, 98; cursor: pointer; active: dash and show_favs and k < favs.count and not mode_open }
    }
    zone ellipse ai_stop { at: d0.x + cw - 24, cy.0 - 50 * aiw + 22; radius: 26; cursor: pointer; active: dash and show_chat and ai_wait }
    zone box chat_zone { at: d0.x + cw / 2, y0 + 182; size: cw, 364; active: dash and show_chat and not mode_open }
    repeat k in 0..8 {
        zone box bub_hit.$k { at: bx.$k + (ch.$k.width + 26) / 2, cy.$k + (ch.$k.height + 22) / 2; size: ch.$k.width + 26, ch.$k.height + 22; active: dash and show_chat and k < chat.count and cy.$k > y0 - 10 and cy.$k < y0 + 350 and not mode_open }
    }
    repeat k in 0..7 {
        zone box chip_hit.$k { at: chx.$k + (cm.$k.width + 28) / 2, yc; size: cm.$k.width + 28, 32; cursor: pointer; active: dash and k < chips.count }
    }
    repeat k in 0..3 {
        zone box wxs_hit.$k { at: wxs + k * 62 + 29, yw; size: 60, 26; cursor: pointer; active: dash }
    }
    zone box wxd_hit { at: d0.x + cw - 40, yw; size: 80, 26; cursor: pointer; active: dash }
    // rozbalený výber režimu: klik mimo neho ho zavrie (pod jeho riadkami)
    zone box mode_away { at: W / 2, H / 2; size: W, H; active: dash and mode_open }
    repeat k in 0..5 {
        zone box mode_row.$k { at: d0.x + 100, d0.y + 66 + k * 40; size: 190, 38; cursor: pointer; active: dash and mode_open }
    }
    // otvorená ponuka: klik mimo nej ju zavrie (pod jej riadkami)
    zone box ctx_away { at: W / 2, H / 2; size: W, H; active: ctx_open }
    repeat k in 0..10 {
        zone box ctx_row.$k { at: cx0 + 120, cy0 + 17 + k * 34; size: 228, 30; cursor: pointer; active: ctx_open and k < ctx.count }
    }

    // >>> kvapky widgetov (widgety.py)
    // Každá kvapka visí z okraja (side 0 dole, 1 hore, 2 vľavo, 3 vpravo; pos 0..1 pozdĺž neho) na hladine s krkom,
    // ku kurzoru sa nakloní a nad ňou sa nafúkne (živý tvor). Chytiť a pustiť pri inom okraji = prilepí sa tam;
    // pustiť ďaleko od okrajov = steká preč (odstráni sa, späť cez spúšťač). Kliky podľa Noctalie (logika).
    model wdg max 12 { icon: image 22, 22; val: text; hasval: bool; mono: bool; side: number; pos: number; right: bool; wheel: bool; on: bool }
    fact wdrag = -1
    fact wmoved = false
    fact wd.x = 0
    fact wd.y = 0
    fact wd.w = 1920
    fact wd.h = 1080
    event w_click ->
    event w_right ->
    event w_wheel ->
    event w_drop ->
    spring splashy = 420, 13
    let wa.x.0 = pick(wdg.0.side, W * wdg.0.pos, W * wdg.0.pos, 0, W)
    let wa.y.0 = pick(wdg.0.side, H, 0, H * wdg.0.pos, H * wdg.0.pos)
    let wn.x.0 = pick(wdg.0.side, 0, 0, 1, -1)
    let wn.y.0 = pick(wdg.0.side, -1, 1, 0, 0)
    let wnear.0 = 1 - smooth(0, 170, length(mx - wa.x.0, my - wa.y.0))
    let wout.0 = 24 + 9 * wnear.0 + 2.5 * noise(time * 0.3 + 0.0)
    let wt.x.0 = wa.x.0 + wn.x.0 * wout.0 + clamp(mx - wa.x.0, -18, 18) * 0.28 * wnear.0 * (1 - abs(wn.x.0))
    let wt.y.0 = wa.y.0 + wn.y.0 * wout.0 + clamp(my - wa.y.0, -18, 18) * 0.28 * wnear.0 * (1 - abs(wn.y.0))
    prop wp.x.0 = 0 ~lively
    prop wp.y.0 = 0 ~lively
    follow wp.x.0 = if(wdrag == 0 and wmoved, pointer.x, wt.x.0)
    follow wp.y.0 = if(wdrag == 0 and wmoved, pointer.y, wt.y.0)
    prop wb.0 = 0 ~lively
    follow wb.0 = if(0 < wdg.count, 1, 0)
    prop wh.0 = 0 ~lively
    prop wwob.0 = 0 ~splashy
    let wr.0 = (21 + 3 * wh.0) * wb.0
    let wjit.0 = 0.05 * sin(time * 9 + 0) * wh.0 + wwob.0 * 0.01
    let wsheet.0 = wb.0 * if(wdrag == 0 and wmoved, 0, 1)
    let wa.x.1 = pick(wdg.1.side, W * wdg.1.pos, W * wdg.1.pos, 0, W)
    let wa.y.1 = pick(wdg.1.side, H, 0, H * wdg.1.pos, H * wdg.1.pos)
    let wn.x.1 = pick(wdg.1.side, 0, 0, 1, -1)
    let wn.y.1 = pick(wdg.1.side, -1, 1, 0, 0)
    let wnear.1 = 1 - smooth(0, 170, length(mx - wa.x.1, my - wa.y.1))
    let wout.1 = 24 + 9 * wnear.1 + 2.5 * noise(time * 0.3 + 1.7)
    let wt.x.1 = wa.x.1 + wn.x.1 * wout.1 + clamp(mx - wa.x.1, -18, 18) * 0.28 * wnear.1 * (1 - abs(wn.x.1))
    let wt.y.1 = wa.y.1 + wn.y.1 * wout.1 + clamp(my - wa.y.1, -18, 18) * 0.28 * wnear.1 * (1 - abs(wn.y.1))
    prop wp.x.1 = 0 ~lively
    prop wp.y.1 = 0 ~lively
    follow wp.x.1 = if(wdrag == 1 and wmoved, pointer.x, wt.x.1)
    follow wp.y.1 = if(wdrag == 1 and wmoved, pointer.y, wt.y.1)
    prop wb.1 = 0 ~lively
    follow wb.1 = if(1 < wdg.count, 1, 0)
    prop wh.1 = 0 ~lively
    prop wwob.1 = 0 ~splashy
    let wr.1 = (21 + 3 * wh.1) * wb.1
    let wjit.1 = 0.05 * sin(time * 9 + 1) * wh.1 + wwob.1 * 0.01
    let wsheet.1 = wb.1 * if(wdrag == 1 and wmoved, 0, 1)
    let wa.x.2 = pick(wdg.2.side, W * wdg.2.pos, W * wdg.2.pos, 0, W)
    let wa.y.2 = pick(wdg.2.side, H, 0, H * wdg.2.pos, H * wdg.2.pos)
    let wn.x.2 = pick(wdg.2.side, 0, 0, 1, -1)
    let wn.y.2 = pick(wdg.2.side, -1, 1, 0, 0)
    let wnear.2 = 1 - smooth(0, 170, length(mx - wa.x.2, my - wa.y.2))
    let wout.2 = 24 + 9 * wnear.2 + 2.5 * noise(time * 0.3 + 3.4)
    let wt.x.2 = wa.x.2 + wn.x.2 * wout.2 + clamp(mx - wa.x.2, -18, 18) * 0.28 * wnear.2 * (1 - abs(wn.x.2))
    let wt.y.2 = wa.y.2 + wn.y.2 * wout.2 + clamp(my - wa.y.2, -18, 18) * 0.28 * wnear.2 * (1 - abs(wn.y.2))
    prop wp.x.2 = 0 ~lively
    prop wp.y.2 = 0 ~lively
    follow wp.x.2 = if(wdrag == 2 and wmoved, pointer.x, wt.x.2)
    follow wp.y.2 = if(wdrag == 2 and wmoved, pointer.y, wt.y.2)
    prop wb.2 = 0 ~lively
    follow wb.2 = if(2 < wdg.count, 1, 0)
    prop wh.2 = 0 ~lively
    prop wwob.2 = 0 ~splashy
    let wr.2 = (21 + 3 * wh.2) * wb.2
    let wjit.2 = 0.05 * sin(time * 9 + 2) * wh.2 + wwob.2 * 0.01
    let wsheet.2 = wb.2 * if(wdrag == 2 and wmoved, 0, 1)
    let wa.x.3 = pick(wdg.3.side, W * wdg.3.pos, W * wdg.3.pos, 0, W)
    let wa.y.3 = pick(wdg.3.side, H, 0, H * wdg.3.pos, H * wdg.3.pos)
    let wn.x.3 = pick(wdg.3.side, 0, 0, 1, -1)
    let wn.y.3 = pick(wdg.3.side, -1, 1, 0, 0)
    let wnear.3 = 1 - smooth(0, 170, length(mx - wa.x.3, my - wa.y.3))
    let wout.3 = 24 + 9 * wnear.3 + 2.5 * noise(time * 0.3 + 5.1)
    let wt.x.3 = wa.x.3 + wn.x.3 * wout.3 + clamp(mx - wa.x.3, -18, 18) * 0.28 * wnear.3 * (1 - abs(wn.x.3))
    let wt.y.3 = wa.y.3 + wn.y.3 * wout.3 + clamp(my - wa.y.3, -18, 18) * 0.28 * wnear.3 * (1 - abs(wn.y.3))
    prop wp.x.3 = 0 ~lively
    prop wp.y.3 = 0 ~lively
    follow wp.x.3 = if(wdrag == 3 and wmoved, pointer.x, wt.x.3)
    follow wp.y.3 = if(wdrag == 3 and wmoved, pointer.y, wt.y.3)
    prop wb.3 = 0 ~lively
    follow wb.3 = if(3 < wdg.count, 1, 0)
    prop wh.3 = 0 ~lively
    prop wwob.3 = 0 ~splashy
    let wr.3 = (21 + 3 * wh.3) * wb.3
    let wjit.3 = 0.05 * sin(time * 9 + 3) * wh.3 + wwob.3 * 0.01
    let wsheet.3 = wb.3 * if(wdrag == 3 and wmoved, 0, 1)
    let wa.x.4 = pick(wdg.4.side, W * wdg.4.pos, W * wdg.4.pos, 0, W)
    let wa.y.4 = pick(wdg.4.side, H, 0, H * wdg.4.pos, H * wdg.4.pos)
    let wn.x.4 = pick(wdg.4.side, 0, 0, 1, -1)
    let wn.y.4 = pick(wdg.4.side, -1, 1, 0, 0)
    let wnear.4 = 1 - smooth(0, 170, length(mx - wa.x.4, my - wa.y.4))
    let wout.4 = 24 + 9 * wnear.4 + 2.5 * noise(time * 0.3 + 6.8)
    let wt.x.4 = wa.x.4 + wn.x.4 * wout.4 + clamp(mx - wa.x.4, -18, 18) * 0.28 * wnear.4 * (1 - abs(wn.x.4))
    let wt.y.4 = wa.y.4 + wn.y.4 * wout.4 + clamp(my - wa.y.4, -18, 18) * 0.28 * wnear.4 * (1 - abs(wn.y.4))
    prop wp.x.4 = 0 ~lively
    prop wp.y.4 = 0 ~lively
    follow wp.x.4 = if(wdrag == 4 and wmoved, pointer.x, wt.x.4)
    follow wp.y.4 = if(wdrag == 4 and wmoved, pointer.y, wt.y.4)
    prop wb.4 = 0 ~lively
    follow wb.4 = if(4 < wdg.count, 1, 0)
    prop wh.4 = 0 ~lively
    prop wwob.4 = 0 ~splashy
    let wr.4 = (21 + 3 * wh.4) * wb.4
    let wjit.4 = 0.05 * sin(time * 9 + 4) * wh.4 + wwob.4 * 0.01
    let wsheet.4 = wb.4 * if(wdrag == 4 and wmoved, 0, 1)
    let wa.x.5 = pick(wdg.5.side, W * wdg.5.pos, W * wdg.5.pos, 0, W)
    let wa.y.5 = pick(wdg.5.side, H, 0, H * wdg.5.pos, H * wdg.5.pos)
    let wn.x.5 = pick(wdg.5.side, 0, 0, 1, -1)
    let wn.y.5 = pick(wdg.5.side, -1, 1, 0, 0)
    let wnear.5 = 1 - smooth(0, 170, length(mx - wa.x.5, my - wa.y.5))
    let wout.5 = 24 + 9 * wnear.5 + 2.5 * noise(time * 0.3 + 8.5)
    let wt.x.5 = wa.x.5 + wn.x.5 * wout.5 + clamp(mx - wa.x.5, -18, 18) * 0.28 * wnear.5 * (1 - abs(wn.x.5))
    let wt.y.5 = wa.y.5 + wn.y.5 * wout.5 + clamp(my - wa.y.5, -18, 18) * 0.28 * wnear.5 * (1 - abs(wn.y.5))
    prop wp.x.5 = 0 ~lively
    prop wp.y.5 = 0 ~lively
    follow wp.x.5 = if(wdrag == 5 and wmoved, pointer.x, wt.x.5)
    follow wp.y.5 = if(wdrag == 5 and wmoved, pointer.y, wt.y.5)
    prop wb.5 = 0 ~lively
    follow wb.5 = if(5 < wdg.count, 1, 0)
    prop wh.5 = 0 ~lively
    prop wwob.5 = 0 ~splashy
    let wr.5 = (21 + 3 * wh.5) * wb.5
    let wjit.5 = 0.05 * sin(time * 9 + 5) * wh.5 + wwob.5 * 0.01
    let wsheet.5 = wb.5 * if(wdrag == 5 and wmoved, 0, 1)
    let wa.x.6 = pick(wdg.6.side, W * wdg.6.pos, W * wdg.6.pos, 0, W)
    let wa.y.6 = pick(wdg.6.side, H, 0, H * wdg.6.pos, H * wdg.6.pos)
    let wn.x.6 = pick(wdg.6.side, 0, 0, 1, -1)
    let wn.y.6 = pick(wdg.6.side, -1, 1, 0, 0)
    let wnear.6 = 1 - smooth(0, 170, length(mx - wa.x.6, my - wa.y.6))
    let wout.6 = 24 + 9 * wnear.6 + 2.5 * noise(time * 0.3 + 10.2)
    let wt.x.6 = wa.x.6 + wn.x.6 * wout.6 + clamp(mx - wa.x.6, -18, 18) * 0.28 * wnear.6 * (1 - abs(wn.x.6))
    let wt.y.6 = wa.y.6 + wn.y.6 * wout.6 + clamp(my - wa.y.6, -18, 18) * 0.28 * wnear.6 * (1 - abs(wn.y.6))
    prop wp.x.6 = 0 ~lively
    prop wp.y.6 = 0 ~lively
    follow wp.x.6 = if(wdrag == 6 and wmoved, pointer.x, wt.x.6)
    follow wp.y.6 = if(wdrag == 6 and wmoved, pointer.y, wt.y.6)
    prop wb.6 = 0 ~lively
    follow wb.6 = if(6 < wdg.count, 1, 0)
    prop wh.6 = 0 ~lively
    prop wwob.6 = 0 ~splashy
    let wr.6 = (21 + 3 * wh.6) * wb.6
    let wjit.6 = 0.05 * sin(time * 9 + 6) * wh.6 + wwob.6 * 0.01
    let wsheet.6 = wb.6 * if(wdrag == 6 and wmoved, 0, 1)
    let wa.x.7 = pick(wdg.7.side, W * wdg.7.pos, W * wdg.7.pos, 0, W)
    let wa.y.7 = pick(wdg.7.side, H, 0, H * wdg.7.pos, H * wdg.7.pos)
    let wn.x.7 = pick(wdg.7.side, 0, 0, 1, -1)
    let wn.y.7 = pick(wdg.7.side, -1, 1, 0, 0)
    let wnear.7 = 1 - smooth(0, 170, length(mx - wa.x.7, my - wa.y.7))
    let wout.7 = 24 + 9 * wnear.7 + 2.5 * noise(time * 0.3 + 11.9)
    let wt.x.7 = wa.x.7 + wn.x.7 * wout.7 + clamp(mx - wa.x.7, -18, 18) * 0.28 * wnear.7 * (1 - abs(wn.x.7))
    let wt.y.7 = wa.y.7 + wn.y.7 * wout.7 + clamp(my - wa.y.7, -18, 18) * 0.28 * wnear.7 * (1 - abs(wn.y.7))
    prop wp.x.7 = 0 ~lively
    prop wp.y.7 = 0 ~lively
    follow wp.x.7 = if(wdrag == 7 and wmoved, pointer.x, wt.x.7)
    follow wp.y.7 = if(wdrag == 7 and wmoved, pointer.y, wt.y.7)
    prop wb.7 = 0 ~lively
    follow wb.7 = if(7 < wdg.count, 1, 0)
    prop wh.7 = 0 ~lively
    prop wwob.7 = 0 ~splashy
    let wr.7 = (21 + 3 * wh.7) * wb.7
    let wjit.7 = 0.05 * sin(time * 9 + 7) * wh.7 + wwob.7 * 0.01
    let wsheet.7 = wb.7 * if(wdrag == 7 and wmoved, 0, 1)
    let wa.x.8 = pick(wdg.8.side, W * wdg.8.pos, W * wdg.8.pos, 0, W)
    let wa.y.8 = pick(wdg.8.side, H, 0, H * wdg.8.pos, H * wdg.8.pos)
    let wn.x.8 = pick(wdg.8.side, 0, 0, 1, -1)
    let wn.y.8 = pick(wdg.8.side, -1, 1, 0, 0)
    let wnear.8 = 1 - smooth(0, 170, length(mx - wa.x.8, my - wa.y.8))
    let wout.8 = 24 + 9 * wnear.8 + 2.5 * noise(time * 0.3 + 13.6)
    let wt.x.8 = wa.x.8 + wn.x.8 * wout.8 + clamp(mx - wa.x.8, -18, 18) * 0.28 * wnear.8 * (1 - abs(wn.x.8))
    let wt.y.8 = wa.y.8 + wn.y.8 * wout.8 + clamp(my - wa.y.8, -18, 18) * 0.28 * wnear.8 * (1 - abs(wn.y.8))
    prop wp.x.8 = 0 ~lively
    prop wp.y.8 = 0 ~lively
    follow wp.x.8 = if(wdrag == 8 and wmoved, pointer.x, wt.x.8)
    follow wp.y.8 = if(wdrag == 8 and wmoved, pointer.y, wt.y.8)
    prop wb.8 = 0 ~lively
    follow wb.8 = if(8 < wdg.count, 1, 0)
