    // <<< kvapky widgetov
    // >>> DaNoGoo zóny (danogoo.py)
    // hrozno: klik mimo neho ho zavrie (pod bobuľami)
    zone box dn_away { at: W / 2, H / 2; size: W, H; active: dn_open }
    zone ellipse dn_hit { at: dn.x, dn.y; radius: 34; cursor: pointer; active: solo }
    zone box br_hit.0 { at: brx.0, bry.0; size: 360, 52; cursor: pointer; active: dn_open and 0 < berries.count and bre.0 > 0.9 }
    zone box br_hit.1 { at: brx.1, bry.1; size: 360, 52; cursor: pointer; active: dn_open and 1 < berries.count and bre.1 > 0.9 }
    zone box br_hit.2 { at: brx.2, bry.2; size: 360, 52; cursor: pointer; active: dn_open and 2 < berries.count and bre.2 > 0.9 }
    zone box br_hit.3 { at: brx.3, bry.3; size: 360, 52; cursor: pointer; active: dn_open and 3 < berries.count and bre.3 > 0.9 }
    zone box br_hit.4 { at: brx.4, bry.4; size: 360, 52; cursor: pointer; active: dn_open and 4 < berries.count and bre.4 > 0.9 }
    zone box br_hit.5 { at: brx.5, bry.5; size: 360, 52; cursor: pointer; active: dn_open and 5 < berries.count and bre.5 > 0.9 }
    zone box dn_clr { at: clx, cly; size: 190, 34; cursor: pointer; active: dn_open and berries.count > 0 and cle > 0.9 }
    // DaNoGoo: ľavý klik = hrozno (znova klik, Esc alebo klik mimo = späť), ťahanie = iný okraj, pravý = kalendár
    on press dn_hit { dn_drag = true; dn_moved = false; wd.w = W; wd.h = H; dnp.x = pointer.x; dnp.y = pointer.y; dnq.x = 0; dnq.y = 0 }
    on drag dn_hit while dn_drag { dnq.x = drag.dx; dnq.y = drag.dy }
    on drag dn_hit while dn_drag and abs(drag.dx) + abs(drag.dy) > 6 { dn_moved = true; dn_open = false; dc_open = false }
    on release dn_hit while dn_drag and dn_moved { dnd.x = pointer.x; dnd.y = pointer.y; impulse dn.wob 300; emit dn_drop; dn_moved = false; dn_drag = false }
    on release dn_hit while dn_drag and not dn_moved { dn_drag = false; toggle dn_open; dc_open = false; impulse dn.wob 160; dash = false; pmenu = false }
    on press right dn_hit { impulse dn.wob 120; dn_open = false; toggle dc_open; dash = false; pmenu = false; emit dn_cal }
    on enter dn_hit { dn.h: 1 }
    on leave dn_hit { dn.h: 0 }
    on press dn_away { dn_open = false }
    on press right dn_away { dn_open = false }
    on key Escape while dn_open { dn_open = false }
    on change dn_open while dn_open { toast.p: 0 }
    on press dn_clr { dn_open = false; emit dn_clear_all }
    // bobule: ľavý klik = otvoriť, pravý = akcie upozornenia (iba ak nejaké má), odhodenie nabok = zahodiť
    on press br_hit.0 { brk = 0; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.0 while brk == 0 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.0 while brk == 0 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.0 while brk == 0 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(0) }
    on release br_hit.0 while brk == 0 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.0 while brk == 0 and not brmoved { brk = -1; emit berry_open(0) }
    on press right br_hit.0 while berries.0.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(0) }
    on enter br_hit.0 { berry_hot = 0 }
    on leave br_hit.0 { berry_hot = -1 }
    on press br_hit.1 { brk = 1; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.1 while brk == 1 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.1 while brk == 1 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.1 while brk == 1 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(1) }
    on release br_hit.1 while brk == 1 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.1 while brk == 1 and not brmoved { brk = -1; emit berry_open(1) }
    on press right br_hit.1 while berries.1.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(1) }
    on enter br_hit.1 { berry_hot = 1 }
    on leave br_hit.1 { berry_hot = -1 }
    on press br_hit.2 { brk = 2; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.2 while brk == 2 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.2 while brk == 2 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.2 while brk == 2 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(2) }
    on release br_hit.2 while brk == 2 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.2 while brk == 2 and not brmoved { brk = -1; emit berry_open(2) }
    on press right br_hit.2 while berries.2.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(2) }
    on enter br_hit.2 { berry_hot = 2 }
    on leave br_hit.2 { berry_hot = -1 }
    on press br_hit.3 { brk = 3; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.3 while brk == 3 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.3 while brk == 3 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.3 while brk == 3 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(3) }
    on release br_hit.3 while brk == 3 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.3 while brk == 3 and not brmoved { brk = -1; emit berry_open(3) }
    on press right br_hit.3 while berries.3.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(3) }
    on enter br_hit.3 { berry_hot = 3 }
    on leave br_hit.3 { berry_hot = -1 }
    on press br_hit.4 { brk = 4; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.4 while brk == 4 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.4 while brk == 4 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.4 while brk == 4 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(4) }
    on release br_hit.4 while brk == 4 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.4 while brk == 4 and not brmoved { brk = -1; emit berry_open(4) }
    on press right br_hit.4 while berries.4.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(4) }
    on enter br_hit.4 { berry_hot = 4 }
    on leave br_hit.4 { berry_hot = -1 }
    on press br_hit.5 { brk = 5; brmoved = false; br.dx = 0; br.dy = 0 }
    on drag br_hit.5 while brk == 5 { br.dx = drag.dx; br.dy = drag.dy * 0.2 }
    on drag br_hit.5 while brk == 5 and abs(drag.dx) > 10 { brmoved = true }
    on release br_hit.5 while brk == 5 and brmoved and abs(br.dx) > 140 { brk = -1; brmoved = false; br.dx = 0; br.dy = 0; emit berry_dismiss(5) }
    on release br_hit.5 while brk == 5 and brmoved { brk = -1; brmoved = false; br.dx = 0; br.dy = 0 }
    on release br_hit.5 while brk == 5 and not brmoved { brk = -1; emit berry_open(5) }
    on press right br_hit.5 while berries.5.acts { ctx_up = false; ctx.x = mx; ctx.y = my; emit berry_menu(5) }
    on enter br_hit.5 { berry_hot = 5 }
    on leave br_hit.5 { berry_hot = -1 }
    // karta DaNoGoo: vyrastie z kvapky smerom od okraja, vzhľad ako spúšťač (farby témy → káva pri kvapke)
    prop dcg = 0 ~dnspring
    follow dcg = if(dc_open, 1, 0)
    // okno sa ku kvapke pripája ROHOM (1. 10.): kvapka vystúpi a okno z nej vyrastie tak, aby bolo celé vidieť —
    // pozdĺž okraja tam, kde je miesto (pri dolnom a hornom okraji vpravo, inak vľavo; pri bočnom dole, inak hore).
    // Kvapky sa dajú presúvať, preto prichádzajú do úvahy všetky štyri rohy okna.
    let kc.sx = if(dn.vert > 0.5, 0, if(dn.x + 600 + 12 <= W, 1, -1))
    let kc.sy = if(dn.vert > 0.5, if(dn.y + 560 + 12 <= H, 1, -1), 0)
    let kc.tx = if(dn.vert > 0.5, dn.x + dn.nx * (600 / 2 - 10), dn.x + kc.sx * (600 / 2 - 10))
    let kc.ty = if(dn.vert > 0.5, dn.y + kc.sy * (560 / 2 - 10), dn.y + dn.ny * (560 / 2 - 10))
    let kc.x = dn.x + (kc.tx - dn.x) * clamp(dcg, 0, 1.05)
    let kc.y = dn.y + (kc.ty - dn.y) * clamp(dcg, 0, 1.05)
    let kc.gx = dn.nx * 600 / 2 * dn.vert
    let kc.gy = dn.ny * 560 / 2 * (1 - dn.vert)
    let dcs = clamp(dcg * 2 - 1, 0, 1)
    let c0.x = kc.tx - 600 / 2 + 24
    let c0.y = kc.ty - 560 / 2 + 20
    body {
        gradient: kc.x + kc.gx, kc.y + kc.gy to kc.x - kc.gx, kc.y - kc.gy, l.win, l.win, l.win, mix(l.win, coffee, 0.35), coffee
        glass: 100% * l.glass
        lens: l.pearl > 0.5
        shine: pointer
        refraction: 120% * l.pearl
        dispersion: 260% * l.pearl
        light: 6%, kc.y - 560 / 2, 60
        rim: 18%
        shadow: 0, 12, 34, 38% * dcg
        opacity: if(dcg > 0.01, 1, 0) * so
        box { at: kc.x, kc.y; size: (60 + 540 * dcg), (60 + 500 * dcg); corner: 30 - 6 * dcg }
        // kvapka DaNoGoo trčí z rohu karty ako ucho (zliata s ňou)
        ellipse { at: dn.x, dn.y; radius: dn.r * clamp(dcg * 4, 0, 1); blend: 18 * dcg }
    }
    group {
        opacity: dcs
        show: dcg > 0.5 and solo
        // hlavička: mesiac, šípky, Dnes
        text dc_month { at: c0.x + 2, c0.y + 18; anchor: left center; size: 20; weight: 600; color: l.fg; family: "Inter" }
        ellipse { at: c0.x + 552 - 124, c0.y + 18; radius: 15; color: if(dc_hot == 100, l.hover, l.var) }
        text "" { at: c0.x + 552 - 124, c0.y + 19; anchor: center; size: 15; color: l.fg; family: "noctalia-tabler-icons" }
        ellipse { at: c0.x + 552 - 88, c0.y + 18; radius: 15; color: if(dc_hot == 101, l.hover, l.var) }
        text "" { at: c0.x + 552 - 88, c0.y + 19; anchor: center; size: 15; color: l.fg; family: "noctalia-tabler-icons" }
        box { at: c0.x + 552 - 30, c0.y + 18; size: 58, 30; corner: 15; color: if(dc_hot == 102, l.hover, l.var) }
        text "Today" { at: c0.x + 552 - 30, c0.y + 18; anchor: center; size: 12; weight: 500; color: l.fg; family: "Inter" }
        text "Mo" { at: c0.x + 0 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "Tu" { at: c0.x + 1 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "We" { at: c0.x + 2 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "Th" { at: c0.x + 3 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "Fr" { at: c0.x + 4 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "Sa" { at: c0.x + 5 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        text "Su" { at: c0.x + 6 * 42 + 21, c0.y + 56; anchor: center; size: 11; weight: 600; color: l.dim; family: "Inter" }
        repeat k in 0..42 {
            ellipse { at: c0.x + (k - 7 * floor(k / 7)) * 42 + 21, c0.y + 84 + floor(k / 7) * 38; radius: 16; color: if(days.$k.today, l.acc, l.hover); opacity: if(days.$k.today, 100%, if(days.$k.sel or dc_hot == k, 100%, 0)); show: k < days.count }
            text days.$k.d { at: c0.x + (k - 7 * floor(k / 7)) * 42 + 21, c0.y + 83 + floor(k / 7) * 38; anchor: center; size: 13; weight: 500; color: if(days.$k.today, l.onacc, if(days.$k.inm, l.fg, l.dim)); opacity: if(days.$k.inm, 100%, 45%); show: k < days.count; family: "Inter" }
            ellipse { at: c0.x + (k - 7 * floor(k / 7)) * 42 + 21, c0.y + 96 + floor(k / 7) * 38; radius: 2.2; color: if(days.$k.today, l.onacc, l.acc); show: k < days.count and days.$k.dot }
        }
        // vybraný deň: udalosti a úlohy, nová udalosť
        box { at: c0.x + 435, c0.y + 170; size: 234, 300; corner: 14; color: l.var; opacity: 45% }
        text dc_seltitle { at: c0.x + 332, c0.y + 40; anchor: left center; width: 206; lines: 1; size: 13.5; weight: 600; color: l.fg; family: "Inter" }
        repeat k in 0..5 {
            text evs.$k.hm { at: c0.x + 332, c0.y + 66 + k * 28; anchor: left center; size: 11.5; weight: 600; color: l.acc; show: k < evs.count; family: "Inter" }
            text evs.$k.title { at: c0.x + 400, c0.y + 66 + k * 28; anchor: left center; width: 138; lines: 1; size: 12.5; color: l.fg; show: k < evs.count; family: "Inter" }
        }
        text "No events" { at: c0.x + 332, c0.y + 66; anchor: left center; size: 12.5; color: l.dim; show: evs.count < 1; family: "Inter" }
        text "Tasks" { at: c0.x + 332, c0.y + 212; anchor: left center; size: 12; weight: 600; color: l.dim; family: "Inter" }
        repeat k in 0..5 {
            text pick(if(tds.$k.done, 1, 0), "", "") { at: c0.x + 332, c0.y + 238 + k * 26; anchor: left center; size: 15; color: if(tds.$k.done, l.dim, l.acc); show: k < tds.count; family: "noctalia-tabler-icons" }
            text tds.$k.title { at: c0.x + 356, c0.y + 238 + k * 26; anchor: left center; width: 184; lines: 1; size: 12.5; color: if(tds.$k.done, l.dim, l.fg); show: k < tds.count; family: "Inter" }
        }
        text "No tasks" { at: c0.x + 332, c0.y + 238; anchor: left center; size: 12.5; color: l.dim; show: tds.count < 1; family: "Inter" }
        box { at: c0.x + 435, c0.y + 298; size: 234, 36; corner: 12; color: l.acc; opacity: 75% }
        box { at: c0.x + 435, c0.y + 298; size: 231, 33; corner: 10.5; color: l.var }
        text dc_hint { at: c0.x + 330, c0.y + 298; anchor: left center; width: 210; lines: 1; size: 12.5; color: l.dim; show: dc_empty; family: "Inter" }
        input dc_new { at: c0.x + 330, c0.y + 298; width: 210; size: 12.5; color: l.fg; selection: l.hover; family: "Inter" }
        // počasie (presunuté z TimeGoo, 1. 10.): miesto, Dnes / Zajtra / Týždeň, súhrn, predpoveď
        text "" { at: c0.x + 2, c0.y + 350; anchor: left center; size: 14; color: l.dim; family: "noctalia-tabler-icons" }
        text wx_place { at: c0.x + 22, c0.y + 350; anchor: left center; width: 150; lines: 1; size: 13; weight: 600; color: l.fg; family: "Inter" }
        repeat k in 0..3 {
            box { at: c0.x + 214 + k * 64, c0.y + 350; size: 60, 26; corner: 13; color: if(wx_view == k, l.acc, l.hover); opacity: if(wx_view == k, 100%, if(wx_hot == k, 100%, 0)) }
        }
        text "Today" { at: c0.x + 214, c0.y + 350; anchor: center; size: 12; weight: 500; color: if(wx_view == 0, l.onacc, l.dim); family: "Inter" }
        text "Tomorrow" { at: c0.x + 278, c0.y + 350; anchor: center; size: 12; weight: 500; color: if(wx_view == 1, l.onacc, l.dim); family: "Inter" }
        text "Week" { at: c0.x + 342, c0.y + 350; anchor: center; size: 12; weight: 500; color: if(wx_view == 2, l.onacc, l.dim); family: "Inter" }
        text wx_icon { at: c0.x + 392, c0.y + 350; anchor: left center; size: 15; color: l.fg; family: "noctalia-tabler-icons" }
        text wx_sum { at: c0.x + 414, c0.y + 350; anchor: left center; width: 138; lines: 1; size: 12; color: l.fg; family: "Inter" }
        repeat k in 0..8 {
            box { at: c0.x + k * 69 + 34, c0.y + 440; size: 62, 124; corner: 14; color: l.var; opacity: 60%; show: k < wx.count }
            text wx.$k.label { at: c0.x + k * 69 + 34, c0.y + 398; anchor: center; size: 11.5; color: l.dim; show: k < wx.count; family: "Inter" }
            text wx.$k.glyph { at: c0.x + k * 69 + 34, c0.y + 438; anchor: center; size: 24; color: l.fg; show: k < wx.count; family: "noctalia-tabler-icons" }
            text wx.$k.temp { at: c0.x + k * 69 + 34, c0.y + 480; anchor: center; size: 12; weight: 600; color: l.fg; show: k < wx.count; family: "Inter" }
        }
    }
    // karta: klik mimo zavrie (pod ňou), karta sama kliky pohltí
    zone box dc_away { at: W / 2, H / 2; size: W, H; active: dc_open }
    zone box dc_card { at: kc.tx, kc.ty; size: 600, 560; active: dc_open }
    zone ellipse dc_prev { at: c0.x + 552 - 124, c0.y + 18; radius: 16; cursor: pointer; active: dc_open }
    zone ellipse dc_next { at: c0.x + 552 - 88, c0.y + 18; radius: 16; cursor: pointer; active: dc_open }
    zone box dc_today { at: c0.x + 552 - 30, c0.y + 18; size: 58, 30; cursor: pointer; active: dc_open }
    repeat k in 0..42 {
        zone ellipse dc_d.$k { at: c0.x + (k - 7 * floor(k / 7)) * 42 + 21, c0.y + 84 + floor(k / 7) * 38; radius: 18; cursor: pointer; active: dc_open and k < days.count }
    }
    repeat k in 0..5 {
        zone box dc_ev.$k { at: c0.x + 435, c0.y + 66 + k * 28; size: 220, 26; active: dc_open and k < evs.count }
        zone box dc_td.$k { at: c0.x + 435, c0.y + 238 + k * 26; size: 220, 24; cursor: pointer; active: dc_open and k < tds.count }
    }
    repeat k in 0..3 {
        zone box wxs_hit.$k { at: c0.x + 214 + k * 64, c0.y + 350; size: 62, 28; cursor: pointer; active: dc_open }
    }
    zone box wxd_hit { at: 0, 0; size: 1, 1; active: false }
    on press dc_away { dc_open = false }
    on press right dc_away { dc_open = false }
    on key Escape while dc_open { dc_open = false }
    on change dc_open while dc_open { focus dc_new }
    on submit dc_new { emit dc_add }
    on press dc_prev { emit dc_nav(-1) }
    on press dc_next { emit dc_nav(1) }
    on press dc_today { emit dc_nav(0) }
    on scroll dc_card { emit dc_nav(if(wheel > 0, -1, 1)) }
    on enter dc_prev { dc_hot = 100 }
    on leave dc_prev { dc_hot = -1 }
    on enter dc_next { dc_hot = 101 }
    on leave dc_next { dc_hot = -1 }
    on enter dc_today { dc_hot = 102 }
    on leave dc_today { dc_hot = -1 }
    repeat k in 0..42 {
        on press dc_d.$k { emit dc_day(k) }
        on enter dc_d.$k { dc_hot = k }
        on leave dc_d.$k { dc_hot = -1 }
    }
    repeat k in 0..5 {
        on press dc_td.$k { emit dc_todo(k) }
        on press right dc_ev.$k { ctx_up = false; ctx.x = mx; ctx.y = my; emit dc_ev_menu(k) }
    }
    // <<< DaNoGoo zóny
    // >>> QueenGoo zóny (queengoo.py)
    zone ellipse qg_hit { at: qg.x, qg.y; radius: 34; cursor: pointer; active: solo }
    on press qg_hit { qg_drag = true; qg_moved = false; wd.w = W; wd.h = H; qgp.x = pointer.x; qgp.y = pointer.y; qgq.x = 0; qgq.y = 0 }
    on drag qg_hit while qg_drag { qgq.x = drag.dx; qgq.y = drag.dy }
    on press right qg_hit { impulse qg.wob 140; emit qg_open(1) }
    on drag qg_hit while qg_drag and abs(drag.dx) + abs(drag.dy) > 6 { qg_moved = true }
    on release qg_hit while qg_drag and qg_moved { qgd.x = pointer.x; qgd.y = pointer.y; impulse qg.wob 300; emit qg_drop; qg_moved = false; qg_drag = false }
    on release qg_hit while qg_drag and not qg_moved { qg_drag = false; impulse qg.wob 160; emit qg_open(0) }
    on enter qg_hit { qg.h: 1 }
    on leave qg_hit { qg.h: 0 }
    // <<< QueenGoo zóny

    // >>> PowerGoo (powergoo.py)
    // ── PowerGoo: ponuka ako okno Goo, pripojené rohom ku kvapke vypínača (1. 10.) ──
    fact bat_present = false
    fact bat_pct = 100
    fact bat_chg = false
    let pxs = pick(side, px, W - px, edge - p.y, W - edge + p.y)
    let pys = pick(side, p.y + H - edge, edge - p.y, px, H - px)
    let pw = 250
    let ph = 292 + 28 + if(bat_present, 44, 0)
    // ucho: kvapka vypínača vystúpi kolmo od okraja; okno rastie od nej tam, kde je miesto (ktorýkoľvek zo 4 rohov)
    let pk.x = if(vert, pxs + away.x * 58, pxs)
    let pk.y = if(vert, pys, pys + away.y * 58)
    let p.sx = if(vert, 0, if(pk.x + pw + 12 <= W, 1, -1))
    let p.sy = if(vert, if(pk.y + ph + 12 <= H, 1, -1), 0)
    let pt.x = if(vert, pk.x + away.x * (pw / 2 - 12), pk.x + p.sx * (pw / 2 - 12))
    let pt.y = if(vert, pk.y + p.sy * (ph / 2 - 12), pk.y + away.y * (ph / 2 - 12))
    let p.swim = smooth(0, 0.45, pm)
    let p.grow = smooth(0.3, 1, pm)
    let pb.x = pxs + (pk.x - pxs) * p.swim
    let pb.y = pys + (pk.y - pys) * p.swim
    let pc.x = pk.x + (pt.x - pk.x) * p.grow
    let pc.y = pk.y + (pt.y - pk.y) * p.grow
    let p0.x = pt.x - pw / 2 + 12
    let p0.y = pt.y - ph / 2 + 14 + if(bat_present, 44, 0)
    let p.gx = away.x * pw / 2 * vert
    let p.gy = away.y * ph / 2 * (1 - vert)
    body {
        gradient: pc.x + p.gx, pc.y + p.gy to pc.x - p.gx, pc.y - p.gy, l.win, l.win, mix(l.win, coffee, 0.4), coffee
        glass: 100% * l.glass
        lens: l.pearl > 0.5
        shine: pointer
        refraction: 120% * l.pearl
        dispersion: 260% * l.pearl
        rim: 18%
        light: 6%, pc.y - ph / 2, 40
        shadow: 0, 10, 26, 38% * pm
        opacity: if(pm > 0.01, 1, 0) * so
        box { at: if(p.grow > 0.02, pc.x, pb.x), if(p.grow > 0.02, pc.y, pb.y); size: 44 + (pw - 44) * p.grow, 44 + (ph - 44) * p.grow; corner: 22 - 6 * p.grow }
        // ucho = kvapka vypínača v rohu okna (zliata s ním)
        ellipse { at: pb.x, pb.y; radius: 24 * clamp(pm * 4, 0, 1); blend: 16 * p.grow }
    }
    text "" { at: pb.x, pb.y; anchor: center; size: 16; color: ink; opacity: so * clamp(pm * 3 - 0.5, 0, 1); show: pm > 0.1; family: "noctalia-tabler-icons" }
    group {
        opacity: clamp(pm * 2 - 1, 0, 1)
        show: pm > 0.5
        // batéria (notebook): percento, nabíjanie
        text pick(if(bat_chg, 1, 0), "", "") { at: p0.x + 8, p0.y - 30; anchor: left center; size: 18; color: if(bat_pct < 15 and not bat_chg, #e5484d, l.fg); show: bat_present; family: "noctalia-tabler-icons" }
        text "{bat_pct} %" { at: p0.x + 36, p0.y - 30; anchor: left center; size: 15; weight: 600; color: l.fg; show: bat_present; family: "Inter" }
        text pick(if(bat_chg, 1, 0), "On battery", "Charging") { at: p0.x + pw - 32, p0.y - 30; anchor: right center; size: 12; color: l.dim; show: bat_present; family: "Inter" }
        box { at: pt.x, p0.y - 8; size: pw - 40, 1; color: l.line; show: bat_present }
        box { at: pt.x, p0.y + 20; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 0, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 20; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Settings" { at: p0.x + 44, p0.y + 20; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 60; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 1, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 60; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Monitor" { at: p0.x + 44, p0.y + 60; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 86; size: pw - 40, 1; color: l.line }
        box { at: pt.x, p0.y + 112; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 2, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 112; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Lock" { at: p0.x + 44, p0.y + 112; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 152; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 3, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 152; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Sign out" { at: p0.x + 44, p0.y + 152; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 192; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 4, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 192; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Sleep" { at: p0.x + 44, p0.y + 192; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 232; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 5, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 232; anchor: left center; size: 17; color: l.fg; family: "noctalia-tabler-icons" }
        text "Restart" { at: p0.x + 44, p0.y + 232; anchor: left center; size: 13.5; weight: 500; color: l.fg; family: "Inter" }
        box { at: pt.x, p0.y + 272; size: pw - 24, 36; corner: 10; color: l.hover; opacity: if(pm_hot == 6, 100%, 0) }
        text "" { at: p0.x + 16, p0.y + 272; anchor: left center; size: 17; color: #e5484d; family: "noctalia-tabler-icons" }
        text "Shut down" { at: p0.x + 44, p0.y + 272; anchor: left center; size: 13.5; weight: 500; color: #e5484d; family: "Inter" }
    }
    zone box pm_hit.0 { at: pt.x, p0.y + 20; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.1 { at: pt.x, p0.y + 60; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.2 { at: pt.x, p0.y + 112; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.3 { at: pt.x, p0.y + 152; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.4 { at: pt.x, p0.y + 192; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.5 { at: pt.x, p0.y + 232; size: pw - 20, 38; cursor: pointer; active: pmenu }
    zone box pm_hit.6 { at: pt.x, p0.y + 272; size: pw - 20, 38; cursor: pointer; active: pmenu }
    // batéria na kvapke vypínača: minibublinky (3 zelené ≥ 60 %, 2 žlté ≥ 30 %, 1 červená), pod 10 % pulzuje,
    // pri nabíjaní stúpajú a klesajú; na stolnom PC žiadne
    let bat_n = if(bat_pct >= 60, 3, if(bat_pct >= 30, 2, 1))
    let bat_pulse = if(bat_pct < 10 and not bat_chg, 1 + 0.25 * sin(time * 8), 1)
    body {
        color: pick(bat_n - 1, #e5484d, #f5c542, #46a758)
        rim: 30%
        light: 18%, 0, 16
        opacity: if(bat_present and solo, 1, 0) * (1 - pm)
        ellipse { at: pxs + (away.x * cos(-32) - away.y * sin(-32)) * (27 + 3 * sin(time * 3 + 0) * if(bat_chg, 1, 0)), pys + (away.y * cos(-32) + away.x * sin(-32)) * (27 + 3 * sin(time * 3 + 0) * if(bat_chg, 1, 0)); radius: 4.5 * if(0 < bat_n, 1, 0) * bat_pulse * so; blend: 4 }
        ellipse { at: pxs + (away.x * cos(0) - away.y * sin(0)) * (27 + 3 * sin(time * 3 + 2) * if(bat_chg, 1, 0)), pys + (away.y * cos(0) + away.x * sin(0)) * (27 + 3 * sin(time * 3 + 2) * if(bat_chg, 1, 0)); radius: 4.5 * if(1 < bat_n, 1, 0) * bat_pulse * so; blend: 4 }
        ellipse { at: pxs + (away.x * cos(32) - away.y * sin(32)) * (27 + 3 * sin(time * 3 + 4) * if(bat_chg, 1, 0)), pys + (away.y * cos(32) + away.x * sin(32)) * (27 + 3 * sin(time * 3 + 4) * if(bat_chg, 1, 0)); radius: 4.5 * if(2 < bat_n, 1, 0) * bat_pulse * so; blend: 4 }
    }
    // <<< PowerGoo
