    body {
        color: coffee
        rim: 30%
        light: 14%, 0, 30
        glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
        shine: pointer
        box { at: wa.x.0, wa.y.0; size: 64 * abs(wn.y.0) + 18 * abs(wn.x.0), 18 * abs(wn.y.0) + 64 * abs(wn.x.0); corner: 9; opacity: 1 }
        ellipse { at: wa.x.0, wa.y.0; radius: 22 * wsheet.0; blend: 14 }
