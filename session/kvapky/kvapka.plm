// LatteOS — Kvapka: lišta aplikácií ako tekutá kvapka kávy (prototyp, pleamar 0.1).
// Zámerne nesúmerná: hlava (hrbolček bez očí — kvapky nemajú tvár) stojí vždy na ĽAVOM konci, kvapka rastie
// doprava s každým oknom; bez okien je guľatá, do okraja sa zlieva plynulo, radiálne.
// V pokoji je vpitá do okraja obrazovky (skoro rovina). Keď sa k nej myš priblíži na štvrtinu výšky obrazovky,
// začne sa vysúvať a kým k nej myš dôjde, je napoly vonku, na hrubej stopke pod hlavou.
// Vlastné menu nemá: od okraja sa odtrhne iba chytením a potiahnutím (drag & drop). Stopka sa natiahne a
// pretrhne, kvapka ide za myšou; pustená pri inom okraji sa k nemu prilepí (ako presun panela úloh k inému
// okraju), pustená uprostred skvapalní, stečie a znova sa vynorí tam, kde bola.
// Kreslí sa v „rámci okraja“ (okraj je čiara y = edge, kvapka nad ňou) a skupina ho otočí k zvolenému okraju;
// ikony a nápis stoja rovno, preto sa ich poloha prepočíta do obrazovky (pick podľa `side`).
// Klik na hlavu prepne režim okien (plávajúce → dlaždice → páska), koliesko nad hlavou: páska = posun,
// plávajúce = ďalšie okno.
// Samostatne (relácia LatteOS Kvapky, bez Noctalie: LATTE_VARIANT=kvapky) pribudnú vľavo od hlavy dve malé
// kvapky, tiež vpité do okraja: Hodiny (na mieste Štartu; po rozbalení dashboard) a vypínač (ponuka Vypnúť).
// Na Hodinách visia upozornenia ako farebné kvapôčky; nové do nich spadne a vyleje sa pri nich bublina s textom.
// Kvapky na seba pôsobia:
// keď sa vysúvajú, spájajú ich goo vlákna (vypínač ↔ Štart ↔ hlava), nakláňajú sa k susedovi pod myšou
// a stlačenie jednej prebehne vlnou cez susedov.
// Koncept: AUDIT-WIN11.md › Kvapky.
language 0.1

scene Kvapka {
    surface {
        size: full, full    // celá obrazovka: kvapka sa dá preniesť k ľubovoľnému okraju; kliky berú iba zóny
        anchor: bottom
        margin: 0
        level: top
        reserve: -1     // ignorovať vyhradené pásy (lišta Noctalie): okraj kvapky je skutočný okraj obrazovky
        rate: 60        // pokojný pohyb kvapky nepotrebuje 144 Hz: 12 % → 6 % jadra na RX 640
        keyboard: on_demand while dash or dn_open   // hľadanie v spúšťači, Esc pri hrozne DaNoGoo
    }
    permissions { services: "window", "window.*", "clock", "notifications", "notifications.*", "apps", "apps.*", "network", "network.*", "bluetooth", "bluetooth.*", "audio", "audio.*", "battery", "media", "tray", "tray.*", "clipboard.set"; run: "noctalia", "latte-app", "hyprctl", "cat", "printenv", "curl", "latte-spustac", "latte-ponuka", "latte-kvapky", "fd", "xdg-open", "latte-ai", "latte-terminal", "date", "sh", "notify-send", "paplay", "latte-apps", "latte-devices" }

    // zoznam okien priamo zo služby (wlr-foreign-toplevel), bez logiky; ikona podľa triedy okna
    model wins max 48 { id: text; title: text; class: text; active: bool; minimized: bool }
    service window { list: wins }
    // rozloženie guľôčok okien (počíta logika): x, y od hlavy v rámci okraja (y < 0 = preč od okraja), polomer.
    // Okná tej istej aplikácie sa zlepia do strapca ako ikry — čím viac, tým menšie (do 72 %) —, jedno okno je
    // plná guľa; myš nad strapcom ho rozvinie do radu (vejár), okno cez celú obrazovku (tight) všetko zrovná do pásu
    model lay max 48 { x: number; y: number; r: number; icon: text; ax: number; ay: number; dim: number }
    fact chain_w = 50                        // kde šnúra končí (od hlavy)
    // čas (služba bez logiky); dátum sa skladá tu — `clock.date` je iba po anglicky
    service clock as now { time: text = "--:--"; hour: number; minute: number; weekday: number; day: number; month: number; year: number }
    // upozornenia (plní logika, iba v ploche Kvapky — inak by ich prebrala Noctalii), najnovšie prvé;
    // urgency 0 nízka, 1 bežná, 2 kritická
    model notes max 20 { id: number; app: text; title: text; body: text; urgency: number }
    event new_note
    text toast = ""
    // ── spúšťač (1. 10., náčrt používateľa): vyteká z TimeGoo — ľavý klik na ňu alebo kláves Win. Vlastný vzhľad Goo
    // (nie menu z klasického LatteOS). Zhora: pole s ikonou režimu (klik = výber, koliesko točí: AI, aplikácie,
    // súbory, web, Linux príkaz); obsah režimu; riadok režimu (záložky obľúbených, nastavenia AI, vyhľadávač…);
    // úplne dole úzky riadok počasia (Dnes / Zajtra / Týždeň, Detaily). Plní logika (~/.config/latteos/spustac.json).
    fact dash = false
    text query = ""
    text hint = ""                           // zástupný text poľa podľa režimu (logika)
    text note = ""                           // riadok nápovedy v prázdnom obsahu (logika)
    text weather = ""
    fact typing = false                      // v poli je niečo napísané (logika; text sa vo výrazoch neporovnáva)
    fact renaming = false                    // pole práve slúži ako názov záložky
    fact smode = 1                           // 0 AI, 1 aplikácie, 2 súbory, 3 web, 4 Linux príkaz
    fact mode_open = false                   // rozbalený výber režimu pod ikonou
    fact mode_hot = -1
    model modes max 5 { name: text; glyph: text }
    fact tab = 1                             // záložka obľúbených (1..), v režime aplikácií
    // riadky obsahu: aplikácie, súbory, vyhľadávače, príkazy — vpravo druh
    model hits max 7 { name: text; sub: text; icon: image 28, 28; warn: bool }
    fact sel = 0
    fact hit_hot = -1
    // obľúbené v záložke: mriežka 6 × 3
    model favs max 12 { name: text; icon: image 36, 36 }
    text fav_title = ""                      // názov zvolenej záložky nad dlaždicami
    // nedávno spustené aplikácie (pod obľúbenými, 2 × 2)
    model recent max 4 { name: text; icon: image 24, 24 }
    fact rec_hot = -1
    event rec_open ->
    event rec_menu ->
    fact tema = 0                            // téma LatteOS (poradie v session/themes/make-themes.py, logika)
    fact fav_hot = -1
    // AI: rozhovor ako goo bubliny, najnovšia navrchu pri poli (náčrt); me = používateľ
    model chat max 8 { txt: text; me: bool }
    fact ai_wait = false
    // riadok režimu: čipy (záložky, AI služba a model, vyhľadávač…); on = vybraný, drop = otvorí ponuku
    model chips max 7 { label: text; label_on: bool; glyph: text; hasg: bool; on: bool; drop: bool }
    fact chip_hot = -1
    // počasie: miesto, súhrn zvolenej varianty (0 dnes, 1 zajtra, 2 týždeň); Detaily = predpoveď v obsahu
    text wx_place = ""
    text wx_sum = ""
    text wx_icon = ""
    fact wx_view = 0
    fact wx_detail = false
    fact wx_hot = -1
    model wx max 8 { label: text; glyph: text; temp: text }
    // kontextová ponuka v spúšťači (pravý klik, rozbaľovacie čipy): položky a miesto dáva logika; on 1 = zaškrtnuté
    model ctx max 10 { label: text; on: number; off: bool }
    fact ctx_open = false
    fact ctx.x = 0
    fact ctx.y = 0
    fact ctx_hot = -1
    event open_hit ->
    event hit_menu ->
    event fav_open ->
    event fav_menu ->
    event chip_pick ->
    event chip_menu ->
    event mode_pick ->
    event wx_pick ->
    event bubble_menu ->
    event ai_cancel ->
    event ctx_pick ->
    event query_submit ->
    event sel_move ->
    event note_open ->
    event notes_clear ->
    event dash_toggle                        // kláves Win (latte-spustac) v ploche Kvapky
    event time_menu ->                       // pravý klik na Hodiny: časové menu
    // časové menu TimeGoo (1. 10.): tá istá karta z ucha; logika plní a stráži minútku a budíky (v Goo nie je
    // widget hodín Noctalie, ktorý to robí v klasickom LatteOS)
    fact tview = 0                           // 0 spúšťač, 1 časové menu
    fact ttab = 0                            // 0 prehľad, 1 stopky, 2 minútka, 3 budíky
    text t_date = ""
    text t_week = ""
    text t_sw = "00:00,0"
    text t_timer = "05:00"
    text t_next = ""
    text t_alh = "07"
    text t_alm = "00"
    text wb_total = ""
    fact t_frac = 0                          // minútka: zostáva / celkom (kruh)
    fact t_run = false                       // minútka beží
    fact t_active = false                    // minútka beží alebo je pozastavená
    fact sw_run = false
    fact t_has_next = false
    fact t_hot = -1
    model wbl max 3 { name: text; dur: text; frac: number }
    model zones max 4 { city: text; hm: text; diff: text }
    model laps max 5 { label: text; time: text }
    model alarms max 5 { hm: text; label: text; on: bool }
    event t_do ->
    event t_wheel ->
    // ponuka Vypnúť: vyteká z kvapky vypínača (klik); akcie robí Noctalia (`noctalia msg session …`)
    fact pmenu = false
    fact pm_hot = -1
    event power_do ->
    // stav siete, bluetoothu a zvuku (služby pleamaru) — pre kvapky widgetov
    model nets max 7 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model bts max 7 { name: text; paired: bool; connected: bool }
    model outs max 7 { name: text; default: bool }
    service network as net { online: bool; wifi: bool; name: text; networks: nets }
    service bluetooth as bt { present: bool; powered: bool; devices: bts }
    service audio as snd { volume: number; muted: bool; outputs: outs }
    event hover ->
    event unhover ->
    fact mode: plavajuce | dlazdice | paska = plavajuce
    fact side: dole | hore | vlavo | vpravo = dole   // okraj, pri ktorom lišta je (logika ho pamätá)
    fact pos = 0.4                           // kde na okraji stojí hlava (podiel dĺžky okraja)
    fact pulling = false                     // ťahá sa od okraja (stopka sa naťahuje)
    fact bsnap = false                       // vlákno ťahanej guľôčky prasklo
    fact lpress = false                      // hlava stlačená ľavým (klik = režim okien)
    fact ldrag = false                       // základňa stlačená ľavým: iba ľavé ťahanie lištu presúva (ako vo Windows)
    fact icon_press = false                  // stlačený hrbolček s oknom (ťahanie z neho kvapku nepresúva)
    // ťahanie guľôčky okna: ide za myšou na lepkavom vlákne; pustená medzi inými presunie aplikáciu (poradie v lište),
    // inde sa pružne vráti. Klik bez ťahania = prepnúť okno (vyhodnotí sa až po pustení)
    fact bdrag = -1
    fact bmoved = false
    event bead_drop ->
    fact menu.x = 0                          // kde otvoriť ponuku okna (kurzor pri pravom kliku)
    fact menu.y = 0
    fact free = false                        // odtrhnutá, ide za myšou
    fact melting = false                     // pustená uprostred: steká
    fact room = 999                          // voľné miesto od okraja po najnižšie okno (logika), px
    fact tight = false                       // aktívne okno siaha k lište (maximalizované, celá obrazovka, dlaždice):
                                             // kvapka ostane v páse 64 px a cez okno sa nevysunie (logika)
    fact solo = false                        // bez Noctalie: kvapky Štart a vypínač (logika podľa LATTE_VARIANT)
    event cycle ->
    event pick ->
    event wheel_turn ->
    event start_open ->
    event power_open ->
    event side_moved ->
    event win_menu ->

    // obsah je vždy káva (téma je hrnček — materiál okien); líši sa pomerom vody a mlieka:
    // voda ju robí priesvitnou (sklo, ako lungo/americano), mlieko svetlejšou a zakalenou (cappuccino, latte).
    // Voľbu (~/.config/latteos/kava, napr. „latte“) číta logika; fakty 0..1.
    fact voda = 0
    fact mlieko = 0
    prop v = 0 ~gentle
    prop m = 0 ~gentle
    follow v = voda
    follow m = mlieko
    let coffee = mix(mix(#1c0f09, #4a2410, v), #c9a47a, pow(m, 2))   // voda: hnedšia; mlieko svetlejšie, najprv pomaly
    let cream = #f3ebdd
    let ink = mix(#f3ebdd, #2a170c, smooth(0.62, 0.78, m))   // ikony a nápisy na svetlej (mliečnej) káve tmavé
    let edge = 260                           // okraj v rámci kvapky (čiara y = 260, kvapka nad ňou)
    let W = screen.width
    let H = screen.height
    let L = if(side == vlavo or side == vpravo, H, W)     // dĺžka okraja
    let lx = L * pos                         // hlava: ľavý koniec (v rámci okraja)
    let bl = lx - 36                         // ľavý okraj tela
    let sx0 = lx - 92                        // kvapka Hodiny (na mieste Štartu, pokojová poloha)
    let px0 = lx - 158                       // kvapka vypínač
    let n = wins.count
    // Tvar ako tekutina v nízkej gravitácii (goo): nie tuhá kapsula, ale šnúra guľôčok. Hlava vľavo je najväčšia
    // „materská“ kvapka, každé okno je vlastná guľatá kvapka (povrchové napätie), so susedkami ju spája krk
    // (blend) a drží ich tenké vlákno. Kvapky pomaly dýchajú a plávajú, každá inak; aktívne okno je plnšie;
    // pribudnuté alebo zatvorené okno pošle šnúrou vlnu. Bez okien ostane iba hlava — guľa vpitá do okraja.
    // Dlaždice: okná sú na ploche vedľa seba, kvapka je jedna široká „tabuľka“ bez guľôčok.
    let step = if(mode == paska, 46, 56)     // rozostup guľôčok (o trochu menší ako priemer → krk)
    let rr = if(mode == paska, 24, 29)       // polomer guľôčky okna
    let round = if(n < 1, 1, 0)
    prop w = 72 ~lively
    prop h = 72 ~lively
    prop c = 36 ~lively
    // (30. 9.) okná sú guľôčky vo všetkých režimoch — v Dlaždiciach predtým zmizli a nedali sa kliknúť
    follow w = if(round, 72, chain_w + 36)
    follow h = if(round, 72, 2 * rr + 6)
    follow c = if(round, 36, 12)
    // vlákno medzi guľôčkami: tenké; pri dlaždiciach a bez okien je celé telo
    let spine.h = if(round, h, h * 0.34)

    // blízkosť myši kdekoľvek na ploche (cursor.x/y: pleamar sa pýta Hyprlandu, žiadna zóna nekradne kliky).
    // Každá kvapka sa zdvíha podľa vzdialenosti kurzora od NEJ (lišta, Hodiny, vypínač), nie všetky naraz;
    // sused sa pridá iba trochu (goo ho ťahá). Lišta sa vysúva od štvrtiny výšky obrazovky (270 px pri 1080).
    // myš v rámci okraja (inverzia otočenia skupiny nižšie)
    // na skúšky bez myši (headless): `pleamar --say kvapka "fact tcx 700"` a `"fact tcy 1000"` — náhradný kurzor
    fact tcx = -1
    fact tcy = -1
    let mx = if(tcx >= 0, tcx, cursor.x)
    let my = if(tcy >= 0, tcy, cursor.y)
    let cu = pick(side, mx, W - mx, my, H - my)
    let cv = pick(side, my - (H - edge), edge - my, edge - mx, mx - W + edge)
    let dist.x = max(0, max(bl - cu, cu - (bl + w)))
    let dist.y = max(0, edge - h * 0.6 - cv)
    let near.s = 1 - smooth(0, 130, length(cu - sx0, max(0, edge - 40 - cv)))     // Hodiny
    let near.p = 1 - smooth(0, 110, length(cu - px0, max(0, edge - 30 - cv)))     // vypínač
    // zhora sa lišta vysúva od štvrtiny výšky obrazovky, do strán má kratší dosah (×2,2), aby kurzor nad Hodinami
    // či vypínačom dvíhal najmä tie
    let approach.b = 1 - smooth(0, 270, length(dist.x * 2.2, dist.y))
    let approach = clamp(approach.b + 0.3 * near.s * so, 0, 1)                      // lišta (+ trochu od Hodín)

    // von z okraja: 0 = vpitá do okraja, 0,55 = napoly vonku (myš pri nej), 0,9 = stopka praskne pri ťahaní.
    // Bez odskoku, aby stopka nepreskočila späť. Pri vysúvaní drží telo stopka pod hlavou: stĺpik od okraja
    // k telu, roztavený s oboma koncami (preto je v strede tenší), ktorý sa od 0,4 zužuje, až pri 0,9 zmizne.
    fact probe = 0                           // na skúšky: `pleamar --say kvapka "fact probe 75"` zastaví kvapku na 0,75
    prop pull = 0 ~quick                     // ťahanie myšou od okraja: −1 k okraju … 1 preč
    prop out = 0 ~700ms
    follow out = if(probe > 0, probe / 100, if(pulling and not free, clamp(0.55 + pull * 0.45, 0, 1), if(tight, room.cap, 0.55) * approach))
    // ap: lišta je pri okraji (1) alebo vtiahnutá doň (0) — kým ide za myšou, steká, alebo sa vynára inde
    prop ap = 1 ~600ms
    // Lišta sa od okraja NEODLEPÍ sama: pri myši (out do 0,55) sa iba vynorí a stále sa ho dotýka (dno na okraji);
    // odlepí ju až ťahanie (out nad 0,55 → dno ide od okraja, stopka sa naťahuje a praskne)
    let sink = h * 0.42
    let o.rise = clamp(out / 0.55, 0, 1)
    // pod oknom sa lišta vysunie presne po jeho spodok (najvyšší bod = hlava, mid − 44), nie vyššie
    let room.cap = clamp(0.55 * (1 - (h / 2 + 44 - room) / max(sink, 1)), 0.08, 0.55)
    let o.pull = clamp((out - 0.55) / 0.45, 0, 1)
    let bottom = edge + sink * (1 - o.rise) - 48 * o.pull + (h + 44) * (1 - ap)
    let by = bottom - h
    let mid = by + h / 2
    // lišta je „uväznená váhou“: kým ju nikto neťahá, sedí na okraji ako kvapky na stole — široká „voda“ pod celou
    // šnúrou a menisk (neck) pod každou guľôčkou; strapce z nej rastú hore, ale od okraja sa neoddelia
    let neck = if(round, 24, 16) * (1 - o.pull) + 16 * 4 * o.pull * (1 - o.pull) + 6 * o.rise * (1 - o.pull)
    let stalk.w = 30 * clamp((0.9 - out) / 0.5, 0, 1)
    let stalk.x = lx + 6
    // „voda“ pod okrajom: v pokoji široká (kvapka sa zlieva s okrajom do roviny), vonku úzka pod hlavou
    let water.w = 40 + (w + 90) * (1 - o.pull) * (1 - o.pull)
    let water.x = stalk.x + (bl + w / 2 - stalk.x) * (1 - o.pull)

    // odtrhnutá kvapka (v súradniciach obrazovky): ide za myšou s oneskorením, zaguľatí sa; pri stekaní padá,
    // naťahuje sa a mizne
    prop gx = 0 ~lively
    prop gy = 0 ~lively
    prop gw = 90 ~lively
    prop gh = 90 ~lively
    prop fall = 0 ~1000ms
    prop dockt = 0 ~260ms
    let near.edge = min(min(mx, W - mx), min(my, H - my))

    prop wob = 0 ~lively
    prop bdx = 0 ~lively                     // posun ťahanej guľôčky (v rámci okraja)
    prop bdy = 0 ~lively
    prop squish = 0 ~quick
    prop squish.s = 0 ~quick
    prop squish.p = 0 ~quick
    prop nfall = 0 ~700ms                    // nové upozornenie padá do Hodín
    prop toast.p = 0 ~lively                 // bublina s textom nového upozornenia
    on new_note { impulse dn.wob 260; toast.p: 1 after 200ms; toast.p: 0 after 6500ms }
    prop dsh = 0 ~420ms                      // dashboard: 0 = zbalený v Hodinách, 1 = rozliaty
    // rýchle nastavenia v dashboarde a riadky ponuky Vypnúť: myš nad nimi ich trochu nafúkne
    repeat k in 0..4 {
        prop qsh.$k = 0 ~lively
    }
    repeat k in 0..5 {
        prop pmh.$k = 0 ~lively
        follow pmh.$k = if(pm_hot == k, 1, 0)
    }
    prop pm = 0 ~380ms                       // ponuka Vypnúť
    follow pm = if(pmenu, 1, 0)
    follow dsh = if(dash, 1, 0)
    spring springy = 170, 11
    prop dsw = 0 ~springy
    follow dsw = if(dash or dsh > 0.3, 1, 0)             // ucho ostane v rohu, kým sa karta nezloží
    prop swob = 0 ~springy
    fact esnap = false
    prop estub = 0 ~320ms
    on change dsw < 0.05 while dsw < 0.05 and not dash { impulse swob 380; impulse wob 60 }
    on change dsw > 0.72 while dsw > 0.72 and dash and not esnap and e.d > 150 { esnap = true; estub: 1 ~0ms; estub: 0 ~320ms after 16ms; impulse swob 160 }
    on change dsw < 0.3 while dsw < 0.3 and not dash and esnap { esnap = false; impulse swob 120 }
    on change ap > 0.9 while ap > 0.9 { impulse wob 70 }

    // Štart a vypínač: bez odtrhnutia, iba sa vysunú (pri myši napoly von, ako hlavná kvapka)
    prop so = 0 ~lively
    follow so = if(solo, 1, 0)
    // každá malá kvapka vlastné zdvihnutie (sused iba 30 %); lift = spoločné (mosty, víry), najvyššie z nich
    prop lift.s = 0 ~700ms
    prop lift.p = 0 ~700ms
    follow lift.s = clamp(near.s + 0.3 * max(near.p, approach.b), 0, 1) * if(tight, 0.35, 1)
    follow lift.p = clamp(near.p + 0.3 * near.s, 0, 1) * if(tight, 0.35, 1)
    let lift = max(lift.s, lift.p)
    // tekutina okolo vypínača a Štartu žije aj bez myši: pomalé toky (flow, flow2 0..1, desiatky sekúnd), kvapky
    // driftujú, mláka pri okraji sa rozlieva a sťahuje, vlákna sa samy tvoria a trhajú; myš (lift) to zosilní
    let flow = 0.5 + 0.5 * noise(time * 0.13 + 1.7)
    let flow2 = 0.5 + 0.5 * noise(time * 0.09 + 5.1)
    let stir = 1 + 1.5 * lift
    // pôsobenie medzi kvapkami: myš nad kvapkou (hs, hp, hh = Štart, vypínač, hlava) ju nafúkne a susedov
    // k nej nakloní; mosty (link) rastú s vysunutím — v pokoji spája kvapky iba okraj
    prop hs = 0 ~lively
    prop hp = 0 ~lively
    prop hh = 0 ~lively
    prop wp = 0 ~gentle                      // váhy obrazu režimu v hlave (páska / plávajúce / dlaždice)
    prop wf = 1 ~gentle
    prop wd = 0 ~gentle
    follow wp = if(mode == paska, 1, 0)
    follow wf = if(mode == plavajuce, 1, 0)
    follow wd = if(mode == dlazdice, 1, 0)
    let ws = max(wp + wf + wd, 0.05)
    // most sa vytvorí, keď je medzera medzi kvapkami menšia ako asi polovica `link` (smooth min v pleamare):
    // pri vysúvaní sa preto kvapky k sebe nakláňajú — Štart k telu, vypínač k Štartu
    // živý tvor (30. 9.): keď sa kurzor priblíži, kvapka sa k nemu nakloní — venuje mu pozornosť; keď je nad ňou,
    // mierne sa nafúkne a netrpezlivo pulzuje (jit: rôsolovo, striedavo do šírky a do výšky). Tvár sa nemení.
    let near.h = 1 - smooth(0, 150, length(cu - lx, max(0, edge - 40 - cv)))
    let sx = sx0 + 18 * lift.s + 10 * hh - 9 * hp + 6 * stir * noise(time * 0.11 + 3) + 3 * lift.s * noise(time * 0.45 + 8) + clamp(cu - sx0, -26, 26) * 0.3 * near.s
    let px = px0 + 12 * lift.p + 12 * hs + 5 * stir * noise(time * 0.1 + 4) + 3 * lift.p * noise(time * 0.5 + 2) + clamp(cu - px0, -20, 20) * 0.3 * near.p
    let hx = lx - 7 * hs + clamp(cu - lx, -22, 22) * 0.25 * near.h
    let jit.s = 0.045 * sin(time * 8.5) * hs
    let jit.p = 0.05 * sin(time * 9.3) * hp
    let jit.h = 0.03 * sin(time * 7.7) * hh
    // v pokoji kvapky pomaly vystupujú z okraja a klesajú (každá v inom rytme), preto vidno aj vlákna a mláku
    // Hodiny sú vidieť stále (aj v pokoji a v úzkom páse): stred 22 px nad okrajom, pri myši o kúsok vyššie
    let s.y = edge - 22 - 24 * lift.s - 3 * hs - 4 * flow * (1 - lift.s) + 70 * (1 - ap)
    let p.y = edge + 3 - 26 * lift.p - 4 * hp - 12 * flow2 * (1 - lift.p) + 60 * (1 - ap)
    let link = 10 + 16 * lift + 10 * flow
    // goo vlákna: vypínač ↔ Štart a Štart ↔ telo lišty. Hrubnú s priblížením myši; keď sa lišta odtrhne
    // (out → 1), vlákno k nej sa stenčí a pretrhne. Roztavené s oboma koncami (blend), preto uprostred tenšie.
    let thread.ps = 9 * so * max(smooth(0.3, 0.9, min(lift.p, lift.s) * 1.6), 0.8 * smooth(0.55, 0.85, flow))
    let thread.sb = 12 * so * max(smooth(0.2, 0.8, max(lift.s, approach.b)), 0.7 * smooth(0.6, 0.9, flow2)) * clamp((0.97 - out) / 0.3, 0, 1)
    // kvapôčka, ktorá tečie po vláknach vypínač → Štart → lišta (iba kde vlákno je)
    let tt = fract(time * 0.07)
    let seg = if(tt < 0.5, 0, 1)
    let tf = if(tt < 0.5, tt * 2, tt * 2 - 1)
    let drip.x = if(seg, sx + 8 + (bl + 18 - sx - 8) * tf, px + (sx - px) * tf)
    let drip.y = if(seg, s.y - 12 + (bottom - 14 - s.y + 12) * tf, p.y - 4 + (s.y - 6 - p.y + 4) * tf)
    let drip.r = 4.5 * if(seg, clamp(thread.sb * ap / 4, 0, 1), clamp(thread.ps / 4, 0, 1))

    // guľôčka každého okna: pružina 0 → 1, zatvorené okno sa vtiahne späť do šnúry; aktívne je plnšie (act)
    repeat k in 0..48 {
        image icon.$k = from lay.$k.icon, 30, 30     // ikona zo spúšťača aplikácie (.desktop), inak podľa triedy
        prop b.$k = 0 ~lively
        follow b.$k = if(k < n, 1, 0)
        prop act.$k = 0 ~gentle
        follow act.$k = if(k < n and wins.$k.active, 1, 0)
        prop ux.$k = 50 ~gentle
        prop uy.$k = 0 ~gentle
        prop ur.$k = 29 ~gentle
        follow ux.$k = lay.$k.x
        follow uy.$k = lay.$k.y
        follow ur.$k = if(lay.$k.r > 0, lay.$k.r, rr)
        // lepkavé vlákno: kotva strapca (guľôčka pri lište) visí na okraji, ostatné na kotve (ako med, obr. 30. 9.)
        prop kx.$k = 50 ~gentle
        prop ky.$k = 0 ~gentle
        follow kx.$k = lay.$k.ax
        follow ky.$k = lay.$k.ay
        // minimalizované okno: guľôčka menšia (logika) a ikona stlmená
        prop dm.$k = 0 ~gentle
        follow dm.$k = lay.$k.dim
    }
    on change n { impulse wob 70 }

    // ── hladina pri okraji (prevzaté z Marey, k4ditano/marea-plm „ripple“, BSD-3) ────────────────────────────
    // Okraj je voda: odkiaľ kvapka odíde (krk praskne) alebo kam sa vráti (hladina sa nad ňou zatvorí), vyrazia
    // po hladine dve malé vlny doľava a doprava, zmenšujú sa a zaniknú. Štyri miesta: 0 Hodiny, 1 vypínač,
    // 2 lišta (okno pribudlo / ubudlo), 3 pustená guľôčka a lišta pristátá pri okraji. vx = kde (v súradniciach
    // okraja), vl = 0 → 1 cesta vlny. Viditeľná až keď sa oddelí od miesta, kde vznikla (clamp(vl · 6)).
    prop vl.0 = 1 ~900ms
    prop vx.0 = 0 ~0ms
    prop vl.1 = 1 ~900ms
    prop vx.1 = 0 ~0ms
    prop vl.2 = 1 ~900ms
    prop vx.2 = 0 ~0ms
    prop vl.3 = 1 ~900ms
    prop vx.3 = 0 ~0ms
    let vd.0 = 10 + 58 * vl.0
    let vh.0 = 12 * (1 - vl.0) * clamp(vl.0 * 6, 0, 1) * ap
    let vd.1 = 10 + 58 * vl.1
    let vh.1 = 12 * (1 - vl.1) * clamp(vl.1 * 6, 0, 1) * ap
    let vd.2 = 10 + 58 * vl.2
    let vh.2 = 12 * (1 - vl.2) * clamp(vl.2 * 6, 0, 1) * ap
    let vd.3 = 10 + 58 * vl.3
    let vh.3 = 12 * (1 - vl.3) * clamp(vl.3 * 6, 0, 1) * ap
    // prehnutie hladiny pod Hodinami, kým vyplávajú do panela (zvon: najväčšie v polovici cesty, ako krk)
    let sag.s = 16 * 4 * clamp(dsw, 0, 1) * (1 - clamp(dsw, 0, 1)) * so
    // kvapka, ktorá ostane po prasknutí krku: chvíľu visí na okraji, potom ju hladina pohltí
    prop stray = 0 ~520ms
    prop stray.x = 0 ~0ms
    on change dsw > 0.3 while dsw > 0.3 and dash { vx.0: sx ~0ms; vl.0: 0 ~16ms; vl.0: 1 ~900ms after 30ms; stray.x: sx ~0ms; stray: 1 ~16ms; stray: 0 ~520ms after 60ms }
    on change dsw < 0.05 while dsw < 0.05 and not dash { vx.0: sx ~0ms; vl.0: 0 ~16ms; vl.0: 1 ~760ms after 30ms }
    on change pm > 0.84 while pm > 0.84 { vx.1: px ~0ms; vl.1: 0 ~16ms; vl.1: 1 ~900ms after 30ms }
    on change pm < 0.06 while pm < 0.06 { vx.1: px ~0ms; vl.1: 0 ~16ms; vl.1: 1 ~760ms after 30ms }
    on change n { vx.2: lx + chain_w * 0.5 ~0ms; vl.2: 0 ~16ms; vl.2: 1 ~900ms after 30ms }
    on change ap > 0.9 while ap > 0.9 { vx.3: lx ~0ms; vl.3: 0 ~16ms; vl.3: 1 ~900ms after 30ms }

    // otvorený dashboard: klik kamkoľvek mimo neho ho zavrie (zóna cez celú obrazovku, pod všetkými ostatnými)
    zone box dash_away { at: W / 2, H / 2; size: W, H; active: dash or pmenu }

    // objem kvapky: svetlo zhora, lem a tieň z pleamaru, navrch odlesk. Skupina otočí rámec k okraju `side`
    // (otočenie okolo bodu okraja 0, edge a posun; inverzia je cu/cv vyššie).
    group {
        pivot: 0, edge
        rotate: pick(side, 0deg, 180deg, 90deg, -90deg)
        move: pick(side, 0, W, 0, W), pick(side, H - edge, 0 - edge, 0 - edge, H - edge)
        // dve svetlá (30. 9.): pasívne v ploche (light zhora + bodky odlesku hore vľavo) a aktívne — kurzor: svetlá
        // škvrna na povrchu tekutiny ide za ním, na guľôčkach pribudne odlesk na strane ku kurzoru
        body {
            gradient: radial cu, cv radius 230, mix(coffee, #f3ebdd, 0.16), coffee
            // vodová káva (lungo, americano) je sklo pleamaru: prepúšťa a láme, čo je za ňou, okraj chytá svetlo
            // kurzora (shine: pointer), stlačenie pošle ňou kruh svetla; espresso a mliečne kávy ostávajú nepriehľadné
            glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
            shine: pointer
            refraction: 110%
            dispersion: 60%
            ripple: 100%
            light: 16%, by - 40, 34
            rim: 30%
            shadow: 0, 6, 16, 40% * out
            box water { from: water.x - water.w / 2, edge; size: water.w, 70 }
            box { at: bl + w / 2, mid; size: w + wob * 0.1, spine.h * (1 - squish * 0.08); corner: spine.h / 2; blend: neck }
            box stalk { from: stalk.x - stalk.w / 2, bottom - 12; size: stalk.w, edge - bottom + 24; corner: stalk.w / 2; blend: 16 * clamp(stalk.w / 10, 0, 1) }
            // hlava: najväčšia guľa, trochu vyššie (nesúmernosť), pomaly dýcha
            ellipse { at: hx, mid - 8 - wob * 0.05 - 3 * near.h; radius: (36 + 3 * hh) * (1 + 0.03 * noise(time * 0.4)); scale: 1 + jit.h, 1 - jit.h; blend: 22 }
            // guľôčky okien: každá pláva a dýcha inak (noise podľa k), vlna pri zmene počtu (wob, striedavo)
            ellipse { at: lx + ux.0 + 2 * noise(0.0, time * 0.35) + if(bdrag == 0, bdx, 0), mid + uy.0 + 2.5 * noise(5.0, time * 0.3) + if(bdrag == 0, bdy, 0); radius: ur.0 * b.0 * (1 + 0.035 * noise(0.0, time * 0.5) + 0.12 * act.0) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.1 + 2 * noise(0.7, time * 0.35) + if(bdrag == 1, bdx, 0), mid + uy.1 + 2.5 * noise(6.3, time * 0.3) + if(bdrag == 1, bdy, 0); radius: ur.1 * b.1 * (1 + 0.035 * noise(2.1, time * 0.5) + 0.12 * act.1) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.2 + 2 * noise(1.4, time * 0.35) + if(bdrag == 2, bdx, 0), mid + uy.2 + 2.5 * noise(7.6, time * 0.3) + if(bdrag == 2, bdy, 0); radius: ur.2 * b.2 * (1 + 0.035 * noise(4.2, time * 0.5) + 0.12 * act.2) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.3 + 2 * noise(2.1, time * 0.35) + if(bdrag == 3, bdx, 0), mid + uy.3 + 2.5 * noise(8.9, time * 0.3) + if(bdrag == 3, bdy, 0); radius: ur.3 * b.3 * (1 + 0.035 * noise(6.3, time * 0.5) + 0.12 * act.3) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.4 + 2 * noise(2.8, time * 0.35) + if(bdrag == 4, bdx, 0), mid + uy.4 + 2.5 * noise(10.2, time * 0.3) + if(bdrag == 4, bdy, 0); radius: ur.4 * b.4 * (1 + 0.035 * noise(8.4, time * 0.5) + 0.12 * act.4) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.5 + 2 * noise(3.5, time * 0.35) + if(bdrag == 5, bdx, 0), mid + uy.5 + 2.5 * noise(11.5, time * 0.3) + if(bdrag == 5, bdy, 0); radius: ur.5 * b.5 * (1 + 0.035 * noise(10.5, time * 0.5) + 0.12 * act.5) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.6 + 2 * noise(4.2, time * 0.35) + if(bdrag == 6, bdx, 0), mid + uy.6 + 2.5 * noise(12.8, time * 0.3) + if(bdrag == 6, bdy, 0); radius: ur.6 * b.6 * (1 + 0.035 * noise(12.6, time * 0.5) + 0.12 * act.6) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.7 + 2 * noise(4.9, time * 0.35) + if(bdrag == 7, bdx, 0), mid + uy.7 + 2.5 * noise(14.1, time * 0.3) + if(bdrag == 7, bdy, 0); radius: ur.7 * b.7 * (1 + 0.035 * noise(14.7, time * 0.5) + 0.12 * act.7) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.8 + 2 * noise(5.6, time * 0.35) + if(bdrag == 8, bdx, 0), mid + uy.8 + 2.5 * noise(15.4, time * 0.3) + if(bdrag == 8, bdy, 0); radius: ur.8 * b.8 * (1 + 0.035 * noise(16.8, time * 0.5) + 0.12 * act.8) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.9 + 2 * noise(6.3, time * 0.35) + if(bdrag == 9, bdx, 0), mid + uy.9 + 2.5 * noise(16.7, time * 0.3) + if(bdrag == 9, bdy, 0); radius: ur.9 * b.9 * (1 + 0.035 * noise(18.9, time * 0.5) + 0.12 * act.9) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.10 + 2 * noise(7.0, time * 0.35) + if(bdrag == 10, bdx, 0), mid + uy.10 + 2.5 * noise(18.0, time * 0.3) + if(bdrag == 10, bdy, 0); radius: ur.10 * b.10 * (1 + 0.035 * noise(21.0, time * 0.5) + 0.12 * act.10) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.11 + 2 * noise(7.7, time * 0.35) + if(bdrag == 11, bdx, 0), mid + uy.11 + 2.5 * noise(19.3, time * 0.3) + if(bdrag == 11, bdy, 0); radius: ur.11 * b.11 * (1 + 0.035 * noise(23.1, time * 0.5) + 0.12 * act.11) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.12 + 2 * noise(8.4, time * 0.35) + if(bdrag == 12, bdx, 0), mid + uy.12 + 2.5 * noise(20.6, time * 0.3) + if(bdrag == 12, bdy, 0); radius: ur.12 * b.12 * (1 + 0.035 * noise(25.2, time * 0.5) + 0.12 * act.12) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.13 + 2 * noise(9.1, time * 0.35) + if(bdrag == 13, bdx, 0), mid + uy.13 + 2.5 * noise(21.9, time * 0.3) + if(bdrag == 13, bdy, 0); radius: ur.13 * b.13 * (1 + 0.035 * noise(27.3, time * 0.5) + 0.12 * act.13) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.14 + 2 * noise(9.8, time * 0.35) + if(bdrag == 14, bdx, 0), mid + uy.14 + 2.5 * noise(23.2, time * 0.3) + if(bdrag == 14, bdy, 0); radius: ur.14 * b.14 * (1 + 0.035 * noise(29.4, time * 0.5) + 0.12 * act.14) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.15 + 2 * noise(10.5, time * 0.35) + if(bdrag == 15, bdx, 0), mid + uy.15 + 2.5 * noise(24.5, time * 0.3) + if(bdrag == 15, bdy, 0); radius: ur.15 * b.15 * (1 + 0.035 * noise(31.5, time * 0.5) + 0.12 * act.15) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.16 + 2 * noise(11.2, time * 0.35) + if(bdrag == 16, bdx, 0), mid + uy.16 + 2.5 * noise(25.8, time * 0.3) + if(bdrag == 16, bdy, 0); radius: ur.16 * b.16 * (1 + 0.035 * noise(33.6, time * 0.5) + 0.12 * act.16) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.17 + 2 * noise(11.9, time * 0.35) + if(bdrag == 17, bdx, 0), mid + uy.17 + 2.5 * noise(27.1, time * 0.3) + if(bdrag == 17, bdy, 0); radius: ur.17 * b.17 * (1 + 0.035 * noise(35.7, time * 0.5) + 0.12 * act.17) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.18 + 2 * noise(12.6, time * 0.35) + if(bdrag == 18, bdx, 0), mid + uy.18 + 2.5 * noise(28.4, time * 0.3) + if(bdrag == 18, bdy, 0); radius: ur.18 * b.18 * (1 + 0.035 * noise(37.8, time * 0.5) + 0.12 * act.18) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.19 + 2 * noise(13.3, time * 0.35) + if(bdrag == 19, bdx, 0), mid + uy.19 + 2.5 * noise(29.7, time * 0.3) + if(bdrag == 19, bdy, 0); radius: ur.19 * b.19 * (1 + 0.035 * noise(39.9, time * 0.5) + 0.12 * act.19) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.20 + 2 * noise(14.0, time * 0.35) + if(bdrag == 20, bdx, 0), mid + uy.20 + 2.5 * noise(31.0, time * 0.3) + if(bdrag == 20, bdy, 0); radius: ur.20 * b.20 * (1 + 0.035 * noise(42.0, time * 0.5) + 0.12 * act.20) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.21 + 2 * noise(14.7, time * 0.35) + if(bdrag == 21, bdx, 0), mid + uy.21 + 2.5 * noise(32.3, time * 0.3) + if(bdrag == 21, bdy, 0); radius: ur.21 * b.21 * (1 + 0.035 * noise(44.1, time * 0.5) + 0.12 * act.21) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.22 + 2 * noise(15.4, time * 0.35) + if(bdrag == 22, bdx, 0), mid + uy.22 + 2.5 * noise(33.6, time * 0.3) + if(bdrag == 22, bdy, 0); radius: ur.22 * b.22 * (1 + 0.035 * noise(46.2, time * 0.5) + 0.12 * act.22) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.23 + 2 * noise(16.1, time * 0.35) + if(bdrag == 23, bdx, 0), mid + uy.23 + 2.5 * noise(34.9, time * 0.3) + if(bdrag == 23, bdy, 0); radius: ur.23 * b.23 * (1 + 0.035 * noise(48.3, time * 0.5) + 0.12 * act.23) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.24 + 2 * noise(16.8, time * 0.35) + if(bdrag == 24, bdx, 0), mid + uy.24 + 2.5 * noise(36.2, time * 0.3) + if(bdrag == 24, bdy, 0); radius: ur.24 * b.24 * (1 + 0.035 * noise(50.4, time * 0.5) + 0.12 * act.24) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.25 + 2 * noise(17.5, time * 0.35) + if(bdrag == 25, bdx, 0), mid + uy.25 + 2.5 * noise(37.5, time * 0.3) + if(bdrag == 25, bdy, 0); radius: ur.25 * b.25 * (1 + 0.035 * noise(52.5, time * 0.5) + 0.12 * act.25) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.26 + 2 * noise(18.2, time * 0.35) + if(bdrag == 26, bdx, 0), mid + uy.26 + 2.5 * noise(38.8, time * 0.3) + if(bdrag == 26, bdy, 0); radius: ur.26 * b.26 * (1 + 0.035 * noise(54.6, time * 0.5) + 0.12 * act.26) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.27 + 2 * noise(18.9, time * 0.35) + if(bdrag == 27, bdx, 0), mid + uy.27 + 2.5 * noise(40.1, time * 0.3) + if(bdrag == 27, bdy, 0); radius: ur.27 * b.27 * (1 + 0.035 * noise(56.7, time * 0.5) + 0.12 * act.27) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.28 + 2 * noise(19.6, time * 0.35) + if(bdrag == 28, bdx, 0), mid + uy.28 + 2.5 * noise(41.4, time * 0.3) + if(bdrag == 28, bdy, 0); radius: ur.28 * b.28 * (1 + 0.035 * noise(58.8, time * 0.5) + 0.12 * act.28) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.29 + 2 * noise(20.3, time * 0.35) + if(bdrag == 29, bdx, 0), mid + uy.29 + 2.5 * noise(42.7, time * 0.3) + if(bdrag == 29, bdy, 0); radius: ur.29 * b.29 * (1 + 0.035 * noise(60.9, time * 0.5) + 0.12 * act.29) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.30 + 2 * noise(21.0, time * 0.35) + if(bdrag == 30, bdx, 0), mid + uy.30 + 2.5 * noise(44.0, time * 0.3) + if(bdrag == 30, bdy, 0); radius: ur.30 * b.30 * (1 + 0.035 * noise(63.0, time * 0.5) + 0.12 * act.30) + wob * 0.04; blend: 13 }
