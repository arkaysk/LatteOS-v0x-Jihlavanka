            ellipse { at: lx + ux.29 + 2 * noise(20.3, time * 0.35) + if(bdrag == 29, bdx, 0), mid + uy.29 + 2.5 * noise(42.7, time * 0.3) + if(bdrag == 29, bdy, 0); radius: ur.29 * b.29 * (1 + 0.035 * noise(60.9, time * 0.5) + 0.12 * act.29) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.30 + 2 * noise(21.0, time * 0.35) + if(bdrag == 30, bdx, 0), mid + uy.30 + 2.5 * noise(44.0, time * 0.3) + if(bdrag == 30, bdy, 0); radius: ur.30 * b.30 * (1 + 0.035 * noise(63.0, time * 0.5) + 0.12 * act.30) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.31 + 2 * noise(21.7, time * 0.35) + if(bdrag == 31, bdx, 0), mid + uy.31 + 2.5 * noise(45.3, time * 0.3) + if(bdrag == 31, bdy, 0); radius: ur.31 * b.31 * (1 + 0.035 * noise(65.1, time * 0.5) + 0.12 * act.31) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.32 + 2 * noise(22.4, time * 0.35) + if(bdrag == 32, bdx, 0), mid + uy.32 + 2.5 * noise(46.6, time * 0.3) + if(bdrag == 32, bdy, 0); radius: ur.32 * b.32 * (1 + 0.035 * noise(67.2, time * 0.5) + 0.12 * act.32) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.33 + 2 * noise(23.1, time * 0.35) + if(bdrag == 33, bdx, 0), mid + uy.33 + 2.5 * noise(47.9, time * 0.3) + if(bdrag == 33, bdy, 0); radius: ur.33 * b.33 * (1 + 0.035 * noise(69.3, time * 0.5) + 0.12 * act.33) - wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.34 + 2 * noise(23.8, time * 0.35) + if(bdrag == 34, bdx, 0), mid + uy.34 + 2.5 * noise(49.2, time * 0.3) + if(bdrag == 34, bdy, 0); radius: ur.34 * b.34 * (1 + 0.035 * noise(71.4, time * 0.5) + 0.12 * act.34) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.35 + 2 * noise(24.5, time * 0.35) + if(bdrag == 35, bdx, 0), mid + uy.35 + 2.5 * noise(50.5, time * 0.3) + if(bdrag == 35, bdy, 0); radius: ur.35 * b.35 * (1 + 0.035 * noise(73.5, time * 0.5) + 0.12 * act.35) - wob * 0.04; blend: 13 }
