            ellipse { at: lx + ux.38 + 2 * noise(26.6, time * 0.35) + if(bdrag == 38, bdx, 0), mid + uy.38 + 2.5 * noise(54.4, time * 0.3) + if(bdrag == 38, bdy, 0); radius: ur.38 * b.38 * (1 + 0.035 * noise(79.8, time * 0.5) + 0.12 * act.38) + wob * 0.04; blend: 13 }
            ellipse { at: lx + ux.39 + 2 * noise(27.3, time * 0.35) + if(bdrag == 39, bdx, 0), mid + uy.39 + 2.5 * noise(55.7, time * 0.3) + if(bdrag == 39, bdy, 0); radius: ur.39 * b.39 * (1 + 0.035 * noise(81.9, time * 0.5) + 0.12 * act.39) - wob * 0.04; blend: 13 }
