            // Štart a vypínač: vlastná „voda“ pod okrajom; s hlavou a medzi sebou ich spája most `link`
            box { from: px - 34 - 14 * flow2 * stir, edge; size: (sx - px + 68 + 28 * flow2 * stir) * so, 70 }
            ellipse { at: sx, s.y; radius: (33 + 3 * hs) * so * (1 - smooth(0, 0.12, dsh)); scale: 1 + squish.s * 0.08, 1 - squish.s * 0.12; blend: link * so }
            // upozornenia: kvapôčky prilepené hore vľavo na Hodinách (najviac tri) a jedna, ktorá práve padá
            ellipse { at: sx - 25, s.y - 23; radius: 6.5 * so * (1 - dsh) * if(notes.count > 0, 1, 0); blend: 8 }
            ellipse { at: sx - 10, s.y - 34; radius: 5.5 * so * (1 - dsh) * if(notes.count > 1, 1, 0); blend: 8 }
            ellipse { at: sx + 6, s.y - 37; radius: 4.8 * so * (1 - dsh) * if(notes.count > 2, 1, 0); blend: 8 }
            ellipse { at: sx + 4, s.y - 110 + 72 * nfall; radius: 6 * so * if(nfall > 0.02 and nfall < 0.97, 1, 0); scale: 0.85, 1.25; blend: 10 }
            ellipse { at: px, p.y; radius: (19 + 4 * hp) * so * (1 - smooth(0, 0.12, pm)); scale: 1 + squish.p * 0.08, 1 - squish.p * 0.12; blend: link * so }
            line { from: px, p.y - 4; to: sx, s.y - 6; width: thread.ps * (1 - max(dsh, pm)); blend: 12 * clamp(thread.ps * (1 - max(dsh, pm)) / 3, 0, 1) }
            line { from: sx + 8, s.y - 12; to: bl + 18, bottom - 14; width: thread.sb * ap * (1 - dsh); blend: 14 * clamp(thread.sb * ap * (1 - dsh) / 3, 0, 1) }
            ellipse { at: drip.x, drip.y; radius: drip.r * so; blend: 8 }
        }
        // obraz režimu okien v hlave (30. 9., návrh používateľa): akoby cez kvapku presvitali okná — páska (pás
        // okolo valca, boky skrátené), plávajúce (nad sebou), dlaždice. Pri prepnutí sa okienka prelejú do nového
        // usporiadania; myš nad hlavou obraz zvýrazní (ľavý klik režim prepne)
        group {
            opacity: (26% + 34% * hh) * ap * (1 - o.pull)
            box { at: hx + (wp * -22 + wf * -7 + wd * -9) / ws + 1.5 * noise(0.3, time * 0.2), mid - 8 + (wp * 1 + wf * -7 + wd * 0) / ws; size: (wp * 11 + wf * 26 + wd * 17) / ws, (wp * 20 + wf * 19 + wd * 34) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 0.6 + wd * 1) / ws }
            box { at: hx + (wp * 0 + wf * 0 + wd * 10) / ws + 1.5 * noise(1.3, time * 0.2), mid - 8 + (wp * 0 + wf * 0 + wd * -9) / ws; size: (wp * 24 + wf * 26 + wd * 18) / ws, (wp * 30 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 1 + wf * 0.8 + wd * 0.8) / ws }
            box { at: hx + (wp * 22 + wf * 7 + wd * 10) / ws + 1.5 * noise(2.3, time * 0.2), mid - 8 + (wp * 1 + wf * 7 + wd * 9) / ws; size: (wp * 11 + wf * 26 + wd * 18) / ws, (wp * 20 + wf * 19 + wd * 16) / ws; corner: 4; color: ink; opacity: (wp * 0.55 + wf * 1 + wd * 0.8) / ws }
        }
        // odlesk: každá guľa odráža svetlo sama (bodka hore vľavo), hlava najväčšiu
        group {
            blur: 1.5
            opacity: 70% * ap
            ellipse { at: hx - 14, mid - 32; radius: 4; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
            repeat k in 0..48 {
                // stred guľôčky a vzdialenosť kurzora (aktívne svetlo)
                let qx = lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)
                let qy = mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)
                let qd = length(cu - qx, cv - qy)
                ellipse { at: qx - ur.$k * 0.4, qy - ur.$k * 0.52; radius: 0.11 * ur.$k * b.$k; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
                // aktívne svetlo: odlesk na strane ku kurzoru, bližšie = jasnejší
                ellipse { at: qx + (cu - qx) / max(qd, 1) * ur.$k * 0.55, qy + (cv - qy) / max(qd, 1) * ur.$k * 0.55; radius: 0.13 * ur.$k * b.$k * (1 - smooth(50, 360, qd)); color: #ffe4bd }
            }
            // hlava a Hodiny: to isté
            ellipse { at: hx + (cu - hx) / max(length(cu - hx, cv - mid + 8), 1) * 22, mid - 8 + (cv - mid + 8) / max(length(cu - hx, cv - mid + 8), 1) * 22; radius: 5 * (1 - smooth(60, 420, length(cu - hx, cv - mid + 8))); color: #ffe4bd }
            ellipse { at: sx + (cu - sx) / max(length(cu - sx, cv - s.y), 1) * 20, s.y + (cv - s.y) / max(length(cu - sx, cv - s.y), 1) * 20; radius: 4.5 * so * (1 - smooth(0, 0.12, dsh)) * (1 - smooth(60, 420, length(cu - sx, cv - s.y))); color: #ffe4bd }
        }
        // farba upozornení podľa naliehavosti (nízka mätová, bežná jantárová, kritická červená)
        ellipse { at: sx - 25, s.y - 23; radius: 3.8 * so * (1 - dsh) * if(notes.count > 0, 1, 0); color: pick(notes.0.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx - 10, s.y - 34; radius: 3.2 * so * (1 - dsh) * if(notes.count > 1, 1, 0); color: pick(notes.1.urgency, #9ed6bd, #e4b283, #e07a5f) }
        ellipse { at: sx + 6, s.y - 37; radius: 2.8 * so * (1 - dsh) * if(notes.count > 2, 1, 0); color: pick(notes.2.urgency, #9ed6bd, #e4b283, #e07a5f) }
        // základňa kvapky: telo (0) a hlava (1) — ľavý klik = režim okien, ťahanie ľavým aj pravým = presun,
        // koliesko = okná, pravý klik nič. Hrbolčeky s oknami (icon_hit) majú vlastné kliky a ležia navrchu.
        repeat z in 0..2 {
            zone box base.$z { at: if(z == 0, bl + w / 2, hx), if(z == 0, mid, by - 4); size: if(z == 0, w, 66), if(z == 0, h, 66); corner: if(z == 0, c, 33); cursor: pointer }
        }
        zone ellipse start_hit { at: sx, s.y; radius: 34; cursor: pointer; active: solo }
        zone ellipse power_hit { at: px, p.y; radius: 19; cursor: pointer; active: solo }
        repeat k in 0..48 {
            zone box icon_hit.$k { at: (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)); size: ur.$k * 2, ur.$k * 2; corner: ur.$k; cursor: pointer; active: k < n and not free }
        }
    }

    // odtrhnutá kvapka: za myšou; pri stekaní padá (smerom dole na obrazovke), naťahuje sa, zmenšuje a kvapká
    body {
        color: coffee
        light: 16%, gy - gh / 2 - 10, 30
        rim: 30%
        shadow: 0, 8, 18, 40%
        opacity: if(free, 1, 0) * (1 - 0.42 * v * (1 - m))
        box { at: gx, gy + 150 * fall; size: gw * (1 - 0.7 * fall), gh * (1 + 0.5 * fall) * (1 - 0.8 * fall); corner: min(gw, gh) / 2 * (1 - 0.7 * fall) }
        ellipse { at: gx - 12, gy + gh * 0.4 + 210 * fall * fall; radius: 9 * fall * (1 - fall) * 4; blend: 10 }
        ellipse { at: gx + 16, gy + gh * 0.3 + 260 * fall * fall; radius: 6 * fall * (1 - fall) * 4; blend: 8 }
    }

    // ikony stoja rovno: bod rámca (u, v) → obrazovka podľa okraja; veľkosť podľa guľôčky
    repeat k in 0..48 {
        image icon.$k { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0))) - ur.$k * 0.52, pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)), (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))) - ur.$k * 0.52; size: ur.$k * 1.04, ur.$k * 1.04; opacity: b.$k * ap * (1 - 0.55 * dm.$k); show: k < n }
        box { at: pick(side, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), W - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, W - edge + (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76), pick(side, (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) + ur.$k * 0.76 + H - edge, edge - (mid + uy.$k + 2.5 * noise(5 + k * 1.3, time * 0.3) + if(bdrag == k, bdy, 0)) - ur.$k * 0.76, (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0)), H - (lx + ux.$k + 2 * noise(k * 0.7, time * 0.35) + if(bdrag == k, bdx, 0))); size: if(side == vlavo or side == vpravo, 3, 12), if(side == vlavo or side == vpravo, 12, 3); corner: 1.5; color: ink; opacity: ap; show: k < n and wins.$k.active }
    }

    image power_icon = icon "system-shutdown-symbolic", 18, 18
    image qs_wifi_i = icon "network-wireless-symbolic", 20, 20
    image qs_bt_i = icon "bluetooth-active-symbolic", 20, 20
    image qs_snd_i = icon "audio-volume-high-symbolic", 20, 20
    image qs_more_i = icon "emblem-system-symbolic", 20, 20
    // Hodiny: čas a dátum stoja rovno v kvapke (bod rámca → obrazovka)
    let cxs = pick(side, sx, W - sx, edge - s.y, W - edge + s.y)
    let cys = pick(side, s.y + H - edge, edge - s.y, sx, H - sx)
    // bublina nového upozornenia: vyleje sa z Hodín smerom od okraja (v obrazovke, text rovno), 6 s
    let vert = if(side == vlavo or side == vpravo, 1, 0)
    let away.x = pick(side, 0, 0, 1, -1)
    let away.y = pick(side, -1, 1, 0, 0)
    let tst.x = cxs + if(vert, away.x * (40 + 170 * toast.p), 170 * toast.p)
    let tst.y = cys + if(vert, 0, away.y * (58 * toast.p))
    body {
        color: coffee
        rim: 30%
        shadow: 0, 6, 16, 30% * toast.p
        opacity: clamp(toast.p * 3, 0, 1) * so
        ellipse { at: cxs, cys; radius: 33 }
        box { at: tst.x, tst.y; size: 40 + 300 * toast.p, 30 + 14 * toast.p; corner: 22; blend: 22 }
    }
    text now.time { at: cxs, cys - 5; anchor: center; size: 16; weight: 800; color: ink; opacity: so * ap * (1 - smooth(0, 0.2, dsh)); show: solo }
    text pick(now.weekday, "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat") { at: cxs - 2, cys + 12; anchor: right center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.2, dsh)); show: solo }
    text "{now.day}. {now.month}." { at: cxs + 1, cys + 12; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 70% * so * ap * (1 - smooth(0, 0.2, dsh)); show: solo }

    text toast { at: tst.x - 135, tst.y; anchor: left center; width: 270; lines: 1; size: 12.5; weight: 600; color: ink; opacity: clamp(toast.p * 2 - 1, 0, 1) * so; show: solo }

    // ── dashboard (vyteká z Hodín smerom od okraja; v obrazovke, text rovno) ──
    let dw = 560
    let dh = 520
    let dt.x = if(vert, cxs + away.x * (40 + dw / 2), clamp(cxs + 190, dw / 2 + 12, W - dw / 2 - 12))
    let dt.y = if(vert, clamp(cys, dh / 2 + 12, H - dh / 2 - 12), cys + away.y * (40 + dh / 2))
    // kvapka Hodín sa odlepí od lišty, dopláva do rohu dashboardu (bod karty najbližší Hodinám) a karta z nej
    // vyrastie — ako v Marei, kde sa kvapka stane rohom okna; na lište po nej ostane iba mláka
    let dk.x = clamp(cxs, dt.x - dw / 2 + 34, dt.x + dw / 2 - 34)
    let dk.y = clamp(cys, dt.y - dh / 2 + 34, dt.y + dh / 2 - 34)
    let d.swim = smooth(0, 0.45, dsh)
    let d.grow = smooth(0.3, 1, dsh)
    let db.x = cxs + (dk.x - cxs) * d.swim
    let db.y = cys + (dk.y - cys) * d.swim
    let dc.x = dk.x + (dt.x - dk.x) * d.grow
    let dc.y = dk.y + (dt.y - dk.y) * d.grow
    let d0.x = dt.x - dw / 2 + 28              // obsah: ľavý horný roh
    let d0.y = dt.y - dh / 2 + 24
    let dshow = clamp(dsh * 2 - 1, 0, 1)
    body {
        color: coffee
        light: 10%, dc.y - dh / 2, 60
        rim: 30%
        shadow: 0, 10, 30, 40% * dsh
        opacity: if(dsh > 0.01, 1, 0) * so
        ellipse { at: db.x, db.y; radius: 34 * if(d.grow > 0.02, 0, 1) }
        box { at: if(d.grow > 0.02, dc.x, db.x), if(d.grow > 0.02, dc.y, db.y); size: 68 + (dw - 68) * d.grow, 68 + (dh - 68) * d.grow; corner: 34 - 6 * d.grow }
    }
    group {
        opacity: dshow
        show: dsh > 0.5
        text now.time { at: d0.x, d0.y + 22; anchor: left center; size: 44; weight: 800; family: "Fraunces"; color: ink }
        text pick(now.weekday, "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday") { at: d0.x, d0.y + 62; anchor: left center; size: 14; weight: 600; color: ink; opacity: 75%; measure: wday }
        text "{now.day}. {now.month}. {now.year}" { at: d0.x + wday.width + 10, d0.y + 62; anchor: left center; size: 14; weight: 600; color: ink; opacity: 75% }
        text weather { at: d0.x + dw - 56, d0.y + 22; anchor: right center; size: 14; weight: 600; color: ink; opacity: 85% }
        // hľadanie (úloha Štartu): píše sa hneď po otvorení
        box { at: d0.x + (dw - 56) / 2, d0.y + 106; size: dw - 56, 40; corner: 20; color: #000000; opacity: 30% }
        input query { at: d0.x + 18, d0.y + 106; width: dw - 92; size: 14; color: ink; placeholder: "Search apps…"; selection: #6b4a33 }
        // výsledky hľadania
        repeat k in 0..6 {
            box { at: d0.x + (dw - 56) / 2, d0.y + 150 + k * 40; size: dw - 56, 36; corner: 12; color: #ffffff; opacity: if(k == sel, 10%, 0); show: typing and k < results.count }
            image results.$k.icon { at: d0.x + 12, d0.y + 137 + k * 40; size: 26, 26; show: typing and k < results.count }
            text results.$k.name { at: d0.x + 48, d0.y + 150 + k * 40; anchor: left center; size: 13.5; color: ink; show: typing and k < results.count }
        }
        text "Nothing found" { at: d0.x, d0.y + 150; anchor: left center; size: 13; color: ink; opacity: 60%; show: typing and results.count < 1 }
        // bez hľadania: upozornenia a pripnuté
        text "NOTIFICATIONS" { at: d0.x, d0.y + 150; anchor: left center; size: 10.5; weight: 800; color: #e4b283; show: not typing and page == 0 }
        text "Clear all" { at: d0.x + dw - 56, d0.y + 150; anchor: right center; size: 11; weight: 700; color: ink; opacity: 70%; show: not typing and page == 0 and notes.count > 0 }
        text "No notifications" { at: d0.x, d0.y + 180; anchor: left center; size: 13; color: ink; opacity: 55%; show: not typing and page == 0 and notes.count < 1 }
        repeat k in 0..4 {
            ellipse { at: d0.x + 6, d0.y + 180 + k * 30; radius: 4; color: pick(notes.$k.urgency, #9ed6bd, #e4b283, #e07a5f); show: not typing and page == 0 and k < notes.count }
            text "{notes.$k.app} · {notes.$k.title}" { at: d0.x + 20, d0.y + 180 + k * 30; anchor: left center; width: dw - 90; lines: 1; size: 13; color: ink; show: not typing and page == 0 and k < notes.count }
        }
        text "PINNED" { at: d0.x, d0.y + 316; anchor: left center; size: 10.5; weight: 800; color: #e4b283; show: not typing and page == 0 }
        repeat k in 0..6 {
            image pins.$k.icon { at: d0.x + k * 84 + 12, d0.y + 334; size: 36, 36; show: not typing and page == 0 and k < pins.count }
            text pins.$k.name { at: d0.x + k * 84 + 30, d0.y + 386; anchor: center; width: 80; lines: 1; size: 10.5; color: ink; opacity: 80%; show: not typing and page == 0 and k < pins.count }
        }
        // rýchle nastavenia (previazané s Noctaliou)
        line { from: d0.x, d0.y + 410; to: d0.x + dw - 56, d0.y + 410; width: 1; color: ink; opacity: 12% }
        ellipse { at: d0.x + 22, d0.y + 446; radius: 22 + 2 * qsh.0; color: if(net.wifi, #e4b283, #3a2618) }
        ellipse { at: d0.x + 86, d0.y + 446; radius: 22 + 2 * qsh.1; color: if(bt.powered, #e4b283, #3a2618); show: bt.present }
        ellipse { at: d0.x + 150, d0.y + 446; radius: 22 + 2 * qsh.2; color: if(snd.muted, #3a2618, #e4b283) }
        ellipse { at: d0.x + 214, d0.y + 446; radius: 22 + 2 * qsh.3; color: #3a2618 }
        image qs_wifi_i { at: d0.x + 12, d0.y + 436; size: 20, 20; tint: if(net.wifi, #2a170c, cream) }
        image qs_bt_i { at: d0.x + 76, d0.y + 436; size: 20, 20; tint: if(bt.powered, #2a170c, cream); show: bt.present }
        image qs_snd_i { at: d0.x + 140, d0.y + 436; size: 20, 20; tint: if(snd.muted, cream, #2a170c) }
        image qs_more_i { at: d0.x + 204, d0.y + 436; size: 20, 20; tint: cream }
        text "Network ›" { at: d0.x + 22, d0.y + 482; anchor: center; size: 10; color: ink; opacity: if(page == 1, 100%, 75%) }
        text "Bluetooth ›" { at: d0.x + 86, d0.y + 482; anchor: center; size: 10; color: ink; opacity: if(page == 2, 100%, 75%); show: bt.present }
        text "Sound ›" { at: d0.x + 150, d0.y + 482; anchor: center; size: 10; color: ink; opacity: if(page == 3, 100%, 75%) }
        text "Settings" { at: d0.x + 214, d0.y + 482; anchor: center; size: 10; color: ink; opacity: 75% }
        // stránka (sieť / bluetooth / zvuk): zoznam namiesto upozornení a pripnutých
        text pick(page, "", "NETWORK", "BLUETOOTH", "SOUND OUTPUT") { at: d0.x + 26, d0.y + 150; anchor: left center; size: 10.5; weight: 800; color: #e4b283; show: not typing and page > 0 }
        text "‹" { at: d0.x + 4, d0.y + 149; anchor: left center; size: 17; weight: 800; color: ink; show: not typing and page > 0 }
        text "Nothing here" { at: d0.x, d0.y + 184; anchor: left center; size: 13; color: ink; opacity: 55%; show: not typing and ((page == 1 and nets.count < 1 and not net.online) or (page == 2 and bts.count < 1) or (page == 3 and outs.count < 1)) }
        text "Connected by cable" { at: d0.x, d0.y + 184; anchor: left center; size: 13; weight: 600; color: ink; show: not typing and page == 1 and nets.count < 1 and net.online }
        repeat k in 0..7 {
            box { at: d0.x + (dw - 56) / 2, d0.y + 184 + k * 34; size: dw - 56, 30; corner: 10; color: #ffffff; opacity: if(pg_hot == k, 10%, 0); show: not typing and page > 0 and k < pick(page, 0, nets.count, bts.count, outs.count) }
            // sieť: sila (štyri paličky), meno, zámok, pripojená
            box { at: d0.x + 8, d0.y + 190 + k * 34; size: 3, 5; color: ink; opacity: if(nets.$k.strength > 10, 90%, 25%); show: not typing and page == 1 and k < nets.count }
            box { at: d0.x + 13, d0.y + 188 + k * 34; size: 3, 9; color: ink; opacity: if(nets.$k.strength > 35, 90%, 25%); show: not typing and page == 1 and k < nets.count }
            box { at: d0.x + 18, d0.y + 186 + k * 34; size: 3, 13; color: ink; opacity: if(nets.$k.strength > 60, 90%, 25%); show: not typing and page == 1 and k < nets.count }
            box { at: d0.x + 23, d0.y + 184 + k * 34; size: 3, 17; color: ink; opacity: if(nets.$k.strength > 80, 90%, 25%); show: not typing and page == 1 and k < nets.count }
            text nets.$k.ssid { at: d0.x + 36, d0.y + 184 + k * 34; anchor: left center; width: dw - 220; lines: 1; size: 13; weight: 600; color: ink; show: not typing and page == 1 and k < nets.count }
            text pick(if(nets.$k.active, 2, if(nets.$k.known, 1, 0)), "", "Saved", "Connected") { at: d0.x + dw - 70, d0.y + 184 + k * 34; anchor: right center; size: 11; color: #e4b283; show: not typing and page == 1 and k < nets.count }
            // bluetooth: meno, stav
            text bts.$k.name { at: d0.x + 10, d0.y + 184 + k * 34; anchor: left center; width: dw - 200; lines: 1; size: 13; weight: 600; color: ink; show: not typing and page == 2 and k < bts.count }
            text pick(if(bts.$k.connected, 2, if(bts.$k.paired, 1, 0)), "", "Paired", "Connected") { at: d0.x + dw - 70, d0.y + 184 + k * 34; anchor: right center; size: 11; color: #e4b283; show: not typing and page == 2 and k < bts.count }
            // zvuk: výstupy, predvolený označený
            ellipse { at: d0.x + 12, d0.y + 184 + k * 34; radius: 5; color: if(outs.$k.default, #e4b283, #3a2618); show: not typing and page == 3 and k < outs.count }
            text outs.$k.name { at: d0.x + 28, d0.y + 184 + k * 34; anchor: left center; width: dw - 110; lines: 1; size: 13; weight: 600; color: ink; show: not typing and page == 3 and k < outs.count }
        }
        // hlasitosť: ťahanie po lište
        box { from: d0.x + 262, d0.y + 443; size: dw - 56 - 262, 6; corner: 3; color: ink; opacity: 20% }
        box { from: d0.x + 262, d0.y + 443; size: (dw - 56 - 262) * clamp(snd.volume, 0, 1), 6; corner: 3; color: #e4b283 }
        ellipse { at: d0.x + 262 + (dw - 56 - 262) * clamp(snd.volume, 0, 1), d0.y + 446; radius: 9; color: cream }
    }
    // dashboard: klikateľné miesta (navrchu)
    zone box dash_card { at: dt.x, dt.y; size: dw, dh; active: dash }
    repeat k in 0..6 {
        zone box res_hit.$k { at: d0.x + (dw - 56) / 2, d0.y + 150 + k * 40; size: dw - 56, 36; cursor: pointer; active: dash and typing and k < results.count }
        zone box pin_hit.$k { at: d0.x + k * 84 + 30, d0.y + 360; size: 76, 76; cursor: pointer; active: dash and not typing and page == 0 and k < pins.count }
    }
    repeat k in 0..4 {
        zone box note_hit.$k { at: d0.x + (dw - 56) / 2, d0.y + 180 + k * 30; size: dw - 56, 28; cursor: pointer; active: dash and not typing and page == 0 and k < notes.count }
    }
    zone ellipse qs_wifi_hit { at: d0.x + 22, d0.y + 446; radius: 22; cursor: pointer; active: dash }
    zone ellipse qs_bt_hit { at: d0.x + 86, d0.y + 446; radius: 22; cursor: pointer; active: dash and bt.present }
    zone ellipse qs_snd_hit { at: d0.x + 150, d0.y + 446; radius: 22; cursor: pointer; active: dash }
    zone box pg_open.1 { at: d0.x + 22, d0.y + 482; size: 60, 18; cursor: pointer; active: dash }
    zone box pg_open.2 { at: d0.x + 86, d0.y + 482; size: 64, 18; cursor: pointer; active: dash and bt.present }
    zone box pg_open.3 { at: d0.x + 150, d0.y + 482; size: 60, 18; cursor: pointer; active: dash }
    zone box pg_back { at: d0.x + 60, d0.y + 150; size: 130, 26; cursor: pointer; active: dash and page > 0 and not typing }
    repeat k in 0..7 {
        zone box pg_row.$k { at: d0.x + (dw - 56) / 2, d0.y + 184 + k * 34; size: dw - 56, 30; cursor: pointer; active: dash and not typing and page > 0 and k < pick(page, 0, nets.count, bts.count, outs.count) }
    }
    zone ellipse qs_more_hit { at: d0.x + 214, d0.y + 446; radius: 22; cursor: pointer; active: dash }
    zone box qs_vol_hit { from: d0.x + 254, d0.y + 430; size: dw - 56 - 246, 32; cursor: pointer; active: dash }
    zone box clear_hit { at: d0.x + dw - 90, d0.y + 150; size: 90, 24; cursor: pointer; active: dash and not typing and page == 0 and notes.count > 0 }

    // ── ponuka Vypnúť (vyteká z kvapky vypínača smerom od okraja) ──
    let pxs = pick(side, px, W - px, edge - p.y, W - edge + p.y)
    let pys = pick(side, p.y + H - edge, edge - p.y, px, H - px)
    let pw = 230
    let ph = 5 * 42 + 22
    let pt.x = if(vert, pxs + away.x * (30 + pw / 2), clamp(pxs + pw / 2 - 34, pw / 2 + 12, W - pw / 2 - 12))
    let pt.y = if(vert, clamp(pys, ph / 2 + 12, H - ph / 2 - 12), pys + away.y * (30 + ph / 2))
    let pk.x = clamp(pxs, pt.x - pw / 2 + 20, pt.x + pw / 2 - 20)
    let pk.y = clamp(pys, pt.y - ph / 2 + 20, pt.y + ph / 2 - 20)
    let p.swim = smooth(0, 0.45, pm)
    let p.grow = smooth(0.3, 1, pm)
    let pb.x = pxs + (pk.x - pxs) * p.swim
    let pb.y = pys + (pk.y - pys) * p.swim
    let pc.x = pk.x + (pt.x - pk.x) * p.grow
    let pc.y = pk.y + (pt.y - pk.y) * p.grow
    let p0.y = pt.y - ph / 2 + 11
    body {
        color: coffee
        rim: 30%
        shadow: 0, 10, 26, 40% * pm
        opacity: if(pm > 0.01, 1, 0) * so
        ellipse { at: pb.x, pb.y; radius: 20 * if(p.grow > 0.02, 0, 1) }
        box { at: if(p.grow > 0.02, pc.x, pb.x), if(p.grow > 0.02, pc.y, pb.y); size: 40 + (pw - 40) * p.grow, 40 + (ph - 40) * p.grow; corner: 20 - 4 * p.grow }
    }
    // riadky ponuky ako kapsuly zliate do tekutého stĺpca; riadok pod myšou sa vydutí
    body {
        color: mix(coffee, #f3ebdd, 0.08)
        rim: 25%
        opacity: clamp(pm * 2 - 1, 0, 1) * so
        box { at: pt.x + 4 * pmh.0, p0.y + 21 + 0 * 42; size: pw - 30 + 10 * pmh.0, 35 + 5 * pmh.0; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.1, p0.y + 21 + 1 * 42; size: pw - 30 + 10 * pmh.1, 35 + 5 * pmh.1; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.2, p0.y + 21 + 2 * 42; size: pw - 30 + 10 * pmh.2, 35 + 5 * pmh.2; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.3, p0.y + 21 + 3 * 42; size: pw - 30 + 10 * pmh.3, 35 + 5 * pmh.3; corner: 18; blend: 16 }
        box { at: pt.x + 4 * pmh.4, p0.y + 21 + 4 * 42; size: pw - 30 + 10 * pmh.4, 35 + 5 * pmh.4; corner: 18; blend: 16 }
    }
    image pm_i.0 = icon "system-lock-screen-symbolic", 18, 18
    image pm_i.1 = icon "system-log-out-symbolic", 18, 18
    image pm_i.2 = icon "weather-clear-night-symbolic", 18, 18
    image pm_i.3 = icon "system-reboot-symbolic", 18, 18
    image pm_i.4 = icon "system-shutdown-symbolic", 18, 18
    group {
        opacity: clamp(pm * 2 - 1, 0, 1)
        show: pm > 0.5
        repeat k in 0..5 {
            image pm_i.$k { at: pt.x - pw / 2 + 20, p0.y + 12 + k * 42; size: 18, 18; tint: if(k == 4, #e07a5f, ink) }
            text pick(k, "Lock", "Sign out", "Sleep", "Restart", "Shut down") { at: pt.x - pw / 2 + 50, p0.y + 21 + k * 42; anchor: left center; size: 13.5; weight: 600; color: ink }
        }
    }
    repeat k in 0..5 {
        zone box pm_hit.$k { at: pt.x, p0.y + 21 + k * 42; size: pw - 16, 38; cursor: pointer; active: pmenu }
    }
    image power_icon { at: pick(side, px, W - px, edge - p.y, W - edge + p.y) - 8, pick(side, p.y + H - edge, edge - p.y, px, H - px) - 8; size: 16, 16; tint: ink; opacity: so * (0.4 + 0.6 * lift.p) * ap * (1 - smooth(0, 0.2, pm)); show: solo }

    text pick(mode, "Floating windows", "Tiles", "Endless strip") { at: pick(side, lx - 30, W - lx - 30, edge - by + 40, W - edge + by - 150), pick(side, by - 56 + H - edge, edge - by + 56, lx - 60, H - lx - 60); anchor: left center; size: 12; weight: 700; color: ink; opacity: 70% * out * ap * if(tight or dash or pmenu, 0, 1) }

    // základňa: vlastné menu nemá. Ľavý klik (bez ťahania) prepne režim okien. Chytiť ľavým alebo pravým a ťahať
    // od okraja: stopka sa naťahuje (pull), pri 0,9 praskne a kvapka ide za myšou; pustená pri okraji (do 170 px)
    // sa k nemu prilepí, inde steká a vynorí sa, kde bola. Pustená skôr, než stopka praskne: vráti sa.
    // Ťahanie, ktoré začalo na hrbolčeku s oknom (icon_press), kvapku nepresúva.
    repeat z in 0..2 {
        // (30. 9.) režim prepína iba hlava (v nej je obraz režimu): klik vedľa guľôčky na telo pásku prepol na dlaždice
        // (30. 9.) pravý klik na goo nerobí nič — okrem guľôčok okien (ponuka okna), ako na paneli úloh vo Windows
        on press base.$z { lpress = z == 1; ldrag = true; squish: 1 }
        on press right base.$z { lpress = false; ldrag = false }
        on drag base.$z while ldrag and not free and not icon_press { pull: clamp(pick(side, 0 - drag.dy, drag.dy, drag.dx, 0 - drag.dx) / 90, -1, 1) ~0ms }
        on drag base.$z while ldrag and not free and not icon_press and abs(drag.dx) + abs(drag.dy) > 6 { pulling = true }
        on drag base.$z while ldrag and free { gx: pointer.x; gy: pointer.y }
        on release base.$z while not free and not pulling and lpress { emit cycle; squish.s: 0.5 after 70ms; squish.p: 0.35 after 140ms }
        on release base.$z while not free { pulling = false; pull: 0; squish: 0; squish.s: 0 after 140ms; squish.p: 0 after 210ms }
        on release base.$z while free and near.edge < 170 and near.edge == H - cursor.y { side = dole; pos = clamp(cursor.x / W, 0.1, 0.6); gx: cursor.x; gy: H; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.y { side = hore; pos = clamp((W - cursor.x) / W, 0.1, 0.6); gx: cursor.x; gy: 0; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == cursor.x { side = vlavo; pos = clamp(cursor.y / H, 0.1, 0.6); gx: 0; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge < 170 and near.edge == W - cursor.x { side = vpravo; pos = clamp((H - cursor.y) / H, 0.1, 0.6); gx: W; gy: cursor.y; dockt: 1 }
        on release base.$z while free and near.edge >= 170 { melting = true }
        on release base.$z while free { pulling = false; pull: 0; squish: 0 }
        // koliesko nad kvapkou (aj nad hrbolčekmi): páska = posun, plávajúce = ďalšie okno
        on scroll base.$z { emit wheel_turn(wheel) }
    }
    on change out > 0.9 while out > 0.9 and pulling and not free { free = true; ap: 0 ~0ms; gx: cursor.x ~0ms; gy: cursor.y ~0ms; gw: w ~0ms; gh: h ~0ms; gw: 90 after 30ms; gh: 90 after 30ms; fall: 0 ~0ms }
    on change melting while melting { fall: 1 }
    // prilepenie: kvapka dobehne k okraju, potom sa lišta vynorí z okraja na novom mieste
    on change dockt > 0.95 while dockt > 0.95 { free = false; dockt: 0 ~0ms; ap: 1; emit side_moved }
    // stečenie: po páde sa lišta vynorí na starom mieste
    on change fall > 0.95 while fall > 0.95 and melting { free = false; melting = false; fall: 0 ~0ms; ap: 1 }
    // stlačenie prebehne vlnou cez susedov (vypínač → Štart → hlava a naopak)
    on press start_hit while panel_noc { emit noc_panel }
    on press start_hit while not panel_noc { toggle dash }
    on press start_hit { squish.s: 1; squish.p: 0.5 after 70ms; squish: 0.4 after 70ms }
    on release start_hit { squish.s: 0; squish.p: 0 after 70ms; squish: 0 after 70ms }
    on press power_hit { toggle pmenu; dash = false; squish.p: 1; squish.s: 0.5 after 70ms; squish: 0.3 after 140ms }
    on change dash while dash { pmenu = false }
    repeat k in 0..5 {
        on press pm_hit.$k { emit power_do(k) }
        on enter pm_hit.$k { pm_hot = k }
        on leave pm_hit.$k { pm_hot = -1 }
    }
    on release power_hit { squish.p: 0; squish.s: 0 after 70ms; squish: 0 after 140ms }
    // dashboard: otvorenie dá kurzor do hľadania; Esc alebo klik mimo zavrie; ↑↓ a Enter vo výsledkoch
    on change dash while dash { focus query }
    on press dash_away { dash = false; pmenu = false }
    on key Escape while dash { dash = false }
    on key Down while dash { sel = min(sel + 1, max(results.count - 1, 0)) }
    on key Up while dash { sel = max(sel - 1, 0) }
    on submit query { emit open_result(sel) }
    repeat k in 0..6 {
        on press res_hit.$k { emit open_result(k) }
        on press pin_hit.$k { emit pin_open(k) }
    }
    repeat k in 0..4 {
        on press note_hit.$k { emit note_open(k) }
    }
    on press clear_hit { emit notes_clear }
    on dash_toggle while panel_noc { emit noc_panel }
    on dash_toggle while not panel_noc { toggle dash }
    on press qs_wifi_hit { emit qs_wifi }
    on enter qs_wifi_hit { qsh.0: 1 }
    on leave qs_wifi_hit { qsh.0: 0 }
    on enter qs_bt_hit { qsh.1: 1 }
    on leave qs_bt_hit { qsh.1: 0 }
    on enter qs_snd_hit { qsh.2: 1 }
    on leave qs_snd_hit { qsh.2: 0 }
    on enter qs_more_hit { qsh.3: 1 }
    on leave qs_more_hit { qsh.3: 0 }
    on press qs_bt_hit { emit qs_bt }
    on press qs_snd_hit { emit qs_mute }
    on press qs_more_hit { emit qs_more }
    on press pg_open.1 { page = if(page == 1, 0, 1) }
    on press pg_open.2 { page = if(page == 2, 0, 2) }
    on press pg_open.3 { page = if(page == 3, 0, 3) }
    on press pg_back { page = 0 }
    on change dash while not dash { page = 0 }
    repeat k in 0..7 {
        on press pg_row.$k { emit pg_pick(k) }
        on enter pg_row.$k { pg_hot = k }
        on leave pg_row.$k { pg_hot = -1 }
    }
    on press qs_vol_hit { emit qs_vol(clamp((local.x - 8) / (dw - 56 - 262), 0, 1)) }
    on drag qs_vol_hit { emit qs_vol(clamp((local.x - 8) / (dw - 56 - 262), 0, 1)) }
    on enter start_hit { hs: 1 }
    on leave start_hit { hs: 0 }
    on enter power_hit { hp: 1 }
    on leave power_hit { hp: 0 }
    on enter base.1 { hh: 1 }
    on leave base.1 { hh: 0 }
    // hrbolček s oknom: ľavý klik = prepnúť naň (aktívne okno sa minimalizuje, ako vo Windows),
    // pravý klik = ponuka okna
    repeat k in 0..48 {
        on press icon_hit.$k { icon_press = true; bdrag = k; bmoved = false }
        on drag icon_hit.$k while bdrag == k { bdx: pick(side, drag.dx, 0 - drag.dx, drag.dy, 0 - drag.dy) ~0ms; bdy: pick(side, drag.dy, 0 - drag.dy, 0 - drag.dx, drag.dx) ~0ms }
        on drag icon_hit.$k while bdrag == k and abs(drag.dx) + abs(drag.dy) > 8 { bmoved = true }
        on release icon_hit.$k while not bmoved { emit pick(k) }
        on release icon_hit.$k while bmoved { emit bead_drop(k) }
        on enter icon_hit.$k { emit hover(k) }
        on leave icon_hit.$k { emit unhover(k) }
        on press right icon_hit.$k { icon_press = true; bdrag = -1; menu.x = cursor.x; menu.y = cursor.y; emit win_menu(k) }
        on release icon_hit.$k { icon_press = false; bdx: 0; bdy: 0; impulse wob 40 }
    }

    translations sk {
        "Search apps…" = "Hľadať aplikácie…"
        "Nothing found" = "Nič sa nenašlo"
        "NOTIFICATIONS" = "UPOZORNENIA"
        "Clear all" = "Vymazať všetko"
        "No notifications" = "Žiadne upozornenia"
        "PINNED" = "PRIPNUTÉ"
        "Network" = "Sieť"
        "Lock" = "Zamknúť"
        "Sign out" = "Odhlásiť sa"
        "Sleep" = "Uspať"
        "Restart" = "Reštartovať"
        "Shut down" = "Vypnúť"
        "Sound" = "Zvuk"
        "Bluetooth" = "Bluetooth"
        "Network ›" = "Sieť ›"
        "Bluetooth ›" = "Bluetooth ›"
        "Sound ›" = "Zvuk ›"
        "Settings" = "Nastavenia"
        "NETWORK" = "SIEŤ"
        "BLUETOOTH" = "BLUETOOTH"
        "SOUND OUTPUT" = "VÝSTUP ZVUKU"
        "Nothing here" = "Nič tu nie je"
        "Connected by cable" = "Pripojené káblom"
        "Saved" = "Uložená"
        "Connected" = "Pripojené"
        "Paired" = "Spárované"
        "Sunday" = "nedeľa"
        "Monday" = "pondelok"
        "Tuesday" = "utorok"
        "Wednesday" = "streda"
        "Thursday" = "štvrtok"
        "Friday" = "piatok"
        "Saturday" = "sobota"
        "Sun" = "ne"
        "Mon" = "po"
        "Tue" = "ut"
        "Wed" = "st"
        "Thu" = "št"
        "Fri" = "pi"
        "Sat" = "so"
        "Floating windows" = "Plávajúce okná"
        "Tiles" = "Dlaždice"
        "Endless strip" = "Nekonečná páska"
    }
}
