// LatteOS — Kvapka: lišta aplikácií ako tekutá kvapka kávy (prototyp, pleamar 0.1).
// Zámerne nesúmerná: hlava (hrbolček bez očí — kvapky nemajú tvár) stojí vždy na ĽAVOM konci, kvapka rastie
// doprava s každým oknom.
// V pokoji je vpitá do spodného okraja obrazovky (skoro rovina). Keď sa k nej myš priblíži na štvrtinu
// výšky obrazovky, začne sa vysúvať a kým k nej myš dôjde, je napoly vonku, na hrubej stopke pod hlavou.
// Odtrhne sa až klikom alebo potiahnutím nahor (stopka sa stenčí a pretrhne); ďalší klik alebo
// potiahnutie nadol ju vráti do okraja. Stopka sa nekreslí zvlášť: okraj („voda“ pod obrazovkou) a
// stĺpik pod hlavou sú roztavené s telom (ako `neck` v Marei, ball-prototype.plm).
// Klik na hlavu prepne režim okien (plávajúce → dlaždice → páska), koliesko nad hlavou: páska = posun,
// plávajúce = ďalšie okno.
// Samostatne (relácia LatteOS Kvapky, bez Noctalie: LATTE_VARIANT=kvapky) pribudnú vľavo od hlavy dve malé
// kvapky, tiež vpité do okraja: Štart (spúšťač App Managera) a vypínač (ponuka Vypnúť). Kvapky na seba pôsobia:
// keď sa vysúvajú, spájajú ich mosty (vypínač ↔ Štart ↔ hlava), nakláňajú sa k susedovi pod myšou,
// stlačenie jednej prebehne vlnou cez susedov a odtrhnutá lišta most k Štartu natiahne, až praskne.
// Koncept: AUDIT-WIN11.md › Kvapky.
language 0.1

scene Kvapka {
    surface {
        size: full, 260
        anchor: bottom
        margin: 0
        level: top
        reserve: -1     // ignorovať vyhradené pásy (lišta Noctalie): okraj kvapky je skutočný okraj obrazovky
        rate: 60        // pokojný pohyb kvapky nepotrebuje 144 Hz: 12 % → 6 % jadra na RX 640
    }
    permissions { services: "window", "window.*"; run: "hyprctl", "cat", "printenv", "latte-spustac", "latte-ponuka" }

    // zoznam okien priamo zo služby (wlr-foreign-toplevel), bez logiky; ikona podľa triedy okna
    model wins max 10 { id: text; title: text; class: text; active: bool; minimized: bool }
    service window { list: wins }
    fact mode: plavajuce | dlazdice | paska = plavajuce
    fact detached = false
    fact pulling = false
    fact solo = false                        // bez Noctalie: kvapky Štart a vypínač (logika podľa LATTE_VARIANT)
    event cycle ->
    event pick ->
    event wheel_turn ->
    event start_open ->
    event power_open ->

    let coffee = #1c0f09
    let cream = #f3ebdd
    let edge = 260                           // spodný okraj obrazovky
    let lx = screen.width * 0.4              // hlava: ľavý koniec, pevne (medzi kapsulami Noctalie)
    let bl = lx - 34                         // ľavý okraj tela
    let sx0 = lx - 86                        // kvapka Štart (pokojová poloha)
    let px0 = lx - 146                       // kvapka vypínač
    let n = wins.count
    let step = if(mode == paska, 54, 64)

    prop w = 150 ~lively
    prop h = 78 ~lively
    prop c = 39 ~lively
    follow w = 150 + n * if(mode == paska, 54, if(mode == dlazdice, 34, 64))
    follow h = if(mode == paska, 60, if(mode == dlazdice, 108, 78))
    follow c = if(mode == paska, 20, if(mode == dlazdice, 30, 39))

    // blízkosť myši kdekoľvek na ploche (cursor.x/y: pleamar sa pýta Hyprlandu, žiadna zóna nekradne kliky):
    // od štvrtiny výšky obrazovky (270 px pri 1080) sa kvapka vysúva, pri nej je vonku na 0,55
    let dist.x = max(0, max(if(solo, px0 - 30, bl) - cursor.x, cursor.x - (bl + w)))
    let dist.y = max(0, edge - h * 0.6 - cursor.y)
    let approach = 1 - smooth(0, 270, length(dist.x, dist.y))

    // von z okraja: 0 = vpitá do okraja, 1 = voľná, 48 px nad ním. Bez odskoku, aby stopka nepreskočila
    // späť. Pri vysúvaní drží telo stopka pod hlavou: stĺpik od okraja k telu, roztavený s oboma koncami
    // (preto je v strede tenší), ktorý sa od 0,4 zužuje, až pri 0,9 zmizne — kvapka sa odtrhne.
    fact probe = 0                           // na skúšky: `pleamar --say kvapka "fact probe 75"` zastaví kvapku na 0,75
    prop pull = 0 ~quick                     // ťahanie myšou: −1 nadol … 1 nahor
    prop out = 0 ~700ms
    follow out = if(probe > 0, probe / 100, if(pulling, clamp(if(detached, 1, 0.55) + pull * 0.45, 0, 1), if(detached, 1, 0.55 * approach)))
    let sink = h * 0.42
    let bottom = edge + sink * (1 - out) - 48 * out
    let by = bottom - h
    let mid = by + h / 2
    let neck = 14 * (1 - out) + 16 * 4 * out * (1 - out)
    let stalk.w = 30 * clamp((0.9 - out) / 0.5, 0, 1)
    let stalk.x = lx + 6
    // „voda“ pod okrajom: v pokoji široká (kvapka sa zlieva s okrajom do roviny), vonku úzka pod hlavou
    let water.w = 40 + (w + 90) * (1 - out) * (1 - out)
    let water.x = stalk.x + (bl + w / 2 - stalk.x) * (1 - out)

    prop wob = 0 ~lively
    prop squish = 0 ~quick
    prop squish.s = 0 ~quick
    prop squish.p = 0 ~quick
    on change detached { impulse wob if(detached, 90, -60) }

    // Štart a vypínač: bez odtrhnutia, iba sa vysunú (pri myši napoly von, ako hlavná kvapka)
    prop so = 0 ~lively
    follow so = if(solo, 1, 0)
    prop lift = 0 ~700ms
    follow lift = approach
    // pôsobenie medzi kvapkami: myš nad kvapkou (hs, hp, hh = Štart, vypínač, hlava) ju nafúkne a susedov
    // k nej nakloní; mosty (link) rastú s vysunutím — v pokoji spája kvapky iba okraj
    prop hs = 0 ~lively
    prop hp = 0 ~lively
    prop hh = 0 ~lively
    // most sa vytvorí, keď je medzera medzi kvapkami menšia ako asi polovica `link` (smooth min v pleamare):
    // pri vysúvaní sa preto kvapky k sebe nakláňajú — Štart k telu, vypínač k Štartu
    let sx = sx0 + 18 * lift + 10 * hh - 9 * hp
    let px = px0 + 12 * lift + 12 * hs
    let hx = lx - 7 * hs
    let s.y = edge + 10 - 36 * lift - 4 * hs
    let p.y = edge + 8 - 26 * lift - 4 * hp
    let link = 10 + 16 * lift
    // goo vlákna: vypínač ↔ Štart a Štart ↔ telo lišty. Hrubnú s priblížením myši; keď sa lišta odtrhne
    // (out → 1), vlákno k nej sa stenčí a pretrhne. Roztavené s oboma koncami (blend), preto uprostred tenšie.
    let thread.ps = 9 * so * smooth(0.3, 0.9, lift)
    let thread.sb = 12 * so * smooth(0.2, 0.8, lift) * clamp((0.97 - out) / 0.3, 0, 1)

    // hrbolček každého okna: pružina 0 → 1, zatvorené okno sa vtiahne späť do kvapky
    repeat k in 0..10 {
        image icon.$k = from wins.$k.class, 30, 30
        prop b.$k = 0 ~lively
        follow b.$k = if(k < n and mode != dlazdice, 1, 0)
    }

    // objem kvapky: svetlo zhora, lem a tieň z pleamaru, navrch odlesk (nižšie)
    group {
        body {
            color: coffee
            light: 16%, by - 40, 34
            rim: 30%
            shadow: 0, 6, 16, 40% * out
            box water { from: water.x - water.w / 2, edge; size: water.w, 70 }
            box { at: bl + w / 2, mid; size: w + wob * 0.12, h * (1 - squish * 0.08) - wob * 0.1; corner: c; blend: neck }
            box stalk { from: stalk.x - stalk.w / 2, bottom - 12; size: stalk.w, edge - bottom + 24; corner: stalk.w / 2; blend: 16 * clamp(stalk.w / 10, 0, 1) }
            ellipse { at: hx, by - 4 - wob * 0.05; radius: 33 + 3 * hh; blend: 22 }
            ellipse { at: bl + w - 22 + noise(time * 0.42 + 7) * 28, mid + noise(time * 0.3) * 6; radius: 27; blend: 22 }
            ellipse { at: bl + 80 + 0 * step, mid; radius: 26 * b.0; blend: 16 }
            ellipse { at: bl + 80 + 1 * step, mid; radius: 26 * b.1; blend: 16 }
            ellipse { at: bl + 80 + 2 * step, mid; radius: 26 * b.2; blend: 16 }
            ellipse { at: bl + 80 + 3 * step, mid; radius: 26 * b.3; blend: 16 }
            ellipse { at: bl + 80 + 4 * step, mid; radius: 26 * b.4; blend: 16 }
            ellipse { at: bl + 80 + 5 * step, mid; radius: 26 * b.5; blend: 16 }
            ellipse { at: bl + 80 + 6 * step, mid; radius: 26 * b.6; blend: 16 }
            ellipse { at: bl + 80 + 7 * step, mid; radius: 26 * b.7; blend: 16 }
            ellipse { at: bl + 80 + 8 * step, mid; radius: 26 * b.8; blend: 16 }
            ellipse { at: bl + 80 + 9 * step, mid; radius: 26 * b.9; blend: 16 }
            // Štart a vypínač: vlastná „voda“ pod okrajom; s hlavou a medzi sebou ich spája most `link`
            box { from: px - 34, edge; size: (sx - px + 68) * so, 70 }
            ellipse { at: sx, s.y; radius: (26 + 5 * hs) * so; scale: 1 + squish.s * 0.08, 1 - squish.s * 0.12; blend: link * so }
            ellipse { at: px, p.y; radius: (19 + 4 * hp) * so; scale: 1 + squish.p * 0.08, 1 - squish.p * 0.12; blend: link * so }
            line { from: px, p.y - 4; to: sx, s.y - 6; width: thread.ps; blend: 12 * clamp(thread.ps / 3, 0, 1) }
            line { from: sx + 8, s.y - 12; to: bl + 18, bottom - 14; width: thread.sb; blend: 14 * clamp(thread.sb / 3, 0, 1) }
        }
    }

    // odlesk: dlhý mäkký pás pozdĺž hornej hrany tela a lesklá bodka na hlave (ako na mokrej kvapke)
    group {
        blur: 3
        opacity: 30%
        ellipse { at: bl + 40 + (w - 40) * 0.5, by + 8; radius: 10; scale: (w - 70) / 20, 0.32; color: #ffffff }
    }
    group {
        blur: 1.5
        opacity: 75%
        ellipse { at: hx + 20, by - 27; radius: 3.2; scale: 1.3, 0.8; rotate: 40deg; color: #fff6ea }
    }

    repeat k in 0..10 {
        image icon.$k { at: bl + 65 + k * step, mid - 15; size: 30, 30; opacity: b.$k; show: k < n and mode != dlazdice }
        box { at: bl + 80 + k * step, mid + 22; size: 14, 3; corner: 1.5; color: cream; show: k < n and wins.$k.active and mode != dlazdice }
    }

    image start_icon = icon "view-app-grid-symbolic", 22, 22
    image power_icon = icon "system-shutdown-symbolic", 18, 18
    image start_icon { at: sx - 11, s.y - 11; size: 22, 22; tint: cream; opacity: so * (0.4 + 0.6 * lift); show: solo }
    image power_icon { at: px - 8, p.y - 8; size: 16, 16; tint: cream; opacity: so * (0.4 + 0.6 * lift); show: solo }

    text pick(mode, "Floating windows", "Tiles", "Endless strip") { at: lx - 30, by - 56; anchor: left center; size: 12; weight: 700; color: cream; opacity: 70% * out }

    zone box body_hit { at: bl + w / 2, mid; size: w, h; corner: c; cursor: pointer }
    zone ellipse start_hit { at: sx, s.y; radius: 26; cursor: pointer; active: solo }
    zone ellipse power_hit { at: px, p.y; radius: 19; cursor: pointer; active: solo }
    zone ellipse head_hit { at: hx, by - 4; radius: 33; cursor: pointer }
    repeat k in 0..10 {
        zone box icon_hit.$k { at: bl + 80 + k * step, mid; size: 44, 44; corner: 12; cursor: pointer; active: k < n and mode != dlazdice }
    }

    // telo: klik odtrhne / vráti; ťahanie nahor ťahá stopku (nad 0,7 sa pretrhne), nadol vracia
    on press body_hit { squish: 1 }
    on drag body_hit { pull: clamp(-drag.dy / 90, -1, 1) ~0ms }
    on drag body_hit while abs(drag.dy) > 6 { pulling = true }
    on release body_hit while pulling { detached = out > 0.8; pulling = false; pull: 0; squish: 0 }
    on release body_hit while not pulling { toggle detached; pull: 0; squish: 0 }
    // hlava: režim okien; koliesko: páska = posun, plávajúce = ďalšie okno
    on press head_hit { emit cycle; squish: 1; squish.s: 0.5 after 70ms; squish.p: 0.35 after 140ms }
    on release head_hit { squish: 0; squish.s: 0 after 70ms; squish.p: 0 after 140ms }
    on scroll head_hit { emit wheel_turn(wheel) }
    // stlačenie prebehne vlnou cez susedov (vypínač → Štart → hlava a naopak)
    on press start_hit { emit start_open; squish.s: 1; squish.p: 0.5 after 70ms; squish: 0.4 after 70ms }
    on release start_hit { squish.s: 0; squish.p: 0 after 70ms; squish: 0 after 70ms }
    on press power_hit { emit power_open; squish.p: 1; squish.s: 0.5 after 70ms; squish: 0.3 after 140ms }
    on release power_hit { squish.p: 0; squish.s: 0 after 70ms; squish: 0 after 140ms }
    on enter start_hit { hs: 1 }
    on leave start_hit { hs: 0 }
    on enter power_hit { hp: 1 }
    on leave power_hit { hp: 0 }
    on enter head_hit { hh: 1 }
    on leave head_hit { hh: 0 }
    repeat k in 0..10 {
        on press icon_hit.$k { emit pick(k) }
    }

    translations sk {
        "Floating windows" = "Plávajúce okná"
        "Tiles" = "Dlaždice"
        "Endless strip" = "Nekonečná páska"
    }
}
