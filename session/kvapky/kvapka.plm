    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.0.icon { at: wp.x.0 - 11, wp.y.0 - 11 - if(wdg.0.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.0 * if(wdg.0.on, 100%, 55%); show: 0 < wdg.count and wdg.0.mono }
    image wdg.0.icon { at: wp.x.0 - 12, wp.y.0 - 12; size: 24, 24; opacity: wb.0 * if(wdg.0.on, 100%, 55%); show: 0 < wdg.count and not wdg.0.mono }
    text wdg.0.val { at: wp.x.0, wp.y.0 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.0; show: 0 < wdg.count }
    zone ellipse w_hit.0 { at: wp.x.0, wp.y.0; radius: 24; cursor: pointer; active: 0 < wdg.count and not dash }
    on press w_hit.0 { wdrag = 0; wmoved = false; wd.w = W; wd.h = H; wp0.x = pointer.x; wp0.y = pointer.y; wq.x = 0; wq.y = 0 }
    on drag w_hit.0 while wdrag == 0 { wq.x = drag.dx; wq.y = drag.dy }
    on drag w_hit.0 while wdrag == 0 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.0 while wdrag == 0 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.0 300; emit w_drop(0); wmoved = false; wdrag = -1 }
    on release w_hit.0 while wdrag == 0 and not wmoved { wdrag = -1; impulse wwob.0 120; emit w_click(0) }
    on press right w_hit.0 while wdg.0.right { impulse wwob.0 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(0) }
    on scroll w_hit.0 while wdg.0.wheel { emit w_wheel(0 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.0 { wh.0: 1 }
    on leave w_hit.0 { wh.0: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.1.icon { at: wp.x.1 - 11, wp.y.1 - 11 - if(wdg.1.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.1 * if(wdg.1.on, 100%, 55%); show: 1 < wdg.count and wdg.1.mono }
    image wdg.1.icon { at: wp.x.1 - 12, wp.y.1 - 12; size: 24, 24; opacity: wb.1 * if(wdg.1.on, 100%, 55%); show: 1 < wdg.count and not wdg.1.mono }
    text wdg.1.val { at: wp.x.1, wp.y.1 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.1; show: 1 < wdg.count }
    zone ellipse w_hit.1 { at: wp.x.1, wp.y.1; radius: 24; cursor: pointer; active: 1 < wdg.count and not dash }
    on press w_hit.1 { wdrag = 1; wmoved = false; wd.w = W; wd.h = H; wp0.x = pointer.x; wp0.y = pointer.y; wq.x = 0; wq.y = 0 }
    on drag w_hit.1 while wdrag == 1 { wq.x = drag.dx; wq.y = drag.dy }
    on drag w_hit.1 while wdrag == 1 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
    on release w_hit.1 while wdrag == 1 and wmoved { wd.x = pointer.x; wd.y = pointer.y; impulse wwob.1 300; emit w_drop(1); wmoved = false; wdrag = -1 }
    on release w_hit.1 while wdrag == 1 and not wmoved { wdrag = -1; impulse wwob.1 120; emit w_click(1) }
    on press right w_hit.1 while wdg.1.right { impulse wwob.1 120; ctx.x = pointer.x - 20; ctx.y = pointer.y - 20 - 34 * 4; emit w_right(1) }
    on scroll w_hit.1 while wdg.1.wheel { emit w_wheel(1 * 2 + if(wheel > 0, 1, 0)) }
    on enter w_hit.1 { wh.1: 1 }
    on leave w_hit.1 { wh.1: 0 }
    // symbolické ikony widgetov v farbe textu; farebné ikony programov (systémová lišta) ako sú
    image wdg.2.icon { at: wp.x.2 - 11, wp.y.2 - 11 - if(wdg.2.hasval, 5, 0); size: 22, 22; tint: ink; opacity: wb.2 * if(wdg.2.on, 100%, 55%); show: 2 < wdg.count and wdg.2.mono }
    image wdg.2.icon { at: wp.x.2 - 12, wp.y.2 - 12; size: 24, 24; opacity: wb.2 * if(wdg.2.on, 100%, 55%); show: 2 < wdg.count and not wdg.2.mono }
    text wdg.2.val { at: wp.x.2, wp.y.2 + 11; anchor: center; size: 9; weight: 700; color: ink; opacity: 85% * wb.2; show: 2 < wdg.count }
    zone ellipse w_hit.2 { at: wp.x.2, wp.y.2; radius: 24; cursor: pointer; active: 2 < wdg.count and not dash }
    on press w_hit.2 { wdrag = 2; wmoved = false; wd.w = W; wd.h = H; wp0.x = pointer.x; wp0.y = pointer.y; wq.x = 0; wq.y = 0 }
    on drag w_hit.2 while wdrag == 2 { wq.x = drag.dx; wq.y = drag.dy }
    on drag w_hit.2 while wdrag == 2 and abs(drag.dx) + abs(drag.dy) > 6 { wmoved = true }
