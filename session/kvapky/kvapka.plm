    body {
        color: coffee
        rim: 30%
        light: 14%, 0, 30
        glass: 100% * clamp(v * 1.3, 0, 1) * (1 - m)
        shine: pointer
        box { at: wa.x.0, wa.y.0; size: 64 * abs(wn.y.0) + 18 * abs(wn.x.0), 18 * abs(wn.y.0) + 64 * abs(wn.x.0); corner: 9; opacity: 1 }
        ellipse { at: wa.x.0, wa.y.0; radius: 22 * wsheet.0; blend: 14 }
        ellipse { at: wp.x.0, wp.y.0; radius: wr.0; scale: 1 + wjit.0, 1 - wjit.0; blend: 16 * wsheet.0 + 2 }
        box { at: wa.x.1, wa.y.1; size: 64 * abs(wn.y.1) + 18 * abs(wn.x.1), 18 * abs(wn.y.1) + 64 * abs(wn.x.1); corner: 9; opacity: 1 }
        ellipse { at: wa.x.1, wa.y.1; radius: 22 * wsheet.1; blend: 14 }
        ellipse { at: wp.x.1, wp.y.1; radius: wr.1; scale: 1 + wjit.1, 1 - wjit.1; blend: 16 * wsheet.1 + 2 }
        box { at: wa.x.2, wa.y.2; size: 64 * abs(wn.y.2) + 18 * abs(wn.x.2), 18 * abs(wn.y.2) + 64 * abs(wn.x.2); corner: 9; opacity: 1 }
