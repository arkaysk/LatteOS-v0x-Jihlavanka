    let sl.pg = smooth(0.05, 0.45, p.swim)
    let sl.dn = smooth(0.08, 0.6, dn.lift)
    let sl.qg = smooth(0.08, 0.6, qg.lift)
    let sl.src = if(sl.tg > 0.02, 0, if(sl.pg > 0.02, 1, if(sl.dn > 0.02, 2, if(sl.qg > 0.02, 3, -1))))
    let sl.a = if(sl.src == 0, sl.tg, if(sl.src == 1, sl.pg, if(sl.src == 2, sl.dn, if(sl.src == 3, sl.qg, 0))))
    let sl.x = if(sl.src == 0, db.x, if(sl.src == 1, pb.x, if(sl.src == 2, dn.x, if(sl.src == 3, qg.x, 0))))
    let sl.y = if(sl.src == 0, db.y, if(sl.src == 1, pb.y, if(sl.src == 2, dn.y, if(sl.src == 3, qg.y, 0))))
