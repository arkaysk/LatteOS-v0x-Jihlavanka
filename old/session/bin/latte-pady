#!/usr/bin/env python3
"""latte-pady — „Prečo to spadlo?“ (nápad z Omarchy): keď program spadne, LatteOS to nezamlčí. Ukáže upozornenie
s tlačidlom Prečo? — zhrnie, čo sa stalo, a ak je zapnutá AI, nechá to vysvetliť ľudskou rečou (lokálny alebo
zvolený model). Bez AI iba upozornenie a technické zhrnutie.

  latte-pady sleduj          beží s plochou: číta záznamy o pádoch (systemd-coredump) tohto účtu
  latte-pady preco PID       zhrnutie pádu programu s týmto PID (a vysvetlenie od AI) → otvorí sa ako dokument
  latte-pady ticho NÁZOV     pre tento program už upozornenie neukazovať (~/.config/latteos/pady-ticho)

Nehlási sa: kompozitor pri odhlásení (Hyprland padá pri ukončovaní v knižnici Aquamarine — relácii to neublíži)
a program, ktorý padol pred menej než minútou znova (iba raz).
"""
import json, os, re, subprocess, sys, threading, time

HOME = os.path.expanduser("~")
QUIET = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "latteos", "pady-ticho")
OUT = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "latteos")
IGNORE = {"Hyprland", "Xwayland", "pleamar", "latte-relacia"}


def quiet():
    try:
        return {l.strip() for l in open(QUIET, encoding="utf-8") if l.strip()}
    except OSError:
        return set()


def app_name(comm, exe):
    """meno, pod ktorým program pozná človek (zo spúšťača), inak meno procesu"""
    base = os.path.basename(exe or "") or comm
    for d in (HOME + "/.local/share/applications", "/usr/share/applications", "/var/lib/flatpak/exports/share/applications"):
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for f in names:
            if not f.endswith(".desktop"):
                continue
            try:
                t = open(os.path.join(d, f), encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            m = re.search(r"^Exec=(\S+)", t, re.M)
            if m and os.path.basename(m.group(1)) in (base, comm) or re.search(r"^StartupWMClass=%s$" % re.escape(comm), t, re.M | re.I):
                n = re.search(r"^Name=(.+)$", t, re.M)
                if n:
                    return n.group(1).strip()
    return comm


def ask_user(pid, comm, name):
    """upozornenie s akciami; klik (default) = Prečo?, druhá = stíšiť pre tento program"""
    try:
        r = subprocess.run(["notify-send", "-a", "LatteOS", "-i", "dialog-warning", "-u", "normal", "--wait",
                            "-A", "default=Prečo?", "-A", "ticho=Neukazovať pre tento program",
                            f"„{name}“ spadol", "Klikni na Prečo? — LatteOS zhrnie, čo sa stalo."],
                           capture_output=True, text=True, timeout=3600)
    except (OSError, subprocess.TimeoutExpired):
        return
    act = r.stdout.strip()
    if act == "default":
        subprocess.Popen([sys.argv[0], "preco", str(pid)], start_new_session=True)
    elif act == "ticho":
        os.makedirs(os.path.dirname(QUIET), exist_ok=True)
        with open(QUIET, "a", encoding="utf-8") as f:
            f.write(comm + "\n")


def watch():
    last = {}
    p = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "json", "-t", "systemd-coredump"], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if str(e.get("COREDUMP_UID", "")) != str(os.getuid()):
            continue
        comm, exe, pid = e.get("COREDUMP_COMM", ""), e.get("COREDUMP_EXE", ""), e.get("COREDUMP_PID", "")
        if not comm or comm in IGNORE or comm in quiet():
            continue
        if time.time() - last.get(comm, 0) < 60:
            continue
        last[comm] = time.time()
        threading.Thread(target=ask_user, args=(pid, comm, app_name(comm, exe)), daemon=True).start()
    return 0


def why(pid):
    info = subprocess.run(["coredumpctl", "info", "--no-pager", str(pid)], capture_output=True, text=True).stdout
    keep, frames = [], 0
    for l in info.splitlines():
        s = l.strip()
        if re.match(r"^(PID|UID|Signal|Timestamp|Command Line|Executable|Package|Message):", s):
            keep.append(s)
        elif s.startswith("#") and frames < 15:
            keep.append(s)
            frames += 1
    summary = "\n".join(keep) or "Záznam o páde sa nenašiel (možno ho systém už zmazal)."
    m = re.search(r"Executable: (.+)", info)
    exe = m.group(1).strip() if m else ""
    name = app_name(os.path.basename(exe), exe) if exe else str(pid)
    text = f"# Prečo spadol „{name}“\n\n"
    st = subprocess.run(["latte-ai", "status"], capture_output=True, text=True).stdout
    if "provider=ziadna" not in st and st.strip():
        prompt = ("Program na mojom počítači (Fedora Linux, LatteOS) spadol. Vysvetli po slovensky, jednoducho a krátko "
                  "(najviac 8 viet) pre bežného používateľa: čo sa pravdepodobne stalo a čo mám urobiť (aktualizácia, "
                  "nastavenie, nahlásenie chyby). Technické údaje:\n\n" + summary)
        ans = subprocess.run(["latte-ai", "ask", prompt], capture_output=True, text=True, timeout=180).stdout.strip()
        text += (ans or "AI teraz neodpovedala.") + "\n\n"
    else:
        text += "Vysvetlenie ľudskou rečou dá AI — zapni ju v Nastaveniach › AI.\n\n"
    text += "## Technické údaje\n\n```\n" + summary + "\n```\n"
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, f"Prečo spadol {re.sub(r'[/]', '_', name)}.md")
    open(path, "w", encoding="utf-8").write(text)
    subprocess.Popen(["latte-app", "heidelberg", path], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def main(a):
    if a[:1] == ["sleduj"]:
        return watch()
    if a[:1] == ["preco"] and len(a) == 2:
        return why(a[1])
    if a[:1] == ["ticho"] and len(a) == 2:
        os.makedirs(os.path.dirname(QUIET), exist_ok=True)
        open(QUIET, "a", encoding="utf-8").write(a[1] + "\n")
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
