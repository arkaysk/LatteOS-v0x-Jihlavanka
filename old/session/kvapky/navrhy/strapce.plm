// Návrh (nie je súčasť relácie): strapce okien ako ikry a hodiny namiesto Štartu, ktoré po rozbalení
// nesú dashboard. Vymyslené okná: 4× Súbory, 6× SAP, Photoshop, Firefox (aktívny). Spustenie na latte-lab:
//   pleamar --scene session/kvapky/navrhy/strapce.plm --no-hud      (fact stav: zbalene | rozbalene)
// Polohy guľôčok vygeneroval skript: kotva strapca pri lište, ďalšie okná sa lepia smerom od lišty,
// čím viac okien, tým menšie (do 72 %), každá guľa trochu iná; plné je iba jadro (ikona), obal je sklo.
language 0.1

scene Strapce {
    surface { size: full, full; anchor: bottom; margin: 0; level: top; reserve: -1 }
    fact stav: zbalene | rozbalene = zbalene
    prop open = 0 ~420ms
    follow open = if(stav == rozbalene, 1, 0)

    let coffee = #1c0f09
    let cream = #f3ebdd
    let amber = #e4b283
    let W = screen.width
    let H = screen.height
    let hx = W * 0.4                  // hlava lišty
    let y0 = H - 44                   // stredná čiara šnúry (lišta napoly vysunutá, ako pri myši)
    let cx = hx - 92                  // kvapka Hodiny (na mieste Štartu)
    let cy = H - 40
    let px = cx - 70                  // vypínač

    image folder = icon "folder", 40, 40
    image ff = file "/home/arkay/.local/share/flatpak/exports/share/icons/hicolor/64x64/apps/org.mozilla.firefox.png", 40, 40

    // plné jadro: vypínač, Hodiny, hlava, vlákno šnúry, stopky k okraju
    body {
        color: coffee
        light: 16%, H - 110, 40
        rim: 30%
        shadow: 0, 6, 16, 35%
        box { from: px - 40, H; size: hx - px + 80, 60 }
        ellipse { at: px, H - 22; radius: 19; blend: 14 }
        ellipse { at: cx, cy; radius: 34; blend: 18 }
        line { from: px, H - 24; to: cx, cy; width: 8; blend: 12 }
        line { from: cx, cy - 4; to: hx, y0 - 8; width: 10; blend: 14 }
        ellipse { at: hx, y0 - 10; radius: 36; blend: 22 }
        box { at: hx + 222.9 , y0; size: 445.8, 18; corner: 9; blend: 14 }
        box { from: hx - 12, y0; size: 24, 60; corner: 12; blend: 16 }
        // oznámenia: tri kvapôčky prilepené k Hodinám (zliate s povrchom)
        ellipse { at: cx - 26, cy - 24; radius: 7; blend: 8 }
        ellipse { at: cx - 12, cy - 35; radius: 6; blend: 8 }
        ellipse { at: cx + 4, cy - 38; radius: 5; blend: 8 }
        // dashboard vyteká z Hodín (rozbalené)
        box { at: cx + 140 * open, cy - 20 - 240 * open; size: 68 + 520 * open, 68 + 400 * open; corner: 34 - 6 * open; blend: 30 }
    }
    // farba oznámení na kvapôčkach (jantár, podľa druhu) a jedna práve padá
    ellipse { at: cx - 26, cy - 24; radius: 4.5; color: amber; opacity: 1 - open }
    ellipse { at: cx - 12, cy - 35; radius: 3.8; color: #9ed6bd; opacity: 1 - open }
    ellipse { at: cx + 4, cy - 38; radius: 3.2; color: amber; opacity: 1 - open }
    body {
        color: coffee
        rim: 30%
        opacity: 1 - open
        ellipse { at: cx + 10, cy - 96; radius: 6; scale: 0.85, 1.25 }
        ellipse { at: cx + 10, cy - 78; radius: 2; blend: 10 }
    }

    // sklenený obal okien: ikry — priesvitné, zliate so susedkami v strapci aj s vláknom
    body {
        color: #3a2012
        glass: 55%
        rim: 40%
        shadow: 0, 4, 12, 25%
        box { at: hx + 222.9, y0; size: 445.8, 14; corner: 7 }

        ellipse { at: hx + 99.5, y0 + 0.0; radius: 21.5; blend: 9 }
        ellipse { at: hx + 140.3, y0 + -10.5; radius: 22.9; blend: 9 }
        ellipse { at: hx + 116.2, y0 + -35.5; radius: 24.3; blend: 9 }
        ellipse { at: hx + 78.9, y0 + -29.1; radius: 22.2; blend: 9 }
        ellipse { at: hx + 220.9, y0 + 0.0; radius: 19.6; blend: 9 }
        ellipse { at: hx + 258.1, y0 + -9.6; radius: 20.9; blend: 9 }
        ellipse { at: hx + 236.1, y0 + -32.4; radius: 22.2; blend: 9 }
        ellipse { at: hx + 202.1, y0 + -26.5; radius: 20.3; blend: 9 }
        ellipse { at: hx + 267.1, y0 + -39.9; radius: 21.5; blend: 9 }
        ellipse { at: hx + 222.3, y0 + -61.4; radius: 19.6; blend: 9 }
        ellipse { at: hx + 335.0, y0 + 0.0; radius: 29.0; blend: 9 }
        ellipse { at: hx + 413.9, y0 + 0.0; radius: 31.9; blend: 9 }
    }
    // jadrá (plné) a ikony

    ellipse { at: hx + 99.5, y0 + 0.0; radius: 11.8; color: coffee; opacity: 88% }
    ellipse { at: hx + 140.3, y0 + -10.5; radius: 12.6; color: coffee; opacity: 88% }
    ellipse { at: hx + 116.2, y0 + -35.5; radius: 13.4; color: coffee; opacity: 88% }
    ellipse { at: hx + 78.9, y0 + -29.1; radius: 12.2; color: coffee; opacity: 88% }
    ellipse { at: hx + 220.9, y0 + 0.0; radius: 10.8; color: coffee; opacity: 88% }
    ellipse { at: hx + 258.1, y0 + -9.6; radius: 11.5; color: coffee; opacity: 88% }
    ellipse { at: hx + 236.1, y0 + -32.4; radius: 12.2; color: coffee; opacity: 88% }
    ellipse { at: hx + 202.1, y0 + -26.5; radius: 11.2; color: coffee; opacity: 88% }
    ellipse { at: hx + 267.1, y0 + -39.9; radius: 11.8; color: coffee; opacity: 88% }
    ellipse { at: hx + 222.3, y0 + -61.4; radius: 10.8; color: coffee; opacity: 88% }
    ellipse { at: hx + 335.0, y0 + 0.0; radius: 16.0; color: coffee; opacity: 88% }
    ellipse { at: hx + 413.9, y0 + 0.0; radius: 17.5; color: coffee; opacity: 88% }
    image folder { at: hx + 99.5 - 11.3, y0 + 0.0 - 11.3; size: 22.6, 22.6 }
    image folder { at: hx + 140.3 - 12.0, y0 + -10.5 - 12.0; size: 24.0, 24.0 }
    image folder { at: hx + 116.2 - 12.75, y0 + -35.5 - 12.75; size: 25.5, 25.5 }
    image folder { at: hx + 78.9 - 11.65, y0 + -29.1 - 11.65; size: 23.3, 23.3 }
    box { at: hx + 220.9, y0 + 0.0; size: 24.5, 14.7; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 220.9, y0 + 0.0; anchor: center; size: 8.2; weight: 800; color: #ffffff }
    box { at: hx + 258.1, y0 + -9.6; size: 26.1, 15.7; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 258.1, y0 + -9.6; anchor: center; size: 8.8; weight: 800; color: #ffffff }
    box { at: hx + 236.1, y0 + -32.4; size: 27.8, 16.6; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 236.1, y0 + -32.4; anchor: center; size: 9.3; weight: 800; color: #ffffff }
    box { at: hx + 202.1, y0 + -26.5; size: 25.4, 15.2; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 202.1, y0 + -26.5; anchor: center; size: 8.5; weight: 800; color: #ffffff }
    box { at: hx + 267.1, y0 + -39.9; size: 26.9, 16.1; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 267.1, y0 + -39.9; anchor: center; size: 9.0; weight: 800; color: #ffffff }
    box { at: hx + 222.3, y0 + -61.4; size: 24.5, 14.7; corner: 3; color: #0a6ed1 }
    text "SAP" { at: hx + 222.3, y0 + -61.4; anchor: center; size: 8.2; weight: 800; color: #ffffff }
    box { at: hx + 335.0, y0 + 0.0; size: 30.5, 30.5; corner: 7; color: #001e36 }
    text "Ps" { at: hx + 335.0, y0 + 0.0; anchor: center; size: 18.0; weight: 800; color: #31a8ff }
    image ff { at: hx + 413.9 - 16.75, y0 + 0.0 - 16.75; size: 33.5, 33.5 }
    box { at: hx + 413.9, y0 + 0.0 + 31.9 - 6; size: 12, 3; corner: 1.5; color: cream }
    group {
        blur: 1.2
        opacity: 75%
        ellipse { at: hx - 14, y0 - 34; radius: 4; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: cx - 12, cy - 18; radius: 3.5; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea; opacity: 1 - open }
        ellipse { at: hx + 99.5 - 9.0, y0 + 0.0 - 10.8; radius: 2.8; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 140.3 - 9.6, y0 + -10.5 - 11.4; radius: 3.0; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 116.2 - 10.2, y0 + -35.5 - 12.2; radius: 3.2; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 78.9 - 9.3, y0 + -29.1 - 11.1; radius: 2.9; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 220.9 - 8.2, y0 + 0.0 - 9.8; radius: 2.5; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 258.1 - 8.8, y0 + -9.6 - 10.4; radius: 2.7; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 236.1 - 9.3, y0 + -32.4 - 11.1; radius: 2.9; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 202.1 - 8.5, y0 + -26.5 - 10.2; radius: 2.6; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 267.1 - 9.0, y0 + -39.9 - 10.8; radius: 2.8; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 222.3 - 8.2, y0 + -61.4 - 9.8; radius: 2.5; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 335.0 - 12.2, y0 + 0.0 - 14.5; radius: 3.8; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
        ellipse { at: hx + 413.9 - 13.4, y0 + 0.0 - 15.9; radius: 4.1; scale: 1.5, 0.8; rotate: -30deg; color: #fff6ea }
    }

    // Hodiny (zbalené): čas a dátum v kvapke
    text "14:32" { at: cx, cy - 5; anchor: center; size: 17; weight: 800; color: cream; opacity: 1 - open }
    text "ut 29. 9." { at: cx, cy + 12; anchor: center; size: 9.5; weight: 600; color: cream; opacity: 70% * (1 - open) }
    image power = icon "system-shutdown-symbolic", 16, 16
    image power { at: px - 8, H - 30; size: 16, 16; tint: cream }

    // dashboard (rozbalené): čas, počasie, oznámenia, hľadanie a spustenie (Štart)
    group {
        opacity: clamp(open * 2 - 1, 0, 1)
        text "14:32" { at: cx - 110, cy - 440; size: 46; weight: 800; color: cream; family: "Fraunces" }
        text "utorok 29. septembra" { at: cx - 110, cy - 392; size: 15; weight: 600; color: cream; opacity: 75% }
        text "☁  14 °C · Jihlava · zajtra 17 °C" { at: cx + 170, cy - 425; size: 13; weight: 600; color: cream; opacity: 80% }
        box { at: cx + 140, cy - 345; size: 470, 40; corner: 20; color: #000000; opacity: 35% }
        text "Hľadať aplikácie, súbory, nastavenia…" { at: cx - 80, cy - 345; anchor: left center; size: 13; color: cream; opacity: 60% }
        text "OZNÁMENIA · 3" { at: cx - 90, cy - 300; size: 10; weight: 800; color: amber }
        ellipse { at: cx - 82, cy - 268; radius: 4; color: amber }
        text "SAP · Objednávka 4471 čaká na schválenie" { at: cx - 70, cy - 268; anchor: left center; size: 12.5; color: cream }
        ellipse { at: cx - 82, cy - 242; radius: 4; color: #9ed6bd }
        text "Súbory · Kopírovanie dokončené (4 priečinky)" { at: cx - 70, cy - 242; anchor: left center; size: 12.5; color: cream }
        ellipse { at: cx - 82, cy - 216; radius: 4; color: amber }
        text "Firefox · Sťahovanie: faktura_09.pdf" { at: cx - 70, cy - 216; anchor: left center; size: 12.5; color: cream }
        text "PRIPNUTÉ" { at: cx - 90, cy - 180; size: 10; weight: 800; color: amber }
        image folder { at: cx - 90, cy - 162; size: 34, 34 }
        image ff { at: cx - 40, cy - 162; size: 34, 34 }
        box { at: cx + 27, cy - 145; size: 34, 34; corner: 7; color: #001e36 }
        text "Ps" { at: cx + 27, cy - 145; anchor: center; size: 16; weight: 800; color: #31a8ff }
        box { at: cx + 77, cy - 145; size: 38, 24; corner: 3; color: #0a6ed1 }
        text "SAP" { at: cx + 77, cy - 145; anchor: center; size: 11; weight: 800; color: #ffffff }
    }
}
