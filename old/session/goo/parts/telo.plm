        line { from: x.5 + if(goo.5.ed == 1 or goo.5.ed == 3, 0, 1) * kwa.5 * (goo.5.kd - 1), y.5 + if(goo.5.ed == 1 or goo.5.ed == 3, 1, 0) * kwa.5 * (goo.5.kd - 1); to: x.5 + if(goo.5.ed == 1 or goo.5.ed == 3, 0, 1) * kwa.5 * (goo.5.kd + 1), y.5 + if(goo.5.ed == 1 or goo.5.ed == 3, 1, 0) * kwa.5 * (goo.5.kd + 1); width: rr.5 * 2 * if(kwa.5 > 0.5, 1, 0); blend: lk.5 }
        ellipse { at: bx.6, by.6; radius: rr.6 * 0.5 * base.6; scale: bsx.6, 2.1 - bsx.6; blend: 14 }
