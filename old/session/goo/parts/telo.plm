    ellipse { at: x.127 - rr.127 * if(goo.127.kw > 0, 0.4, 0.12), y.127 - rr.127 * if(goo.127.kw > 0, 0.9, 0.58); radius: rr.127 * 0.06 * if(sklo and goo.127.on, 1, 0); color: #ffffff; opacity: 75% }
        // <<< odlesky
    // farebné jadro: od stredu prechod z farby do kávy (okraj splynie s kvapkou), predvolene druh upozornenia;
    // vypnuté má nulovú veľkosť (so záplatou nič nestojí)
    repeat k in 0..128 {
        // ikona kapsuly: na ľavom konci (kd 0 — obojsmerná kapsula), pri jednosmernej ostane v pôvodnej kvapke
        let jio.$k = if(goo.$k.kd < 0, 0, kwa.$k * (goo.$k.kd - 1))
        let jix.$k = x.$k + if(goo.$k.ed == 1 or goo.$k.ed == 3, 0, jio.$k)
        let jiy.$k = y.$k + if(goo.$k.ed == 1 or goo.$k.ed == 3, jio.$k, 0)
        body {
            gradient: radial jix.$k, jiy.$k radius rr.$k * 0.97, if(goo.$k.jf == 0, #e5484d, if(goo.$k.jf == 1, #30a46c, if(goo.$k.jf == 2, #3e63dd, if(goo.$k.jf == 3, #f5a524, if(goo.$k.jf == 4, #ffe8c2, #8e4ec6))))), coffee
            opacity: clamp(jd.$k, 0, 1)
            ellipse { at: jix.$k, jiy.$k; radius: rr.$k * 0.97 * if(jd.$k > 0.02, 1, 0); scale: 1 + fxw.$k, 1 - fxw.$k }    // kapsula: jadro pri ikone
        }
    }
    // bublina okna (pravidlo 14): z kávy do materiálu karty, pri nafukovaní rastie tieň
    body {
        gradient: b.x + bub.nx * b.w / 2, b.y + bub.ny * b.h / 2 to b.x - bub.nx * b.w / 2, b.y - bub.ny * b.h / 2, mix(coffee, #2c2019, b.s3), mix(coffee, #2c2019, b.s3 * 0.55)
        rim: 24%
        shadow: 0, 10, 26, 38% * b.s3
        opacity: bub.a * if(bub.t > 0.27, 1, 0)
        box { at: b.x, b.y; size: b.w * if(bub.a > 0.01, 1, 0), b.h; corner: b.r + (14 - b.r) * b.s3 }
    }
    // minimalizované okno sa zmenšuje do kvapky (potom padá v tele goo)
    body {
        gradient: mf.x0, mf.y0 - mf.h / 2 to mf.x0, mf.y0 + mf.h / 2, mix(#2c2019, coffee, mf.k), coffee
        rim: 20%
        opacity: (1 - mf.k * mf.k) * mf.on
        box { at: mf.x0, mf.y0; size: (30 + (mf.w - 30) * (1 - mf.k)) * if(mf.k < 1, mf.on, 0), 30 + (mf.h - 30) * (1 - mf.k); corner: 14 + 6 * mf.k }
    }
    // prasknutie: prstenec sa rozbehne a zmizne, kvapôčky odletia a klesnú
    ellipse { at: pop.x, pop.y; radius: pop.r * (0.55 + 0.5 * pop.t); stroke: 4 * (1 - pop.t); color: cream; opacity: 0.7 * (1 - pop.t) * if(pop.t < 1, 1, 0) }
    repeat i in 0..10 {
        ellipse { at: pop.x + cos(i * 36 + 12) * pop.r * (0.6 + 0.75 * pop.t), pop.y + sin(i * 36 + 12) * pop.r * (0.6 + 0.75 * pop.t) + 90 * pop.t * pop.t; radius: (5 + 2 * noise(i * 3.1)) * (1 - pop.t) * if(pop.t < 1, 1, 0); color: coffee; opacity: 0.9 }
    }
}
