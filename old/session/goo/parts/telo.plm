// Telo Goo: kreslenie lišty a všetkých kvapiek v jednom goo (SDF tvary). Plný vzhľad; SafeGoo kreslí jednoduchšie.
// Časť scény Goo (`include` z goo.plm; patrí scéne, akoby bola napísaná priamo v nej). Pozri README.md › Časti scény.
part Telo {
    // ── telo: lišta a všetky kvapky v jednom goo (zliatie) ─────────────────────────────────────────────────────
    body {
        // jedna káva pre lištu aj všetky kvapky (pravidlo 6), jedno svetlo kurzora (§3)
        gradient: radial cursor.x, cursor.y radius 260, mix(coffee, svit, 0.12 + 0.05 * zl), coffee
        rim: 28%
        // ostrý okraj (aj okolo ôk medzi spojmi): tieň iba tesný, nerozmazaný
        shadow: 0, 2, 2, 28%
        // SKLENENÁ KÁVA (materiál na výber, 7. 10., predloha „Droplu“ z Figmy): telo je sklo, cez ktoré presvitá
        // a láme sa pozadie (tapeta, okná), okraj chytá svetlo od kurzora. Lom potrebuje našu záplatu
        // pleamar-sklo-stabilne: bez nej v skle pri hýbucich sa kvapkách ostávali duchovia a zrnité pásy (7. 10.);
        // vypne ho kvapky.json sklo_lom = false (potom pozadie iba rozmazáva Hyprland); farbu kávy dáva telo nižšie („káva v skle“). Pri
        // obyčajnej káve je sklo 0 % a lom vypnutý — nestojí nič
        glass: if(sklo, 100%, 0%)
        lens: sklo and sklolom
        shine: pointer
        refraction: 170%
        dispersion: 45%
        dome: 30%
        // okraj obrazovky je hladina (ako Kvapky): pás je tesne pod ním, kvapky z neho vystupujú a pri ňom sa rozlievajú
        box bar { from: 0, H; size: W, 40 }
        // >>> telo (gen.py)
        ellipse { at: bx.0, by.0; radius: rr.0 * 0.5 * base.0; scale: bsx.0, 2.1 - bsx.0; blend: 14 }
        line { from: bx.0, by.0; to: x.0, y.0; width: rr.0 * 2 * stalk.0; blend: 14 }
        line { from: wax.0, way.0; to: wbx.0, wby.0; width: wa.0 * 2; blend: 16 }
        ellipse { at: x.0, y.0; radius: rr.0; scale: 1 + fxw.0, 1 - fxw.0; blend: lk.0 + 6 * near.0 }
        line { from: t0x.0, t0y.0; to: thx.0, thy.0; width: th.0; blend: thb.0 }
        line { from: x.0 + if(goo.0.ed == 1 or goo.0.ed == 3, 0, 1) * kwa.0 * (goo.0.kd - 1), y.0 + if(goo.0.ed == 1 or goo.0.ed == 3, 1, 0) * kwa.0 * (goo.0.kd - 1); to: x.0 + if(goo.0.ed == 1 or goo.0.ed == 3, 0, 1) * kwa.0 * (goo.0.kd + 1), y.0 + if(goo.0.ed == 1 or goo.0.ed == 3, 1, 0) * kwa.0 * (goo.0.kd + 1); width: rr.0 * 2 * if(kwa.0 > 0.5, 1, 0); blend: lk.0 }
        ellipse { at: bx.1, by.1; radius: rr.1 * 0.5 * base.1; scale: bsx.1, 2.1 - bsx.1; blend: 14 }
        line { from: bx.1, by.1; to: x.1, y.1; width: rr.1 * 2 * stalk.1; blend: 14 }
        line { from: wax.1, way.1; to: wbx.1, wby.1; width: wa.1 * 2; blend: 16 }
        ellipse { at: x.1, y.1; radius: rr.1; scale: 1 + fxw.1, 1 - fxw.1; blend: lk.1 + 6 * near.1 }
        line { from: t0x.1, t0y.1; to: thx.1, thy.1; width: th.1; blend: thb.1 }
        line { from: x.1 + if(goo.1.ed == 1 or goo.1.ed == 3, 0, 1) * kwa.1 * (goo.1.kd - 1), y.1 + if(goo.1.ed == 1 or goo.1.ed == 3, 1, 0) * kwa.1 * (goo.1.kd - 1); to: x.1 + if(goo.1.ed == 1 or goo.1.ed == 3, 0, 1) * kwa.1 * (goo.1.kd + 1), y.1 + if(goo.1.ed == 1 or goo.1.ed == 3, 1, 0) * kwa.1 * (goo.1.kd + 1); width: rr.1 * 2 * if(kwa.1 > 0.5, 1, 0); blend: lk.1 }
        ellipse { at: bx.2, by.2; radius: rr.2 * 0.5 * base.2; scale: bsx.2, 2.1 - bsx.2; blend: 14 }
        line { from: bx.2, by.2; to: x.2, y.2; width: rr.2 * 2 * stalk.2; blend: 14 }
        line { from: wax.2, way.2; to: wbx.2, wby.2; width: wa.2 * 2; blend: 16 }
        ellipse { at: x.2, y.2; radius: rr.2; scale: 1 + fxw.2, 1 - fxw.2; blend: lk.2 + 6 * near.2 }
        line { from: t0x.2, t0y.2; to: thx.2, thy.2; width: th.2; blend: thb.2 }
        line { from: x.2 + if(goo.2.ed == 1 or goo.2.ed == 3, 0, 1) * kwa.2 * (goo.2.kd - 1), y.2 + if(goo.2.ed == 1 or goo.2.ed == 3, 1, 0) * kwa.2 * (goo.2.kd - 1); to: x.2 + if(goo.2.ed == 1 or goo.2.ed == 3, 0, 1) * kwa.2 * (goo.2.kd + 1), y.2 + if(goo.2.ed == 1 or goo.2.ed == 3, 1, 0) * kwa.2 * (goo.2.kd + 1); width: rr.2 * 2 * if(kwa.2 > 0.5, 1, 0); blend: lk.2 }
        ellipse { at: bx.3, by.3; radius: rr.3 * 0.5 * base.3; scale: bsx.3, 2.1 - bsx.3; blend: 14 }
        line { from: bx.3, by.3; to: x.3, y.3; width: rr.3 * 2 * stalk.3; blend: 14 }
        line { from: wax.3, way.3; to: wbx.3, wby.3; width: wa.3 * 2; blend: 16 }
        ellipse { at: x.3, y.3; radius: rr.3; scale: 1 + fxw.3, 1 - fxw.3; blend: lk.3 + 6 * near.3 }
        line { from: t0x.3, t0y.3; to: thx.3, thy.3; width: th.3; blend: thb.3 }
        line { from: x.3 + if(goo.3.ed == 1 or goo.3.ed == 3, 0, 1) * kwa.3 * (goo.3.kd - 1), y.3 + if(goo.3.ed == 1 or goo.3.ed == 3, 1, 0) * kwa.3 * (goo.3.kd - 1); to: x.3 + if(goo.3.ed == 1 or goo.3.ed == 3, 0, 1) * kwa.3 * (goo.3.kd + 1), y.3 + if(goo.3.ed == 1 or goo.3.ed == 3, 1, 0) * kwa.3 * (goo.3.kd + 1); width: rr.3 * 2 * if(kwa.3 > 0.5, 1, 0); blend: lk.3 }
