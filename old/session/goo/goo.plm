// LatteOS — engine Goo (jadro, skúšobná scéna; relácia „LatteOS Kvapky – engine test“).
// Jedny pravidlá pre všetky kvapky (LATTEOS-GOO.md §2, §3): každá kvapka je záznam v modeli `goo` (plní logika,
// lib/engine.luau) a scéna s ňou robí vždy to isté. Kvapky sú vždy káva (pravidlo 6: pomer vody a mlieka z Baristu),
// nemajú tvár (7), sú v jednom goo tele s lištou (§3) — zlievajú sa s ňou aj medzi sebou. Kurzor ich iba PRIŤAHUJE
// (gravitácia, nikdy neodpudzuje) a je ich svetlom: keď sa priblíži, kvapky sa nadnesú od lišty na stopke, nakloní sa
// k nemu a susedné sa pri tom prelievajú; nad kvapkou sa mierne nafúkne a netrpezlivo pulzuje (obsah sa nemení).
// Vlastný pohyb aj bez myši (dych, drift). Lepivosť: ťahaná kvapka sa natiahne a odtrhne; ťažká padne a odrazí sa.
// Čím sa kvapky líšia, sú iba ČÍSLA v zázname (povaha) a háčiky v logike — nie vlastné pravidlá.
// Nová kvapka = záznam (JSON používateľa alebo modul Luau programátora), scéna sa nemení. Pozri README.md.
//
// Rozšírenie pleamar „ako DLC“: iba zdokumentovaný jazyk 0.2 (bez záplat Rustu), aby to prežilo aktualizácie.
// Jazyk nedovolí `repeat` vnútri `body` (zliatie goo) — telo rozpisuje gen.py; ten nastavuje aj počet miest (N).
language 0.2

scene Goo {
    surface {
        size: full, full    // celá obrazovka: kvapka môže byť kdekoľvek; kliky berú iba zóny
        anchor: bottom
        margin: 0
        level: top
        reserve: -1
        rate: 60
        // karta je otvorená iba do kliku mimo (ako ponuka): kým je, klávesnica patrí jej — Esc ju zavrie
        // hneď a do poľa karty sa dá písať bez klikania (on_demand by ju dostal až po kliku do karty)
        keyboard: exclusive while ctx_open or kb
    }
    // povolenia musia byť v hlavičke scény (v `part` ich pleamar neberie do úvahy)
    // povolenia: Goobar (okná, spúšťače aplikácií), DaNoGoo (upozornenia), PowerGoo (batéria, Noctalia, pás výkonu:
    // latte-sysmon), QueenGoo
    permissions { run: "latte-goo", "date", "hyprctl", "systemctl", "labwc", "foot", "latte-app", "noctalia", "latte-spustac", "latte-devices", "latte-apps", "latte-kvapky", "latte-riadok", "latte-hladaj", "latte-ai", "latte-terminal", "xdg-open", "latte-sysmon", "latte-zamok", "latte-chatgoo", "zoxide", "latte-webapp", "latte-relacia"; services: "clock", "window", "window.*", "apps", "apps.*", "notifications", "notifications.*", "battery", "clipboard.set", "env" }
    // vstupy fyziky (čas, kurzor) pomenované na jednom mieste (zdieľané časti píšu T, curx, cury)
    let T = time
    let curx = cursor.x
    let cury = cursor.y

    include "parts/rozhranie.plm"
    include "parts/telo.plm"
    include "parts/karty.plm"
}
