// Pokus 7. 10. 2026: kvapky ako 3D tekuté kvapky z Figmy („Droplu“), ale v kávových farbách — sklo s lomom svetla
// (glass, refraction, dome), farebná káva nad lomom, nepravidelný tvar zo zliatych elíps, odlesk zhora, svetlo
// prechádzajúce kvapkou dole, bublinky. Spustenie: pleamar --scene session/goo/pokusy/kavove-sklo.plm --screen DP-3
language 0.2

scene SkloSkuska {
    surface {
        size: 1100, 380
        anchor: top
        margin: 260
        level: overlay
        rate: 60
    }
    body {
        gradient: radial 199, 217 radius 123, #8a5532, #2a170e
        glass: 70%
        shine: 50, 20
        refraction: 190%
        dispersion: 45%
        dome: 45%
        shadow: 0, 14, 24, 34%
        ellipse { at: 170, 180; radius: 82; scale: 1.05, 0.92 }
        ellipse { at: 221, 211; radius: 37; blend: 29 }
        ellipse { at: 125, 155; radius: 41; blend: 25 }
        ellipse { at: 289, 250; radius: 16 }
    }
    // káva v skle: priesvitná farba nad lomom (bez skla, bez tieňa)
    body {
        gradient: radial 199, 217 radius 123, #8a5532, #2a170e
        opacity: 55%
        ellipse { at: 170, 180; radius: 82; scale: 1.05, 0.92 }
        ellipse { at: 221, 211; radius: 37; blend: 29 }
        ellipse { at: 125, 155; radius: 41; blend: 25 }
        ellipse { at: 289, 250; radius: 16 }
    }
    // odlesk zhora (okno svetla) a svetlá kosačka dole, kade svetlo z kvapky vychádza
    ellipse { at: 136, 137; radius: 16; scale: 2.1, 0.9; color: #fff8ef; opacity: 70% }
    ellipse { at: 158, 129; radius: 4.1; color: #ffffff; opacity: 80% }
    ellipse { at: 190, 237; radius: 8; scale: 4.2, 0.9; color: #e0a46a; opacity: 45% }
    ellipse { at: 195, 172; radius: 3.5; color: #ffffff; opacity: 50% }
    ellipse { at: 204, 184; radius: 2; color: #ffffff; opacity: 45% }
    ellipse { at: 186, 192; radius: 1.5; color: #ffffff; opacity: 40% }
    text "espresso" { at: 170, 355; anchor: center; size: 16; color: #ffffff }
    body {
        gradient: radial 572, 221 radius 138, #d39a62, #5b3620
        glass: 65%
        shine: 420, 20
        refraction: 190%
        dispersion: 45%
        dome: 45%
        shadow: 0, 14, 24, 34%
        ellipse { at: 540, 180; radius: 92; scale: 1.1, 0.9 }
        ellipse { at: 597, 215; radius: 41; blend: 32 }
        ellipse { at: 489, 152; radius: 46; blend: 28 }
        ellipse { at: 673, 258; radius: 18 }
    }
    // káva v skle: priesvitná farba nad lomom (bez skla, bez tieňa)
    body {
        gradient: radial 572, 221 radius 138, #d39a62, #5b3620
        opacity: 55%
        ellipse { at: 540, 180; radius: 92; scale: 1.1, 0.9 }
        ellipse { at: 597, 215; radius: 41; blend: 32 }
        ellipse { at: 489, 152; radius: 46; blend: 28 }
        ellipse { at: 673, 258; radius: 18 }
    }
    // odlesk zhora (okno svetla) a svetlá kosačka dole, kade svetlo z kvapky vychádza
    ellipse { at: 501, 132; radius: 18; scale: 2.1, 0.9; color: #fff8ef; opacity: 70% }
    ellipse { at: 526, 123; radius: 4.6; color: #ffffff; opacity: 80% }
    ellipse { at: 563, 244; radius: 9; scale: 4.2, 0.9; color: #ffd29a; opacity: 45% }
    ellipse { at: 568, 171; radius: 3.5; color: #ffffff; opacity: 50% }
    ellipse { at: 579, 185; radius: 2; color: #ffffff; opacity: 45% }
    ellipse { at: 558, 194; radius: 1.5; color: #ffffff; opacity: 40% }
    text "café crema" { at: 540, 355; anchor: center; size: 16; color: #ffffff }
    body {
        gradient: radial 930, 223 radius 128, #f1d3ae, #a8784e
        glass: 55%
        shine: 780, 25
        refraction: 190%
        dispersion: 45%
        dome: 45%
        shadow: 0, 14, 24, 34%
        ellipse { at: 900, 185; radius: 85; scale: 1.05, 0.92 }
        ellipse { at: 953, 217; radius: 38; blend: 30 }
        ellipse { at: 853, 160; radius: 42; blend: 26 }
        ellipse { at: 1023, 257; radius: 14 }
    }
    // káva v skle: priesvitná farba nad lomom (bez skla, bez tieňa)
    body {
        gradient: radial 930, 223 radius 128, #f1d3ae, #a8784e
        opacity: 55%
        ellipse { at: 900, 185; radius: 85; scale: 1.05, 0.92 }
        ellipse { at: 953, 217; radius: 38; blend: 30 }
        ellipse { at: 853, 160; radius: 42; blend: 26 }
        ellipse { at: 1023, 257; radius: 14 }
    }
    // odlesk zhora (okno svetla) a svetlá kosačka dole, kade svetlo z kvapky vychádza
    ellipse { at: 864, 141; radius: 17; scale: 2.1, 0.9; color: #fff8ef; opacity: 70% }
    ellipse { at: 887, 132; radius: 4.2; color: #ffffff; opacity: 80% }
    ellipse { at: 921, 244; radius: 8; scale: 4.2, 0.9; color: #fff0dc; opacity: 45% }
    ellipse { at: 926, 176; radius: 3.5; color: #ffffff; opacity: 50% }
    ellipse { at: 936, 189; radius: 2; color: #ffffff; opacity: 45% }
    ellipse { at: 917, 198; radius: 1.5; color: #ffffff; opacity: 40% }
    text "latte" { at: 900, 355; anchor: center; size: 16; color: #ffffff }
}
