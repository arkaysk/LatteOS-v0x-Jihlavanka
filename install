#!/usr/bin/env python3
"""install: puts LatteOS on this Fedora, or takes it off again, by the list in FILES.

  ./install                  says what it would do and what is missing; nothing is changed
  sudo ./install --go        builds what is built, copies the files, runs the steps
  sudo ./install --remove    undoes the steps, takes the files off, puts back what LatteOS replaced; what was
                             made while it ran ([state] in FILES) stays, unless --purge is said too
  --root DIR                 with --go or --remove: the files go under DIR and no step is run. For looking at
                             the result, for packaging, and for tests
  --prune                    with --go: what is in LatteOS's own folders and not in FILES is removed too
                             (left behind by an older LatteOS); without it, it is only listed
  --with PACKAGES            with --go: these optional ones too (a list: "steam gamescope"), as the installer's
                             window chose them
  --old-amd                  with --go: Linux 7.3 and Mesa 26.3 too, for AMD cards of GFX6 to GFX8 (an RX 640), until
                             Fedora has them (patches/old-amd.sh); --remove takes that Mesa off again
  --gpu "CARDS"              with --go: the graphics cards this PC has, as the installer's window found them (nvidia,
                             nouveau for NVIDIA without its driver, amd, intel): NVIDIA's driver from RPM Fusion for
                             nvidia, and the firmware of the cards it does not have is taken off and kept off (2.10)
  --progress                 with --go: lines for the installer's window besides the usual ones, "@step N/M text"
                             when a part begins and "@percent P" as it goes (docs/instalator/PLAN.md)

It changes nothing it was not told about in FILES. A file LatteOS replaces is kept beside it as *.pre-latteos.
"""
import glob
import os
import pwd
import re
import secrets
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
OWN = ("/usr/share/latteos", "/usr/lib64/latteos", "/usr/share/plymouth/themes/latteos", "/usr/share/fonts/latteos")     # folders that are LatteOS's alone


def read(path):
    """FILES as {section: [line without its comment]}."""
    sections, now = {}, None
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = re.sub(r"(^|\s+)#.*$", "", line.rstrip("\n")).rstrip()
            if re.fullmatch(r"\[\w+\]", line):
                now = sections.setdefault(line[1:-1], [])
            elif line and now is not None:
                now.append(line)
    return sections


def pairs(lines):
    return [tuple(part.strip() for part in line.split("<-", 1)) for line in lines if "<-" in line]


def built(source):
    """Where a source of FILES is in this repository once it is built: [(file, name it has in the target)]."""
    kind, _, name = source.partition(":")
    if kind == "build":
        return [(os.path.join(HERE, "target", "release", name), name)]
    if kind == "pleamar":               # pleamar and pleamar-wm with LatteOS's patches (patches/build-pleamar.sh)
        src = os.path.join(HERE, "build", "pleamar-src")
        if name.endswith("/**"):        # a whole tree, as it is (Marea's scenes), without git's and the evidence's files
            top, found = os.path.join(src, name[:-3]), []
            for d, ds, fs in os.walk(top):
                # build trees stay out; her agent's packages go with her (patches/build-pleamar.sh fetched them)
                ds[:] = [x for x in ds if x not in (".git", ".github", "evidencia", "target")
                         and not (x == "node_modules" and os.path.basename(d) != "agent")]
                found += [(os.path.join(d, f), os.path.relpath(os.path.join(d, f), top)) for f in sorted(fs)]
            return found
        return [(os.path.join(src, name) if "/" in name else os.path.join(src, "target", "release", name), os.path.basename(name))]
    if kind == "qsweb":                 # Quickshell with a web engine, for LensAI (patches/build-quickshell-web.sh)
        return [(os.path.join(HERE, "build", "quickshell-web", "build", "src", name), name)]
    if kind == "system":
        return [(f, os.path.basename(f)) for f in sorted(glob.glob(name))]
    return [(os.path.join(HERE, source), os.path.basename(source))]


def copies(sections, section):
    """[(file in the repository or the system, where it goes)] for a section of `target <- source` lines."""
    found = {}
    # what the system lends first: a file of LatteOS's own with the same name is the one that stays
    for target, source in sorted(pairs(sections.get(section, [])), key=lambda p: not p[1].startswith("system:")):
        for path, name in built(source):
            found[target + name if target.endswith("/") else target] = path
    return [(path, target) for target, path in found.items()]


def needs(sections, have=None, there=os.path.exists):
    """What the system lacks: (packages that must be there, optional ones, files that must be, optional files)."""
    # --whatprovides: a package that gives the same under another name counts (nodejs22 gives nodejs)
    have = have or (lambda p: subprocess.run(["rpm", "-q", "--whatprovides", p], capture_output=True).returncode == 0)
    must, may, files, may_files = [], [], [], []
    for line in sections.get("needs", []):
        head, _, rest = line.partition(":")
        if head in ("package", "optional"):
            (must if head == "package" else may).extend(p for p in rest.split() if not have(p))
        elif head.startswith("optional /"):
            if not there(head.split()[1]): may_files.append(line)
        elif head.startswith("/") and not there(head):
            files.append(line)
    return must, may, files, may_files


def users():
    """Who uses the desktop: whoever asked for this with sudo, and everyone with a home of their own."""
    names = [u.pw_name for u in pwd.getpwall() if 1000 <= u.pw_uid < 60000 and u.pw_dir.startswith("/home/") and os.path.isdir(u.pw_dir)]
    asked = os.environ.get("SUDO_USER")
    return sorted(set(names + ([asked] if asked and asked != "root" else [])))


def give_back_home(pw):
    """What root made under a user's home is the user's: the home's own entries owned by root (not following links, not
    leaving the home's file system), and everything in LatteOS's own folders. Returns how many it changed."""
    changed, home_dev = 0, os.stat(pw.pw_dir).st_dev

    def give(path):
        nonlocal changed
        try:
            if os.lstat(path).st_uid == 0:
                os.lchown(path, pw.pw_uid, pw.pw_gid)
                changed += 1
        except OSError:
            pass

    for d, ds, fs in os.walk(pw.pw_dir):
        ds[:] = [x for x in ds if not os.path.islink(os.path.join(d, x)) and os.lstat(os.path.join(d, x)).st_dev == home_dev]
        give(d)
        for x in fs:
            give(os.path.join(d, x))
    for sub in (".config/latteos", ".config/quickshell", ".local/share/latteos", ".cache/latteos", ".local/state/latteos"):
        top = os.path.join(pw.pw_dir, sub)
        if not os.path.isdir(top):
            continue
        os.lchown(top, pw.pw_uid, pw.pw_gid)
        for d, ds, fs in os.walk(top):
            for x in [os.path.join(d, n) for n in ds + fs]:
                os.lchown(x, pw.pw_uid, pw.pw_gid)
    return changed


def commands(lines, people, kernels):
    """The steps as they are run: a line with USER once for each user, one with VERSION once for each kernel."""
    out = []
    for line in lines:
        for user in (people if re.search(r"\bUSER\b", line) else [None]):
            for kernel in (kernels if re.search(r"\bVERSION\b", line) else [None]):
                cmd = re.sub(r"\bUSER\b", user, line) if user else line
                out.append(re.sub(r"\bVERSION\b", kernel, cmd) if kernel else cmd)
    return out


def leftovers(root, targets, sections):
    """What is in LatteOS's own folders and is neither a file of this LatteOS nor one FILES says it needs there."""
    needed = re.findall(r"^(?:optional )?(/\S+):", "\n".join(sections.get("needs", [])), re.M)
    wanted = {os.path.normpath(root + t) for t in targets + needed}
    return sorted(os.path.join(d, f) for own in OWN for d, _, files in os.walk(root + own) for f in files if os.path.join(d, f) not in wanted)


# The repositories beyond Fedora's (user 16. 11.): the COPR always (hypridle, Quickshell 0.3, mpvpaper), RPM Fusion and
# Terra only with the Game session (steam; gamescope-session, Terra limited to those two as Bazzite does), mise's own
# with the AI tools. The installer's Summary says so before anything is added.
GAMES = ("steam", "gamescope-session", "gamescope-session-steam")
TERRA = """[terra-latteos]
name=Terra (Fyra Labs), only gamescope-session for LatteOS's Game session
baseurl=https://repos.fyralabs.com/terra$releasever
enabled=1
gpgcheck=1
gpgkey=https://repos.fyralabs.com/terra$releasever/key.asc
repo_gpgcheck=0
includepkgs=gamescope-session gamescope-session-steam
"""


# The tools of peripherals (ROADMAP 2.11, user 19. 11.: all of them, as on Windows), chosen by the installer's window when
# such a device is plugged in: OpenRazer and Polychromatic (Razer, as Synapse) from openSUSE's hardware:razer, CoolerControl
# (NZXT's cooler, as CAM) from its COPR, OpenDeck (stream docks) from its release with 4ndv's plugin for Ajazz (GPL-3.0).
RAZER_REPO = "https://download.opensuse.org/repositories/hardware:/razer/Fedora_%s/hardware:razer.repo"
OPENDECK = "https://github.com/nekename/OpenDeck/releases/download/v2.14.2/opendeck-2.14.2-1.x86_64.rpm"
AKP03 = "https://github.com/4ndv/opendeck-akp03/releases/download/v0.11.0/opendeck-akp03.plugin.zip"
DKMS_SIGN = "/etc/dkms/framework.conf.d/latteos-mok.conf"   # OpenRazer's module signed with the same key as NVIDIA's


def repositories(extra, nvidia=False):
    """Add what the chosen packages come from (RPM Fusion for NVIDIA's driver too); False when one could not be added."""
    have = subprocess.run(["dnf", "repolist", "--enabled"], capture_output=True, text=True).stdout
    steps = []
    if "lionheartp:Hyprland" not in have:
        steps.append(["dnf", "copr", "enable", "-y", "lionheartp/Hyprland"])
    if (any(p in GAMES for p in extra) or nvidia) and "rpmfusion-nonfree" not in have:
        v = subprocess.run(["rpm", "-E", "%fedora"], capture_output=True, text=True).stdout.strip()
        steps.append(["dnf", "install", "-y"] + ["https://mirrors.rpmfusion.org/%s/fedora/rpmfusion-%s-release-%s.noarch.rpm" % (k, k, v)
                                                 for k in ("free", "nonfree")])
    if any(p in GAMES for p in extra):
        if "terra-latteos" not in have:
            with open("/etc/yum.repos.d/terra-latteos.repo", "w") as f: f.write(TERRA)
    if "openrazer-meta" in extra and "hardware_razer" not in have:
        v = subprocess.run(["rpm", "-E", "%fedora"], capture_output=True, text=True).stdout.strip()
        steps.append(["dnf", "config-manager", "addrepo", "--from-repofile=" + RAZER_REPO % v])
    if "coolercontrol" in extra and "codifryed:CoolerControl" not in have:
        steps.append(["dnf", "copr", "enable", "-y", "codifryed/CoolerControl"])
    if "mise" in extra and "mise-repo" not in have:
        steps.append(["dnf", "config-manager", "addrepo", "--from-repofile=https://mise.jdx.dev/rpm/mise.repo"])
    for step in steps:
        print("   $ " + " ".join(step), flush=True)
        if subprocess.run(step).returncode: return False
    return True


# The graphics cards' firmware (ROADMAP 2.10): Fedora's linux-firmware only recommends these, so the ones of cards this PC
# does not have go, and a file of dnf's keeps updates from bringing them back. NVIDIA's own driver brings its firmware.
FIRMWARE = {"amd": "amd-gpu-firmware", "intel": "intel-gpu-firmware", "nouveau": "nvidia-gpu-firmware"}
EXCLUDE = "/etc/dnf/libdnf5.conf.d/latteos-gpu.conf"
NVIDIA = ["akmod-nvidia", "xorg-x11-drv-nvidia-cuda"]       # RPM Fusion: the open modules on RTX 20 and newer, CUDA for AI
MOK_KEY = "/etc/pki/akmods/certs/public_key.der"


def secure_boot():
    try:
        with open("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c", "rb") as f: return f.read()[-1:] == b"\x01"
    except OSError: return False


def firmware_off(cards, say):
    """Take off the firmware of the cards this PC does not have, unless a package still needs it; keep it off."""
    keep = {FIRMWARE[c] for c in cards if c in FIRMWARE}
    drop = [p for p in sorted(set(FIRMWARE.values()) - keep)
            if subprocess.run(["rpm", "-q", "--whatrequires", p], capture_output=True).returncode]
    if not drop: return
    there = [p for p in drop if not subprocess.run(["rpm", "-q", p], capture_output=True).returncode]
    if there:                       # first off, then kept off: dnf cannot remove a package it already excludes
        say("   $ dnf remove -y --noautoremove " + " ".join(there))
        subprocess.run(["dnf", "remove", "-y", "--noautoremove", "--setopt=excludepkgs="] + there)
    with open(EXCLUDE, "w") as f:
        f.write("# LatteOS (install --gpu): firmware of graphics cards this PC does not have; delete this file for another card\n"
                "[main]\nexcludepkgs=%s\n" % ",".join(drop))
    say("   left out, firmware of cards this PC does not have: " + " ".join(drop))


def peripherals(extra, say):
    """What a peripheral's tool needs beyond its package; none of it fails the install."""
    if "openrazer-meta" in extra:               # its daemon talks only to plugdev's members
        for user in users(): subprocess.run(["gpasswd", "-a", user, "plugdev"], capture_output=True)
        # its package builds the module only for the Linux running now, and fails when that one's headers are not there
        # (a fresh Fedora brings a newer kernel-devel): built here for the Linux the next start runs; new ones by dkms's hook
        k = default_kernel()
        subprocess.run(["dnf", "install", "-y", "kernel-devel-" + k], capture_output=True)
        subprocess.run(["dkms", "autoinstall", "-k", k], capture_output=True)
        built = not subprocess.run(["modinfo", "-F", "version", "razermouse", "-k", k], capture_output=True).returncode
        say("   Razer: OpenRazer's module " + ("built for Linux " + k if built else "not built (dkms status; its log in /var/lib/dkms/openrazer-driver/)")
            + "; the users are in plugdev; Polychromatic is its window")
    if "coolercontrol" in extra:
        subprocess.run(["systemctl", "enable", "coolercontrold.service"], capture_output=True)
        say("   the cooler: coolercontrold starts with the system")
    if "opendeck" in extra:
        say("   $ dnf install -y " + OPENDECK)
        if subprocess.run(["dnf", "install", "-y", OPENDECK]).returncode:
            say("   OpenDeck could not be installed: " + OPENDECK)
            return
        try:
            import io, urllib.request, zipfile
            plugin = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(AKP03, timeout=60).read()))
            for user in users():                # OpenDeck's own folder: Tauri's config dir by its identifier
                pw = pwd.getpwnam(user)
                top = os.path.join(pw.pw_dir, ".config", "me.amankhanna.opendeck")
                plugin.extractall(os.path.join(top, "plugins"))
                for d, _, fs in os.walk(top):
                    for x in [d] + [os.path.join(d, f) for f in fs]: os.chown(x, pw.pw_uid, pw.pw_gid)
                for x in plugin.namelist():         # its programs: the zip keeps no modes
                    if x.endswith("-linux"): os.chmod(os.path.join(top, "plugins", x), 0o755)
            say("   the stream dock: OpenDeck with the Ajazz plugin (Ajazz AKP03, Mirabox N3)")
        except Exception as e:
            say("   OpenDeck is there, its Ajazz plugin is not (%s): OpenDeck › Plugins › Install from file, %s" % (e, AKP03))


def mok_password():
    """Eight letters that are where they are on QWERTY and QWERTZ alike (MokManager reads the keys as QWERTY), no l or o."""
    return "".join(secrets.choice("abcdefghijkmnpqrstuvwx") for _ in range(8))


def mok_key(say):
    """With Secure Boot on, a key of this PC's that akmods signs NVIDIA's module with, before it is built; the firmware
    learns it at the next start (MokManager asks for the password once). The password, "" when none is asked."""
    subprocess.run(["kmodgenca", "-a"])                 # a key already there is kept
    tested = subprocess.run(["mokutil", "--test-key", MOK_KEY], capture_output=True, text=True)
    if "already enrolled" in tested.stdout + tested.stderr: return ""
    password = mok_password()
    hashed = subprocess.run(["mokutil", "--generate-hash=" + password], capture_output=True, text=True).stdout.strip()
    path = "/run/latteos-mok.hash"
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f: f.write(hashed + "\n")
    done = subprocess.run(["mokutil", "--import", MOK_KEY, "--hash-file", path]).returncode == 0
    os.remove(path)
    if not done:
        say("   the key for Secure Boot was not queued: NVIDIA's driver will not load until it is (mokutil --import " + MOK_KEY + ")")
        return ""
    return password


def default_kernel():
    """The kernel the next start runs: NVIDIA's module is built for it."""
    k = subprocess.run(["grubby", "--default-kernel"], capture_output=True, text=True).stdout.strip()
    return os.path.basename(k)[len("vmlinuz-"):] if k.startswith("/boot/vmlinuz-") else os.uname().release


def main(a):
    flags = {f for f in a if f in ("--go", "--remove", "--purge", "--prune", "--progress", "--old-amd")}
    rest = [x for x in a if x not in flags]
    chosen = []
    if "--with" in rest[:-1]:
        k = rest.index("--with"); chosen = rest[k + 1].split(); rest = rest[:k] + rest[k + 2:]
    cards = []
    if "--gpu" in rest[:-1]:
        k = rest.index("--gpu"); cards = rest[k + 1].split(); rest = rest[:k] + rest[k + 2:]
    root = ""
    if rest[:1] == ["--root"] and len(rest) == 2:
        root, rest = os.path.abspath(rest[1]), []
    if rest or ("--go" in flags and "--remove" in flags):
        print(__doc__.strip())
        return 2
    sections = read(os.path.join(HERE, "FILES"))
    act = bool(flags & {"--go", "--remove"})
    if act and not root and os.geteuid() != 0:
        print("install: this changes the system; run it with sudo, or with --root DIR to look at the result")
        return 1
    say = lambda line: print(line, flush=True)
    # the parts of an install and how long each takes, roughly: the installer's bar moves by them
    # LensAI's web tabs only when wanted: the installer's window says so in --with (its component brings qt6-qtwebengine)
    with_web = "--go" in flags and not root and any(s.startswith("qsweb:") for _, s in pairs(sections.get("files", []))) \
        and ("--with" not in a or "qt6-qtwebengine" in chosen)
    # the boot menu (Aarambh) only when the installer's window chose it: it changes what the firmware starts first
    with_boot = "--go" in flags and not root and "gnu-efi-devel" in chosen
    # agentgram and ToolHive only when the installer's window chose them (patches/ai-stack.sh): bun, the Registry Server, ToolHive Studio
    # and a build of the user's fork; for the one who asked with sudo, not for every user of the PC (a build is ~2.2 GB)
    with_ai = "--go" in flags and not root and "postgresql-server" in chosen
    with_pleamar = "--go" in flags and not root and any(s.startswith("pleamar:") for _, s in pairs(sections.get("files", [])))
    must, may, files, may_files = needs(sections)
    fetch = must + [p for p in chosen if p in may]       # what dnf brings: what is missing, and what was chosen of the rest
    old_amd = "--old-amd" in flags and "--go" in flags and not root
    nvidia = "nvidia" in cards and "--go" in flags and not root
    with_packages = "--go" in flags and not root and bool(fetch or cards)
    parts = ([("packages", "Installing Fedora's packages", 25)] if with_packages else []) \
        + ([("gpu", "Linux 7.3 and Mesa 26.3 for this graphics card", 35)] if old_amd else []) + [("build", "Building LatteOS's programs", 15)] + ([("pleamar", "Building pleamar and pleamar-wm", 45)] if with_pleamar else []) \
        + ([("web", "Building Quickshell for LensAI", 40)] if with_web else []) \
        + [("files", "Copying the files", 25), ("steps", "Setting the system up", 20)] \
        + ([("boot", "The boot menu", 10)] if with_boot else []) + ([("ai", "Agentgram and ToolHive", 12)] if with_ai else []) + ([("driver", "NVIDIA's driver, built for this Linux", 8)] if nvidia else [])
    whole = sum(w for _, _, w in parts)
    def part(name, share=0.0):
        """Where the bar is: at `share` (0…1) of that part; with --progress, a line for the installer's window."""
        if "--progress" not in flags or "--go" not in flags: return
        k = next(i for i, p in enumerate(parts) if p[0] == name)
        if share == 0.0: say("@step %d/%d %s" % (k + 1, len(parts), parts[k][1]))
        say("@percent %d" % int(100 * (sum(w for _, _, w in parts[:k]) + parts[k][2] * share) / whole))
    run = (lambda cmd: say("   $ " + cmd)) if (root or not act) else (lambda cmd: (say("   $ " + cmd), subprocess.run(cmd, shell=True))[1])
    kernels = sorted(os.listdir("/lib/modules")) if os.path.isdir("/lib/modules") else []

    if "--remove" in flags:
        say("== the steps, undone" + (" (not run under --root)" if root else ""))
        for cmd in commands(sections.get("undo", []), users(), kernels): run(cmd)
        if not root and os.path.isdir("/opt/mesa-26.3"):             # what --old-amd put there
            run("sh " + os.path.join(HERE, "patches", "old-amd.sh") + " remove")
        if not root and os.path.exists(EXCLUDE):                     # what --gpu put there; NVIDIA's driver stays
            os.remove(EXCLUDE)
            say("   dnf may bring every graphics card's firmware again (NVIDIA's driver stays: dnf remove akmod-nvidia)")
        say("== the files")
        gone = 0
        for _, target in copies(sections, "files") + copies(sections, "replaces"):
            path = root + target
            if os.path.lexists(path):
                os.remove(path); gone += 1
            if os.path.lexists(path + ".pre-latteos"):
                os.replace(path + ".pre-latteos", path)
                say("   put back: " + target)
        for own in OWN:                         # the folders that were LatteOS's alone go when they are empty
            for d, _, _ in sorted(os.walk(root + own, topdown=False)):
                if not os.listdir(d): os.rmdir(d)
        say("   %d files removed" % gone)
        if "--purge" in flags:
            say("== what was made while it ran")
            for line in sections.get("state", []) + [t for _, t in copies(sections, "seeds")]:
                for home in ([pwd.getpwnam(u).pw_dir for u in users()] if line.startswith("~") else [""]):
                    for path in glob.glob(root + (home + line[1:] if home else line)) if not line.startswith("$") else []:
                        shutil.rmtree(path) if os.path.isdir(path) and not os.path.islink(path) else os.remove(path)
                        say("   removed: " + path)
        return 0

    say("== what LatteOS needs")
    if must: say("   missing:  sudo dnf install " + " ".join(must))
    for line in files: say("   missing:  " + line)
    if may: say("   optional: sudo dnf install " + " ".join(may))
    for line in may_files: say("   optional: " + line[9:])
    if not (must or files or may or may_files): say("   all there")
    # Fedora's packages it brings itself; a missing file that is not a package still has to be there first
    mok = ""                                    # Secure Boot's password for MokManager, when a key was queued
    if with_packages:
        part("packages")
        extra = [p for p in fetch if p not in must]
        def dnf(args, lo, hi):
            """dnf with its lines passed on; its [n/m] counter moves the bar from lo to hi of the packages' part."""
            say("   $ dnf " + " ".join(args))
            p = subprocess.Popen(["dnf"] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
            best = 0.0              # dnf counts twice (downloading, then installing): the bar only moves forward
            for line in p.stdout:
                say(line.rstrip("\n"))
                m = re.match(r"\[\s*(\d+)/(\d+)\]", line)
                if m and int(m.group(2)):
                    # downloads are the first half of the way, the transaction the second
                    at = int(m.group(1)) / int(m.group(2)) / 2 + (0.5 if "Install" in line or "Remov" in line or "Upgrad" in line else 0)
                    if at > best: best = at; part("packages", lo + (hi - lo) * at)
            return p.wait()
        if "openrazer-meta" in extra and secure_boot():   # its module is built while dnf installs it: the key first
            if not dnf(["install", "-y", "akmods", "mokutil", "openssl"], 0.55, 0.58):
                mok = mok_key(say)
                os.makedirs(os.path.dirname(DKMS_SIGN), exist_ok=True)
                with open(DKMS_SIGN, "w") as f:
                    f.write("# LatteOS (install): DKMS signs with akmods' key, the one MokManager learns (ROADMAP 2.11)\n"
                            "mok_signing_key=/etc/pki/akmods/private/private_key.priv\nmok_certificate=" + MOK_KEY + "\n")
        if not repositories(extra, nvidia):
            say("install: a repository could not be added")
            return 1
        if must and dnf(["install", "-y"] + must, 0.0, 0.6 if extra else 1.0):
            say("install: dnf could not install them")
            return 1
        # a chosen extra still missing from every repository is left out, not fatal
        if extra:
            plain = [p for p in extra if p != "opendeck"]     # OpenDeck comes from its release (peripherals)
            if plain: dnf(["install", "-y", "--skip-unavailable"] + plain, 0.6 if must else 0.0, 1.0)
            left = [p for p in plain if subprocess.run(["rpm", "-q", "--whatprovides", p], capture_output=True).returncode]
            if left: say("   not in Fedora's repositories, left out: " + " ".join(left))
            peripherals(extra, say)
        must = needs(sections)[0]
    building = None
    if nvidia:
        say("== NVIDIA's driver")
        if secure_boot():
            if dnf(["install", "-y", "akmods", "mokutil", "openssl"], 0.9, 0.92):
                say("install: the tools for Secure Boot's key could not be installed")
                return 1
            mok = mok or mok_key(say)
        if dnf(["install", "-y"] + NVIDIA, 0.92, 1.0):
            say("install: NVIDIA's driver could not be installed")
            return 1
        # its module is built in the background while LatteOS and pleamar are (about 5 minutes); waited for at the end
        building = subprocess.Popen(["akmods", "--kernels", default_kernel()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if cards and with_packages:
        firmware_off(cards, say)
    if (must or files) and "--go" in flags and not root:
        say("install: what is missing has to be there first")
        return 1

    if old_amd:
        say("== Linux 7.3 and Mesa 26.3")
        part("gpu")
        if subprocess.run(["sh", os.path.join(HERE, "patches", "old-amd.sh")]).returncode:
            say("install: Linux 7.3 or Mesa 26.3 could not be put in place")
            return 1

    if "--go" in flags:
        say("== building")
        part("build")
        owner = os.environ.get("SUDO_USER") if os.geteuid() == 0 else None      # cargo's files stay the user's
        as_user = ["sudo", "-u", owner] if owner and owner != "root" else []
        crates = sorted({s[6:] for _, s in pairs(sections.get("files", [])) if s.startswith("build:")})
        # the build runs as the user, but the source may have been fetched by root (get): its build folders are the
        # user's, or cargo stops with "failed to open .cargo-build-lock: Permission denied" (22. 11., main PC)
        if as_user:
            for d in ("target", "build"):
                os.makedirs(os.path.join(HERE, d), exist_ok=True)
                subprocess.run(["chown", "-R", owner, os.path.join(HERE, d)])

        def gentle(cmd):
            """A build runs at the lowest priority and leaves two cores free: the installer's window (cage, the moving
            coffee) must keep drawing and the mouse must keep moving while cargo takes everything else (22. 11.: on the
            main PC the window froze during pleamar's build)."""
            cmd = ["nice", "-n", "19", "ionice", "-c", "2", "-n", "7"] + cmd
            if "sudo" in cmd[:6]: cmd.insert(cmd.index("sudo") + 1, "--preserve-env=CARGO_BUILD_JOBS,MAKEFLAGS,CMAKE_BUILD_PARALLEL_LEVEL")
            return cmd
        def gentle_env():
            jobs = str(max(1, (os.cpu_count() or 2) - 2))
            return dict(os.environ, CARGO_BUILD_JOBS=jobs, MAKEFLAGS="-j" + jobs, CMAKE_BUILD_PARALLEL_LEVEL=jobs)

        def compiled(cmd, name, crates_about, cwd=None):
            """A build with its lines passed on; cargo's "Compiling …" lines move the bar through `name`'s part.
            cargo does not say how many there will be: about as many as the lock files hold."""
            p = subprocess.Popen(gentle(cmd), cwd=cwd, env=gentle_env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
            n = 0
            for line in p.stdout:
                say(line.rstrip("\n"))
                if line.lstrip().startswith("Compiling "):
                    n += 1
                    part(name, min(0.97, n / crates_about))
            return p.wait()

        # ponytail: the counts are the lock files' of 16. 11. (226 here; pleamar 339, pleamar-wm 444 sharing most of
        # them); the bar only slows near its end if they grow, it never goes back
        if crates and compiled(as_user + ["cargo", "build", "--release"] + [x for c in crates for x in ("-p", c)], "build", 230, cwd=HERE):
            return 1
        # the desktop itself: pleamar and pleamar-wm with LatteOS's patches (not under --root either: ten minutes)
        if with_pleamar:
            part("pleamar")
            if compiled(as_user + ["sh", os.path.join(HERE, "patches", "build-pleamar.sh")], "pleamar", 500):
                say("install: pleamar or pleamar-wm could not be built")
                return 1
        # LensAI's web tabs: a Quickshell of its own; without it LensAI only goes without them
        # (not into a tree under --root: tests/check.sh builds nothing that takes ten minutes)
        if with_web:
            part("web")
            if subprocess.run(gentle(as_user + ["sh", os.path.join(HERE, "patches", "build-quickshell-web.sh")]), env=gentle_env()).returncode:
                say("   Quickshell with a web engine was not built: LensAI goes without the services' tabs")
        # how LatteOS was developed, for the Settings' About page: from this repository's history, as the user (git
        # refuses a repository that is not its asker's); no history (a copy without .git) leaves the old file as it is
        if os.path.isdir(os.path.join(HERE, ".git")):
            subprocess.run(as_user + [sys.executable, os.path.join(HERE, "bin", "latte-activity"), "write", os.path.join(HERE, "build", "activity.json")])

    say("== the files" + ("" if act else " (nothing is copied without --go)"))
    part("files")
    done = missing = 0
    every = [(section, c) for section in ("files", "replaces", "seeds") for c in copies(sections, section)]
    for n, (section, (source, target)) in enumerate(every):
        if n % 50 == 0 and n: part("files", n / len(every))
        path = root + target
        if not os.path.isfile(source):
            if "/build/quickshell-web/" in source:      # LensAI only goes without the services' tabs
                say("   not built (LensAI's tabs): " + source)
                continue
            if source.endswith("/build/activity.json"):     # only the About page's history; no git history here is fine
                say("   not built (About page's history): " + source)
                continue
            if root and "/build/pleamar-src/" in source:     # not built into a tree under --root (tests/check.sh)
                say("   not built under --root: " + source)
                continue
            say("   not built or not there: " + source); missing += 1
            continue
        if section == "seeds" and os.path.lexists(path):
            continue                        # from the first time on it is the user's
        if "--go" in flags:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if section == "replaces" and os.path.lexists(path) and not os.path.lexists(path + ".pre-latteos"):
                os.replace(path, path + ".pre-latteos")
                say("   kept the original: " + target + ".pre-latteos")
            shutil.copyfile(source, path + ".new")
            os.chmod(path + ".new", 0o755 if os.access(source, os.X_OK) else 0o644)
            os.replace(path + ".new", path)
        done += 1
    say("   %d files%s" % (done, ", %d could not be found" % missing if missing else ""))
    if missing and "--go" in flags:
        return 1

    targets = [t for section in ("files", "replaces", "seeds") for _, t in copies(sections, section)]
    left = leftovers(root, targets, sections)
    if left:
        say("== in LatteOS's own folders, and not of this LatteOS (%d)" % len(left))
        for path in left[:12]: say("   " + path)
        if len(left) > 12: say("   … and %d more" % (len(left) - 12))
        if "--go" in flags and "--prune" in flags:
            for path in left: os.remove(path)
            say("   removed")
        else:
            say("   --prune with --go removes them")

    say("== the steps" + (" (not run under --root)" if root and act else ("" if act else " (not run without --go)")))
    part("steps")
    todo = commands(sections.get("steps", []), users(), kernels)
    failed = []
    for n, cmd in enumerate(todo):
        may_fail = cmd.startswith("- ")            # as in a Makefile: a step that may fail without the install failing
        cmd = cmd[2:] if may_fail else cmd
        if "--go" in flags:
            done = run(cmd)
            if not root and done.returncode and not may_fail: failed.append(cmd)
            part("steps", (n + 1) / len(todo))
        else: say("   $ " + cmd)
    if "--go" in flags and not root and os.geteuid() == 0:
        # steps run as root with the user's HOME: whatever they made under the user's folders stays the user's. Not a list of
        # names (a step made ~/.config before the user ever logged in, then ~/.config/pleamar...; a list is always one short,
        # 22. 11.): every thing under the home that root owns is given back, and all of LatteOS's own folders whoever owns
        # what is in them
        for name in users():
            try: pw = pwd.getpwnam(name)
            except KeyError: continue
            give_back_home(pw)
    if with_boot:
        part("boot")
        if subprocess.run(["sh", os.path.join(HERE, "patches", "aarambh", "setup-latteos.sh")]).returncode:
            say("   the boot menu was not set up whole: if the PC starts into Aarambh, LatteOS is there under its own name; sudo ./install --remove takes the menu off")
    if with_ai:
        part("ai")
        asked = os.environ.get("SUDO_USER") or (users() or [""])[0]
        if asked and subprocess.run(["sh", os.path.join(HERE, "patches", "ai-stack.sh"), asked]).returncode:
            say("   agentgram and ToolHive were not set up whole: sudo sh patches/ai-stack.sh %s runs it again (what is done stays)" % asked)
    if building:
        part("driver")
        building.wait()
        k = default_kernel()
        if subprocess.run(["modinfo", "-F", "version", "nvidia", "-k", k], capture_output=True).returncode:
            say("   NVIDIA's module is not built yet: akmods builds it at the next start (its log: /var/cache/akmods/nvidia/)")
        else:
            say("   NVIDIA's module is built for Linux " + k)
    if mok:
        say("@mok " + mok)
        say("   Secure Boot: at the next start MokManager asks for the password " + mok + " once (Enroll MOK, Continue, Yes)")
    if failed:
        # the wizard must not say "installed" when the login screen or SAFE was not set up
        say("install: these steps failed:")
        for cmd in failed: say("   " + cmd)
        return 1
    if "--progress" in flags and "--go" in flags: say("@percent 100")
    if "--go" in flags and not root:
        say("LatteOS is in place. It starts with the next boot: the login screen is greetd's.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
